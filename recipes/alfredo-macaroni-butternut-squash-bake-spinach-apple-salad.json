  "instructions": [
    {
      "id": 373150,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 373151,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add butternut squash, pasta, and salt; stir for a few seconds. Cook until pasta reaches desired firmness, 8-10 minutes.",
      "secondary_message": "4 cup frozen butternut squash, pieces\n10 oz macaroni (elbow) pasta\n1 tsp salt"
    },
    {
      "id": 373152,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 Gala apples\n1 English cucumber\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 373153,
      "primary_message": "Quarter, core, and thinly slice apples. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 373154,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the apple and set aside. ",
      "secondary_message": null
    },
    {
      "id": 373155,
      "primary_message": "When the pasta and butternut squash are done, drain and transfer to a large baking dish. ",
      "secondary_message": null
    },
    {
      "id": 373156,
      "primary_message": "Add Alfredo sauce and spices to the baking dish with the pasta and butternut squash. Stir to combine. ",
      "secondary_message": "1 (16 oz) jar alfredo sauce\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 373157,
      "primary_message": "Place dish in the oven and bake until sauce is warmed through and the top is golden, about 10 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 373158,
      "primary_message": "Just before serving, add spinach, pumpkin seeds, and vinaigrette to the bowl with the apple and cucumber. Toss to combine the salad. ",
      "secondary_message": "¼ cup pumpkin seeds\n¼ cup French vinaigrette"
    },
    {
      "id": 373159,
      "primary_message": "To serve, divide pasta bake and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
