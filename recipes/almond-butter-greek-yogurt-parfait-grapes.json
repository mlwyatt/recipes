  "instructions": [
    {
      "id": 152536,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 152537,
      "primary_message": "Add almonds to the skillet; cook, stirring occasionally, until lightly toasted, 2-3 minutes. Set aside to cool.",
      "secondary_message": "⅔ cup almonds, sliced"
    },
    {
      "id": 152538,
      "primary_message": "Combine yogurt, honey, and almond butter in a medium bowl and whisk until smooth.",
      "secondary_message": "3 cups plain Greek yogurt\n2 tbsp honey\n½ cup natural almond butter"
    },
    {
      "id": 152539,
      "primary_message": "Wash, dry, and cut grapes into halves.",
      "secondary_message": "½ lb red grapes"
    },
    {
      "id": 152540,
      "primary_message": "To serve, divide yogurt, grapes, and almonds between jars or bowls, alternating ingredients to create layers. Enjoy!",
      "secondary_message": null
    }
  ],
