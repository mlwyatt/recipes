          {
            "id": 152536,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 152537,
            "primary_message": "Add almonds to the skillet; cook, stirring occasionally, until lightly toasted, 2-3 minutes. Set aside to cool.",
