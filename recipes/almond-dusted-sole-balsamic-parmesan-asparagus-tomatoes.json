        "instructions": [
          {
            "id": 326550,
            "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil for easier cleanup (optional).",
            "secondary_message": null
          },
          {
            "id": 326551,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 small bunches asparagus\n1 pint grape tomatoes\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 326552,
            "primary_message": "Snap or cut off woody ends of the asparagus and transfer to the baking sheet. ",
            "secondary_message": null
          },
          {
            "id": 326553,
            "primary_message": "Add tomatoes to the baking sheet with the asparagus and spread veggies out in an even layer. ",
            "secondary_message": null
          },
          {
            "id": 326554,
            "primary_message": "Cut butter into small pieces and sprinkle over the veggies; drizzle with vinegar, then season with salt and pepper. ",
            "secondary_message": "2 tbsp butter, unsalted\n4 tsp balsamic vinegar\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 326555,
            "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender, 12-15 minutes.",
            "secondary_message": null
          },
          {
            "id": 326556,
            "primary_message": "While the veggies are roasting, zest lemon into a medium bowl. (Reserve lemon for serving.)",
            "secondary_message": null
          },
          {
            "id": 326557,
            "primary_message": "Add almond meal, salt, and pepper to the bowl with the lemon zest; stir to combine.",
            "secondary_message": "1 cup almond meal/flour\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 326558,
            "primary_message": "Working one by one, dredge fish fillets in the almond meal mixture, pressing lightly to adhere to both sides. Transfer fish to a plate. ",
            "secondary_message": "1 ½ lb sole fillets"
          },
          {
            "id": 326559,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 326560,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the fish and pan-fry until golden brown and cooked through, 2-3 minutes per side. Remove to a clean plate.",
            "secondary_message": "⅓ cup butter, unsalted"
          },
          {
            "id": 326561,
            "primary_message": "Meanwhile, finely grate Parmesan. ",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 326562,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 326563,
            "primary_message": "When the veggies are done, remove from the oven and sprinkle with Parmesan and half of the parsley; toss to combine. (Reserve the rest of the parsley for serving.)",
            "secondary_message": null
          },
          {
            "id": 326564,
            "primary_message": "To serve, divide fish and veggies between plates. Juice reserved lemon over fish and sprinkle with reserved parsley. Enjoy!",
            "secondary_message": null
          }
        ],
