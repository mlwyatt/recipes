  "instructions": [
    {
      "id": 405322,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "2 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 405323,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom. Lay prosciutto in the skillet and cook until it browns slightly, about 1 minute per side. Transfer to a plate and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil\n4 slices prosciutto"
    },
    {
      "id": 405324,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 red bell peppers\n1 small pkg fresh basil\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 405325,
      "primary_message": "Seed and slice bell peppers into thin strips. Peel and mince shallots.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 405326,
      "primary_message": "Return skillet to stove over medium-high heat. Add more oil and swirl to coat the bottom. Add peppers, shallots, and salt; cook, stirring often, until crisp-tender, 5-6 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 405327,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the skillet with the peppers during the last 30 seconds of cooking. Remove both from heat and set aside to cool.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 405328,
      "primary_message": "Combine oil, vinegar, Dijon, and spices in a large salad bowl and whisk to combine the dressing. ",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup red wine vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper\n¼ tsp onion powder\n¼ tsp Italian seasoning"
    },
    {
      "id": 405329,
      "primary_message": "Drain and thinly slice artichoke hearts; transfer to the bowl with the dressing.",
      "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 405330,
      "primary_message": "Cut cheese into ½-inch cubes; transfer to the bowl.",
      "secondary_message": "⅔ (8 oz) block mozzarella cheese"
    },
    {
      "id": 405331,
      "primary_message": "Halve olives and add to the bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 405332,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 405333,
      "primary_message": "When the pasta is done cooking, drain and rinse under cold, running water. Transfer pasta, bell pepper mixture, and arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 405334,
      "primary_message": "Chop or tear prosciutto into pieces.",
      "secondary_message": null
    },
    {
      "id": 405335,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
