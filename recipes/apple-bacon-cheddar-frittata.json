        "instructions": [
          {
            "id": 21856,
            "primary_message": "Wash, core, and thinly slice apples into ⅛ inch wedges. Transfer to a bowl and set aside.",
            "secondary_message": "2 Gala apples"
          },
          {
            "id": 21857,
            "primary_message": "In a medium bowl, whisk together eggs, water, salt, and pepper.",
            "secondary_message": "12 eggs\r\n4 tbsp water\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 21858,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 21859,
            "primary_message": "Chop bacon into smaller pieces.",
            "secondary_message": "6 strips bacon"
          },
          {
            "id": 21860,
            "primary_message": "Add bacon to skillet and cook, stirring occasionally, until crispy, 3-4 minutes. Transfer to a plate, leaving the grease in the skillet.",
            "secondary_message": ""
          },
          {
            "id": 21861,
            "primary_message": "Preheat oven to broil and position rack about 4 inches from the top.",
            "secondary_message": ""
          },
          {
            "id": 21862,
            "primary_message": "Grate 1 cup of cheddar. Add ½ to bowl with eggs and mix.",
            "secondary_message": "½ (8 oz) block cheddar cheese"
          },
          {
            "id": 21863,
            "primary_message": "Once bacon has been transferred, add butter and apple slices to skillet. Stir to combine, and cook until apples are slightly softened, 1-2 minutes.",
            "secondary_message": "1 tbsp butter, unsalted"
          },
          {
            "id": 21864,
            "primary_message": "Return about ½ of the bacon to the skillet. Spread out the apples and bacon evenly.",
            "secondary_message": ""
          },
          {
            "id": 21865,
            "primary_message": "Pour in egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
            "secondary_message": ""
          },
          {
            "id": 21866,
            "primary_message": "Sprinkle remaining cheddar and bacon over top. Place skillet in the oven until the top is set, 2-3 minutes.",
            "secondary_message": ""
          },
          {
            "id": 21867,
            "primary_message": "To serve, cut frittata into wedges and place on a plate. Enjoy!",
            "secondary_message": ""
          }
        ],
