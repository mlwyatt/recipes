        "instructions": [
          {
            "id": 45904,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "2 Gala apples\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 45905,
            "primary_message": "Quarter the apples lengthwise, then cut out the core and stem from each section; cut each quarter lengthwise into thin wedges. Transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 45906,
            "primary_message": "Coarsely grate 2 cups of cheddar and transfer to a bowl.",
            "secondary_message": "1 (8 oz) block cheddar cheese"
          },
          {
            "id": 45908,
            "primary_message": "Place the 8 bread slices on a flat surface and divide the mustard among them. Evenly top 4 of the slices with ½ of the apple (save the rest for the salad) and the grated cheddar; season with salt and pepper. Cover the sandwiches with the remaining bread slices, mustard-side-down.",
            "secondary_message": "8 slices whole grain bread\n2 tbsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 45907,
            "primary_message": "Preheat a nonstick skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 45909,
            "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
            "secondary_message": "½ tbsp butter, unsalted"
          },
          {
            "id": 45910,
            "primary_message": "Place 2 of the sandwiches in the skillet and cook until the bottom is golden brown, 2 to 4 minutes. Then, remove the sandwiches to a plate and add more butter to the skillet; return the sandwiches to the skillet, browned-side-up, and cook until golden brown on the other side and the cheese is melted, 2 to 4 minutes. Once done, transfer to a cutting board. Repeat the process with the remaining sandwiches.",
            "secondary_message": "½ tbsp butter, unsalted"
          },
          {
            "id": 45911,
            "primary_message": "While the sandwiches toast, roughly chop the pecans.",
            "secondary_message": "¼ cup pecans, dry roasted "
          },
          {
            "id": 45912,
            "primary_message": "Transfer the arugula, remaining apple slices, and pecans to a large salad bowl.",
            "secondary_message": null
          },
          {
            "id": 45913,
            "primary_message": "In a small bowl, combine and whisk together extra virgin olive oil, apple cider vinegar, honey, salt, and pepper.",
            "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper "
          },
          {
            "id": 45914,
            "primary_message": "Pour the dressing over the salad and toss to coat.",
            "secondary_message": ""
          },
          {
            "id": 45915,
            "primary_message": "Cut the sandwiches in half on the diagonal.",
            "secondary_message": ""
          },
          {
            "id": 45916,
            "primary_message": "To serve, divide the salad and sandwiches between plates. Enjoy!",
            "secondary_message": null
          }
        ],
