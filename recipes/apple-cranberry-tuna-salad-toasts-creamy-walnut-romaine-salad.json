  "instructions": [
    {
      "id": 386869,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 sticks celery\n2 Granny Smith apples\n2 hearts romaine hearts"
    },
    {
      "id": 386870,
      "primary_message": "Place yogurt, mayo, onion powder, and salt in a medium bowl. Stir to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n¼ cup mayonnaise\n½ tsp onion powder\n½ tsp salt"
    },
    {
      "id": 386871,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 386872,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl along with the cranberries. ",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 386873,
      "primary_message": "Drain tuna and flake into bite-sized pieces. Add to the bowl, stir to combine the tuna salad, and set aside.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 386874,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 386875,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 386876,
      "primary_message": "Roughly chop walnuts. Add to the bowl with the lettuce along with additional cranberries, dressing, and salt. Toss to combine the salad and set aside. ",
      "secondary_message": "½ cup walnuts\n¼ cup dried cranberries\n¼ cup ranch dressing\n⅛ tsp salt"
    },
    {
      "id": 386877,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 386878,
      "primary_message": "Divide toast between plates and top with tuna salad. Serve with romaine salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
