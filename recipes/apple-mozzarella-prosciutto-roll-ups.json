        "instructions": [
          {
            "id": 391972,
            "primary_message": "Wash, dry, quarter, and core apples. Slice each apple into 8 wedges.",
            "secondary_message": "2 Gala apples"
          },
          {
            "id": 391973,
            "primary_message": "Thinly slice cheese into 16 pieces.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 391974,
            "primary_message": "Cut or tear prosciutto pieces in half lengthwise into 16 strips.",
            "secondary_message": "8 slices prosciutto"
          },
          {
            "id": 391975,
            "primary_message": "Place one apple wedge and one slice of cheese at the end of each strip of prosciutto, then roll up.",
            "secondary_message": null
          },
          {
            "id": 391976,
            "primary_message": "To serve, divide roll-ups between plates. Enjoy!",
            "secondary_message": null
          }
        ],
