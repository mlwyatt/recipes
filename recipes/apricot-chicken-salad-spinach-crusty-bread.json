  "instructions": [
    {
      "id": 13911,
      "primary_message": "Place chicken in a small saucepan. Season with salt and pepper. Cover with water and bring to a boil. Reduce heat, cover, and simmer until chicken is cooked through, 8-12 minutes. Remove from liquid and place on a plate.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 13912,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 13913,
      "primary_message": "In a large bowl, prepare dressing by mixing together yogurt, Dijon, honey, salt, and pepper. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 13914,
      "primary_message": "Coat bottom of skillet with oil. Add almonds and, stirring constantly, cook until golden brown, 1-2 minutes. Transfer to a small bowl and set aside to cool.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n¼ cup almonds, sliced"
    },
    {
      "id": 13915,
      "primary_message": "Wash and dry celery and green onions. Small dice celery and add to bowl with dressing. Trim and discard root ends, chop onions, and add to bowl.",
      "secondary_message": "2 sticks celery\r\n1 small bunch green onions (scallions)"
    },
    {
      "id": 13916,
      "primary_message": "Small dice apricots and add to bowl. Add almonds to bowl.",
      "secondary_message": "16 dried apricots"
    },
    {
      "id": 13917,
      "primary_message": "Wash and dry spinach.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 13918,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 13919,
      "primary_message": "Pat dry the chicken with paper towels, small dice, and add to bowl. Toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 13920,
      "primary_message": "To serve, arrange a bed of spinach on a plate and top with chicken salad. Enjoy with crusty bread!",
      "secondary_message": ""
    }
  ],
