  "instructions": [
    {
      "id": 7157,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": ""
    },
    {
      "id": 7158,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Transfer to a sheet pan.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 7159,
      "primary_message": "Drizzle chickpeas with oil and season with cumin, salt, and pepper. Toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n1 tsp cumin\r\n1 tsp salt\r\n¼ tsp black pepper\r\n⅛ tsp cayenne pepper"
    },
    {
      "id": 7160,
      "primary_message": "Place in the oven and roast until crispy, 15-20 minutes. Stir halfway through cooking time.",
      "secondary_message": ""
    },
    {
      "id": 7161,
      "primary_message": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together garlic, lemon juice, oil, Dijon, salt, and pepper. Set aside.",
      "secondary_message": "2 cloves garlic\r\n1 lemon\r\n6 tbsp extra virgin olive oil\r\n½ tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 7162,
      "primary_message": "Wash and dry arugula.",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 7163,
      "primary_message": "Wash and medium dice cucumber. Halve and pit avocados; scoop out and medium dice the flesh.",
      "secondary_message": "1 English cucumber\r\n2 avocados"
    },
    {
      "id": 7164,
      "primary_message": "Shred ¼ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 7165,
      "primary_message": "To serve, arrange a bed of arugula on a plate and top with chickpeas, cucumber, and avocado. Drizzle with dressing and sprinkle with Parmesan. Enjoy!",
      "secondary_message": ""
    }
  ],
