  "instructions": [
    {
      "id": 13776,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to low, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 13777,
      "primary_message": "Peel and mince garlic. Wash and mince chives.",
      "secondary_message": "2 cloves garlic\r\n1 small pkg chives"
    },
    {
      "id": 13778,
      "primary_message": "In a medium bowl, prepare dressing by whisking together the garlic, ½ of the chives, lemon juice, olive oil, Dijon, salt, and pepper.",
      "secondary_message": "juice of 1 lemon\r\n6 tbsp extra virgin olive oil\r\n½ tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 13779,
      "primary_message": "Wash and dry arugula. Transfer to a large bowl. Add the remaining minced chives.",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 13780,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 13781,
      "primary_message": "Wash and slice mushrooms.",
      "secondary_message": "2 lb cremini mushrooms"
    },
    {
      "id": 13782,
      "primary_message": "Coat bottom of skillet with oil. Add pine nuts and, stirring constantly, cook until golden brown, 1-2 minutes. Transfer to a small bowl and set aside to cool.",
      "secondary_message": "1 tbsp extra virgin olive oil \r\n½ cup pine nuts"
    },
    {
      "id": 13783,
      "primary_message": "Return skillet to stove and add more oil. Add mushrooms and season with salt and pepper. Stirring occasionally, cook until just tender, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 13784,
      "primary_message": "Uncover quinoa and fluff with a fork. Add quinoa, mushrooms, and pine nuts to bowl with arugula. Toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 13785,
      "primary_message": "To serve, place salad on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
