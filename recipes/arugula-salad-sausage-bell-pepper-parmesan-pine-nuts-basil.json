  "instructions": [
    {
      "id": 346572,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n2 red bell peppers\n1 English cucumber\n2 (5 oz) pkgs baby arugula"
    },
    {
      "id": 346573,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 346574,
      "primary_message": "Add oil, vinegar, and spices to the bowl with the basil; whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tsp oregano, dried\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 346575,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346576,
      "primary_message": "While the skillet heats up, slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 346577,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add sausage and cook, turning occasionally, until golden brown and crispy, 5-6 minutes. Remove from heat. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 346578,
      "primary_message": "Meanwhile, using a clean cutting board, trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 346579,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 346580,
      "primary_message": "Thinly slice sun-dried tomatoes and add to the bowl. ",
      "secondary_message": "8 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 346581,
      "primary_message": "Finely grate Parmesan and add to the bowl. ",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 346582,
      "primary_message": "Add arugula and pine nuts to the bowl; toss to combine the salad.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 346583,
      "primary_message": "To serve, divide salad between plates or bowls and top with crispy sausage. Enjoy!",
      "secondary_message": null
    }
  ],
