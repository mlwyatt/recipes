        "instructions": [
          {
            "id": 265003,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 265004,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 265005,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 eggplants\n2 red bell peppers\n4 caps portobello mushrooms\n2 (1 inch) pieces ginger root\n1 small pkg fresh basil"
          },
          {
            "id": 265006,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 265007,
            "primary_message": "While the skillet heats up, trim and quarter the eggplants lengthwise, then cut crosswise into ¼-inch thick pieces. ",
            "secondary_message": null
          },
          {
            "id": 265008,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add eggplant and cook, stirring occasionally, until golden brown, about 10 minutes.",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 265009,
            "primary_message": "Meanwhile, peel, halve, and medium dice onion; place in a medium bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 265010,
            "primary_message": "Trim, seed, and slice bell peppers into thin strips. Remove stems from mushrooms, halve, and cut crosswise into thin strips. Add both to the bowl with the onion.",
            "secondary_message": null
          },
          {
            "id": 265011,
            "primary_message": "When the eggplant is done, remove to a plate and set aside. Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. ",
            "secondary_message": "4 tsp toasted sesame oil"
          },
          {
            "id": 265012,
            "primary_message": "Add onion, bell pepper, and mushrooms to the skillet. Cook, stirring occasionally, until the veggies are almost fork-tender, 5-6 minutes. (Reserve bowl for later use.)",
            "secondary_message": null
          },
          {
            "id": 265013,
            "primary_message": "While the veggies are cooking, drain and rinse the chickpeas in a colander; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 265014,
            "primary_message": "Peel and mince ginger and garlic; place in the reserved bowl along with soy sauce, water, peanut butter, maple syrup, cornstarch, vinegar, oil, chili-garlic sauce, and pepper. Whisk to combine the sauce and set aside.",
            "secondary_message": "2 cloves garlic\n⅓ cup soy sauce\n¼ cup water\n2 tbsp natural peanut butter\n4 tsp pure maple syrup\n1 tbsp cornstarch\n2 tsp rice vinegar\n2 tsp toasted sesame oil\n1 tsp chili-garlic sauce\n½ tsp black pepper"
          },
          {
            "id": 265015,
            "primary_message": "Add chickpeas to the skillet and continue to cook, stirring occasionally, until the veggies are tender and chickpeas are warmed through, 2-3 minutes more.",
            "secondary_message": null
          },
          {
            "id": 265016,
            "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 265017,
            "primary_message": "Add sauce, half of the basil (reserving the rest for garnish), and the cooked eggplant to the skillet. Continue to cook, stirring frequently, until the sauce is thickened and veggies are coated, 1-2 minutes. ",
            "secondary_message": null
          },
          {
            "id": 265018,
            "primary_message": "To serve, divide rice and stir-fry between plates; sprinkle with sesame seeds and reserved basil. Enjoy!",
            "secondary_message": "4 tsp sesame seeds"
          }
        ],
