  "instructions": [
    {
      "id": 323160,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 323161,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lb green beans\n4 medium carrots\n2 (1 inch) pieces ginger root\n2 small bunches green onions (scallions)"
    },
    {
      "id": 323162,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 323163,
      "primary_message": "While the rice cooks, trim and cut green beans into 1-inch pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 323164,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the green beans and set aside.",
      "secondary_message": null
    },
    {
      "id": 323165,
      "primary_message": "Peel and mince ginger and garlic; place both in a small bowl. Add cold water (from the tap), soy sauce, cornstarch, vinegar, and chili-garlic sauce to the bowl; whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "4 cloves garlic\n1 cup water\n¼ cup soy sauce\n2 tbsp cornstarch\n2 tbsp rice vinegar\n2 tsp chili-garlic sauce"
    },
    {
      "id": 323166,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323167,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring often, until starting to soften, 5-6 minutes.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 323168,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 323169,
      "primary_message": "Add beef, salt, and pepper to the skillet with the veggies. Continue to cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 ½ lb lean ground beef\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 323170,
      "primary_message": "Add the stir-fry sauce, half of the green onions, and sesame seeds to the skillet (reserve remaining green onions for the rice). Continue to cook, stirring often, until sauce thickens slightly, 1-2 minutes more.",
      "secondary_message": "2 tsp sesame seeds"
    },
    {
      "id": 323171,
      "primary_message": "When the rice is done, add reserved green onions and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 323172,
      "primary_message": "To serve, divide rice and beef stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
