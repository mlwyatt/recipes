  "instructions": [
    {
      "id": 470695,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 lb cremini mushrooms\n1 bunch Swiss chard\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 lime"
    },
    {
      "id": 470696,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 470697,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the ginger and garlic.",
      "secondary_message": null
    },
    {
      "id": 470698,
      "primary_message": "Preheat a large pot over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 470699,
      "primary_message": "While the pot heats up, fold chard leaves in half lengthwise and slice off the stems. Cut leaves into bite-sized pieces and thinly slice the stems, keeping them separate. Place leaves in another medium bowl, reserving stems for the next step.",
      "secondary_message": null
    },
    {
      "id": 470700,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, mushrooms, chard stems, pork, and spices. Cook, breaking the meat apart with a spoon, until the pork is cooked through and chard stems are tender, about 5 minutes.",
      "secondary_message": "4 tsp neutral vegetable oil\n1 ½ lb lean ground pork\n½ tsp crushed red pepper\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 470701,
      "primary_message": "Add broth, water, soy sauce, and fish sauce to the pot. Stir to combine, cover, and bring to a boil over high heat.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n4 cup water\n3 tbsp soy sauce\n3 tbsp fish sauce"
    },
    {
      "id": 470702,
      "primary_message": "Once the broth is boiling, uncover, add rice noodles, and stir to combine the soup. Reduce heat to medium and simmer, stirring occasionally, until noodles are almost soft, 6-8 minutes.",
      "secondary_message": "6 oz flat rice (pad thai) noodles"
    },
    {
      "id": 470703,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the chard leaves. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 470704,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 470705,
      "primary_message": "When the noodles are almost soft, add chard leaves, cilantro, and green onions to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 470706,
      "primary_message": "Continue to cook until noodles and chard leaves are tender, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 470707,
      "primary_message": "Juice lime into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 470708,
      "primary_message": "To serve, divide soup between bowls, then top with reserved cilantro and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
