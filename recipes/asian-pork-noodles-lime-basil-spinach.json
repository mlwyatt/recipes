  "instructions": [
    {
      "id": 343869,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 343870,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lime\n2 (5 oz) pkgs baby spinach\n1 small pkg fresh basil\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 343871,
      "primary_message": "When the water in the pot comes to a boil, uncover and season the water with salt, then add the pasta (snap the spaghetti into thirds as you add to the water); stir for a few seconds. Cook until desired firmness, 8-10 minutes. Once cooked, drain the pasta in a colander and set aside.",
      "secondary_message": "10 oz spaghetti pasta\n2 tsp salt"
    },
    {
      "id": 343872,
      "primary_message": "Peel and mince or press the garlic. Peel and mince or grate the ginger. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 343873,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 343874,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 343875,
      "primary_message": "Cut the pork sausage open at one end. Sliding your fingers from the sealed to the cut end, squeeze the contents of the sausage into the skillet and discard the casing. Add garlic, and ginger to the skillet. Breaking the sausage apart with a spatula, cook until browned and crumbly, 4-5 minutes.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 343876,
      "primary_message": "Juice the lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 343877,
      "primary_message": "Pick the basil leaves off the stems and discard the stems. ",
      "secondary_message": null
    },
    {
      "id": 343878,
      "primary_message": "Turn the heat down to low and add the spinach and half the basil, stir until the spinach is wilted. ",
      "secondary_message": null
    },
    {
      "id": 343879,
      "primary_message": "Add the pasta, lime juice, fish sauce, salt, and pepper. Cook, stirring constantly, until ingredients are well combined. ",
      "secondary_message": "2 tbsp fish sauce\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 343880,
      "primary_message": "To serve, divide the pasta between bowls and garnish with the remaining basil. Enjoy!",
      "secondary_message": null
    }
  ],
