        "instructions": [
          {
            "id": 247208,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 247209,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 limes\n2 medium carrots\n1 English cucumber\n1 small bunch cilantro\n1 small pkg fresh mint\n1 head butter (Boston) lettuce"
          },
          {
            "id": 247210,
            "primary_message": "Zest and juice limes into a small bowl, stir to combine, and set aside.",
            "secondary_message": null
          },
          {
            "id": 247211,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 247212,
            "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion.",
            "secondary_message": "½ medium red onion"
          },
          {
            "id": 247213,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until soft and golden, about 3 minutes.",
            "secondary_message": "¼ cup toasted sesame oil"
          },
          {
            "id": 247214,
            "primary_message": "Crumble the tofu with your fingers into the skillet. Add half the lime mixture (reserving the rest for the sauce), sugar, chili-garlic sauce, and salt to the skillet; stir to combine. Cook, stirring often, until tofu turns golden brown, about 10 minutes.",
            "secondary_message": "4 tsp brown sugar\n2 tsp chili-garlic sauce\n1 tsp salt"
          },
          {
            "id": 247215,
            "primary_message": "While the tofu is cooking, add soy sauce, sugar, and chili-garlic sauce to the bowl with the reserved lime mixture. Whisk to combine the sauce and set aside.",
            "secondary_message": "2 tbsp soy sauce\n4 tsp brown sugar\n1 tsp chili-garlic sauce"
          },
          {
            "id": 247216,
            "primary_message": "Peel, trim, and thinly slice carrots; place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 247217,
            "primary_message": "Trim and small dice cucumber; add to the bowl with the carrots.",
            "secondary_message": null
          },
          {
            "id": 247218,
            "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl with the veggies. Stir to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 247219,
            "primary_message": "Peel and mince garlic. Roughly chop peanuts.",
            "secondary_message": "2 cloves garlic\n1 cup peanuts, roasted unsalted"
          },
          {
            "id": 247220,
            "primary_message": "When the tofu is golden brown, add garlic and peanuts to the skillet, stir to combine, and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 247221,
            "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with salad and tofu-peanut mixture; drizzle with sauce and enjoy!",
            "secondary_message": null
          }
        ],
