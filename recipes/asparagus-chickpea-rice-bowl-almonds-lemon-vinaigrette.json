        "instructions": [
          {
            "id": 28908,
            "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
            "secondary_message": "1 cup basmati rice\n2 cups water\n¼ tsp salt "
          },
          {
            "id": 28909,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 small bunches asparagus\n1 small bunch green onions (scallions)\n1 lemon"
          },
          {
            "id": 28910,
            "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears on an angle into 2-inch pieces. Transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 28911,
            "primary_message": "Once the water is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 15 to 18 minutes. Remove from the heat and let the rice stand, covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 28912,
            "primary_message": "Peel and halve the shallots lengthwise; thinly slice crosswise.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 28913,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 28914,
            "primary_message": "Drain and rinse the chickpeas.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 28915,
            "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 28916,
            "primary_message": "Add the shallots and chickpeas to the skillet and stir to coat in the oil; cook, stirring occasionally, until the chickpeas are lightly browned and the shallots are softened, 3 to 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 28917,
            "primary_message": "Meanwhile, trim and discard the ends of the green onions; cut the onions on an angle into ¼-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 28918,
            "primary_message": "Add the asparagus and ½ of the onions (save the rest for garnishing) to the skillet; season with salt and pepper. Cook, stirring occasionally, until the asparagus is bright green and tender, 3 to 4 minutes. Once done, remove from the heat.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 28919,
            "primary_message": "Meanwhile, peel and mince the garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 28920,
            "primary_message": "Juice the lemon into a small bowl. Add the minced garlic, olive oil, Dijon, salt, and pepper; whisk together.",
            "secondary_message": "4 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 28921,
            "primary_message": "Measure out the almonds.",
            "secondary_message": "¼ cup almonds, sliced"
          },
          {
            "id": 28922,
            "primary_message": "Divide the rice between bowls and top with the asparagus and chickpea mixture. Sprinkle with the almonds and remaining green onions and drizzle with the dressing. Enjoy!",
            "secondary_message": null
          }
        ],
