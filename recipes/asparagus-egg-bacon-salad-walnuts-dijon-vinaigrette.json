        "instructions": [
          {
            "id": 24376,
            "primary_message": "Place the eggs into a medium saucepan, fill about halfway with water, and bring to a boil. Once boiling, cook them for 5 minutes. Then remove to a bowl and cover with cold water or ice. Keep the saucepan on the burner for cooking the asparagus after.",
            "secondary_message": "8 eggs\r\n"
          },
          {
            "id": 24377,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 24378,
            "primary_message": "Add the bacon to the skillet and cook until crispy, 3-4 minutes per side. Remove to a cutting board.",
            "secondary_message": "8 slices bacon\r\n"
          },
          {
            "id": 24379,
            "primary_message": "Wash the asparagus and snap (or cut) off woody ends. Cut on an angle into 2 inch pieces.",
            "secondary_message": "2 small bunches asparagus\r\n"
          },
          {
            "id": 24380,
            "primary_message": "Once eggs have been removed, add asparagus to the boiling water and cook until tender and bright green, 2-3 minutes. Drain and rinse under cold water to stop it from cooking further. Set aside.",
            "secondary_message": ""
          },
          {
            "id": 24381,
            "primary_message": "In a small bowl, prepare the dressing by whisking together olive oil, vinegar, Dijon, salt, and pepper.",
            "secondary_message": "4 tbsp extra virgin olive oil\r\n4 tsp red wine vinegar\r\n4 tsp Dijon mustard\r\n½ tsp salt\r\n½ tsp black pepper"
          },
          {
            "id": 24382,
            "primary_message": "Roughly chop the walnuts.",
            "secondary_message": "1 cup walnuts\r\n"
          },
          {
            "id": 24383,
            "primary_message": "Peel the eggs and quarter lengthwise. Chop the bacon into smaller pieces.",
            "secondary_message": ""
          },
          {
            "id": 24384,
            "primary_message": "To serve, arrange asparagus, eggs, bacon, and walnuts on a plate and drizzle with dressing. Enjoy!",
            "secondary_message": ""
          }
        ],
