        "instructions": [
          {
            "id": 99923,
            "primary_message": "Peel and small dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 99924,
            "primary_message": "Wash and snap or cut off the woody ends of the asparagus; cut into 2-inch pieces.",
            "secondary_message": "2 small bunches asparagus"
          },
          {
            "id": 99925,
            "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 99926,
            "primary_message": "When skillet is hot, add butter and swirl to coat bottom. Add the onion and garlic; cook, stirring frequently, until softened and lightly browned, 3-4 minutes.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 99927,
            "primary_message": "In a large bowl, whisk together eggs, water, salt, pepper, and half the cheese.",
            "secondary_message": "12 eggs\n¼ cup water\n½ tsp salt\n½ tsp black pepper\n1 (4 oz) pkg crumbled blue cheese"
          },
          {
            "id": 99928,
            "primary_message": "Add more butter to the skillet, followed by the asparagus. Cook, stirring occasionally, for 2-3 minutes.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 99929,
            "primary_message": "Preheat oven to broil and position rack under the broiler.",
            "secondary_message": null
          },
          {
            "id": 99930,
            "primary_message": "Spread out the asparagus evenly in the skillet. Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
            "secondary_message": null
          },
          {
            "id": 99931,
            "primary_message": "Sprinkle with the remaining cheese. Place skillet in the oven until the top is set, 2-3 minutes.",
            "secondary_message": null
          },
          {
            "id": 99932,
            "primary_message": "Roughly chop the pecans.",
            "secondary_message": "1 cup pecans, dry roasted"
          },
          {
            "id": 99933,
            "primary_message": "To serve, cut frittata into wedges and place on a plate; sprinkle with pecans. Enjoy!",
            "secondary_message": null
          }
        ],
