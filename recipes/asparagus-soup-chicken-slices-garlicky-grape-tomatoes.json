        "instructions": [
          {
            "id": 24274,
            "primary_message": "Wash the asparagus and snap (or cut) off the woody ends. Cut off about 2 inches of the tips and reserve in a bowl. Chop the remaining stalks into 1 inch pieces.",
            "secondary_message": "2 small bunches asparagus\r\n"
          },
          {
            "id": 24275,
            "primary_message": "Peel and thinly slice the shallots into rings. Peel and mince the garlic.",
            "secondary_message": "4 shallots\r\n4 cloves garlic"
          },
          {
            "id": 24276,
            "primary_message": "Heat a large pot over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 24277,
            "primary_message": "Add butter to the pot and swirl to coat bottom. Add reserved asparagus tips and cook until slightly softened, 2-3 minutes. Transfer back to the bowl and set aside.",
            "secondary_message": "2 tbsp butter, unsalted\r\n"
          },
          {
            "id": 24278,
            "primary_message": "Once tips have been removed, add more butter to the pot followed by asparagus stalks, shallots, and garlic. Season with salt and pepper. Increase heat to medium-high and cook, stirring occasionally, until softened, 5-6 minutes.",
            "secondary_message": "2 tbsp butter, unsalted\r\n½ tsp salt\r\n½ tsp black pepper"
          },
          {
            "id": 24279,
            "primary_message": "Wash and dry the spinach; set aside.",
            "secondary_message": "1 (5 oz) pkg baby spinach\r\n"
          },
          {
            "id": 24280,
            "primary_message": "Wash the tomatoes. Peel and mince the remaining garlic.",
            "secondary_message": "1 pint grape tomatoes\r\n4 cloves garlic"
          },
          {
            "id": 24281,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 24282,
            "primary_message": "Slice the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 24283,
            "primary_message": "Add oil to skillet and swirl to coat bottom. Add chicken and cook until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate.",
            "secondary_message": "1 tbsp extra virgin olive oil\r\n"
          },
          {
            "id": 24284,
            "primary_message": "Add spinach to the asparagus and mix. Pour in the broth and bring to a boil. Turn heat off and purée with a hand (immersion) blender or transfer to a regular blender.",
            "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n"
          },
          {
            "id": 24285,
            "primary_message": "Add olive oil and garlic to the skillet; cook until fragrant, 15-30 seconds. Reduce heat to low. Add the tomatoes and vinegar; cook, stirring frequently, until the vinegar has thickened slightly and the tomatoes have begun to burst, 4-6 minutes. Remove from heat.",
            "secondary_message": "1 tbsp extra virgin olive oil\r\n6 tbsp balsamic vinegar"
          },
          {
            "id": 24286,
            "primary_message": "Slice chicken on an angle into bite-sized strips.",
            "secondary_message": ""
          },
          {
            "id": 24287,
            "primary_message": "To serve, pour soup into a bowl, scatter the asparagus tips over top, and season with additional salt and pepper if desired. Place chicken slices on the side and top with tomatoes. Enjoy!",
            "secondary_message": ""
          }
        ],
