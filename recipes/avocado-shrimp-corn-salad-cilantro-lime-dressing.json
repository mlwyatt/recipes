        "instructions": [
          {
            "id": 30383,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 pint grape tomatoes\n1 head romaine lettuce\n1 small bunch cilantro\n2 avocados\n2 limes"
          },
          {
            "id": 30384,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals, then set the colander aside, allowing the shrimp to drain. (If using fresh shrimp, skip this step.)",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 30385,
            "primary_message": "Trim off and discard the root end of the lettuce and remove any blemished leaves; quarter the lettuce lengthwise, then chop crosswise into 1-inch pieces. Transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 30386,
            "primary_message": "Halve the grape tomatoes lengthwise; transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 30387,
            "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and medium dice the flesh. Transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 30388,
            "primary_message": "Place the shrimp on a clean towel or paper towels and pat dry, then transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 30389,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add ½ of the cilantro to the shrimp and transfer the other ½ to a small bowl (that you'll use for the dressing).",
            "secondary_message": null
          },
          {
            "id": 30390,
            "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add the garlic to the bowl with the shrimp.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 30391,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 30392,
            "primary_message": "While the skillet heats up, juice the limes; add ½ of the lime juice to the bowl with the shrimp and the other ½ to the bowl with the cilantro.",
            "secondary_message": null
          },
          {
            "id": 30393,
            "primary_message": "Season the shrimp with chili powder, salt, and pepper; toss to combine in the marinade.",
            "secondary_message": "2 tsp chili powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 30394,
            "primary_message": "Once the skillet is heated, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 30395,
            "primary_message": "Add the corn to the skillet and season with salt and pepper. Cook, stirring occasionally, until the corn is lightly browned and tender, 2 to 4 minutes. Once done, transfer to a small bowl.",
            "secondary_message": "2 cups frozen corn\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 30396,
            "primary_message": "Add olive oil, salt, and pepper to the small bowl with the cilantro and lime juice; whisk together and set aside.",
            "secondary_message": "4 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 30397,
            "primary_message": "Once the corn has been transferred, add more coconut oil to the skillet, followed by the shrimp. Cook until they are pink and opaque, 1 to 2 minutes per side. Once done, remove the skillet from the heat.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 30398,
            "primary_message": "To serve, arrange a bed of the chopped romaine on a plate, top with the tomatoes, avocado, corn, and shrimp, and drizzle with the dressing. Enjoy!",
            "secondary_message": null
          }
        ],
