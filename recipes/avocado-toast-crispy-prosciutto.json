  "instructions": [
    {
      "id": 392107,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 392108,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Lay prosciutto in the skillet and cook until it browns slightly, about 1 minute per side. Remove to a plate and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil\n4 slices prosciutto"
    },
    {
      "id": 392109,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 392110,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 392111,
      "primary_message": "Meanwhile, wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and place in a medium bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "2 avocados"
    },
    {
      "id": 392112,
      "primary_message": "Add spices to the bowl with the avocado, then mash once more to combine the spread.",
      "secondary_message": "¼ tsp onion powder\n¼ tsp garlic powder\n¼ tsp black pepper"
    },
    {
      "id": 392113,
      "primary_message": "Divide avocado spread between toast slices and smooth out in an even layer. ",
      "secondary_message": null
    },
    {
      "id": 392114,
      "primary_message": "To serve, divide toast between plates; crumble crispy prosciutto over top. Enjoy!",
      "secondary_message": null
    }
  ],
