        "instructions": [
          {
            "id": 140013,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 140014,
            "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry, then transfer to a medium bowl. Add oil and spices to the bowl with the chickpeas and stir to combine. ",
            "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)\n1 tbsp extra virgin olive oil\n½ tsp paprika\n¼ tsp salt\n⅛ tsp cayenne pepper"
          },
          {
            "id": 140015,
            "primary_message": "Transfer chickpeas to a baking sheet and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until slightly crispy, 15-20 minutes. Reserve bowl for next step.",
            "secondary_message": null
          },
          {
            "id": 140016,
            "primary_message": "Meanwhile, wash and juice lemon into the medium bowl.",
            "secondary_message": "1 lemon"
          },
          {
            "id": 140017,
            "primary_message": "Wash, halve, and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. ",
            "secondary_message": "2 avocados"
          },
          {
            "id": 140018,
            "primary_message": "Add avocado, salt, and garlic powder to the bowl with the lemon juice and mash with a potato masher or fork. ",
            "secondary_message": "¼ tsp salt\n¼ tsp garlic powder"
          },
          {
            "id": 140019,
            "primary_message": "Toast bread if desired.",
            "secondary_message": "8 slices whole grain bread"
          },
          {
            "id": 140020,
            "primary_message": "To serve, divide toasts between dishes. Top with a layer of mashed avocado and a pile of warm roasted chickpeas. Enjoy! ",
            "secondary_message": null
          }
        ],
