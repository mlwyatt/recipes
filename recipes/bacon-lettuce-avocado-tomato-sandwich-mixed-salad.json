  "instructions": [
    {
      "id": 334943,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 medium carrots\n1 head romaine lettuce\n2 tomatoes\n1 avocado"
    },
    {
      "id": 334944,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 334945,
      "primary_message": "Once the skillet is hot, add bacon and cook, turning occasionally, until crispy, 6-8 minutes. Using tongs, transfer bacon to a paper towel-lined plate.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 334946,
      "primary_message": "Meanwhile, juice lemon into a medium bowl; add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 334947,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 334948,
      "primary_message": "Separate lettuce leaves; set aside 1 leaf per sandwich and chop or tear remaining leaves into bite-sized pieces. Add chopped lettuce to the bowl, along with broccoli slaw, and toss to combine the salad; set aside.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 334949,
      "primary_message": "Slice tomatoes into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 334950,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 334951,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 334952,
      "primary_message": "Spread mayo over each bread slice; layer half of the slices with lettuce, tomato, avocado, and bacon. Place remaining slices on top to close sandwiches.",
      "secondary_message": "3 tbsp mayonnaise"
    },
    {
      "id": 334953,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
