  "instructions": [
    {
      "id": 319652,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (8 oz) pkg sugar snap peas\n2 small bunches asparagus\n1 lemon\n1 small pkg fresh mint"
    },
    {
      "id": 319653,
      "primary_message": "Peel, halve, and small dice onion; place in a medium bowl. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 319654,
      "primary_message": "Halve snap peas crosswise. Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces. Add both to the bowl with the onion and set aside. ",
      "secondary_message": null
    },
    {
      "id": 319655,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 319656,
      "primary_message": "While the pot heats up, small dice bacon. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 319657,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 319658,
      "primary_message": "When the bacon is done, add veggies to the pot and cook, stirring occasionally, until starting to soften, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 319659,
      "primary_message": "Add broth and spices to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, about 5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 319660,
      "primary_message": "Meanwhile, using a clean cutting board, cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 319661,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl along with ricotta, salt, and pepper; stir to combine.",
      "secondary_message": "1 (15 oz) pkg ricotta cheese\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 319662,
      "primary_message": "Toast bread if desired; spread with half of the minted ricotta (reserve remaining minted ricotta for the soup).",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 319663,
      "primary_message": "When the soup is done, add the remaining minted ricotta, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 319664,
      "primary_message": "Divide soup between bowls; serve with lemon wedges and toast on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
