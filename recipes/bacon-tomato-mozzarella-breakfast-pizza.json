  "instructions": [
    {
      "id": 96040,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 96041,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 96042,
      "primary_message": "Chop the bacon into bite-sized pieces. Add to the skillet and cook until crispy, 3-4 minutes. When done, use a slotted spoon to transfer bacon to a plate lined with paper towels and pat dry.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 96043,
      "primary_message": "Wash, dry, and slice the tomatoes.",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 96044,
      "primary_message": "Grate cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 96045,
      "primary_message": "Place flatbread on a baking sheet; arrange tomatoes, cheese, and bacon on the flatbread, leaving the center open for the egg.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 96046,
      "primary_message": "Gently break an egg into the center of each flatbread. Bake until the eggs are set, about 8 minutes.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 96047,
      "primary_message": "To serve, transfer pizzas to plates and season with salt and pepper. Enjoy!",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    }
  ],
