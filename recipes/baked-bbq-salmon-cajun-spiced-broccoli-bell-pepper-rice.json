        "instructions": [
          {
            "id": 383734,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 383735,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 383736,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 383737,
            "primary_message": "Meanwhile, pat salmon dry with paper towels. Place on one half of a large baking sheet pan and spread barbecue sauce over top.",
            "secondary_message": "1 ½ lb salmon fillet\n¼ cup barbecue sauce"
          },
          {
            "id": 383738,
            "primary_message": "Wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips. Add bell pepper and broccoli to the other half of the baking sheet.",
            "secondary_message": "2 red bell peppers\n1 (18 oz) bag broccoli florets"
          },
          {
            "id": 383739,
            "primary_message": "Drizzle veggies with oil, then sprinkle with Cajun seasoning and salt. Toss to coat and spread out in an even layer.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp Cajun seasoning\n½ tsp salt"
          },
          {
            "id": 383740,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until veggies are fork-tender and salmon is cooked through, 10-12 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 383741,
            "primary_message": "To serve, divide rice, salmon, and veggies between plates. Enjoy!",
            "secondary_message": null
          }
        ],
