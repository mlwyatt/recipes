  "instructions": [
    {
      "id": 303167,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 303168,
      "primary_message": "Place spices in a medium bowl and stir to combine.",
      "secondary_message": "1 tsp onion powder\n1 tsp garlic powder\n1 tsp rosemary, dried\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 303169,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 303170,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a plate. Sprinkle half of the spices over both sides to coat. (Reserve remaining spice mix for the veggies.)",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 303171,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the chicken and cook until golden brown and almost cooked through, 3-4 minutes per side. Remove to a clean plate and loosely cover with aluminum foil. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 303172,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 caps portobello mushrooms\n2 red bell peppers\n2 crowns broccoli"
    },
    {
      "id": 303173,
      "primary_message": "Remove mushroom stems and carefully scrape out the gills. Medium dice and add to the bowl with the remaining spice mix.",
      "secondary_message": null
    },
    {
      "id": 303174,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 303175,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 303176,
      "primary_message": "Return skillet to medium heat. Add more butter and swirl to coat the bottom; add veggies and remaining spice mix. Cook, stirring occasionally, until veggies soften, 5-7 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 303177,
      "primary_message": "Meanwhile, cut cream cheese into small pieces. Coarsely grate cheddar.",
      "secondary_message": "½ (8 oz) block cream cheese\n½ (8 oz) block cheddar cheese"
    },
    {
      "id": 303178,
      "primary_message": "When the veggies are soft, add cream cheese to the skillet; cook, stirring frequently, until melted and combined. ",
      "secondary_message": null
    },
    {
      "id": 303179,
      "primary_message": "Nestle chicken into the veggies and top with cheddar. Place skillet in the oven and bake until cheese is melted and chicken is cooked through, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 303180,
      "primary_message": "To serve, divide cheesy chicken and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
