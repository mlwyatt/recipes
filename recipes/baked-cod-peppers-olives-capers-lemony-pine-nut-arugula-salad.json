        "instructions": [
          {
            "id": 383167,
            "primary_message": "Preheat oven to 500°F.",
            "secondary_message": null
          },
          {
            "id": 383168,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "2 red bell peppers\n2 orange bell peppers\n2 lemons\n1 (5 oz) pkg baby arugula\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 383169,
            "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 383170,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until peppers are charred in spots, about 15 minutes.",
            "secondary_message": null
          },
          {
            "id": 383171,
            "primary_message": "Meanwhile, halve olives lengthwise. Place in a small bowl along with capers and vinegar; stir to combine and set aside until the peppers are ready.",
            "secondary_message": "½ cup Kalamata olives, pitted\n2 tbsp capers\n2 tsp red wine vinegar"
          },
          {
            "id": 383172,
            "primary_message": "When the peppers are charred, remove from oven. Reduce temperature to 400°F.",
            "secondary_message": null
          },
          {
            "id": 383173,
            "primary_message": "Spoon olive mixture over the peppers and stir to combine; spread back out in an even layer.",
            "secondary_message": null
          },
          {
            "id": 383174,
            "primary_message": "Pat the cod dry with paper towels and arrange on top of the peppers. Drizzle with additional oil, then season with salt and pepper.",
            "secondary_message": "1 ½ lb cod fillet\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 383175,
            "primary_message": "Return baking sheet to the oven and bake until fish flakes easily with a fork, 8-10 minutes.",
            "secondary_message": null
          },
          {
            "id": 383176,
            "primary_message": "Meanwhile, juice one of the lemons into a medium bowl. Cut remaining lemon into wedges and set aside for serving.",
            "secondary_message": null
          },
          {
            "id": 383177,
            "primary_message": "Peel and mince shallot. Add to the bowl with the lemon juice along with additional oil, salt, and pepper. Whisk to combine the dressing.",
            "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 383178,
            "primary_message": "Add arugula and pine nuts to the bowl with the dressing, then toss to combine. Set aside.",
            "secondary_message": "½ cup pine nuts"
          },
          {
            "id": 383179,
            "primary_message": "Using a peeler, shave the Parmesan into curls. Set aside.",
            "secondary_message": "3 oz Parmesan cheese"
          },
          {
            "id": 383180,
            "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. When the fish is done, remove from oven and top with parsley.",
            "secondary_message": null
          },
          {
            "id": 383181,
            "primary_message": "Divide peppers, fish, and salad between plates. Top the salad with Parmesan and serve with lemon wedges for squeezing over the fish. Enjoy!",
            "secondary_message": null
          }
        ],
