  "instructions": [
    {
      "id": 257853,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n2 medium zucchini squash\n1 lb cremini mushrooms\n2 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 257854,
      "primary_message": "Trim and medium dice eggplants and zucchini; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 257855,
      "primary_message": "Thinly slice mushrooms. Roughly chop tomatoes; add both to the bowl with the eggplant and zucchini.",
      "secondary_message": null
    },
    {
      "id": 257856,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257857,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion lengthwise into strips. Peel and mince garlic.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 257858,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring often, until softened, about 3 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 257859,
      "primary_message": "Add veggies and spices to the skillet; reduce heat to medium and cover. Cook, stirring halfway through, until softened, about 10 minutes.",
      "secondary_message": "2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 257860,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 257861,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; set aside.",
      "secondary_message": null
    },
    {
      "id": 257862,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 257863,
      "primary_message": "Split rolls in half and place on a large baking sheet pan, cut-side up. Drizzle with oil and sprinkle with garlic and spices. Place in the oven and broil until toasted, 1-2 minutes; remove from oven.",
      "secondary_message": "4 whole grain buns or rolls\n2 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 257864,
      "primary_message": "When the veggies are ready, stir basil into the ratatouille (reserving a small handful for garnish).",
      "secondary_message": null
    },
    {
      "id": 257865,
      "primary_message": "Using a stirring spoon, make a well for each egg in the ratatouille; crack an egg into each well. Cook until the egg whites are almost cooked through, 2-3 minutes. Cover skillet with a lid and cook for 1 minute more.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 257866,
      "primary_message": "Divide ratatouille and eggs between plates or bowls; top with feta and reserved basil. Serve with garlic toast on the side and enjoy!",
      "secondary_message": "2 (4 oz) pkgs crumbled feta cheese"
    }
  ],
