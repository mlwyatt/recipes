        "instructions": [
          {
            "id": 370489,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 370490,
            "primary_message": "Place hoisin sauce, water, soy sauce, and oil in a large baking dish; stir to combine the sauce.",
            "secondary_message": "½ cup hoisin sauce\n2 tbsp water\n4 tsp soy sauce\n4 tsp toasted sesame oil"
          },
          {
            "id": 370491,
            "primary_message": "Pat chicken dry with paper towels, add to the dish with the sauce, and turn to coat. ",
            "secondary_message": "2 ½ lb chicken drumsticks"
          },
          {
            "id": 370492,
            "primary_message": "Place dish in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until chicken is cooked through, 25-30 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 370493,
            "primary_message": "When the chicken is almost done, place dressing, additional oil, and sesame seeds in a large bowl. Stir to combine the dressing.",
            "secondary_message": "⅓ cup Italian salad dressing\n2 tsp toasted sesame oil\n2 tsp sesame seeds"
          },
          {
            "id": 370494,
            "primary_message": "Wash, dry, and halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing, along with carrots, and toss to combine the salad.",
            "secondary_message": "2 hearts romaine hearts\n1 (10 oz) bag shredded carrots"
          },
          {
            "id": 370495,
            "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
