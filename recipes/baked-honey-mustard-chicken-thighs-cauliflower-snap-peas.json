  "instructions": [
    {
      "id": 374391,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 374392,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 374393,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a plate. Season with salt and pepper.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 374394,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the chicken and cook until golden brown and almost cooked through, 3-4 minutes per side. Remove to a clean plate. (Reserve skillet with cooking juices for the next step.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 374395,
      "primary_message": "Return skillet to medium heat. Add more butter and swirl to coat the bottom. Add cauliflower, snap peas, and spices; cook, stirring occasionally, until veggies begin to soften, 4-5 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n2 (10 oz) bags cauliflower florets\n2 (8 oz) pkg sugar snap peas\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 374396,
      "primary_message": "Nestle chicken into the veggies, then drizzle dressing over the chicken. Place skillet in the oven and bake until chicken is cooked through, 7-8 minutes. Remove from oven.",
      "secondary_message": "½ cup honey mustard dressing"
    },
    {
      "id": 374397,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
