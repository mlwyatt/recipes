        "instructions": [
          {
            "id": 362871,
            "primary_message": "Preheat oven to 450°F. Coat a baking dish with a thin layer of oil and set aside. ",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 362872,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n2 red bell peppers\n1 English cucumber\n1 small bunch green onions (scallions)"
          },
          {
            "id": 362873,
            "primary_message": "Peel and mince ginger; place in a medium bowl along with miso, dressing, water, and oil. Whisk to combine the glaze. ",
            "secondary_message": "¼ cup miso paste, white\n¼ cup honey mustard dressing\n¼ cup water\n2 tsp toasted sesame oil"
          },
          {
            "id": 362874,
            "primary_message": "Pat salmon dry with paper towels, place in the baking dish, and drizzle with half of the glaze. (Reserve bowl with remaining glaze for later use.)",
            "secondary_message": "1 ½ lb salmon fillet"
          },
          {
            "id": 362875,
            "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through, about 10 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 362876,
            "primary_message": "Meanwhile, add additional dressing and oil to the bowl with the remaining glaze; whisk to combine.",
            "secondary_message": "¼ cup honey mustard dressing\n2 tsp toasted sesame oil"
          },
          {
            "id": 362877,
            "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 362878,
            "primary_message": "Trim and medium dice cucumber; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 362879,
            "primary_message": "Trim and cut green onions crosswise into thin pieces; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 362880,
            "primary_message": "Add broccoli slaw and almonds to the bowl, then toss to combine.",
            "secondary_message": "1 (12 oz) pkg broccoli slaw\n¼ cup almonds, sliced"
          },
          {
            "id": 362881,
            "primary_message": "To serve, divide salmon and slaw between plates. Enjoy! ",
            "secondary_message": null
          }
        ],
