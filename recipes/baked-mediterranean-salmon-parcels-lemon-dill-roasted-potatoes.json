        "instructions": [
          {
            "id": 181800,
            "primary_message": "Preheat oven to 425°F. Position racks in the upper and lower thirds of the oven. ",
            "secondary_message": null
          },
          {
            "id": 181801,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "6 medium red potatoes\n2 lemons\n1 small bunch fresh dill"
          },
          {
            "id": 181802,
            "primary_message": "Cut each potato lengthwise into 10-12 thin wedges, then transfer to a large baking sheet pan. Drizzle with oil and season with salt and pepper. ",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 181803,
            "primary_message": "Juice one of the lemons over the potatoes. Slice remaining lemon into thin rounds and set aside.",
            "secondary_message": null
          },
          {
            "id": 181804,
            "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. Sprinkle half of the dill over the potatoes and toss to coat (set remaining dill aside for garnish).",
            "secondary_message": null
          },
          {
            "id": 181805,
            "primary_message": "Place the potatoes on the lower rack of the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until fork-tender, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 181806,
            "primary_message": "Meanwhile, place four 12-inch x 12-inch squares of parchment, side by side, on a flat surface with a corner pointing up (in a diamond shape). If counter space is limited, you can overlap parchment corners by 3-4 inches, leaving a space in the center for each fish fillet.",
            "secondary_message": null
          },
          {
            "id": 181807,
            "primary_message": "Pat the fish dry with paper towels, then place one fillet, skin-side down, on top of each parchment square. Drizzle with oil and season with salt and pepper. ",
            "secondary_message": "1 ½ lb salmon fillet\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 181808,
            "primary_message": "Peel and mince garlic, then sprinkle over each fillet.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 181809,
            "primary_message": "Peel and thinly slice shallot; lay over each fillet.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 181810,
            "primary_message": "Halve the olives lengthwise. Thinly slice sun-dried tomatoes. Sprinkle both over each fillet.",
            "secondary_message": "½ cup Kalamata olives, pitted\n8 sun-dried tomatoes, oil-packed"
          },
          {
            "id": 181811,
            "primary_message": "Layer lemon slices over each fillet. Loosely pull the top and bottom corners of each piece of parchment towards the center, then roll and fold towards the center to seal. Loosely tuck the opposite sides of the parchment underneath each fillet; transfer fish parcels to another baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 181812,
            "primary_message": "Reduce oven to 400°F. Place fish on the upper rack of the oven and bake until opaque and easily flakes with a fork, 12-15 minutes.",
            "secondary_message": null
          },
          {
            "id": 181813,
            "primary_message": "To serve, divide fish parcels and potatoes between plates. Open the parcels, garnish with reserved dill, and enjoy!",
            "secondary_message": null
          }
        ],
