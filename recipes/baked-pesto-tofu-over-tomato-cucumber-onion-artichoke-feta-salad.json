        "instructions": [
          {
            "id": 309019,
            "primary_message": "Preheat oven to 450°F. Coat a large baking sheet pan with a thin layer of oil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 309020,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on another baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 309021,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "2 pints grape tomatoes\n1 English cucumber\n2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 309022,
            "primary_message": "Medium dice tofu and place in a large bowl. Sprinkle with salt, drizzle with pesto, and gently stir to coat.",
            "secondary_message": "½ tsp salt\n½ cup basil pesto"
          },
          {
            "id": 309023,
            "primary_message": "Sprinkle bread crumbs over the tofu and stir once more to coat. Transfer tofu to the baking sheet and spread out in a single layer. (Wipe the bowl clean with paper towels and set aside for the salad.)",
            "secondary_message": "1 cup panko bread crumbs"
          },
          {
            "id": 309024,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, 18-20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 309025,
            "primary_message": "Meanwhile, peel, halve, and thinly slice onion. Place in the reserved bowl, along with vinaigrette, and toss to coat.",
            "secondary_message": "1 medium red onion\n⅓ cup French vinaigrette"
          },
          {
            "id": 309026,
            "primary_message": "Halve tomatoes and add to the bowl with the onion.",
            "secondary_message": null
          },
          {
            "id": 309027,
            "primary_message": "Trim and medium dice cucumber; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 309028,
            "primary_message": "Drain and thinly slice artichokes; add to the bowl.",
            "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
          },
          {
            "id": 309029,
            "primary_message": "Just before serving, add mixed greens and feta to the bowl with the other veggies; toss to combine the salad. ",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 309030,
            "primary_message": "To serve, divide salad between plates or bowls; top with tofu and enjoy!",
            "secondary_message": null
          }
        ],
