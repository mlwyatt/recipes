  "instructions": [
    {
      "id": 363121,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 363122,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 363123,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 363124,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions in half crosswise. Chop the white and pale green parts into 1-inch pieces and transfer to a large baking sheet pan. Thinly slice the dark green parts and set aside for serving.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 363125,
      "primary_message": "Wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips. Add bell pepper and broccoli to the baking sheet with the green onion.",
      "secondary_message": "2 red bell peppers\n1 (18 oz) bag broccoli florets"
    },
    {
      "id": 363126,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch pieces. Add to the baking sheet.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak"
    },
    {
      "id": 363127,
      "primary_message": "Drizzle veggies and steak with stir-fry sauce and oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "½ cup stir-fry sauce\n4 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 363128,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and steak is cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363129,
      "primary_message": "To serve, divide rice, steak, veggies, and sauce between plates. Sprinkle with reserved green onions and sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
