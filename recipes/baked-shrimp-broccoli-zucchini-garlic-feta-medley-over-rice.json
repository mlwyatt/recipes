  "instructions": [
    {
      "id": 232977,
      "primary_message": "Preheat oven to 400°F. ",
      "secondary_message": null
    },
    {
      "id": 232978,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 232979,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 232980,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 232981,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 232982,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 232983,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half rounds. Add to the baking sheet with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 232984,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the baking sheet, reserving a small amount for garnish.",
      "secondary_message": null
    },
    {
      "id": 232985,
      "primary_message": "Juice lemon over the veggies.",
      "secondary_message": null
    },
    {
      "id": 232986,
      "primary_message": "Peel and mince garlic. Add to the baking sheet along with shrimp and spices; toss to combine.",
      "secondary_message": "4 cloves garlic\n1 tsp salt\n1 tsp Italian seasoning\n½ tsp onion powder\n¼ tsp black pepper"
    },
    {
      "id": 232987,
      "primary_message": "Cut butter into small pieces. Sprinkle feta over the shrimp and veggies; dot with butter.",
      "secondary_message": "¼ cup butter, unsalted\n2 (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 232988,
      "primary_message": "Place baking sheet in the oven and bake until veggies are tender and shrimp is cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 232989,
      "primary_message": "To serve, divide rice, shrimp, and veggies between plates. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
