        "instructions": [
          {
            "id": 45774,
            "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line a baking sheet with aluminum foil to make cleanup easier (optional).",
            "secondary_message": null
          },
          {
            "id": 45775,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium spaghetti squash\n2 bunches kale"
          },
          {
            "id": 45776,
            "primary_message": "Halve the squash lengthwise and scrape out the seeds; Rub each half with olive oil and season with salt and freshly ground pepper. Place halves, cut side down, on a baking sheet.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 45778,
            "primary_message": "Place the squash in the oven (it doesn't have to be fully heated) and roast until tender so a knife can easily pierce though the flesh, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 45779,
            "primary_message": "Drain and rinse the cannellini beans in a colander, then set aside to drain further.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 45780,
            "primary_message": "Cut out and discard the stems from each kale leaf; chop the leaves crosswise into 1-inch strips. Transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 45781,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 45782,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 45783,
            "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 45784,
            "primary_message": "Add the garlic and crushed red pepper to the skillet and stir until fragrant, 15-30 seconds.",
            "secondary_message": "¼ tsp crushed red pepper"
          },
          {
            "id": 45785,
            "primary_message": "Add the kale and ¼ cup of water to the skillet; cook, stirring constantly, until the kale is wilted, 2-3 minutes. Remove from the heat.",
            "secondary_message": ""
          },
          {
            "id": 45786,
            "primary_message": "Add the beans to the skillet and season the mixture with salt and pepper. Cook, stirring frequently, until the beans are just heated through, 1-2 minutes.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 45787,
            "primary_message": "Remove the squash from the oven; allow squash to cool slightly, about 5 minutes. Using a fork, scrape up the squash flesh to make spaghetti-like strings (use an oven mitt or towel to hold it with your other hand).",
            "secondary_message": null
          },
          {
            "id": 45788,
            "primary_message": "Finely grate 1 cup of Parmesan.",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 45789,
            "primary_message": "To serve, divide the bean and kale mixture between the squash halves. Alternatively, spoon out the squash and divide between plates, then top with the bean and kale mixture. Sprinkle with the Parmesan. Enjoy!",
            "secondary_message": null
          }
        ],
