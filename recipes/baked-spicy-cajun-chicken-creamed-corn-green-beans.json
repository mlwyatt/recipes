        "instructions": [
          {
            "id": 157737,
            "primary_message": "Preheat oven to 450°F. Line a large baking sheet with aluminum foil. ",
            "secondary_message": null
          },
          {
            "id": 157738,
            "primary_message": "Combine flour and spices in a large bowl.",
            "secondary_message": "2 tbsp all-purpose flour\n1 tbsp paprika\n2 tsp garlic powder\n2 tsp onion powder\n2 tsp thyme\n1 tsp salt\n1 tsp black pepper\n½ tsp cayenne pepper"
          },
          {
            "id": 157739,
            "primary_message": "Coat chicken with oil. Add drumsticks one by one to the bowl with the spices, rolling and pressing to adhere on all sides. Place chicken on the baking sheet.",
            "secondary_message": "1 ½ lb chicken drumsticks\n2 tbsp extra virgin olive oil"
          },
          {
            "id": 157740,
            "primary_message": "Place baking sheet in the oven and bake, turning once, until cooked through, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 157741,
            "primary_message": "Meanwhile, heat a medium saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 157742,
            "primary_message": "Add corn to the colander and rinse under hot water for several minutes to defrost. Set aside to drain.",
            "secondary_message": "3 cups frozen corn"
          },
          {
            "id": 157743,
            "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom.",
            "secondary_message": "2 tsp butter, unsalted"
          },
          {
            "id": 157744,
            "primary_message": "Add flour and whisk until smooth. Slowly add cream, whisking to make sure no lumps form. Stir in corn, salt, and pepper. Cover pan; remove from heat and set aside.",
            "secondary_message": "2 tsp all-purpose flour\n4 fl oz (½ cup) heavy cream\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 157745,
            "primary_message": "Wash green beans and trim ends.",
            "secondary_message": "1 lb green beans"
          },
          {
            "id": 157746,
            "primary_message": "Heat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 157747,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
            "secondary_message": "2 tsp butter, unsalted"
          },
          {
            "id": 157748,
            "primary_message": "Add green beans to the skillet and season with salt and pepper. Cook, tossing frequently, until bright green and tender-crisp, 4-5 minutes. Remove from the heat.",
            "secondary_message": "½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 157749,
            "primary_message": "To serve, divide the chicken, creamed corn, and green beans between plates. Enjoy!",
            "secondary_message": null
          }
        ],
