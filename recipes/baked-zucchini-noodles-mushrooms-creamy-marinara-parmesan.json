        "instructions": [
          {
            "id": 424163,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 424164,
            "primary_message": "Wash, dry, and trim zucchini; use a julienne (or regular) peeler, make noodles. Divide noodles and mushrooms between two baking sheet pans. Drizzle with oil and season with spices; toss to combine and spread out in an even layer.",
            "secondary_message": "8 medium zucchini squash\n2 (8 oz) pkgs sliced white mushrooms\n3 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 424165,
            "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tender, 10-15 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 424166,
            "primary_message": "Meanwhile, place marinara sauce and cream in a medium saucepan. Bring to a simmer over medium heat, stirring occasionally. Once simmering, remove from heat and cover to keep warm.",
            "secondary_message": "1 (24 oz) jar marinara sauce\n8 fl oz (1 cup) heavy whipping cream"
          },
          {
            "id": 424167,
            "primary_message": "To serve, divide zucchini noodles and mushrooms between plates or bowls; top with sauce and Parmesan. Enjoy!",
            "secondary_message": "1 cup Parmesan cheese, shredded"
          }
        ],
