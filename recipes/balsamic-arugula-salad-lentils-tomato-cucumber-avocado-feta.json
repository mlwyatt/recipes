        "instructions": [
          {
            "id": 399175,
            "primary_message": "Peel, halve, and small dice onion. Place in a large bowl. ",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 399176,
            "primary_message": "Drain and rinse lentils. Add to the bowl with the onion.",
            "secondary_message": "2 (15 oz) cans lentils"
          },
          {
            "id": 399177,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "2 pints grape tomatoes\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley\n2 avocados\n2 (5 oz) pkgs baby arugula"
          },
          {
            "id": 399178,
            "primary_message": "Halve tomatoes lengthwise and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 399179,
            "primary_message": "Trim and small dice cucumber. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 399180,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 399181,
            "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 399182,
            "primary_message": "Add feta and vinaigrette to the bowl, then stir to combine the salad.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese\n½ cup balsamic vinaigrette"
          },
          {
            "id": 399183,
            "primary_message": "To serve, divide arugula between plates or bowls; top with the lentil salad. Enjoy!",
            "secondary_message": null
          }
        ],
