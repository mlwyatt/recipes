  "instructions": [
    {
      "id": 249230,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 bunch radish\n2 (5 oz) pkgs baby arugula"
    },
    {
      "id": 249231,
      "primary_message": "Juice lemon into a large bowl; add oil, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp pure maple syrup\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 249232,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 249233,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces; season with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 249234,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and sauté, stirring occasionally, until cooked through, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 249235,
      "primary_message": "Meanwhile, crumble goat cheese into a small bowl and add cranberries; stir to combine and set aside.",
      "secondary_message": "1 (4 oz) log goat cheese\n¼ cup dried cranberries"
    },
    {
      "id": 249236,
      "primary_message": "Using a clean cutting board, peel, halve, and slice onion into thin half-moons.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 249237,
      "primary_message": "When the chicken is done, use a slotted spoon to transfer it to a plate (leaving cooking juices in the skillet).",
      "secondary_message": null
    },
    {
      "id": 249238,
      "primary_message": "Return skillet to medium-high heat. Add the onion and cook, stirring occasionally, until softened, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 249239,
      "primary_message": "While the onion is cooking, trim off and discard tops and root ends of radishes; cut into matchsticks and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 249240,
      "primary_message": "Add vinegar and sugar to the skillet with the onion; continue to cook, stirring constantly, until the vinegar is reduced, 1-2 minutes. Return chicken to the skillet (along with any accumulated juices), stir to combine, and remove from heat.",
      "secondary_message": "¼ cup balsamic vinegar\n1 tsp brown sugar"
    },
    {
      "id": 249241,
      "primary_message": "Add arugula to the bowl with the dressing and radish; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 249242,
      "primary_message": "Place tortillas on a flat surface and divide balsamic chicken between them; top with a small amount of salad and sprinkle with the goat cheese-cranberry mixture. Roll tightly to close and cut in half. ",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 249243,
      "primary_message": "Divide wraps and remaining salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
