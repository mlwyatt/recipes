        "instructions": [
          {
            "id": 44445,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "6 tomatoes\n1 small pkg fresh basil"
          },
          {
            "id": 44446,
            "primary_message": "Preheat a grill pan or regular skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 44447,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a medium bowl (that will be used to marinade the chicken).",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 44448,
            "primary_message": "To the garlic, add olive oil, balsamic vinegar, salt, and pepper; whisk together.",
            "secondary_message": "1 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 44449,
            "primary_message": "Pat dry the chicken breasts with paper towels and place in the bowl with the marinade; turn to coat.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 44450,
            "primary_message": "Carefully place the chicken breasts in the grill pan / skillet; cook until the chicken is golden brown and cooked through (check doneness with a thermometer or cut into the chicken with a knife), 6 to 8 minutes per side. Once done, transfer the chicken to plate.",
            "secondary_message": null
          },
          {
            "id": 44451,
            "primary_message": "Slice the tomatoes crosswise into ¼-inch-thick rounds and arrange on a large plate.",
            "secondary_message": null
          },
          {
            "id": 44452,
            "primary_message": "Tear the mozzarella into small chunks with your hands and add on top of the tomato slices.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 44453,
            "primary_message": "Pick the basil leaves off the stems; tear the leaves into small pieces with your hands and scatter on top of the tomato slices and mozzarella chunks.",
            "secondary_message": ""
          },
          {
            "id": 44454,
            "primary_message": "Drizzle the salad with olive oil and season with salt and pepper.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 44455,
            "primary_message": "Slice the chicken crosswise into strips.",
            "secondary_message": null
          },
          {
            "id": 44456,
            "primary_message": "To serve, divide the salad and chicken slices between plates. Enjoy!",
            "secondary_message": null
          }
        ],
