        "instructions": [
          {
            "id": 186007,
            "primary_message": "Peel, halve, and thinly slice the onions into half rings.",
            "secondary_message": "2 medium yellow onions"
          },
          {
            "id": 186008,
            "primary_message": "Preheat a medium saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 186009,
            "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onions and salt; cook, stirring occasionally, until soft and caramelized, 15-20 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 186010,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "4 caps portobello mushrooms\n1 head romaine lettuce\n2 tomatoes\n1 English cucumber"
          },
          {
            "id": 186011,
            "primary_message": "Peel and mince garlic; place in a large bowl along with oil, vinegar, and Italian seasoning. Whisk to combine the marinade.",
            "secondary_message": "4 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n2 tsp Italian seasoning"
          },
          {
            "id": 186012,
            "primary_message": "Remove mushroom stems and carefully scrape out the gills. Add to the bowl with the marinade and turn to coat. Set aside.",
            "secondary_message": null
          },
          {
            "id": 186013,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 186014,
            "primary_message": "While the skillet heats up, combine mayo, oil, Dijon, garlic powder, and salt in a small bowl. Whisk to combine the aioli and set aside.",
            "secondary_message": "¼ cup mayonnaise\n2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp garlic powder\n½ tsp salt"
          },
          {
            "id": 186015,
            "primary_message": "Once the skillet is hot, add mushrooms and cook until soft, 3-5 minutes per side. (Reserve bowl with leftover marinade for the next step.) When mushrooms are cooked, slice the cheese, place on top of mushroom caps, and reduce heat to low. Cover and let cook until cheese melts, 2-3 minutes. Remove from heat.",
            "secondary_message": "⅔ (8 oz) block mozzarella cheese"
          },
          {
            "id": 186016,
            "primary_message": "Meanwhile, add oil, vinegar, honey, Dijon, and salt to the bowl with leftover marinade. Whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp balsamic vinegar\n1 tsp honey\n1 tsp Dijon mustard\n¼ tsp salt"
          },
          {
            "id": 186017,
            "primary_message": "Separate the lettuce leaves. Set aside 1 large leaf per burger; chop or tear remaining leaves into bite-sized pieces and add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 186018,
            "primary_message": "Medium dice one tomato and add to the salad bowl. Thinly slice remaining tomato and set aside.",
            "secondary_message": null
          },
          {
            "id": 186019,
            "primary_message": "Trim and medium dice the cucumber; add to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 186020,
            "primary_message": "Toast buns if desired. Spread aioli on bottom half of each bun; layer with reserved lettuce, tomato, mushrooms, and caramelized onions. Close with the top half. ",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 186021,
            "primary_message": "To serve, divide burgers and salad between plates and enjoy!",
            "secondary_message": null
          }
        ],
