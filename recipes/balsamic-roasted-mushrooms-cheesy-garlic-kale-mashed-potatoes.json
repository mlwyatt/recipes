  "instructions": [
    {
      "id": 268272,
      "primary_message": "Preheat the oven to 450°F. Line a large baking sheet with aluminum foil (for easy clean-up). ",
      "secondary_message": null
    },
    {
      "id": 268273,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lb cremini mushrooms\n1 ½ lb new potatoes\n1 bunch kale\n1 small bunch Italian (flat-leaf) parsley\n1 small bunch green onions (scallions)"
    },
    {
      "id": 268274,
      "primary_message": "Peel the garlic. Mince 2 cloves and add to a small bowl; set the other cloves aside.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 268275,
      "primary_message": "Add oil, vinegar, maple syrup, soy sauce, and spices to the bowl with the garlic; whisk to combine the sauce.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ cup balsamic vinegar\n2 tbsp pure maple syrup\n2 tbsp soy sauce\n½ tsp thyme, dried\n½ tsp salt"
    },
    {
      "id": 268276,
      "primary_message": "Quarter mushrooms and place on the baking sheet. Drizzle with sauce and stir to coat, then spread out in an even layer. Place in the oven and bake, stirring halfway through, until tender, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 268277,
      "primary_message": "Large dice the potatoes. Transfer potatoes and remaining garlic cloves to a large pot, cover with water, put on the lid, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "id": 268278,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems, then thinly slice crosswise into shreds.",
      "secondary_message": null
    },
    {
      "id": 268279,
      "primary_message": "Once the water in the pot is boiling, remove the lid and cook until the potatoes are almost done, about 8 minutes. Add kale to the pot and cook 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 268280,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 268281,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 268282,
      "primary_message": "Once potatoes, garlic, and kale are done, drain and return to the pot. ",
      "secondary_message": null
    },
    {
      "id": 268283,
      "primary_message": "Add oil, milk, yogurt, parsley, and spices to the pot with the potatoes and mash until almost smooth. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 fl oz (½ cup) whole milk\n½ cup plain Greek yogurt\n½ tsp onion powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 268284,
      "primary_message": "Stir cheese into the mashed potatoes and return to medium-high heat. Cook, stirring constantly, until melted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 268285,
      "primary_message": "Trim off the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 268286,
      "primary_message": "To serve, divide mashed potatoes between bowls. Spoon mushrooms and their cooking juices over the potatoes and sprinkle with green onion. Enjoy!",
      "secondary_message": null
    }
  ],
