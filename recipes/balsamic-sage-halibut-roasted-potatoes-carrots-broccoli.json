        "instructions": [
          {
            "id": 474242,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 474243,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium carrots\n4 medium red potatoes\n2 crowns broccoli"
          },
          {
            "id": 474244,
            "primary_message": "Peel, trim, and slice carrots crosswise into ½-inch thick rounds. Transfer to a large baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 474245,
            "primary_message": "Medium dice potatoes and add to the baking sheet with the carrot. Drizzle with oil and season with spices; stir to coat and spread out in an even layer.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 474246,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until potatoes and carrots are starting to soften, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 474247,
            "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a medium bowl, drizzle with additional oil, and season with salt; toss to coat.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 474248,
            "primary_message": "When the potatoes and carrots are starting to soften, remove baking sheet from the oven. Add broccoli and stir to combine. Return baking sheet to the oven and continue to roast until veggies are fork-tender, 12-15 minutes more. Remove from oven. (Reserve bowl for later use.)",
            "secondary_message": null
          },
          {
            "id": 474249,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 474250,
            "primary_message": "While the skillet heats up, pat halibut dry with paper towels and place on a plate. Season both sides with salt and pepper.",
            "secondary_message": "1 ½ lb halibut fillet\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 474251,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add halibut and pan-fry, turning once, until fish is cooked through, about 10 minutes. Remove to a clean plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 474252,
            "primary_message": "While the fish is cooking, peel and mince garlic. Place in the reserved bowl along with vinegar, oil, water, maple syrup, and spices. Stir to combine the sauce.",
            "secondary_message": "4 cloves garlic\n¼ cup balsamic vinegar\n4 tsp extra virgin olive oil\n2 tsp water\n2 tsp pure maple syrup\n1 tsp sage, dried\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 474253,
            "primary_message": "Return skillet to medium heat. Add sauce and cook, stirring constantly, until reduced by half, about 1 minute. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 474254,
            "primary_message": "To serve, divide halibut and roasted veggies between plates. Drizzle fish with sauce and enjoy!",
            "secondary_message": null
          }
        ],
