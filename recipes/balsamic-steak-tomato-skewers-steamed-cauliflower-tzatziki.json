        "instructions": [
          {
            "id": 386503,
            "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 386504,
            "primary_message": "Wash and dry tomatoes; set aside.",
            "secondary_message": "2 pints grape tomatoes"
          },
          {
            "id": 386505,
            "primary_message": "Pat steak dry with paper towels and cut into 1-inch cubes.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak"
          },
          {
            "id": 386506,
            "primary_message": "Thread the steak and tomatoes onto skewers, alternating ingredients; place on a plate. Drizzle with vinaigrette and season with salt and pepper. (If you don't have skewers, you can cook the steak and tomatoes directly on the grill pan.)",
            "secondary_message": "¼ cup balsamic vinaigrette\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 386507,
            "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 386508,
            "primary_message": "Once the grill pan is hot, working in batches if necessary, add the skewers. Cook, turning occasionally, until the steak reaches desired doneness and tomatoes are starting to burst, 6-10 minutes. Remove to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 386509,
            "primary_message": "Meanwhile, fill a large pot with about 1-inch of hot water (from the tap). Cover and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 386510,
            "primary_message": "Once the water is boiling, add cauliflower. Re-cover and cook until tender, about 5 minutes; drain and return to the pot. Drizzle with oil, season with spices, and toss to combine; cover to keep warm.",
            "secondary_message": "2 (10 oz) bags cauliflower florets\n4 tsp extra virgin olive oil\n½ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 386511,
            "primary_message": "Using a clean cutting board, peel and mince shallot.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 386512,
            "primary_message": "Divide skewers and cauliflower between plates, then sprinkle with shallots; serve with tzatziki on the side for dipping. Enjoy!",
            "secondary_message": "1 cup tzatziki sauce"
          }
        ],
