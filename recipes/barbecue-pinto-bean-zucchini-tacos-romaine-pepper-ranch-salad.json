        "instructions": [
          {
            "id": 417418,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium zucchini squash\n2 hearts romaine hearts\n2 yellow bell peppers"
          },
          {
            "id": 417419,
            "primary_message": "Trim and small dice zucchini. Set aside.",
            "secondary_message": null
          },
          {
            "id": 417420,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 417421,
            "primary_message": "While the skillet heats up, drain and rinse the beans in a colander.",
            "secondary_message": "2 (15 oz) cans pinto beans"
          },
          {
            "id": 417422,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini, beans, and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
            "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 417423,
            "primary_message": "Meanwhile, halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 417424,
            "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the lettuce, along with dressing, and toss to combine the salad. Set aside.",
            "secondary_message": "¼ cup ranch dressing"
          },
          {
            "id": 417425,
            "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
            "secondary_message": "12 small flour tortillas"
          },
          {
            "id": 417426,
            "primary_message": "When the zucchini and beans are done, add barbecue sauce to the skillet and stir to combine. Remove from heat.",
            "secondary_message": "½ cup barbecue sauce"
          },
          {
            "id": 417427,
            "primary_message": "Divide tortillas between plates and fill with bean mixture, cheese, and a small portion of the salad. Serve with remaining salad on the side and enjoy!",
            "secondary_message": "1 cup shredded cheese, Mexican blend"
          }
        ],
