        "instructions": [
          {
            "id": 428486,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 428487,
            "primary_message": "Place pesto, oil, salt, and pepper in a small bowl, then stir to combine. Set aside.",
            "secondary_message": "½ cup basil pesto\n¼ cup extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 428488,
            "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut crosswise into 2-inch pieces. Divide between two baking sheet pans.",
            "secondary_message": "1 small bunch asparagus"
          },
          {
            "id": 428489,
            "primary_message": "Wash, dry, and add tomatoes to the baking sheets with the asparagus.",
            "secondary_message": "2 pints grape tomatoes"
          },
          {
            "id": 428490,
            "primary_message": "Peel, halve, and medium dice onions. Add to the baking sheets along with the mushrooms and gnocchi. Drizzle with the pesto oil, stir to combine, and spread out in an even layer.",
            "secondary_message": "2 medium red onions\n2 (8 oz) pkgs sliced white mushrooms\n2 (16 oz) pkgs potato gnocchi"
          },
          {
            "id": 428491,
            "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are tender and gnocchi is golden, about 25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 428492,
            "primary_message": "To serve, divide gnocchi bake between plates or bowls and top with Parmesan. Enjoy!",
            "secondary_message": "½ cup Parmesan cheese, shredded"
          }
        ],
