  "instructions": [
    {
      "id": 369295,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 369296,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n2 medium zucchini squash\n2 pints grape tomatoes"
    },
    {
      "id": 369297,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 2-inch pieces. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 369298,
      "primary_message": "Trim and medium dice zucchini. Add to the baking sheet with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 369299,
      "primary_message": "Halve tomatoes and add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 369300,
      "primary_message": "Pat chicken dry with paper towels and large dice. Add to the baking sheet.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 369301,
      "primary_message": "Drizzle veggies and chicken with oil, then season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 369302,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender and chicken is cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 369303,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and return to the pot. Cover and set aside to keep warm.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 369304,
      "primary_message": "When the veggies and chicken are done, carefully transfer them to the pot with the pasta. Add the pesto and stir to combine.",
      "secondary_message": "½ cup basil pesto"
    },
    {
      "id": 369305,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
