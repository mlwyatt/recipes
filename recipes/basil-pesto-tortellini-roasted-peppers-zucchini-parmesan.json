  "instructions": [
    {
      "id": 424251,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 424252,
      "primary_message": "Wash, dry, trim, and medium dice zucchini. Transfer to a large baking sheet pan.",
      "secondary_message": "4 medium zucchini squash"
    },
    {
      "id": 424253,
      "primary_message": "Peel, halve, and slice onions lengthwise into thin pieces. Add to the baking sheet with the zucchini.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 424254,
      "primary_message": "Drain and roughly chop roasted peppers, then add to the baking sheet. Drizzle veggies with oil and season with spices; stir to combine and spread out in an even layer. ",
      "secondary_message": "1 (12 oz) jar roasted red bell peppers\n2 tbsp extra virgin olive oil\n1 tsp oregano, dried\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 424255,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until zucchini are golden and fork-tender, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 424256,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "18 oz cheese tortellini, fresh or frozen"
    },
    {
      "id": 424257,
      "primary_message": "When the tortellini is done, drain and return to the pot. Cover and set aside to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 424258,
      "primary_message": "When the veggies are done, remove from the oven. Add roasted veggies and pesto to the pot with the tortellini; stir to combine.",
      "secondary_message": "⅔ cup basil pesto"
    },
    {
      "id": 424259,
      "primary_message": "To serve, divide pasta between plates or bowls and top with Parmesan. Enjoy!",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
