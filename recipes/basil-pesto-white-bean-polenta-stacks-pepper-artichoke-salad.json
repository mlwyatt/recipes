        "instructions": [
          {
            "id": 423309,
            "primary_message": "Preheat oven to 450°F. Coat a large baking sheet pan with a thin layer of oil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 423310,
            "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Transfer to the baking sheet, arranging the slices in a single layer.",
            "secondary_message": "2 (18 oz) tubes polenta, pre-cooked"
          },
          {
            "id": 423311,
            "primary_message": "Place polenta in the oven (it doesn't have to be fully heated) while you prepare the topping.",
            "secondary_message": null
          },
          {
            "id": 423312,
            "primary_message": "Drain and rinse beans. Place in a large bowl along with pesto, salt, and pepper; stir to combine.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans\n½ cup basil pesto\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 423313,
            "primary_message": "Remove baking sheet from the oven. Spoon the bean topping over the polenta slices, then top with cheese. (Wipe bowl clean with paper towels and reserve for later use.)",
            "secondary_message": "1 cup shredded cheese, Italian blend"
          },
          {
            "id": 423314,
            "primary_message": "Return baking sheet to the oven and bake until polenta stacks are warmed through and cheese is melted, 6-7 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 423315,
            "primary_message": "Meanwhile, wash and dry spring mix (skip if it came pre-washed). Place in the reserved bowl along with the carrots.",
            "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n1 (10 oz) bag shredded carrots"
          },
          {
            "id": 423316,
            "primary_message": "Drain and roughly chop artichokes and roasted peppers. Add both to the bowl with the mixed greens, along with the dressing, and toss to combine the salad.",
            "secondary_message": "2 (6 oz) jars artichoke hearts, marinated\n1 (12 oz) jar roasted red bell peppers\n¼ cup Italian salad dressing"
          },
          {
            "id": 423317,
            "primary_message": "To serve, divide polenta stacks and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
