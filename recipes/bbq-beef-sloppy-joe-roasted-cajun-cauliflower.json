  "instructions": [
    {
      "id": 382208,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 382209,
      "primary_message": "Place cauliflower on a baking sheet pan, drizzle with oil, then sprinkle with Cajun seasoning and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 (10 oz) bags cauliflower florets\n4 tsp extra virgin olive oil\n2 tsp Cajun seasoning\n⅛ tsp salt"
    },
    {
      "id": 382210,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is golden and fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 382211,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 382212,
      "primary_message": "Once the skillet is hot, add beef, salt, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "1 ½ lb lean ground beef\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 382213,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 382214,
      "primary_message": "When the beef is done, add barbecue sauce and stir to combine. Continue to cook until heated through and slightly thickened, 1-2 minutes more. Cover with a lid and remove from heat.",
      "secondary_message": "1 cup barbecue sauce"
    },
    {
      "id": 382215,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 382216,
      "primary_message": "When the cauliflower is done, remove from the oven, add parsley, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 382217,
      "primary_message": "Place bottom half of each bun on a plate. Top with barbecue beef, then close with the top half of the buns. Serve roasted cauliflower on the side. Enjoy!",
      "secondary_message": null
    }
  ],
