  "instructions": [
    {
      "id": 222576,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 222577,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onion; transfer to a baking sheet pan.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 222578,
      "primary_message": "Wash, dry, seed, and medium dice bell peppers; add to the baking sheet.",
      "secondary_message": "2 yellow bell peppers"
    },
    {
      "id": 222579,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to combine and spread out in an even layer. Place veggies in the oven and bake until tender, 12-15 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 222580,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 222581,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 222582,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and small dice.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 222583,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and chicken to the skillet and sauté until golden brown and cooked through, 8-10 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 222584,
      "primary_message": "While the chicken is cooking, place tomato sauce, ketchup, Dijon, sugar, vinegar, Worcestershire, and spices in a medium bowl. Whisk to combine.",
      "secondary_message": "1 (8 oz) can tomato sauce\n2 tbsp ketchup\n2 tbsp Dijon mustard\n4 tsp brown sugar\n4 tsp apple cider vinegar\n4 tsp Worcestershire sauce\n1 tsp salt\n1 tsp onion powder\n½ tsp chili powder"
    },
    {
      "id": 222585,
      "primary_message": "Pour sauce into the skillet with the chicken. (Reserve bowl for later use). Stir and bring to a simmer over high heat. Reduce heat to medium-low and cook, stirring occasionally, until thickened, 5-6 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 222586,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 222587,
      "primary_message": "Wash, dry, and, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 222588,
      "primary_message": "When the veggies are done, carefully transfer them to the bowl used for the sauce and set aside.",
      "secondary_message": null
    },
    {
      "id": 222589,
      "primary_message": "Place pitas on the baking sheet. Return to oven and toast for 5 minutes.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 222590,
      "primary_message": "Top toasted pitas with saucy chicken, cheese, and veggies. Return pitas to the oven and bake until the cheese melts, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 222591,
      "primary_message": "To serve, divide pitas between plates, top with cilantro, and enjoy!",
      "secondary_message": null
    }
  ],
