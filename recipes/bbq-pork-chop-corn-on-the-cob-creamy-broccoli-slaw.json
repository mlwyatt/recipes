        "instructions": [
          {
            "id": 330998,
            "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 330999,
            "primary_message": "Meanwhile, remove husks and silks from corn; set aside.",
            "secondary_message": "4 ears corn"
          },
          {
            "id": 331000,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 331001,
            "primary_message": "While the grill pan heats up, pat the pork chops dry with paper towels and place on a plate. Season both sides with salt and pepper, then coat with BBQ sauce. ",
            "secondary_message": "4 pork chops, bone-in\n½ tsp salt\n½ tsp black pepper\n3 tbsp barbecue sauce"
          },
          {
            "id": 331002,
            "primary_message": "Once the grill pan is hot, coat with butter; working in batches if necessary, add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate and coat with additional BBQ sauce.",
            "secondary_message": "2 tsp butter, unsalted\n¼ cup barbecue sauce"
          },
          {
            "id": 331003,
            "primary_message": "Once the water is boiling, uncover the pot and reduce heat to medium; use tongs to lower the corn into the water and cook until just tender, about 5 minutes. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 331004,
            "primary_message": "Meanwhile, wash and dry parsley, then shave leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with dressing and mayo; whisk to combine.",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n3 tbsp honey mustard dressing\n4 tsp mayonnaise"
          },
          {
            "id": 331005,
            "primary_message": "Add broccoli slaw to the bowl with dressing and stir to combine.",
            "secondary_message": "1 (12 oz) pkg broccoli slaw"
          },
          {
            "id": 331006,
            "primary_message": "To serve, divide pork chops, corn, and slaw between plates; spread corn with butter and sprinkle with salt. Enjoy!",
            "secondary_message": "4 tsp butter, unsalted\n¼ tsp salt"
          }
        ],
