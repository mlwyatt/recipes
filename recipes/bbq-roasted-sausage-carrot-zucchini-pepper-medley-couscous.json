  "instructions": [
    {
      "id": 336155,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 336156,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 yellow bell peppers\n2 medium zucchini squash"
    },
    {
      "id": 336157,
      "primary_message": "Peel, trim, and cut carrots crosswise into thin rounds; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 336158,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheet with the carrot.",
      "secondary_message": null
    },
    {
      "id": 336159,
      "primary_message": "Trim and slice zucchini crosswise into thin rounds; add to the baking sheet. Drizzle veggies with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 336160,
      "primary_message": "Add sausages to the baking sheet, nestling them into the veggies.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 336161,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender and sausages are cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 336162,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 336163,
      "primary_message": "While the couscous is cooking, place tomato sauce, Dijon, vinegar, Worcestershire, sugar, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "1 (8 oz) can tomato sauce\n2 tbsp Dijon mustard\n4 tsp apple cider vinegar\n4 tsp Worcestershire sauce\n4 tsp brown sugar\n1 tsp salt\n1 tsp onion powder\n½ tsp chili powder"
    },
    {
      "id": 336164,
      "primary_message": "When the sausages and veggies are done, transfer sausages to a cutting board and slice crosswise into thin rounds. ",
      "secondary_message": null
    },
    {
      "id": 336165,
      "primary_message": "Return sausages to the baking sheet with the veggies; drizzle with BBQ sauce, toss to combine, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 336166,
      "primary_message": "Return baking sheet to the oven and continue to roast until veggies and sauce are caramelized, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 336167,
      "primary_message": "To serve, divide sausage, veggies, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
