  "instructions": [
    {
      "id": 175885,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 175886,
      "primary_message": "Wash and cut cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower. ",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 175887,
      "primary_message": "Place cauliflower, broth, polenta, and salt in a medium saucepan. Stir and bring to a boil over high heat. Cover and reduce heat to medium-low; cook, stirring occasionally, until polenta is soft and the mixture has thickened, 20-25 minutes.",
      "secondary_message": "28 fl oz (3 ½ cups) chicken or vegetable broth\n½ cup polenta (cornmeal)\n½ tsp salt"
    },
    {
      "id": 175888,
      "primary_message": "Meanwhile, place tomato sauce, ketchup, Dijon, sugar, vinegar, Worcestershire, and spices in a small saucepan. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, for 6 minutes. Remove from heat and set aside.",
      "secondary_message": "1 (8 oz) can tomato sauce\n2 tbsp ketchup\n2 tbsp Dijon mustard\n2 tbsp brown sugar\n4 tsp apple cider vinegar\n4 tsp Worcestershire sauce\n1 tsp salt\n1 tsp garlic powder\n1 tsp onion powder\n½ tsp chili powder\n½ tsp paprika"
    },
    {
      "id": 175889,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 175890,
      "primary_message": "Wash, dry, trim, and medium dice zucchini.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 175891,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 175892,
      "primary_message": "Add zucchini and corn to the skillet; cook, stirring occasionally, until vegetables are lightly browned and softened, 5-7 minutes. ",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 175893,
      "primary_message": "Meanwhile, combine spices in a medium bowl. Add shrimp and toss to coat.",
      "secondary_message": "½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 175894,
      "primary_message": "Add shrimp to the skillet with the veggies; cook until opaque, 4-5 minutes. Pour the sauce into the skillet and toss to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 175895,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 175896,
      "primary_message": "Add cheese and butter to the pan with the cauliflower grits and stir to melt and combine. Remove from heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 175897,
      "primary_message": "To serve, divide cauliflower grits between plates or bowls. Top with vegetables and shrimp. Enjoy!",
      "secondary_message": null
    }
  ],
