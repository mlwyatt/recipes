  "instructions": [
    {
      "id": 332256,
      "primary_message": "Place vinegar, ketchup, sugar, Worcestershire, Dijon, and spices in a small saucepan; stir to combine the BBQ sauce.",
      "secondary_message": "½ cup balsamic vinegar\n½ cup ketchup\n4 tsp brown sugar\n1 tbsp Worcestershire sauce\n1 tbsp Dijon mustard\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 332257,
      "primary_message": "Bring sauce to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until thickened, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 332258,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; slice lengthwise into ¼-inch thick strips. Place in a medium bowl.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 332259,
      "primary_message": "Wash, dry, and slice mushrooms into ½-inch thick pieces; add to the bowl with the bell pepper.",
      "secondary_message": "4 caps portobello mushrooms"
    },
    {
      "id": 332260,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 332261,
      "primary_message": "While the grill pan heats up, peel, halve, and slice onion lengthwise into ¼-inch thick pieces; add to the bowl with the other veggies. Drizzle with oil, season with spices, and toss to coat.",
      "secondary_message": "1 medium red onion\n4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 332262,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add veggies and cook, turning occasionally, until tender, 8-10 minutes. Transfer veggies to a plate and loosely cover with aluminum foil. (Reserve bowl for the next step).",
      "secondary_message": null
    },
    {
      "id": 332263,
      "primary_message": "Meanwhile, mince sun-dried tomatoes and capers; place both in the reserved bowl.",
      "secondary_message": "8 sun-dried tomatoes, oil-packed\n3 tbsp capers"
    },
    {
      "id": 332264,
      "primary_message": "Add beef and spices to the bowl with sun-dried tomatoes and capers; mix with your hands until well combined. Form the beef mixture into 4 equal-sized patties and place on another plate.",
      "secondary_message": "1 ½ lb lean ground beef\n2 tsp parsley flakes\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 332265,
      "primary_message": "Once the veggies are done, return the grill pan to medium-high heat and coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 2-3 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 332266,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 332267,
      "primary_message": "To assemble the burgers, layer the bottom half of each bun with a patty, BBQ sauce, and a small portion of grilled veggies; close with the top half of each bun. (Reserve remaining veggies for serving.)",
      "secondary_message": null
    },
    {
      "id": 332268,
      "primary_message": "To serve, divide burgers and remaining veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
