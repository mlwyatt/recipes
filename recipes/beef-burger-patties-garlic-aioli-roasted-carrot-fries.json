        "instructions": [
          {
            "id": 48473,
            "primary_message": "Preheat the oven to 475°F.",
            "secondary_message": null
          },
          {
            "id": 48474,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "1 (5 oz) pkg baby arugula\n8 medium carrots\n1 lemon"
          },
          {
            "id": 48475,
            "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Halve the carrots crosswise, then cut into ¼-inch-thick sticks.",
            "secondary_message": null
          },
          {
            "id": 48476,
            "primary_message": "Place the carrots on a sheet pan. Drizzle with olive oil and season with salt and pepper; toss to thoroughly coat, then arrange in a single, even layer.",
            "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 48477,
            "primary_message": "Place the carrots in the oven and roast, stirring halfway through, until browned and tender when pierced with a fork, 15 to 20 minutes. Remove from the oven.",
            "secondary_message": null
          },
          {
            "id": 48478,
            "primary_message": "Trim off and discard the ends of the shallots; peel and mince the shallots. Transfer to a medium bowl.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 48479,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 48480,
            "primary_message": "To the bowl with the shallot, add ground beef, salt, and pepper. Using your hands, mix well, then form into 4 equal patties.",
            "secondary_message": "1 ½ lb lean ground beef\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 48481,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 48482,
            "primary_message": "Place the burger patties in the skillet and cook until browned and cooked to your desired degree of doneness, 3 to 5 minutes per side. Transfer to a plate.",
            "secondary_message": ""
          },
          {
            "id": 48483,
            "primary_message": "Juice the lemon and divide the juice between a small bowl and a large salad bowl.",
            "secondary_message": ""
          },
          {
            "id": 48484,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the small bowl with the lemon juice.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 48485,
            "primary_message": "Add mayonnaise to the lemon juice and garlic; mix together.",
            "secondary_message": "4 tbsp mayonnaise"
          },
          {
            "id": 48486,
            "primary_message": "Add olive oil, Dijon, salt, and pepper to the salad bowl with the lemon juice; whisk together.",
            "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 48487,
            "primary_message": "Add the arugula to the salad bowl and toss to coat in the dressing.",
            "secondary_message": null
          },
          {
            "id": 48488,
            "primary_message": "To serve, divide the arugula salad, burger patties, carrot fries, and aioli between plates. Enjoy!",
            "secondary_message": null
          }
        ],
