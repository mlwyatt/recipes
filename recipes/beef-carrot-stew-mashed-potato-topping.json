        "instructions": [
          {
            "id": 33423,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium carrots\n4 medium yellow potatoes\n1 small pkg fresh thyme"
          },
          {
            "id": 33424,
            "primary_message": "Peel and halve the potatoes crosswise; transfer to a medium saucepan.",
            "secondary_message": null
          },
          {
            "id": 33425,
            "primary_message": "Cover the potatoes with hot water (from the tap) by about 1 inch; bring the water to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 33426,
            "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Medium dice the carrots (cut into ½-inch cubes) and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 33427,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces) and add to the bowl with the carrots.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 33428,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add the garlic to the bowl with the other vegetables.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 33429,
            "primary_message": "Once the water in the saucepan is boiling, cook the potatoes until they are tender when pierced with a knife, 10 to 12 minutes.",
            "secondary_message": ""
          },
          {
            "id": 33430,
            "primary_message": "Preheat a sauté pan over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 33431,
            "primary_message": "While the pan heats up, pat the beef dry with paper towels, then cut into 1-inch chunks; transfer to a medium bowl.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak"
          },
          {
            "id": 33432,
            "primary_message": "Season the beef with salt and pepper; toss to coat.",
            "secondary_message": "1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 33433,
            "primary_message": "Add the beef cubes to the pan in a single layer; cook, stirring occasionally, until the beef is browned but not fully cooked through, 4 to 5 minutes. Once done, transfer the beef to a bowl.",
            "secondary_message": null
          },
          {
            "id": 33434,
            "primary_message": "While the beef cooks, wash and dry the cutting board and knife.",
            "secondary_message": null
          },
          {
            "id": 33435,
            "primary_message": "Once the beef has been transferred, add butter to the pan, followed by the onions, carrots, and garlic. Cook, stirring occasionally, until the carrots begin to soften, 3 to 4 minutes.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 33436,
            "primary_message": "Add Worcestershire sauce, salt, and pepper to the sauté pan; stir to combine.",
            "secondary_message": "2 tsp Worcestershire sauce\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 33437,
            "primary_message": "Return the beef to the pan, then sprinkle the beef and vegetables with flour and stir to combine.",
            "secondary_message": "2 tbsp all-purpose flour"
          },
          {
            "id": 33438,
            "primary_message": "Add tomato paste and broth to the pan and stir to combine; increase the heat to high and bring the liquid to a simmer. Once simmering, reduce the heat to medium, cover the pan with a lid, and cook until the carrots are tender and the liquid is reduced, about 10 minutes.",
            "secondary_message": "2 tbsp tomato paste\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 33439,
            "primary_message": "One by one, holding a sprig of thyme at its top, run you fingers down it to remove the leaves. Discard the sprigs and chop the leaves; stir about ¾ of the thyme into the stew and save the rest for garnishing.",
            "secondary_message": ""
          },
          {
            "id": 33440,
            "primary_message": "Once the potatoes are tender, drain most of the water, but leave some for mashing. Add butter, salt, and pepper; mash with a potato masher until smooth.",
            "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 33441,
            "primary_message": "To serve, spoon the stew into a bowl, top with scoops of mashed potatoes, and garnish with the remaining thyme. Enjoy!",
            "secondary_message": null
          }
        ],
