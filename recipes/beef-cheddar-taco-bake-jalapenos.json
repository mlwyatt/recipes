  "instructions": [
    {
      "id": 332545,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 332546,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 332547,
      "primary_message": "Peel and small dice onions. Seed and small dice bell peppers.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 332548,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332549,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 332550,
      "primary_message": "Add onions and bell peppers to the skillet; cook, stirring frequently, until veggies begin to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 332551,
      "primary_message": "Add beef and spices to the skillet and, breaking apart with a spoon, cook until beef is browned and crumbly, 5-6 minutes. Remove from heat and let cool slightly.",
      "secondary_message": "1 ½ lb lean ground beef\n2 tsp chili powder\n1 ½ tsp salt\n1 tsp cumin, ground\n1 tsp garlic powder\n1 tsp onion powder"
    },
    {
      "id": 332552,
      "primary_message": "Meanwhile, grate cheese.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 332553,
      "primary_message": "Wash and thinly slice jalapeños. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 332554,
      "primary_message": "Whisk eggs in a large bowl.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 332555,
      "primary_message": "Add beef mixture to the bowl with the eggs and stir to combine. Spread mixture into an even layer in the bottom of a medium baking dish. Top with cheese and jalapeño slices.",
      "secondary_message": null
    },
    {
      "id": 332556,
      "primary_message": "Place baking dish in the oven; cook until egg is set and cheese is melted and bubbly, about 22 minutes.",
      "secondary_message": null
    },
    {
      "id": 332557,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 332558,
      "primary_message": "To serve, divide taco bake between plates and top with yogurt and cilantro. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
