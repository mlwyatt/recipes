  "instructions": [
    {
      "id": 39980,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 39981,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 39982,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 39983,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces) and transfer to a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 39984,
      "primary_message": "Add the ground beef to the skillet and cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer the beef to a bowl, leaving some of the juices in the skillet.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 39985,
      "primary_message": "Once the beef has been transferred, add the onion to the skillet; cook, stirring occasionally, while you prep the bell peppers.",
      "secondary_message": ""
    },
    {
      "id": 39986,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Small dice the peppers and add to the onion.",
      "secondary_message": null
    },
    {
      "id": 39987,
      "primary_message": "When the water in the saucepan comes to a boil, uncover the pan and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions). Once done, drain the pasta in a colander.",
      "secondary_message": "2 tbsp salt\n10 oz (about 2 ¼ cups) macaroni pasta"
    },
    {
      "id": 39988,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add the garlic to the skillet. Cook the vegetables, stirring frequently, until softened, 2 to 3 more minutes.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 39989,
      "primary_message": "Return the beef to the skillet and season with chili powder, cumin, salt, and pepper.",
      "secondary_message": "2 tbsp chili powder\n1 tsp cumin\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 39990,
      "primary_message": "Add the diced tomatoes to the skillet and bring the mixture to a simmer; cook until the pasta is ready.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 39991,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Add about ¾ of the onions to the sauce and save the rest for garnishing.",
      "secondary_message": null
    },
    {
      "id": 39992,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 39993,
      "primary_message": "Add the drained pasta and cheese to the sauce; stir until the cheese is melted.",
      "secondary_message": null
    },
    {
      "id": 39994,
      "primary_message": "To serve, divide the chili mac between bowls and top with the remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
