        "instructions": [
          {
            "id": 235497,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 235498,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 235499,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb cremini mushrooms\n6 baby bok choy\n2 (1 inch) pieces ginger root"
          },
          {
            "id": 235500,
            "primary_message": "Thinly slice steak against the grain into strips. Transfer to a medium bowl, add soy sauce, and toss to combine; set aside to marinate.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n¼ cup soy sauce"
          },
          {
            "id": 235501,
            "primary_message": "Meanwhile, using a clean cutting board, thinly slice mushrooms; transfer to another medium bowl.",
            "secondary_message": null
          },
          {
            "id": 235502,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 235503,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak strips to the skillet and stir-fry until just cooked through, about 5 minutes.",
            "secondary_message": "4 tsp virgin coconut oil"
          },
          {
            "id": 235504,
            "primary_message": "Meanwhile, trim ends and separate bok choy into leaves.",
            "secondary_message": null
          },
          {
            "id": 235505,
            "primary_message": "When the steak strips are done, transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 235506,
            "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until starting to brown, about 3 minutes. (Reserve bowl for the next step.)",
            "secondary_message": "4 tsp virgin coconut oil"
          },
          {
            "id": 235507,
            "primary_message": "While the mushrooms cook, slice white stems of the bok choy crosswise into thin strips; chop or tear leaves into bite-sized pieces. Transfer leaves to the reserved bowl.",
            "secondary_message": null
          },
          {
            "id": 235508,
            "primary_message": "Add bok choy stems to the skillet and stir to combine. Cook, stirring occasionally, until veggies are fork-tender, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 235509,
            "primary_message": "Meanwhile, peel and mince ginger and garlic; add to the skillet and stir-fry until fragrant, about 30 seconds.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 235510,
            "primary_message": "Add bok choy leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful.",
            "secondary_message": null
          },
          {
            "id": 235511,
            "primary_message": "Return steak strips (and any accumulated juices) to the skillet along with soy sauce and vinegar; stir to combine and remove from heat.",
            "secondary_message": "2 tbsp soy sauce\n2 tsp rice vinegar"
          },
          {
            "id": 235512,
            "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
