        "instructions": [
          {
            "id": 46657,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 (5 oz) pkg baby spinach\n1 small pkg fresh basil"
          },
          {
            "id": 46658,
            "primary_message": "Add broth to a medium saucepan; cover and bring to a boil over high heat.",
            "secondary_message": "40 fl oz (5 cups) chicken or vegetable broth"
          },
          {
            "id": 46659,
            "primary_message": "Finely grate 1 cup of Parmesan and transfer to a small bowl.",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 46660,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 46661,
            "primary_message": "In a large bowl, combine the ground beef, eggs, breadcrumbs, ¾ of the Parmesan, ½ of the garlic, oregano, salt, and pepper; mix to combine.",
            "secondary_message": "1 ½ lb lean ground beef\n2 eggs\n½ cup panko bread crumbs\n½ tsp oregano\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 46662,
            "primary_message": "Once the liquid is boiling, slowly add the polenta in a thin steady stream while whisking constantly until all the polenta is incorporated into the liquid. Turn the heat down to low and continue whisking until the polenta has thickened. Cover the polenta and cook for 20 to 25 minutes, stirring every 10 minutes or so.",
            "secondary_message": "1 cup polenta (cornmeal)"
          },
          {
            "id": 46663,
            "primary_message": "Preheat a sauté pan over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 46664,
            "primary_message": "While the pan heats up, form the beef mixture into 20 to 24 equal-sized meatballs and transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 46665,
            "primary_message": "Once the pan is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 46666,
            "primary_message": "Add the meatballs to the pan; cook, turning occasionally, until they are browned but not cooked through, 4 to 6 minutes. Transfer the meatballs to a bowl, leaving the drippings in the pan.",
            "secondary_message": ""
          },
          {
            "id": 46667,
            "primary_message": "While the meatballs cook, pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons.",
            "secondary_message": null
          },
          {
            "id": 46668,
            "primary_message": "Once the meatballs have been transferred, add the remaining garlic and the diced tomatoes to the pan; bring to a boil. Reduce the heat to a simmer and crush some of the tomatoes with a potato masher; season the sauce with salt and pepper.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 46669,
            "primary_message": "Return the meatballs to the pan and stir in about ¾ of the basil ribbons (save the rest for garnishing); cook until the meatballs are cooked through and the sauce is slightly thickened, 8 to 10 minutes.",
            "secondary_message": ""
          },
          {
            "id": 46670,
            "primary_message": "Roughly chop the spinach leaves and stir into the meatball and sauce mixture.",
            "secondary_message": null
          },
          {
            "id": 46671,
            "primary_message": "Add butter to the polenta and season with salt and pepper; stir to combine.",
            "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 46672,
            "primary_message": "To serve, divide the polenta between bowls, top with the meatballs and tomato sauce, and garnish with the remaining basil and Parmesan. Enjoy!",
            "secondary_message": null
          }
        ],
