        "instructions": [
          {
            "id": 259972,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 259973,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "8 medium carrots\n2 lb cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 259974,
            "primary_message": "Peel and trim carrots. Slice in half crosswise, then lengthwise into ½-inch thick sticks. Place in a large bowl along with oil, honey, salt, and pepper; toss to coat.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 259975,
            "primary_message": "Transfer carrots to a large baking sheet pan and spread out in a single layer. Place in the oven (it doesn't have to be fully heated) and roast until fork-tender, 20-25 minutes. (Reserve bowl for the next step.)",
            "secondary_message": null
          },
          {
            "id": 259976,
            "primary_message": "Meanwhile, mince half the mushrooms and place in the reserved bowl. Thinly slice remaining mushrooms, place in a small bowl, and set aside.",
            "secondary_message": null
          },
          {
            "id": 259977,
            "primary_message": "Add beef, Worcestershire, salt, and pepper to the bowl with the minced mushrooms; mix with your hands until well combined. Form the mixture into 4 equal-sized patties and place on a plate.",
            "secondary_message": "1 ½ lb lean ground beef\n1 tsp Worcestershire sauce\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 259978,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 259979,
            "primary_message": "Once the skillet is hot, add the burger patties and cook, undisturbed, for 5 minutes. Flip patties and continue to cook until cooked through, 4-5 minutes more. Transfer to a clean plate, loosely cover with aluminum foil, and set aside. (Reserve skillet for later use.)",
            "secondary_message": null
          },
          {
            "id": 259980,
            "primary_message": "Meanwhile, peel, halve, and thinly slice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 259981,
            "primary_message": "Return skillet to medium heat; add oil and swirl to coat the bottom. Add onion, garlic, and salt; cook, stirring occasionally, until the onion begins to soften, 3-4 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 259982,
            "primary_message": "Add sliced mushrooms to the skillet and cook, stirring occasionally, until they begin to soften, 3-4 minutes.",
            "secondary_message": null
          },
          {
            "id": 259983,
            "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 259984,
            "primary_message": "Sprinkle flour into the skillet and stir to combine. Add broth and bring to a simmer; continue to cook, stirring often, until the sauce thickens, 3-4 minutes.",
            "secondary_message": "2 tsp all-purpose flour\n8 fl oz (1 cup) chicken or vegetable broth"
          },
          {
            "id": 259985,
            "primary_message": "Once the sauce has thickened, remove from the heat. Add yogurt, Worcestershire, and half the parsley (reserving the rest for the carrots); stir to combine.",
            "secondary_message": "¼ cup plain Greek yogurt\n1 tsp Worcestershire sauce"
          },
          {
            "id": 259986,
            "primary_message": "Once the carrots are done, remove from the oven, sprinkle with reserved parsley, and toss to combine.",
            "secondary_message": null
          },
          {
            "id": 259987,
            "primary_message": "Toast buns if desired.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 259988,
            "primary_message": "Place bottom half of each bun on a plate, then top with burgers and mushroom sauce. Close with the top half of the bun and serve with roasted carrots on the side. Enjoy!",
            "secondary_message": null
          }
        ],
