  "instructions": [
    {
      "id": 14401,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": ""
    },
    {
      "id": 14402,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 14403,
      "primary_message": "Cut tortillas into 8 triangles and place on a baking sheet pan. Drizzle with olive oil and season with salt and pepper. Toss to coat, then spread out in a single layer.",
      "secondary_message": "4 small corn tortillas\n1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 14404,
      "primary_message": "Place in the oven and bake until golden and crispy, 10-12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 14405,
      "primary_message": "Add beef to the skillet and, breaking apart with a spoon, cook until browned and crumbly, 2-3 minutes.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 14406,
      "primary_message": "Add chili powder, cumin, salt, and pepper to the beef. Reduce heat to medium, stir, and cook for another 1-2 minutes. Remove from heat.",
      "secondary_message": "1 tbsp chili powder\r\n1 tsp cumin\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 14407,
      "primary_message": "Wash and dry lettuce. Halve lengthwise, then chop crosswise into thin (shred-like) strips. Wash and medium dice tomatoes.",
      "secondary_message": "1 head romaine lettuce\n2 tomatoes"
    },
    {
      "id": 14408,
      "primary_message": "Grate 1 cup of cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 14409,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, ketchup, olive oil, vinegar, honey, Worcestershire, onion powder, paprika, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\n2 tbsp ketchup\r\n4 tbsp extra virgin olive oil\r\n2 tbsp red wine vinegar\r\n2 tsp honey\r\n¼ tsp Worcestershire sauce\r\n½ tsp onion powder\r\n¼ tsp paprika\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 14410,
      "primary_message": "To serve, place lettuce in a bowl, crush tortilla chips on top, and add beef and tomatoes. Sprinkle with cheddar and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
