  "instructions": [
    {
      "id": 332639,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 332640,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332641,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 332642,
      "primary_message": "Add onion and garlic to the skillet; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 332643,
      "primary_message": "Add ground beef and spices to the skillet; cook, breaking apart with a spoon, until crumbly and cooked through, 6-7 minutes.",
      "secondary_message": "1 ½ lb lean ground beef\n4 tsp chili powder\n1 tsp salt\n1 tsp cumin, ground\n½ tsp garlic powder\n½ tsp onion powder"
    },
    {
      "id": 332644,
      "primary_message": "Meanwhile, wash and dry tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom; sprinkle with salt.",
      "secondary_message": "8 tomatoes\n½ tsp salt"
    },
    {
      "id": 332645,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 332646,
      "primary_message": "Wash and dry lettuce. Stack leaves, one on top of the other, halve lengthwise, then chop crosswise into thin (shred-like) strips.",
      "secondary_message": "1 head butter (Boston) lettuce"
    },
    {
      "id": 332647,
      "primary_message": "To serve, divide tomatoes between plates. Stuff with beef and top with cheese, lettuce, and yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
