  "instructions": [
    {
      "id": 456362,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456363,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 456364,
      "primary_message": "Once the pot is hot, add onion and beef; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 456365,
      "primary_message": "Add broth, frozen veggies, tomatoes, Worcestershire, and spices to the pot, then stir to combine the soup. Cover and bring to a boil over high heat. Once boiling, reduce heat to low and simmer until the veggies are soft, about 10 minutes. Remove from heat.",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n5 cups frozen mixed vegetables (carrots, corn, green beans, peas)\n2 (14.5 oz) cans diced tomatoes\n4 tsp Worcestershire sauce\n1 ½ tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 456366,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 456367,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
