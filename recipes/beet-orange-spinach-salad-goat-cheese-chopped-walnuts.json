        "instructions": [
          {
            "id": 8312,
            "primary_message": "Preheat oven to 500°F.",
            "secondary_message": ""
          },
          {
            "id": 8313,
            "primary_message": "Wash, trim root ends, peel, and thinly slice beets into half rounds. Transfer to a sheet pan, drizzle with oil, and season with salt and pepper.",
            "secondary_message": "4 beets\r\n2 tsp extra virgin olive oil\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 8314,
            "primary_message": "Place in the oven and roast until beets are tender, 20 minutes.",
            "secondary_message": ""
          },
          {
            "id": 8315,
            "primary_message": "Wash and dry spinach and oranges. Peel and thinly slice oranges into half rounds.",
            "secondary_message": "1 (5 oz) pkg baby spinach\r\n4 oranges"
          },
          {
            "id": 8316,
            "primary_message": "In a medium bowl, prepare dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
            "secondary_message": "6 tbsp extra virgin olive oil\r\n2 tsp balsamic vinegar\r\n½ tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 8317,
            "primary_message": "Crumble goat cheese into a medium bowl. Roughly chop walnuts.",
            "secondary_message": "1 (5 oz) pkg goat cheese\r\n½ cup walnuts"
          },
          {
            "id": 8318,
            "primary_message": "To serve, arrange a bed of spinach on a plate and top with beet and orange slices. Sprinkle with goat cheese, walnuts, and drizzle with dressing. Enjoy!",
            "secondary_message": ""
          }
        ],
