  "instructions": [
    {
      "id": 245220,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 245221,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "4 medium beets\n1 lime\n2 small bunches cilantro\n2 jalapeño peppers\n2 oranges\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 245222,
      "primary_message": "Peel, trim, and slice beets into ¼-inch thick rounds. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 245223,
      "primary_message": "Drizzle beets with oil and season with salt and pepper; toss to coat, then arrange in a single layer. Place baking sheet in the oven (it doesn't have to be fully heated) and roast until beets are tender, 15-20 minutes. Remove from oven.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245224,
      "primary_message": "Meanwhile, set goat cheese on the counter to soften.",
      "secondary_message": "2 (4 oz) logs goat cheese"
    },
    {
      "id": 245225,
      "primary_message": "Juice lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 245226,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with oil, sugar, cumin, and salt; whisk to combine the lime mixture.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n1 tsp brown sugar\n1 tsp cumin, ground\n½ tsp salt"
    },
    {
      "id": 245227,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime mixture. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 245228,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the jalapeño-cilantro sauce; set aside.",
      "secondary_message": null
    },
    {
      "id": 245229,
      "primary_message": "Peel and mince additional garlic. Place in a large bowl along with oil, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n4 tsp balsamic vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245230,
      "primary_message": "Peel and thinly slice shallot into rings. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 245231,
      "primary_message": "Cut off skin and white pith from the oranges; slice between the membranes to release segments. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 245232,
      "primary_message": "Split rolls in half and place on another large baking sheet, cut-side facing up. Place in the oven and bake until lightly toasted, 3-4 minutes. Remove from oven.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 245233,
      "primary_message": "Roughly chop almonds. Add to the salad bowl along with the mixed greens; toss to combine the salad.",
      "secondary_message": "¼ cup almonds"
    },
    {
      "id": 245234,
      "primary_message": "Divide toasted rolls between plates; spread each with a thick layer of goat cheese, then top with roasted beets and jalapeño-cilantro sauce. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
