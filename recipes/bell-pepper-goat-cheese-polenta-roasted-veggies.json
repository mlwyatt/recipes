        "instructions": [
          {
            "id": 217881,
            "primary_message": "Preheat oven to 400°F. Line a large baking sheet pan with parchment paper.",
            "secondary_message": null
          },
          {
            "id": 217882,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 lb sweet potatoes\n2 crowns broccoli\n1 red bell pepper\n1 small pkg chives"
          },
          {
            "id": 217883,
            "primary_message": "Peel and small dice sweet potatoes; transfer to the baking sheet.",
            "secondary_message": null
          },
          {
            "id": 217884,
            "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; add to the baking sheet.",
            "secondary_message": null
          },
          {
            "id": 217885,
            "primary_message": "Peel and medium dice onion; add to the baking sheet.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 217886,
            "primary_message": "Drizzle oil over veggies and season with salt and pepper; toss to coat, then spread out in an even layer. Place in the oven and bake until veggies are fork-tender, about 25 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 217887,
            "primary_message": "Pour broth into a medium saucepan, cover, and bring to a boil over high heat.",
            "secondary_message": "40 fl oz (5 cups) chicken or vegetable broth"
          },
          {
            "id": 217888,
            "primary_message": "Meanwhile, trim, seed, and mince bell pepper; add to the pan with the boiling broth.",
            "secondary_message": null
          },
          {
            "id": 217889,
            "primary_message": "Reduce heat to low and gradually add polenta to the pan in a thin steady stream, while whisking constantly, until the polenta is incorporated into the broth. Cook, stirring occasionally, until grains are soft and the texture is creamy, 15-25 minutes.",
            "secondary_message": "1 cup polenta (cornmeal)"
          },
          {
            "id": 217890,
            "primary_message": "Meanwhile, crumble goat cheese into a small bowl.",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 217891,
            "primary_message": "Chop chives into small pieces.",
            "secondary_message": null
          },
          {
            "id": 217892,
            "primary_message": "When the polenta is done, add oil, goat cheese, and half of the chives to the pan and stir until smooth.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 217893,
            "primary_message": "To serve, divide polenta and veggies between bowls. Top with remaining chives and enjoy!",
            "secondary_message": null
          }
        ],
