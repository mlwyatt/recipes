  "instructions": [
    {
      "id": 208147,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "1 cup basmati rice"
    },
    {
      "id": 208148,
      "primary_message": "Peel and mince garlic and onion. ",
      "secondary_message": "4 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 208149,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208150,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, onion, and spices; cook, stirring occasionally, until veggies begin to soften, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp turmeric\n½ tsp cumin\n½ tsp coriander\n½ tsp salt\n⅛ tsp cinnamon"
    },
    {
      "id": 208151,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 lime\n2 (1 inch) pieces ginger root\n1 jalapeño pepper\n1 small pkg fresh mint\n1 small bunch cilantro"
    },
    {
      "id": 208152,
      "primary_message": "Once the veggies are soft, add broth to the pot and bring to a boil. ",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 208153,
      "primary_message": "Once the broth comes to a boil, add rice, stir the mixture, cover the pot, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 208154,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 208155,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208156,
      "primary_message": "Drain and rinse the chickpeas. ",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 208157,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower, chickpeas, broth, and spices; cook, stirring occasionally, until cauliflower is tender, 10-12 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 fl oz (½ cup) chicken or vegetable broth\n1 tsp salt\n1 tsp turmeric\n½ tsp cumin\n½ tsp coriander"
    },
    {
      "id": 208158,
      "primary_message": "Meanwhile, juice lime into a medium bowl. Peel and mince ginger; add to the bowl along with the sugar. Whisk to combine.",
      "secondary_message": "4 tsp brown sugar"
    },
    {
      "id": 208159,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 208160,
      "primary_message": "Pick mint and cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the chutney.",
      "secondary_message": null
    },
    {
      "id": 208161,
      "primary_message": "To serve, divide rice and veggies between bowls. Top with chutney and cashews. Enjoy! ",
      "secondary_message": "½ cup cashews, roasted unsalted"
    }
  ],
