        "instructions": [
          {
            "id": 28631,
            "primary_message": "Drain the beans (but don't rinse them) and transfer to a large bowl. Use a potato masher or fork to mash them until they are mostly broken up, but there are still some whole beans left.",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 28632,
            "primary_message": "Coarsely grate the onion and add to the bowl.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 28633,
            "primary_message": "Add the bread crumbs, chili powder, salt, and pepper to the beans and onion; stir until the mixture is combined.",
            "secondary_message": "½ cup panko bread crumbs\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 28634,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 28635,
            "primary_message": "Form the bean mixture into four patties.",
            "secondary_message": null
          },
          {
            "id": 28636,
            "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 28637,
            "primary_message": "Place the patties in the skillet and cook until they are browned and heated through, 4 to 5 minutes per side. Once done, transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 28638,
            "primary_message": "Toast the buns if desired.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 28639,
            "primary_message": "Wash and dry the fresh produce. (Skip the greens if they came pre-washed.)",
            "secondary_message": "2 avocados\n2 limes\n1 pint grape tomatoes\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 28640,
            "primary_message": "Halve and pit the avocados; medium dice the flesh while it's still in the skin, then scoop out into a small bowl.",
            "secondary_message": ""
          },
          {
            "id": 28641,
            "primary_message": "Add juice of 1 lime to the avocados and season with salt and pepper; mash with a fork until smooth.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 28642,
            "primary_message": "Halve the grape tomatoes.",
            "secondary_message": null
          },
          {
            "id": 28643,
            "primary_message": "Place the bun halves on four plates (or two plates and two lunch containers), top with the black bean patties, and add dollops of the avocado spread. Arrange the greens on the side, top with the grape tomatoes, and drizzle with olive oil and the remaining lime. Enjoy!",
            "secondary_message": "1 tbsp extra virgin olive oil"
          }
        ],
