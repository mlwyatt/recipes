        "instructions": [
          {
            "id": 207474,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 207475,
            "primary_message": "Wash, dry, and peel the butternut squash; halve and remove seeds with a spoon. Small dice squash and place in a medium bowl; set aside.",
            "secondary_message": "1 small butternut squash"
          },
          {
            "id": 207476,
            "primary_message": "Peel and small dice onion; peel and mince garlic. Add both to the bowl with the squash.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 207477,
            "primary_message": "Wash, dry, and quarter jalapeños lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": "2 jalapeño peppers"
          },
          {
            "id": 207478,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 207479,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices to the pot; cook, stirring occasionally, until squash is fork-tender, 7-8 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp chili powder\n1 tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp cayenne pepper\n½ tsp cumin"
          },
          {
            "id": 207480,
            "primary_message": "Meanwhile, measure oil into a medium saucepan and place over medium-high heat. Once the oil is hot, whisk in the flour; continuing to whisk, cook the flour until lightly golden, about 1 minute.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp all-purpose flour"
          },
          {
            "id": 207481,
            "primary_message": "Slowly whisk in tomato sauce, broth, and spices. Bring to a boil, then reduce heat and simmer until thickened, 4-5 minutes. Remove enchilada sauce from heat and set aside.",
            "secondary_message": "2 (8 oz) cans tomato sauce\n12 fl oz (1 ½ cups) chicken or vegetable broth\n2 tbsp chili powder\n1 tsp garlic powder\n1 tsp onion powder\n1 tsp cumin\n1 tsp salt\n½ tsp oregano"
          },
          {
            "id": 207482,
            "primary_message": "Meanwhile, drain and rinse beans. Grate mozzarella.",
            "secondary_message": "1 (15 oz) can black beans\n1 (8 oz) block mozzarella cheese"
          },
          {
            "id": 207483,
            "primary_message": "Add beans, half the cheese (reserving the rest for later), and yogurt to the pot with the veggies. Stir to combine and remove from heat.",
            "secondary_message": "½ cup plain Greek yogurt"
          },
          {
            "id": 207484,
            "primary_message": "Spread a thin layer of the enchilada sauce over the bottom of a medium baking dish; set remaining sauce aside.",
            "secondary_message": null
          },
          {
            "id": 207485,
            "primary_message": "Place tortillas on a flat surface and divide vegetable mixture evenly between them; roll up and place, seam-side down, in the baking dish. Top with remaining sauce and cheese.",
            "secondary_message": "8 small flour tortillas"
          },
          {
            "id": 207486,
            "primary_message": "Place enchiladas in the oven and bake until the cheese is melted, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 207487,
            "primary_message": "To serve, divide enchiladas between plates and enjoy!",
            "secondary_message": null
          }
        ],
