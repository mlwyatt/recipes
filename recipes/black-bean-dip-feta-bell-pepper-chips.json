  "instructions": [
    {
      "id": 393520,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n1 lime\n½ small bunch cilantro\n3 red bell peppers"
    },
    {
      "id": 393521,
      "primary_message": "Peel and mince shallots and garlic. Place both in a small bowl.",
      "secondary_message": "2 shallots\n4 cloves garlic"
    },
    {
      "id": 393522,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 393523,
      "primary_message": "While the skillet heats up, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the shallot and garlic. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 393524,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shallot, garlic, and jalapeño; cook, stirring occasionally, until softened, about 5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 393525,
      "primary_message": "Meanwhile, juice lime into a blender.",
      "secondary_message": null
    },
    {
      "id": 393526,
      "primary_message": "Drain and rinse beans. Add to the blender along with water and spices.",
      "secondary_message": "2 (15 oz) cans black beans\n¼ cup water\n1 tsp cumin, ground\n½ tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 393527,
      "primary_message": "When the sautéed veggies are soft, add to the blender. Blend on high until semi-smooth, adding more water, 1-2 tablespoons at a time, if needed.",
      "secondary_message": null
    },
    {
      "id": 393528,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the blender and process once more until just combined. Set aside.",
      "secondary_message": null
    },
    {
      "id": 393529,
      "primary_message": "Cut bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Slice each quarter crosswise into 3-4 pieces to make the \"chips.\"",
      "secondary_message": null
    },
    {
      "id": 393530,
      "primary_message": "Divide black bean dip between plates and sprinkle with feta. Serve with bell pepper \"chips\" on the side.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
