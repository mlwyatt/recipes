  "instructions": [
    {
      "id": 92142,
      "primary_message": "Peel and slice the onion into thin half rings.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 92143,
      "primary_message": "Wash and dry the pineapple. Cut skin off pineapple, core, and cut into bite-sized pieces.",
      "secondary_message": "1 small pineapple"
    },
    {
      "id": 92144,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 92145,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 92146,
      "primary_message": "In a medium bowl, combine garlic, tomato sauce, and spices. Stir to combine and set aside.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n¼ tsp crushed red pepper\n¼ tsp paprika\n¼ tsp onion powder\n¼ tsp black pepper"
    },
    {
      "id": 92147,
      "primary_message": "Preheat oven to broil.",
      "secondary_message": null
    },
    {
      "id": 92148,
      "primary_message": "Grate the mozzarella.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 92149,
      "primary_message": "To assemble, top the pitas with a thin layer of tomato sauce, cheese, red onion, pineapple, and black beans. Place on a baking sheet and cook in the oven for 2-3 minutes, until the cheese melts.",
      "secondary_message": "8 whole grain pitas"
    },
    {
      "id": 92150,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 92151,
      "primary_message": "Remove from oven and top with cilantro leaves. Enjoy!",
      "secondary_message": null
    }
  ],
