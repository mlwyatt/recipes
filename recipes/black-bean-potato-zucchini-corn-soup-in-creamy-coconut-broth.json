  "instructions": [
    {
      "id": 293222,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 medium yellow potatoes\n2 sticks celery\n2 medium zucchini squash\n1 small pkg fresh thyme\n1 lemon"
    },
    {
      "id": 293223,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 293224,
      "primary_message": "Peel and medium dice carrots and potatoes; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 293225,
      "primary_message": "Trim celery and cut crosswise into thin pieces; add to the bowl with the carrot and potato.",
      "secondary_message": null
    },
    {
      "id": 293226,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 293227,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 293228,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies, salt, and pepper. Cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 293229,
      "primary_message": "Meanwhile, trim and medium dice zucchini.",
      "secondary_message": null
    },
    {
      "id": 293230,
      "primary_message": "Slide thyme leaves off the stems; discard the stems.",
      "secondary_message": null
    },
    {
      "id": 293231,
      "primary_message": "When the veggies are soft, add beans, zucchini, thyme, broth, coconut milk, and corn to the pot. Stir to combine the soup, cover, and bring to a simmer over medium-high heat.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n1 cup frozen corn"
    },
    {
      "id": 293232,
      "primary_message": "Once the soup is simmering, reduce heat to medium-low and cook, stirring occasionally, until the potatoes are fork-tender, about 8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 293233,
      "primary_message": "Juice lemon into the soup and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 293234,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
