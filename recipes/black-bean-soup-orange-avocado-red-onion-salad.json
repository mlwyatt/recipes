        "instructions": [
          {
            "id": 42239,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 green bell peppers\n2 oranges\n2 avocados\n1 lime\n1 small bunch cilantro"
          },
          {
            "id": 42240,
            "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Small dice the peppers and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 42241,
            "primary_message": "Preheat a medium saucepan over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 42242,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice ½ of the onion (cut into ¼-inch pieces) and add to the bowl with the peppers, then thinly slice the other ½ into quarter-rings and transfer to a small bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 42243,
            "primary_message": "Once the saucepan is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 42244,
            "primary_message": "Add the onion and bell peppers to the saucepan; cook, stirring frequently, until softened, 3 to 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 42245,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "2 clove garlic"
          },
          {
            "id": 42246,
            "primary_message": "Add the garlic, cumin, and crushed red pepper to the saucepan; cook, stirring constantly, until fragrant, 15 to 30 seconds.",
            "secondary_message": "1 tsp cumin\n½ tsp crushed red pepper"
          },
          {
            "id": 42247,
            "primary_message": "Add the broth and beans (with their liquid) to the saucepan; season with salt and pepper. Increase the heat to high and bring to a boil. Once boiling, reduce to a simmer, cover, and cook for 15 minutes.",
            "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n2 (15 oz) cans black beans\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 42248,
            "primary_message": "While the soup cooks, using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 42249,
            "primary_message": "Cut a small piece off both orange ends to reveal the flesh; place the oranges on one end and, from top to bottom, slice off the skin and pith. Halve the oranges lengthwise, then slice crosswise into ¼-inch-thick half-rounds and transfer to a small bowl.",
            "secondary_message": ""
          },
          {
            "id": 42250,
            "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; thinly slice the flesh crosswise (without piercing the skin) and scoop out.",
            "secondary_message": null
          },
          {
            "id": 42251,
            "primary_message": "Juice the lime into a small bowl (that will be used to make the dressing).",
            "secondary_message": null
          },
          {
            "id": 42252,
            "primary_message": "To the lime juice, add olive oil, honey, salt, and pepper; whisk together.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper "
          },
          {
            "id": 42253,
            "primary_message": "Using an immersion (hand) blender, purée the soup until the desired consistently is reached.",
            "secondary_message": null
          },
          {
            "id": 42254,
            "primary_message": "To serve, divide the soup between bowls, top with spoonfuls of Greek yogurt, and garnish with some of the cilantro. Arrange the orange slices, avocado, and remaining onion on plates. Drizzle the salad with the dressing and garnish with the remaining cilantro. Enjoy!",
            "secondary_message": "½ cup plain Greek yogurt"
          }
        ],
