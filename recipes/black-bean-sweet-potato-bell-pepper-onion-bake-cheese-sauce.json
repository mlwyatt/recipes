        "instructions": [
          {
            "id": 270407,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 270408,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 green bell peppers\n1 ½ lb sweet potatoes\n1 small bunch green onions (scallions)"
          },
          {
            "id": 270409,
            "primary_message": "Trim, seed, and medium dice bell peppers; place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 270410,
            "primary_message": "Peel and cut sweet potatoes into ½-inch cubes; add to the bowl with the bell pepper.",
            "secondary_message": null
          },
          {
            "id": 270411,
            "primary_message": "Peel, halve, and large dice onion. Add to the bowl along with oil, salt, and pepper; toss to combine, transfer to a large baking sheet pan, and spread out in an even layer.",
            "secondary_message": "1 medium red onion\n2 tbsp extra virgin olive oil\n1 tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 270412,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden brown and fork-tender, about 20 minutes.",
            "secondary_message": null
          },
          {
            "id": 270413,
            "primary_message": "Meanwhile, coarsely grate mozzarella and set aside.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 270414,
            "primary_message": "Preheat a medium saucepan over medium heat. Once the pan is hot, add oil and flour; whisk until combined, about 1 minute.",
            "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp all-purpose flour"
          },
          {
            "id": 270415,
            "primary_message": "Add broth and spices to the pan; cook, whisking frequently, until thickened, 3-4 minutes.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 tsp salt\n1 tsp coriander, ground\n¼ tsp black pepper"
          },
          {
            "id": 270416,
            "primary_message": "Add mozzarella and yogurt to the pan; whisk until cheese is melted and combined. Cover sauce and set over low heat, stirring occasionally, to keep warm.",
            "secondary_message": "½ cup plain Greek yogurt"
          },
          {
            "id": 270417,
            "primary_message": "Drain and rinse beans in a colander.",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 270418,
            "primary_message": "When the veggies are done, remove from the oven, add beans, and stir to combine. Return baking sheet to the oven and bake until beans are warmed through, 2-3 minutes more; remove from oven.",
            "secondary_message": null
          },
          {
            "id": 270419,
            "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 270420,
            "primary_message": "To serve, divide roasted veggies and beans between bowls; top with cheese sauce and green onions. Enjoy!",
            "secondary_message": null
          }
        ],
