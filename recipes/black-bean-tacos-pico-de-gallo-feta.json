        "instructions": [
          {
            "id": 41465,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 pints grape tomatoes\n2 jalapeño peppers\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 41466,
            "primary_message": "Drain and rinse the beans; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 41467,
            "primary_message": "Quarter the grape tomatoes and transfer to a medium bowl (that will hold the salsa).",
            "secondary_message": null
          },
          {
            "id": 41468,
            "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the salsa bowl.",
            "secondary_message": ""
          },
          {
            "id": 41469,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salsa bowl.",
            "secondary_message": null
          },
          {
            "id": 41470,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 41471,
            "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces). Add ½ of the onion to the salsa bowl and leave the rest on the cutting board.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 41472,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 41473,
            "primary_message": "Add the remaining onion to the skillet; cook, stirring frequently, until softened, 3 to 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 41474,
            "primary_message": "While the onion cooks, juice the limes and add to the salsa bowl.",
            "secondary_message": ""
          },
          {
            "id": 41475,
            "primary_message": "Season the salsa with salt and pepper; toss to combine.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 41476,
            "primary_message": "Add the black beans to the skillet and season with chili powder, salt, and pepper; cook until the mixture is heated through, 3 to 4 minutes. Once done, remove the skillet from the heat.",
            "secondary_message": "2 tsp chili powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 41477,
            "primary_message": "Place the feta in a small bowl.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 41478,
            "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15 to 30 seconds.",
            "secondary_message": "16 small corn tortillas"
          },
          {
            "id": 41479,
            "primary_message": "To serve, divide the black beans between the tortillas, then top with the salsa and feta. Enjoy!",
            "secondary_message": null
          }
        ],
