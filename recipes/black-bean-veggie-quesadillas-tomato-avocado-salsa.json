  "instructions": [
    {
      "id": 18699,
      "primary_message": "Wash and dry tomatoes, jalapeños, and cilantro.",
      "secondary_message": "4 tomatoes\r\n2 jalapeño peppers\r\n1 small bunch cilantro"
    },
    {
      "id": 18700,
      "primary_message": "Medium dice and transfer tomatoes to a medium bowl. Seed, mince, and add ½ of the jalapeños to bowl (save the rest for the quesadilla filling). Halve and pit avocados; scoop out the flesh, medium dice, and add to bowl. Shave cilantro leaves off the stems; discard the stems, mince the leaves, and add ½ to bowl (save the rest for the quesadilla filling). Peel, small dice onion, and add ½ to bowl (save the rest for the quesadilla filling).",
      "secondary_message": "2 avocados\r\n1 medium red onion"
    },
    {
      "id": 18701,
      "primary_message": "Drizzle ingredients in bowl with olive oil and lime juice; season with salt and pepper. Mix to combine and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\r\njuice of 1 lime\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 18702,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 18703,
      "primary_message": "Wash, seed, and small dice bell peppers.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 18704,
      "primary_message": "Coat bottom of skillet with oil. Add remaining onion, jalapeño, and bell pepper. Stirring frequently, cook until vegetables have softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 18705,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 18706,
      "primary_message": "Add beans and remaining cilantro to skillet. Then season with chili powder, cumin, salt, and pepper. Stir and cook until beans are warmed through, 2-3 minutes. Transfer to a bowl.",
      "secondary_message": "1 tsp chili powder \r\n1 tsp cumin\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 18707,
      "primary_message": "Grate 2 cups of cheddar.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 18708,
      "primary_message": "Wash and dry skillet. Heat over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 18709,
      "primary_message": "Place tortillas on a flat surface. Layer one half of each tortilla with ⅛ of the cheese, ¼ of the bean mixture, and another ⅛ of the cheese. Fold tortillas over to close.",
      "secondary_message": "4 large (burrito size) flour tortillas"
    },
    {
      "id": 18710,
      "primary_message": "Coat skillet with oil. Place 2 of the quesadillas in the skillet, straight edges next to each other. Cook until golden brown on both sides and cheese is melted, 2-3 minutes per side. Repeat with remaining 2 quesadillas.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 18711,
      "primary_message": "Transfer to a cutting board and cut into wedges.",
      "secondary_message": ""
    },
    {
      "id": 18712,
      "primary_message": "To serve, place quesadilla on a plate and serve with salsa. Enjoy!",
      "secondary_message": ""
    }
  ],
