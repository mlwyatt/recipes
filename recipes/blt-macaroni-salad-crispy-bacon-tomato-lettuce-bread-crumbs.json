  "instructions": [
    {
      "id": 475713,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n8 oz macaroni (elbow) pasta"
    },
    {
      "id": 475714,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 475715,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 475716,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 475717,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, Dijon, honey, and spices in a medium bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tbsp red wine vinegar\n1 tbsp Dijon mustard\n1 tsp honey\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 475718,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n2 tomatoes\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 475719,
      "primary_message": "Using a clean cutting board, peel, trim, and small dice carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 475720,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 475721,
      "primary_message": "Small dice tomatoes. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 475722,
      "primary_message": "When the bacon is done, remove all but 4 teaspoons of drippings from the skillet, then return to medium heat. Add bread crumbs and toast, stirring often, until golden brown, 3-4 minutes. Transfer toasted bread crumbs to a small bowl, then add garlic powder and salt; stir to combine and set aside.",
      "secondary_message": "⅔ cup panko bread crumbs\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 475723,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl with the dressing and veggies. Stir to combine the macaroni salad.",
      "secondary_message": null
    },
    {
      "id": 475724,
      "primary_message": "Separate lettuce into leaves and arrange on plates. Top with macaroni salad, bread crumbs, and crispy bacon. Enjoy!",
      "secondary_message": null
    }
  ],
