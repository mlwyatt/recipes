  "instructions": [
    {
      "id": 288639,
      "primary_message": "Place cherries, cranberries, vinegar, sugar, and spices in a medium saucepan. Bring to a boil over medium-high heat.",
      "secondary_message": "1 ½ cup frozen cherries\n¼ cup dried cranberries\n4 tsp red wine vinegar\n1 tsp brown sugar\n½ tsp rosemary, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 288640,
      "primary_message": "Once boiling, gently crush the fruit with the back of a spoon to release juices. Reduce heat to a simmer and continue cooking, stirring occasionally, until thickened, about 15 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 288641,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a large bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 288642,
      "primary_message": "Wash, dry, and juice lemon into the bowl with the garlic. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 lemon\n4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 288643,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl. Use your hands to massage the dressing into the kale until slightly softened; set aside. ",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 288644,
      "primary_message": "Form the ground beef into 4 equal-sized patties, place on a plate, and season with spices.",
      "secondary_message": "1 ½ lb lean ground beef\n1 tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 288645,
      "primary_message": "Preheat a large grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 288646,
      "primary_message": "Once the grill pan is hot, place patties in the pan and cook, undisturbed, for 5 minutes; flip patties and cook an additional 2-3 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 288647,
      "primary_message": "If desired, place buns, cut-side down, on the grill pan to toast, 1-2 minutes.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 288648,
      "primary_message": "Place bottom half of a bun on each plate, then top with burgers, blue cheese, and cherry sauce. Close with the top half of the bun and serve with salad on the side. Enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
    }
  ],
