  "instructions": [
    {
      "id": 105414,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 105415,
      "primary_message": "Peel bananas, break into chunks, and add to blender.",
      "secondary_message": "4 bananas"
    },
    {
      "id": 105416,
      "primary_message": "Add blueberries, yogurt, oats (uncooked), almond milk, almond butter, cinnamon, and honey to the blender.",
      "secondary_message": "4 cup frozen blueberries\n1 cup plain Greek yogurt\n1 cup oats, quick cooking\n16 fl oz (2 cups) almond milk, unsweetened\n¼ cup natural almond butter\n2 tsp cinnamon\n2 tsp honey"
    },
    {
      "id": 105417,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 105418,
      "primary_message": "Pour the smoothie into glasses and enjoy!",
      "secondary_message": null
    }
