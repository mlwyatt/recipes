        "instructions": [
          {
            "id": 479940,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 479941,
            "primary_message": "Cut or tear bread into bite-sized pieces. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to combine and spread out in an even layer.",
            "secondary_message": "4 slices sourdough bread\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 479942,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until croutons are golden and toasted, about 10 minutes. Remove from oven and set aside to cool, 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 479943,
            "primary_message": "Meanwhile, peel and mince shallots and garlic. Place both in a large bowl along with oil, vinegar, and spices. Whisk to combine the dressing. ",
            "secondary_message": "2 shallots\n2 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
          },
          {
            "id": 479944,
            "primary_message": "Drain tuna, add to the bowl with the dressing, and flake with a fork. Stir to combine. ",
            "secondary_message": "4 (6 oz) cans chunk light tuna in water"
          },
          {
            "id": 479945,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 tomatoes\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 479946,
            "primary_message": "Large dice tomatoes. Add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 479947,
            "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 479948,
            "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 479949,
            "primary_message": "Roughly chop olives. Add to the bowl.",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 479950,
            "primary_message": "Chop or tear mozzarella into bite-sized pieces. Add to the bowl.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 479951,
            "primary_message": "Add the cooled croutons and capers to the bowl. Stir once more to combine the salad.",
            "secondary_message": "3 tbsp capers"
          },
          {
            "id": 479952,
            "primary_message": "To serve, divide panzanella salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
