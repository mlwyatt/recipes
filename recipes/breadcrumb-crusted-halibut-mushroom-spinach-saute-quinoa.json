  "instructions": [
    {
      "id": 8150,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": ""
    },
    {
      "id": 8151,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 8152,
      "primary_message": "In a small bowl, mix together lemon juice, bread crumbs, dill, salt, and pepper.",
      "secondary_message": "1 lemon\r\n6 tbsp panko bread crumbs\r\n1 tsp dill\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 8153,
      "primary_message": "Place halibut in a small baking dish. Drizzle with a little olive oil and top with bread crumb mixture, patting lightly to help it adhere.",
      "secondary_message": "1 lb halibut fillet\r\nabout 2 tsp extra virgin olive oil"
    },
    {
      "id": 8154,
      "primary_message": "Place dish in the oven and bake until fish is white and flaky, 10-12 minutes. Change setting to broil and continue baking until bread crumb mixture turns golden brown, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 8155,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 8156,
      "primary_message": "Peel and mince garlic. Wash, dry, and thinly slice mushrooms.",
      "secondary_message": "4 cloves garlic\r\n1 lb white mushrooms"
    },
    {
      "id": 8157,
      "primary_message": "Coat bottom of skillet with oil. Add garlic and cook until fragrant, 15-30 seconds. Add mushrooms and season with salt and pepper. Stirring occasionally, cook until softened, 4-5 minutes.",
      "secondary_message": "about 2 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 8158,
      "primary_message": "Wash and dry spinach. Add to mushrooms and toss until just wilted, 1-2 minutes.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 8159,
      "primary_message": "Uncover quinoa and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 8160,
      "primary_message": "To serve, place quinoa on a plate, add spinach-mushroom sauté, and top with halibut fillet. Enjoy!",
      "secondary_message": ""
    }
  ],
