  "instructions": [
    {
      "id": 438926,
      "primary_message": "Wash and dry raspberries.",
      "secondary_message": "2 (6 oz) pkgs raspberries"
    },
    {
      "id": 438927,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 438928,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and spread peanut butter on one half of each tortilla. Top with raspberries and drizzle with maple syrup; fold in half to close.",
      "secondary_message": "4 large flour tortillas\n½ cup natural peanut butter\n2 tsp pure maple syrup"
    },
    {
      "id": 438929,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "id": 438930,
      "primary_message": "To serve, cut each quesadilla into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
