  "instructions": [
    {
      "id": 336637,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional). ",
      "secondary_message": null
    },
    {
      "id": 336638,
      "primary_message": "Wash and dry mushrooms; remove stems and carefully scrape out the gills. Transfer to the baking sheet. ",
      "secondary_message": "4 caps portobello mushrooms"
    },
    {
      "id": 336639,
      "primary_message": "Wash, dry, and cut tomatoes in half crosswise; add to the baking sheet with the mushrooms, arranging the veggies on one half in a single layer. Drizzle with oil and season with spices.",
      "secondary_message": "2 tomatoes\n4 tsp extra virgin olive oil\n½ tsp parsley flakes\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 336640,
      "primary_message": "Arrange bacon on the other half of the baking sheet.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 336641,
      "primary_message": "Place baking sheet in the oven and broil, flipping veggies and bacon halfway through, until veggies are tender and bacon is crisp, 6-8 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 336642,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 336643,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but yolks are still runny, about 4 minutes. Remove from heat, then season with salt and pepper. ",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 336644,
      "primary_message": "While the eggs are cooking, toast bread if desired and cut in half. ",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 336645,
      "primary_message": "To serve, divide mushrooms, tomatoes, bacon, eggs, and bread between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
