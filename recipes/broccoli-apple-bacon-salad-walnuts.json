        "instructions": [
          {
            "id": 21816,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 21817,
            "primary_message": "Wash broccoli, carrots, and apples; set aside.",
            "secondary_message": "4 crowns broccoli\n2 medium carrots\n2 Gala apples"
          },
          {
            "id": 21818,
            "primary_message": "Place bacon in skillet and cook until crispy and golden, 2-3 minutes per side. Transfer to a plate.",
            "secondary_message": "8 strips bacon"
          },
          {
            "id": 21819,
            "primary_message": "Peel and mince garlic. In a large bowl, prepare salad dressing by whisking together garlic, lemon juice, mayo, honey, salt, and pepper.",
            "secondary_message": "2 cloves garlic\r\njuice of 1 lemon\r\n½ cup mayonnaise\r\n1 tsp honey\r\n½ tsp salt\r\n½ tsp black pepper"
          },
          {
            "id": 21820,
            "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; add to bowl with dressing. Trim, peel, and coarsely grate carrots; add to bowl. Core and medium dice apples; add to bowl.",
            "secondary_message": ""
          },
          {
            "id": 21821,
            "primary_message": "Add cranberries to bowl. Roughly chop walnuts and add to bowl.",
            "secondary_message": "¼ cup dried cranberries\r\n1 cup walnuts"
          },
          {
            "id": 21822,
            "primary_message": "Chop bacon into small pieces and add to salad. Toss salad until well coated with dressing.",
            "secondary_message": ""
          },
          {
            "id": 21823,
            "primary_message": "Serve in a bowl and enjoy!",
            "secondary_message": ""
          }
        ],
