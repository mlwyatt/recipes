        "instructions": [
          {
            "id": 7999,
            "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
            "secondary_message": ""
          },
          {
            "id": 8000,
            "primary_message": "Wash broccoli, separate into bite-sized florets, and cut thick stems into smaller pieces.",
            "secondary_message": "2 crowns broccoli"
          },
          {
            "id": 8001,
            "primary_message": "Once water is boiling, add broccoli to saucepan and cook until bright green and tender-crisp, 1-2 minutes. Drain and run under cold water. Set aside to drain excess water.",
            "secondary_message": ""
          },
          {
            "id": 8002,
            "primary_message": "Peel and mince garlic. Wash lemon and grate 2 tsp of zest. In a large bowl, prepare dressing by whisking together garlic, lemon zest and juice, oil, Dijon, honey, salt, and pepper.",
            "secondary_message": "2 cloves garlic\r\n2 lemons\r\n6 tbsp extra virgin olive oil\r\n2 tsp Dijon mustard\r\n1 tsp honey\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 8003,
            "primary_message": "Rinse and drain chickpeas. Place on paper towels and pat dry. Add to bowl with dressing and toss to coat.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 8004,
            "primary_message": "Wash and dry bell peppers and parsley. Seed and medium dice the peppers. Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to bowl.",
            "secondary_message": "2 red bell peppers\r\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 8005,
            "primary_message": "Add broccoli and feta to bowl. Toss salad.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 8006,
            "primary_message": "To serve, place salad on a plate or in a bowl. Enjoy!",
            "secondary_message": ""
          }
        ],
