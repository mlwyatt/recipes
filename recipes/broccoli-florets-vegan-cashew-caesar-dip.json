  "instructions": [
    {
      "id": 405725,
      "primary_message": "Wash, dry, and juice lemons into a blender.",
      "secondary_message": "2 lemons"
    },
    {
      "id": 405726,
      "primary_message": "Peel garlic; add to the blender along with cashews, water, nutritional yeast, capers, soy sauce, Dijon, salt, and pepper. Blend on high, adding additional water, 1-2 tablespoons at a time, if needed, to make a smooth dip.",
      "secondary_message": "2 cloves garlic\n1 cup cashews, roasted unsalted\n½ cup water\n¼ cup nutritional yeast flakes\n1 tbsp capers\n2 tsp soy sauce\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 405727,
      "primary_message": "Divide broccoli florets between plates; serve with dip on the side. Enjoy!",
      "secondary_message": "1 (18 oz) bag broccoli florets"
    }
  ],
