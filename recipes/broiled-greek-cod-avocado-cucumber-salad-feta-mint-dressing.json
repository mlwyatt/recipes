        "instructions": [
          {
            "id": 251670,
            "primary_message": "Preheat oven to broil on high and position rack under the broiler. Coat a baking sheet pan with a thin layer of oil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 251671,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 limes\n1 small pkg fresh mint\n2 avocados\n2 English cucumbers"
          },
          {
            "id": 251672,
            "primary_message": "Juice one of the limes into a small bowl. (Reserve remaining lime for later.)",
            "secondary_message": null
          },
          {
            "id": 251673,
            "primary_message": "Peel and mince shallots; add to the bowl with the lime juice.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 251674,
            "primary_message": "Mince the sun-dried tomatoes; add to the bowl along with oil and spices. Stir to combine the tapenade.",
            "secondary_message": "8 sun-dried tomatoes, oil-packed\n2 tbsp extra virgin olive oil\n2 tsp dill, dried\n1 tsp oregano, dried\n½ tsp garlic powder\n¼ tsp crushed red pepper"
          },
          {
            "id": 251675,
            "primary_message": "Thinly slice olives.",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 251676,
            "primary_message": "Pat cod dry with paper towels and place on the baking sheet; season with salt and pepper. Spread with tapenade and top with olives.",
            "secondary_message": "1 ½ lb cod fillet\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 251677,
            "primary_message": "Place baking sheet in the oven and broil until the cod is almost cooked through, about 8 minutes. ",
            "secondary_message": null
          },
          {
            "id": 251678,
            "primary_message": "Meanwhile, juice the remaining lime into a large bowl.",
            "secondary_message": null
          },
          {
            "id": 251679,
            "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice along with oil, salt, and pepper. Stir to combine the dressing.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 251680,
            "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 251681,
            "primary_message": "Remove cod from the oven and top with half the feta (reserve remaining cheese for the salad). Return baking sheet to the oven and broil until the fish flakes easily with a fork and the cheese is golden, 2-3 minutes more. Remove from oven.",
            "secondary_message": "2 (4 oz) pkgs crumbled feta cheese"
          },
          {
            "id": 251682,
            "primary_message": "Trim and thinly slice cucumbers crosswise; add to the salad bowl along with the reserved feta. Gently stir to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 251683,
            "primary_message": "To serve, divide cod and salad between plates; enjoy!",
            "secondary_message": null
          }
        ],
