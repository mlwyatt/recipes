  "instructions": [
    {
      "id": 436999,
      "primary_message": "Preheat the broiler to high and position rack about 6 inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 437000,
      "primary_message": "Place pork chops on a broiler pan and season both sides with salt and pepper.",
      "secondary_message": "4 pork chops, bone-in\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 437001,
      "primary_message": "Place pan in the oven. Broil, flipping halfway through, until chops are no longer pink in the center and are browned at the edges, 12-14 minutes. Remove from oven and let rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 437002,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 437003,
      "primary_message": "While the skillet heats up, place yogurt, tahini, vinegar, and salt in a small bowl. Stir to combine and set aside. ",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup tahini\n2 tbsp white wine vinegar\n¼ tsp salt"
    },
    {
      "id": 437004,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until golden and toasted, 4-5 minutes. Transfer to a plate and set aside. (Reserve skillet for later use.)",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 437005,
      "primary_message": "Wash, dry, and trim green beans; place in a medium bowl.",
      "secondary_message": "1 lb green beans"
    },
    {
      "id": 437006,
      "primary_message": "Wash, dry, trim, and seed bell peppers, then slice lengthwise into thin strips. Add to the bowl with the green beans. ",
      "secondary_message": "2 orange bell peppers"
    },
    {
      "id": 437007,
      "primary_message": "Return the skillet to high heat, add oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until blistered and tender, about 5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 437008,
      "primary_message": "To serve, divide chops and tahini yogurt between plates; top yogurt with veggies and almonds. Enjoy!",
      "secondary_message": null
    }
  ],
