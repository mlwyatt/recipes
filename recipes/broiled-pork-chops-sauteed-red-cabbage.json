  "instructions": [
    {
      "id": 22309,
      "primary_message": "Heat oven on broiler setting and position rack about 6 inches from the top.",
      "secondary_message": ""
    },
    {
      "id": 22310,
      "primary_message": "Place pork chops on a broiler pan (or baking dish if you don’t have a broiler pan) and season both sides with chili powder, salt, and pepper.",
      "secondary_message": "4 pork chops, bone-in\r\n1 tsp chili powder\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 22311,
      "primary_message": "Place dish in the oven and broil, flipping halfway through cooking time, until chops are cooked through and browned at the edges, 10-12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 22312,
      "primary_message": "Wash, core, and cut apples into thin bite-sized pieces. Transfer to a large bowl.",
      "secondary_message": "2 Gala apples"
    },
    {
      "id": 22313,
      "primary_message": "Wash cabbage, quarter, and cut off core. Thinly slice crosswise into shreds and add to bowl with apples.",
      "secondary_message": "1 small head red cabbage"
    },
    {
      "id": 22314,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 22315,
      "primary_message": "Peel and thinly slice onion into half rings.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 22316,
      "primary_message": "Coat bottom of skillet with oil. Add onion and cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 22317,
      "primary_message": "Add cabbage, apple, water, vinegar, salt, and pepper to skillet; stir to combine. Cook, stirring occasionally, until cabbage is tender-crisp, 6-8 minutes.",
      "secondary_message": "4 tbsp water\r\n4 tbsp apple cider vinegar\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 22318,
      "primary_message": "Serve pork chops with cabbage on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
