  "instructions": [
    {
      "id": 250178,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n2 red bell peppers\n4 sticks celery\n1 pint grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 250179,
      "primary_message": "Peel and small dice potatoes; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 250180,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the potato.",
      "secondary_message": null
    },
    {
      "id": 250181,
      "primary_message": "Trim and cut celery crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 250182,
      "primary_message": "Peel and mince garlic; add to the bowl and set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 250183,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250184,
      "primary_message": "While the pot heats up, peel, halve, and thinly slice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 250185,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add the onion and spices to the pot; cook, stirring often, until starting to soften, about 3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper\n½ tsp thyme, dried"
    },
    {
      "id": 250186,
      "primary_message": "Add veggies, broth, edamame, corn, and sugar to the pot with the onion. Stir to combine the succotash and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies are tender, 8-10 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n2 cups edamame\n1 cup frozen corn\n1 tsp brown sugar"
    },
    {
      "id": 250187,
      "primary_message": "While the succotash is cooking, halve tomatoes and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 250188,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 250189,
      "primary_message": "Toast flatbread if desired (optional), then slice into wedges.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 250190,
      "primary_message": "When the succotash is done, add tomatoes, parsley, and cream to the pot; stir to combine and remove from heat.",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream"
    },
    {
      "id": 250191,
      "primary_message": "To serve, divide succotash between bowls and enjoy with warm flatbread on the side!",
      "secondary_message": null
    }
  ],
