  "instructions": [
    {
      "id": 189535,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add pasta and salt, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "12 oz macaroni (elbow) pasta\n2 tsp salt"
    },
    {
      "id": 189536,
      "primary_message": "While pasta is cooking, melt butter in a medium saucepan over medium-high heat. Stir, cooking until butter has browned, 3-4 minutes. Watch it carefully so that it does not burn.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 189537,
      "primary_message": "Remove saucepan from heat, stir in flour, whisking constantly, 1 minute.",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 189538,
      "primary_message": "Return saucepan to heat, gradually stir in milk. Bring to a simmer and cook for 1 minute, stirring constantly, until thickened.",
      "secondary_message": "10 fl oz (1 ¼ cups) whole milk"
    },
    {
      "id": 189539,
      "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
      "secondary_message": "½ small pkg fresh thyme"
    },
    {
      "id": 189540,
      "primary_message": "Stir in pumpkin, salt, pepper, and most of the thyme (reserve some for garnish). ",
      "secondary_message": "½ (15 oz) can pure pumpkin purée\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 189541,
      "primary_message": "Grate cheese and add to saucepan. Cook, stirring occasionally, until cheese is melted.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 189542,
      "primary_message": "When macaroni is done cooking, drain in a colander and return to the pot. Add the cheese sauce to the pot and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 189543,
      "primary_message": "To serve, divide the macaroni and cheese between plates or bowls and sprinkle with fresh thyme. Enjoy!",
      "secondary_message": null
    }
  ],
