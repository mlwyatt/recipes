        "instructions": [
          {
            "id": 244866,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 244867,
            "primary_message": "Wash, dry, seed, and medium dice bell peppers. Place in a large bowl.",
            "secondary_message": "2 yellow bell peppers"
          },
          {
            "id": 244868,
            "primary_message": "Wash, dry, and halve tomatoes. Add to the bowl with the pepper.",
            "secondary_message": "2 pints grape tomatoes"
          },
          {
            "id": 244869,
            "primary_message": "Peel and medium dice onion. Add to the bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 244870,
            "primary_message": "Add gnocchi, oil, sugar, and spices to the bowl; toss to combine.",
            "secondary_message": "2 (16 oz) pkg potato gnocchi\n4 tsp extra virgin olive oil\n1 ½ tsp brown sugar\n1 tsp salt\n½ tsp sage, dried\n¼ tsp black pepper"
          },
          {
            "id": 244871,
            "primary_message": "Transfer veggies and gnocchi to a large baking sheet pan and spread out in a single layer. Add sausages to the baking sheet, nestling them into the veggies and gnocchi. ",
            "secondary_message": null
          },
          {
            "id": 244872,
            "primary_message": "Place baking sheet in the oven and roast until sausages are cooked through and gnocchi is golden brown, 20-25 minutes.",
            "secondary_message": "4 pork sausages"
          },
          {
            "id": 244873,
            "primary_message": "Remove baking sheet from the oven. Transfer sausages to a cutting board and slice crosswise into 1-inch thick pieces.",
            "secondary_message": null
          },
          {
            "id": 244874,
            "primary_message": "To serve, divide gnocchi, veggies, and sausage between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
