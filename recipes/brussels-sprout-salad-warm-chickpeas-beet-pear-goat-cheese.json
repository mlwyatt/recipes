  "instructions": [
    {
      "id": 371464,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 371465,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium beets\n2 pears\n1 lb Brussels sprouts"
    },
    {
      "id": 371466,
      "primary_message": "Peel, trim, and small dice beets. Transfer to a large baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 371467,
      "primary_message": "Drain and rinse chickpeas. Add to the baking sheet with the beets, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 371468,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are golden and beets are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 371469,
      "primary_message": "Meanwhile, place oil, vinegar, maple syrup, and spices in a medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n2 tsp pure maple syrup\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 371470,
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 371471,
      "primary_message": "Quarter, core, and thinly slice pears. Add to the bowl and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 371472,
      "primary_message": "Just before serving, add pumpkin seeds to the bowl and stir to combine the salad. ",
      "secondary_message": "½ cup pumpkin seeds"
    },
    {
      "id": 371473,
      "primary_message": "To serve, divide salad between plates or bowls; top with warm chickpeas and beets. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese"
    }
  ],
