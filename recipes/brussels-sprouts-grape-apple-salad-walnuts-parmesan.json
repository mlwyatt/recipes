  "instructions": [
    {
      "id": 22048,
      "primary_message": "In a large salad bowl, prepare dressing by whisking together lemon juice, olive oil, vinegar, maple syrup, salt, and pepper.",
      "secondary_message": "juice of 1 lemon\r\n8 tbsp extra virgin olive oil\r\n4 tbsp balsamic vinegar\r\n1 tsp pure maple syrup\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 22049,
      "primary_message": "Wash brussels sprouts and trim rough ends. Shred by slicing thinly or using a mandoline slicer; transfer to salad bowl and toss with dressing.",
      "secondary_message": "2 lb brussels sprouts\r\n"
    },
    {
      "id": 22050,
      "primary_message": "Wash grapes and apples. Halve and add grapes to salad bowl. Core, medium dice, and add apples to salad bowl.",
      "secondary_message": "1 lb red grapes\n2 Gala apples"
    },
    {
      "id": 22051,
      "primary_message": "Roughly chop walnuts; add to salad bowl. Grate ½ cup of Parmesan; add to salad bowl.",
      "secondary_message": "1 cup walnuts\r\n2 oz Parmesan cheese"
    },
    {
      "id": 22052,
      "primary_message": "Toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 22053,
      "primary_message": "Serve salad on a plate and enjoy!",
      "secondary_message": ""
    }
  ],
