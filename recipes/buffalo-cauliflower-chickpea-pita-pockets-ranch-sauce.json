  "instructions": [
    {
      "id": 138432,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium head cauliflower\n2 medium carrots\n2 sticks celery\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 138433,
      "primary_message": "Reserve ½ cup of the chickpea liquid and place in a medium bowl, then drain and rinse the chickpeas.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 138434,
      "primary_message": "Add half the chickpeas to the bowl with the bean liquid and mash well; stir in remaining chickpeas, leaving them whole.",
      "secondary_message": null
    },
    {
      "id": 138435,
      "primary_message": "Add vinegar, Dijon, chili-garlic sauce, and tomato paste to the chickpea mixture; stir to combine. Set aside. ",
      "secondary_message": "2 tbsp white wine vinegar\n4 tsp Dijon mustard\n2 tsp chili-garlic sauce\n2 tbsp tomato paste"
    },
    {
      "id": 138436,
      "primary_message": "To make the ranch dressing, combine mayonnaise and spices in a small bowl; whisk to combine. Add additional water (1 tsp at a time) as needed to reach a drizzling consistency.   ",
      "secondary_message": "⅓ cup mayonnaise\n1 tsp dill\n¼ tsp parsley flakes\n¼ tsp garlic powder\n¼ tsp onion powder\n⅛ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 138437,
      "primary_message": "Remove leaves and thick stems from cauliflower; cut into bite-sized florets. Transfer to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 138438,
      "primary_message": "Peel and small dice onion and carrots; add to the bowl with the cauliflower. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 138439,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 138440,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 138441,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 138442,
      "primary_message": "Add cauliflower, onion, carrot, and garlic to the skillet and cook, stirring occasionally, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 138443,
      "primary_message": "Add chickpea mixture, salt, and pepper to the skillet and continue to cook until cauliflower is tender, about 5 minutes. Taste the chickpea mixture and add more garlic-chili sauce (½ tsp at a time) to reach desired spiciness.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper\n2 tsp chili-garlic sauce"
    },
    {
      "id": 138444,
      "primary_message": "Small dice celery.",
      "secondary_message": null
    },
    {
      "id": 138445,
      "primary_message": "Cut pita in half and carefully open the pita pockets.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 138446,
      "primary_message": "To serve, divide spinach, bean-cauliflower mixture, and celery between pita pockets. Top with ranch dressing and enjoy!",
      "secondary_message": null
    }
  ],
