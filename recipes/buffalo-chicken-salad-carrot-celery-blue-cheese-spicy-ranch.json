        "instructions": [
          {
            "id": 346196,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n2 sticks celery\n1 avocado\n2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 346197,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 346198,
            "primary_message": "Add dressing, hot sauce, salt, and pepper to the bowl with the parsley; stir to combine.",
            "secondary_message": "⅔ cup ranch dressing\n2 tbsp hot sauce\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 346199,
            "primary_message": "Trim and thinly slice celery crosswise; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 346200,
            "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 346201,
            "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and add to the bowl.",
            "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
          },
          {
            "id": 346202,
            "primary_message": "Add mixed greens and shredded carrots to the bowl; toss to combine the salad.",
            "secondary_message": "1 (10 oz) bag shredded carrots"
          },
          {
            "id": 346203,
            "primary_message": "To serve, divide salad between plates or bowls and sprinkle with blue cheese. Enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
          }
        ],
