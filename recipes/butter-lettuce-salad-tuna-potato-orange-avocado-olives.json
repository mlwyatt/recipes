  "instructions": [
    {
      "id": 348653,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb new potatoes\n1 lemon\n2 oranges\n1 small bunch Italian (flat-leaf) parsley\n2 avocados\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 348654,
      "primary_message": "Quarter potatoes and place in a medium saucepan; cover with hot water (from the tap) and bring to a boil over high heat. Once boiling, reduce heat to medium and cook until fork-tender, 8-10 minutes. Drain and rinse with cold water to cool, then set aside.",
      "secondary_message": null
    },
    {
      "id": 348655,
      "primary_message": "Meanwhile, zest and juice lemon into a large bowl; add mayo, oil, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n4 tsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 348656,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 348657,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348658,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348659,
      "primary_message": "Roughly chop olives and add to the bowl.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 348660,
      "primary_message": "Drain tuna, flake with a fork, and add to the bowl.",
      "secondary_message": "4 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 348661,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348662,
      "primary_message": "Chop or tear lettuce into bite-sized pieces, add to the bowl, along with the potatoes, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 348663,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
