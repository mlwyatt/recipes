        "instructions": [
          {
            "id": 113769,
            "primary_message": "Chop the bacon into small pieces.",
            "secondary_message": "4 slices bacon"
          },
          {
            "id": 113770,
            "primary_message": "Heat a large saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 113771,
            "primary_message": "Add bacon to the saucepan and cook until crispy, 3-4 minutes. Remove bacon with a slotted spoon and place on a paper towel lined plate; remove the saucepan from the heat but leave the bacon fat in the saucepan.",
            "secondary_message": null
          },
          {
            "id": 113772,
            "primary_message": "Peel and mince the garlic. Peel and small dice the onion.",
            "secondary_message": "2 cloves garlic\n1 medium yellow onion"
          },
          {
            "id": 113773,
            "primary_message": "Wash the squash; trim off and discard the ends. Halve the squash lengthwise and scrape out the seeds from each half; peel and small dice the squash. You should have about 3 cups of diced squash.",
            "secondary_message": "1 small butternut squash"
          },
          {
            "id": 113774,
            "primary_message": "Return the saucepan to medium heat. Add the onion, minced garlic, and butternut squash to the bacon fat. Cook, stirring occasionally, for 2 minutes.",
            "secondary_message": null
          },
          {
            "id": 113775,
            "primary_message": "Add broth to the pan with squash mixture, bring to a boil, reduce heat to low, and let simmer, covered, until the squash is fork-tender, 15 minutes.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 113776,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "12 oz fettuccine pasta\n1 tbsp salt"
          },
          {
            "id": 113777,
            "primary_message": "Finely grate the Parmesan cheese and set aside.",
            "secondary_message": "3 oz Parmesan cheese"
          },
          {
            "id": 113778,
            "primary_message": "Once the squash mixture is cooked through, purée with an immersion (hand) blender or regular blender. Return the puréed mixture to the saucepan on low heat to keep warm. Stir in the grated Parmesan cheese, salt, and pepper.",
            "secondary_message": "1 tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 113779,
            "primary_message": "Add pasta to the saucepan with the squash purée; toss to combine.",
            "secondary_message": null
          },
          {
            "id": 113780,
            "primary_message": "Add spinach to the pasta and stir, allowing the spinach to wilt into the pasta, about 3 minutes.",
            "secondary_message": "1 (5 oz) pkg baby spinach"
          },
          {
            "id": 113781,
            "primary_message": "To serve, divide pasta between bowls and top with bacon. Enjoy!",
            "secondary_message": null
          }
        ],
