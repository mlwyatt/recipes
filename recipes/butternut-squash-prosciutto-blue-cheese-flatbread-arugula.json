        "instructions": [
          {
            "id": 324733,
            "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil and set aside.",
            "secondary_message": null
          },
          {
            "id": 324734,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "½ small pkg fresh sage\n1 small butternut squash\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 324735,
            "primary_message": "Pick sage leaves off the stems; discard stems and finely chop the leaves. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 324736,
            "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and small dice. Add to the bowl with the sage along with oil, salt, and pepper; stir to coat. Transfer squash to the baking sheet and spread out in a single layer. (Reserve bowl for later use.)",
            "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 324737,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, 15-18 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 324738,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 324739,
            "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion into half-moons.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 324740,
            "primary_message": "Once the skillet is hot, add prosciutto slices and cook until crispy, about 1 minute per side. Remove to a paper towel-lined plate and set aside.",
            "secondary_message": "4 slices prosciutto"
          },
          {
            "id": 324741,
            "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom; add onion, water, and salt. Cook, stirring frequently, until onions are soft and golden brown, about 8 minutes. Remove from heat.",
            "secondary_message": "2 tsp extra virgin olive oil\n2 tbsp water\n¼ tsp salt"
          },
          {
            "id": 324742,
            "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in the reserved bowl; whisk to combine the dressing and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 324743,
            "primary_message": "Crumble or chop the crispy prosciutto into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 324744,
            "primary_message": "Carefully remove cooked squash from the baking sheet by lifting the corners of the foil and transferring the whole sheet to a flat surface. ",
            "secondary_message": null
          },
          {
            "id": 324745,
            "primary_message": "Arrange flatbreads on the baking sheet; layer with onion, squash, prosciutto, and blue cheese. Place in the oven and bake until flatbreads are golden and cheese is melted, about 5 minutes.",
            "secondary_message": "4 flatbreads or naan\n1 (4 oz) pkg crumbled blue cheese"
          },
          {
            "id": 324746,
            "primary_message": "Meanwhile, add arugula to the bowl with the dressing and toss to combine.",
            "secondary_message": null
          },
          {
            "id": 324747,
            "primary_message": "When the flatbreads are done, remove from oven, and top each with a small handful of arugula. (Reserve remaining arugula for serving.)",
            "secondary_message": null
          },
          {
            "id": 324748,
            "primary_message": "Divide flatbreads between plates; serve with remaining arugula on the side and enjoy!",
            "secondary_message": null
          }
        ],
