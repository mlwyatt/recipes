  "instructions": [
    {
      "id": 424303,
      "primary_message": "Place butternut squash, broth, coconut milk, paprika, and salt in a large pot. Stir to combine the soup. ",
      "secondary_message": "6 cup frozen butternut squash, pieces\n32 fl oz (4 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n1 tsp paprika\n½ tsp salt"
    },
    {
      "id": 424304,
      "primary_message": "Bring the soup to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until squash is very soft, 8-10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 424305,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Place in a medium bowl. ",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 424306,
      "primary_message": "Add carrots, Parmesan, cranberries, and pumpkin seeds to the bowl with the arugula. Set aside. ",
      "secondary_message": "1 (10 oz) bag shredded carrots\n½ cup Parmesan cheese, shredded\n¼ cup dried cranberries\n¼ cup pumpkin seeds"
    },
    {
      "id": 424307,
      "primary_message": "When the soup is done, remove from the heat. Purée with an immersion or regular blender (return to the pan).",
      "secondary_message": null
    },
    {
      "id": 424308,
      "primary_message": "Add dressing to the bowl with the arugula and toss to combine the salad. ",
      "secondary_message": "¼ cup honey mustard dressing"
    },
    {
      "id": 424309,
      "primary_message": "Divide soup between bowls and sprinkle with additional pumpkin seeds; serve with salad on the side. Enjoy!",
      "secondary_message": "¼ cup pumpkin seeds"
    }
  ],
