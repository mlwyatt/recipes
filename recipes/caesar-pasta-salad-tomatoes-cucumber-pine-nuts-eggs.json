  "instructions": [
    {
      "id": 420907,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 420908,
      "primary_message": "Meanwhile, quarter eggs and set aside.",
      "secondary_message": "6 hard-cooked eggs, peeled"
    },
    {
      "id": 420909,
      "primary_message": "Wash, dry, trim, and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Place in a medium bowl.",
      "secondary_message": "1 English cucumber"
    },
    {
      "id": 420910,
      "primary_message": "Wash, dry, and halve tomatoes. Add to the bowl with the cucumber.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 420911,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 420912,
      "primary_message": "Add cheese, dressing, and pine nuts to the bowl, then stir to combine the pasta salad.",
      "secondary_message": "1 cup shredded cheese, Italian blend\n½ cup Caesar dressing\n¼ cup pine nuts"
    },
    {
      "id": 420913,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Top with eggs and enjoy!",
      "secondary_message": null
    }
  ],
