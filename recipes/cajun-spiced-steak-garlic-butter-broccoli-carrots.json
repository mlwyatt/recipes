        "instructions": [
          {
            "id": 410824,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 410825,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; sprinkle Cajun seasoning on both sides.",
            "secondary_message": "1 ½ lb ribeye steak\n2 tsp Cajun seasoning"
          },
          {
            "id": 410826,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and set aside to rest. (Reserve skillet for later use.)",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 410827,
            "primary_message": "Meanwhile, peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 410828,
            "primary_message": "Wipe the skillet clean with paper towels and return to medium heat; add more butter and swirl to coat the bottom. Add garlic and cook, stirring frequently, until fragrant, about 30 seconds.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 410829,
            "primary_message": "Add broccoli, carrots, and salt to the skillet. Cook, stirring frequently, until veggies are tender, 3-4 minutes. Remove from heat.",
            "secondary_message": "1 (18 oz) bag broccoli florets\n1 (10 oz) bag shredded carrots\n½ tsp salt"
          },
          {
            "id": 410830,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 410831,
            "primary_message": "To serve, divide steak and veggies between plates. Enjoy!",
            "secondary_message": null
          }
        ],
