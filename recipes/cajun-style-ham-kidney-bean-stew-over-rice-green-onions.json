  "instructions": [
    {
      "id": 379556,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "1 cup basmati rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 379557,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 379558,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Place in a medium bowl. ",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 379559,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add half to the bowl with the bell pepper. (Reserve remaining green onion for serving.)",
      "secondary_message": "2 small bunches green onions (scallions)"
    },
    {
      "id": 379560,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 379561,
      "primary_message": "While the skillet heats up, small dice ham. Add to the bowl with the veggies. ",
      "secondary_message": "16 oz ham steak, boneless"
    },
    {
      "id": 379562,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies, ham, flour, and Cajun seasoning. Cook, stirring occasionally, until veggies start to soften, about 3 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted\n2 tbsp all-purpose flour\n4 tsp Cajun seasoning"
    },
    {
      "id": 379563,
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "2 (15 oz) cans kidney beans"
    },
    {
      "id": 379564,
      "primary_message": "When the veggies are soft, add beans, tomatoes, and salt to the skillet. Stir to combine the stew and bring to a boil. Once boiling, reduce heat to low, cover with a lid, and cook until beans are tender and stew has thickened, 8-10 minutes. Remove from heat. ",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n½ tsp salt"
    },
    {
      "id": 379565,
      "primary_message": "To serve, divide rice and stew between plates or bowls. Sprinkle with reserved green onion and enjoy!",
      "secondary_message": null
    }
  ],
