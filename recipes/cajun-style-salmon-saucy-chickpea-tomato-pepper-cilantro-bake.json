        "instructions": [
          {
            "id": 402905,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 402906,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 green bell peppers\n2 yellow bell peppers\n1 small bunch cilantro"
          },
          {
            "id": 402907,
            "primary_message": "Trim, seed, and small dice bell peppers. Place in a large baking dish. ",
            "secondary_message": null
          },
          {
            "id": 402908,
            "primary_message": "Drain and rinse chickpeas. Add to the baking dish with the bell peppers along with marinara sauce, water, and spices; stir to combine.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n1 (24 oz) jar marinara sauce\n⅓ cup water\n4 tsp Cajun seasoning\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 402909,
            "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until peppers and chickpeas are tender, 15-20 minutes.",
            "secondary_message": null
          },
          {
            "id": 402910,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 402911,
            "primary_message": "While the skillet heats up, pat salmon dry with paper towels and place, skin-side down, on a plate. Season the top side of the salmon with spices.",
            "secondary_message": "1 ½ lb salmon fillet\n1 tsp Cajun seasoning\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 402912,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 402913,
            "primary_message": "While the salmon is cooking, shave cilantro leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 402914,
            "primary_message": "When the peppers and chickpeas are done, remove from the oven. Add cilantro and stir to combine. ",
            "secondary_message": null
          },
          {
            "id": 402915,
            "primary_message": "To serve, divide saucy chickpeas and salmon between plates. Enjoy!",
            "secondary_message": null
          }
        ],
