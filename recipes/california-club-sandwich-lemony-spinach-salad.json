  "instructions": [
    {
      "id": 20160,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 20161,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "1 lb chicken breasts, boneless skinless\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 20162,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and bacon. Cook chicken until it is golden brown and cooked through and bacon until it is crispy, 3-4 minutes per side. Transfer to a plate lined with paper towels and pat dry the bacon.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 20163,
      "primary_message": "Toast buns or rolls.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 20164,
      "primary_message": "Wash and dry spinach. Wash and slice tomatoes into rounds. Halve and pit avocados; cut into slices while still in skin and scoop out.",
      "secondary_message": "1 (5 oz) pkg baby spinach\r\n2 tomatoes\r\n2 avocados"
    },
    {
      "id": 20165,
      "primary_message": "Peel and mince garlic. In a small bowl, mix together mayo with ½ of the garlic (save the rest for the salad dressing).",
      "secondary_message": "4 cloves garlic\r\n4 tbsp mayonnaise"
    },
    {
      "id": 20166,
      "primary_message": "In a small bowl, prepare salad dressing by whisking together remaining garlic, lemon juice, olive oil, salt, and pepper.",
      "secondary_message": "juice of 1 lemon\r\n3 tbsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 20167,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 20168,
      "primary_message": "Spread garlic mayo over the bottom halves of bread in each pair. Layer with spinach leaves, chicken, avocado, tomato, and bacon. Top with remaining slices of bread.",
      "secondary_message": ""
    },
    {
      "id": 20169,
      "primary_message": "Place sandwich on a plate and serve with remaining spinach on the side. Drizzle with dressing and enjoy!",
      "secondary_message": ""
    }
  ],
