  "instructions": [
    {
      "id": 19129,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 19130,
      "primary_message": "Heat a skillet over medium-low heat.",
      "secondary_message": ""
    },
    {
      "id": 19131,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 19132,
      "primary_message": "Cut bacon strips in half crosswise.",
      "secondary_message": "4 strips bacon"
    },
    {
      "id": 19133,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and bacon. Cook chicken until golden brown and no longer pink inside, 4-5 minutes per side. Cook bacon until crispy, 4-5 minutes per side. Transfer both to a plate lined with paper towels.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 19134,
      "primary_message": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together the garlic, olive oil, vinegar, Dijon, salt, and pepper. Set aside.",
      "secondary_message": "2 cloves garlic\r\n6 tbsp extra virgin olive oil\r\n2 tbsp red wine vinegar\r\n2 tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19135,
      "primary_message": "Wash lettuce, halve lengthwise, then chop crosswise into 1 inch strips.",
      "secondary_message": "1 head romaine lettuce"
    },
    {
      "id": 19136,
      "primary_message": "Wash and halve tomatoes.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 19137,
      "primary_message": "Halve and pit avocado; scoop out the flesh and medium dice.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 19138,
      "primary_message": "Cut chicken into cubes. Roughly chop bacon. Peel and roughly chop eggs.",
      "secondary_message": ""
    },
    {
      "id": 19139,
      "primary_message": "To serve, arrange a bed of lettuce on a plate, then add tomatoes, avocado, chicken, bacon, eggs, and blue cheese in rows over top. Drizzle with dressing and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
    }
  ],
