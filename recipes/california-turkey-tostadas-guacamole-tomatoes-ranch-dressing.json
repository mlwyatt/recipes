  "instructions": [
    {
      "id": 294068,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 294069,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n2 hearts romaine hearts\n1 lime"
    },
    {
      "id": 294070,
      "primary_message": "Drizzle both sides of the tortillas with oil and sprinkle with salt; divide between two baking sheet pans. Place in the oven (it doesn't have to be fully heated), and bake, flipping halfway through, until the tortillas are golden brown and crispy, 10-15 minutes. Remove from oven.",
      "secondary_message": "12 small corn tortillas\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 294071,
      "primary_message": "Meanwhile, halve tomatoes and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 294072,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips; add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 294073,
      "primary_message": "Cut lime into wedges and add to the plate.",
      "secondary_message": null
    },
    {
      "id": 294074,
      "primary_message": "To serve, divide the tortillas between plates and spread with guacamole; top with turkey, tomatoes, and lettuce. Drizzle with dressing, juice lime over top, and enjoy!",
      "secondary_message": "1 cup guacamole\n16 oz oven roasted turkey breast, sliced\n½ cup ranch dressing"
    }
  ],
