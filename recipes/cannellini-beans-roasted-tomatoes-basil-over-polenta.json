  "instructions": [
    {
      "id": 20519,
      "primary_message": "Preheat oven to 425°F and position rack in the center.",
      "secondary_message": ""
    },
    {
      "id": 20520,
      "primary_message": "In a medium saucepan, bring broth and water to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking constantly, until the polenta is incorporated into the liquid. Cook, stirring occasionally, until grains are soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 cups water\n1 cup polenta (cornmeal)"
    },
    {
      "id": 20521,
      "primary_message": "Drain and rinse beans. Place on paper towels and pat dry. Transfer to a baking sheet pan.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 20522,
      "primary_message": "Wash tomatoes and add to beans.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 20523,
      "primary_message": "Peel and mince garlic; add to beans and tomatoes. Drizzle with olive oil and season salt and pepper; toss to combine.",
      "secondary_message": "4 cloves garlic\r\n4 tbsp extra virgin olive oil\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 20524,
      "primary_message": "Place in the oven and roast until tomatoes collapse slightly, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 20525,
      "primary_message": "Wash basil. Pick leaves off the stems; discard the stems and thinly slice the leaves crosswise into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 20526,
      "primary_message": "Finely grate ½ cup of Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 20527,
      "primary_message": "Add Parmesan, salt, and pepper to polenta and stir to combine. If polenta is too firm, add a little more water and stir.",
      "secondary_message": "½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 20528,
      "primary_message": "Remove beans and tomatoes from oven. Sprinkle with basil and drizzle with vinegar; gently toss.",
      "secondary_message": "1 tbsp balsamic vinegar"
    },
    {
      "id": 20529,
      "primary_message": "Place polenta into a bowl and top with beans and tomatoes. Enjoy!",
      "secondary_message": ""
    }
  ],
