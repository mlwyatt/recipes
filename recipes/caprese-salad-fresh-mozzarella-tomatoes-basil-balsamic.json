        "instructions": [
          {
            "id": 375041,
            "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 375042,
            "primary_message": "Medium dice cheese. Add to the bowl with the dressing.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 375043,
            "primary_message": "Wash, dry, and halve tomatoes. Add to the bowl.",
            "secondary_message": "2 pints grape tomatoes"
          },
          {
            "id": 375044,
            "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add to the bowl, then stir to combine the salad.",
            "secondary_message": "½ small pkg fresh basil"
          },
          {
            "id": 375045,
            "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
