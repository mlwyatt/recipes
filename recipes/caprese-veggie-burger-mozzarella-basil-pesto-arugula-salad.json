  "instructions": [
    {
      "id": 287363,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 287364,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 veggie burger patties, plant-based"
    },
    {
      "id": 287365,
      "primary_message": "While the patties are cooking, slice mozzarella into rounds.",
      "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 287366,
      "primary_message": "Wash, dry, and slice tomatoes into rounds.",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 287367,
      "primary_message": "Wash and dry the arugula. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 287368,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 287369,
      "primary_message": "Place the bottom half of each bun on a flat surface, then top with burger patties, mozzarella, tomato, and pesto. Close with the top half of each bun.",
      "secondary_message": "3 tbsp basil pesto"
    },
    {
      "id": 287370,
      "primary_message": "To serve, divide caprese burgers and arugula between plates. Drizzle dressing over the arugula, sprinkle with pine nuts, and enjoy!",
      "secondary_message": "3 tbsp italian salad dressing\n¼ cup pine nuts"
    }
  ],
