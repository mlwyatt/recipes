  "instructions": [
    {
      "id": 304351,
      "primary_message": "Place water and salt in a medium saucepan, cover, and bring to a boil over high heat. ",
      "secondary_message": "28 fl oz (3 ½ cups) water\n⅛ tsp salt"
    },
    {
      "id": 304352,
      "primary_message": "Meanwhile, wash, dry, trim, and peel carrots; coarsely grate.",
      "secondary_message": "4 medium carrots"
    },
    {
      "id": 304353,
      "primary_message": "Roughly chop dates.",
      "secondary_message": "½ cup medjool dates, pitted"
    },
    {
      "id": 304354,
      "primary_message": "Once the water is boiling, stir in carrots, dates, oats, and spices. Reduce heat to low, cover, and let simmer, stirring occasionally, until oatmeal reaches desired consistency, 3-5 minutes.",
      "secondary_message": "2 cup oats, quick cooking\n1 tsp cinnamon, ground\n¼ tsp cloves, ground\n¼ tsp nutmeg, ground"
    },
    {
      "id": 304355,
      "primary_message": "While the oatmeal cooks, roughly chop walnuts.",
      "secondary_message": "⅔ cup walnuts"
    },
    {
      "id": 304356,
      "primary_message": "Divide oatmeal between bowls; top with walnuts and sprinkle with sugar. Serve with milk and enjoy!",
      "secondary_message": "4 tsp brown sugar\n8 fl oz (1 cup) whole milk"
    }
  ],
