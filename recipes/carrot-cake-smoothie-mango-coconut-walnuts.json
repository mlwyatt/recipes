  "instructions": [
    {
      "id": 132626,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 132627,
      "primary_message": "Wash, peel, and trim off the ends of the carrots. Chop into 1-inch chunks and add to blender. ",
      "secondary_message": "4 medium carrots"
    },
    {
      "id": 132628,
      "primary_message": "Wash, dry, peel, and slice ginger; add to blender. (If you have a high powered blender, you can put the peeled chunk in whole). ",
      "secondary_message": "1 (1 inch) piece ginger root"
    },
    {
      "id": 132629,
      "primary_message": "Peel bananas, break into chunks and add to blender. ",
      "secondary_message": "4 bananas"
    },
    {
      "id": 132630,
      "primary_message": "Add almond milk, yogurt, mango, walnuts, coconut, cinnamon, and 8 ice cubes to the blender.",
      "secondary_message": "20 fl oz (2 ½ cups) almond milk, unsweetened\n1 cup plain Greek yogurt\n2 cup frozen mangoes\n½ cup walnuts\n1 tsp cinnamon"
    },
    {
      "id": 132631,
      "primary_message": "Blend on high speed for several minutes until smooth. ",
      "secondary_message": null
    },
    {
      "id": 132632,
      "primary_message": "Pour the smoothie into glasses, top with shredded coconut and enjoy!",
      "secondary_message": "¼ cup shredded unsweetened coconut"
    }
  ],
