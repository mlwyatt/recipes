  "instructions": [
    {
      "id": 484443,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 484444,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n1 small bunch Italian (flat-leaf) parsley\n6 medium carrots\n1 head butter (Boston) lettuce"
    },
    {
      "id": 484445,
      "primary_message": "Juice lemons into a medium bowl. Add oil, honey, Dijon, and spices, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp honey\n1 ½ tsp Dijon mustard\n½ tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 484446,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 484447,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 484448,
      "primary_message": "Peel and halve the eggs. Season with salt.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 484449,
      "primary_message": "Place mayo, water, and additional salt in a small bowl. Whisk to combine.",
      "secondary_message": "½ cup mayonnaise\n4 tsp water\n⅛ tsp salt"
    },
    {
      "id": 484450,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with carrot salad and eggs. Spoon mayo sauce over eggs, top with capers, and season with pepper. Enjoy!",
      "secondary_message": "2 tbsp capers\n¼ tsp black pepper"
    }
  ],
