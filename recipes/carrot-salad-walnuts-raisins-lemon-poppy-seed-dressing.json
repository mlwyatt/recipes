        "instructions": [
          {
            "id": 373656,
            "primary_message": "Wash, dry, and juice lemon into a medium bowl.",
            "secondary_message": "1 lemon"
          },
          {
            "id": 373657,
            "primary_message": "Add oil, maple syrup, poppy seeds, salt, and pepper to the bowl with the lemon juice. Whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 tsp poppy seeds\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 373658,
            "primary_message": "Roughly chop walnuts. Add to the bowl with the dressing along with the raisins and carrots; stir to combine the salad.",
            "secondary_message": "1 cup walnuts\n½ cup raisins\n1 (10 oz) bag shredded carrots"
          },
          {
            "id": 373659,
            "primary_message": "To serve, divide salad between bowls and enjoy!",
            "secondary_message": null
          }
        ],
