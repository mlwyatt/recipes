        "instructions": [
          {
            "id": 272471,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 272472,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. ",
            "secondary_message": null
          },
          {
            "id": 272473,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n1 small bunch asparagus\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 272474,
            "primary_message": "Cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Roughly chop into ½-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 272475,
            "primary_message": "Once the water in the pot is boiling, uncover, add cauliflower, pasta, and salt; stir for a few seconds. Cook until pasta is almost tender, about 7 minutes.",
            "secondary_message": "10 oz penne pasta\n1 tsp salt"
          },
          {
            "id": 272476,
            "primary_message": "Meanwhile, snap or cut off the woody ends of the asparagus and cut into 1-inch pieces. Set aside.",
            "secondary_message": null
          },
          {
            "id": 272477,
            "primary_message": "Peel and mince garlic; place in a large bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 272478,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the garlic (reserving the rest for garnish).",
            "secondary_message": null
          },
          {
            "id": 272479,
            "primary_message": "When the pasta is almost tender, add asparagus to the pot; continue to cook until the pasta and veggies are tender, 3-4 minutes more.",
            "secondary_message": null
          },
          {
            "id": 272480,
            "primary_message": "Meanwhile, add tomato sauce, ricotta, and spices to the bowl with the garlic and parsley; whisk to combine the sauce.",
            "secondary_message": "2 (8 oz) cans tomato sauce\n1 (15 oz) pkg ricotta cheese\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 272481,
            "primary_message": "Coarsely grate mozzarella.",
            "secondary_message": "⅔ (8 oz) block mozzarella cheese"
          },
          {
            "id": 272482,
            "primary_message": "When the pasta and veggies are done, drain in a colander. Add pasta and veggies to the bowl with the sauce; stir to combine.",
            "secondary_message": null
          },
          {
            "id": 272483,
            "primary_message": "Transfer the saucy pasta to a large baking dish, spread out in an even layer, and sprinkle with cheese. Place baking dish in the oven and bake until cheese is melted and bubbly, 10-12 minutes.",
            "secondary_message": null
          },
          {
            "id": 272484,
            "primary_message": "To serve, divide pasta bake between bowls and top with reserved parsley. Enjoy!",
            "secondary_message": null
          }
        ],
