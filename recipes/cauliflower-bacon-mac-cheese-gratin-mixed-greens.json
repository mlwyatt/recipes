  "instructions": [
    {
      "id": 222938,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); add salt, cover, and bring to a boil over high heat.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 222939,
      "primary_message": "Meanwhile, wash, dry, and cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 222940,
      "primary_message": "Once the water is boiling, add cauliflower and cook until tender-crisp, about 8 minutes. Drain in a colander and set aside.",
      "secondary_message": null
    },
    {
      "id": 222941,
      "primary_message": "While the cauliflower is cooking, preheat a large ovenproof skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 222942,
      "primary_message": "Once the skillet is hot, add bacon and cook until crispy, 3-5 minutes per side. Transfer to a plate lined with paper towels, crumble or chop into small pieces, and set aside.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 222943,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 222944,
      "primary_message": "Cut cream cheese into small pieces. Coarsely grate cheddar; set both aside.",
      "secondary_message": "⅔ (8 oz) block cream cheese\n⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 222945,
      "primary_message": "Return skillet (with bacon fat) to medium heat.",
      "secondary_message": null
    },
    {
      "id": 222946,
      "primary_message": "Once the skillet is hot, add milk and spices; whisk to combine and bring to a simmer. Once simmering, add cream cheese, a few pieces at a time, whisking until melted and combined, 2-3 minutes.",
      "secondary_message": "8 fl oz (1 cup) whole milk\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp paprika\n⅛ tsp black pepper"
    },
    {
      "id": 222947,
      "primary_message": "Add half the cheddar to the skillet and whisk until melted. ",
      "secondary_message": null
    },
    {
      "id": 222948,
      "primary_message": "Add cooked cauliflower to the skillet and stir to combine. Sprinkle with remaining cheddar and place in the oven; broil until the top is golden and bubbly, 2-3 minutes. Remove from the oven. ",
      "secondary_message": null
    },
    {
      "id": 222949,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n2 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 222950,
      "primary_message": "Wash and dry the spring mix (skip this step if it came pre-washed). Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 222951,
      "primary_message": "Divide cauliflower between plates and sprinkle with bacon. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
