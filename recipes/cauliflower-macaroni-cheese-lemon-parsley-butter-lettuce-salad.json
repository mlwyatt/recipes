        "instructions": [
          {
            "id": 270490,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n2 heads butter (Boston) lettuce"
          },
          {
            "id": 270491,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil.",
            "secondary_message": null
          },
          {
            "id": 270492,
            "primary_message": "While the water is heating, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
            "secondary_message": null
          },
          {
            "id": 270493,
            "primary_message": "Once the water in the pot is boiling, uncover, and add cauliflower, pasta, and salt; stir for a few seconds. Cook until pasta reaches desired firmness, 8-10 minutes. ",
            "secondary_message": "10 oz macaroni (elbow) pasta\n2 tsp salt"
          },
          {
            "id": 270494,
            "primary_message": "Meanwhile, juice lemon into a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 270495,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with lemon juice (reserving the rest for the pasta).",
            "secondary_message": null
          },
          {
            "id": 270496,
            "primary_message": "Add oil, honey, salt, and pepper to the bowl; whisk to combine the dressing and set aside.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 270497,
            "primary_message": "Coarsely grate cheddar. Cut cream cheese into small pieces.",
            "secondary_message": "⅔ (8 oz) block cheddar cheese\n½ (8 oz) block cream cheese"
          },
          {
            "id": 270498,
            "primary_message": "Preheat a small saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 270499,
            "primary_message": "Once the pan is hot, add milk, cheddar, cream cheese, and spices. Cook, whisking frequently, until cheeses melt and combine, 3-4 minutes; remove cheese sauce from heat.",
            "secondary_message": "8 fl oz (1 cup) whole milk\n1 tsp salt\n½ tsp paprika\n¼ tsp black pepper"
          },
          {
            "id": 270500,
            "primary_message": "When the cauliflower and pasta are done, drain in a strainer, and return to the pot. Add cheese sauce and stir to combine the cauliflower macaroni & cheese. Cover and set aside.",
            "secondary_message": null
          },
          {
            "id": 270501,
            "primary_message": "Chop or tear lettuce into bite-sized pieces and add to the bowl with the dressing; toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 270502,
            "primary_message": "To serve, divide cauliflower macaroni & cheese and salad between plates. Top pasta with reserved parsley and crushed red pepper. Enjoy!",
            "secondary_message": "¼ tsp crushed red pepper"
          }
        ],
