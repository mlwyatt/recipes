        "instructions": [
          {
            "id": 370289,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 370290,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "8 sticks celery\n4 Granny Smith apples\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 370291,
            "primary_message": "Place oil, vinegar, maple syrup, and spices in a large bowl. Whisk to combine the dressing. ",
            "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp white wine vinegar\n1 tbsp pure maple syrup\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
          },
          {
            "id": 370292,
            "primary_message": "Peel and slice shallots crosswise into thin rounds. Add to the bowl with the dressing.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 370293,
            "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 370294,
            "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 370295,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 370296,
            "primary_message": "Roughly chop peanuts and dates. Add both to the bowl and set aside.",
            "secondary_message": "½ cup peanuts, roasted unsalted\n½ cup medjool dates, pitted"
          },
          {
            "id": 370297,
            "primary_message": "Transfer the cooked quinoa to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 370298,
            "primary_message": "Finely grate Parmesan. Add to the bowl, along with the cooled quinoa, and stir to combine the salad.",
            "secondary_message": "4 oz Parmesan cheese"
          },
          {
            "id": 370299,
            "primary_message": "To serve, divide the salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
