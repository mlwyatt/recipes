        "instructions": [
          {
            "id": 164198,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt, add water and bring to a boil over high heat.",
            "secondary_message": "1 ⅓ cups basmati rice\n2 ⅔ cup water\n½ tsp salt"
          },
          {
            "id": 164199,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium zucchini squash\n2 red bell peppers\n2 yellow bell peppers\n1 small bunch cilantro"
          },
          {
            "id": 164200,
            "primary_message": "Preheat oven to broil and position rack under the broiler.",
            "secondary_message": null
          },
          {
            "id": 164201,
            "primary_message": "Season steak with salt and pepper and cut into 1 inch cubes.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 164202,
            "primary_message": "Once the liquid with the rice comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 164203,
            "primary_message": "Peel the onion, cut it into quarters and separate it into slices; place in a medium bowl. ",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 164204,
            "primary_message": "Trim off the ends of the zucchinis then cut in half lengthwise; Cut into 2 inch pieces and add to the bowl with the onion.",
            "secondary_message": null
          },
          {
            "id": 164205,
            "primary_message": "Cut peppers into quarters, remove seeds and membranes; cut in half crosswise and add to bowl with zucchini and onion.",
            "secondary_message": null
          },
          {
            "id": 164206,
            "primary_message": "Add oil, curry powder, pepper and salt to the bowl with the veggies, toss to coat.",
            "secondary_message": "4 tsp extra virgin olive oil\n4 tsp curry powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 164207,
            "primary_message": "Thread beef, onion, squash and peppers onto skewers and place onto the broiler pan. If you don't have skewers, spread veggies and steak on the broiler pan.",
            "secondary_message": null
          },
          {
            "id": 164208,
            "primary_message": "Broil in preheated oven, turning every 3 minutes, until done, about 12 minutes. If you aren't using skewers simply toss the vegetables and beef every 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 164209,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 164210,
            "primary_message": "Uncover the rice and fluff with a fork; gently fold in minced cilantro, reserving 2 tbsp for garnish. ",
            "secondary_message": null
          },
          {
            "id": 164211,
            "primary_message": "To serve, divide rice and skewers between plates and garnish with reserved cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
