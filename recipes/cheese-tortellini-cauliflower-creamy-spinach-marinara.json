  "instructions": [
    {
      "id": 370788,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add cauliflower, tortellini, and salt; stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions).",
      "secondary_message": "2 (10 oz) bags cauliflower florets\n18 oz cheese tortellini, fresh or frozen\n1 tsp salt"
    },
    {
      "id": 370789,
      "primary_message": "Meanwhile, place marinara sauce, cream, and spices in another large pot. Stir to combine and bring the sauce to a simmer over medium heat. Once simmering, reduce heat to medium-low and cook until slightly thickened, 3-4 minutes.",
      "secondary_message": "1 (24 oz) jar marinara sauce\n8 fl oz (1 cup) heavy whipping cream\n½ tsp basil, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 370790,
      "primary_message": "While the sauce is cooking, wash and dry the spinach (skip if it came pre-washed).",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 370791,
      "primary_message": "When the sauce has thickened, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 370792,
      "primary_message": "When the cauliflower and tortellini are done, drain and add to the pot with the creamy marinara sauce; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 370793,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
