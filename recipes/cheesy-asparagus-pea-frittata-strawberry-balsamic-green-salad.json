        "instructions": [
          {
            "id": 421204,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "2 small bunches asparagus\n1 (16 oz) pkg strawberries\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 421205,
            "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 421206,
            "primary_message": "While the skillet heats up, snap (or cut) off woody ends of the asparagus; cut spears into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 421207,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, peas, salt, and pepper; cook, stirring occasionally, until asparagus softens, about 5 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 cups frozen peas\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 421208,
            "primary_message": "Meanwhile, place eggs in a large bowl; whisk to combine and set aside.",
            "secondary_message": "12 eggs"
          },
          {
            "id": 421209,
            "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 421210,
            "primary_message": "When the asparagus is soft, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
            "secondary_message": null
          },
          {
            "id": 421211,
            "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
            "secondary_message": "1 cup shredded cheese, Italian blend"
          },
          {
            "id": 421212,
            "primary_message": "Meanwhile, trim and thinly slice strawberries.",
            "secondary_message": null
          },
          {
            "id": 421213,
            "primary_message": "To serve, cut frittata into wedges and divide between plates. Add mixed greens to the plate, top with strawberries and almonds, then drizzle with vinaigrette. Enjoy!",
            "secondary_message": "¼ cup almonds, sliced\n⅓ cup balsamic vinaigrette"
          }
        ],
