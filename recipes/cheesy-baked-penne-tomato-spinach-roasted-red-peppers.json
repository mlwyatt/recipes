        "instructions": [
          {
            "id": 421263,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 421264,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "1 tsp salt\n10 oz penne pasta"
          },
          {
            "id": 421265,
            "primary_message": "Meanwhile, medium dice peppers and set aside.",
            "secondary_message": "1 (12 oz) jar roasted red bell peppers"
          },
          {
            "id": 421266,
            "primary_message": "Place spinach in a colander.",
            "secondary_message": "1 (16oz) bag frozen chopped spinach"
          },
          {
            "id": 421267,
            "primary_message": "When the pasta is done, drain in the colander over the spinach; return pasta and spinach to the pot.",
            "secondary_message": null
          },
          {
            "id": 421268,
            "primary_message": "Add diced peppers, marinara sauce, and ricotta to the pot with the pasta and spinach; stir to combine.",
            "secondary_message": "1 (24 oz) jar marinara sauce\n1 (15 oz) pkg ricotta cheese"
          },
          {
            "id": 421269,
            "primary_message": "Place pasta over medium heat and cook, stirring occasionally, until just warmed through, 1-2 minutes. Transfer pasta to a large baking dish and top with cheese.",
            "secondary_message": "1 cup shredded cheese, Italian blend"
          },
          {
            "id": 421270,
            "primary_message": "Place baking dish in the oven and bake until cheese is melted and sauce is bubbly, 10-12 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 421271,
            "primary_message": "To serve, divide pasta bake between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
