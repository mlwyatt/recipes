        "instructions": [
          {
            "id": 418013,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 418014,
            "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place in a large baking dish, drizzle with oil, and season with salt and pepper. ",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 418015,
            "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until almost cooked through, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 418016,
            "primary_message": "Meanwhile, wash and dry bell peppers; using a clean cutting board, trim, seed, and small dice. Place in a medium bowl.",
            "secondary_message": "2 green bell peppers"
          },
          {
            "id": 418017,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 418018,
            "primary_message": "While the pot heats up, wash, dry, trim, and cut green onions crosswise into thin pieces. Set aside a small handful for serving and add remaining green onions to the bowl with the bell pepper.",
            "secondary_message": "1 small bunch green onions (scallions)"
          },
          {
            "id": 418019,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, and spices; cook, stirring occasionally, until starting to soften, about 2 minutes. ",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper"
          },
          {
            "id": 418020,
            "primary_message": "Add cauliflower and water to the pot; stir combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook, stirring occasionally, until liquid has evaporated and cauliflower is tender, 5-7 minutes more. Remove from heat and cover to keep warm. ",
            "secondary_message": "2 (12 oz) bags frozen, riced cauliflower\n½ cup water"
          },
          {
            "id": 418021,
            "primary_message": "When the chicken is almost cooked through, remove from oven. Drizzle barbecue sauce over each fillet, then top with cheese. ",
            "secondary_message": "⅔ cup barbecue sauce\n1 cup shredded cheese, Mexican blend"
          },
          {
            "id": 418022,
            "primary_message": "Return baking dish to the oven and continue to bake until cheese is melted and chicken is cooked through, 8-10 minutes more. Remove from oven. ",
            "secondary_message": null
          },
          {
            "id": 418023,
            "primary_message": "To serve, divide chicken and cauliflower rice between plates. Top with reserved green onions and enjoy!",
            "secondary_message": null
          }
        ],
