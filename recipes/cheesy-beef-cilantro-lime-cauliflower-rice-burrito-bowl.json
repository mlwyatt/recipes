  "instructions": [
    {
      "id": 354322,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 small bunch cilantro\n2 limes\n1 pint grape tomatoes\n1 avocado"
    },
    {
      "id": 354323,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 354324,
      "primary_message": "Once the skillet is hot, add ground beef and spices. Cook, breaking apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 ½ lb lean ground beef\n2 tsp cumin, ground\n2 tsp chili powder\n1 tsp oregano, dried\n½ tsp salt"
    },
    {
      "id": 354325,
      "primary_message": "Meanwhile, peel and mince garlic. Once the beef is done cooking, add the garlic and stir to combine. Transfer to a medium bowl and loosely cover with foil.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 354326,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 354327,
      "primary_message": "Return skillet to medium-high heat, add butter and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 354328,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 354329,
      "primary_message": "Add cauliflower and spices to the skillet with the onion. Continue to cook, stirring often, until cauliflower is lightly golden and cooked through, 6-8 minutes more. ",
      "secondary_message": "1 tsp chili powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 354330,
      "primary_message": "Grate the cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 354331,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 354332,
      "primary_message": "Cut one lime into wedges, reserving the other lime for the cauliflower rice.",
      "secondary_message": null
    },
    {
      "id": 354333,
      "primary_message": "When the cauliflower rice is done, juice remaining lime into the skillet. Add cilantro and beef; gently stir to combine and continue to cook until heated through, 2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 354334,
      "primary_message": "Meanwhile, halve tomatoes. Halve and pit avocado; slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 354335,
      "primary_message": "To serve, divide cauliflower rice mixture between bowls or plates and top with grated cheese, tomatoes, and avocado. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
