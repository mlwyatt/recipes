        "instructions": [
          {
            "id": 466548,
            "primary_message": "Place hash browns in a colander; rinse under hot water (from the tap) to thaw. Using your hands, squeeze as much water from the hash browns as you can.",
            "secondary_message": "2 cups frozen shredded hash brown potatoes"
          },
          {
            "id": 466549,
            "primary_message": "Place hash browns in a medium bowl along with beef, cheese, eggs, salt, and pepper. Mix with your hands to combine, then form into 12 equal-sized patties and place on a plate.",
            "secondary_message": "1 ½ lb lean ground beef\n1 cup shredded cheese, Mexican blend\n2 eggs\n1 tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 466550,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 466551,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add patties and cook, undisturbed, until golden underneath, about 5 minutes; flip patties and cook an additional 5-6 minutes, until cooked through. Remove from heat.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 466552,
            "primary_message": "Meanwhile, wash, dry, and halve grape tomatoes. Place in a clean medium bowl.",
            "secondary_message": "1 pint grape tomatoes"
          },
          {
            "id": 466553,
            "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the tomatoes, along with dressing, and toss to combine the salad.",
            "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n¼ cup ranch dressing"
          },
          {
            "id": 466554,
            "primary_message": "To serve, divide salad and patties between plates. Drizzle patties with ketchup and enjoy!",
            "secondary_message": "¼ cup ketchup"
          }
        ],
