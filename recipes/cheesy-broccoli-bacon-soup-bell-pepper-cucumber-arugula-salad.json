        "instructions": [
          {
            "id": 424389,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 424390,
            "primary_message": "While the pot heats up, small dice bacon. ",
            "secondary_message": "8 slices bacon"
          },
          {
            "id": 424391,
            "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until golden brown and crispy, 4-5 minutes. ",
            "secondary_message": null
          },
          {
            "id": 424392,
            "primary_message": "Meanwhile, wash and dry the fresh produce. ",
            "secondary_message": "2 orange bell peppers\n1 English cucumber\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 424393,
            "primary_message": "When the bacon is done, add broth, Alfredo sauce, broccoli, and spices to the pot. Stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until broccoli is tender, about 5 minutes. Remove from heat.",
            "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 (16 oz) jar Alfredo sauce\n1 (18 oz) bag broccoli florets\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
          },
          {
            "id": 424394,
            "primary_message": "While the soup is cooking, using a clean cutting board, trim, seed, and medium dice bell peppers. Place in a medium bowl. ",
            "secondary_message": null
          },
          {
            "id": 424395,
            "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the bell pepper. ",
            "secondary_message": null
          },
          {
            "id": 424396,
            "primary_message": "Add arugula and dressing to the bowl, then toss to combine the salad. ",
            "secondary_message": "¼ cup Italian salad dressing"
          },
          {
            "id": 424397,
            "primary_message": "Divide soup between bowls and top with cheese; serve with salad on the side. Enjoy!",
            "secondary_message": "½ cup Parmesan cheese, shredded"
          }
        ],
