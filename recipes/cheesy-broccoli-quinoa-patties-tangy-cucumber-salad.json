  "instructions": [
    {
      "id": 110323,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and spread onto a baking sheet in a thin layer to cool.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 110324,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 English cucumbers"
    },
    {
      "id": 110325,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 110326,
      "primary_message": "Peel and small dice the onion; set half aside in a large bowl for the salad.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 110327,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 110328,
      "primary_message": "Add the other half of the onion to the skillet; cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 110329,
      "primary_message": "Finely mince the broccoli (you should have about 4 cups). Add to the skillet along with the onion and cook another 3-4 minutes, stirring frequently. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 110330,
      "primary_message": "Grate the cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 110331,
      "primary_message": "In a large bowl, combine the cooked quinoa, onion, broccoli, cheese, panko, and eggs.",
      "secondary_message": "1 cup panko bread crumbs\n4 eggs"
    },
    {
      "id": 110332,
      "primary_message": "Form the quinoa vegetable mixture into patties using a ¼-cup measure, firmly pressing the mixture together between your hands.",
      "secondary_message": null
    },
    {
      "id": 110333,
      "primary_message": "Wipe out the skillet with a paper towel and heat over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 110334,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place the patties in the skillet and cook for 5-6 minutes; flip and cook another 2-3 minutes, until golden brown on both sides. Work in batches if necessary.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 110335,
      "primary_message": "Trim the ends of the cucumber; then thinly slice.",
      "secondary_message": null
    },
    {
      "id": 110336,
      "primary_message": "Add cucumber, oil, vinegar, salt, and pepper to the bowl with the onion. Stir to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 110337,
      "primary_message": "To serve, divide the quinoa patties and cucumber salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
