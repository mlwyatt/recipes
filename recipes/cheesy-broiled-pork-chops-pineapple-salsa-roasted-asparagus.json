        "instructions": [
          {
            "id": 418269,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 418270,
            "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 418271,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and cook until golden brown, about 2 minutes per side (they will not be cooked all the way through).",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 418272,
            "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 418273,
            "primary_message": "When the chops are done, transfer to one half of a large baking sheet pan, sprinkle with cheese, and set aside.",
            "secondary_message": "1 cup shredded cheese, Mexican blend"
          },
          {
            "id": 418274,
            "primary_message": "Wash and dry asparagus. Snap (or cut) off woody ends and arrange on the other half of the baking sheet. Drizzle with oil and season with salt and pepper.",
            "secondary_message": "2 small bunches asparagus\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 418275,
            "primary_message": "Place baking sheet in the oven and broil until the chops are cooked through, cheese is melted, and asparagus softens slightly, 3-4 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 418276,
            "primary_message": "Meanwhile, wash, dry, and cut off skin from pineapple; quarter, core, and small dice the flesh. Place in a medium bowl, along with the salsa, and stir to combine.",
            "secondary_message": "1 small pineapple\n1 cup salsa"
          },
          {
            "id": 418277,
            "primary_message": "To serve, divide pork chops, asparagus, and pineapple salsa between plates. Enjoy!",
            "secondary_message": null
          }
        ],
