        "instructions": [
          {
            "id": 418325,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 418326,
            "primary_message": "Wash, dry, trim, seed, and medium dice bell peppers. Transfer to a large baking sheet pan.",
            "secondary_message": "2 red bell peppers"
          },
          {
            "id": 418327,
            "primary_message": "Wash, dry, trim, and medium dice zucchini. Add to the baking sheet with the bell pepper.",
            "secondary_message": "2 medium zucchini squash"
          },
          {
            "id": 418328,
            "primary_message": "Peel, halve, and small dice onion. Add to the baking sheet along with butternut squash. Drizzle veggies with oil, then season with Cajun seasoning and salt. Stir to coat and spread out in an even layer.",
            "secondary_message": "1 medium yellow onion\n4 cup frozen butternut squash, pieces\n2 tbsp extra virgin olive oil\n4 tsp Cajun seasoning\n½ tsp salt"
          },
          {
            "id": 418329,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until veggies start to soften, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 418330,
            "primary_message": "While the veggies are baking, medium dice ham.",
            "secondary_message": "16 oz ham steak, boneless"
          },
          {
            "id": 418331,
            "primary_message": "When the veggies are starting to soften, remove baking sheet from the oven. Add the ham and stir to combine, then sprinkle with cheese.",
            "secondary_message": "1 ⅓ cups shredded cheese, Mexican blend"
          },
          {
            "id": 418332,
            "primary_message": "Return baking sheet to the oven and continue to bake until veggies are soft and cheese is melted, 5-6 minutes more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 418333,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 418334,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
            "secondary_message": "4 tsp extra virgin olive oil\n8 eggs\n⅛ tsp salt"
          },
          {
            "id": 418335,
            "primary_message": "To serve divide the hash and eggs between plates. Enjoy!",
            "secondary_message": null
          }
        ],
