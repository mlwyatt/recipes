  "instructions": [
    {
      "id": 189844,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 189845,
      "primary_message": "Wash the broccoli and cut into bite-sized florets; transfer to a large pot. Fill with just enough water to cover florets and add salt to season.",
      "secondary_message": "2 crowns broccoli\n1 tsp salt"
    },
    {
      "id": 189846,
      "primary_message": "Bring to a boil, then reduce heat to a simmer and cook until the broccoli is fork-tender, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 189847,
      "primary_message": "Add yogurt, mayo, curry powder, salt, pepper and garlic powder to a medium mixing bowl.",
      "secondary_message": "1 cup plain Greek yogurt\n½ cup mayonnaise\n½ tsp curry powder\n½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 189848,
      "primary_message": "Coarsely grate the cheddar, set aside.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 189849,
      "primary_message": "When broccoli is done, drain well in a colander and add to a baking dish.",
      "secondary_message": null
    },
    {
      "id": 189850,
      "primary_message": "Pour yogurt mixture over broccoli and top with cheddar cheese. Bake in the oven for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 189851,
      "primary_message": "While broccoli mixture cooks, heat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 189852,
      "primary_message": "Pat the chicken breasts dry with paper towel and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken breasts, boneless skinless\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 189853,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 189854,
      "primary_message": "Working in batches if necessary, place the chicken breasts in the skillet; cook until the chicken is golden brown and cooked through, 4-5 minutes per side. ",
      "secondary_message": null
    },
    {
      "id": 189855,
      "primary_message": "To serve, divide broccoli and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
