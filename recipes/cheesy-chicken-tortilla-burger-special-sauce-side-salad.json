  "instructions": [
    {
      "id": 472724,
      "primary_message": "Place chicken, bread crumbs, Worcestershire, salt, and pepper in a medium bowl; mix with your hands until well combined. Divide the chicken mixture into 4 portions and form into ½-inch thick patties; place on a plate and set aside.",
      "secondary_message": "1 lb ground chicken\n½ cup panko bread crumbs\n2 tsp Worcestershire sauce\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 472725,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 472726,
      "primary_message": "While the skillet heats, up thinly slice cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 472727,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, until golden underneath, 3-4 minutes; flip patties, top with cheese, and cook an additional 3-4 minutes, until cooked through. Remove to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 472728,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 tomatoes\n2 heads butter (Boston) lettuce\n1 English cucumber"
    },
    {
      "id": 472729,
      "primary_message": "Place oil, vinegar, Dijon, honey, and spices in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 472730,
      "primary_message": "Slice two tomatoes crosswise into thin rounds; medium dice remaining tomatoes. Place slices on another plate and add diced tomato to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 472731,
      "primary_message": "Separate lettuce into leaves. Set aside a few leaves per burger and chop (or tear) remaining leaves into bite-sized pieces. Add whole leaves to the plate and chopped lettuce to the bowl. Set the plate aside.",
      "secondary_message": null
    },
    {
      "id": 472732,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 472733,
      "primary_message": "Place mayo, ketchup, Dijon, and cayenne in a small bowl. Whisk to combine the special sauce and set aside.",
      "secondary_message": "2 tbsp mayonnaise\n4 tsp ketchup\n2 tsp Dijon mustard\n⅛ tsp cayenne pepper"
    },
    {
      "id": 472734,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "8 small flour tortillas"
    },
    {
      "id": 472735,
      "primary_message": "To assemble the burgers, place half of the tortillas on a flat surface, then top with cheesy burger patties, lettuce leaves, tomato slices, and special sauce. Close with the remaining tortillas and cut in half.",
      "secondary_message": null
    },
    {
      "id": 472736,
      "primary_message": "To serve, divide chicken burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
