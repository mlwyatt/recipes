        "instructions": [
          {
            "id": 458169,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 458170,
            "primary_message": "Wash, dry, and quarter potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, about 10 minutes.",
            "secondary_message": "1 ½ lb new potatoes\n1 tsp salt"
          },
          {
            "id": 458171,
            "primary_message": "Meanwhile, peel, halve, and slice onions crosswise into thin half-moons. Peel and mince garlic.",
            "secondary_message": "2 medium yellow onions\n2 cloves garlic"
          },
          {
            "id": 458172,
            "primary_message": "Preheat a large ovenproof skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 458173,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion and garlic to the skillet; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
            "secondary_message": "4 tsp butter, unsalted"
          },
          {
            "id": 458174,
            "primary_message": "Add beef and spices to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly 4-5 minutes. Remove from heat.",
            "secondary_message": "1 ½ lb lean ground beef\n1 tsp thyme, dried\n1 tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 458175,
            "primary_message": "While the beef is cooking, coarsely grate mozzarella.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 458176,
            "primary_message": "When the potatoes are done, drain and add to the skillet with the beef and onions. Gently crush some of the potatoes using a fork or potato masher. Add broth and Worcestershire to the skillet and stir to combine. (Reserve pot for later use.)",
            "secondary_message": "6 fl oz (¾ cup) chicken or vegetable broth\n4 tsp Worcestershire sauce"
          },
          {
            "id": 458177,
            "primary_message": "Sprinkle mozzarella over the beef and potatoes. Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 458178,
            "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
            "secondary_message": "2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 458179,
            "primary_message": "Return the pot to medium heat.",
            "secondary_message": null
          },
          {
            "id": 458180,
            "primary_message": "Once the pot is hot, add additional butter and swirl to coat the bottom. Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, and remove from heat.",
            "secondary_message": "4 tsp butter, unsalted\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 458181,
            "primary_message": "To serve, divide beef-potato skillet and spinach between plates. Enjoy!",
            "secondary_message": null
          }
        ],
