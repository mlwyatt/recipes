        "instructions": [
          {
            "id": 177335,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and place over high heat.",
            "secondary_message": null
          },
          {
            "id": 177336,
            "primary_message": "Wash and dry the spinach. (Skip this step if it came pre-washed.)",
            "secondary_message": "2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 177337,
            "primary_message": "Wash and separate broccoli into bite-sized florets and cut stems into smaller pieces.",
            "secondary_message": "2 crowns broccoli"
          },
          {
            "id": 177338,
            "primary_message": "Once the water in the pot is boiling, add the spinach, and stir. Cook 30-60 seconds, then remove to a colander with a slotted spoon. Rinse spinach under cold water, then press out excess water with the back of a spoon or your hands; transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 177339,
            "primary_message": "When the water in the pot returns to a boil, add the broccoli, cover, and reduce heat to medium. Cook until broccoli is fork-tender, about 4 minutes. Drain and set aside.",
            "secondary_message": null
          },
          {
            "id": 177340,
            "primary_message": "Coarsely grate the mozzarella.",
            "secondary_message": "1 (8 oz) block mozzarella cheese"
          },
          {
            "id": 177341,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 177342,
            "primary_message": "Pat chicken dry with paper towels and cut into 1-inch pieces.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 177343,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 177344,
            "primary_message": "Add chicken and spices to the skillet. Cook, stirring occasionally, until golden and cooked through, 4-5 minutes.",
            "secondary_message": "2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
          },
          {
            "id": 177345,
            "primary_message": "Meanwhile, peel and mince the garlic. When the chicken is done, add the garlic to the skillet and cook 1 minute more.",
            "secondary_message": "6 cloves garlic"
          },
          {
            "id": 177346,
            "primary_message": "Add spinach, broccoli, mozzarella, and ricotta to the skillet; continue to cook, stirring frequently, until cheese is melted and starting to bubble.",
            "secondary_message": "1 (15 oz) pkg ricotta cheese"
          },
          {
            "id": 177347,
            "primary_message": "To serve, divide chicken sauté between plates, sprinkle with crushed red pepper, and enjoy!",
            "secondary_message": "⅛ tsp crushed red pepper"
          }
        ],
