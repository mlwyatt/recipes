  "instructions": [
    {
      "id": 323937,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 323938,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 red bell peppers\n1 lime\n1 small bunch cilantro\n1 head romaine lettuce\n1 pint grape tomatoes"
    },
    {
      "id": 323939,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 323940,
      "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 5-6 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 323941,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323942,
      "primary_message": "Once the skillet is hot, add beef and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 ½ lb lean ground beef\n2 tsp chili powder\n1 tsp cumin, ground\n1 tsp garlic powder\n1 tsp onion powder\n1 tsp paprika\n1 tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 323943,
      "primary_message": "While the beef is cooking, juice lime into a medium bowl. Add oil and spices; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 323944,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing (reserving the other half for the beef). ",
      "secondary_message": null
    },
    {
      "id": 323945,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 323946,
      "primary_message": "When the beef is done, add reserved cilantro and half of the cheese (setting the rest aside for topping the peppers) to the skillet; stir to combine the filling.",
      "secondary_message": null
    },
    {
      "id": 323947,
      "primary_message": "Divide beef mixture between pepper halves and top with remaining cheese. Return baking sheet to the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 323948,
      "primary_message": "Meanwhile, halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips; add to the bowl with the dressing and cilantro.",
      "secondary_message": null
    },
    {
      "id": 323949,
      "primary_message": "Halve tomatoes and add to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 323950,
      "primary_message": "To serve, divide stuffed peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
