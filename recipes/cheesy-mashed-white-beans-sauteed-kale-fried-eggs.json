        "instructions": [
          {
            "id": 31077,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 bunches kale\n1 lemon"
          },
          {
            "id": 31078,
            "primary_message": "Fold each kale leaf lengthwise, slice away and discard the stems, and slice the leaves crosswise into ⅛-inch strips and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 31079,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic and transfer to a small bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 31080,
            "primary_message": "Preheat a small saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 31081,
            "primary_message": "While the saucepan heats up, drain and rinse the beans.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 31082,
            "primary_message": "Finely grate ½ cup of Parmesan.",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 31083,
            "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom.",
            "secondary_message": "4 tbsp butter, unsalted"
          },
          {
            "id": 31084,
            "primary_message": "Add ½ of the garlic to the saucepan (save the rest for the kale); cook until fragrant, 15 to 30 seconds.",
            "secondary_message": null
          },
          {
            "id": 31085,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 31086,
            "primary_message": "Add the beans and ½ of the broth to the saucepan; bring to a boil, then mash the beans with a potato masher.",
            "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
          },
          {
            "id": 31087,
            "primary_message": "Add the remaining broth, most of the Parmesan (save a little for garnishing), salt, and pepper to the bean mash; stir to combine. Remove the saucepan from the heat and cover to keep the mash warm.",
            "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 31088,
            "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 31089,
            "primary_message": "Gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 2 to 3 minutes. Once done, separate the eggs and transfer to a plate.",
            "secondary_message": "8 eggs"
          },
          {
            "id": 31090,
            "primary_message": "Once the eggs have been transferred, add more oil to the skillet.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 31091,
            "primary_message": "Add the remaining garlic and kale to the skillet; season with salt and pepper. Cook, stirring frequently, until the kale is wilted, 3 to 4 minutes.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 31092,
            "primary_message": "Juice the lemon and pour over the kale; stir to combine.",
            "secondary_message": ""
          },
          {
            "id": 31093,
            "primary_message": "To serve, spoon the mashed beans into a bowl, top with the kale and fried eggs, and sprinkle with the remaining Parmesan. Enjoy!",
            "secondary_message": null
          }
        ],
