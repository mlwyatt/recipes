        "instructions": [
          {
            "id": 424033,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 424034,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "4 medium zucchini squash\n2 orange bell peppers\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 424035,
            "primary_message": "Trim and halve zucchini lengthwise. Scrape out the soft flesh from the middle of each half, place in a medium bowl, and set aside for later use.",
            "secondary_message": null
          },
          {
            "id": 424036,
            "primary_message": "Arrange zucchini halves, cut-side up, on a baking sheet pan; drizzle with oil and season with salt and pepper.",
            "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 424037,
            "primary_message": "Place zucchini boats in the oven and bake until starting to soften, 5-7 minutes.",
            "secondary_message": null
          },
          {
            "id": 424038,
            "primary_message": "Meanwhile, roughly chop reserved zucchini flesh and return to the bowl.",
            "secondary_message": null
          },
          {
            "id": 424039,
            "primary_message": "Drain and rinse beans. Add to the bowl with the zucchini along with salsa and spices; stir to combine the filling.",
            "secondary_message": "2 (15 oz) cans black beans\n2 cup salsa\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 424040,
            "primary_message": "Remove zucchini boats from the oven, divide filling between them, and top with cheese. (Wipe bowl clean with paper towels and set aside for later use.)",
            "secondary_message": "1 ⅓ cups shredded cheese, Mexican blend"
          },
          {
            "id": 424041,
            "primary_message": "Return zucchini boats to the oven and continue to bake until flesh is tender, filling is warmed through, and cheese is bubbly, about 10 minutes. Remove from the oven.",
            "secondary_message": null
          },
          {
            "id": 424042,
            "primary_message": "Meanwhile, rinse corn under hot water (from the tap) to thaw. Pat dry with paper towels and place in the reserved bowl.",
            "secondary_message": "1 cup frozen corn"
          },
          {
            "id": 424043,
            "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the corn, along with the mixed greens, and set aside.",
            "secondary_message": null
          },
          {
            "id": 424044,
            "primary_message": "Right before serving, add dressing to the bowl with the mixed greens and toss to combine the salad.",
            "secondary_message": "¼ cup ranch dressing"
          },
          {
            "id": 424045,
            "primary_message": "To serve, divide zucchini boats and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
