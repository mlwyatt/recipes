        "instructions": [
          {
            "id": 302466,
            "primary_message": "Peel and small dice the onion. Peel and mince the garlic.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 302467,
            "primary_message": "Heat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 302468,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 302469,
            "primary_message": "Add the onion and garlic to the pot; cook, stirring frequently, until slightly softened, 4-5 minutes.",
            "secondary_message": null
          },
          {
            "id": 302470,
            "primary_message": "Use the tip of a knife to slice down the length of the sausages. Peel off the casings and discard. Add the pork to the pot and break apart with a spoon. Cook, stirring occasionally, until pork is browned and crumbly, 6-8 minutes.",
            "secondary_message": "4 pork sausages"
          },
          {
            "id": 302471,
            "primary_message": "Coarsely grate the mozzarella. Finely grate the Parmesan.",
            "secondary_message": "½ (8 oz) block mozzarella cheese\n1 oz Parmesan cheese"
          },
          {
            "id": 302472,
            "primary_message": "Add gnocchi, diced tomatoes with their juices, water, Italian seasoning, and salt to the pot. Cover and cook on medium heat until gnocchi is cooked through, 3-5 minutes. Remove from heat.",
            "secondary_message": "1 (16 oz) pkg potato gnocchi\n2 (14.5 oz) cans diced tomatoes\n½ cup water\n1 tsp Italian seasoning\n½ tsp salt"
          },
          {
            "id": 302473,
            "primary_message": "Wash and dry the spinach (Skip the spinach if it came pre-washed.) Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful, 1-2 minutes. Stir until well combined. ",
            "secondary_message": "1 (5 oz) pkg baby spinach"
          },
          {
            "id": 302474,
            "primary_message": "Sprinkle both cheeses over the gnocchi and cover. Let sit for 3-5 minutes until cheese is melted.",
            "secondary_message": null
          },
          {
            "id": 302475,
            "primary_message": "To serve, divide gnocchi between bowls and enjoy!",
            "secondary_message": null
          }
        ],
