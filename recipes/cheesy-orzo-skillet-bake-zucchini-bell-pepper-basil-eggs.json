        "instructions": [
          {
            "id": 480434,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
            "secondary_message": "1 tsp salt\n10 oz orzo pasta"
          },
          {
            "id": 480435,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 medium zucchini squash\n2 red bell peppers\n1 small pkg fresh basil"
          },
          {
            "id": 480436,
            "primary_message": "Trim and small dice zucchini. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 480437,
            "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the zucchini and set aside.",
            "secondary_message": null
          },
          {
            "id": 480438,
            "primary_message": "Preheat a large ovenproof skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 480439,
            "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 480440,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion, garlic, and spices to the skillet. Cook, stirring frequently, until onion begins to soften, 2-3 minutes.",
            "secondary_message": "2 tbsp butter, unsalted\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp crushed red pepper"
          },
          {
            "id": 480441,
            "primary_message": "Add zucchini and bell pepper to the skillet. Continue to cook, stirring often, until veggies are tender, 5-6 minutes. (Reserve bowl for the next step.)",
            "secondary_message": null
          },
          {
            "id": 480442,
            "primary_message": "While the veggies are cooking, coarsely grate cheese. Place in the reserved bowl and set aside.",
            "secondary_message": "⅔ (8 oz) block mozzarella cheese"
          },
          {
            "id": 480443,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 480444,
            "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 480445,
            "primary_message": "Add cooked orzo, tomato sauce, and half of the basil to the skillet (reserve remaining basil for serving). Cook, stirring occasionally, until sauce is warmed through, 2-3 minutes. Remove from heat.",
            "secondary_message": "2 (8 oz) cans tomato sauce"
          },
          {
            "id": 480446,
            "primary_message": "Using a stirring spoon, make a well for each egg in the orzo. Crack an egg into each well.",
            "secondary_message": "8 eggs"
          },
          {
            "id": 480447,
            "primary_message": "Place skillet in the oven and broil until egg whites are just set, 3-4 minutes. Top with cheese and continue to broil until melted, 1 minute more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 480448,
            "primary_message": "To serve, divide orzo and eggs between plates or bowls; top with reserved basil. Enjoy!",
            "secondary_message": null
          }
        ],
