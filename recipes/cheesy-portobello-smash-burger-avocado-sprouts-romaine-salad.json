        "instructions": [
          {
            "id": 489400,
            "primary_message": "Place mayo, ketchup, and spices in a small bowl. Whisk to combine the special sauce and set aside. ",
            "secondary_message": "¼ cup mayonnaise\n2 tbsp ketchup\n½ tsp smoked paprika\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 489401,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 caps portobello mushrooms\n1 head romaine lettuce\n4 tomatoes\n2 avocados\n1 (3 oz) pkg alfalfa sprouts"
          },
          {
            "id": 489402,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 489403,
            "primary_message": "While the skillet heats up, remove stems from portobello mushrooms. Place on a plate, drizzle with oil, and season with salt and pepper on both sides. ",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 489404,
            "primary_message": "Once the skillet is hot, add mushrooms, cap-side down. Cook until starting to soften, about 3 minutes. Flip and continue to cook, occasionally pressing down with the bottom of a spatula, until golden underneath, 2-3 minutes more. ",
            "secondary_message": null
          },
          {
            "id": 489405,
            "primary_message": "While the mushrooms are cooking, place oil, vinegar, Dijon, honey, and salt in a medium bowl. Whisk to combine the dressing and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n2 tsp Dijon mustard\n2 tsp honey\n¼ tsp salt"
          },
          {
            "id": 489406,
            "primary_message": "Thinly slice cheese. ",
            "secondary_message": "⅔ (8 oz) block mozzarella cheese"
          },
          {
            "id": 489407,
            "primary_message": "When the mushrooms are golden underneath, flip once more and top with cheese. Continue to cook until cheese melts and mushrooms are fork-tender, 3-4 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 489408,
            "primary_message": "Meanwhile, chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 489409,
            "primary_message": "Slice two tomatoes crosswise into thin rounds; medium dice remaining tomatoes. Place slices on a clean plate and add diced tomato to the bowl with the lettuce and dressing; toss to combine the salad. ",
            "secondary_message": null
          },
          {
            "id": 489410,
            "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice lengthwise into thin slices. Add to the plate with the tomato. ",
            "secondary_message": null
          },
          {
            "id": 489411,
            "primary_message": "Toast buns if desired.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 489412,
            "primary_message": "Spread special sauce over the bottom half of each bun; top with cheesy portobellos, then layer with tomato, avocado, and sprouts. Close with the top half of each bun. Serve with salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
