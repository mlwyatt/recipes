        "instructions": [
          {
            "id": 295073,
            "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
            "secondary_message": null
          },
          {
            "id": 295074,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "4 orange bell peppers\n1 lb cremini mushrooms\n2 tomatoes\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 295075,
            "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
            "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 295076,
            "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven and set aside to cool.",
            "secondary_message": null
          },
          {
            "id": 295077,
            "primary_message": "Meanwhile, thinly slice mushrooms and place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 295078,
            "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the mushrooms.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 295079,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry, then roughly chop into bite-sized pieces.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 295080,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 295081,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add shrimp, mushrooms, onion, garlic, and spices. Cook, stirring occasionally, until veggies are tender and shrimp is cooked through, about 5 minutes. Remove from heat. (Reserve bowl for the next step.)",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 295082,
            "primary_message": "Meanwhile, using a clean cutting board, medium dice tomatoes and place in the reserved bowl.",
            "secondary_message": null
          },
          {
            "id": 295083,
            "primary_message": "Coarsely grate cheese; add half to the bowl with the tomato (reserving the rest for topping the peppers).",
            "secondary_message": "1 (8 oz) block mozzarella cheese"
          },
          {
            "id": 295084,
            "primary_message": "When the shrimp and veggies are done, add tomato and cheese to the skillet; stir to combine the filling. (Reserve bowl for the salad.)",
            "secondary_message": null
          },
          {
            "id": 295085,
            "primary_message": "Divide shrimp filling between pepper halves and top with reserved cheese. Return baking sheet to the oven and broil until cheese is golden, 2-3 minutes; remove from oven.",
            "secondary_message": null
          },
          {
            "id": 295086,
            "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp white wine vinegar\n2 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 295087,
            "primary_message": "Add mixed greens and pumpkin seeds to the bowl with the dressing; toss to combine the salad.",
            "secondary_message": "½ cup pumpkin seeds"
          },
          {
            "id": 295088,
            "primary_message": "To serve, divide peppers and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
