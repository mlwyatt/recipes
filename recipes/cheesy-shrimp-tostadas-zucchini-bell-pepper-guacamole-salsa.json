        "instructions": [
          {
            "id": 418457,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 418458,
            "primary_message": "Arrange tortillas on a large baking sheet pan. Drizzle with oil on both sides, then season with salt.",
            "secondary_message": "12 small corn tortillas\n4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 418459,
            "primary_message": "Place tortillas in the oven (it doesn't have to be fully heated) and bake until starting to crisp, 5-7 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 418460,
            "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; small dice. Place in a large bowl.",
            "secondary_message": "2 red bell peppers"
          },
          {
            "id": 418461,
            "primary_message": "Wash, dry, trim, and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper.",
            "secondary_message": "2 medium zucchini squash"
          },
          {
            "id": 418462,
            "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 418463,
            "primary_message": "Add shrimp and taco seasoning to the bowl with the veggies, then toss to combine.",
            "secondary_message": "3 tbsp taco seasoning"
          },
          {
            "id": 418464,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 418465,
            "primary_message": "While the skillet heats up, flip tortillas and sprinkle with cheese. Return baking sheet to the oven and continue to bake until cheese is melted, 4-5 minutes more. Remove from oven.",
            "secondary_message": "1 cup shredded cheese, Mexican blend"
          },
          {
            "id": 418466,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp and veggies; cook, stirring occasionally, until shrimp are cooked through and veggies are tender, 4-5 minutes. Remove from heat.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 418467,
            "primary_message": "To serve, divide tostadas between plates; top with shrimp, veggies, guacamole, and salsa. Enjoy!",
            "secondary_message": "1 cup guacamole\n⅔ cup salsa"
          }
        ],
