        "instructions": [
          {
            "id": 155739,
            "primary_message": "Preheat oven to 375°F.",
            "secondary_message": null
          },
          {
            "id": 155740,
            "primary_message": "Using a strainer or colander, rinse rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 155741,
            "primary_message": "Once liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook rice until the liquid is fully absorbed, 15-18 minutes. ",
            "secondary_message": null
          },
          {
            "id": 155742,
            "primary_message": "Meanwhile, wash and dry mushrooms; remove stems and carefully scrape out gills, making sure not to damage the rim of the mushrooms. Place on a baking sheet and rub with oil; set aside.",
            "secondary_message": "8 caps portobello mushrooms\n4 tsp extra virgin olive oil"
          },
          {
            "id": 155743,
            "primary_message": "Peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 155744,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 155745,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 155746,
            "primary_message": "Add garlic to the skillet and cook until fragrant, 15-30 seconds.",
            "secondary_message": null
          },
          {
            "id": 155747,
            "primary_message": "Wash and dry the spinach. (Skip if it came pre-washed.) Add to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
            "secondary_message": "2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 155748,
            "primary_message": "Finely grate Parmesan.",
            "secondary_message": "4 oz Parmesan cheese"
          },
          {
            "id": 155749,
            "primary_message": "Add Parmesan, yogurt, salt, and pepper to the skillet and stir to combine; remove from the heat. When the rice is done, add to skillet and stir to combine.",
            "secondary_message": "1 ⅓ cups plain Greek yogurt\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 155750,
            "primary_message": "Fill mushroom caps with equal portions of the rice mixture. Place in the oven and bake for 12 minutes.",
            "secondary_message": null
          },
          {
            "id": 155751,
            "primary_message": "Meanwhile, grate mozzarella.",
            "secondary_message": "⅔ (8 oz) block mozzarella cheese"
          },
          {
            "id": 155752,
            "primary_message": "Remove baking sheet from oven and top mushrooms with mozzarella. Bake for another 5 minutes, until cheese is golden and melted.",
            "secondary_message": null
          },
          {
            "id": 155753,
            "primary_message": "To serve, divide mushrooms between plates. Enjoy!",
            "secondary_message": null
          }
        ],
