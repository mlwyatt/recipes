        "instructions": [
          {
            "id": 302830,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium zucchini squash\n2 medium carrots\n2 yellow bell peppers\n2 tomatoes"
          },
          {
            "id": 302831,
            "primary_message": "Trim zucchini and carrots; use a julienne (or regular) peeler to make noodles. Place both in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 302832,
            "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the veggie noodles and set aside.",
            "secondary_message": null
          },
          {
            "id": 302833,
            "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 302834,
            "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 302835,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion, garlic, beef, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb lean ground beef\n4 tsp chili powder\n2 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
          },
          {
            "id": 302836,
            "primary_message": "Meanwhile, grate cheddar and set aside.",
            "secondary_message": "½ (8 oz) block cheddar cheese"
          },
          {
            "id": 302837,
            "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
            "secondary_message": null
          },
          {
            "id": 302838,
            "primary_message": "When the beef is done, add veggie noodles, bell pepper, and water to the skillet; continue to cook, stirring occasionally, until the liquid has evaporated and veggies are tender, 3-4 minutes more.",
            "secondary_message": "½ cup water"
          },
          {
            "id": 302839,
            "primary_message": "Meanwhile, medium dice tomatoes.",
            "secondary_message": null
          },
          {
            "id": 302840,
            "primary_message": "When the veggies are tender, add tomato and tomato sauce to the skillet; stir to combine and bring to a simmer. Once simmering, remove from heat and sprinkle with cheddar.",
            "secondary_message": "2 (8 oz) cans tomato sauce"
          },
          {
            "id": 302841,
            "primary_message": "Place skillet in the oven and broil until cheese is melted and golden, 2-3 minutes.",
            "secondary_message": null
          },
          {
            "id": 302842,
            "primary_message": "To serve, divide skillet between plates or bowls and top with a dollop of yogurt. Enjoy!",
            "secondary_message": "¼ cup plain Greek yogurt"
          }
        ],
