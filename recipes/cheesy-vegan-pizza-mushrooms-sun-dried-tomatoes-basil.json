        "instructions": [
          {
            "id": 142194,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 142195,
            "primary_message": "Peel and mince garlic; transfer to a small bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 142196,
            "primary_message": "Add tomato sauce and spices to the bowl with the garlic; whisk to combine and set aside.",
            "secondary_message": "1 (8 oz) can tomato sauce\n½ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 142197,
            "primary_message": "Divide flatbreads between 2 baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 10-12 minutes. Remove from the oven.",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 142198,
            "primary_message": "Meanwhile, wash, dry, and slice the mushrooms.",
            "secondary_message": "½ lb white mushrooms"
          },
          {
            "id": 142199,
            "primary_message": "Thinly slice sun-dried tomatoes.",
            "secondary_message": "16 sun-dried tomatoes, oil-packed"
          },
          {
            "id": 142200,
            "primary_message": "In a small saucepan, combine almond milk, oil, nutritional yeast, arrowroot starch, Dijon, onion powder, and garlic powder; whisk until smooth. Place the saucepan over medium heat and cook, whisking constantly, until the sauce becomes thick and stretchy, 2-4 minutes. Remove from the heat.",
            "secondary_message": "4 fl oz (½ cup) almond milk, unsweetened\n4 tsp extra virgin olive oil\n¼ cup nutritional yeast flakes\n2 tsp arrowroot starch/powder\n2 tsp Dijon mustard\n⅛ tsp onion powder\n⅛ tsp garlic powder"
          },
          {
            "id": 142201,
            "primary_message": "Spread tomato sauce over each flatbread. Spoon the cheesy sauce over the tomato sauce, then top with mushrooms, sun-dried tomatoes, and Italian seasoning.",
            "secondary_message": "½ tsp Italian seasoning"
          },
          {
            "id": 142202,
            "primary_message": "Place prepared flatbreads back in the oven and bake, rotating the sheet pans halfway through, until mushrooms have softened, 6-8 minutes. Remove from the oven.",
            "secondary_message": null
          },
          {
            "id": 142203,
            "primary_message": "Meanwhile, wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": "1 small pkg fresh basil"
          },
          {
            "id": 142204,
            "primary_message": "To serve, slice flatbread pizzas into wedges and divide between plates. Garnish with basil and enjoy!",
            "secondary_message": null
          }
        ],
