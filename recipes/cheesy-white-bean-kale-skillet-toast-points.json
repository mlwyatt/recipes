        "instructions": [
          {
            "id": 156047,
            "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 156048,
            "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
            "secondary_message": "4 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 156049,
            "primary_message": "Wash and dry kale. Fold leaves in half lengthwise, slice off stems, and finely chop leaves. ",
            "secondary_message": "1 bunch kale"
          },
          {
            "id": 156050,
            "primary_message": "Peel and thinly slice garlic.",
            "secondary_message": "6 cloves garlic"
          },
          {
            "id": 156051,
            "primary_message": "Preheat a large ovenproof skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 156052,
            "primary_message": "Grate cheese and set aside.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 156053,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and tomato paste; stir to combine.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tbsp tomato paste"
          },
          {
            "id": 156054,
            "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful; cook, stirring often, until kale softens, 4-5 minutes.",
            "secondary_message": null
          },
          {
            "id": 156055,
            "primary_message": "Add beans, hot water (from the tap), and spices to the skillet; stir to combine. Bring to a boil, then sprinkle with cheese and place in the oven; broil until cheese has melted and is browned in spots, about 4 minutes. Remove from the oven.",
            "secondary_message": "1 cup water\n1 tsp salt\n½ tsp black pepper\n½ tsp Italian seasoning\n½ tsp onion powder"
          },
          {
            "id": 156056,
            "primary_message": "Meanwhile, cut bread slices on the diagonal and place on a baking sheet pan in a single layer; drizzle with oil on both sides. ",
            "secondary_message": "4 slices whole grain bread\n2 tsp extra virgin olive oil"
          },
          {
            "id": 156057,
            "primary_message": "Place bread in the oven and broil, flipping halfway through, until nicely toasted, 2-3 minutes. Remove from the oven. ",
            "secondary_message": null
          },
          {
            "id": 156058,
            "primary_message": "Divide white bean mixture between plates or bowls. Serve with toast for dipping. Enjoy!",
            "secondary_message": null
          }
        ],
