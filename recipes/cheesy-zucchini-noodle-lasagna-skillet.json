  "instructions": [
    {
      "id": 298335,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 298336,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium zucchini squash\n1 small pkg fresh basil\n1 small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 298337,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 298338,
      "primary_message": "Peel and mince or press garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 298339,
      "primary_message": "Coat bottom of skillet with oil. Add ground beef and garlic. Break apart the beef with a spoon until crumbly. Stirring occasionally, cook until beef is browned, 4-6 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\n1 ½ lb lean ground beef"
    },
    {
      "id": 298340,
      "primary_message": "Add the tomato paste and cook until fragrant, 1-2 minutes. ",
      "secondary_message": "2 tbsp tomato paste"
    },
    {
      "id": 298341,
      "primary_message": "Add the tomatoes and broth. Increase the heat to high and bring to a rapid simmer.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 298342,
      "primary_message": "Shave leaves off the parsley stems; discard the stems and mince the leaves. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Put some of the fresh herbs aside to use as garnish. ",
      "secondary_message": null
    },
    {
      "id": 298343,
      "primary_message": "Add the parsley, basil, spinach, salt, and pepper to the skillet. Continue to cook for another 4-5 minutes. ",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 298344,
      "primary_message": "Trim ends of the zucchini. Using a vegetable peeler, peel zucchini into thick noodle-like strips. ",
      "secondary_message": null
    },
    {
      "id": 298345,
      "primary_message": "Remove the tomato sauce from the skillet, and set aside in a bowl. Arrange the half of the zucchini in a flat layer that covers the bottom of the skillet. Pour half of the tomato mixture over top of the zucchini noodles. Then arrange a second layer of zucchini noodles, followed by a second layer of sauce. ",
      "secondary_message": null
    },
    {
      "id": 298346,
      "primary_message": "Thinly slice the mozzarella cheese. Finely grate the Parmesan cheese.  ",
      "secondary_message": "½ (8 oz) block mozzarella cheese\n4 oz Parmesan cheese"
    },
    {
      "id": 298347,
      "primary_message": "Cover the top layer of sauce with mozzarella slices and sprinkle with Parmesan, place in the oven for 10-12 minutes. Put the oven to broil for the last few minutes to brown the top if desired. ",
      "secondary_message": null
    },
    {
      "id": 298348,
      "primary_message": "Divide between plates, garnish with remaining fresh herbs, and enjoy!",
      "secondary_message": null
    }
  ],
