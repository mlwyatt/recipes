        "instructions": [
          {
            "id": 162036,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n2 cup water"
          },
          {
            "id": 162037,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 162038,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n4 green bell peppers\n1 small bunch green onions (scallions)"
          },
          {
            "id": 162039,
            "primary_message": "Peel and mince ginger. Peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 162040,
            "primary_message": "Place soy sauce, oil, cornstarch, vinegar, and sugar in a small bowl; whisk to combine the sauce.",
            "secondary_message": "½ cup soy sauce\n2 tbsp toasted sesame oil\n4 tsp cornstarch\n1 tbsp rice vinegar\n1 tbsp brown sugar"
          },
          {
            "id": 162041,
            "primary_message": "Seed and medium dice bell peppers. ",
            "secondary_message": null
          },
          {
            "id": 162042,
            "primary_message": "Cut chicken thighs into ½-inch pieces.",
            "secondary_message": "2 lb chicken thighs, boneless skinless"
          },
          {
            "id": 162043,
            "primary_message": "Heat a large skillet over high heat.",
            "secondary_message": null
          },
          {
            "id": 162044,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tsp toasted sesame oil"
          },
          {
            "id": 162045,
            "primary_message": "Add chicken and stir-fry for 3-4 minutes. Add ginger, garlic, and bell peppers; continue to cook, stirring often, until veggies begin to soften, 3-4 more minutes.",
            "secondary_message": null
          },
          {
            "id": 162046,
            "primary_message": "Pour sauce into the skillet. Reduce heat to medium-high and cook, stirring often, until the sauce thickens, 5-6 minutes.",
            "secondary_message": null
          },
          {
            "id": 162047,
            "primary_message": "Meanwhile, trim green onions on a clean cutting board and cut crosswise into ¼-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 162048,
            "primary_message": "Add cashews to the skillet and stir to combine.",
            "secondary_message": "½ cup cashews, roasted unsalted"
          },
          {
            "id": 162049,
            "primary_message": "To serve, divide rice between bowls; top with chicken stir-fry and green onions. Enjoy!",
            "secondary_message": null
          }
        ],
