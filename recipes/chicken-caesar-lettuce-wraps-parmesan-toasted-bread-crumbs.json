  "instructions": [
    {
      "id": 424443,
      "primary_message": "Place mayo, dressing, and spices in a medium bowl. Stir to combine.",
      "secondary_message": "½ cup mayonnaise\n¼ cup Caesar dressing\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 424444,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n2 green bell peppers\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 424445,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 424446,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 424447,
      "primary_message": "Place chicken on the cutting board and, using your hands, remove meat from the skin and bones. Chop chicken into small pieces and add to the bowl.",
      "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 424448,
      "primary_message": "Add Parmesan to the bowl and stir to combine the chicken salad; set aside.",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    },
    {
      "id": 424449,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 424450,
      "primary_message": "Once the skillet is hot, add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Transfer toasted bread crumbs to a small bowl, then add additional garlic powder and salt; stir to combine.",
      "secondary_message": "½ cup panko bread crumbs\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 424451,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with chicken salad, then top with bread crumbs and additional Parmesan. Enjoy!",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    }
  ],
