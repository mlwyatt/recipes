        "instructions": [
          {
            "id": 47857,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n½ tsp salt\n2 cups water"
          },
          {
            "id": 47858,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 Granny Smith apples"
          },
          {
            "id": 47859,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 47860,
            "primary_message": "Preheat a sauté pan over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 47861,
            "primary_message": "While the sauté pan heats up, pat the chicken thighs dry with paper towels and place on a cutting board. Cut into 1-inch pieces and season with salt and pepper.",
            "secondary_message": "2 lb chicken thighs, boneless skinless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 47862,
            "primary_message": "Once the pan is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 47863,
            "primary_message": "Add the chicken to the pan; cook, tossing occasionally, until the pieces are browned but not fully cooked through, 3 to 4 minutes total. Once done, transfer the chicken to a bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 47864,
            "primary_message": "While the chicken cooks, wash and dry the cutting board. Trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 47865,
            "primary_message": "Once the chicken has been transferred, add more coconut oil to the skillet followed by the onion. Cook, stirring frequently, until softened, 3 to 5 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 47866,
            "primary_message": "Quarter the apples lengthwise, then cut out the core and stem from each section; large dice the apples into ¾-inch cubes.",
            "secondary_message": null
          },
          {
            "id": 47867,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 47868,
            "primary_message": "Add the garlic and curry powder to the pan; stir until fragrant, 15 to 30 seconds.",
            "secondary_message": "2 tbsp curry powder"
          },
          {
            "id": 47869,
            "primary_message": "Add the apples to the pan; cook, stirring occasionally, until they begin to soften, 1 to 2 minutes.",
            "secondary_message": null
          },
          {
            "id": 47870,
            "primary_message": "Return the chicken to the pan and pour in the broth; season with salt and pepper. Bring the mixture to a boil, then reduce the heat and simmer until the chicken is cooked through and the apples are tender, 4 to 6 minutes.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 47871,
            "primary_message": "Uncover the rice and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 47872,
            "primary_message": "To serve, divide the rice between bowls and top with the curry. Enjoy!",
            "secondary_message": null
          }
        ],
