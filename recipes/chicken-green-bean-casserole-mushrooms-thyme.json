  "instructions": [
    {
      "id": 19696,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 19697,
      "primary_message": "Fill a large pot halfway with water and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 19698,
      "primary_message": "Wash green beans and trim ends. Add to boiling water. Cook until bright green and tender-crisp, 2-3 minutes. Drain in a colander and rinse under cold water.",
      "secondary_message": "2 lb green beans"
    },
    {
      "id": 19699,
      "primary_message": "Peel and small dice onion. Peel and mince garlic. Wash and slice mushrooms. Transfer everything to a plate.",
      "secondary_message": "1 medium yellow onion\r\n2 cloves garlic\r\n½ lb white mushrooms"
    },
    {
      "id": 19700,
      "primary_message": "Heat a large skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 19701,
      "primary_message": "Cut chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19702,
      "primary_message": "Melt butter in skillet. Add chicken and cook until no longer pink, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 19703,
      "primary_message": "Melt more butter in skillet. Add onion, garlic, and mushrooms. Stirring occasionally, cook until vegetables are tender, 3-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 19704,
      "primary_message": "Grate ½ cup of Parmesan. In a small bowl, mix together bread crumbs and Parmesan. Set aside.",
      "secondary_message": "2 oz Parmesan cheese\r\n½ cup panko bread crumbs"
    },
    {
      "id": 19705,
      "primary_message": "Wash thyme and slide leaves off the stems.",
      "secondary_message": "1 small pkg fresh thyme"
    },
    {
      "id": 19706,
      "primary_message": "Sprinkle flour over top vegetables; stir and cook for about 1 minute. Add thyme, chicken, yogurt, salt, and pepper to skillet. Stir to combine and remove from heat.",
      "secondary_message": "2 tbsp all-purpose flour\n1 cup plain Greek yogurt\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 19707,
      "primary_message": "Transfer mixture to a large baking dish, add green beans, and stir to combine. Sprinkle with parmesan mixture over top.",
      "secondary_message": ""
    },
    {
      "id": 19708,
      "primary_message": "Place in the oven and cook for 10 minutes. Then broil for 1-2 minutes until topping is slightly browned.",
      "secondary_message": ""
    },
    {
      "id": 19709,
      "primary_message": "Serve in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
