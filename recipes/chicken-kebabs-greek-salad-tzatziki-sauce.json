        "instructions": [
          {
            "id": 25174,
            "primary_message": "Peel and mince the garlic.",
            "secondary_message": "4 cloves garlic \r\n"
          },
          {
            "id": 25175,
            "primary_message": "In a small bowl, whisk together the minced garlic, lemon juice, olive oil, vinegar, oregano, salt, and pepper.",
            "secondary_message": "juice of ½ lemon\r\n6 tbsp extra virgin olive oil\r\n2 tbsp red wine vinegar\r\n1 tsp oregano\r\n1 tsp salt\r\n1 tsp black pepper"
          },
          {
            "id": 25176,
            "primary_message": "Cube the chicken and transfer to a medium bowl. Pour half of the dressing over top (save the rest for the salad) and toss to coat.",
            "secondary_message": "1 lb chicken breasts, boneless skinless\r\n"
          },
          {
            "id": 25177,
            "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 25178,
            "primary_message": "Thread the chicken onto 4 skewers. Alternatively, you can cook the chicken pieces directly on the grill/skillet without using skewers.",
            "secondary_message": ""
          },
          {
            "id": 25179,
            "primary_message": "Add the chicken to the grill or skillet and cook, turning occasionally, until cooked through, 8-10 minutes.",
            "secondary_message": ""
          },
          {
            "id": 25180,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 head romaine lettuce\n1 English cucumber\n1 pint grape tomatoes"
          },
          {
            "id": 25181,
            "primary_message": "Finely dice ¼ of the cucumber. Peel and mince the remaining garlic. In a small bowl, prepare the tzatziki sauce by mixing together the cucumber, garlic, lemon juice, yogurt, and salt.",
            "secondary_message": "2 cloves garlic\njuice of ½ lemon\n1 cup plain Greek yogurt\n½ tsp salt\n½ tsp black pepper "
          },
          {
            "id": 25182,
            "primary_message": "Halve the lettuce lengthwise, then chop crosswise into 1 inch strips; transfer to a salad bowl. Quarter the remaining cucumber lengthwise, then cut crosswise into chunks; add to the bowl. Halve the tomatoes; add to the bowl.",
            "secondary_message": ""
          },
          {
            "id": 25183,
            "primary_message": "Add the olives, feta, and reserved dressing to the salad and toss.",
            "secondary_message": "½ cup Kalamata olives, pitted\r\n1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 25184,
            "primary_message": "To serve, place salad on a plate and add a chicken skewer on top. Serve with tzatziki sauce and enjoy!",
            "secondary_message": ""
          }
        ],
