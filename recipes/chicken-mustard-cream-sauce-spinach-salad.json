        "instructions": [
          {
            "id": 23980,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 23981,
            "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 23982,
            "primary_message": "Add butter to skillet and swirl to coat bottom. Add chicken and cook until browned and cooked through, 2-3 minutes per side. Transfer to a plate.",
            "secondary_message": "1 tbsp butter, unsalted\r\n"
          },
          {
            "id": 23983,
            "primary_message": "Peel and mince shallots.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 23984,
            "primary_message": "Once chicken has been transferred, reduce heat to medium. Add more butter and shallots; cook, stirring frequently, until softened, 2-3 minutes.",
            "secondary_message": "1 tbsp butter, unsalted\r\n"
          },
          {
            "id": 23985,
            "primary_message": "Add broth and vinegar; scrape skillet to loosen any browned bits. Cook, stirring occasionally, until the liquid is reduced by about half, 4-5 minutes.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n4 tbsp white wine vinegar"
          },
          {
            "id": 23986,
            "primary_message": "Add Dijon and butter; stir until well combined and continue cooking for 1-2 minutes. Remove from heat and season with salt and freshly ground pepper.",
            "secondary_message": "2 tbsp Dijon mustard\n4 tbsp butter, unsalted\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 23987,
            "primary_message": "Wash and dry spinach.",
            "secondary_message": "2 (5 oz) pkg baby spinach\r\n"
          },
          {
            "id": 23988,
            "primary_message": "To serve, arrange spinach and chicken on a plate; drizzle with mustard sauce and enjoy!",
            "secondary_message": ""
          }
        ],
