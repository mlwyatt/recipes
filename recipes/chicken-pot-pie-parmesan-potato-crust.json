  "instructions": [
    {
      "id": 200071,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 200072,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium red potatoes\n2 medium carrots\n2 sticks celery"
    },
    {
      "id": 200073,
      "primary_message": "Slice potatoes, using a mandoline or knife, into very thin rounds. Coat the bottom of a baking sheet pan with oil. Add potatoes in a single layer, and bake until tender; 15-20 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 200074,
      "primary_message": "Meanwhile, peel, trim, and small dice the carrots. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 200075,
      "primary_message": "Trim and discard ends of the celery; small dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200076,
      "primary_message": "Peel and small dice the onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 200077,
      "primary_message": "Heat a large pot over medium-high heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 200078,
      "primary_message": "Add carrots, celery, onion, and spices to the pot. Cook, stirring occasionally, while you prep the chicken.",
      "secondary_message": "1 tsp thyme\n1 tsp rosemary\n1 tsp sage\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 200079,
      "primary_message": "Cut chicken into bite-sized pieces and add to the pot with the vegetables. Cook, stirring occasionally, until vegetables are tender and chicken is cooked through, 6-9 minutes.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 200080,
      "primary_message": "Add peas, corn, and flour, stirring to coat. Add broth and Worcestershire sauce; bring to a simmer and cook, stirring occasionally, until sauce has thickened, 3-4 minutes.",
      "secondary_message": "½ cup frozen peas\n½ cup frozen corn\n¼ cup all-purpose flour\n12 fl oz (1 ½ cups) chicken or vegetable broth\n2 tsp Worcestershire sauce"
    },
    {
      "id": 200081,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 200082,
      "primary_message": "Carefully pour chicken and vegetable mixture into a baking dish and use tongs to top with the sliced, par-baked, potatoes. Cover potatoes evenly with Parmesan. ",
      "secondary_message": null
    },
    {
      "id": 200083,
      "primary_message": "Place in the oven and bake for 7 minutes, then increase oven temperature to broil on high. Broil for 2-3 minutes or until bubbly and potato topping is golden brown. Remove from oven and let rest 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 200084,
      "primary_message": "To serve, divide pot pie between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
