        "instructions": [
          {
            "id": 310013,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 310014,
            "primary_message": "Wash and dry the fresh produce. ",
            "secondary_message": "2 yellow bell peppers\n2 small bunches asparagus\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
          },
          {
            "id": 310015,
            "primary_message": "Trim, seed, and medium dice bell peppers. Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces. Place both in a medium bowl. ",
            "secondary_message": null
          },
          {
            "id": 310016,
            "primary_message": "Peel, halve, and thinly slice onion; peel and mince garlic. Add both to the bowl with the bell pepper and asparagus; set aside. ",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 310017,
            "primary_message": "Preheat a large ovenproof skillet over medium-high heat. ",
            "secondary_message": null
          },
          {
            "id": 310018,
            "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "2 lb chicken thighs, boneless skinless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 310019,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add chicken and cook until golden, about 2 minutes per side. Once golden, transfer to a clean plate (the chicken will not be cooked all the way through). Reserve skillet with juices for later use.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 310020,
            "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water, then drain. ",
            "secondary_message": "1 cup basmati rice"
          },
          {
            "id": 310021,
            "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add veggies and rice; cook, stirring occasionally, until veggies start to soften, about 2 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 310022,
            "primary_message": "Once the veggies are soft, add broth, tomato sauce, and spices to the skillet; stir to combine and bring to a boil. Once boiling, return chicken (and any accumulated juices) to the skillet and nestle into the veggies and rice; cover the skillet with an ovenproof lid or aluminum foil.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 (8 oz) cans tomato sauce\n4 tsp paprika\n2 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper\n½ tsp coriander, ground\n⅛ tsp cayenne pepper"
          },
          {
            "id": 310023,
            "primary_message": "Place skillet in the oven and bake until rice has fully absorbed liquid and chicken is cooked through, about 15 minutes. Remove from oven. ",
            "secondary_message": null
          },
          {
            "id": 310024,
            "primary_message": "Meanwhile, drain and roughly chop artichoke hearts.",
            "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
          },
          {
            "id": 310025,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 310026,
            "primary_message": "Slice lemon into wedges. ",
            "secondary_message": null
          },
          {
            "id": 310027,
            "primary_message": "When the chicken and rice are done, add artichokes and half of the parsley to the skillet; stir to combine the \"paella.\" (Reserve remaining parsley for garnish.)",
            "secondary_message": null
          },
          {
            "id": 310028,
            "primary_message": "To serve, divide paella between plates or bowls; sprinkle with reserved parsley and squeeze lemon over top. Enjoy!",
            "secondary_message": null
          }
        ],
