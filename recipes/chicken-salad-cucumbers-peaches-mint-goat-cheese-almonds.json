        "instructions": [
          {
            "id": 417134,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 hearts romaine hearts\n1 English cucumber\n2 peaches\n1 small pkg fresh mint"
          },
          {
            "id": 417135,
            "primary_message": "Chop or tear lettuce into bite-sized pieces. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 417136,
            "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the lettuce.",
            "secondary_message": null
          },
          {
            "id": 417137,
            "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into thin wedges. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 417138,
            "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 417139,
            "primary_message": "Place chicken on the cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and add to the bowl.",
            "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
          },
          {
            "id": 417140,
            "primary_message": "Crumble goat cheese into the bowl. Add almonds, vinaigrette, salt, and pepper, then toss to combine the salad.",
            "secondary_message": "1 (4 oz) log goat cheese\n⅔ cup almonds, sliced\n⅔ cup French vinaigrette\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 417141,
            "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
