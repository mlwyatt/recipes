  "instructions": [
    {
      "id": 9697,
      "primary_message": "Peel and mince ginger. In a large bowl, whisk together ginger, peanut butter, water, vinegar, soy sauce, honey, lime juice, turmeric, and crushed red pepper. Transfer ½ of mixture to a medium bowl (to use as sauce) and set aside.",
      "secondary_message": "2 (1 inch) pieces ginger\r\n6 tbsp natural peanut butter\r\n4 tbsp warm water\r\n4 tbsp rice vinegar\r\n3 tbsp soy sauce\r\n1 tbsp honey\r\n1 lime\r\n2 tsp turmeric\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 9698,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Add ½ (save the rest for the salad) to the large bowl.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 9699,
      "primary_message": "Cut chicken into bite-sized pieces. Add to large bowl and toss to coat.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 9700,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 9701,
      "primary_message": "Thread chicken onto 12 skewers and place on a plate. Alternatively, you can cook the chicken pieces directly on the grill/skillet without using skewers.",
      "secondary_message": ""
    },
    {
      "id": 9702,
      "primary_message": "Coat grill or bottom of skillet with oil. Add skewers and cook until chicken is cooked through but still juicy, 3-4 minutes per side.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 9703,
      "primary_message": "In a large bowl, prepare salad dressing by whisking together remaining cilantro, lime juice, vinegar, soy sauce, honey, and crushed red pepper.",
      "secondary_message": "1 lime\r\n4 tbsp rice vinegar\r\n2 tbsp soy sauce\r\n2 tbsp honey\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 9704,
      "primary_message": "Peel and thinly slice onion. Wash, trim ends, halve lengthwise, and thinly slice cucumbers into half rounds. Add everything to bowl with dressing and toss.",
      "secondary_message": "1 medium red onion\r\n4 English cucumbers"
    },
    {
      "id": 9705,
      "primary_message": "To serve, place chicken skewers on a plate, add salad, and have with peanut sauce on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
