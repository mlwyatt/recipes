        "instructions": [
          {
            "id": 465752,
            "primary_message": "Place mayo, ketchup, Dijon, and cayenne in a small bowl. Stir to combine the special sauce and set aside.",
            "secondary_message": "¼ cup mayonnaise\n4 tsp ketchup\n2 tsp Dijon mustard\n⅛ tsp cayenne pepper"
          },
          {
            "id": 465753,
            "primary_message": "Place vinegar, oil, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
            "secondary_message": "2 tbsp red wine vinegar\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 465754,
            "primary_message": "Peel and slice shallots crosswise into thin rounds. Add to the bowl with the dressing, stir to combine, and set aside.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 465755,
            "primary_message": "Place chicken in another medium bowl along with oil, Worcestershire, and spices. Mix with your hands until well combined.",
            "secondary_message": "1 lb ground chicken\n2 tsp extra virgin olive oil\n2 tsp Worcestershire sauce\n2 tsp garlic powder\n1 tsp paprika\n½ tsp oregano, dried\n½ tsp chili powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 465756,
            "primary_message": "Arrange tortillas on a flat surface, then divide the chicken mixture between them (about 1 ½ tablespoons per tortilla). Using your hands, spread the chicken mixture over the surface of each tortilla in an even layer.",
            "secondary_message": "12 small corn tortillas"
          },
          {
            "id": 465757,
            "primary_message": "Preheat two large skillets over medium-high heat. ",
            "secondary_message": null
          },
          {
            "id": 465758,
            "primary_message": "While the skillets heat up, coarsely grate cheese.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 465759,
            "primary_message": "Once the skillets are hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tacos, meat-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the chicken is cooked through, about 2 minutes. ",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 465760,
            "primary_message": "Flip tacos, chicken-side up, and sprinkle with cheese. Continue to cook until cheese has melted, 1 minute more. Transfer to a large plate.",
            "secondary_message": null
          },
          {
            "id": 465761,
            "primary_message": "Meanwhile, wash, dry, and medium dice tomatoes. Add to the bowl with the dressing.",
            "secondary_message": "4 tomatoes"
          },
          {
            "id": 465762,
            "primary_message": "Wash, dry, and halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl and toss to combine the salad.",
            "secondary_message": "1 head romaine lettuce"
          },
          {
            "id": 465763,
            "primary_message": "Divide tacos between plates. Top each with a small handful of salad and drizzle with special sauce. Serve with remaining salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
