  "instructions": [
    {
      "id": 312278,
      "primary_message": "Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 312279,
      "primary_message": "Place chicken, salt, and pepper in a medium saucepan and cover with water by 1-inch; bring to a boil. Once boiling, reduce heat to low and simmer until chicken is cooked through, 8-10 minutes; transfer chicken to a plate to cool.",
      "secondary_message": "1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 312280,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 312281,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 red bell peppers\n2 medium carrots\n1 English cucumber\n1 small bunch cilantro"
    },
    {
      "id": 312282,
      "primary_message": "Once the water in the pot is boiling, add noodles and edamame; cook noodles according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water; set aside.",
      "secondary_message": "10 oz soba (buckwheat) noodles\n1 cup edamame, shelled"
    },
    {
      "id": 312283,
      "primary_message": "While the noodles and edamame cook, using a clean cutting board, peel and mince ginger and garlic. Place both in a large bowl along with soy sauce, vinegar, oil, peanut butter, and honey; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n¼ cup soy sauce\n2 tbsp rice vinegar\n2 tbsp toasted sesame oil\n2 tsp natural peanut butter\n2 tsp honey"
    },
    {
      "id": 312284,
      "primary_message": "Trim, seed, and thinly slice bell peppers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 312285,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 312286,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 312287,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 312288,
      "primary_message": "Once the chicken is cool, shred using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat. Add to the bowl along with noodles and edamame.",
      "secondary_message": null
    },
    {
      "id": 312289,
      "primary_message": "Roughly chop peanuts and add to the bowl; toss to combine the noodle salad.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 312290,
      "primary_message": "To serve, divide noodle salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
