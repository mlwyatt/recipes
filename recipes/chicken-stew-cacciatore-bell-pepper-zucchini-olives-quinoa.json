  "instructions": [
    {
      "id": 282882,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 282883,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 medium zucchini squash\n1 small pkg fresh basil"
    },
    {
      "id": 282884,
      "primary_message": "Peel, halve, and thinly slice onion; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 282885,
      "primary_message": "Trim, seed, and medium dice bell peppers; trim and quarter zucchini lengthwise, then cut crosswise into ¼-inch thick pieces. Add both to the bowl with the onion and garlic; set aside. ",
      "secondary_message": null
    },
    {
      "id": 282886,
      "primary_message": "Cut the chicken into bite-sized pieces. Sprinkle with cornstarch and season with spices on both sides. ",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n2 tbsp cornstarch\n2 tsp Italian seasoning\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 282887,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 282888,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until golden, 3-4 minutes. (The chicken will not be cooked all the way through.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 282889,
      "primary_message": "Add veggies and spices to the pot with the chicken; continue to cook, stirring occasionally, until veggies soften, 3-4 minutes.",
      "secondary_message": "2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 282890,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop olives. ",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 282891,
      "primary_message": "When the veggies are done, add tomatoes, broth, and olives to the pot; stir to combine and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until stew has thickened and chicken is cooked through, 6-8 minutes more. ",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 282892,
      "primary_message": "While the stew is simmering, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 282893,
      "primary_message": "When the stew is done, add half of the basil to the pot; stir to combine and remove from heat. (Reserve remaining basil for garnish.)",
      "secondary_message": null
    },
    {
      "id": 282894,
      "primary_message": "To serve, divide quinoa and chicken stew between bowls; top with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
