        "instructions": [
          {
            "id": 29144,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 (16 oz) pkg strawberries\n2 avocados\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 29145,
            "primary_message": "Trim and discard the stem ends of the strawberries; cut the strawberries into quarters lengthwise and transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 29146,
            "primary_message": "Halve and pit the avocados, then scoop out the flesh and cut crosswise into slices; transfer to the plate with the strawberries.",
            "secondary_message": null
          },
          {
            "id": 29147,
            "primary_message": "Measure out the almonds into a small bowl.",
            "secondary_message": "¼ cup almonds, sliced"
          },
          {
            "id": 29148,
            "primary_message": "Preheat a grill pan or skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 29149,
            "primary_message": "Place the chicken on a cutting board and holding a knife parallel to the board, cut the chicken in half horizontally to form thin fillets. Season with salt and pepper, then rub with olive oil.",
            "secondary_message": "1 lb chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper\n2 tsp extra virgin olive oil"
          },
          {
            "id": 29150,
            "primary_message": "Place the chicken in the grill pan or skillet; cook until golden brown and cooked through, 3 to 4 minute per side. Once done, transfer to a cutting board.",
            "secondary_message": null
          },
          {
            "id": 29151,
            "primary_message": "While the chicken cooks, in a small bowl, combine olive oil, balsamic vinegar, Dijon, salt, and pepper and whisk together.",
            "secondary_message": "6 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n½ tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 29152,
            "primary_message": "Slice the chicken crosswise into bite-sized strips.",
            "secondary_message": null
          },
          {
            "id": 29153,
            "primary_message": "To serve, arrange a bed of the spinach on a plate and top with the avocado, strawberries, and chicken. Sprinkle with almonds and drizzle with the dressing just before serving. Enjoy!",
            "secondary_message": null
          }
        ],
