        "instructions": [
          {
            "id": 445342,
            "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 445343,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "8 caps portobello mushrooms\n6 sticks celery\n2 Granny Smith apples"
          },
          {
            "id": 445344,
            "primary_message": "Remove stems from portobello mushrooms and carefully scrape out the gills. Transfer to a baking sheet pan, rub with oil, then season with salt and pepper on both sides; arrange cap-side up.",
            "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 445345,
            "primary_message": "Place mushrooms in the oven and broil until starting to soften, about 6 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 445346,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 445347,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 lb ground chicken\n½ tsp thyme, dried\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 445348,
            "primary_message": "While the chicken is cooking, place additional oil, vinegar, Dijon, salt, and pepper in a medium bowl. Whisk to combine the dressing and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 445349,
            "primary_message": "Using tongs, carefully flip the mushrooms, cap-side down. Fill with chicken mixture and top with blue cheese.",
            "secondary_message": "2 (4 oz) pkgs crumbled blue cheese"
          },
          {
            "id": 445350,
            "primary_message": "Return baking sheet to the oven and continue to broil until the mushrooms are soft and cheese is melted, 4-5 minutes more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 445351,
            "primary_message": "Meanwhile, trim and thinly slice celery crosswise. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 445352,
            "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 445353,
            "primary_message": "Roughly chop pecans, add to the bowl, and stir to combine the salad.",
            "secondary_message": "¼ cup pecan halves"
          },
          {
            "id": 445354,
            "primary_message": "To serve, divide stuffed mushrooms and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
