  "instructions": [
    {
      "id": 349100,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349101,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 349102,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 349103,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n2 mangoes\n1 red bell pepper\n1 small bunch cilantro\n1 lime\n½ head butter (Boston) lettuce"
    },
    {
      "id": 349104,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and place in a medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 349105,
      "primary_message": "Peel and mince shallot and garlic; add both to the bowl with the jalapeño.",
      "secondary_message": "1 shallot\n4 cloves garlic"
    },
    {
      "id": 349106,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; small dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349107,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349108,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349109,
      "primary_message": "Juice lime into the bowl; add salt and stir to combine the mango salsa. Set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 349110,
      "primary_message": "Remove lettuce leaves from head, then chop crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 349111,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 349112,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 349113,
      "primary_message": "To serve, divide tortillas between plates; fill with chicken, lettuce, and mango salsa. Enjoy!",
      "secondary_message": null
    }
  ],
