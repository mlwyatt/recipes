        "instructions": [
          {
            "id": 195748,
            "primary_message": "Preheat the oven to 425°F and position rack in the center and bottom of the oven. Line two baking sheets with parchment paper.",
            "secondary_message": null
          },
          {
            "id": 195749,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 crowns broccoli\n⅔ lb sweet potato\n½ small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 195750,
            "primary_message": "Cut the sweet potatoes in half lengthwise, then cut each half into ½-inch planks, then into sticks. Add to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 195751,
            "primary_message": "Drizzle sweet potatoes with oil and season with garlic powder, salt, and pepper and toss until evenly coated. Spread out in an even layer on one of the prepared baking sheets and place in the oven, cook for 10 minutes. Set the bowl aside for the broccoli.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 195752,
            "primary_message": "Separate broccoli into bite-sized florets and cut stems into strips. Add to the bowl used for the sweet potatoes and toss with oil and spices. Set aside.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 195753,
            "primary_message": "Meanwhile, measure out the cornstarch in a medium bowl for dredging.",
            "secondary_message": "½ cup cornstarch"
          },
          {
            "id": 195754,
            "primary_message": "In another medium bowl, whisk the egg.",
            "secondary_message": "2 eggs"
          },
          {
            "id": 195755,
            "primary_message": "In a third medium bowl, mix together the almond meal, garlic powder, paprika, salt, and cayenne pepper. Stir to combine.",
            "secondary_message": "1 ½ cup almond meal/flour\n1 tsp garlic powder\n1 tsp paprika\n2 tsp salt\n½ tsp cayenne pepper"
          },
          {
            "id": 195756,
            "primary_message": "Cut the chicken into 1-inch thick strips.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 195757,
            "primary_message": "First, dredge the strips in cornstarch, shaking off any excess. Then, dip the chicken strips into the egg. Finally, dredge in almond meal mixture, pressing gently to adhere. Shake off excess and place on another prepared baking sheet. Place in the oven for 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 195758,
            "primary_message": "Meanwhile, in small bowl prepare the dip by whisking together Dijon, maple syrup, salt, and cayenne. Set aside.",
            "secondary_message": "2 tbsp Dijon mustard\n3 tbsp pure maple syrup\n¼ tsp salt\n¼ tsp cayenne pepper"
          },
          {
            "id": 195759,
            "primary_message": "When the potatoes have baked for 10 minutes, remove from oven and spread broccoli evenly over top. Return to oven and bake for another 15 minutes, until potatoes are fork tender.",
            "secondary_message": null
          },
          {
            "id": 195760,
            "primary_message": "Once the chicken has cooked for 10 minutes remove from oven and flip. Return to oven and bake an additional 8-10 minutes.",
            "secondary_message": null
          },
          {
            "id": 195761,
            "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle; discard the stems and finely chop the leaves.",
            "secondary_message": null
          },
          {
            "id": 195762,
            "primary_message": "To serve, arrange chicken tenders, wedges and broccoli on a plate. Garnish with parsley and serve with the maple mustard dip. Enjoy!",
            "secondary_message": null
          }
        ],
