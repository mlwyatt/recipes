        "instructions": [
          {
            "id": 20246,
            "primary_message": "Peel and medium dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\r\n2 cloves garlic"
          },
          {
            "id": 20247,
            "primary_message": "Wash turnips and mushrooms. Peel and medium dice turnips. Slice mushrooms.",
            "secondary_message": "2 medium turnips\r\n½ lb cremini mushrooms"
          },
          {
            "id": 20248,
            "primary_message": "Heat a large pot over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 20249,
            "primary_message": "Medium dice chicken. Season with salt and pepper.",
            "secondary_message": "2 lb chicken thighs, boneless skinless\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 20250,
            "primary_message": "Coat bottom of pot with oil. Add chicken and cook until lightly browned, 2-3 minutes. Transfer to a plate.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 20251,
            "primary_message": "Add more oil to pot, then add onion, garlic, turnip, and mushrooms. Cook, stirring frequently, until onion is softened, 4-5 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 20252,
            "primary_message": "Preheat the broiler and position rack about 6 inches from the top.",
            "secondary_message": ""
          },
          {
            "id": 20253,
            "primary_message": "Wash rosemary and slide leaves off the stems.",
            "secondary_message": "1 small pkg fresh rosemary"
          },
          {
            "id": 20254,
            "primary_message": "Wash and dry spinach.",
            "secondary_message": "1 (5 oz) pkg baby spinach"
          },
          {
            "id": 20255,
            "primary_message": "Add chicken, rosemary, spinach, and broth to pot. Season with salt and pepper. Stir to combine and bring to a boil. Reduce heat to a simmer, cover, and cook until turnips are tender, about 10 minutes.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 20256,
            "primary_message": "Peel and mince remaining garlic. In a small bowl, mix together garlic, olive oil, salt, and pepper.",
            "secondary_message": "2 cloves garlic\r\n2 tbsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
          },
          {
            "id": 20257,
            "primary_message": "Place halves of bun or roll cut side up on a baking sheet pan. Spread the oil mixture over top. Place in the oven and broil until bread in golden brown, 2-3 minutes.",
            "secondary_message": "2 whole grain buns or rolls"
          },
          {
            "id": 20258,
            "primary_message": "Pour stew into a bowl and enjoy with garlic bread!",
            "secondary_message": ""
          }
        ],
