        "instructions": [
          {
            "id": 419646,
            "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Place in a medium bowl.",
            "secondary_message": "2 green bell peppers"
          },
          {
            "id": 419647,
            "primary_message": "Peel, halve, and small dice onions. Add to the bowl with the bell pepper along with the carrots.",
            "secondary_message": "2 medium yellow onions\n1 (10 oz) bag shredded carrots"
          },
          {
            "id": 419648,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 419649,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 7-8 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp garlic powder\n½ tsp dill, dried"
          },
          {
            "id": 419650,
            "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 419651,
            "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces.",
            "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
          },
          {
            "id": 419652,
            "primary_message": "Add beans, chicken, and broth to the pot; stir to combine the stew and bring to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until veggies and beans are soft, about 10 minutes. Remove from heat.",
            "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
          },
          {
            "id": 419653,
            "primary_message": "To serve, divide stew between bowls and top with cheese. Enjoy!",
            "secondary_message": "1 cup shredded cheese, Mexican blend"
          }
        ],
