        "instructions": [
          {
            "id": 363401,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "1 small pineapple\n1 small bunch cilantro\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 363402,
            "primary_message": "Cut off skin from pineapple; quarter, core, and small dice the flesh. Place half in a small saucepan. (Place the remaining pineapple in a medium bowl and set aside for later use.)",
            "secondary_message": null
          },
          {
            "id": 363403,
            "primary_message": "Small dice apricots and add to the pan with the pineapple.",
            "secondary_message": "8 dried apricots"
          },
          {
            "id": 363404,
            "primary_message": "Add water, vinegar, sugar, and spices to the pan. Stir to combine the chutney and bring to a simmer over medium-high heat. Once simmering, reduce heat to low and cook, stirring occasionally, until thickened, 8-10 minutes. Remove from heat.",
            "secondary_message": "¼ cup water\n¼ cup apple cider vinegar\n2 tsp brown sugar\n1 tsp curry powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 363405,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 363406,
            "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 363407,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until cooked through, 3-4 minutes per side. Remove from heat.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 363408,
            "primary_message": "While the chicken is cooking, add oil, vinegar, maple syrup, salt, and pepper to the bowl with the pineapple. Stir to combine the salad dressing.",
            "secondary_message": "4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 363409,
            "primary_message": "Using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing, along with the mixed greens, and toss to combine the salad. Set aside.",
            "secondary_message": null
          },
          {
            "id": 363410,
            "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
            "secondary_message": null
          },
          {
            "id": 363411,
            "primary_message": "Thinly slice chicken into strips.",
            "secondary_message": null
          },
          {
            "id": 363412,
            "primary_message": "Place tortillas on a flat surface; spread each with a layer of mayo and chutney. Top with chicken and a small portion of salad. Roll tightly to close. (Reserve remaining salad for serving.)",
            "secondary_message": "4 large flour tortillas\n2 tbsp mayonnaise"
          },
          {
            "id": 363413,
            "primary_message": "Cut wraps in half and divide between plates. Serve with remaining salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
