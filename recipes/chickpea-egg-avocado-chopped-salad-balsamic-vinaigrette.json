        "instructions": [
          {
            "id": 33481,
            "primary_message": "Place the eggs in a small saucepan and cover with cold water by about 1 inch. Cover with a lid and bring to a rolling boil over high heat.",
            "secondary_message": "4 eggs"
          },
          {
            "id": 33482,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 pint grape tomatoes\n1 English cucumber\n2 avocados\n1 head romaine lettuce"
          },
          {
            "id": 33483,
            "primary_message": "Trim off and discard the root end of the lettuce and remove any blemished leaves; quarter the head lengthwise, then chop crosswise into 1-inch pieces and transfer to a large salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33484,
            "primary_message": "Trim off and discard the ends of the cucumber; large dice the cucumber (cut into ¾-inch cubes) and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33485,
            "primary_message": "Halve the grape tomatoes and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33486,
            "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and large dice the flesh. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33487,
            "primary_message": "Once the water is boiling, remove the pan from the heat and let the eggs sit, covered, for 6 minutes.",
            "secondary_message": null
          },
          {
            "id": 33488,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; medium dice the onion (cut into ½-inch pieces) and add to the salad bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 33489,
            "primary_message": "Drain and rinse the chickpeas, then place on a clean towel or paper towels and pat dry; add to the salad bowl.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 33490,
            "primary_message": "Once the eggs are done, place them in a bowl of cold water to stop the cooking process and set aside for 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 33491,
            "primary_message": "In a small bowl, combine and whisk together olive oil, balsamic vinegar, Dijon mustard, salt, and pepper.",
            "secondary_message": "6 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 33492,
            "primary_message": "Peel and roughly chop the eggs; add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33493,
            "primary_message": "To serve, spoon the salad onto a plate or into a bowl and drizzle with the dressing. Enjoy!",
            "secondary_message": null
          }
        ],
