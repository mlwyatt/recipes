  "instructions": [
    {
      "id": 13387,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 13388,
      "primary_message": "Cut bread into cubes.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 13389,
      "primary_message": "Coat bottom of skillet with oil. Add bread cubes, season with salt and pepper, and toss to coat. Stirring occasionally, cook until golden brown, 4-5 minutes.",
      "secondary_message": "about 4 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 13390,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by whisking together garlic, oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\n6 tbsp extra virgin olive oil\r\n2 tbsp red wine vinegar\r\n½ tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 13391,
      "primary_message": "Drain and rinse chickpeas; place on paper towels and pat dry. Add to bowl with dressing and toss to coat.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 13392,
      "primary_message": "Wash and dry cucumber, tomatoes, bell peppers, and basil. Medium dice the cucumber and tomatoes. Seed and medium dice the peppers. Pick the basil leaves off the stems and thinly slice into ribbons. Peel and medium dice onion. Add to bowl.",
      "secondary_message": "1 English cucumber\n4 tomatoes\n2 yellow bell peppers\n1 small pkg fresh basil\n1 medium red onion"
    },
    {
      "id": 13393,
      "primary_message": "Add bread and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 13394,
      "primary_message": "To serve, place salad in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
