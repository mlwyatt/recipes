  "instructions": [
    {
      "id": 114176,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 114177,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 green bell peppers\n2 avocados\n1 lime"
    },
    {
      "id": 114178,
      "primary_message": "Seed and small dice the bell peppers; set aside.",
      "secondary_message": null
    },
    {
      "id": 114179,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 114180,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 114181,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 114182,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 114183,
      "primary_message": "Add the bell peppers, onion, garlic, and chickpeas. Cook until the chickpeas are slightly golden, stirring occasionally, about 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 114184,
      "primary_message": "Add soy sauce, chili powder, and paprika to the chickpeas and sauté for 5-7 more minutes, until golden brown.",
      "secondary_message": "¼ cup soy sauce\n1 tsp chili powder\n½ tsp paprika"
    },
    {
      "id": 114185,
      "primary_message": "Add the avocados, water, and salt to a blender. Juice the lime into the blender. Purée until smooth.",
      "secondary_message": "¼ cup water\n¼ tsp salt"
    },
    {
      "id": 114186,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15-30 seconds.",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 114187,
      "primary_message": "To assemble, add the chickpea vegetable mixture to each tortilla. Top with a drizzle of the avocado cream. Enjoy!",
      "secondary_message": null
    }
  ],
