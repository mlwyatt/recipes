        "instructions": [
          {
            "id": 401942,
            "primary_message": "Drain and rinse chickpeas; set aside to drain further. ",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 401943,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 401944,
            "primary_message": "While the pot heats up, wash, dry, peel, and mince ginger. ",
            "secondary_message": "2 (1 inch) pieces ginger root"
          },
          {
            "id": 401945,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger and spices; cook, stirring constantly, until fragrant, about 1 minute.",
            "secondary_message": "2 tsp virgin coconut oil\n4 tsp curry powder\n2 tsp garam masala\n1 tsp garlic powder\n1 tsp salt"
          },
          {
            "id": 401946,
            "primary_message": "Add chickpeas, tomatoes, and water to the pot; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to low and cook until chickpeas start to soften, about 5 minutes. ",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n1 cup water"
          },
          {
            "id": 401947,
            "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Reduce heat to low and continue to cook, stirring occasionally, until chickpeas and kale are tender, 5 minutes more. Remove from heat.",
            "secondary_message": "1 (10 oz) bag kale, cut and ready to use"
          },
          {
            "id": 401948,
            "primary_message": "Meanwhile, toast naan if desired, then cut into wedges. ",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 401949,
            "primary_message": "Divide chickpea curry between bowls and top with yogurt. Serve with naan on the side and enjoy! ",
            "secondary_message": "½ cup plain Greek yogurt"
          }
        ],
