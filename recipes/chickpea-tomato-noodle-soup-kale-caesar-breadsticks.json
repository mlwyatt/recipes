  "instructions": [
    {
      "id": 221845,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 221846,
      "primary_message": "Meanwhile, peel and mince onion and garlic. Place half the garlic in a large bowl and set aside for the salad dressing.",
      "secondary_message": "½ medium red onion\n2 cloves garlic"
    },
    {
      "id": 221847,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 221848,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and remaining garlic to the pot; cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 221849,
      "primary_message": "Add broth, tomato sauce, pasta, and spices to the pot; stir to combine. Bring to a simmer, reduce heat to medium, cover, and cook until noodles are just tender, about 8 minutes. ",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n2 (8 oz) cans tomato sauce\n6 oz penne pasta\n½ tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 221850,
      "primary_message": "Meanwhile, cut flatbreads into 1½-inch wide strips, place on a baking sheet pan, and drizzle with oil. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven and set aside.",
      "secondary_message": "2 flatbreads or naan\n4 tsp extra virgin olive oil"
    },
    {
      "id": 221851,
      "primary_message": "While the breadsticks are baking, wash, dry, and juice lemon into the bowl with the garlic. Add mayo, Dijon, soy sauce, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "1 lemon\n2 tbsp mayonnaise\n2 tsp Dijon mustard\n1 tsp soy sauce\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 221852,
      "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the bowl with the dressing; toss to combine the salad and set aside. ",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 221853,
      "primary_message": "Drain and rinse chickpeas. Once the pasta is tender, add chickpeas to the pot and stir to combine. Continue to cook until heated through, 1-2 minutes. ",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 221854,
      "primary_message": "Finely grate cheese. ",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 221855,
      "primary_message": "Ladle soup into bowls and serve with salad and breadsticks on the side. Top soup and salad with cheese and enjoy!",
      "secondary_message": null
    }
  ],
