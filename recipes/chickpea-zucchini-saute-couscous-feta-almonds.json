        "instructions": [
          {
            "id": 31218,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 pint grape tomatoes\n4 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 31219,
            "primary_message": "Trim off and discard the ends of the zucchini; halve the zucchini lengthwise, then cut the halves crosswise into ¼-inch-thick half-rounds at a 45° angle. Transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 31220,
            "primary_message": "Halve the grape tomatoes; transfer to a small bowl.",
            "secondary_message": ""
          },
          {
            "id": 31221,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 31222,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 31223,
            "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; medium dice the onion (cut into ½-inch pieces).",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 31224,
            "primary_message": "Once the skillet is heated, add olive oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 31225,
            "primary_message": "Add the onion to the skillet; cook, stirring occasionally, until it has softened, 3 to 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 31226,
            "primary_message": "While the onion cooks, using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and roughly chop the leaves.",
            "secondary_message": null
          },
          {
            "id": 31227,
            "primary_message": "Add the broth to a small saucepan; bring to a boil over high heat.",
            "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
          },
          {
            "id": 31228,
            "primary_message": "Add the garlic and cumin to the skillet and stir until fragrant, 15 to 30 seconds.",
            "secondary_message": "1 tsp cumin"
          },
          {
            "id": 31229,
            "primary_message": "Add the zucchini and broth to the skillet; season with salt and pepper. Cook, stirring occasionally, until the zucchini is tender, 6 to 8 minutes.",
            "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 31230,
            "primary_message": "Once the liquid in the saucepan comes to a boil, add couscous and salt; give it a stir and cover with a lid. Remove from the heat and let it stand for 5 minutes.",
            "secondary_message": "1 cup whole wheat couscous\n½ tsp salt"
          },
          {
            "id": 31231,
            "primary_message": "Drain and rinse the chickpeas in a colander.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 31232,
            "primary_message": "Measure out the feta into a small bowl.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 31233,
            "primary_message": "Measure out the almonds into a small bowl.",
            "secondary_message": "¼ cup almonds, sliced "
          },
          {
            "id": 31234,
            "primary_message": "Add the chickpeas, tomatoes, and parsley to the zucchini. Stir and cook until the mixture is heated through, 1 to 2 minutes.",
            "secondary_message": null
          },
          {
            "id": 31235,
            "primary_message": "Uncover the couscous and fluff with a fork.",
            "secondary_message": ""
          },
          {
            "id": 31236,
            "primary_message": "To serve, place the couscous into a bowl or on a plate, top with the zucchini and chickpea sauté, and sprinkle with the crumbled feta and almonds. Enjoy!",
            "secondary_message": null
          }
        ],
