  "instructions": [
    {
      "id": 428374,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 428375,
      "primary_message": "Pat chicken dry with paper towels, cut into 1-inch cubes, and season with spices. Thread onto skewers and place on a plate. (If you don't have skewers, you can cook the chicken directly on the grill pan.)",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n4 tsp chili powder\n1 tsp garlic powder\n1 tsp salt"
    },
    {
      "id": 428376,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428377,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add the skewers and cook, turning occasionally, until the chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 428378,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 Granny Smith apples\n2 avocados"
    },
    {
      "id": 428379,
      "primary_message": "Using a clean cutting board, trim and medium dice cucumber. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 428380,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 428381,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl along with shredded cabbage and dressing, then stir to combine the slaw.",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n⅓ cup ranch dressing"
    },
    {
      "id": 428382,
      "primary_message": "To serve, divide skewers and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
