        "instructions": [
          {
            "id": 29741,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb sweet potatoes\n2 Granny Smith apples\n2 jalapeño peppers\n1 lime\n1 small bunch green onions (scallions)"
          },
          {
            "id": 29742,
            "primary_message": "Peel and medium dice the sweet potatoes into ½-inch cubes; transfer to a small saucepan.",
            "secondary_message": null
          },
          {
            "id": 29743,
            "primary_message": "Add water to the saucepan, covering the potatoes, and bring to a boil. Cook until they are tender when pierced with a fork, 14 to 16 minutes.",
            "secondary_message": null
          },
          {
            "id": 29744,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 29745,
            "primary_message": "In a small bowl, combine and mix together chili powder, cumin, salt, and pepper.",
            "secondary_message": "2 tsp chili powder\n1 tsp cumin\n1 tsp salt\n1 tsp black pepper"
          },
          {
            "id": 29746,
            "primary_message": "Pat the pork chops dry with paper towels, then place on a plate; rub both sides with the spice mixture.",
            "secondary_message": "4 pork chops, boneless"
          },
          {
            "id": 29747,
            "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 29748,
            "primary_message": "Place the pork chops in the skillet; cook until browned and cooked through, 3 to 5 minutes per side. Once done, transfer to a plate and let them rest for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 29749,
            "primary_message": "While the pork chops cook, core and small dice the apples into ¼-inch cubes; transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 29750,
            "primary_message": "Quarter the jalapeños lengthwise, then remove and discard the seeds and white membranes; finely dice the peppers and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 29751,
            "primary_message": "Trim and discard the ends of the green onions; chop the onions into ¼-inch pieces. Add ¾ of the onions to the apple and pepper mixture and transfer the rest to a small bowl (for garnishing the sweet potato mash).",
            "secondary_message": ""
          },
          {
            "id": 29752,
            "primary_message": "Once the potatoes are tender, scoop out ½ cup of the water and set aside, then drain the potatoes in a colander and return them back to the saucepan.",
            "secondary_message": null
          },
          {
            "id": 29753,
            "primary_message": "Add the reserved cooking water, coconut oil, salt, and pepper to the potatoes; mash with a potato masher until smooth.",
            "secondary_message": "2 tbsp virgin coconut oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 29754,
            "primary_message": "Juice the lime and add to the bowl with the apple and jalapeño.",
            "secondary_message": null
          },
          {
            "id": 29755,
            "primary_message": "Add olive oil, honey, salt, and pepper to the apple salsa; toss to combine.",
            "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 29756,
            "primary_message": "To serve, place the pork chops and sweet potato mash on a plate. Spoon the salsa overtop the pork and sprinkle the mash with the remaining green onions. Enjoy!",
            "secondary_message": null
          }
        ],
