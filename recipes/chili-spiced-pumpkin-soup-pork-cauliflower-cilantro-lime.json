        "instructions": [
          {
            "id": 346246,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n1 small bunch cilantro\n1 lime"
          },
          {
            "id": 346247,
            "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces; place in a medium bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 346248,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 346249,
            "primary_message": "While the pot heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the bowl with the cauliflower (reserving the rest for serving).",
            "secondary_message": null
          },
          {
            "id": 346250,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add pork and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb lean ground pork\n2 tsp chili powder\n½ tsp salt\n¼ tsp cayenne pepper"
          },
          {
            "id": 346251,
            "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the cauliflower and cilantro.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 346252,
            "primary_message": "When the pork is done, add veggies to the pot and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
            "secondary_message": null
          },
          {
            "id": 346253,
            "primary_message": "Add broth and pumpkin to the pot; stir to combine and bring the soup to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until the cauliflower is soft, about 10 minutes.",
            "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n2 (15 oz) cans pure pumpkin purée"
          },
          {
            "id": 346254,
            "primary_message": "When the soup is done, juice lime into the pot, stir to combine, and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 346255,
            "primary_message": "To serve, divide soup between bowls and sprinkle with reserved cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
