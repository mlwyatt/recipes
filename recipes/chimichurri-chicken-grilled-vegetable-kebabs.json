  "instructions": [
    {
      "id": 107131,
      "primary_message": "If using wooden skewers, place 6-8 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 107132,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 small bunch cilantro\n2 red bell peppers\n2 medium zucchini squash\n½ lb white mushrooms"
    },
    {
      "id": 107133,
      "primary_message": "Shave parsley and cilantro leaves off the stems; discard the stems and mince the leaves; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 107134,
      "primary_message": "Peel and mince garlic and add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 107135,
      "primary_message": "To make the chimichurri sauce, add olive oil, red wine vinegar, and spices to the bowl with the fresh herbs and garlic. Stir to combine. Pour half of the sauce into a small bowl and set aside.",
      "secondary_message": "½ cup extra virgin olive oil\n¼ cup red wine vinegar\n1 tsp oregano\n½ tsp cumin\n¼ tsp crushed red pepper\n1 tsp salt"
    },
    {
      "id": 107136,
      "primary_message": "Cut chicken into 1-inch cubes. Add to the medium bowl with half of the chimichurri sauce and stir to coat.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 107137,
      "primary_message": "Peel and chop onion into 1-inch pieces and add to another medium bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 107138,
      "primary_message": "Seed the peppers and chop into 1-inch pieces. Halve zucchinis lengthwise, then slice crosswise into 1-inch half rounds; halve the mushrooms. Add veggies to the bowl with the onions.",
      "secondary_message": null
    },
    {
      "id": 107139,
      "primary_message": "Add oil, salt, and pepper to the veggies and toss until well coated.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 107140,
      "primary_message": "Thread chicken and veggies onto skewers and place on a plate. Alternatively, you can cook the chicken and veggies directly on the grill/skillet without using skewers.",
      "secondary_message": null
    },
    {
      "id": 107141,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 107142,
      "primary_message": "When hot, coat grill or bottom of grill/skillet with oil; add the kebabs (as many as will fit). Cook until vegetables are tender, and chicken is cooked through, 4-6 minutes per side. Transfer to a plate and loosely cover with foil. Repeat with remaining kebabs.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 107143,
      "primary_message": "To serve, divide kebabs between plates, and top with the remaining chimichurri sauce. Enjoy!",
      "secondary_message": null
    }
  ],
