        "instructions": [
          {
            "id": 9324,
            "primary_message": "Preheat oven to 350°F.",
            "secondary_message": ""
          },
          {
            "id": 9325,
            "primary_message": "Cut tortillas into thin strips and transfer to a sheet pan. Drizzle with oil, season with salt and pepper, and toss to coat. Arrange in a single layer.",
            "secondary_message": "2 large flour tortillas\n2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 9326,
            "primary_message": "Place in the oven and bake until golden and crispy, 10-12 minutes.",
            "secondary_message": ""
          },
          {
            "id": 9327,
            "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 9328,
            "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
            "secondary_message": "1 lb chicken breasts, boneless skinless\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
          },
          {
            "id": 9329,
            "primary_message": "Coat grill or bottom of skillet with oil. Add chicken and cook until golden brown and cooked through, 2-3 minutes per side.",
            "secondary_message": "about 2 tbsp virgin coconut oil"
          },
          {
            "id": 9330,
            "primary_message": "Peel and mince garlic and ginger. In a large bowl, prepare dressing by whisking together garlic, ginger, oil, vinegar, soy sauce, sesame oil, honey, and crushed red pepper.",
            "secondary_message": "2 cloves garlic\r\n2 (1 inch) pieces ginger\r\n4 tbsp extra virgin olive oil\r\n4 tbsp rice vinegar\r\n2 tbsp soy sauce\r\n1 tbsp toasted sesame oil\r\n1 tbsp honey\r\n¼ tsp crushed red pepper"
          },
          {
            "id": 9331,
            "primary_message": "Wash and dry cabbage, carrots, and cilantro. Thinly slice cabbage into shreds. Trim ends, peel, and coarsely grate carrots. Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add everything to bowl with dressing and toss.",
            "secondary_message": "1 medium head napa cabbage\n2 medium carrots\n1 small bunch cilantro"
          },
          {
            "id": 9332,
            "primary_message": "Slice chicken into strips.",
            "secondary_message": ""
          },
          {
            "id": 9333,
            "primary_message": "To serve, place salad on a plate and top with tortilla chips and chicken. Enjoy!",
            "secondary_message": ""
          }
        ],
