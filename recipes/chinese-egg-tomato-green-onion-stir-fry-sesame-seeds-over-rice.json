        "instructions": [
          {
            "id": 443460,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 443461,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 (1 inch) piece ginger root\n8 tomatoes\n1 small bunch green onions (scallions)"
          },
          {
            "id": 443462,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 443463,
            "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a medium bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 443464,
            "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the ginger and garlic, then set aside.",
            "secondary_message": null
          },
          {
            "id": 443465,
            "primary_message": "Crack eggs into another medium bowl. Add salt, then beat with a whisk or fork until smooth. ",
            "secondary_message": "12 eggs\n½ tsp salt"
          },
          {
            "id": 443466,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 443467,
            "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. ",
            "secondary_message": null
          },
          {
            "id": 443468,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onions (reserving a small handful for serving) and cook, stirring frequently, until beginning to soften, about 30 seconds.",
            "secondary_message": "2 tbsp neutral vegetable oil"
          },
          {
            "id": 443469,
            "primary_message": "Add eggs to the skillet and cook, stirring frequently, until just set, about 3 minutes. Remove to a plate. (Reserve skillet for the next step.)",
            "secondary_message": null
          },
          {
            "id": 443470,
            "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add tomatoes and soy sauce; cook, stirring occasionally, until beginning to soften, about 3 minutes.",
            "secondary_message": "2 tbsp neutral vegetable oil\n¼ cup soy sauce"
          },
          {
            "id": 443471,
            "primary_message": "Meanwhile, place water, ketchup, cornstarch, and sugar in a small bowl. Whisk to combine the sauce. ",
            "secondary_message": "¼ cup water\n¼ cup ketchup\n2 tsp cornstarch\n2 tsp brown sugar"
          },
          {
            "id": 443472,
            "primary_message": "Once the tomatoes have softened, reduce heat to medium. Add sauce and continue to cook, stirring frequently, until sauce thickens slightly, 2-3 minutes.",
            "secondary_message": null
          },
          {
            "id": 443473,
            "primary_message": "Return eggs to the skillet, using a spoon to break them up. Continue to cook, stirring occasionally, until warmed through, 1-2 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 443474,
            "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved green onions and sesame seeds. Enjoy!",
            "secondary_message": "4 tsp sesame seeds"
          }
        ],
