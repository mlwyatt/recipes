        "instructions": [
          {
            "id": 483304,
            "primary_message": "Not all protein powders are created equal. If desired, adjust shake consistency by adding more or less liquid per package instructions. This recipe will make about 8 cups of shake. Work in batches to best fit your blender.",
            "secondary_message": null
          },
          {
            "id": 483305,
            "primary_message": "Place milk, water, protein powder, cherries, dates, cocoa powder, vanilla, cinnamon, and salt in a blender. Blend on high speed for several minutes until smooth.",
            "secondary_message": "16 fl oz (2 cups) whole milk\n1 ⅓ cup water\n4 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n1 cup frozen cherries\n½ cup medjool dates, pitted\n¼ cup cocoa powder\n½ tsp vanilla extract\n¼ tsp cinnamon, ground\n⅛ tsp salt"
          },
          {
            "id": 483306,
            "primary_message": "To serve, divide shake between glasses, adding ice if desired. Enjoy!",
            "secondary_message": null
          }
