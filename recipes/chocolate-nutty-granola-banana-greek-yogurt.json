        "instructions": [
          {
            "id": 105446,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 105447,
            "primary_message": "Add oats to a large mixing bowl.",
            "secondary_message": "1 cup oats, quick cooking"
          },
          {
            "id": 105448,
            "primary_message": "Roughly chop nuts and add to the bowl.",
            "secondary_message": "½ cup almonds\n½ cup walnuts"
          },
          {
            "id": 105449,
            "primary_message": "Melt coconut oil in a medium saucepan. Add maple syrup, salt, cocoa powder, and cinnamon; whisk to combine.",
            "secondary_message": "¼ cup virgin coconut oil\n4 tsp pure maple syrup\n½ tsp salt\n4 tsp cocoa powder\n2 tsp cinnamon"
          },
          {
            "id": 105450,
            "primary_message": "Pour oil mixture over oats and nuts and stir to coat.",
            "secondary_message": null
          },
          {
            "id": 105451,
            "primary_message": "Spread out on a baking sheet lined with parchment paper and bake for 6-8 minutes, stirring halfway through cooking. Watch carefully as the nuts can burn easily.",
            "secondary_message": null
          },
          {
            "id": 105452,
            "primary_message": "Peel the bananas and slice.",
            "secondary_message": "2 bananas"
          },
          {
            "id": 105453,
            "primary_message": "Spoon yogurt into bowls and top with granola and bananas. Enjoy!",
            "secondary_message": "2 cups plain Greek yogurt"
          }
        ],
