  "instructions": [
    {
      "id": 483559,
      "primary_message": "Preheat oven to 350°F. Line two baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 483560,
      "primary_message": "Peel bananas, break into chunks, and place in a medium bowl. Mash with a fork or potato masher until smooth.",
      "secondary_message": "2 bananas"
    },
    {
      "id": 483561,
      "primary_message": "Roughly chop dates. Add to the bowl with the banana along with eggs, peanut butter, and maple syrup. Stir to combine.",
      "secondary_message": "½ cup medjool dates, pitted\n2 eggs\n⅓ cup natural peanut butter\n2 tbsp pure maple syrup"
    },
    {
      "id": 483562,
      "primary_message": "Add oats, protein powder, cocoa powder, cinnamon, and salt to the bowl. Stir once more to combine the batter.",
      "secondary_message": "1 ½ cup oats, quick cooking\n2 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n2 tbsp cocoa powder\n½ tsp cinnamon, ground\n⅛ tsp salt"
    },
    {
      "id": 483563,
      "primary_message": "Using a ¼-cup measure, scoop batter onto the baking sheets, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 483564,
      "primary_message": "Allow to cool for a few minutes before transferring to plates. Enjoy!",
      "secondary_message": null
    }
  ],
