        "instructions": [
          {
            "id": 298744,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 small bunches cilantro\n4 medium zucchini squash\n2 jalapeño peppers\n1 bunch radish\n1 lime"
          },
          {
            "id": 298745,
            "primary_message": "Shave cilantro leaves off the stems; discard stems. Place half of the leaves in a small bowl and set aside for serving; mince remaining leaves and place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 298746,
            "primary_message": "Add beef, salt, and pepper to the bowl with the minced cilantro; mix with your hands until well combined. Form the beef mixture into 4 equal-sized patties, place on a plate, and set aside. ",
            "secondary_message": "1 ½ lb lean ground beef\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 298747,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 298748,
            "primary_message": "While the skillet heats up, place mayo and chili-garlic sauce in another small bowl; stir to combine the spicy mayo and set aside.",
            "secondary_message": "3 tbsp mayonnaise\n2 tsp chili-garlic sauce"
          },
          {
            "id": 298749,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 2-3 minutes, until cooked through. Once done, transfer to a clean plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 298750,
            "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Place in another medium bowl.",
            "secondary_message": null
          },
          {
            "id": 298751,
            "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the zucchini; set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 298752,
            "primary_message": "Peel, halve, and thinly slice onion. Peel and mince garlic.",
            "secondary_message": "1 medium red onion\n2 cloves garlic"
          },
          {
            "id": 298753,
            "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until fragrant, about 1 minute.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 298754,
            "primary_message": "Add zucchini, jalapeño, water, salt, and pepper to the skillet; continue to cook, stirring occasionally, until veggies are fork-tender, 3-4 minutes more.",
            "secondary_message": "2 tbsp water\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 298755,
            "primary_message": "Meanwhile, trim and thinly slice radishes.",
            "secondary_message": null
          },
          {
            "id": 298756,
            "primary_message": "When the veggies are done, juice lime into the skillet, stir to combine, and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 298757,
            "primary_message": "Toast buns if desired.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 298758,
            "primary_message": "Place bottom half of each bun on a plate; spread with spicy mayo, then layer with burger patties, radish, and reserved cilantro leaves. Close with the top half of each bun and serve with sautéed veggies on the side. Enjoy!",
            "secondary_message": null
          }
        ],
