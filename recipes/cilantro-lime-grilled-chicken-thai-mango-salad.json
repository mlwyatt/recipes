  "instructions": [
    {
      "id": 27698,
      "primary_message": "Wash and dry the cilantro. Shave the leaves off the stems; discard the stems and mince the leaves. Transfer one half to a medium bowl and the other half to a large bowl.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 27699,
      "primary_message": "Grate zest from a lime. Add the lime zest and juice, olive oil, salt, and pepper to the medium bowl with the cilantro; mix together.",
      "secondary_message": "1 lime\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 27700,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place in the marinade and turn to coat. Set aside for a few minutes.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 27701,
      "primary_message": "Preheat a grill pan or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 27702,
      "primary_message": "Wash the mangoes and bell peppers.",
      "secondary_message": "2 mangoes\n2 red bell peppers"
    },
    {
      "id": 27703,
      "primary_message": "Coat the grill/skillet with oil. Add the chicken and cook until browned and cooked through, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 27704,
      "primary_message": "Peel and julienne (or cut into thin sticks) the mangoes; add to the large bowl with the cilantro. Seed and julienne (or cut into thin sticks) the bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 27705,
      "primary_message": "Peel and mince or press the garlic. In a small bowl, prepare the dressing by whisking together the minced garlic, lime juice, fish sauce, rice vinegar, honey, water, and crushed red pepper.",
      "secondary_message": "2 cloves garlic\n1 lime\n2 tbsp fish sauce\n2 tbsp rice vinegar\n2 tbsp honey\n2 tbsp water\n¼ tsp crushed red pepper"
    },
    {
      "id": 27706,
      "primary_message": "Pour the dressing over top the salad and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 27707,
      "primary_message": "Serve the grilled chicken with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
