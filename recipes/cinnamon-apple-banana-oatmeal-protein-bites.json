        "instructions": [
          {
            "id": 483595,
            "primary_message": "Preheat oven to 350°F. Line two baking sheet pans with parchment paper.",
            "secondary_message": null
          },
          {
            "id": 483596,
            "primary_message": "Peel bananas, break into chunks, and place in a medium bowl. Mash with a fork or potato masher until smooth.",
            "secondary_message": "2 bananas"
          },
          {
            "id": 483597,
            "primary_message": "Add eggs and maple syrup to the bowl with the banana. Stir to combine.",
            "secondary_message": "2 eggs\n2 tbsp pure maple syrup"
          },
          {
            "id": 483598,
            "primary_message": "Wash, dry, quarter, core, and small dice apple. Add to the bowl along with oats, protein powder, cinnamon, and salt. Stir once more to combine the batter.",
            "secondary_message": "1 Gala apple\n1 ½ cup oats, quick cooking\n2 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n1 tsp cinnamon, ground\n⅛ tsp salt"
          },
          {
            "id": 483599,
            "primary_message": "Using a ¼-cup measure, scoop batter onto the baking sheets, leaving some space between. Use the back of a spoon to spread each \"bite\" into a 3-inch circle. Place in the oven and bake until just firm to the touch, about 15 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 483600,
            "primary_message": "Allow to cool for a few minutes before transferring to plates. Enjoy!",
            "secondary_message": null
          }
        ],
