  "instructions": [
    {
      "id": 115840,
      "primary_message": "Add salt and water to a medium saucepan, cover, and bring to a boil over high heat. ",
      "secondary_message": "⅛ tsp salt\n3 ½ cup water"
    },
    {
      "id": 115841,
      "primary_message": "Wash and dry the lime; zest and juice it into a small bowl.",
      "secondary_message": "1 lime"
    },
    {
      "id": 115842,
      "primary_message": "Once the water is boiling, stir in oats, cinnamon, and maple syrup; reduce heat to medium-low. Cover and let simmer for 3-5 minutes or until oats reach desired consistency. ",
      "secondary_message": "2 cup oats, quick cooking\n1 tsp cinnamon\n4 tsp pure maple syrup"
    },
    {
      "id": 115843,
      "primary_message": "Add yogurt and maple syrup to the bowl with the lime zest and juice; whisk to combine.",
      "secondary_message": "1 cup plain Greek yogurt\n4 tsp pure maple syrup"
    },
    {
      "id": 115844,
      "primary_message": "When the oats are done, stir in milk.",
      "secondary_message": "4 fl oz (½ cup) whole milk"
    },
    {
      "id": 115845,
      "primary_message": "To serve, divide oats between bowls and top with lime yogurt and pistachios. Enjoy!",
      "secondary_message": "½ cup pistachios, unsalted"
    }
  ],
