        "instructions": [
          {
            "id": 33814,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 tomatoes\n1 English cucumber\n1 head romaine lettuce"
          },
          {
            "id": 33815,
            "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 33816,
            "primary_message": "In a medium bowl, combine and mix together the ground beef, Worcestershire, Dijon, salt, and pepper. Form the mixture into 4 patties and place on a plate.",
            "secondary_message": "1 ½ lb lean ground beef\n2 tsp Worcestershire sauce\n2 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 33817,
            "primary_message": "Once the grill pan or skillet is hot, coat the bottom with coconut oil.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 33818,
            "primary_message": "Place the beef patties on the grill pan or skillet and cook until desired doneness, 4 to 6 minutes per side. Once done, transfer the patties to a plate.",
            "secondary_message": null
          },
          {
            "id": 33819,
            "primary_message": "While the patties cook, rip off a few lettuce leaves for the burgers and place on a plate. Then, trim off and discard the root end of the remaining lettuce and remove any blemished leaves; quarter the head lengthwise, then chop crosswise into 1-inch pieces. Transfer the chopped lettuce to a large salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33820,
            "primary_message": "Slice two of the tomatoes crosswise into ¼-inch-thick rounds for the burgers and add to the plate with the lettuce leaves. Halve the other tomatoes lengthwise and cut out and discard the stem end; large dice the tomato and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33821,
            "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into ¼-inch-thick pieces on an angle and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33822,
            "primary_message": "In a small bowl, combine and whisk together olive oil, red wine vinegar, Dijon, salt, and pepper.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n½ tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper "
          },
          {
            "id": 33823,
            "primary_message": "Pour the dressing over the salad and toss to coat.",
            "secondary_message": null
          },
          {
            "id": 33824,
            "primary_message": "Toast the buns if desired.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 33825,
            "primary_message": "To serve, assemble the burger and add any desired condiments. Serve with the salad on the side. Enjoy!",
            "secondary_message": null
          }
        ],
