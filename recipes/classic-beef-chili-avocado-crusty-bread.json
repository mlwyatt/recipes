  "instructions": [
    {
      "id": 15241,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 15242,
      "primary_message": "Peel and small dice onion. Peel and mince garlic. Wash, seed, and mince jalapeños.",
      "secondary_message": "1 medium red onion\r\n4 cloves garlic\r\n2 jalapeño peppers"
    },
    {
      "id": 15243,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and jalapeños. Stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 15244,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans kidney beans"
    },
    {
      "id": 15245,
      "primary_message": "Add garlic, chili powder, and cumin to saucepan. Stir and cook for 30 seconds.",
      "secondary_message": "2 tbsp chili powder\r\n2 tsp cumin"
    },
    {
      "id": 15246,
      "primary_message": "Add beef and, breaking apart with a spoon, cook until crumbly and browned, 2-3 minutes.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 15247,
      "primary_message": "Add beans, tomatoes, salt, and pepper. Bring to a boil. Reduce heat to a simmer and cook until chili thickens, about 10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 15248,
      "primary_message": "Halve and pit avocado; scoop out and medium dice the flesh.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 15249,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 15250,
      "primary_message": "To serve, place chili in a bowl and garnish with avocado. Enjoy with bread!",
      "secondary_message": ""
    }
  ],
