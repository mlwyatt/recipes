        "instructions": [
          {
            "id": 236227,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 236228,
            "primary_message": "Meanwhile, peel and small dice onion.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 236229,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until starting to soften, 2-3 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 236230,
            "primary_message": "While the onion is cooking, wash and dry the fresh produce.",
            "secondary_message": "4 medium carrots\n2 sticks celery\n2 medium zucchini squash"
          },
          {
            "id": 236231,
            "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to the pot with the onion. ",
            "secondary_message": "1 ⅓ cups green lentils, dried"
          },
          {
            "id": 236232,
            "primary_message": "Add broth, diced tomatoes, and spices to the pot; stir to combine, cover, and bring soup to a boil over medium-high heat.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes\n2 tsp Italian seasoning\n1 ½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 236233,
            "primary_message": "While the soup is heating, peel, trim, and slice carrots crosswise into ¼-inch pieces. Trim and slice celery crosswise into ¼-inch pieces. Add both to the soup.",
            "secondary_message": null
          },
          {
            "id": 236234,
            "primary_message": "Trim and medium dice zucchini; add to the soup.",
            "secondary_message": null
          },
          {
            "id": 236235,
            "primary_message": "Peel and mince garlic; add half the garlic to the soup (reserving the rest for the bread sticks) and stir to combine. Once the soup comes to a boil, reduce heat to a simmer, cover, and cook until veggies and lentils are tender, about 20 minutes.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 236236,
            "primary_message": "Meanwhile, preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 236237,
            "primary_message": "Place reserved garlic in a small bowl along with oil and spices; stir to combine the garlic oil.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp rosemary, dried\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 236238,
            "primary_message": "Drizzle garlic oil over the flatbreads; cut into 1½-inch wide strips and transfer to a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven.",
            "secondary_message": "2 flatbreads or naan"
          },
          {
            "id": 236239,
            "primary_message": "When the soup is done, add vinegar and stir to combine.",
            "secondary_message": "1 tsp red wine vinegar"
          },
          {
            "id": 236240,
            "primary_message": "Divide soup between bowls and serve with breadsticks on the side. Enjoy!",
            "secondary_message": null
          }
        ],
