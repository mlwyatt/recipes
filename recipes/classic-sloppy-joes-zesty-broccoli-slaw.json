  "instructions": [
    {
      "id": 15517,
      "primary_message": "Peel and small dice onion. Wash, seed, and small dice bell peppers. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\r\n2 red bell peppers\r\n2 cloves garlic"
    },
    {
      "id": 15518,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 15519,
      "primary_message": "Coat bottom of skillet with oil. Add onion and peppers. Stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 15520,
      "primary_message": "Add beef and garlic. Breaking apart with a spoon, cook until meat is browned and crumbly, 2-3 minutes.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 15521,
      "primary_message": "Add tomato sauce, vinegar, honey, Worcestershire, Dijon, chili powder, salt, and pepper. Stirring occasionally, reduce heat to low and simmer until sauce thickens, 10-15 minutes.",
      "secondary_message": "2 (8 oz) cans tomato sauce\r\n1 tbsp red wine vinegar\r\n1 tbsp honey\r\n1 tbsp Worcestershire sauce\r\n1 tsp Dijon mustard\r\n1 tsp chili powder\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 15522,
      "primary_message": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together garlic, olive oil, vinegar, Dijon, honey, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\n3 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n2 tsp Dijon mustard\r\n2 tsp honey\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 15523,
      "primary_message": "Add broccoli slaw to bowl with dressing and toss to coat.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 15524,
      "primary_message": "Toast buns or rolls if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 15525,
      "primary_message": "To serve, fill buns or rolls with sloppy joe mixture and enjoy with broccoli slaw on the side!",
      "secondary_message": ""
    }
  ],
