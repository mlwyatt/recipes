  "instructions": [
    {
      "id": 99410,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 99411,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 oranges\n1 small pineapple"
    },
    {
      "id": 99412,
      "primary_message": "Peel the oranges and cut into quarters; place in blender.",
      "secondary_message": null
    },
    {
      "id": 99413,
      "primary_message": "Cut skin off pineapple, core, and cut into large pieces; place in blender.",
      "secondary_message": null
    },
    {
      "id": 99414,
      "primary_message": "Add the mango, coconut milk, and 4 ice cubes to the blender.",
      "secondary_message": "2 cup frozen mangoes\n1 (13.5 fl oz) can coconut milk"
    },
    {
      "id": 99415,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 99416,
      "primary_message": "Pour the smoothie into glasses and enjoy!",
      "secondary_message": null
    }
  ],
