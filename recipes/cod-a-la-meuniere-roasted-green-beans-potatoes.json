        "instructions": [
          {
            "id": 34654,
            "primary_message": "Preheat the oven to 450°F and place the rack in the center position.",
            "secondary_message": null
          },
          {
            "id": 34655,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium red potatoes\n1 lb green beans\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 34656,
            "primary_message": "Halve the potatoes lengthwise, then cut each half lengthwise into 6 wedges; transfer the wedges to a baking sheet.",
            "secondary_message": ""
          },
          {
            "id": 34657,
            "primary_message": "Place the sheet in the oven and cook the potatoes for about 10 minutes (while you prepare the green beans).",
            "secondary_message": null
          },
          {
            "id": 34658,
            "primary_message": "Trim and discard the ends of the green beans; transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 34659,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 34660,
            "primary_message": "Remove the sheet from the oven; add the green beans and garlic to the potatoes.",
            "secondary_message": ""
          },
          {
            "id": 34661,
            "primary_message": "Drizzle the vegetables with olive oil and season with salt and pepper; toss to coat, then spread out in an even layer.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 34662,
            "primary_message": "Return the sheet to the oven; cook the vegetables, tossing once halfway through cooking time, until they are tender, another 10 to 15 minutes. Once done, remove from the oven.",
            "secondary_message": null
          },
          {
            "id": 34663,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 34664,
            "primary_message": "Pat the cod dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb cod fillet\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 34665,
            "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 34666,
            "primary_message": "Place the fish in the skillet; cook until it is browned and crisp, 3 to 5 minutes per side. Once done, transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 34667,
            "primary_message": "While the fish cooks, juice the lemon into a small bowl.",
            "secondary_message": null
          },
          {
            "id": 34668,
            "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves.",
            "secondary_message": ""
          },
          {
            "id": 34669,
            "primary_message": "Once the fish has been transferred, add butter to the skillet and let it turn a light brown, then remove the skillet from the heat and stir in the lemon juice and ½ of the parsley (save the rest for the green beans and potatoes).",
            "secondary_message": "4 tbsp butter, unsalted"
          },
          {
            "id": 34670,
            "primary_message": "Sprinkle the green beans and potatoes with the remaining parsley; toss to combine.",
            "secondary_message": ""
          },
          {
            "id": 34671,
            "primary_message": "To serve, place the fish on a plate, spoon the butter sauce overtop, and add the roasted green beans and potatoes on the side. Enjoy!",
            "secondary_message": null
          }
        ],
