        "instructions": [
          {
            "id": 364537,
            "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
            "secondary_message": "1 tsp salt"
          },
          {
            "id": 364538,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 limes\n1 red bell pepper\n1 English cucumber\n1 small bunch cilantro"
          },
          {
            "id": 364539,
            "primary_message": "Zest and juice limes into a small bowl. Add coconut milk, sugar, curry powder, and salt; whisk to combine the dressing and set aside.",
            "secondary_message": "1 (13.5 fl oz) can coconut milk\n2 tbsp brown sugar\n2 tsp curry powder\n1 tsp salt"
          },
          {
            "id": 364540,
            "primary_message": "Once the water in the saucepan is boiling, add the noodles and edamame; cook noodles according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water.",
            "secondary_message": "10 oz soba (buckwheat) noodles\n2 cups edamame"
          },
          {
            "id": 364541,
            "primary_message": "Meanwhile, trim, seed, and halve bell pepper crosswise, then slice into thin strips. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 364542,
            "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the bell pepper.",
            "secondary_message": null
          },
          {
            "id": 364543,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 364544,
            "primary_message": "Add noodles, edamame, cabbage, and carrots to the bowl; toss to combine the salad.",
            "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n1 (10 oz) bag shredded carrots"
          },
          {
            "id": 364545,
            "primary_message": "To serve, divide salad between plates or bowls; drizzle with dressing and enjoy. Enjoy!",
            "secondary_message": null
          }
        ],
