        "instructions": [
          {
            "id": 308661,
            "primary_message": "Preheat oven to 425°F. Position racks in the upper and lower thirds of the oven.",
            "secondary_message": null
          },
          {
            "id": 308662,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 leeks\n1 lemon\n2 yellow bell peppers\n2 (8 oz) pkg sugar snap peas"
          },
          {
            "id": 308663,
            "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in a medium bowl. ",
            "secondary_message": null
          },
          {
            "id": 308664,
            "primary_message": "Peel and mince garlic; zest lemon. Add both to the bowl with the leek and set aside. (Reserve lemon for later use.)",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 308665,
            "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 308666,
            "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 308667,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add chicken and cook until golden, about 2 minutes per side. Once golden, transfer to a clean plate and cover with aluminum foil (the chicken will not be cooked all the way through). Reserve skillet (with juices) for the next step.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 308668,
            "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add leek, garlic, lemon zest, and spices; cook, stirring occasionally, until the leek starts to soften, 3-4 minutes. (Reserve bowl for the next step.)",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp coriander, ground\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 308669,
            "primary_message": "Meanwhile, trim, seed, and medium dice bell peppers; cut snap peas in half crosswise. Place both in the reserved bowl.",
            "secondary_message": null
          },
          {
            "id": 308670,
            "primary_message": "When the leek is soft, add bell pepper, snap peas, and broth to the skillet; stir to combine and bring to a simmer over medium-high heat. ",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
          },
          {
            "id": 308671,
            "primary_message": "Once simmering, return chicken to the skillet (along with any accumulated juices) and nestle into the veggies. Place skillet on lower rack of the oven and bake until veggies are tender and chicken is cooked through, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 308672,
            "primary_message": "While the chicken is cooking, split buns in half and place on a large baking sheet pan; drizzle with oil and season with spices. Place on upper rack of the oven and toast until golden, about 4 minutes. Remove from oven.",
            "secondary_message": "4 whole grain buns or rolls\n1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 308673,
            "primary_message": "When the chicken is done, remove from oven and juice reserved lemon over top.",
            "secondary_message": null
          },
          {
            "id": 308674,
            "primary_message": "To serve, divide chicken, veggies, sauce, and toast between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
