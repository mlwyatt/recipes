        "instructions": [
          {
            "id": 475137,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 475138,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n1 pint grape tomatoes\n1 small pkg fresh basil"
          },
          {
            "id": 475139,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 475140,
            "primary_message": "While the skillet heats up, trim, seed, and slice bell peppers lengthwise into thin strips.",
            "secondary_message": null
          },
          {
            "id": 475141,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, tomatoes, and salt. Cook, stirring occasionally, until tender and starting to brown, 5-7 minutes. ",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 475142,
            "primary_message": "Meanwhile, arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from oven and set aside.",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 475143,
            "primary_message": "While the flatbreads are baking, place cottage cheese in a strainer to remove excess liquid. Transfer to a small bowl, season with salt, and stir to combine. Set aside.",
            "secondary_message": "2 cups cottage cheese\n⅛ tsp salt"
          },
          {
            "id": 475144,
            "primary_message": "Place honey, hot sauce, and salt in another small bowl. Whisk to combine the hot honey and set aside.",
            "secondary_message": "3 tbsp honey\n2 tsp hot sauce\n⅛ tsp salt"
          },
          {
            "id": 475145,
            "primary_message": "When the veggies are done, add vinegar to the skillet, stir to combine, and remove from heat.",
            "secondary_message": "2 tsp balsamic vinegar"
          },
          {
            "id": 475146,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the skillet with the veggies and stir to combine. (Reserve remaining basil for serving.)",
            "secondary_message": null
          },
          {
            "id": 475147,
            "primary_message": "Spread the cottage cheese over each flatbread, then top with veggies.",
            "secondary_message": null
          },
          {
            "id": 475148,
            "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Drizzle with hot honey and top with reserved basil. Enjoy!",
            "secondary_message": null
          }
        ],
