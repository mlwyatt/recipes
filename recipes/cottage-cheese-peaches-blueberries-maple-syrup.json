          },
          {
            "id": 414352,
            "primary_message": "Wash and dry blueberries.",
            "secondary_message": "1 (6 oz) pkg blueberries"
          },
          {
            "id": 414353,
            "primary_message": "To serve, divide cottage cheese, peaches, and blueberries between bowls. Drizzle with maple syrup and enjoy!",
            "secondary_message": "3 cups cottage cheese\n4 tsp pure maple syrup"
          }
