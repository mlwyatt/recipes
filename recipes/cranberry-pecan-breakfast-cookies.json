        "instructions": [
          {
            "id": 125532,
            "primary_message": "Preheat the oven to 350°F and place the rack in the center position. Line a sheet pan with parchment paper (optional).",
            "secondary_message": null
          },
          {
            "id": 125533,
            "primary_message": "Peel bananas, break into chunks, and place in a medium bowl. ",
            "secondary_message": "2 bananas"
          },
          {
            "id": 125534,
            "primary_message": "Crack the eggs into the bowl and add honey. Use a fork or potato masher to mash the ingredients together.",
            "secondary_message": "2 eggs\n2 tbsp honey"
          },
          {
            "id": 125535,
            "primary_message": "Roughly chop the pecans and add to the bowl.",
            "secondary_message": "½ cup pecans, dry roasted"
          },
          {
            "id": 125536,
            "primary_message": "Add oats, cinnamon, and cranberries to the bowl. Stir until all ingredients are well combined. ",
            "secondary_message": "2 ⅔ cup oats, quick cooking\n1 tsp cinnamon\n½ cup dried cranberries"
          },
          {
            "id": 125537,
            "primary_message": "Use a ¼ cup measure to evenly scoop the batter onto the sheet pan. Press each cookie flat with your fingertips. Place in the oven and bake for 12 minutes. ",
            "secondary_message": null
          },
          {
            "id": 125538,
            "primary_message": "Allow to cool for a few minutes before transferring to plates, enjoy! ",
            "secondary_message": null
          }
        ],
