        "instructions": [
          {
            "id": 220714,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium carrots\n4 sticks celery\n2 medium zucchini squash"
          },
          {
            "id": 220715,
            "primary_message": "Peel and small dice onion. Peel, trim, and small dice carrots. Transfer both to a medium bowl.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 220716,
            "primary_message": "Trim and small dice celery; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 220717,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 220718,
            "primary_message": "While the pot heats up, peel and mince garlic. Place half in a small bowl and set aside.",
            "secondary_message": "6 cloves garlic"
          },
          {
            "id": 220719,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 220720,
            "primary_message": "Add veggies, remaining garlic, and spices to the pot. Cook, stirring occasionally, until veggies are soft, 5-6 minutes.",
            "secondary_message": "½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 220721,
            "primary_message": "Meanwhile, drain and rinse chickpeas; transfer to a blender, along with broth, and blend until smooth.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 220722,
            "primary_message": "Trim and medium dice zucchini.",
            "secondary_message": null
          },
          {
            "id": 220723,
            "primary_message": "Add chickpea mixture, additional broth, and zucchini to the pot, stir to combine, and bring soup to a simmer. Cook, stirring occasionally, until veggies are tender, 5-7 minutes. ",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 220724,
            "primary_message": "Meanwhile, preheat oven to broil on high.",
            "secondary_message": null
          },
          {
            "id": 220725,
            "primary_message": "Place pitas on a baking sheet pan, drizzle with oil, and sprinkle with reserved garlic, salt, and rosemary. Place in the oven and broil until golden and toasted, 2-3 minutes. Remove from the oven.",
            "secondary_message": "4 whole grain pitas\n2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp rosemary"
          },
          {
            "id": 220726,
            "primary_message": "Cut pitas into quarters.",
            "secondary_message": null
          },
          {
            "id": 220727,
            "primary_message": "Divide soup between bowls and drizzle with oil. Serve with pita on the side and enjoy!",
            "secondary_message": "4 tsp extra virgin olive oil"
          }
        ],
