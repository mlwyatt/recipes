        "instructions": [
          {
            "id": 474000,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 leeks\n4 fennel bulbs\n4 sticks celery\n2 medium red potatoes"
          },
          {
            "id": 474001,
            "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 474002,
            "primary_message": "Trim off root end and dark green stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise and medium dice. Add to the bowl with the leek.",
            "secondary_message": null
          },
          {
            "id": 474003,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 474004,
            "primary_message": "While the pot heats up, trim and small dice celery. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 474005,
            "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
            "secondary_message": "2 tbsp butter, unsalted\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 474006,
            "primary_message": "Meanwhile, peel and small dice potatoes.",
            "secondary_message": null
          },
          {
            "id": 474007,
            "primary_message": "When the veggies are soft, add potato and broth to the pot. Stir to combine and bring to a boil over high heat. Once the soup is boiling, reduce heat and simmer until potatoes are tender, 12-15 minutes.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth"
          },
          {
            "id": 474008,
            "primary_message": "When the potatoes are tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.)",
            "secondary_message": null
          },
          {
            "id": 474009,
            "primary_message": "Add cream to the pot and continue to cook, stirring occasionally, until just warmed through, 1 minute more. Remove from heat.",
            "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream"
          },
          {
            "id": 474010,
            "primary_message": "To serve, divide soup between bowls. Top with pumpkin seeds and enjoy!",
            "secondary_message": "¼ cup pumpkin seeds"
          }
        ],
