        "instructions": [
          {
            "id": 114319,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Add the frozen corn within the last 4 minutes of cooking. When the pasta and corn are finished, drain, return to pot, and set aside.",
            "secondary_message": "2 tsp salt\n10 oz fettuccine pasta\n1 cup frozen corn"
          },
          {
            "id": 114320,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 small pkgs fresh basil\n1 lemon\n2 avocados\n1 pint grape tomatoes"
          },
          {
            "id": 114321,
            "primary_message": "Pick basil leaves off the stems and place in the blender. Reserve several leaves for garnish.",
            "secondary_message": null
          },
          {
            "id": 114322,
            "primary_message": "Juice the lemons into the blender.",
            "secondary_message": null
          },
          {
            "id": 114323,
            "primary_message": "Halve avocados and remove pits; scoop the flesh into the blender.",
            "secondary_message": null
          },
          {
            "id": 114324,
            "primary_message": "Peel the garlic and add to the blender.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 114325,
            "primary_message": "Finely grate Parmesan and add to the blender along with the olive oil, salt, and pepper.",
            "secondary_message": "4 oz Parmesan cheese\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 114326,
            "primary_message": "Blend the ingredients until smooth, 30-60 seconds.",
            "secondary_message": null
          },
          {
            "id": 114327,
            "primary_message": "Add the sauce from the blender into the pot with the pasta and corn; stir to combine.",
            "secondary_message": null
          },
          {
            "id": 114328,
            "primary_message": "Halve the grape tomatoes and add to the pasta, stir once more to combine.",
            "secondary_message": null
          },
          {
            "id": 114329,
            "primary_message": "Divide the pasta mixture between bowls, garnish with reserved basil, and enjoy!",
            "secondary_message": null
          }
        ],
