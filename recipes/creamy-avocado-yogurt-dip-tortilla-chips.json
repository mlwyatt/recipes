        "instructions": [
          {
            "id": 383789,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lime\n½ small bunch cilantro\n2 avocados"
          },
          {
            "id": 383790,
            "primary_message": "Juice lime into a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 383791,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice.",
            "secondary_message": null
          },
          {
            "id": 383792,
            "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and add to the bowl. Season with spices and mash with a fork or potato masher until smooth.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper\n¼ tsp onion powder\n¼ tsp garlic powder"
          },
          {
            "id": 383793,
            "primary_message": "Add yogurt to the bowl and stir to combine the avocado-yogurt dip.",
            "secondary_message": "¼ cup plain Greek yogurt"
          },
          {
            "id": 383794,
            "primary_message": "To serve, divide dip and chips between plates. Enjoy!",
            "secondary_message": "4 oz tortilla chips"
          }
        ],
