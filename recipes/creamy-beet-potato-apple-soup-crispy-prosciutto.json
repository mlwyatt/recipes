        "instructions": [
          {
            "id": 367510,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium beets\n2 medium carrots\n4 medium yellow potatoes\n2 Granny Smith apples\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 367511,
            "primary_message": "Peel, trim, and small dice beets and carrots. Place both in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 367512,
            "primary_message": "Peel and small dice potatoes. Add to the bowl with the beets and carrot. ",
            "secondary_message": null
          },
          {
            "id": 367513,
            "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 367514,
            "primary_message": "Peel and mince garlic. Peel, halve, and small dice onion. Add both to the bowl.",
            "secondary_message": "4 cloves garlic\n1 medium red onion"
          },
          {
            "id": 367515,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 367516,
            "primary_message": "While the pot heats up, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserve remaining parsley for garnish).",
            "secondary_message": null
          },
          {
            "id": 367517,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, apple, and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 367518,
            "primary_message": "When the veggies are soft, add broth and bring to a simmer. Once simmering, reduce heat to medium and continue to cook until veggies are very tender, 10-12 minutes more.",
            "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
          },
          {
            "id": 367519,
            "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 367520,
            "primary_message": "Once the skillet is hot, working in batches, add the prosciutto and cook until crispy, about 1 minute per side. Remove prosciutto to a plate and set aside.",
            "secondary_message": "8 slices prosciutto"
          },
          {
            "id": 367521,
            "primary_message": "When the soup is done, remove from heat and add cream. Use a hand blender to purée the soup until smooth. Alternatively, use a potato masher to crush the veggies (the soup will be chunkier).",
            "secondary_message": "8 fl oz (1 cup) heavy whipping cream"
          },
          {
            "id": 367522,
            "primary_message": "Crumble or chop prosciutto into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 367523,
            "primary_message": "To serve, divide soup between bowls; top with crispy prosciutto and reserved parsley. Enjoy!",
            "secondary_message": null
          }
        ],
