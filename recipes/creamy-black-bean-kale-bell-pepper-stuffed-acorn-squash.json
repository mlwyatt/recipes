  "instructions": [
    {
      "id": 449278,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 449279,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 acorn squash\n1 bunch kale\n2 red bell peppers"
    },
    {
      "id": 449280,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil, then season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 449281,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 449282,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 449283,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the kale.",
      "secondary_message": null
    },
    {
      "id": 449284,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 449285,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 449286,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add kale, bell pepper, and garlic to the skillet in handfuls, waiting for kale to wilt slightly before adding the next handful. Cook, stirring often, until the veggies are tender, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 449287,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 449288,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "⅔ (8 oz) block cream cheese"
    },
    {
      "id": 449289,
      "primary_message": "When the veggies are done, add beans, cream cheese, broth, and spices to the skillet; stir until cheese is melted and combined. Bring to a simmer and continue to cook, stirring occasionally, until sauce thickens, 3-4 minutes more. Remove from heat.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tsp chili powder\n1 tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 449290,
      "primary_message": "To serve, divide squash halves between plates, stuff with filling, and sprinkle with bread crumbs. Enjoy!",
      "secondary_message": "¼ cup panko bread crumbs"
    }
  ],
