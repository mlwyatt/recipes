        "instructions": [
          {
            "id": 324623,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 small bunch cilantro\n2 limes\n1 jalapeño pepper\n1 mango\n1 small head red cabbage\n2 red bell peppers"
          },
          {
            "id": 324624,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a large bowl and half in a blender. ",
            "secondary_message": null
          },
          {
            "id": 324625,
            "primary_message": "Juice one lime into the bowl with the cilantro; juice remaining lime into the blender and set aside. ",
            "secondary_message": null
          },
          {
            "id": 324626,
            "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the cilantro. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
            "secondary_message": null
          },
          {
            "id": 324627,
            "primary_message": "Peel and mince shallot; add to the bowl along with oil, salt, and cumin; whisk to combine the dressing. ",
            "secondary_message": "1 shallot\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp cumin, ground"
          },
          {
            "id": 324628,
            "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice and add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 324629,
            "primary_message": "Quarter the cabbage lengthwise, then cut out and discard the core; slice crosswise into thin (shred-like) strips and add to the bowl. Stir to combine the slaw and set aside.",
            "secondary_message": null
          },
          {
            "id": 324630,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 324631,
            "primary_message": "While the skillet heats up, trim, seed, and thinly slice bell peppers.",
            "secondary_message": null
          },
          {
            "id": 324632,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper and salt. Cook, stirring occasionally, until softened, 4-5 minutes. Remove from heat.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 324633,
            "primary_message": "Meanwhile, drain and rinse beans; add to the blender with the cilantro and lime juice.",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 324634,
            "primary_message": "Peel garlic; add to the blender along with water, pumpkin seeds, and spices. Blend on high until smooth.",
            "secondary_message": "2 cloves garlic\n1 cup water\n½ cup pumpkin seeds\n2 tsp chili powder\n1 tsp cumin, ground\n1 tsp coriander, ground\n½ tsp salt"
          },
          {
            "id": 324635,
            "primary_message": "Place tortillas on a flat surface and spread each with an even layer of black bean spread. Top with bell peppers and a small portion of slaw (reserving the rest for serving); roll tightly to close.",
            "secondary_message": "4 large flour tortillas"
          },
          {
            "id": 324636,
            "primary_message": "Cut wraps in half and divide between plates; serve with remaining slaw on the side and enjoy!",
            "secondary_message": null
          }
        ],
