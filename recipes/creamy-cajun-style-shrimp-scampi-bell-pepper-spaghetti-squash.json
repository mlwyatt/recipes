        "instructions": [
          {
            "id": 377485,
            "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
            "secondary_message": null
          },
          {
            "id": 377486,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium spaghetti squash\n2 green bell peppers\n4 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 377487,
            "primary_message": "Trim each squash, halve lengthwise, and scrape out the seeds. Rub the inside of each half with oil, then season with salt and pepper. Arrange halves, cut-side down, on the baking sheet.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 377488,
            "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 377489,
            "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry. Set aside.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 377490,
            "primary_message": "Peel, halve, and slice onion lengthwise into thin pieces. Peel and mince garlic. Place both in a medium bowl.",
            "secondary_message": "1 medium red onion\n4 cloves garlic"
          },
          {
            "id": 377491,
            "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl with the onion and garlic.",
            "secondary_message": null
          },
          {
            "id": 377492,
            "primary_message": "Trim and slice celery crosswise into thin pieces. Add to the bowl with the other veggies and set aside.",
            "secondary_message": null
          },
          {
            "id": 377493,
            "primary_message": "About 10 minutes before the squash is done, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 377494,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies start to soften, 3-4 minutes.",
            "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp Cajun seasoning\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 377495,
            "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 377496,
            "primary_message": "Add shrimp to the skillet and cook, stirring often, until just cooked through, about 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 377497,
            "primary_message": "Add parsley and cream to the skillet. Continue to cook, stirring constantly, until simmering, 1 minute more. Remove from heat.",
            "secondary_message": "8 fl oz (1 cup) heavy whipping cream"
          },
          {
            "id": 377498,
            "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
            "secondary_message": null
          },
          {
            "id": 377499,
            "primary_message": "To serve, divide squash, shrimp, veggies, and sauce between plates. Enjoy!",
            "secondary_message": null
          }
        ],
