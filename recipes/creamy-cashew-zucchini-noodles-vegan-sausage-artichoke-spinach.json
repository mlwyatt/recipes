        "instructions": [
          {
            "id": 271620,
            "primary_message": "Boil water in a kettle. (If you do not have a kettle, boil water in a small saucepan, starting with hot water from the tap.) In a small heat-safe bowl, pour boiling water over cashews and set aside to soak.",
            "secondary_message": "2 cup water\n1 cup cashews, roasted unsalted"
          },
          {
            "id": 271621,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 271622,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate and cover with foil. (Reserve skillet for later use.)",
            "secondary_message": "2 tsp extra virgin olive oil\n4 pre-cooked vegan sausage"
          },
          {
            "id": 271623,
            "primary_message": "While the sausages are cooking, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "8 medium zucchini squash\n2 (5 oz) pkgs baby spinach\n1 lemon"
          },
          {
            "id": 271624,
            "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 271625,
            "primary_message": "Drain and thinly slice artichoke hearts; add to the bowl with the zucchini and set aside.",
            "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
          },
          {
            "id": 271626,
            "primary_message": "Peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 271627,
            "primary_message": "Return skillet to medium heat.",
            "secondary_message": null
          },
          {
            "id": 271628,
            "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add garlic and cook, stirring occasionally, until fragrant, about 1 minute.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 271629,
            "primary_message": "Add zucchini, artichokes, and spinach to the skillet in handfuls, waiting for the veggies to wilt slightly before adding the next handful. Cook, stirring occasionally, until veggies are tender, 3-4 minutes.",
            "secondary_message": null
          },
          {
            "id": 271630,
            "primary_message": "Meanwhile, drain cashews and place in a blender.",
            "secondary_message": null
          },
          {
            "id": 271631,
            "primary_message": "Juice lemon into the blender with the cashews. Add broth, nutritional yeast, flour, and spices to the blender; purée on high until the sauce is smooth.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n¼ cup nutritional yeast flakes\n4 tsp all-purpose flour\n1 tsp salt\n½ tsp black pepper\n½ tsp onion powder\n½ tsp paprika"
          },
          {
            "id": 271632,
            "primary_message": "Cut sausages crosswise into 1-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 271633,
            "primary_message": "Add sauce and sausage to the skillet; stir to combine with the veggies. Continue to cook, stirring often, until warmed through, 2-3 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 271634,
            "primary_message": "To serve, divide veggies, sauce, and sausage between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
