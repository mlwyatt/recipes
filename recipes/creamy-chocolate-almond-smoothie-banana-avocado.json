  "instructions": [
    {
      "id": 97657,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 97658,
      "primary_message": "Peel bananas, break into chunks, and add to blender.",
      "secondary_message": "6 bananas"
    },
    {
      "id": 97659,
      "primary_message": "Wash, halve, and pit avocado; add to blender.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 97660,
      "primary_message": "Add almond butter, cocoa powder, almond milk, maple syrup, cinnamon, salt, and 8 ice cubes to the blender.",
      "secondary_message": "½ cup natural almond butter\n¼ cup cocoa powder\n24 fl oz (3 cups) almond milk, unsweetened\n2 tsp pure maple syrup\n½ tsp cinnamon\n⅛ tsp salt"
    },
    {
      "id": 97661,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 97662,
      "primary_message": "Pour the smoothie into glasses and enjoy!",
      "secondary_message": null
    }
  ],
