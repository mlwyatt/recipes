        "instructions": [
          {
            "id": 287069,
            "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, about 15 minutes.",
            "secondary_message": "1 cup red lentils, dried\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 287070,
            "primary_message": "Meanwhile, cut chicken into bite-sized pieces. Season with salt and pepper.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 287071,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 287072,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add chicken and sauté until cooked through, 3-4 minutes. Using a slotted spoon, transfer chicken to a plate, cover with aluminum foil, and set aside. (Reserve skillet with cooking juices for later use.)",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 287073,
            "primary_message": "While the chicken is cooking, wash and dry the fresh produce.",
            "secondary_message": "4 green bell peppers\n4 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 287074,
            "primary_message": "Using a clean cutting board, trim, seed, and small dice bell peppers. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 287075,
            "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper. ",
            "secondary_message": null
          },
          {
            "id": 287076,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl (reserving a small handful for garnish).",
            "secondary_message": null
          },
          {
            "id": 287077,
            "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 287078,
            "primary_message": "Return skillet (with cooking juices) to medium heat.",
            "secondary_message": null
          },
          {
            "id": 287079,
            "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies and spices to the skillet; cook, stirring often, until veggies begin to soften, 4-5 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
          },
          {
            "id": 287080,
            "primary_message": "Add tomatoes and broth to the skillet. Reduce heat to low and simmer, stirring occasionally, until sauce thickens, 6-7 minutes.",
            "secondary_message": "1 (14.5 oz) can diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth"
          },
          {
            "id": 287081,
            "primary_message": "Return chicken to the skillet, stir to combine, and simmer until heated through, 2-3 minutes. Remove from heat and stir in cream.",
            "secondary_message": "4 fl oz (½ cup) heavy whipping cream"
          },
          {
            "id": 287082,
            "primary_message": "To serve, divide lentils and chicken sauté between bowls. Garnish with reserved parsley and enjoy!",
            "secondary_message": null
          }
        ],
