        "instructions": [
          {
            "id": 413427,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 413428,
            "primary_message": "While the skillet heats up, roughly chop walnuts.",
            "secondary_message": "1 cup walnuts"
          },
          {
            "id": 413429,
            "primary_message": "Once the skillet is hot, add walnuts and cook, stirring frequently, until lightly browned, 2-3 minutes. Transfer to a small bowl. (Reserve skillet for the next step.)",
            "secondary_message": null
          },
          {
            "id": 413430,
            "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom. Add bread crumbs and cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to the bowl with the walnuts and set aside to cool.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 cup panko bread crumbs\n¼ tsp salt"
          },
          {
            "id": 413431,
            "primary_message": "Meanwhile, place yogurt, Dijon, oil, water, honey, vinegar, salt, and pepper in a large bowl. Whisk to combine the dressing.",
            "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp Dijon mustard\n2 tbsp extra virgin olive oil\n2 tbsp water\n1 tbsp honey\n2 tsp rice vinegar\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 413432,
            "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, about 2 minutes.",
            "secondary_message": "2 bunches kale"
          },
          {
            "id": 413433,
            "primary_message": "Wash, dry, and quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh and add to the bowl with the kale.",
            "secondary_message": "4 peaches"
          },
          {
            "id": 413434,
            "primary_message": "Crumble goat cheese into the bowl and gently toss to combine the salad.",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 413435,
            "primary_message": "To serve, divide the salad between plates or bowls; top with walnuts and crispy bread crumbs. Enjoy!",
            "secondary_message": null
          }
        ],
