  "instructions": [
    {
      "id": 154048,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "2 tsp salt\n12 oz rotini pasta"
    },
    {
      "id": 154049,
      "primary_message": "Meanwhile, heat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 154050,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 154051,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 154052,
      "primary_message": "Add garlic to the pot and stir until fragrant, 15-30 seconds.",
      "secondary_message": null
    },
    {
      "id": 154053,
      "primary_message": "Add peas and salt. Cook, stirring occasionally, until peas are heated through, 4-5 minutes.",
      "secondary_message": "1 cup frozen peas\n½ tsp salt"
    },
    {
      "id": 154054,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 154055,
      "primary_message": "Add cream to the pot with the peas and bring to a simmer. Once pasta is done, drain and add to the pot along with the Parmesan.",
      "secondary_message": "8 fl oz (1 cup) heavy cream"
    },
    {
      "id": 154056,
      "primary_message": "Drain tuna, add to the pot, and gently stir to combine.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 154057,
      "primary_message": "To serve, divide pasta between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
