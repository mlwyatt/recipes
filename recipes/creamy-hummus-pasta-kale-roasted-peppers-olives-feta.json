  "instructions": [
    {
      "id": 430210,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, 6-8 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 430211,
      "primary_message": "Meanwhile, place hummus, milk, salt, and pepper in a small saucepan. Stir to combine and bring to a simmer over medium heat. Once simmering, remove sauce from heat, cover with a lid to keep warm, and set aside.",
      "secondary_message": "1 cup hummus\n8 fl oz (1 cup) whole milk\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 430212,
      "primary_message": "While the sauce is heating, drain and roughly chop roasted peppers and olives. Place both in a small bowl.",
      "secondary_message": "1 (12 oz) jar roasted red bell peppers\n½ cup Kalamata olives, pitted"
    },
    {
      "id": 430213,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add to the bowl with the peppers and olives, then set aside.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 430214,
      "primary_message": "When the pasta is almost done, add kale to the pot and stir to combine. Continue to cook until pasta and kale are tender, 2-3 minutes more. ",
      "secondary_message": "1 (10 oz) bag kale, cut and ready to use"
    },
    {
      "id": 430215,
      "primary_message": "Drain pasta and kale in a colander. Return to the pot along with the sauce, peppers, olives, and basil; gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 430216,
      "primary_message": "To serve, divide pasta between plates or bowls, then top with feta. Enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
