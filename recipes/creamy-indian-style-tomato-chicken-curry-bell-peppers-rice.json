        "instructions": [
          {
            "id": 401825,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n2 cup water\n¼ tsp salt"
          },
          {
            "id": 401826,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n2 green bell peppers\n2 (1 inch) pieces ginger root"
          },
          {
            "id": 401827,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 401828,
            "primary_message": "While the rice is cooking, trim, seed, and medium dice bell peppers. Place in a medium bowl. ",
            "secondary_message": null
          },
          {
            "id": 401829,
            "primary_message": "Preheat a large pot over medium-high heat. ",
            "secondary_message": null
          },
          {
            "id": 401830,
            "primary_message": "While the pot heats up, peel and mince ginger. Add to the bowl with the bell pepper. ",
            "secondary_message": null
          },
          {
            "id": 401831,
            "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add bell pepper, ginger, and spices; cook, stirring occasionally, until peppers soften, 2-3 minutes. ",
            "secondary_message": "2 tbsp butter, unsalted\n4 tsp curry powder\n4 tsp garam masala\n1 tsp garlic powder\n1 tsp salt"
          },
          {
            "id": 401832,
            "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into small bite-sized pieces. ",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 401833,
            "primary_message": "When the peppers are soft, add chicken, marinara sauce, cream, and water to the pot; stir to combine the curry and bring to a simmer. ",
            "secondary_message": "1 (24 oz) jar marinara sauce\n4 fl oz (½ cup) heavy whipping cream\n½ cup water"
          },
          {
            "id": 401834,
            "primary_message": "Once the curry is simmering, reduce heat to low and continue to cook, stirring occasionally, until chicken is cooked through, 8-10 minutes more. Remove from heat and cover to keep warm.",
            "secondary_message": null
          },
          {
            "id": 401835,
            "primary_message": "To serve, divide rice and curry between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
