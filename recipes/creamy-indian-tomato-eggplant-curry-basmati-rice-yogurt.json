  "instructions": [
    {
      "id": 430464,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 430465,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 430466,
      "primary_message": "Meanwhile, wash, dry, trim, and quarter eggplants lengthwise, then cut crosswise into ½-inch thick pieces. Place in a medium bowl.",
      "secondary_message": "2 eggplants"
    },
    {
      "id": 430467,
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl with the eggplant. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 430468,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 430469,
      "primary_message": "While the pot heats up, wash, dry, peel, and mince ginger. Add to the bowl. ",
      "secondary_message": "2 (1 inch) pieces ginger root"
    },
    {
      "id": 430470,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add eggplant, onion, ginger, and spices; cook, stirring occasionally, until eggplant softens, 3-5 minutes. ",
      "secondary_message": "3 tbsp virgin coconut oil\n4 tsp curry powder\n1 tsp garlic powder\n1 tsp salt"
    },
    {
      "id": 430471,
      "primary_message": "Add marinara sauce and cream to the pot; stir combine the curry and bring to a boil. Once boiling, reduce to a simmer and continue to cook, stirring occasionally, until eggplant is tender and curry thickens, 3-5 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": "1 (24 oz) jar marinara sauce\n8 fl oz (1 cup) heavy whipping cream"
    },
    {
      "id": 430472,
      "primary_message": "To serve, divide rice and curry between plates or bowls, then top with yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
