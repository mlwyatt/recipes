        "instructions": [
          {
            "id": 223781,
            "primary_message": "Fill a large pot halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1½ cups of pasta cooking water before draining.)",
            "secondary_message": "2 tsp salt\n10 oz linguine pasta"
          },
          {
            "id": 223782,
            "primary_message": "Meanwhile, trim off the root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch half-moons.",
            "secondary_message": "4 leeks"
          },
          {
            "id": 223783,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 223784,
            "primary_message": "While the skillet heats up, peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 223785,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add leeks and garlic; cook, stirring occasionally, until leeks are soft, about 10 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 223786,
            "primary_message": "Meanwhile, cut the cream cheese into small pieces and set aside.",
            "secondary_message": "1 (8 oz) block cream cheese"
          },
          {
            "id": 223787,
            "primary_message": "Roughly chop prosciutto into bite-sized pieces. Once the leeks have softened, add prosciutto to the skillet, and cook, stirring often, until slightly crispy, about 2 minutes.",
            "secondary_message": "8 slices prosciutto"
          },
          {
            "id": 223788,
            "primary_message": "Add cream cheese, peas, and ¾-cup of the pasta cooking water to the skillet. Reduce heat to low, and continue to cook, stirring often, until cream cheese is melted, 3-4 minutes.",
            "secondary_message": "1 cup frozen peas"
          },
          {
            "id": 223789,
            "primary_message": "Finely grate Parmesan and add to the skillet (reserving a small handful for garnish); stir to combine.",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 223790,
            "primary_message": "Add drained pasta to the skillet and toss to combine; add additional pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency.",
            "secondary_message": null
          },
          {
            "id": 223791,
            "primary_message": "To serve, divide pasta between bowls and garnish with remaining Parmesan. Enjoy!",
            "secondary_message": null
          }
        ],
