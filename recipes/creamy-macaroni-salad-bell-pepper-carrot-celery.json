        "instructions": [
          {
            "id": 386261,
            "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. ",
            "secondary_message": "½ tsp salt\n6 oz macaroni (elbow) pasta"
          },
          {
            "id": 386262,
            "primary_message": "Meanwhile, place yogurt, mayo, vinegar, Dijon, honey, and spices in a medium bowl. Whisk to combine the dressing.",
            "secondary_message": "½ cup plain Greek yogurt\n¼ cup mayonnaise\n1 tbsp red wine vinegar\n1 tbsp Dijon mustard\n2 tsp honey\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 386263,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 sticks celery\n2 medium carrots\n1 red bell pepper"
          },
          {
            "id": 386264,
            "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 386265,
            "primary_message": "Peel, trim, and small dice carrots. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 386266,
            "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 386267,
            "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl. Stir to combine the macaroni salad.",
            "secondary_message": null
          },
          {
            "id": 386268,
            "primary_message": "To serve, divide macaroni salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
