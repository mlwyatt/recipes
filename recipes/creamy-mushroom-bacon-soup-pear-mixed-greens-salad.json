        "instructions": [
          {
            "id": 27274,
            "primary_message": "Wash and slice the mushrooms.",
            "secondary_message": "1 lb white mushrooms"
          },
          {
            "id": 27275,
            "primary_message": "Peel and small dice the onion. Peel and mince the garlic.",
            "secondary_message": "1 medium yellow onion\r\n2 cloves garlic"
          },
          {
            "id": 27276,
            "primary_message": "Melt butter in a medium saucepan over medium heat. Add the mushrooms, onion, and garlic. Season with thyme, salt, and pepper. Cook, stirring occasionally, until tender, 5-6 minutes.",
            "secondary_message": "2 tbsp butter, unsalted\r\n½ tsp thyme\r\n1 tsp salt\r\n1 tsp black pepper"
          },
          {
            "id": 27277,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 27278,
            "primary_message": "Chop the bacon into smaller pieces. Add to the skillet and cook until crispy, 3-4 minutes.",
            "secondary_message": "8 slices bacon\r\n"
          },
          {
            "id": 27279,
            "primary_message": "Sprinkle cornstarch over the mushrooms and stir to coat.",
            "secondary_message": "2 tbsp cornstarch\r\n"
          },
          {
            "id": 27280,
            "primary_message": "Pour in the broth and cream. Stir well and bring the soup to a simmer. Cook until thickened, 1-2 minutes.",
            "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n4 fl oz (½ cup) heavy cream"
          },
          {
            "id": 27281,
            "primary_message": "Wash and dry the greens.",
            "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\r\n"
          },
          {
            "id": 27282,
            "primary_message": "Wash, core, and thinly slice the pears.",
            "secondary_message": "2 pears\r\n"
          },
          {
            "id": 27283,
            "primary_message": "Purée the soup with an immersion (hand) blender or regular blender if desired. Otherwise, leave as is.",
            "secondary_message": ""
          },
          {
            "id": 27284,
            "primary_message": "Arrange a bed of greens on a plate, top with pear slices, and drizzle with olive oil. Pour soup into a bowl and sprinkle with bacon. Enjoy!",
            "secondary_message": "4 tbsp extra virgin olive oil\r\n"
          }
        ],
