        "instructions": [
          {
            "id": 433413,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 433414,
            "primary_message": "Meanwhile, wash, dry, and pick sage leaves off the stems; discard stems.",
            "secondary_message": "1 small pkg fresh sage"
          },
          {
            "id": 433415,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sage leaves in single layer and cook until crispy, about 30 seconds. Using tongs or a slotted spoon, transfer crispy sage to a paper towel-lined plate and season with salt. (Reserve skillet with oil for later use.)",
            "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt"
          },
          {
            "id": 433416,
            "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 433417,
            "primary_message": "Return skillet to medium-high heat. Once the skillet is hot, add chicken and pan-fry, without turning, until golden underneath, 5-6 minutes (the chicken will not be cooked all the way through). Remove to a plate. (Reserve skillet with sage oil for later use.)",
            "secondary_message": null
          },
          {
            "id": 433418,
            "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 433419,
            "primary_message": "Finely grate Parmesan.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 433420,
            "primary_message": "Return skillet with sage oil to medium heat, add more oil, and swirl to coat the bottom. Add garlic and tomato paste; cook, stirring constantly, until fragrant, 15-30 seconds.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tbsp tomato paste"
          },
          {
            "id": 433421,
            "primary_message": "Add Parmesan, pumpkin, broth, cream, and salt to the skillet, then stir to combine. Cook, stirring occasionally, until sauce thickens slightly, 2-3 minutes.",
            "secondary_message": "1 (15 oz) can pure pumpkin purée\n8 fl oz (1 cup) chicken or vegetable broth\n8 fl oz (1 cup) heavy whipping cream\n½ tsp salt"
          },
          {
            "id": 433422,
            "primary_message": "Wash, dry, and add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
            "secondary_message": "2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 433423,
            "primary_message": "Return chicken to the skillet and nestle into the sauce; cover with a lid. Cook, turning chicken occasionally, until cooked through, 5-7 minutes. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 433424,
            "primary_message": "To serve, divide chicken and sauce between plates or bowls. Top with crispy sage and enjoy!",
            "secondary_message": null
          }
        ],
