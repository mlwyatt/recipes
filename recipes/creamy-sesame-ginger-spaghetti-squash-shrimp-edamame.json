        "instructions": [
          {
            "id": 472303,
            "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
            "secondary_message": null
          },
          {
            "id": 472304,
            "primary_message": "Wash, dry, and trim each spaghetti squash, then halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt. Arrange halves, cut-side down, on the baking sheet.",
            "secondary_message": "2 medium spaghetti squash\n2 tsp toasted sesame oil\n1 tsp salt"
          },
          {
            "id": 472305,
            "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 472306,
            "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a small bowl along with tahini, water, oil, vinegar, soy sauce, and maple syrup. Whisk to combine the sauce and set aside.",
            "secondary_message": "2 (1 inch) pieces ginger root\n⅓ cup tahini\n¼ cup water\n¼ cup toasted sesame oil\n¼ cup rice vinegar\n2 tbsp soy sauce\n1 tbsp pure maple syrup"
          },
          {
            "id": 472307,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 472308,
            "primary_message": "When the squash has about 5 minutes left, preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 472309,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper. Cook, stirring occasionally, until shrimp are just opaque, 2-3 minutes. Remove to a plate. (Set skillet aside for later use.)",
            "secondary_message": "1 tbsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 472310,
            "primary_message": "Meanwhile, place edamame in a clean colander and rinse under hot, running water (from the tap) to defrost; set aside to drain. ",
            "secondary_message": "1 ⅓ cups edamame"
          },
          {
            "id": 472311,
            "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 472312,
            "primary_message": "Scrape the inside of the squash with a fork to separate into spaghetti-like strands (use an oven mitt or towel to hold it with your other hand). ",
            "secondary_message": null
          },
          {
            "id": 472313,
            "primary_message": "Return skillet to medium heat. Once the skillet is hot, add sesame-ginger sauce, spaghetti squash, and edamame. Cook, tossing occasionally, until warmed through, 2-3 minutes. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 472314,
            "primary_message": "To serve, divide spaghetti squash, shrimp, and edamame between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
