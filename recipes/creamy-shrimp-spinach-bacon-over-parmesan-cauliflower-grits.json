        "instructions": [
          {
            "id": 291355,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 medium head cauliflower\n1 (5 oz) pkg baby spinach\n1 lemon"
          },
          {
            "id": 291356,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 291357,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 291358,
            "primary_message": "While the skillet heats up, medium dice bacon.",
            "secondary_message": "8 slices bacon"
          },
          {
            "id": 291359,
            "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 3-4 minutes. Using a slotted spoon, transfer crispy bacon to a paper towel-lined plate (leaving the drippings in the skillet). Set skillet aside for later use.",
            "secondary_message": null
          },
          {
            "id": 291360,
            "primary_message": "Meanwhile, finely grate Parmesan and set aside.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 291361,
            "primary_message": "Using a clean cutting board, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower and place in a medium saucepan.",
            "secondary_message": null
          },
          {
            "id": 291362,
            "primary_message": "Add hot water (from the tap) to the pan with the cauliflower, filling it about halfway; cover and bring to a boil over medium-high heat. Once the water is boiling, reduce heat to medium and simmer until the cauliflower is tender, 8-10 minutes.",
            "secondary_message": null
          },
          {
            "id": 291363,
            "primary_message": "Meanwhile, peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 291364,
            "primary_message": "Return the skillet (with bacon drippings) to medium-low heat. Once the skillet is hot, add garlic and cook, stirring constantly, until fragrant, about 30 seconds. ",
            "secondary_message": null
          },
          {
            "id": 291365,
            "primary_message": "Add cream, shrimp, and spices to the skillet; cook, stirring occasionally, until the shrimp is just opaque, 3-4 minutes.",
            "secondary_message": "4 fl oz (½ cup) heavy whipping cream\n1 tsp salt\n½ tsp black pepper\n⅛ tsp cayenne pepper"
          },
          {
            "id": 291366,
            "primary_message": "When the cauliflower is done, drain in a strainer and return to the pan. Add Parmesan, butter, salt, and pepper. Using a potato masher, gently mash the cauliflower into a \"grits\" consistency; cover and set aside.",
            "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 291367,
            "primary_message": "When the shrimp is done, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Juice lemon into the skillet, stir to combine, and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 291368,
            "primary_message": "To serve, divide cauliflower \"grits\" and creamy shrimp between bowls; top with bacon and enjoy!",
            "secondary_message": null
          }
        ],
