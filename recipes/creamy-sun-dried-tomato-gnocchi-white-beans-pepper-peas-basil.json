        "instructions": [
          {
            "id": 281166,
            "primary_message": "Drain and rinse beans; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 281167,
            "primary_message": "Wash and dry bell peppers, then trim, seed, and small dice. Place in a small bowl.",
            "secondary_message": "2 yellow bell peppers"
          },
          {
            "id": 281168,
            "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the bell pepper.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 281169,
            "primary_message": "Mince sun-dried tomatoes and add to the bowl.",
            "secondary_message": "8 sun-dried tomatoes, oil-packed"
          },
          {
            "id": 281170,
            "primary_message": "Preheat a large pot over medium-high heat. ",
            "secondary_message": null
          },
          {
            "id": 281171,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies to the pot; cook, stirring frequently, until softened, 4-5 minutes. (Reserve bowl for next step.)",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 281172,
            "primary_message": "Meanwhile, place water and cornstarch in the reserved bowl; whisk to combine the slurry.",
            "secondary_message": "2 tbsp water\n4 tsp cornstarch"
          },
          {
            "id": 281173,
            "primary_message": "When the veggies are soft, add cornstarch slurry, almond milk, nutritional yeast, salt, and pepper to the pot; stir to combine and bring to a simmer. Once simmering, cook, stirring occasionally, until sauce thickens, 3-4 minutes.",
            "secondary_message": "16 fl oz (2 cups) almond milk, unsweetened\n¼ cup nutritional yeast flakes\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 281174,
            "primary_message": "While the sauce simmers, wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": "2 small pkgs fresh basil"
          },
          {
            "id": 281175,
            "primary_message": "Add beans, gnocchi, peas, and half of the basil to the pot (reserve remaining basil for garnish). Continue to cook, stirring occasionally, until warmed through, 4-5 minutes more.",
            "secondary_message": "2 (16 oz) pkg potato gnocchi\n2 cups frozen peas"
          },
          {
            "id": 281176,
            "primary_message": "To serve, divide creamy gnocchi between bowls. Top with remaining basil and enjoy!",
            "secondary_message": null
          }
        ],
