        "instructions": [
          {
            "id": 375975,
            "primary_message": "Drain and mince capers. Place in a medium bowl along with yogurt, mayo, and spices. Stir to combine the dressing.",
            "secondary_message": "1 tbsp capers\n¼ cup plain Greek yogurt\n3 tbsp mayonnaise\n½ tsp dill, dried\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 375976,
            "primary_message": "Peel and mince shallot. Add to the bowl with the dressing.",
            "secondary_message": "½ shallot"
          },
          {
            "id": 375977,
            "primary_message": "Wash, dry, trim, and small dice celery. Add to the bowl.",
            "secondary_message": "1 stick celery"
          },
          {
            "id": 375978,
            "primary_message": "Drain tuna, add to the bowl, and flake with a fork. Stir to combine the tuna salad.",
            "secondary_message": "2 (6 oz) cans chunk light tuna in water"
          },
          {
            "id": 375979,
            "primary_message": "Divide tuna salad between plates and serve with chips. Enjoy!",
            "secondary_message": "4 oz tortilla chips"
          }
        ],
