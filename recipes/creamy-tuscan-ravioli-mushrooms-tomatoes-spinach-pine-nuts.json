  "instructions": [
    {
      "id": 374597,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "1 tsp salt\n18 oz cheese ravioli, fresh or frozen"
    },
    {
      "id": 374598,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 374599,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 374600,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add garlic and cook until fragrant, about 30 seconds.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 374601,
      "primary_message": "Add mushrooms to the skillet and cook, stirring occasionally, until golden brown, 3-4 minutes.",
      "secondary_message": "2 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 374602,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 374603,
      "primary_message": "Wash and dry the spinach. (Skip if it came pre-washed.)",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 374604,
      "primary_message": "When the mushrooms are done, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 374605,
      "primary_message": "Add tomatoes and spices to the skillet, then stir to combine. Continue to cook, stirring occasionally, until tomatoes begin to soften, 3-4 minutes.",
      "secondary_message": "1 tsp Italian seasoning\n½ tsp crushed red pepper\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 374606,
      "primary_message": "Add ravioli and Alfredo sauce to the skillet. Continue to cook, stirring occasionally, until sauce is warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "1 (16 oz) jar Alfredo sauce"
    },
    {
      "id": 374607,
      "primary_message": "To serve, divide ravioli and sauce between plates or bowls. Sprinkle with pine nuts and enjoy!",
      "secondary_message": "¼ cup pine nuts"
    }
  ],
