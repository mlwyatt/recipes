  "instructions": [
    {
      "id": 247857,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium zucchini squash\n1 pint grape tomatoes\n2 (5 oz) pkgs baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 247858,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 247859,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 247860,
      "primary_message": "While the skillet heats up, small dice bacon. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 247861,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": null
    },
    {
      "id": 247862,
      "primary_message": "Meanwhile, trim zucchini and use a julienne (or regular) peeler to make noodles. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 247863,
      "primary_message": "Halve the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 247864,
      "primary_message": "Return skillet (with bacon drippings) to medium heat; add tomatoes and spices to the skillet. Cook, stirring occasionally, until tomatoes soften, 3-4 minutes.",
      "secondary_message": "1 tsp Italian seasoning\n½ tsp crushed red pepper\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 247865,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 247866,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 247867,
      "primary_message": "Add garlic and shrimp to the skillet; cook until shrimp are opaque, 1-2 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 247868,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 247869,
      "primary_message": "Add zucchini noodles, Parmesan (reserving a small handful for garnish), and cream to the skillet; stir to combine. Cook, stirring occasionally, until the sauce is melted and combined, 1-2 minutes.",
      "secondary_message": "8 fl oz (1 cup) heavy whipping cream"
    },
    {
      "id": 247870,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half the to skillet (reserving the rest for garnish) and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 247871,
      "primary_message": "To serve, divide shrimp, veggies, and sauce between bowls. Top with bacon and remaining Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
