  "instructions": [
    {
      "id": 216722,
      "primary_message": "Place a large pot over high heat. Add broth, cover, and bring to a boil.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 216723,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n4 medium red potatoes\n1 small pkg fresh thyme"
    },
    {
      "id": 216724,
      "primary_message": "Place cashews in a medium bowl. Carefully pour boiling broth over the cashews and set aside to soak for 15 minutes. Reserve pot for later use.",
      "secondary_message": "1 cup cashews, roasted unsalted"
    },
    {
      "id": 216725,
      "primary_message": "Peel and mince garlic. Peel and small dice onion. Transfer both to a large bowl.",
      "secondary_message": "4 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 216726,
      "primary_message": "Peel and small dice carrots. Trim and small dice celery. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 216727,
      "primary_message": "Medium dice potatoes. Add to the bowl along with corn and peas.",
      "secondary_message": "1 cup frozen corn\n1 cup frozen peas"
    },
    {
      "id": 216728,
      "primary_message": "Return pot to medium heat.",
      "secondary_message": null
    },
    {
      "id": 216729,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 216730,
      "primary_message": "Add veggies to the pot and cook, stirring occasionally, until starting to soften, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 216731,
      "primary_message": "Meanwhile, slide thyme leaves off the stems; discard stems.",
      "secondary_message": null
    },
    {
      "id": 216732,
      "primary_message": "Add broth, half the thyme (reserving the rest for garnish), and spices to the pot.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n2 tsp Italian seasoning\n2 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 216733,
      "primary_message": "Drain and rinse beans; add to the pot.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 216734,
      "primary_message": "Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, until potatoes are fork-tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 216735,
      "primary_message": "Meanwhile, transfer the cashew-broth mixture to a blender and purée until smooth.",
      "secondary_message": null
    },
    {
      "id": 216736,
      "primary_message": "Add cashew cream to the pot and stir to combine. Cook, stirring occasionally, until soup begins to thicken, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 216737,
      "primary_message": "To serve, divide soup between bowls. Top with reserved thyme and enjoy!",
      "secondary_message": null
    }
  ],
