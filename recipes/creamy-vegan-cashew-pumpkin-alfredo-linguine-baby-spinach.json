        "instructions": [
          {
            "id": 209997,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "2 tsp salt\n10 oz linguine pasta"
          },
          {
            "id": 209998,
            "primary_message": "Meanwhile, place cashews in a small bowl. Using a measuring cup, carefully remove 2 cups of boiling water from the pot and pour over the cashews; let sit for 15 minutes.",
            "secondary_message": "1 cup cashews, roasted unsalted"
          },
          {
            "id": 209999,
            "primary_message": "Peel and slice garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 210000,
            "primary_message": "Once cashews are done soaking, drain and return to the bowl.",
            "secondary_message": null
          },
          {
            "id": 210001,
            "primary_message": "Add garlic, cashews, pumpkin, broth, nutritional yeast, flour, and spices to a blender and purée until smooth. (If necessary, work in batches to best fit your blender.)",
            "secondary_message": "1 (15 oz) can pure pumpkin purée\n12 fl oz (1 ½ cups) chicken or vegetable broth\n¼ cup nutritional yeast flakes\n4 tsp all-purpose flour\n1 tsp salt\n¼ tsp black pepper\n⅛ tsp nutmeg, ground"
          },
          {
            "id": 210002,
            "primary_message": "Wash and dry the spinach. (Skip this step if it came pre-washed.)",
            "secondary_message": "2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 210003,
            "primary_message": "Drain pasta and set aside to drain further.",
            "secondary_message": null
          },
          {
            "id": 210004,
            "primary_message": "Return pot to medium heat. Add the sauce from the blender and bring to a simmer.",
            "secondary_message": null
          },
          {
            "id": 210005,
            "primary_message": "Once simmering, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
            "secondary_message": null
          },
          {
            "id": 210006,
            "primary_message": "Add pasta, stir to combine, and cook, stirring occasionally, until warmed through, 3-4 minutes.",
            "secondary_message": null
          },
          {
            "id": 210007,
            "primary_message": "Divide pasta between bowls and enjoy!",
            "secondary_message": null
          }
        ],
