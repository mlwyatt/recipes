        "instructions": [
          {
            "id": 148396,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "2 tsp salt\n12 oz fettuccine pasta"
          },
          {
            "id": 148397,
            "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 148398,
            "primary_message": "Peel and small dice the onions.",
            "secondary_message": "2 medium yellow onions"
          },
          {
            "id": 148399,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 148400,
            "primary_message": "Add the onions to the skillet; cook, stirring frequently, until softened, 4-5 minutes.",
            "secondary_message": null
          },
          {
            "id": 148401,
            "primary_message": "Wash and slice mushrooms. Peel and mince garlic.",
            "secondary_message": "1 ½ lb white mushrooms\n4 cloves garlic"
          },
          {
            "id": 148402,
            "primary_message": "Add mushrooms, garlic, and spices to the skillet. Cook, stirring frequently, until mushrooms are softened, 5-6 minutes.",
            "secondary_message": "1 tsp garlic powder\n1 tsp onion powder\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 148403,
            "primary_message": "In a medium bowl, whisk together the coconut milk and cornstarch.",
            "secondary_message": "1 (13.5 fl oz) can coconut milk\n¼ cup cornstarch"
          },
          {
            "id": 148404,
            "primary_message": "Add coconut milk mixture, broth, soy sauce, and vinegar to the skillet. Stir and bring to a boil over high heat. Reduce heat to medium-low and cook, stirring occasionally, until the sauce has thickened, 6-7 minutes.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 tbsp soy sauce\n1 tbsp balsamic vinegar"
          },
          {
            "id": 148405,
            "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems. Add leaves to the skillet and stir to combine.",
            "secondary_message": "1 small pkg fresh thyme"
          },
          {
            "id": 148406,
            "primary_message": "Wash and dry the spinach (skip if it came pre-washed). Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
            "secondary_message": "1 (5 oz) pkg baby spinach"
          },
          {
            "id": 148407,
            "primary_message": "Drain pasta and add to skillet with the sauce. Toss to combine.",
            "secondary_message": null
          },
          {
            "id": 148408,
            "primary_message": "To serve, divide the pasta and sauce between plates. Enjoy!",
            "secondary_message": null
          }
        ],
