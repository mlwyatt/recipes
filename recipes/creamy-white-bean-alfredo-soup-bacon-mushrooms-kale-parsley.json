  "instructions": [
    {
      "id": 380534,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 380535,
      "primary_message": "While the pot heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 380536,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until golden, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 380537,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further. ",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 380538,
      "primary_message": "When the bacon is done, add mushrooms to the pot. Cook, stirring occasionally, until softened, about 3 minutes. ",
      "secondary_message": "2 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 380539,
      "primary_message": "Add beans, broth, Alfredo sauce, and spices to the pot. Stir to combine the soup and bring to a boil over medium-high heat. ",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 (16 oz) jar Alfredo sauce\n2 tsp Italian seasoning\n1 tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 380540,
      "primary_message": "Once boiling, add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Reduce heat to low and continue to cook until beans and kale are tender, about 5 minutes.",
      "secondary_message": "1 (10 oz) bag kale, cut and ready to use"
    },
    {
      "id": 380541,
      "primary_message": "Meanwhile, using a clean cutting board, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 380542,
      "primary_message": "When the soup is done, remove from heat, add parsley, and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 380543,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
