  "instructions": [
    {
      "id": 367850,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg chives\n1 lime\n4 Granny Smith apples"
    },
    {
      "id": 367851,
      "primary_message": "Mince chives and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 367852,
      "primary_message": "Juice lime into the bowl with the chives.",
      "secondary_message": null
    },
    {
      "id": 367853,
      "primary_message": "Add yogurt, mayo, and spices to the bowl. Whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tsp parsley flakes\n½ tsp dill, dried\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 367854,
      "primary_message": "Quarter and core apples; cut into matchsticks or coarsely grate. Add to the bowl with the dressing, along with the broccoli slaw, and stir to combine. Set aside.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 367855,
      "primary_message": "Crack eggs into another medium bowl and beat with a whisk or fork.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 367856,
      "primary_message": "Place bread crumbs on a plate.",
      "secondary_message": "1 ½ cup panko bread crumbs"
    },
    {
      "id": 367857,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chops in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 367858,
      "primary_message": "Dip the seasoned cutlets into the beaten egg (letting the excess drip off), then into the bread crumbs, pressing to adhere. Transfer to another plate.",
      "secondary_message": null
    },
    {
      "id": 367859,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 367860,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the breaded cutlets and cook until golden brown and cooked through, 2-3 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 367861,
      "primary_message": "To serve, divide pork schnitzel and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
