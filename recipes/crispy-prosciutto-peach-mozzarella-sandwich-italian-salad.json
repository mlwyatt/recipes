  "instructions": [
    {
      "id": 350766,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 350767,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 peaches\n2 tomatoes\n2 hearts romaine hearts"
    },
    {
      "id": 350768,
      "primary_message": "Divide prosciutto between two baking sheet pans and arrange in an single layer. Working in batches, place in the oven and broil until crispy, 2-3 minutes. Remove from oven.",
      "secondary_message": "16 slices prosciutto"
    },
    {
      "id": 350769,
      "primary_message": "Meanwhile, quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Cut each quarter into thin wedges and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 350770,
      "primary_message": "Thinly slice tomatoes, then season with salt and pepper; add to the plate with the peach.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 350771,
      "primary_message": "Thinly slice mozzarella into rounds; add to the plate.",
      "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 350772,
      "primary_message": "Add one lettuce leaf per sandwich to the plate and set aside. Chop or tear remaining lettuce into bite-sized pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 350773,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the lettuce and set aside.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 350774,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 350775,
      "primary_message": "Spread mayo over each bread slice. Layer half of the slices with lettuce, tomato, mozzarella, peach, and crispy prosciutto. Close with remaining bread slices.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "id": 350776,
      "primary_message": "Add dressing to the bowl with the lettuce and artichokes; toss to combine the salad.",
      "secondary_message": "¼ cup Italian salad dressing"
    },
    {
      "id": 350777,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
