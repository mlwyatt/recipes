        "instructions": [
          {
            "id": 469059,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 469060,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium beets\n1 lemon\n1 bunch kale"
          },
          {
            "id": 469061,
            "primary_message": "Peel and trim beets; halve lengthwise, then slice into ¼-inch thick wedges. Transfer to one half of a large baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 469062,
            "primary_message": "Slice tempeh crosswise into ½-inch thick strips. Add to the other half of the baking sheet, then drizzle with soy sauce and oil. Season with pepper, then toss to coat and spread out in an even layer.",
            "secondary_message": "2 (8 oz) packages tempeh\n2 tsp soy sauce\n2 tsp extra virgin olive oil\n⅛ tsp black pepper"
          },
          {
            "id": 469063,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring each halfway through, until beets are tender and tempeh is crisp, about 20 minutes. Remove baking sheet from oven; season tempeh with additional soy sauce and toss to coat.",
            "secondary_message": "2 tsp soy sauce"
          },
          {
            "id": 469064,
            "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
          },
          {
            "id": 469065,
            "primary_message": "While the couscous is cooking, juice lemon into a small bowl, then add mayo, oil, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing and set aside.",
            "secondary_message": "⅓ cup mayonnaise\n2 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 469066,
            "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a medium bowl. ",
            "secondary_message": null
          },
          {
            "id": 469067,
            "primary_message": "Add half of the dressing to the bowl with the kale and, using your hands, massage kale with the dressing until wilted, 1-2 minutes. (Reserve remaining dressing for serving.)",
            "secondary_message": null
          },
          {
            "id": 469068,
            "primary_message": "To serve, divide couscous between bowls; top with kale, beets, and crispy tempeh. Drizzle with reserved dressing and enjoy!",
            "secondary_message": null
          }
        ],
