        "instructions": [
          {
            "id": 289532,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 289533,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 English cucumber\n2 red bell peppers\n1 small bunch cilantro\n1 small pkg fresh mint\n1 small bunch green onions (scallions)"
          },
          {
            "id": 289534,
            "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons; place in a large bowl. ",
            "secondary_message": null
          },
          {
            "id": 289535,
            "primary_message": "Trim, seed, and slice bell peppers lengthwise into strips. Add to the bowl with the cucumber.",
            "secondary_message": null
          },
          {
            "id": 289536,
            "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 289537,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 289538,
            "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 289539,
            "primary_message": "Roughly chop peanuts and add to the bowl along with the broccoli slaw. Set aside.",
            "secondary_message": "½ cup peanuts, roasted unsalted\n2 (12 oz) pkg broccoli slaw"
          },
          {
            "id": 289540,
            "primary_message": "Place bread crumbs and cornstarch in a small bowl; stir to combine.",
            "secondary_message": "¼ cup panko bread crumbs\n4 tsp cornstarch"
          },
          {
            "id": 289541,
            "primary_message": "Cut the tofu into ½-inch thick planks along the short side. Working in batches, roll tofu in the breadcrumb mixture, pressing gently to adhere; transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 289542,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 289543,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add breaded tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes. Return crispy tofu to the plate.",
            "secondary_message": "¼ cup extra virgin olive oil"
          },
          {
            "id": 289544,
            "primary_message": "Meanwhile, place vinegar, soy sauce, oil, sugar, and chili-garlic sauce in a small saucepan; stir to combine and bring the dressing to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until slightly thickened, about 3 minutes. Remove from heat.",
            "secondary_message": "⅓ cup rice vinegar\n¼ cup soy sauce\n2 tbsp extra virgin olive oil\n2 tbsp brown sugar\n2 tsp chili-garlic sauce"
          },
          {
            "id": 289545,
            "primary_message": "Add half of the dressing to the bowl with the salad and toss to combine. (Reserve remaining dressing for serving.)",
            "secondary_message": null
          },
          {
            "id": 289546,
            "primary_message": "To serve, divide salad and crispy tofu between bowls. Drizzle with remaining dressing and enjoy!",
            "secondary_message": null
          }
        ],
