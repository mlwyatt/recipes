        "instructions": [
          {
            "id": 104585,
            "primary_message": "Add salt and water to the saucepan, cover, and bring to a boil over high heat. Once boiling, stir in oats and maple syrup. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency.",
            "secondary_message": "⅛ tsp salt\n3 ½ cup water\n2 cup oats, quick cooking\n4 tsp pure maple syrup"
          },
          {
            "id": 104586,
            "primary_message": "Wash and dry apples, then core and medium dice.",
            "secondary_message": "2 Gala apples"
          },
          {
            "id": 104587,
            "primary_message": "Roughly chop peanuts.",
            "secondary_message": "½ cup peanuts, roasted unsalted"
          },
          {
            "id": 104588,
            "primary_message": "When oats are done, stir in peanut butter.",
            "secondary_message": "¼ cup natural peanut butter"
          },
          {
            "id": 104589,
            "primary_message": "To serve, divide oats between bowls and top with chopped apples and peanuts. Enjoy!",
            "secondary_message": null
          }
        ],
