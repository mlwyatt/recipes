        "instructions": [
          {
            "id": 227241,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water, turmeric, and salt; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n2 cup water\n1 tsp turmeric, ground\n½ tsp salt"
          },
          {
            "id": 227242,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 227243,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 English cucumber\n2 tomatoes\n1 lemon"
          },
          {
            "id": 227244,
            "primary_message": "Trim and medium dice cucumber; transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 227245,
            "primary_message": "Medium dice tomatoes and add to the bowl with the cucumber.",
            "secondary_message": null
          },
          {
            "id": 227246,
            "primary_message": "Peel and small dice onion; add to the bowl.",
            "secondary_message": "½ medium red onion"
          },
          {
            "id": 227247,
            "primary_message": "Juice lemon into the bowl, drizzle with oil, and season with spices. Stir to combine the salad and set aside. ",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 227248,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 227249,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp cumin, ground\n¼ tsp coriander, ground"
          },
          {
            "id": 227250,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 227251,
            "primary_message": "Meanwhile, place mayo, vinegar, and spices in a small bowl. Whisk to combine the garlic sauce. ",
            "secondary_message": "¼ cup mayonnaise\n2 tsp apple cider vinegar\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 227252,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 227253,
            "primary_message": "Divide rice, salad, and steak between plates. Serve with garlic sauce on the side and enjoy!",
            "secondary_message": null
          }
        ],
