        "instructions": [
          {
            "id": 400697,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 400698,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 400699,
            "primary_message": "Meanwhile, place oil and spices in a medium bowl. Stir to combine the spice oil.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp curry powder\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 400700,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "1 medium head cauliflower\n1 small pkg fresh mint\n1 English cucumber\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 400701,
            "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the spice oil and stir to coat. Transfer to a baking sheet pan and spread out in an even layer. ",
            "secondary_message": null
          },
          {
            "id": 400702,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is fork-tender, 15-20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 400703,
            "primary_message": "While the cauliflower is roasting, pick mint leaves off the stems; discard stems and mince the leaves. Place half of the mint in a small bowl. (Reserve remaining mint for serving.)",
            "secondary_message": null
          },
          {
            "id": 400704,
            "primary_message": "Add yogurt, tahini, water, vinegar, additional garlic powder, and salt to the bowl with the mint. Whisk to combine the sauce and set aside.",
            "secondary_message": "⅔ cup plain Greek yogurt\n¼ cup tahini\n3 tbsp water\n2 tbsp apple cider vinegar\n½ tsp garlic powder\n½ tsp salt"
          },
          {
            "id": 400705,
            "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 400706,
            "primary_message": "Roughly chop pistachios.",
            "secondary_message": "1 cup pistachios, unsalted"
          },
          {
            "id": 400707,
            "primary_message": "To serve, divide quinoa, cauliflower, arugula, and cucumber between bowls. Drizzle with sauce, then top with pistachios and reserved mint. Enjoy!",
            "secondary_message": null
          }
        ],
