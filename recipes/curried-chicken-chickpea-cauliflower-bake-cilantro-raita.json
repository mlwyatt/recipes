  "instructions": [
    {
      "id": 390521,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 390522,
      "primary_message": "Place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup rice vinegar\n1 ½ tsp honey\n1 tsp salt"
    },
    {
      "id": 390523,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 390524,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 English cucumber\n2 limes\n1 small bunch cilantro"
    },
    {
      "id": 390525,
      "primary_message": "Drain and rinse chickpeas. Transfer to a large baking sheet pan and pat dry with paper towels.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 390526,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the baking sheet with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 390527,
      "primary_message": "Pat the chicken thighs dry with paper towels and cut into bite-sized pieces. Add to the baking sheet, drizzle with oil, then season with curry powder and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 ½ lb chicken thighs, boneless skinless\n2 tbsp extra virgin olive oil\n2 tbsp curry powder\n1 tsp salt"
    },
    {
      "id": 390528,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until chickpeas are crisp, cauliflower is fork-tender, and chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 390529,
      "primary_message": "Meanwhile, using a clean cutting board, peel, trim, and grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 390530,
      "primary_message": "Juice one lime into the bowl with the cucumber. Cut remaining lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 390531,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt, additional honey, crushed red pepper, and salt; stir to combine the raita.",
      "secondary_message": "2 cups plain Greek yogurt\n4 tsp honey\n½ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 390532,
      "primary_message": "Divide chicken bake between plates or bowls; top with pickled onion. Serve with raita on the side and enjoy!",
      "secondary_message": null
    }
  ],
