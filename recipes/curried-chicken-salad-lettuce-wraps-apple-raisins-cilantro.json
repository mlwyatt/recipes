  "instructions": [
    {
      "id": 293614,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n2 Gala apples\n1 small bunch cilantro\n1 head butter (Boston) lettuce"
    },
    {
      "id": 293615,
      "primary_message": "Peel and mince shallot; place in a medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 293616,
      "primary_message": "Add yogurt, mayo, curry powder, and salt to the bowl with the shallot; whisk to combine the dressing.",
      "secondary_message": "⅔ cup plain Greek yogurt\n½ cup mayonnaise\n2 tbsp curry powder\n½ tsp salt"
    },
    {
      "id": 293617,
      "primary_message": "Trim and small dice celery; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 293618,
      "primary_message": "Quarter, core, and small dice apples; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 293619,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 293620,
      "primary_message": "Add raisins to the bowl.",
      "secondary_message": "½ cup raisins"
    },
    {
      "id": 293621,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, add to the bowl, and stir to combine the chicken salad.",
      "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 293622,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with chicken salad and enjoy!",
      "secondary_message": null
    }
  ],
