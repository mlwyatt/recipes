        "instructions": [
          {
            "id": 211455,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n2 sticks celery\n1 small bunch green onions (scallions)\n1 small bunch fresh dill\n2 tomatoes\n1 head butter (Boston) lettuce"
          },
          {
            "id": 211456,
            "primary_message": "Juice lemon into a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 211457,
            "primary_message": "Drain and rinse chickpeas. Transfer half of the chickpeas to the bowl with the lemon juice, along with mayonnaise and spices. Using a fork or potato masher, mash until smooth.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n¼ cup vegan mayonnaise\n1 tsp curry powder\n½ tsp turmeric\n½ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
          },
          {
            "id": 211458,
            "primary_message": "Add remaining chickpeas to the bowl and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 211459,
            "primary_message": "Small dice celery and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 211460,
            "primary_message": "Trim off and discard ends of the green onions; cut crosswise into ¼-inch pieces and transfer to the bowl.",
            "secondary_message": null
          },
          {
            "id": 211461,
            "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the chickpea salad.",
            "secondary_message": null
          },
          {
            "id": 211462,
            "primary_message": "Warm flatbreads in a skillet, oven, or toaster (optional).",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 211463,
            "primary_message": "Meanwhile, slice tomatoes into rounds.",
            "secondary_message": null
          },
          {
            "id": 211464,
            "primary_message": "Divide lettuce and tomato slices between flatbreads and season with salt and pepper. Top with curried chickpea salad.",
            "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 211465,
            "primary_message": "To make wraps easier to eat, place flatbreads on individual squares of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise eat as is and get a little messy! Enjoy!",
            "secondary_message": null
          }
        ],
