  "instructions": [
    {
      "id": 489579,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 avocado\n1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 489580,
      "primary_message": "Trim and small dice celery. Place in a medium bowl along with mayo, Dijon, and spices. Stir to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n2 tsp Dijon mustard\n1 tsp dill, dried\n½ tsp curry powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 489581,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 489582,
      "primary_message": "Roughly chop eggs. Add to the bowl and stir to combine the egg salad.",
      "secondary_message": "6 hard-cooked eggs, peeled"
    },
    {
      "id": 489583,
      "primary_message": "Cut pita in half and carefully open the pockets. Divide egg salad and sprouts between pockets.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 489584,
      "primary_message": "To serve, divide pita pockets between plates and enjoy!",
      "secondary_message": null
    }
  ],
