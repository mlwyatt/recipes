  "instructions": [
    {
      "id": 317137,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 317138,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small head red cabbage\n2 Granny Smith apples\n2 yellow bell peppers"
    },
    {
      "id": 317139,
      "primary_message": "Once the pan is hot, coat with oil; add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 pork sausages"
    },
    {
      "id": 317140,
      "primary_message": "While the sausages are cooking, place ketchup, water, Worcestershire, vinegar, and spices in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup ketchup\n2 tbsp water\n2 tsp Worcestershire sauce\n2 tsp apple cider vinegar\n2 tsp curry powder\n1 tsp garlic powder\n½ tsp paprika\n½ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 317141,
      "primary_message": "Juice lemon into a large bowl; add yogurt, mayo, and spices. Whisk to combine the dressing. ",
      "secondary_message": "¼ cup plain Greek yogurt\n4 tsp mayonnaise\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 317142,
      "primary_message": "Quarter cabbage lengthwise, then cut out and discard the core; slice crosswise into thin (shred-like) strips and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 317143,
      "primary_message": "Quarter, core, and small dice apples; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 317144,
      "primary_message": "Trim, halve, seed, and slice bell peppers into thin strips; add to the bowl and toss to combine the slaw. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 317145,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 317146,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 317147,
      "primary_message": "Place tortillas on a flat surface and top each with a small portion of slaw; arrange sausage slices on top and drizzle with sauce. Roll tightly to close. (Reserve remaining slaw for serving.)",
      "secondary_message": null
    },
    {
      "id": 317148,
      "primary_message": "Cut wraps in half and divide between plates; serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
