        "instructions": [
          {
            "id": 475985,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 475986,
            "primary_message": "While the pot heats up, wash, dry, trim, and cut green onions crosswise into thin pieces.",
            "secondary_message": "1 small bunch green onions (scallions)"
          },
          {
            "id": 475987,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add half of the green onions (reserving the rest for serving), shredded carrots, and spices; cook, stirring occasionally, until veggies soften, 3-4 minutes.",
            "secondary_message": "3 tbsp extra virgin olive oil\n1 (10 oz) bag shredded carrots\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 475988,
            "primary_message": "Meanwhile, drain sauerkraut in a colander.",
            "secondary_message": "3 cups sauerkraut"
          },
          {
            "id": 475989,
            "primary_message": "When the carrots have softened, add sauerkraut, broth, and shredded potatoes to the pot; stir to combine the stew and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until potatoes are tender, about 15 minutes.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n4 cups frozen shredded hash brown potatoes"
          },
          {
            "id": 475990,
            "primary_message": "Meanwhile, stack roast beef slices one on top of another, then medium dice. ",
            "secondary_message": "16 oz deli roast beef"
          },
          {
            "id": 475991,
            "primary_message": "When the potatoes are tender, add roast beef and peas to the stew. Stir to combine and continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
            "secondary_message": "1 cup frozen peas"
          },
          {
            "id": 475992,
            "primary_message": "To serve, divide stew between bowls. Top with reserved green onions and enjoy!",
            "secondary_message": null
          }
        ],
