  "instructions": [
    {
      "id": 400983,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 (5 oz) pkgs spring mix (mixed greens)\n1 English cucumber\n2 pints grape tomatoes\n2 yellow bell peppers\n2 avocados"
    },
    {
      "id": 400984,
      "primary_message": "Place mixed greens and carrots in a large bowl.",
      "secondary_message": "1 (10 oz) bag shredded carrots"
    },
    {
      "id": 400985,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the mixed greens.",
      "secondary_message": null
    },
    {
      "id": 400986,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400987,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400988,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400989,
      "primary_message": "Stack turkey slices one on top of another, then medium dice. Add to the bowl.",
      "secondary_message": "16 oz oven roasted turkey breast, sliced"
    },
    {
      "id": 400990,
      "primary_message": "Crumble goat cheese. Add to the bowl along with the almonds, cranberries, and dressing; toss to combine the salad.",
      "secondary_message": "1 (4 oz) log goat cheese\n½ cup almonds, sliced\n½ cup dried cranberries\n½ cup balsamic vinaigrette"
    },
    {
      "id": 400991,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
