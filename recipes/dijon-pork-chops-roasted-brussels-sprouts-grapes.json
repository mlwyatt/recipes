        "instructions": [
          {
            "id": 8932,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": ""
          },
          {
            "id": 8933,
            "primary_message": "Wash brussels sprouts and grapes. Trim ends and halve the brussels sprouts. Pick grapes off the stems. Transfer to a sheet pan.",
            "secondary_message": "1 lb brussels sprouts\r\n1 lb red grapes"
          },
          {
            "id": 8934,
            "primary_message": "Drizzle with oil and season with thyme, salt, and pepper. Toss to coat.",
            "secondary_message": "2 tbsp extra virgin olive oil\r\n1 tsp thyme\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 8935,
            "primary_message": "Place in the oven and roast until browned and tender, 20 minutes.",
            "secondary_message": ""
          },
          {
            "id": 8936,
            "primary_message": "In a medium bowl, whisk together Dijon, vinegar, maple syrup, thyme, salt, and pepper.",
            "secondary_message": "1 tsp Dijon mustard\r\n1 tsp balsamic vinegar\r\n1 tsp pure maple syrup\r\n¼ tsp thyme\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 8937,
            "primary_message": "Add pork chops to marinade and toss to coat.",
            "secondary_message": "4 pork chops, bone-in"
          },
          {
            "id": 8938,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 8939,
            "primary_message": "Coat bottom of skillet with oil. Add pork chops and cook until cooked through, 3-5 minutes per side, depending on thickness. Spoon any remaining marinade over top while cooking.",
            "secondary_message": "about 2 tbsp virgin coconut oil"
          },
          {
            "id": 8940,
            "primary_message": "Remove sheet from oven, drizzle brussels sprouts and grapes with vinegar, and toss to coat.",
            "secondary_message": "2 tsp balsamic vinegar"
          },
          {
            "id": 8941,
            "primary_message": "To serve, place pork chops, brussels sprouts, and grapes on a plate. Enjoy!",
            "secondary_message": ""
          }
        ],
