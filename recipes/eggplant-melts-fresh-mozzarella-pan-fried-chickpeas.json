        "instructions": [
          {
            "id": 48620,
            "primary_message": "Preheat the oven to 400°F and place the rack in the center position.",
            "secondary_message": null
          },
          {
            "id": 48621,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 eggplants\n2 tomatoes"
          },
          {
            "id": 48622,
            "primary_message": "Halve the eggplants lengthwise and place cut-side-up on a baking sheet. Rub with olive oil and season with salt and pepper.",
            "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 48623,
            "primary_message": "Place the eggplants in the oven and roast until softened, 15 to 20 minutes.",
            "secondary_message": null
          },
          {
            "id": 48624,
            "primary_message": "Slice the tomatoes into rounds and place on a plate lined with paper towels.",
            "secondary_message": null
          },
          {
            "id": 48625,
            "primary_message": "Drain the mozzarella and pat dry with paper towels; slice into rounds.",
            "secondary_message": "1 (8oz) pkg fresh mozzarella"
          },
          {
            "id": 48626,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 48627,
            "primary_message": "Drain and rinse the chickpeas; transfer to paper towels or a clean towel and pat dry.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 48628,
            "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
            "secondary_message": "4 tbsp virgin coconut oil"
          },
          {
            "id": 48629,
            "primary_message": "Add the chickpeas to the skillet and shake to distribute. Cook the chickpeas, shaking occasionally, until they are golden brown and crispy, 5 to 7 minutes.",
            "secondary_message": ""
          },
          {
            "id": 48630,
            "primary_message": "In a medium bowl, combine and mix together paprika, cumin, and salt.",
            "secondary_message": "2 tsp paprika\n½ tsp cumin\n½ tsp salt"
          },
          {
            "id": 48631,
            "primary_message": "Using a slotted spoon, transfer the chickpeas to a paper towel lined plate.",
            "secondary_message": null
          },
          {
            "id": 48632,
            "primary_message": "Remove the baking sheet from the oven. Top the eggplant halves with tomato and fresh mozzarella slices.",
            "secondary_message": null
          },
          {
            "id": 48633,
            "primary_message": "Return the eggplants to the oven and bake until the cheese has melted, another 3 to 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 48634,
            "primary_message": "Add the chickpeas to the bowl with the spices and toss to coat.",
            "secondary_message": null
          },
          {
            "id": 48635,
            "primary_message": "To serve, divide the eggplant melts and chickpeas between plates. Enjoy!",
            "secondary_message": null
          }
        ],
