        "instructions": [
          {
            "id": 31252,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 eggplants\n1 small pkg fresh basil"
          },
          {
            "id": 31253,
            "primary_message": "Trim and discard the ends of the eggplants; medium dice the eggplants (cut into ½-inch cubes) and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 31254,
            "primary_message": "Preheat a sauté pan over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 31255,
            "primary_message": "Peel and small dice the onion (cut into ¼-inch cubes).",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 31256,
            "primary_message": "Add olive oil to the pan and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 31257,
            "primary_message": "Add the onion to the pan; cook, stirring frequently, until softened, 3 to 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 31258,
            "primary_message": "Peel and mince (or crush) the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 31259,
            "primary_message": "Add broth to a small saucepan and bring to a boil.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 31260,
            "primary_message": "Add the garlic to the pan; stir until fragrant, 15 to 30 seconds.",
            "secondary_message": null
          },
          {
            "id": 31261,
            "primary_message": "Add the eggplant, diced tomatoes, and broth to the pan; season with cumin, salt, pepper, and curry powder. Bring to a boil, then reduce the heat to medium-low; cook, stirring occasionally, until the eggplant is tender, 8 to 10 minutes.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth\n1 tsp cumin\n1 tsp salt\n1 tsp black pepper\n½ tsp curry powder"
          },
          {
            "id": 31262,
            "primary_message": "Once the water is boiling, remove the saucepan from the heat. Add salt and couscous and stir. Cover the saucepan and let it sit for 10 minutes.",
            "secondary_message": "½ tsp salt\n1 cup whole wheat couscous"
          },
          {
            "id": 31263,
            "primary_message": "While the eggplant cooks, drain and rinse the chickpeas in a colander.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 31264,
            "primary_message": "Place the feta in a small bowl.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 31265,
            "primary_message": "Pick the basil leaves off the stems; discard the stems and chop almost all of the leaves (save a few for garnishing).",
            "secondary_message": null
          },
          {
            "id": 31266,
            "primary_message": "Stir the chickpeas and chopped basil into the pan; cook for another 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 31267,
            "primary_message": "Uncover the couscous and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 31268,
            "primary_message": "To serve, spoon the couscous onto a plate, top with the stew, and garnish with the feta and remaining basil leaves. Enjoy!",
            "secondary_message": null
          }
        ],
