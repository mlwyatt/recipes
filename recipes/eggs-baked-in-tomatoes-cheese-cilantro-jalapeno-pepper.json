        "instructions": [
          {
            "id": 82699,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 82700,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium yellow onion\n2 small bunches cilantro\n4 jalapeño peppers\n2 pints grape tomatoes"
          },
          {
            "id": 82701,
            "primary_message": "Preheat an oven safe skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 82702,
            "primary_message": "Peel and small dice onion. Peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 82703,
            "primary_message": "Quarter the jalapeño pepper lengthwise; remove and discard the stem, seeds, and membranes. Finely dice half of the jalapeno peppers. Slice the remaining jalapeno peppers and set aside.",
            "secondary_message": null
          },
          {
            "id": 82704,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom. Add onion, garlic, and minced jalapeno. Stirring frequently, cook until vegetables are softened, 3-4 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 82705,
            "primary_message": "Halve grape tomatoes and add to the skillet.",
            "secondary_message": null
          },
          {
            "id": 82706,
            "primary_message": "Drain and rinse the black beans in a colander; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 82707,
            "primary_message": "Add tomato sauce, black beans, oregano, chili powder and salt to the skillet; stir to combine. Reduce heat to low and continue to cook, stirring occasionally, until reduced in volume, 6-8 minutes.",
            "secondary_message": "2 (8 oz) cans tomato sauce\n2 tsp oregano\n1 tsp salt\n½ tsp black pepper\n4 tsp chili powder"
          },
          {
            "id": 82708,
            "primary_message": "Grate mozzarella cheese.",
            "secondary_message": "1 (8 oz) block mozzarella cheese"
          },
          {
            "id": 82709,
            "primary_message": "Gently crack the eggs into the skillet. Top with cheese and sliced jalapeno peppers. Bake until the tops of the whites are set but the yolks are still runny, 8 to 10 minutes.",
            "secondary_message": "8 eggs"
          },
          {
            "id": 82710,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves.",
            "secondary_message": null
          },
          {
            "id": 82711,
            "primary_message": "To serve, divide between plates, and garnish with cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
