  "instructions": [
    {
      "id": 448471,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 448472,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448473,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 448474,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 448475,
      "primary_message": "Meanwhile, drain and rinse beans in a colander.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 448476,
      "primary_message": "When the onion is soft, add beans and tomatoes to the pot. Stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer until the sauce has thickened and beans are tender, about 10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 448477,
      "primary_message": "While the beans are cooking, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the pot with the beans and stir to combine (reserve the remaining for serving).",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 448478,
      "primary_message": "Cut pita breads into wedges and arrange on a large baking sheet pan. When the beans are almost done, place pita bread in the oven and bake until warmed through, 2-3 minutes. Remove from oven.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 448479,
      "primary_message": "When the beans are done, wash, dry, and juice lemon into the pot. Add tahini, stir to combine, and remove from heat.",
      "secondary_message": "1 lemon\n2 tbsp tahini"
    },
    {
      "id": 448480,
      "primary_message": "Divide beans between plates or bowls and sprinkle with reserved parsley. Serve with pita on the side and enjoy!",
      "secondary_message": null
    }
  ],
