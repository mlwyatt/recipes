        "instructions": [
          {
            "id": 451778,
            "primary_message": "Preheat oven to 450°F. ",
            "secondary_message": null
          },
          {
            "id": 451779,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 451780,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 pints grape tomatoes\n2 lemons\n1 small bunch fresh dill\n1 avocado"
          },
          {
            "id": 451781,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 451782,
            "primary_message": "While the rice is cooking, transfer tomatoes to a large baking sheet pan. Drizzle with oil and season with salt. Stir to coat and spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 451783,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tomatoes are just beginning to burst, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 451784,
            "primary_message": "Meanwhile, place seeds and spices in a small bowl; stir to combine the \"everything spice\" mixture.",
            "secondary_message": "4 tsp sesame seeds\n2 tsp poppy seeds\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp black pepper"
          },
          {
            "id": 451785,
            "primary_message": "Pat the salmon dry with paper towels, season with salt, and place, skin-side down, on a plate. Spread the top-side with Dijon, then sprinkle evenly with the spice mixture, pressing gently to adhere. (Reserve bowl for later use.)",
            "secondary_message": "1 ½ lb salmon fillet\n½ tsp salt\n2 tbsp Dijon mustard"
          },
          {
            "id": 451786,
            "primary_message": "When the tomatoes are starting to burst, remove from the oven. Add salmon to the baking sheet, nestling the fillets into the tomatoes. ",
            "secondary_message": null
          },
          {
            "id": 451787,
            "primary_message": "Return baking sheet to the oven and continue to roast until the tomatoes are browned and salmon is cooked through, 7-8 minutes more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 451788,
            "primary_message": "Meanwhile, zest and juice lemons into the reserved bowl.",
            "secondary_message": null
          },
          {
            "id": 451789,
            "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the lemon along with oil, salt, and pepper. Stir to combine the dressing and set aside.",
            "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 451790,
            "primary_message": "Halve and pit avocado. Halve lengthwise and slice thinly while still in the skin, then scoop out with a spoon.",
            "secondary_message": null
          },
          {
            "id": 451791,
            "primary_message": "To serve, divide rice between bowls. Top with salmon, roasted tomatoes, avocado, and capers, then drizzle with dressing. Enjoy!",
            "secondary_message": "2 tbsp capers"
          }
        ],
