  "instructions": [
    {
      "id": 361965,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 361966,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 English cucumbers\n2 avocados\n1 small bunch fresh dill"
    },
    {
      "id": 361967,
      "primary_message": "Place seeds and spices in a small bowl; stir to combine the \"everything spice\" mixture.",
      "secondary_message": "4 tsp sesame seeds\n2 tsp poppy seeds\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 361968,
      "primary_message": "Pat the salmon dry with paper towels and place, skin-side down, on the baking sheet. Spread with Dijon, then sprinkle evenly with the spice mixture, pressing gently to adhere.",
      "secondary_message": "1 ½ lb salmon fillet\n2 tbsp Dijon mustard"
    },
    {
      "id": 361969,
      "primary_message": "Place fish in the oven (it doesn't have to be fully heated) and bake until cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 361970,
      "primary_message": "Meanwhile, place oil, vinegar, capers, and salt in a large bowl; stir to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n2 tbsp capers\n½ tsp salt"
    },
    {
      "id": 361971,
      "primary_message": "Peel, halve, and thinly slice onion crosswise into half-moons. Add to the bowl with the dressing.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 361972,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361973,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon into the bowl.",
      "secondary_message": null
    },
    {
      "id": 361974,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 361975,
      "primary_message": "To serve, divide the salmon and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
