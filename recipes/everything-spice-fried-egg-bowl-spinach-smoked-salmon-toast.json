        "instructions": [
          {
            "id": 319390,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 319391,
            "primary_message": "While the skillet heats up, peel and mince shallots.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 319392,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the shallot and cook, stirring often, until softened, about 2 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 319393,
            "primary_message": "Meanwhile, peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 319394,
            "primary_message": "Add garlic, seeds, salt, and pepper to the skillet with the shallot. Continue to cook, stirring often, until the shallot and garlic become golden, 2-3 minutes more. Transfer \"everything spice\" to a small bowl to keep the garlic from overcooking. (Reserve skillet for later use.)",
            "secondary_message": "4 tsp sesame seeds\n2 tsp poppy seeds\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 319395,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 English cucumber\n2 pints grape tomatoes\n1 lemon\n1 small bunch fresh dill\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 319396,
            "primary_message": "Trim and slice cucumber into thin rounds; place on a plate.",
            "secondary_message": null
          },
          {
            "id": 319397,
            "primary_message": "Halve tomatoes and add to the plate with the cucumber.",
            "secondary_message": null
          },
          {
            "id": 319398,
            "primary_message": "Zest lemon into another small bowl. Slice lemon into wedges, add to the plate with the veggies, and set aside.",
            "secondary_message": null
          },
          {
            "id": 319399,
            "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon zest along with goat cheese and crushed red pepper; mash with the back of a spoon to combine and set aside.",
            "secondary_message": "2 (4 oz) logs goat cheese\n½ tsp crushed red pepper"
          },
          {
            "id": 319400,
            "primary_message": "Return skillet to medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 319401,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat.",
            "secondary_message": "4 tsp extra virgin olive oil\n8 eggs"
          },
          {
            "id": 319402,
            "primary_message": "Meanwhile, halve rolls and toast if desired; spread with lemon-dill goat cheese.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 319403,
            "primary_message": "Chop or tear salmon into bite-sized pieces.",
            "secondary_message": "2 (4 oz) pkgs smoked salmon"
          },
          {
            "id": 319404,
            "primary_message": "Divide spinach between bowls. Top with cucumber, tomatoes, lemon wedges, eggs, and smoked salmon; sprinkle with \"everything spice.\" Serve with goat cheese rolls on the side and enjoy!",
            "secondary_message": null
          }
        ],
