        "instructions": [
          {
            "id": 311755,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 311756,
            "primary_message": "Place spices in a small bowl and stir to combine the spice mix; set aside.",
            "secondary_message": "4 tsp chili powder\n2 tsp cumin, ground\n1 tsp garlic powder\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 311757,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 red bell peppers\n1 bunch kale\n1 lime"
          },
          {
            "id": 311758,
            "primary_message": "Trim, halve, seed, and slice bell peppers into thin strips; divide between two baking sheet pans.",
            "secondary_message": null
          },
          {
            "id": 311759,
            "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick strips; add to the baking sheets with the bell pepper.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 311760,
            "primary_message": "Pat pork chops dry with paper towels and place on a cutting board; thinly slice crosswise into bite-sized strips. Add to the baking sheets, sprinkle with ⅔ of the spice mix, then drizzle with oil; toss to combine and spread out in an even layer. (Reserve remaining spice mix for later use.)",
            "secondary_message": "4 pork chops, boneless\n2 tbsp extra virgin olive oil"
          },
          {
            "id": 311761,
            "primary_message": "Place baking sheets in the oven and roast until veggies start to soften, about 12 minutes.",
            "secondary_message": null
          },
          {
            "id": 311762,
            "primary_message": "Meanwhile, using a clean cutting board, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 311763,
            "primary_message": "Drain and rinse beans in a colander. Add beans to the bowl with the kale along with oil and salt; toss to combine.",
            "secondary_message": "2 (15 oz) cans black beans\n4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 311764,
            "primary_message": "When the veggies are soft, add kale and beans to the baking sheets; toss to combine, then return to the oven and continue to bake until kale is tender and pork is cooked through, 6-7 minutes more.",
            "secondary_message": null
          },
          {
            "id": 311765,
            "primary_message": "Meanwhile, zest and juice lime into the bowl with the remaining spice mix; add yogurt and water, then stir to combine the sauce.",
            "secondary_message": "1 cup plain Greek yogurt\n2 tsp water"
          },
          {
            "id": 311766,
            "primary_message": "To serve, divide pork, beans, and veggies between bowls; drizzle with sauce and enjoy!",
            "secondary_message": null
          }
        ],
