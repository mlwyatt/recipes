  "instructions": [
    {
      "id": 230445,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 230446,
      "primary_message": "Drain and rinse chickpeas. Place on a clean towel or paper towels and pat dry, then transfer to a large bowl.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 230447,
      "primary_message": "Add oil, sesame seeds, and spices to the bowl with the chickpeas; stir to combine. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp sesame seeds\n1 tsp paprika\n1 tsp cumin, ground\n1 tsp coriander, ground\n½ tsp salt"
    },
    {
      "id": 230448,
      "primary_message": "Transfer chickpeas to a large baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until slightly crispy, about 15 minutes. (Reserve bowl for the salad.)",
      "secondary_message": null
    },
    {
      "id": 230449,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 English cucumber\n2 tomatoes\n1 bunch radish\n2 heads romaine lettuce\n1 small bunch cilantro\n1 small bunch Italian (flat-leaf) parsley\n2 lemons"
    },
    {
      "id": 230450,
      "primary_message": "Peel, trim, and coarsely grate carrots; transfer to the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 230451,
      "primary_message": "Trim and medium dice cucumber. Medium dice tomatoes; add both to the bowl with the carrots.",
      "secondary_message": null
    },
    {
      "id": 230452,
      "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 230453,
      "primary_message": "Cut romaine crosswise into thin (shred-like) strips and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 230454,
      "primary_message": "Shave cilantro and parsley leaves off the stems; discard stems and mince the leaves. Add both to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 230455,
      "primary_message": "Peel and mince garlic; place in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 230456,
      "primary_message": "Juice lemons into the bowl with the garlic. Add tahini, water, Dijon, sugar, and spices; whisk to combine the dressing.",
      "secondary_message": "½ cup tahini\n⅓ cup water\n2 tsp Dijon mustard\n1 tsp brown sugar\n½ tsp cumin, ground\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 230457,
      "primary_message": "To serve, divide salad between plates. Top with crispy chickpeas and drizzle with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
