        "instructions": [
          {
            "id": 402249,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add pasta and salt, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "10 oz fettuccine pasta\n1 tsp salt"
          },
          {
            "id": 402250,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 402251,
            "primary_message": "While the skillet heats up, tear smoked salmon into bite-sized pieces.",
            "secondary_message": "2 (4 oz) pkgs smoked salmon"
          },
          {
            "id": 402252,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add salmon and cook, stirring often, until crispy, about 4 minutes. Use a slotted spoon to transfer to a paper towel-lined plate and set aside. (Reserve skillet with cooking juices for the next step.)",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 402253,
            "primary_message": "Return skillet (with cooking juices) to medium heat. Add peas and cook, stirring often, until tender, 1-2 minutes.",
            "secondary_message": "1 ½ cups frozen peas"
          },
          {
            "id": 402254,
            "primary_message": "Add Alfredo sauce to the skillet with the peas. Bring to a simmer, stirring occasionally, then remove from heat and cover to keep warm.",
            "secondary_message": "1 (16 oz) jar Alfredo sauce"
          },
          {
            "id": 402255,
            "primary_message": "Meanwhile, wash and dry the arugula (skip this step if it came pre-washed). Place in a medium bowl along with dressing and additional salt; toss to coat.",
            "secondary_message": "1 (5 oz) pkg baby arugula\n¼ cup honey mustard dressing\n¼ tsp salt"
          },
          {
            "id": 402256,
            "primary_message": "When the pasta is done, drain and add to the skillet with the sauce; toss to combine.",
            "secondary_message": null
          },
          {
            "id": 402257,
            "primary_message": "To serve, divide pasta and arugula between plates; top pasta with crispy salmon. Enjoy!",
            "secondary_message": null
          }
        ],
