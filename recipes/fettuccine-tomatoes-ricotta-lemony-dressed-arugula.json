        "instructions": [
          {
            "id": 488024,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
            "secondary_message": "1 tsp salt\n10 oz fettuccine pasta"
          },
          {
            "id": 488025,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 488026,
            "primary_message": "While the skillet heats up, peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 488027,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and crushed red pepper; cook, stirring frequently, until fragrant and golden, about 1 minute.",
            "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp crushed red pepper"
          },
          {
            "id": 488028,
            "primary_message": "Add tomatoes and salt to the skillet; cook, stirring occasionally, until simmering. Once simmering, reduce heat to medium-low, and continue to cook, stirring occasionally, until slightly thickened, 12-15 minutes more.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n¼ tsp salt"
          },
          {
            "id": 488029,
            "primary_message": "Meanwhile, finely grate Parmesan. Place in a small bowl along with ricotta and salt, then stir to combine. Set aside.",
            "secondary_message": "2 oz Parmesan cheese\n1 (15 oz) pkg ricotta cheese\n¼ tsp salt"
          },
          {
            "id": 488030,
            "primary_message": "Wash, dry, zest, and juice lemon into a medium bowl.",
            "secondary_message": "1 lemon"
          },
          {
            "id": 488031,
            "primary_message": "Peel and mince shallot. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing. ",
            "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 488032,
            "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl with the dressing and toss to coat.",
            "secondary_message": "1 (5 oz) pkg baby arugula"
          },
          {
            "id": 488033,
            "primary_message": "Add drained pasta and reserved pasta water to the skillet with the sauce. Continue to cook, stirring frequently, until heated through, 1-2 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 488034,
            "primary_message": "To serve, divide pasta and arugula between plates or bowls. Top pasta with ricotta and crushed red pepper. Enjoy!",
            "secondary_message": "⅛ tsp crushed red pepper"
          }
        ],
