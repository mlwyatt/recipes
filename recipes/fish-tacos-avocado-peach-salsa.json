  "instructions": [
    {
      "id": 49890,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 peaches\n2 avocados\n2 jalapeño peppers\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 49891,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard the pit; small dice the quarters into ¼-inch cubes. Transfer to a medium bowl (that will hold the salsa).",
      "secondary_message": null
    },
    {
      "id": 49892,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh into ¼-inch cubes. Add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 49893,
      "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 49894,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 49895,
      "primary_message": "Trim off and discard the ends of the shallots; peel and finely dice the shallots. Add to the salsa bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 49896,
      "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 49897,
      "primary_message": "While the skillet heats up, pat the fish dry with paper towels and place on a plate; season with chili powder, salt, and pepper on both sides.",
      "secondary_message": "1 ½ lb cod fillet\n2 tsp chili powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 49898,
      "primary_message": "Once the skillet is hot, add the fish; cook until it is cooked through and flakes easily, 2 to 4 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 49899,
      "primary_message": "Juice the lime and add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 49900,
      "primary_message": "Season the salsa with salt and pepper; toss to combine.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 49901,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15 to 30 seconds.",
      "secondary_message": "16 small corn tortillas"
    },
    {
      "id": 49902,
      "primary_message": "Using a fork or your hands, flake the fish.",
      "secondary_message": null
    },
    {
      "id": 49903,
      "primary_message": "To serve, divide the fish between the tortillas and top with the avocado-peach salsa. Enjoy!",
      "secondary_message": null
    }
  ],
