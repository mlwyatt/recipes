        "instructions": [
          {
            "id": 31295,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head napa cabbage\n2 tomatoes\n2 avocados\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 31296,
            "primary_message": "Cut out and discard the core from the cabbage; quarter the cabbage lengthwise, then thinly slice crosswise and transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 31297,
            "primary_message": "Small dice the tomatoes and add to the cabbage.",
            "secondary_message": null
          },
          {
            "id": 31298,
            "primary_message": "Halve and pit the avocados; cube the flesh while still in the skin. Scoop out the flesh into a small bowl.",
            "secondary_message": null
          },
          {
            "id": 31299,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add ½ of the cilantro to the cabbage and the other ½ to the avocado.",
            "secondary_message": null
          },
          {
            "id": 31300,
            "primary_message": "Juice the limes into a small bowl; add ½ to the cabbage and the other ½ to the avocado.",
            "secondary_message": null
          },
          {
            "id": 31301,
            "primary_message": "Preheat a grill pan or skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 31302,
            "primary_message": "Place the fish on a plate, drizzle with olive oil, and season with chili powder, salt, and pepper.",
            "secondary_message": "1 ½ lb halibut fillets\n2 tbsp extra virgin olive oil\n2 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 31303,
            "primary_message": "Place the fish in the grill pan or skillet; cook until opaque and golden brown, 2 to 3 minutes per side. Once done, transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 31304,
            "primary_message": "Season the avocado with salt and pepper; mash with a fork until smooth.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 31305,
            "primary_message": "Season the cabbage mixture with salt and pepper; toss until well combined.",
            "secondary_message": "1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 31306,
            "primary_message": "Place the tortillas on a plate and cover with a damp paper towel. Microwave for 30 to 60 seconds until they are warmed through. (This step is optional.)",
            "secondary_message": "16 small corn tortillas"
          },
          {
            "id": 31307,
            "primary_message": "Using your hands or a fork, flake the fish.",
            "secondary_message": null
          },
          {
            "id": 31308,
            "primary_message": "Divide the cabbage slaw among the tortillas (leaving any extra on the side), then add the fish, and spoon dollops of the guacamole on top. Enjoy!",
            "secondary_message": null
          }
        ],
