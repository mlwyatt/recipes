        "instructions": [
          {
            "id": 43825,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 (15 oz) pkg strawberries\n2 avocados\n2 jalapeño peppers\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 43826,
            "primary_message": "Trim off and discard the stem ends of the strawberries; small dice the strawberries. Transfer to a large bowl (that will hold the salsa).",
            "secondary_message": ""
          },
          {
            "id": 43827,
            "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh. Add to the salsa bowl.",
            "secondary_message": null
          },
          {
            "id": 43828,
            "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the salsa bowl.",
            "secondary_message": null
          },
          {
            "id": 43829,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salsa bowl.",
            "secondary_message": null
          },
          {
            "id": 43830,
            "primary_message": "Trim off and discard the ends of the shallots; peel and finely dice the shallots. Add to the salsa bowl.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 43831,
            "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 43832,
            "primary_message": "While the grill pan / skillet heats up, pat the fish dry with paper towels and place on a plate. Rub with olive oil and season with chili powder, salt, and pepper on both sides.",
            "secondary_message": "1 ½ lb cod fillet\n1 tbsp extra virgin olive oil\n2 tsp chili powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 43833,
            "primary_message": "Once the grill pan / skillet is hot, add the fish; cook until it is cooked through and flakes easily, 2 to 4 minutes per side. Once done, transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 43834,
            "primary_message": "Juice one lime and add to the salsa bowl; cut the remaining lime into wedges for serving.",
            "secondary_message": null
          },
          {
            "id": 43835,
            "primary_message": "Season the salsa with salt and pepper; toss to combine.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 43836,
            "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15 to 30 seconds.",
            "secondary_message": "16 small corn tortillas"
          },
          {
            "id": 43837,
            "primary_message": "Using a fork or your hands, flake the fish.",
            "secondary_message": null
          },
          {
            "id": 43838,
            "primary_message": "To serve, divide the fish between the tortillas and top with the strawberry-avocado salsa; serve with lime wedges on the side. Enjoy!",
            "secondary_message": null
          }
        ],
