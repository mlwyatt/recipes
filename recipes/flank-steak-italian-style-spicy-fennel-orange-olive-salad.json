  "instructions": [
    {
      "id": 449727,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 oranges\n4 fennel bulbs\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 449728,
      "primary_message": "Mince anchovy fillets. Place in a medium bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "4 anchovy fillets, packed in oil\n3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n½ tsp salt\n¼ tsp oregano, dried\n¼ tsp crushed red pepper"
    },
    {
      "id": 449729,
      "primary_message": "Place steak on a plate, season with salt and pepper on both sides, then drizzle with half of the dressing. Turn to coat and set aside to marinate, 15 minutes. (Reserve remaining dressing for the next step.)",
      "secondary_message": "1 ½ lb flank steaks\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 449730,
      "primary_message": "While the steak is marinating, peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the remaining dressing. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 449731,
      "primary_message": "Halve olives lengthwise and add to the bowl. ",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 449732,
      "primary_message": "Cut off skin and white pith from oranges; slice between the membranes to release segments. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 449733,
      "primary_message": "When the steak is done marinating, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 449734,
      "primary_message": "Once the skillet is hot, add steak and cook until desired doneness, 2-4 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 449735,
      "primary_message": "Meanwhile, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the olives and orange segments.",
      "secondary_message": null
    },
    {
      "id": 449736,
      "primary_message": "Pick parsley leaves off the stems; discard stems. Add leaves to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 449737,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 449738,
      "primary_message": "To serve, divide steak and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
