        "instructions": [
          {
            "id": 473623,
            "primary_message": "Place soy sauce, oil, and spices in a medium bowl. Stir to combine the marinade.",
            "secondary_message": "4 tsp soy sauce\n2 tsp neutral vegetable oil\n4 tsp chili powder\n2 tsp cumin, ground\n1 tsp salt"
          },
          {
            "id": 473624,
            "primary_message": "Pat steak dry with paper towels and place on a cutting board. Slice crosswise into thin strips, then cut each strip into bite-sized pieces. Add to the bowl with the marinade, stir to coat, and set aside for 15 minutes.",
            "secondary_message": "1 ½ lb flank steaks"
          },
          {
            "id": 473625,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small bunch cilantro\n2 limes\n2 jalapeño peppers\n1 medium head napa cabbage"
          },
          {
            "id": 473626,
            "primary_message": "Using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in another medium bowl. (Reserve remaining cilantro for serving.)",
            "secondary_message": null
          },
          {
            "id": 473627,
            "primary_message": "Juice limes into the bowl with the cilantro. Add oil and salt, then whisk to combine the dressing.",
            "secondary_message": "4 tsp neutral vegetable oil\n½ tsp salt"
          },
          {
            "id": 473628,
            "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Slice crosswise into thin half-moons and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 473629,
            "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl and toss to combine the slaw; set aside",
            "secondary_message": null
          },
          {
            "id": 473630,
            "primary_message": "When the steak is done marinating, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 473631,
            "primary_message": "Once the skillet is hot, add steak and cook, undisturbed, until browned, 2-3 minutes. Turn and continue to cook until desired doneness, 1-2 minutes more. Transfer to a plate and set aside to rest, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 473632,
            "primary_message": "Meanwhile, peel, halve, and mince onion. Set aside for serving.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 473633,
            "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
            "secondary_message": "12 small corn tortillas"
          },
          {
            "id": 473634,
            "primary_message": "To serve, divide tortillas and slaw between plates. Top tortillas with steak, hot sauce, onion, and reserved cilantro. Enjoy!",
            "secondary_message": "4 tsp hot sauce"
          }
        ],
