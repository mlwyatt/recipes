        "instructions": [
          {
            "id": 259064,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 259065,
            "primary_message": "Peel and mince garlic; place in a small bowl along with oil and spices. Stir to combine the garlic oil.",
            "secondary_message": "4 cloves garlic\n4 tsp extra virgin olive oil\n½ tsp rosemary, dried\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 259066,
            "primary_message": "Drizzle garlic oil over the flatbreads, cut into 1½-inch wide strips, and transfer to a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven.",
            "secondary_message": "2 flatbreads or naan"
          },
          {
            "id": 259067,
            "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a large bowl; whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp honey\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 259068,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "6 ears corn\n2 peaches\n1 avocado\n1 small pkg fresh basil\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 259069,
            "primary_message": "Remove husks and silks from the corn. Using a knife, carefully slice corn kernels off the cobs; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 259070,
            "primary_message": "Quarter peaches lengthwise (around the pit); twist to separate and remove pit. Medium dice and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 259071,
            "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 259072,
            "primary_message": "Peel and small dice onion. Add to the bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 259073,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 259074,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 259075,
            "primary_message": "Crumble goat cheese into the bowl and gently stir to combine the salad.",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 259076,
            "primary_message": "To serve, divide salad and breadsticks between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
