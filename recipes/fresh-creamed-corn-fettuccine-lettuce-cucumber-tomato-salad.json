  "instructions": [
    {
      "id": 260323,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Reserve 1 cup cooking water before draining; set aside.",
      "secondary_message": "2 tsp salt\n10 oz fettuccine pasta"
    },
    {
      "id": 260324,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "4 ears corn\n1 English cucumber\n1 pint grape tomatoes\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 260325,
      "primary_message": "Remove husks and silks from the corn. Using a knife, carefully slice corn kernels off the cobs and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 260326,
      "primary_message": "Peel and mince garlic; peel and small dice half the onion (reserving the rest for later use). Add both to the bowl with the corn.",
      "secondary_message": "4 cloves garlic\n1 medium red onion"
    },
    {
      "id": 260327,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 260328,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add corn, garlic, onion, broth, and salt; cook, stirring occasionally, until corn starts to soften and break down, 8-10 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n8 fl oz (1 cup) chicken or vegetable broth\n1 tsp salt"
    },
    {
      "id": 260329,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp white wine vinegar\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 260330,
      "primary_message": "Thinly slice remaining onion. Trim and halve cucumber lengthwise; slice crosswise into thin half-moons. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 260331,
      "primary_message": "Halve tomatoes and add to the bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 260332,
      "primary_message": "Cut cream cheese into small pieces. Finely grate Parmesan.",
      "secondary_message": "½ (8 oz) block cream cheese\n2 oz Parmesan cheese"
    },
    {
      "id": 260333,
      "primary_message": "When the corn is ready, add cream cheese and Parmesan to the skillet. Bring to a simmer and cook, stirring often, until cheese melts and the sauce thickens slightly, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 260334,
      "primary_message": "Transfer pasta to the skillet and toss to combine; add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 260335,
      "primary_message": "Add mixed greens to the bowl with the veggies and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 260336,
      "primary_message": "To serve, divide pasta and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
