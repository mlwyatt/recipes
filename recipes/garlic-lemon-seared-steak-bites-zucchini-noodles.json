        "instructions": [
          {
            "id": 215662,
            "primary_message": "Wash and dry lemon; zest and juice into a medium bowl. ",
            "secondary_message": "1 lemon"
          },
          {
            "id": 215663,
            "primary_message": "Peel and mince garlic; add to the bowl with the lemon.",
            "secondary_message": "6 cloves garlic"
          },
          {
            "id": 215664,
            "primary_message": "Add broth, soy sauce, and spices to the bowl; whisk to combine the sauce and set aside.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n⅓ cup tamari soy sauce\n2 tsp parsley flakes\n½ tsp black pepper\n⅛ tsp crushed red pepper"
          },
          {
            "id": 215665,
            "primary_message": "Wash zucchini, trim ends, and use a julienne (or regular) peeler to make noodles. Use a paper towel or a clean cloth to squeeze excess moisture out of the zucchini noodles. ",
            "secondary_message": "4 medium zucchini squash"
          },
          {
            "id": 215666,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 215667,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels, then cut into 1-inch cubes.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak"
          },
          {
            "id": 215668,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 215669,
            "primary_message": "Add steak and cook, stirring occasionally, until desired doneness, 4-5 minutes for medium. Transfer to a plate and set aside. ",
            "secondary_message": null
          },
          {
            "id": 215670,
            "primary_message": "Add sauce to the skillet and whisk. Cook, stirring frequently, until the mixture is reduced by about half, 5-6 minutes.",
            "secondary_message": null
          },
          {
            "id": 215671,
            "primary_message": "Stir in butter and, once melted, add zucchini noodles. Cook, stirring constantly, until just tender, 3-4 minutes. Use tongs to remove from skillet and portion onto plates, leaving the excess sauce in the pan.",
            "secondary_message": "¼ cup butter, unsalted"
          },
          {
            "id": 215672,
            "primary_message": "Return steak to the skillet and toss to coat in the sauce.",
            "secondary_message": null
          },
          {
            "id": 215673,
            "primary_message": "To serve, transfer steak to plates with the noodles and top with any remaining sauce. Enjoy!",
            "secondary_message": null
          }
        ],
