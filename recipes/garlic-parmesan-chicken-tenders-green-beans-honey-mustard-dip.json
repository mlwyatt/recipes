  "instructions": [
    {
      "id": 425631,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 425632,
      "primary_message": "Place mayo, garlic powder, and salt in a medium bowl; stir to combine.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 425633,
      "primary_message": "Place Parmesan, bread crumbs, and paprika in another medium bowl. Stir to combine the coating.",
      "secondary_message": "⅔ cup Parmesan cheese, shredded\n½ cup panko bread crumbs\n½ tsp paprika"
    },
    {
      "id": 425634,
      "primary_message": "Pat chicken dry with paper towels and slice into ¾-inch tenders. Add to the bowl with the mayo mixture and toss to coat.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 425635,
      "primary_message": "Working in batches, dredge tenders in the bread crumb coating, pressing to adhere. Transfer to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 425636,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until tenders start to turn golden, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 425637,
      "primary_message": "While the tenders are baking, wash, dry, and using a clean cutting board, trim green beans. Set aside.",
      "secondary_message": "1 ½ lb green beans"
    },
    {
      "id": 425638,
      "primary_message": "When the chicken is golden, flip and continue to bake until cooked through, 6-8 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 425639,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 425640,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green beans and salt; cook, stirring occasionally, until tender-crisp, 4-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 425641,
      "primary_message": "Divide chicken tenders and green beans between plates. Serve with a side of dressing for dipping. Enjoy!",
      "secondary_message": "½ cup honey mustard dressing"
    }
  ],
