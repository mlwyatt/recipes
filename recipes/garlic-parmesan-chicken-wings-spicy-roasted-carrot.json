  "instructions": [
    {
      "id": 12893,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": ""
    },
    {
      "id": 12894,
      "primary_message": "In a large bowl, mix together oregano, thyme, cumin, and salt. Add chicken wings and toss to coat.",
      "secondary_message": "1 tsp oregano\r\n1 tsp thyme\r\n½ tsp cumin\r\n½ tsp salt\r\n2 lb chicken wings, split with tips removed"
    },
    {
      "id": 12895,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 12896,
      "primary_message": "Coat bottom of skillet with oil. Add chicken wings and brown on both sides, 2-3 minutes per side. Reduce heat to medium-low and cook, occasionally flipping, until cooked through, 10-12 minutes.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 12897,
      "primary_message": "Wash and dry carrots; trim ends and thinly slice, using a mandoline or knife, into rounds.",
      "secondary_message": "8 medium carrots"
    },
    {
      "id": 12898,
      "primary_message": "Brush a sheet pan with oil to prevent sticking. Transfer carrots to sheet. Drizzle with oil and season with salt and pepper; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n¼ tsp cayenne pepper"
    },
    {
      "id": 12899,
      "primary_message": "Spread out in a single layer and place in the oven. Bake until crispy, 10-12 minutes. Watch carefully because they can burn quickly.",
      "secondary_message": ""
    },
    {
      "id": 12900,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems, discard the stems and mince the leaves. Peel and mince garlic. Grate ¼ cup of Parmesan. In a large bowl, mix together parsley, garlic, Parmesan, and salt.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\r\n4 cloves garlic\r\n1 oz Parmesan cheese\r\n½ tsp salt"
    },
    {
      "id": 12901,
      "primary_message": "Add chicken wings to bowl and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 12902,
      "primary_message": "To serve, place chicken wings and carrots on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
