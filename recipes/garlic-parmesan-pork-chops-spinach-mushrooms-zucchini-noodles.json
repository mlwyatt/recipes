        "instructions": [
          {
            "id": 262687,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 medium zucchini squash\n1 lb cremini mushrooms\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 262688,
            "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Place in a small bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 262689,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 262690,
            "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 262691,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer chops to a clean plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 262692,
            "primary_message": "Meanwhile, thinly slice mushrooms.",
            "secondary_message": null
          },
          {
            "id": 262693,
            "primary_message": "Peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 262694,
            "primary_message": "Return skillet to medium heat and add more oil. Add mushrooms and garlic to the skillet and cook, stirring occasionally, until mushrooms begin to soften, 4-5 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 262695,
            "primary_message": "While the mushrooms are cooking, cut cream cheese into small pieces.",
            "secondary_message": "1 (8 oz) block cream cheese"
          },
          {
            "id": 262696,
            "primary_message": "Finely grate Parmesan.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 262697,
            "primary_message": "Add cream cheese, Parmesan, broth, and spices to the skillet; stir until cheese is melted and combined. Bring to a simmer and continue to cook, stirring occasionally, until sauce thickens, 3-4 minutes.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ tsp oregano, dried\n½ tsp crushed red pepper\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 262698,
            "primary_message": "Add spinach and zucchini noodles to the skillet in handfuls, waiting for them to wilt slightly before adding the next handful.",
            "secondary_message": null
          },
          {
            "id": 262699,
            "primary_message": "Return pork chops to the skillet and turn to coat in sauce.",
            "secondary_message": null
          },
          {
            "id": 262700,
            "primary_message": "To serve, divide saucy veggies and pork chops between plates. Enjoy!",
            "secondary_message": null
          }
        ],
