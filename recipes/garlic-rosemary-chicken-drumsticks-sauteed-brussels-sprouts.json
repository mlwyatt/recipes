        "instructions": [
          {
            "id": 31138,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 lb brussels sprouts\n1 small pkg fresh rosemary"
          },
          {
            "id": 31139,
            "primary_message": "Preheat the oven to 450°F and position the rack in the center. Place a baking dish (one that is big enough to hold the chicken) inside the oven to warm up.",
            "secondary_message": null
          },
          {
            "id": 31140,
            "primary_message": "Trim off and discard the stem ends of the Brussels sprouts, then remove the outer layer of leaves; halve the sprouts lengthwise (or quarter if they are large).",
            "secondary_message": ""
          },
          {
            "id": 31141,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 31142,
            "primary_message": "While the skillet heats up, pat dry the chicken with paper towels and place on a plate, then generously season with salt and pepper.",
            "secondary_message": "2 ½ lb chicken drumsticks\n1 tsp salt\n1 tsp black pepper"
          },
          {
            "id": 31143,
            "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 31144,
            "primary_message": "Place the drumsticks in the skillet; cook, turning every 1 minute or so, until the they are browned on all sides (but not cooked through). Once done, remove the baking dish from the oven and transfer the chicken to it.",
            "secondary_message": null
          },
          {
            "id": 31145,
            "primary_message": "While the chicken cooks, one by one, holding a sprig of rosemary at its top, run you fingers down it to remove the leaves. Discard the sprigs and chop the leaves.",
            "secondary_message": null
          },
          {
            "id": 31146,
            "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 31147,
            "primary_message": "Juice the lemon into a small bowl.",
            "secondary_message": "1 lemon"
          },
          {
            "id": 31148,
            "primary_message": "Once the chicken has been transferred, return the skillet to the stove and reduce the heat to medium. Add the rosemary, garlic, ½ of the lemon juice, and ½ of the broth to the skillet. Deglaze the skillet by scraping up browned bits from the bottom.",
            "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
          },
          {
            "id": 31149,
            "primary_message": "Pour the skillet sauce over top of the chicken. Place the chicken in the oven and bake until it is cooked through, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 31150,
            "primary_message": "Add more coconut oil to the skillet.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 31151,
            "primary_message": "Add the Brussels sprouts to the skillet and cook until they are lightly browned, 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 31152,
            "primary_message": "Once the sprouts are browned, add the remaining broth and season with salt and pepper. Cook, stirring occasionally, until the sprouts are tender and the liquid has evaporated, 3 to 4 minutes.",
            "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 31153,
            "primary_message": "To serve, place the chicken and Brussels sprouts on a plate. Enjoy!",
            "secondary_message": null
          }
        ],
