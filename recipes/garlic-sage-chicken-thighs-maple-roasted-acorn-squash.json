  "instructions": [
    {
      "id": 23866,
      "primary_message": "Preheat oven to 500°F and position rack in the centre.",
      "secondary_message": ""
    },
    {
      "id": 23867,
      "primary_message": "Peel and mince garlic. In a medium bowl, mix together the minced garlic, olive oil, sage, salt, and pepper.",
      "secondary_message": "4 cloves garlic\r\n4 tbsp extra virgin olive oil\r\n1 tsp sage\r\n1 tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23868,
      "primary_message": "Wash and thinly slice lemon.",
      "secondary_message": "1 lemon\r\n"
    },
    {
      "id": 23869,
      "primary_message": "Add chicken and lemon slices to bowl; toss to coat. Set aside.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\r\n"
    },
    {
      "id": 23870,
      "primary_message": "Heat a saucepan over medium heat. Add butter, maple syrup, chill powder, salt, and pepper. Simmer for 2-3 minutes while you prepare the squash.",
      "secondary_message": "2 tbsp butter, unsalted\r\n2 tbsp pure maple syrup\r\n¼ tsp chili powder\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23871,
      "primary_message": "Wash and halve squash lengthwise. Scoop out the seeds and cut crosswise into ¼ inch thick slices.",
      "secondary_message": "2 acorn squash\r\n"
    },
    {
      "id": 23872,
      "primary_message": "Lightly coat a baking sheet with olive oil.",
      "secondary_message": "1 tsp extra virgin olive oil\r\n"
    },
    {
      "id": 23873,
      "primary_message": "Add squash slices to baking sheet and pour butter-maple mixture over top. Toss to coat and arrange slices in a single layer.",
      "secondary_message": ""
    },
    {
      "id": 23874,
      "primary_message": "Place chicken and lemon slices on top of squash. Place in the oven and roast until squash is tender and chicken is cooked though, 12-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23875,
      "primary_message": "Serve chicken thighs with squash on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
