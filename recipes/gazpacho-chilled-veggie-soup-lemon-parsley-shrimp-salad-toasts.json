        "instructions": [
          {
            "id": 253981,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 English cucumber\n1 yellow bell pepper\n4 tomatoes\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 253982,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry. Set aside.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 253983,
            "primary_message": "Medium dice bread and transfer to a large bowl.",
            "secondary_message": "2 slices whole grain bread"
          },
          {
            "id": 253984,
            "primary_message": "Peel, trim, and large dice cucumber; add to the bowl with the bread.",
            "secondary_message": null
          },
          {
            "id": 253985,
            "primary_message": "Trim, seed, and large dice bell pepper. Large dice tomatoes; add both to the bowl.",
            "secondary_message": null
          },
          {
            "id": 253986,
            "primary_message": "Peel and roughly chop garlic; add to the bowl along with broth, oil, vinegar, and spices; stir to combine the soup mixture.",
            "secondary_message": "2 cloves garlic\n8 fl oz (1 cup) chicken or vegetable broth\n3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tsp onion powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 253987,
            "primary_message": "Working in batches, transfer the soup mixture to a blender; blend on high until semi-smooth. Once blended, transfer gazpacho to a container with a lid and refrigerate until ready to serve. (Reserve bowl for later use.)",
            "secondary_message": null
          },
          {
            "id": 253988,
            "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
            "secondary_message": null
          },
          {
            "id": 253989,
            "primary_message": "Transfer shrimp to a large baking sheet pan lined with aluminum foil; drizzle with oil and season with salt and pepper. Place baking sheet in the oven and broil, flipping once, until shrimp are opaque and cooked through, 3-4 minutes. Remove from oven.",
            "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 253990,
            "primary_message": "While the shrimp are cooking, mince capers. Place in the reserved bowl along with mayo and crushed red pepper.",
            "secondary_message": "1 tbsp capers\n⅓ cup mayonnaise\n¼ tsp crushed red pepper"
          },
          {
            "id": 253991,
            "primary_message": "Juice lemon into the bowl with the capers and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 253992,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl (reserving a small handful for serving).",
            "secondary_message": null
          },
          {
            "id": 253993,
            "primary_message": "Carefully remove cooked shrimp from the baking sheet by lifting the corners of the foil and transferring the foil sheet to a flat surface. Arrange additional bread slices on the baking sheet, place in the oven, and broil until toasted, 1-2 minutes. Remove from oven.",
            "secondary_message": "8 slices whole grain bread"
          },
          {
            "id": 253994,
            "primary_message": "Meanwhile, roughly chop the cooked shrimp; add to the bowl with the lemon-mayo mixture and stir to combine. Divide shrimp salad between toast slices and spread out in an even layer.",
            "secondary_message": null
          },
          {
            "id": 253995,
            "primary_message": "Divide gazpacho between bowls; drizzle with additional oil and sprinkle with reserved parsley. Serve with shrimp salad toasts on the side and enjoy!",
            "secondary_message": "2 tsp extra virgin olive oil"
          }
        ],
