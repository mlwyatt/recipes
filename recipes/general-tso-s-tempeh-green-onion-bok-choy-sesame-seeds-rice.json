        "instructions": [
          {
            "id": 468041,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 468042,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small bunch green onions (scallions)\n2 (1 inch) pieces ginger root\n10 baby bok choy"
          },
          {
            "id": 468043,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 468044,
            "primary_message": "While the rice is cooking, trim and cut green onions crosswise into thin pieces. Place ⅔ in a small bowl. (Reserve remaining green onions for serving.)",
            "secondary_message": null
          },
          {
            "id": 468045,
            "primary_message": "Peel and mince ginger. Add to the bowl with the green onions along with broth, cornstarch, soy sauce, maple syrup, and ketchup. Stir to combine the stir-fry sauce and set aside.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp cornstarch\n2 tbsp soy sauce\n2 tbsp pure maple syrup\n2 tbsp rice vinegar\n2 tbsp ketchup"
          },
          {
            "id": 468046,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 468047,
            "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick strips. Season with salt. ",
            "secondary_message": "2 (8 oz) packages tempeh\n¼ tsp salt"
          },
          {
            "id": 468048,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh in a single layer and cook, flipping once, until browned and warmed through, 4-5 minutes. Transfer to a plate. (Reserve skillet for later use.)",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 468049,
            "primary_message": "Meanwhile, trim and cut bok choy crosswise into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 468050,
            "primary_message": "Return the skillet to medium heat, add more oil, and swirl to coat the bottom. Add bok choy and salt, then stir-fry until softened, 3-4 minutes. ",
            "secondary_message": "4 tsp toasted sesame oil\n¼ tsp salt"
          },
          {
            "id": 468051,
            "primary_message": "Add stir-fry sauce to the skillet. Bring to a boil and continue to cook, stirring occasionally, until sauce thickens, 2-3 minutes more. Remove from heat, add tempeh, and stir to combine; cover to keep warm. ",
            "secondary_message": null
          },
          {
            "id": 468052,
            "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved green onions and sesame seeds. Enjoy!",
            "secondary_message": "2 tsp sesame seeds"
          }
        ],
