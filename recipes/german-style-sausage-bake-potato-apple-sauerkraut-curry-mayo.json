        "instructions": [
          {
            "id": 448233,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 448234,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lb new potatoes\n2 Gala apples"
          },
          {
            "id": 448235,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl and set aside for later use.",
            "secondary_message": null
          },
          {
            "id": 448236,
            "primary_message": "Quarter potatoes and place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 448237,
            "primary_message": "Quarter, core, and large dice apples. Add to the bowl with the potatoes.",
            "secondary_message": null
          },
          {
            "id": 448238,
            "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick strips. Add to the bowl.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 448239,
            "primary_message": "Slice sausages into 1-inch thick rounds. Add to the bowl along with oil and spices, then stir to combine. Transfer mixture to a large baking sheet pan and spread out in an even layer.",
            "secondary_message": "4 pork sausages\n2 tbsp extra virgin olive oil\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 448240,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until the potatoes are tender and sausage is cooked through, 20-25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 448241,
            "primary_message": "Meanwhile, place mayo, water, curry powder, and salt in another small bowl. Stir to combine the curry mayo and set aside.",
            "secondary_message": "¼ cup mayonnaise\n4 tsp water\n1 tsp curry powder\n⅛ tsp salt"
          },
          {
            "id": 448242,
            "primary_message": "When the sausage bake has about 5 minutes left, place sauerkraut in a small saucepan. Set over high heat and bring to a simmer, stirring occasionally. Cover and remove from heat.",
            "secondary_message": "2 cups sauerkraut"
          },
          {
            "id": 448243,
            "primary_message": "Add parsley to the baking sheet with the veggies and sausage, then stir to combine.",
            "secondary_message": null
          },
          {
            "id": 448244,
            "primary_message": "To serve, divide sausage bake between plates or bowls. Drizzle with curry mayo and top with warm sauerkraut. Enjoy!",
            "secondary_message": null
          }
        ],
