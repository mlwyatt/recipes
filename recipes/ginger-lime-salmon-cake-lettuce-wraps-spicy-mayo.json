        "instructions": [
          {
            "id": 169908,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lime\n2 (1 inch) pieces ginger root\n1 jalapeño pepper\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 avocado\n2 medium carrots\n1 head butter (Boston) lettuce"
          },
          {
            "id": 169909,
            "primary_message": "Zest and juice the lime into a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 169910,
            "primary_message": "Peel and grate or mince the ginger; peel and mince garlic. Transfer both to the bowl with the lime.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 169911,
            "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
            "secondary_message": null
          },
          {
            "id": 169912,
            "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 169913,
            "primary_message": "Trim off and discard ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Add half to the bowl; reserve the rest for garnish.",
            "secondary_message": null
          },
          {
            "id": 169914,
            "primary_message": "Drain salmon. Add to the bowl along with the eggs, mayonnaise, bread crumbs, and salt; mash with a fork to combine.",
            "secondary_message": "2 (7.5 oz) cans wild pink salmon, traditional style\n2 eggs\n¼ cup mayonnaise\n½ cup panko bread crumbs\n¼ tsp salt"
          },
          {
            "id": 169915,
            "primary_message": "Using a ¼ cup measure, portion and form the salmon mixture into ½-inch thick patties.",
            "secondary_message": null
          },
          {
            "id": 169916,
            "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 169917,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, place patties in the skillet and cook until browned on the outside and warmed through, about 3 minutes per side. Remove to a plate. ",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 169918,
            "primary_message": "Meanwhile, halve and pit avocado; slice lengthwise and crosswise while still in the skin and scoop out with a spoon.",
            "secondary_message": null
          },
          {
            "id": 169919,
            "primary_message": "Trim off and discard ends of the carrots. Using a julienne (or regular) peeler, peel carrots into thin noodle-like sticks. ",
            "secondary_message": null
          },
          {
            "id": 169920,
            "primary_message": "In a small bowl mix together chili-garlic sauce and mayonnaise.",
            "secondary_message": "2 tsp chili-garlic sauce\n¼ cup mayonnaise"
          },
          {
            "id": 169921,
            "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Divide carrots, salmon cakes, and avocado between leaves; top with spicy mayo and reserved green onion. Enjoy!",
            "secondary_message": null
          }
        ],
