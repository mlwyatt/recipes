        "instructions": [
          {
            "id": 318383,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 318384,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n2 green bell peppers\n2 red bell peppers\n1 lb white mushrooms"
          },
          {
            "id": 318385,
            "primary_message": "Peel and mince ginger and garlic; place both in a small bowl along with soy sauce, vinegar, and honey. Whisk to combine the sauce.",
            "secondary_message": "4 cloves garlic\n¼ cup soy sauce\n2 tbsp rice vinegar\n4 tsp honey"
          },
          {
            "id": 318386,
            "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets; arrange in a large baking dish. Pour half of the sauce over the chicken and turn to coat (reserve remaining sauce for later use).",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 318387,
            "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until chicken is almost cooked through, 15-18 minutes.",
            "secondary_message": null
          },
          {
            "id": 318388,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 318389,
            "primary_message": "Once the skillet is hot, add bacon and cook until crispy, 3-5 minutes per side. Remove bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
            "secondary_message": "8 slices bacon"
          },
          {
            "id": 318390,
            "primary_message": "While the bacon cooks, using a clean cutting board, trim, seed, and thinly slice bell peppers; place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 318391,
            "primary_message": "Thinly slice mushrooms and add to the bowl with the bell peppers.",
            "secondary_message": null
          },
          {
            "id": 318392,
            "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the bowl.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 318393,
            "primary_message": "Return skillet (with drippings) to medium heat; add veggies and cook, stirring occasionally, until softened, 6-7 minutes.",
            "secondary_message": null
          },
          {
            "id": 318394,
            "primary_message": "Meanwhile, thinly slice cheese.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 318395,
            "primary_message": "When the chicken is almost cooked through, remove from oven. Change oven setting to broil on high.",
            "secondary_message": null
          },
          {
            "id": 318396,
            "primary_message": "Layer chicken with bacon and cheese. Return baking dish to the oven and broil until cheese is melted and chicken is cooked through, about 5 minutes; remove from oven.",
            "secondary_message": null
          },
          {
            "id": 318397,
            "primary_message": "When the veggies are done, add remaining sauce to the skillet, stir to combine, and continue to cook until heated through, 1-2 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 318398,
            "primary_message": "To serve, divide veggies and chicken between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
