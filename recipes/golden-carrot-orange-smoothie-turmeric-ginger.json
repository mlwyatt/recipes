        "instructions": [
          {
            "id": 104788,
            "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
            "secondary_message": null
          },
          {
            "id": 104789,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 oranges\n4 medium carrots\n2 (1 inch) pieces ginger root"
          },
          {
            "id": 104790,
            "primary_message": "Peel the oranges; remove the white pith, and cut into chunks. Add to blender.",
            "secondary_message": null
          },
          {
            "id": 104791,
            "primary_message": "Peel the carrots and ginger, and cut into chunks. Add to blender.",
            "secondary_message": null
          },
          {
            "id": 104792,
            "primary_message": "Add mango, almond milk, cashews, turmeric, and 4 ice cubes.",
            "secondary_message": "2 cup frozen mangoes\n24 fl oz (3 cups) almond milk, unsweetened\n1 cup cashews, roasted unsalted\n2 tsp turmeric"
          },
          {
            "id": 104793,
            "primary_message": "Blend on high speed for several minutes until smooth.",
            "secondary_message": null
          },
          {
            "id": 104794,
            "primary_message": "Pour the smoothie into glasses and enjoy!",
            "secondary_message": null
          }
        ],
