        "instructions": [
          {
            "id": 10874,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": ""
          },
          {
            "id": 10875,
            "primary_message": "Peel and mince garlic. In a small bowl, mix together garlic, oil, salt, and pepper.",
            "secondary_message": "6 cloves garlic\r\n2 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n⅛ tsp black pepper"
          },
          {
            "id": 10876,
            "primary_message": "Wash, dry, and halve tomatoes.",
            "secondary_message": "1 pint grape tomatoes"
          },
          {
            "id": 10877,
            "primary_message": "Measure out 2 cups of ricotta.",
            "secondary_message": "1 (15 oz) pkg ricotta cheese"
          },
          {
            "id": 10878,
            "primary_message": "Place flatbreads on a flat surface. Spoon oil and garlic mixture over top, add tomatoes, and finish off with spoonfuls of ricotta.",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 10879,
            "primary_message": "Place in the oven, directly on the rack, and bake until cheese melts, 8-10 minutes. Then broil for 1-2 minutes.",
            "secondary_message": ""
          },
          {
            "id": 10880,
            "primary_message": "Wash and dry arugula and basil. Pick basil leaves off the stems; discard the stems and thinly slice the leaves into ribbons.",
            "secondary_message": "1 (5 oz) pkg baby arugula\r\n1 small pkg fresh basil"
          },
          {
            "id": 10881,
            "primary_message": "In a small bowl, prepare salad dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
            "secondary_message": "3 tbsp extra virgin olive oil\r\n1 tbsp balsamic vinegar\r\n¼ tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
          },
          {
            "id": 10882,
            "primary_message": "Remove pizzas from oven and garnish with basil; slice into wedges.",
            "secondary_message": ""
          },
          {
            "id": 10883,
            "primary_message": "To serve, place pizza on a plate and have salad on the side. Enjoy!",
            "secondary_message": ""
          }
        ],
