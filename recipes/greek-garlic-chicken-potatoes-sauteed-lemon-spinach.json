        "instructions": [
          {
            "id": 215241,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 215242,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "6 medium yellow potatoes\n2 lemons\n2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 215243,
            "primary_message": "Slice potatoes into ¼-inch thick rounds; transfer to a large baking sheet pan. ",
            "secondary_message": null
          },
          {
            "id": 215244,
            "primary_message": "Peel and mince garlic. Add to the baking sheet with the potatoes along with oil and spices; toss to combine, then spread out in an even layer.",
            "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n1 tsp oregano\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 215245,
            "primary_message": "Place potatoes in the oven (it doesn't have to be fully heated) and bake for 6-8 minutes while you prepare the chicken.",
            "secondary_message": null
          },
          {
            "id": 215246,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 215247,
            "primary_message": "While the skillet heats up, pat the chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 215248,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet; cook until golden brown, about 2 minutes per side (the chicken will not be cooked all the way through).",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 215249,
            "primary_message": "Remove baking sheet from the oven and place seared chicken on top of the potatoes. Juice one of the lemons over the chicken and potatoes. Return to the oven and continue to bake until potatoes are tender and chicken is cooked through, 12-15 minutes.",
            "secondary_message": null
          },
          {
            "id": 215250,
            "primary_message": "When there are 5 minutes left on the potatoes and chicken, return skillet to medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 215251,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 215252,
            "primary_message": "Juice remaining lemon into the skillet and season with salt and pepper; stir to combine. ",
            "secondary_message": "½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 215253,
            "primary_message": "To serve, divide potatoes, chicken, and spinach between plates. Enjoy!",
            "secondary_message": null
          }
        ],
