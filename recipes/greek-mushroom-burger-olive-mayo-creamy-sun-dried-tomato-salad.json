        "instructions": [
          {
            "id": 258106,
            "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top. Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
            "secondary_message": null
          },
          {
            "id": 258107,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 caps portobello mushrooms\n1 lemon\n1 English cucumber\n2 tomatoes\n1 head butter (Boston) lettuce"
          },
          {
            "id": 258108,
            "primary_message": "Remove stems from the mushrooms and carefully scrape out the gills. Place on the baking sheet, rub both sides with oil, season with salt and pepper, and arrange gill-side down.",
            "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 258109,
            "primary_message": "Place mushrooms in the oven and broil until tops are soft, about 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 258110,
            "primary_message": "Meanwhile, mince olives and place in a small bowl.",
            "secondary_message": "¼ cup Kalamata olives, pitted"
          },
          {
            "id": 258111,
            "primary_message": "Zest lemon into the bowl with the olives (reserve lemon for later use); add mayo and spices. Stir to combine the olive mayo and set aside.",
            "secondary_message": "⅓ cup mayonnaise\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 258112,
            "primary_message": "When the tops of the mushrooms are soft, remove from the oven and flip. Fill mushrooms with half the feta (setting remaining feta aside for the dressing), return to the oven, and continue to broil until tender and cheese is golden, 4 minutes more. Remove from oven.",
            "secondary_message": "2 (4 oz) pkgs crumbled feta cheese"
          },
          {
            "id": 258113,
            "primary_message": "While the mushrooms are cooking, juice reserved lemon into a large bowl.",
            "secondary_message": null
          },
          {
            "id": 258114,
            "primary_message": "Mince sun-dried tomatoes and add to the bowl with the lemon juice. Add reserved feta, yogurt, oil, and spices; whisk to combine the dressing.",
            "secondary_message": "8 sun-dried tomatoes, oil-packed\n¼ cup plain Greek yogurt\n2 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 258115,
            "primary_message": "Trim and medium dice cucumber; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 258116,
            "primary_message": "Medium dice one tomato and add to the bowl. Thinly slice the remaining tomato and set aside for serving.",
            "secondary_message": null
          },
          {
            "id": 258117,
            "primary_message": "Separate the lettuce leaves. Set aside 1 leaf per burger and chop or tear remaining leaves into bite-sized pieces. Add chopped lettuce to the bowl, along with pine nuts, and toss to combine the salad.",
            "secondary_message": "½ cup pine nuts"
          },
          {
            "id": 258118,
            "primary_message": "Toast buns if desired.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 258119,
            "primary_message": "Spread olive mayo over the bottom half of each bun; top with feta-stuffed mushrooms, tomato, and reserved lettuce. Close with the top half of each bun.",
            "secondary_message": null
          },
          {
            "id": 258120,
            "primary_message": "To serve, divide mushroom burgers and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
