        "instructions": [
          {
            "id": 432447,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 432448,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 yellow bell peppers\n1 pint grape tomatoes\n1 lemon"
          },
          {
            "id": 432449,
            "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 432450,
            "primary_message": "Halve tomatoes lengthwise and add to the bowl with the bell pepper.",
            "secondary_message": null
          },
          {
            "id": 432451,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 432452,
            "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the other veggies.",
            "secondary_message": "1 medium red onion\n2 cloves garlic"
          },
          {
            "id": 432453,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, basil, and salt; cook, stirring occasionally, until starting to soften, 4-5 minutes. Remove from heat. (Reserve bowl for next step.)",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp basil, dried\n½ tsp salt"
          },
          {
            "id": 432454,
            "primary_message": "Meanwhile, drain and rinse chickpeas; place in the reserved bowl.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 432455,
            "primary_message": "Juice lemon into the bowl with the chickpeas, then add tahini, oil, and spices. Using a fork or potato masher, roughly mash chickpeas until semi-smooth and set aside.",
            "secondary_message": "¼ cup tahini\n2 tbsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 432456,
            "primary_message": "Coarsely grate cheese.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 432457,
            "primary_message": "Halve olives lengthwise.",
            "secondary_message": "¼ cup Kalamata olives, pitted"
          },
          {
            "id": 432458,
            "primary_message": "Arrange pitas on a large baking sheet pan; evenly top with chickpea spread, then cheese, veggies, and olives.",
            "secondary_message": "4 whole grain pitas"
          },
          {
            "id": 432459,
            "primary_message": "Place baking sheet in the oven and bake until pizzas are warmed through and cheese is melted, 6-8 minutes. Remove from oven and cut into wedges.",
            "secondary_message": null
          },
          {
            "id": 432460,
            "primary_message": "To serve, divide pizzas between plates. Enjoy!",
            "secondary_message": null
          }
        ],
