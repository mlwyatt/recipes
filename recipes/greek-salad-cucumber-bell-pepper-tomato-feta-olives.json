        "instructions": [
          {
            "id": 375404,
            "primary_message": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp oregano, dried"
          },
          {
            "id": 375405,
            "primary_message": "Peel, halve, and slice shallot crosswise into thin half moons. Add to the bowl with the dressing and stir to coat. Set aside.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 375406,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 tomatoes\n1 green bell pepper\n1 English cucumber"
          },
          {
            "id": 375407,
            "primary_message": "Large dice tomatoes. Add to the bowl with the dressing and shallot.",
            "secondary_message": null
          },
          {
            "id": 375408,
            "primary_message": "Trim, seed, and large dice bell pepper. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 375409,
            "primary_message": "Trim and large dice cucumber. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 375410,
            "primary_message": "Halve olives lengthwise. Add to the bowl, along with the feta, and stir to combine the salad.",
            "secondary_message": "½ cup Kalamata olives, pitted\n1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 375411,
            "primary_message": "To serve, divide salad between bowls and enjoy!",
            "secondary_message": null
          }
        ],
