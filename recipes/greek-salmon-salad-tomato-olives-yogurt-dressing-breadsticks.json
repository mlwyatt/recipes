        "instructions": [
          {
            "id": 438198,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 438199,
            "primary_message": "Drizzle oil over flatbread, season with spices, and cut into 1½-inch wide strips; transfer to a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from oven.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 flatbreads or naan\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 438200,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 438201,
            "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate. Season with spices on the top-side.",
            "secondary_message": "1 ½ lb salmon fillet\n1 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 438202,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon, skin-side down, and cook until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 438203,
            "primary_message": "While the salmon is cooking, wash and dry the fresh produce.",
            "secondary_message": "1 small bunch fresh dill\n1 lemon\n1 English cucumber\n1 pint grape tomatoes\n2 heads romaine lettuce"
          },
          {
            "id": 438204,
            "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl. ",
            "secondary_message": null
          },
          {
            "id": 438205,
            "primary_message": "Juice lemon into the bowl with the dill.",
            "secondary_message": null
          },
          {
            "id": 438206,
            "primary_message": "Peel and mince shallot. Add to the bowl along with yogurt, water, salt, and pepper; stir to combine the dressing. ",
            "secondary_message": "1 shallot\n½ cup plain Greek yogurt\n2 tbsp water\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 438207,
            "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 438208,
            "primary_message": "Halve grape tomatoes and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 438209,
            "primary_message": "Roughly chop olives and add to the bowl. ",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 438210,
            "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad. ",
            "secondary_message": null
          },
          {
            "id": 438211,
            "primary_message": "Using a fork or your hands, flake the salmon into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 438212,
            "primary_message": "Divide salad between plates or bowls and top with salmon. Serve with breadsticks on the side and enjoy!",
            "secondary_message": null
          }
        ],
