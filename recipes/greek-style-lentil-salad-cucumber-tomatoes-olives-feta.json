        "instructions": [
          {
            "id": 42746,
            "primary_message": "Rinse the lentils, then transfer to a small saucepan and cover with hot water (from the tap) by about 2 inches. Bring to a boil over high heat, then reduce to a simmer and cook until just tender, 15 to 20 minutes. Drain in a colander, rinse under cold water, and set aside to cool and drain further.",
            "secondary_message": "1 ½ cups green lentils"
          },
          {
            "id": 42747,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 pint grape tomatoes\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 42748,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 42749,
            "primary_message": "In a large salad bowl, combine and whisk together the minced garlic, olive oil, vinegar, Dijon, salt, and pepper.",
            "secondary_message": "6 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n2 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 42750,
            "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into ¼-inch-thick pieces at an angle and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 42751,
            "primary_message": "Halve the grape tomatoes crosswise and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 42752,
            "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 42753,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; quarter the onion lengthwise, then thinly slice crosswise into quarter-rings. Add to the salad bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 42754,
            "primary_message": "Halve the olives lengthwise and add to the salad bowl.",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 42755,
            "primary_message": "Measure out the feta and transfer to a small bowl.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 42756,
            "primary_message": "To serve, divide the salad between bowls or plates and top with the feta. Enjoy!",
            "secondary_message": null
          }
        ],
