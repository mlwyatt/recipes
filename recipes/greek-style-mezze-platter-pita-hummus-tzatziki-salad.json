        "instructions": [
          {
            "id": 371583,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 orange bell peppers\n1 English cucumber\n4 hearts romaine hearts"
          },
          {
            "id": 371584,
            "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Place in a large bowl. ",
            "secondary_message": null
          },
          {
            "id": 371585,
            "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper. ",
            "secondary_message": null
          },
          {
            "id": 371586,
            "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 371587,
            "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl. ",
            "secondary_message": "2 shallots"
          },
          {
            "id": 371588,
            "primary_message": "Drain and roughly chop artichokes. Add to the bowl. ",
            "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
          },
          {
            "id": 371589,
            "primary_message": "Roughly chop olives. Add to the bowl, along with the feta, vinaigrette, and oregano. Toss to combine the salad and set aside.",
            "secondary_message": "⅔ cup Kalamata olives, pitted\n1 (4 oz) pkg crumbled feta cheese\n½ cup balsamic vinaigrette\n1 tsp oregano, dried"
          },
          {
            "id": 371590,
            "primary_message": "Toast pita if desired, then cut into wedges. ",
            "secondary_message": "4 whole grain pitas"
          },
          {
            "id": 371591,
            "primary_message": "Divide salad and pita between plates; serve with hummus and tzatziki. Enjoy!",
            "secondary_message": "1 cup hummus\n1 cup tzatziki sauce"
          }
        ],
