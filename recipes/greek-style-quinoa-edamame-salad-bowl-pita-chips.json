        "instructions": [
          {
            "id": 234931,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 234932,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 234933,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n1 small bunch fresh dill\n1 English cucumber\n2 red bell peppers"
          },
          {
            "id": 234934,
            "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
            "secondary_message": "1 ½ cups edamame"
          },
          {
            "id": 234935,
            "primary_message": "Place pita on a flat surface. Holding a knife parallel to the cutting board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces and place on a large baking sheet pan.",
            "secondary_message": "2 whole grain pitas"
          },
          {
            "id": 234936,
            "primary_message": "Zest lemon into a large bowl. Add oil and spices to the bowl, then stir to combine the herb oil. (Reserve lemon for the salad.)",
            "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp basil, dried\n⅛ tsp oregano, dried"
          },
          {
            "id": 234937,
            "primary_message": "Spoon herb oil over the pita. Toss pita with your hands, then spread out in an even layer. Transfer to the oven and bake, flipping halfway through, until the pita chips are crisp, 6-8 minutes. Remove from the oven and set aside to cool.",
            "secondary_message": null
          },
          {
            "id": 234938,
            "primary_message": "Meanwhile, juice lemon into the bowl used for the herb oil.",
            "secondary_message": null
          },
          {
            "id": 234939,
            "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice along with yogurt, oil, vinegar, salt, and pepper. Whisk to combine the dressing.",
            "secondary_message": "½ cup plain Greek yogurt\n2 tsp extra virgin olive oil\n2 tsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 234940,
            "primary_message": "Thinly slice olives and add to the bowl with the dressing.",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 234941,
            "primary_message": "Peel and small dice shallots; add to the bowl.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 234942,
            "primary_message": "Trim and medium dice cucumber; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 234943,
            "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl, along with the edamame, and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 234944,
            "primary_message": "To serve, divide quinoa, edamame salad, and pita chips between plates or bowls. Top with feta cheese and enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          }
        ],
