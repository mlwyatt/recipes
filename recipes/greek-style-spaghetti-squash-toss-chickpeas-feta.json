        "instructions": [
          {
            "id": 47072,
            "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line a baking sheet with aluminum foil to make cleanup easier (optional).",
            "secondary_message": null
          },
          {
            "id": 47073,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 medium spaghetti squash\n1 (5 oz) pkg baby spinach\n1 pint grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n"
          },
          {
            "id": 47074,
            "primary_message": "Halve the squash lengthwise and scrape out the seeds; Rub each half with olive oil and season with salt and freshly ground pepper. Place halves, cut side down, on a baking sheet.",
            "secondary_message": "2 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 47076,
            "primary_message": "Place the squash in the oven (it doesn't have to be fully heated) and roast until tender so a knife can easily pierce though the flesh, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 47077,
            "primary_message": "Drain and rinse the chickpeas in a colander, then set aside to drain further.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 47078,
            "primary_message": "Halve the tomatoes crosswise and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 47079,
            "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the bowl with the tomatoes.",
            "secondary_message": null
          },
          {
            "id": 47080,
            "primary_message": "Quarter the olives lengthwise and add to the bowl with the tomatoes and parsley.",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 47081,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 47082,
            "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces).",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 47083,
            "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 47084,
            "primary_message": "Add the onion to the skillet; cook, stirring frequently, until softened, 4-5 minutes.",
            "secondary_message": null
          },
          {
            "id": 47085,
            "primary_message": "While the onion cooks, trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 47086,
            "primary_message": "Add the garlic and oregano to the skillet; stir until fragrant, 15-30 seconds.",
            "secondary_message": "1 tsp oregano"
          },
          {
            "id": 47087,
            "primary_message": "Add the chickpeas, spinach, tomatoes, parsley, and olives to the skillet; season with salt and pepper and stir to combine. Cook, stirring frequently, until the mixture is heated through and the spinach is wilted, 2-3 minutes. Remove from the heat.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 47088,
            "primary_message": "Remove the squash from the oven; allow squash to cool slightly, about 5 minutes. Using a fork, scrape up the squash flesh to make spaghetti-like strings (use an oven mitt or towel to hold it with your other hand).",
            "secondary_message": null
          },
          {
            "id": 47089,
            "primary_message": "Add the squash to the vegetable mixture and toss to combine.",
            "secondary_message": null
          },
          {
            "id": 47090,
            "primary_message": "To serve, divide the squash and vegetable mixture between plates or bowls and top with the feta cheese. Enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          }
        ],
