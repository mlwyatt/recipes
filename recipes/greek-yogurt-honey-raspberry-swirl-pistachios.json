        "instructions": [
          {
            "id": 374285,
            "primary_message": "Wash and dry raspberries. Place in a medium bowl along with honey and cinnamon. Using a fork or potato masher, gently crush the raspberries until they reach a chunky, jam-like consistency. Set aside.",
            "secondary_message": "2 (6 oz) pkgs raspberries\n2 tbsp honey\n¼ tsp cinnamon, ground"
          },
          {
            "id": 374286,
            "primary_message": "Roughly chop pistachios.",
            "secondary_message": "½ cup pistachios, unsalted"
          },
          {
            "id": 374287,
            "primary_message": "To serve, divide yogurt between bowls. Top with crushed raspberries, then swirl with the yogurt using a spoon. Sprinkle with pistachios and enjoy!",
            "secondary_message": "3 cups plain Greek yogurt"
          }
        ],
