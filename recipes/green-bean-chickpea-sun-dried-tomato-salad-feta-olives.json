  "instructions": [
    {
      "id": 25420,
      "primary_message": "Preheat the oven to 400°F and position rack in the centre. Line a baking sheet with parchment paper.",
      "secondary_message": ""
    },
    {
      "id": 25421,
      "primary_message": "Rinse the green beans. Trim ends, halve, and transfer to the baking sheet. Drizzle with olive oil and season with salt and pepper; toss to coat.",
      "secondary_message": "1 lb green beans\r\n2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n½ tsp black pepper\r\n"
    },
    {
      "id": 25422,
      "primary_message": "Place in the oven and roast until lightly charred, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25423,
      "primary_message": "Rinse the chickpeas and set aside to drain.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\r\n"
    },
    {
      "id": 25424,
      "primary_message": "Peel and mince the garlic. Grate zest from the lemon. In a large bowl, whisk together the minced garlic, lemon zest and juice, olive oil, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\nzest and juice of 1 lemon\r\n2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25425,
      "primary_message": "Wash the tomatoes and parsley. Halve the tomatoes and add to the bowl. Shave the parsley leaves off the stems; discard the stems, chop the leaves, and add to the bowl.",
      "secondary_message": "1 pint grape tomatoes\r\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 25426,
      "primary_message": "Halve the olives and add to the bowl.",
      "secondary_message": "1 cup Kalamata olives, pitted\r\n"
    },
    {
      "id": 25427,
      "primary_message": "Thinly slice the sun-dried tomatoes and add to the bowl.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 25428,
      "primary_message": "Stir in the chickpeas, green beans, and feta. Toss to coat.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese\r\n"
    },
    {
      "id": 25429,
      "primary_message": "To serve, place salad on a plate and enjoy!",
      "secondary_message": ""
    }
  ],
