        "instructions": [
          {
            "id": 128602,
            "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 128603,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "1 small pkg fresh basil\n1 lb green beans\n1 Granny Smith apple\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 128604,
            "primary_message": "Finely grate the Parmesan; transfer to a small bowl.",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 128605,
            "primary_message": "Peel and mince the garlic. Pick the basil leaves off the stems; discard the stems and mince the leaves. Add both to the bowl with the parmesan.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 128606,
            "primary_message": "Trim and discard the ends of the green beans. Once the water in the saucepan is boiling, add the beans and cook until bright green and tender-crisp, 3-4 minutes. Drain and set aside.",
            "secondary_message": null
          },
          {
            "id": 128607,
            "primary_message": "Finely chop the pine nuts.",
            "secondary_message": "¼ cup pine nuts"
          },
          {
            "id": 128608,
            "primary_message": "Add pine nuts, oil, salt, and pepper to the bowl with the Parmesan and stir to combine the pesto; set aside.",
            "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 128609,
            "primary_message": "Coarsely grate the cheddar.",
            "secondary_message": "1 (8 oz) block cheddar cheese"
          },
          {
            "id": 128610,
            "primary_message": "Divide pesto among bread slices and top half of them with half of the cheddar. Arrange green beans on top of the cheddar so that they all face the same direction. Cover with remaining cheese and close sandwiches; press to secure ingredients.",
            "secondary_message": "8 slices whole grain bread"
          },
          {
            "id": 128611,
            "primary_message": "Preheat a large skillet over medium-low heat.",
            "secondary_message": null
          },
          {
            "id": 128612,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook, flipping once, until bread is golden brown and cheese is melted, 3-4 minutes per side. Cook in batches if necessary. Once done, transfer to a cutting board; slice sandwiches on the diagonal. ",
            "secondary_message": "4 tsp butter, unsalted"
          },
          {
            "id": 128613,
            "primary_message": "Meanwhile, combine oil, vinegar, maple syrup, salt, and pepper in a large bowl; whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 128614,
            "primary_message": "Core and thinly slice apple; add apple and mixed greens to the bowl with the dressing; toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 128615,
            "primary_message": "To serve, divide the salad and sandwiches between plates. Enjoy!",
            "secondary_message": null
          }
        ],
