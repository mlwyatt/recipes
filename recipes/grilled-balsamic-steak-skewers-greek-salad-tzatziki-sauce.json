        "instructions": [
          {
            "id": 327297,
            "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 327298,
            "primary_message": "Pat steak dry with paper towels, cut into 1-inch cubes, and season with salt; thread onto skewers, place on a plate, and drizzle with vinaigrette. (If you don't have skewers, you can cook the steak directly on the grill pan.)",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n3 tbsp balsamic vinaigrette"
          },
          {
            "id": 327299,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 327300,
            "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add the skewers and cook, turning occasionally, until the steak is cooked through, 8-10 minutes. Remove to a clean plate.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 327301,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 English cucumber\n2 yellow bell peppers\n1 pint grape tomatoes"
          },
          {
            "id": 327302,
            "primary_message": "Using a clean cutting board, trim and medium dice cucumber; trim, seed, and medium dice bell peppers. Place both in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 327303,
            "primary_message": "Halve tomatoes and add to the bowl with the other veggies.",
            "secondary_message": null
          },
          {
            "id": 327304,
            "primary_message": "Thinly slice olives and add to the bowl.",
            "secondary_message": "¼ cup Kalamata olives, pitted"
          },
          {
            "id": 327305,
            "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl along with the feta and vinaigrette. Stir to combine the salad.",
            "secondary_message": "1 shallot\n1 (4 oz) pkg crumbled feta cheese\n3 tbsp balsamic vinaigrette"
          },
          {
            "id": 327306,
            "primary_message": "To serve, divide skewers, salad, and tzatziki between plates. Enjoy!",
            "secondary_message": "1 cup tzatziki sauce"
          }
        ],
