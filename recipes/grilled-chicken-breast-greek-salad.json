  "instructions": [
    {
      "id": 13188,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 13189,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with Italian seasoning, salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 13190,
      "primary_message": "Coat grill or bottom of skillet with oil. Add chicken and cook until cooked through, 2-3 minutes per side.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 13191,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by whisking together garlic, oil, vinegar, oregano, salt, and pepper.",
      "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 13192,
      "primary_message": "Wash and dry cucumber, bell peppers, and tomatoes. Medium dice cucumber. Seed and medium dice peppers. Halve tomatoes. Peel and medium dice onion. Add everything to bowl with dressing.",
      "secondary_message": "1 English cucumber\r\n2 red bell peppers\r\n1 pint grape tomatoes\r\n1 medium red onion"
    },
    {
      "id": 13193,
      "primary_message": "Add olives to bowl and toss salad.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 13194,
      "primary_message": "To serve, place chicken and greek salad on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
