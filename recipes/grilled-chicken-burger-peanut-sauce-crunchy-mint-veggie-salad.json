  "instructions": [
    {
      "id": 280593,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 pint grape tomatoes\n2 orange bell peppers\n1 English cucumber\n1 small pkg fresh mint"
    },
    {
      "id": 280594,
      "primary_message": "Juice lime into a small bowl; add peanut butter, soy sauce, honey, water, and spices. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "¼ cup natural peanut butter\n4 tsp soy sauce\n1 tbsp honey\n2 tsp water\n¼ tsp turmeric, ground\n⅛ tsp curry powder\n⅛ tsp coriander, ground"
    },
    {
      "id": 280595,
      "primary_message": "Peel and mince garlic; place in a medium bowl along with soy sauce, oil, and crushed red pepper. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n4 tsp soy sauce\n1 tbsp extra virgin olive oil\n¼ tsp crushed red pepper"
    },
    {
      "id": 280596,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Add to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 280597,
      "primary_message": "Place oil, mayo, vinegar, salt, and pepper in another medium bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp mayonnaise\n2 tsp rice vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 280598,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 280599,
      "primary_message": "Once the grill pan is hot, add chicken and cook until charred and cooked through, 3-4 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 280600,
      "primary_message": "While the chicken is cooking, using a clean cutting board, peel, halve, and thinly slice shallots into half-moons; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 280601,
      "primary_message": "Quarter tomatoes. Trim, seed, and small dice bell peppers; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 280602,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into ¼-inch-thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 280603,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 280604,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 280605,
      "primary_message": "Spread half of the peanut sauce over the bottom half of each bun; top with chicken and remaining sauce. Close with the top half of each bun.",
      "secondary_message": null
    },
    {
      "id": 280606,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
