  "instructions": [
    {
      "id": 445108,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 orange\n2 (6 oz) pkgs raspberries\n2 red bell peppers\n2 small bunches asparagus"
    },
    {
      "id": 445109,
      "primary_message": "Juice orange into a blender.",
      "secondary_message": null
    },
    {
      "id": 445110,
      "primary_message": "Peel garlic; add to the blender with the orange juice along with raspberries, ketchup, sugar, Worcestershire, and spices. Blend on high until BBQ sauce is very smooth, about 1 minute; set aside.",
      "secondary_message": "2 cloves garlic\n¼ cup ketchup\n4 tsp brown sugar\n1 tsp Worcestershire sauce\n½ tsp cumin, ground\n¼ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 445111,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445112,
      "primary_message": "While the grill pan heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides. ",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445113,
      "primary_message": "Once the grill pan is hot, coat with oil; add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 445114,
      "primary_message": "Meanwhile, using a clean cutting board, trim, halve, seed, and slice bell peppers crosswise into 1-inch wide strips; place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 445115,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 445116,
      "primary_message": "Peel, halve, and slice onion lengthwise into ½-inch thick wedges; add to the bowl. Drizzle veggies with oil, season with salt and pepper, then gently toss to coat.",
      "secondary_message": "1 medium red onion\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 445117,
      "primary_message": "Once the chicken is done, working in batches if necessary, add veggies to the pan; grill, flipping once, until tender, 2-3 minutes per side. Return to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 445118,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 445119,
      "primary_message": "To assemble the burgers, spread 1 tablespoon of BBQ sauce over the bottom half of each bun; top with chicken and another 1 tablespoon of the sauce. Close with the top half of each bun. (Reserve remaining sauce for serving.)",
      "secondary_message": null
    },
    {
      "id": 445120,
      "primary_message": "Divide burgers and grilled veggies between plates; serve with remaining sauce on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
