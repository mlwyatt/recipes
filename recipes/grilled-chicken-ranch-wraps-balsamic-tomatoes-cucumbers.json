  "instructions": [
    {
      "id": 128769,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Pat dry with paper towel and season both sides with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 128770,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 128771,
      "primary_message": "When the grill pan or skillet is hot, drizzle with oil and add fillets. Grill until cooked through, about 3-4 minutes per side. When the chicken is done, set aside on a plate and cover with aluminum foil. Wipe out and reserve pan for use later.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 128772,
      "primary_message": "Wash and dry the cucumber and tomatoes. Cut the tomatoes into wedges and the cucumber into thin, half moons; set aside.",
      "secondary_message": "1 English cucumber\n2 tomatoes"
    },
    {
      "id": 128773,
      "primary_message": "Add vinegar to a small saucepan and bring to a boil over medium-high heat. Once boiling, reduce to medium-low and continue to simmer, uncovered, until reduced by half, 5-7 minutes; remove from heat and set aside.",
      "secondary_message": "½ cup balsamic vinegar"
    },
    {
      "id": 128774,
      "primary_message": "Combine mayonnaise and spices in a small bowl; whisk to combine the ranch dressing.",
      "secondary_message": "⅓ cup mayonnaise\n1 tsp dill\n¼ tsp parsley flakes\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 128775,
      "primary_message": "Grate cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 128776,
      "primary_message": "Wash and dry spinach. (Skip if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 128777,
      "primary_message": "Thinly slice the cooked chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 128778,
      "primary_message": "Lay the tortillas on a flat surface and divide spinach, chicken, grated cheese, and ranch dressing between them. Roll tightly to close. ",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 128779,
      "primary_message": "Return grill pan or regular skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 128780,
      "primary_message": "Place wraps on the grill and cook, rotating every 1-2 minutes, until tortilla is crispy and golden. Cut each wrap in half.",
      "secondary_message": null
    },
    {
      "id": 128781,
      "primary_message": "To serve, divide wraps and veggies between plates. Drizzle veggies with balsamic reduction and enjoy!",
      "secondary_message": null
    }
  ],
