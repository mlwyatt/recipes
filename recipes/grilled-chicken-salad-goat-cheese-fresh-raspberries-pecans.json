        "instructions": [
          {
            "id": 372753,
            "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin cutlets. Season chicken with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 372754,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 372755,
            "primary_message": "Once the pan is hot, coat with oil. Add chicken to the pan and grill, turning once, until cooked through, 3-4 minutes per side.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 372756,
            "primary_message": "Meanwhile, wash and dry mixed greens (skip if they came pre-washed). Place in a large bowl.",
            "secondary_message": "2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 372757,
            "primary_message": "Wash and dry raspberries. Add to the bowl with the mixed greens.",
            "secondary_message": "2 (6 oz) pkgs raspberries"
          },
          {
            "id": 372758,
            "primary_message": "Using a clean cutting board, roughly chop pecans. Add to the bowl.",
            "secondary_message": "½ cup pecan halves"
          },
          {
            "id": 372759,
            "primary_message": "When the chicken is done, transfer to a cutting board and cut into thin strips.",
            "secondary_message": null
          },
          {
            "id": 372760,
            "primary_message": "Add chicken and vinaigrette to the bowl, then toss to combine the salad.",
            "secondary_message": "⅓ cup French vinaigrette"
          },
          {
            "id": 372761,
            "primary_message": "To serve, divide salad between plates or bowls, crumble goat cheese over top, and enjoy!",
            "secondary_message": "1 (4 oz) log goat cheese"
          }
        ],
