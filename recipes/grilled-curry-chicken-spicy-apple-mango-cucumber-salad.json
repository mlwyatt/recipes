  "instructions": [
    {
      "id": 485534,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 (1 inch) pieces ginger root\n2 mangoes\n4 Gala apples\n1 English cucumber\n2 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 485535,
      "primary_message": "Zest lemon into a medium bowl. (Reserve lemon for later use.)",
      "secondary_message": null
    },
    {
      "id": 485536,
      "primary_message": "Peel and mince ginger and garlic. Add to the bowl with the lemon zest, along with yogurt and spices. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n½ cup plain Greek yogurt\n2 tsp garam masala\n2 tsp curry powder\n1 tsp salt"
    },
    {
      "id": 485537,
      "primary_message": "Pat chicken thighs dry with paper towels. Add to the bowl with the marinade and, using your hands, toss to coat.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 485538,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485539,
      "primary_message": "While the pan heats up, juice reserved lemon into a clean medium bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 485540,
      "primary_message": "Once the grill pan is hot, coat with oil. Add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 485541,
      "primary_message": "Meanwhile, peel mangos and slice flesh away from the pits, starting with the flat sides; roughly chop the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 485542,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 485543,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 485544,
      "primary_message": "Thinly slice jalapeño peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 485545,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 485546,
      "primary_message": "To serve, divide grilled chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
