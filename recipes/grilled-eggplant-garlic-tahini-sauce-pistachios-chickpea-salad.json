  "instructions": [
    {
      "id": 349759,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 eggplants\n2 lemons\n1 English cucumber\n1 pint grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 349760,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349761,
      "primary_message": "While the pan heats up, trim and slice eggplants lengthwise into ½-inch thick planks; place on a plate. Drizzle with oil, then season with salt and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 349762,
      "primary_message": "Once the pan is hot, working in batches if necessary, add eggplant and grill, flipping once, until lightly charred and tender, 6-8 minutes. Return to the plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 349763,
      "primary_message": "Meanwhile, drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 349764,
      "primary_message": "Juice one lemon into a small bowl. (Reserve remaining lemon for later use.)",
      "secondary_message": null
    },
    {
      "id": 349765,
      "primary_message": "Add yogurt, water, tahini, sugar, and spices to the bowl with the lemon juice. Whisk to combine the tahini sauce and set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n¼ cup water\n2 tbsp tahini\n1 tsp brown sugar\n1 tsp garlic powder\n½ tsp salt\n½ tsp cumin, ground"
    },
    {
      "id": 349766,
      "primary_message": "Juice remaining lemon into a medium bowl. Add oil, additional tahini, and spices; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp tahini\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 349767,
      "primary_message": "Trim and small dice cucumber; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 349768,
      "primary_message": "Halve tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349769,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, along with chickpeas, and stir to combine the salad; set aside. ",
      "secondary_message": null
    },
    {
      "id": 349770,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 349771,
      "primary_message": "To serve, divide grilled eggplant and salad between plates. Spoon tahini sauce over eggplant and sprinkle with pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
