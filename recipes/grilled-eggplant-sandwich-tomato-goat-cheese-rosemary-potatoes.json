        "instructions": [
          {
            "id": 216216,
            "primary_message": "Preheat oven to 425°F. Line a large baking sheet pan with parchment paper.",
            "secondary_message": null
          },
          {
            "id": 216217,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium yellow potatoes\n1 eggplant\n4 tomatoes"
          },
          {
            "id": 216218,
            "primary_message": "Slice potatoes into thin wedges and transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 216219,
            "primary_message": "Peel and mince garlic. Add to the bowl with the potatoes, along with oil, rosemary, and salt; toss to combine and spread out in a single layer on the baking sheet.",
            "secondary_message": "4 cloves garlic\n4 tsp extra virgin olive oil\n2 tsp rosemary\n½ tsp salt"
          },
          {
            "id": 216220,
            "primary_message": "Place potatoes in the oven and bake, tossing once, until tender and golden, 25-30 minutes.",
            "secondary_message": null
          },
          {
            "id": 216221,
            "primary_message": "Meanwhile, trim, halve, and cut eggplant into ¼-inch-thick slices. Transfer to the bowl used for the potatoes.",
            "secondary_message": null
          },
          {
            "id": 216222,
            "primary_message": "Add oil, vinegar, and salt to the bowl; toss to combine.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n½ tsp salt"
          },
          {
            "id": 216223,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 216224,
            "primary_message": "Once the grill pan is hot, add eggplant and grill until tender, flipping once, 3-4 minutes per side. Work in batches if necessary.",
            "secondary_message": null
          },
          {
            "id": 216225,
            "primary_message": "Meanwhile, place goat cheese, oil, and Italian seasoning in a small bowl. Stir to combine and set aside.",
            "secondary_message": "2 (4 oz) logs goat cheese\n2 tbsp extra virgin olive oil\n2 tsp Italian seasoning"
          },
          {
            "id": 216226,
            "primary_message": "Thinly slice tomatoes.",
            "secondary_message": null
          },
          {
            "id": 216227,
            "primary_message": "If desired, place buns, cut-side down, on the grill pan to toast, 1-2 minutes.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 216228,
            "primary_message": "Spread buns evenly with goat cheese. Top the bottom halves with eggplant and tomato, closing with the top half of the bun.",
            "secondary_message": null
          },
          {
            "id": 216229,
            "primary_message": "To serve, divide sandwiches and potato wedges between plates. Enjoy!",
            "secondary_message": null
          }
        ],
