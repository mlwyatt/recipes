  "instructions": [
    {
      "id": 227386,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 jalapeño peppers\n½ lb red grapes\n1 small bunch cilantro\n2 avocados"
    },
    {
      "id": 227387,
      "primary_message": "Juice limes into a medium bowl. Add honey and spices; whisk to combine the dressing.",
      "secondary_message": "1 tsp honey\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 227388,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 227389,
      "primary_message": "Peel and mince garlic and shallots. Add both to the bowl.",
      "secondary_message": "2 cloves garlic\n2 shallots"
    },
    {
      "id": 227390,
      "primary_message": "Thinly slice grapes and add to the bowl. Stir to combine, then set aside.",
      "secondary_message": null
    },
    {
      "id": 227391,
      "primary_message": "Meanwhile, place oil and spices in a large bowl; stir to combine the spice paste.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp coriander, ground\n½ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 227392,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 227393,
      "primary_message": "While the grill pan heats up, place tilapia in the bowl with the spice paste and turn to coat.",
      "secondary_message": "1 ½ lb tilapia fillet"
    },
    {
      "id": 227394,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add the tilapia and grill until the flesh is opaque and flakey, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 227395,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the grapes.",
      "secondary_message": null
    },
    {
      "id": 227396,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl and stir to combine the salsa.",
      "secondary_message": null
    },
    {
      "id": 227397,
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 227398,
      "primary_message": "Use a fork to break the tilapia into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 227399,
      "primary_message": "To serve, divide tortillas between plates; fill with grilled tilapia and salsa. Enjoy!",
      "secondary_message": null
    }
  ],
