        "instructions": [
          {
            "id": 320912,
            "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 320913,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
          },
          {
            "id": 320914,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 320915,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n1 small pineapple\n1 small head red cabbage"
          },
          {
            "id": 320916,
            "primary_message": "Peel and mince garlic; place in a medium bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 320917,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic. ",
            "secondary_message": null
          },
          {
            "id": 320918,
            "primary_message": "Juice lemon into the bowl, then add oil, salt, and pepper; whisk to combine the marinade.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 320919,
            "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry. Add to the bowl with the marinade, stir to combine, and set aside.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 320920,
            "primary_message": "Place yogurt, coconut, mayo, vinegar, Dijon, and salt in a large bowl; whisk to combine the dressing. ",
            "secondary_message": "⅔ cup plain Greek yogurt\n¼ cup shredded unsweetened coconut\n¼ cup mayonnaise\n2 tbsp apple cider vinegar\n4 tsp Dijon mustard\n½ tsp salt"
          },
          {
            "id": 320921,
            "primary_message": "Cut off skin from pineapple; quarter, core, and small dice. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 320922,
            "primary_message": "Halve cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips. Add to the bowl, stir to combine the slaw, and set aside.",
            "secondary_message": null
          },
          {
            "id": 320923,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 320924,
            "primary_message": "While the pan heats up, thread shrimp onto skewers. Alternatively, you can cook the shrimp directly on the pan without using skewers.",
            "secondary_message": null
          },
          {
            "id": 320925,
            "primary_message": "Once the pan is hot, working in batches if necessary, add skewers; grill, turning occasionally, until shrimp are cooked through, about 5 minutes. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 320926,
            "primary_message": "To serve, divide rice and slaw between plates; top with shrimp skewers and enjoy! ",
            "secondary_message": null
          }
        ],
