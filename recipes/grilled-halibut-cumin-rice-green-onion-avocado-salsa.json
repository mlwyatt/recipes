        "instructions": [
          {
            "id": 250504,
            "primary_message": "Peel and mince garlic; place in a medium saucepan.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 250505,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to the saucepan with the garlic. Add water and spices; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 250506,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small bunch green onions (scallions)\n2 avocados\n2 jalapeño peppers\n1 lime"
          },
          {
            "id": 250507,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 250508,
            "primary_message": "Place corn in the colander and run under hot water (from the tap); set aside to drain.",
            "secondary_message": "2 cups frozen corn"
          },
          {
            "id": 250509,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 250510,
            "primary_message": "While the grill pan heats up, trim green onions.",
            "secondary_message": null
          },
          {
            "id": 250511,
            "primary_message": "Once the grill pan is hot, coat with oil. Add green onions and grill, turning occasionally, until charred and tender, about 5 minutes. Remove to a cutting board to cool slightly.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 250512,
            "primary_message": "While the onions are grilling, halve and pit the avocados; scoop out the flesh with a spoon and small dice. Transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 250513,
            "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl with the avocado. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 250514,
            "primary_message": "Drain tomatoes and add to the bowl along with the corn and spices; stir to combine the salsa and set aside.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 250515,
            "primary_message": "Pat halibut dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb halibut fillet\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 250516,
            "primary_message": "Return grill pan to medium-high heat and coat with more oil. Add halibut and grill, flipping once, until fish flakes easily with a fork, 4-5 minutes per side. Remove from heat.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 250517,
            "primary_message": "Meanwhile, chop grilled onions into 1-inch pieces, add to the salsa, and gently stir to combine.",
            "secondary_message": null
          },
          {
            "id": 250518,
            "primary_message": "Cut lime into wedges.",
            "secondary_message": null
          },
          {
            "id": 250519,
            "primary_message": "To serve, divide rice, salsa, and halibut between plates. Squeeze lime over top and enjoy!",
            "secondary_message": null
          }
        ],
