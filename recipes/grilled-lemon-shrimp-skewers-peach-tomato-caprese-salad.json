        "instructions": [
          {
            "id": 189139,
            "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 189140,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place in a large bowl.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 189141,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n4 peaches\n4 tomatoes\n1 pint grape tomatoes\n1 small pkg fresh basil"
          },
          {
            "id": 189142,
            "primary_message": "Zest and juice lemon into the bowl with the shrimp. Add oil, salt, and pepper; toss to combine and set aside to marinate.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 189143,
            "primary_message": "Meanwhile, peel and mince the garlic; place in another large bowl along with oil, vinegar, honey, salt, and pepper. Whisk to combine the dressing.",
            "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tsp honey\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 189144,
            "primary_message": "Peel and thinly slice the shallot; add to the bowl with the dressing and toss to combine.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 189145,
            "primary_message": "Cut regular tomatoes in half and slice into thick half-moons; halve the grape tomatoes. Add both to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 189146,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 189147,
            "primary_message": "Meanwhile, quarter the peaches (around the pit) and twist to separate, then remove and discard the pits.",
            "secondary_message": null
          },
          {
            "id": 189148,
            "primary_message": "Working in batches if necessary, place the peaches on the pan and grill until charred, 2 minutes per side. Remove to the bowl with the tomatoes and toss gently to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 189149,
            "primary_message": "While the peaches are cooking, thread the shrimp onto skewers. If you don't have skewers you can cook the shrimp directly on the pan. Discard the marinade.",
            "secondary_message": null
          },
          {
            "id": 189150,
            "primary_message": "Working in batches if necessary, add the shrimp to the pan and grill until opaque, 1-2 minutes per side. Once done, transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 189151,
            "primary_message": "Tear mozzarella into large chunks with your hands.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 189152,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 189153,
            "primary_message": "To serve, divide shrimp and Caprese salad between plates. Drizzle with oil and sprinkle with basil. Enjoy!",
            "secondary_message": "2 tbsp extra virgin olive oil"
          }
        ],
