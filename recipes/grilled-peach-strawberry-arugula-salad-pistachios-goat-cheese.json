        "instructions": [
          {
            "id": 27823,
            "primary_message": "Preheat a grill pan or skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 27860,
            "primary_message": "Wash, halve, and pit peaches.",
            "secondary_message": "4 peaches"
          },
          {
            "id": 27861,
            "primary_message": "Coat grill or bottom of skillet with oil. Place peaches cut side down on grill/skillet and cook until lightly browned and tender, 2-3 minutes per side. Transfer to a plate.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 27862,
            "primary_message": "Wash and dry arugula. Transfer to a large bowl.",
            "secondary_message": "1 (5 oz) pkg baby arugula"
          },
          {
            "id": 27863,
            "primary_message": "Wash cucumber and strawberries. Medium dice and add cucumber to bowl. Trim stem ends, slice, and add strawberries to bowl.",
            "secondary_message": "1 English cucumber\n1 (16 oz) pkg strawberries"
          },
          {
            "id": 27864,
            "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, oil, vinegar, Dijon, salt, and pepper. Set aside.",
            "secondary_message": "2 cloves garlic\n6 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n2 tsp honey\n½ tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 27865,
            "primary_message": "Slice and add peaches to bowl. Toss salad.",
            "secondary_message": null
          },
          {
            "id": 27866,
            "primary_message": "Shell pistachios. Crumble goat cheese.",
            "secondary_message": "½ cup pistachios, roasted unsalted\n1 (4 oz) log goat cheese"
          },
          {
            "id": 27867,
            "primary_message": "To serve, arrange salad on a plate, sprinkle goat cheese and pistachios over top, and drizzle with dressing. Enjoy!",
            "secondary_message": null
          }
        ],
