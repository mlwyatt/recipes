        "instructions": [
          {
            "id": 410193,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 410194,
            "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate. Season both sides with spices.",
            "secondary_message": "4 pork chops, bone-in\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 410195,
            "primary_message": "Once the pan is hot, coat with oil. Add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 410196,
            "primary_message": "Meanwhile, wash, dry, quarter, and core apples; small dice. Place in a medium bowl. ",
            "secondary_message": "2 Granny Smith apples"
          },
          {
            "id": 410197,
            "primary_message": "Wash, dry, and chop chives into small pieces. Add to the bowl with the apple.",
            "secondary_message": "1 small pkg chives"
          },
          {
            "id": 410198,
            "primary_message": "Add shredded cabbage and dressing to the bowl. Toss to combine the slaw and set aside. ",
            "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n⅓ cup balsamic vinaigrette"
          },
          {
            "id": 410199,
            "primary_message": "To serve, divide chops and slaw between plates; drizzle chops with pesto. Enjoy!",
            "secondary_message": "½ cup basil pesto"
          }
        ],
