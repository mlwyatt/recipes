        "instructions": [
          {
            "id": 478651,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 478652,
            "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, boneless\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 478653,
            "primary_message": "Once the pan is hot, coat with oil. Add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 478654,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 (16 oz) pkg strawberries\n4 kiwifruit\n2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 478655,
            "primary_message": "Peel and mince shallot. Place in a large bowl along with oil, vinegar, sesame seeds, Worcestershire, sugar, and spices. Whisk to combine the dressing.",
            "secondary_message": "1 shallot\n3 tbsp extra virgin olive oil\n4 tsp white wine vinegar\n2 tbsp sesame seeds\n4 tsp Worcestershire sauce\n4 tsp brown sugar\n½ tsp salt\n¼ tsp black pepper\n¼ tsp paprika"
          },
          {
            "id": 478656,
            "primary_message": "Trim and thinly slice strawberries. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 478657,
            "primary_message": "Peel, trim, and quarter kiwis lengthwise, then slice crosswise into bite-sized pieces. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 478658,
            "primary_message": "Roughly chop pistachios. Add to the bowl, along with the spinach, and toss to combine the salad.",
            "secondary_message": "⅔ cup pistachios, unsalted"
          },
          {
            "id": 478659,
            "primary_message": "Thinly slice pork chops.",
            "secondary_message": null
          },
          {
            "id": 478660,
            "primary_message": "To serve, divide salad between plates or bowls. Top with sliced pork and enjoy!",
            "secondary_message": null
          }
        ],
