        "instructions": [
          {
            "id": 43663,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 peaches\n1 English cucumber\n1 lime"
          },
          {
            "id": 43664,
            "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 43665,
            "primary_message": "In a small bowl, combine and mix together olive oil, paprika, salt, and pepper.",
            "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 43666,
            "primary_message": "Pat the pork chops dry with paper towels and place on a plate; rub with the spice mixture on both sides.",
            "secondary_message": "4 pork chops, bone-in"
          },
          {
            "id": 43667,
            "primary_message": "Place the pork chops in the grill pan / skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
            "secondary_message": ""
          },
          {
            "id": 43668,
            "primary_message": "Juice the lime and transfer to a large salad bowl.",
            "secondary_message": null
          },
          {
            "id": 43669,
            "primary_message": "To the lime juice, add olive oil, honey, salt, and pepper; whisk together.",
            "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 43670,
            "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard the pit; cut each quarter lengthwise into thin wedges and add to the salad bowl.",
            "secondary_message": ""
          },
          {
            "id": 43671,
            "primary_message": "Trim off and discard the ends of the cucumber; halve the cucumber lengthwise, then slice crosswise into ¼-inch-thick half-rounds at an angle. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 43672,
            "primary_message": "Trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds. Add to the salad bowl and toss the salad to combine.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 43673,
            "primary_message": "To serve, divide the pork chops and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
