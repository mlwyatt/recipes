        "instructions": [
          {
            "id": 408860,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 small bunch fresh dill\n2 heads romaine lettuce\n4 sticks celery"
          },
          {
            "id": 408861,
            "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Place half of the dill in a small bowl. (Reserve remaining dill for serving.)",
            "secondary_message": null
          },
          {
            "id": 408862,
            "primary_message": "Peel and mince shallot. Add to the bowl with the dill along with yogurt, mayo, vinegar, Dijon, sugar, and spices. Whisk until smooth.",
            "secondary_message": "1 shallot\n⅔ cup plain Greek yogurt\n2 tbsp mayonnaise\n4 tsp apple cider vinegar\n2 tsp Dijon mustard\n2 tsp brown sugar\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 408863,
            "primary_message": "Add blue cheese to the bowl and whisk to combine the dressing; set aside.",
            "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
          },
          {
            "id": 408864,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 408865,
            "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 408866,
            "primary_message": "Once the pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 408867,
            "primary_message": "Meanwhile, trim and quarter romaine heads lengthwise into wedges. Rub cut sides with oil, then season with salt and pepper.",
            "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 408868,
            "primary_message": "Working in batches if necessary, place romaine quarters, cut-side down, on the pan. Cook, turning halfway through, until charred and leaves begin to wilt, 3-4 minutes. Transfer to another plate.",
            "secondary_message": null
          },
          {
            "id": 408869,
            "primary_message": "Meanwhile, trim and medium dice celery.",
            "secondary_message": null
          },
          {
            "id": 408870,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 408871,
            "primary_message": "To serve, divide romaine between plates, arranging it grilled-side up. Top with steak, dressing, celery, and reserved dill. Enjoy!",
            "secondary_message": null
          }
        ],
