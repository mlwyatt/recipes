  "instructions": [
    {
      "id": 415801,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415802,
      "primary_message": "While the pan heats up, pat salmon dry with paper towels. Place on a plate and season the top side with salt and pepper. ",
      "secondary_message": "1 ½ lb salmon fillet\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 415803,
      "primary_message": "Once the pan is hot, coat with oil. Add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 415804,
      "primary_message": "Meanwhile, place corn in a colander and rinse under hot water (from the tap) to defrost. Transfer to a medium bowl. ",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 415805,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl with the corn, along with the salsa, and stir to combine; set aside.",
      "secondary_message": "2 avocados\n1 cup salsa"
    },
    {
      "id": 415806,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 415807,
      "primary_message": "To serve, divide salmon, salsa, and arugula between plates; drizzle arugula with vinaigrette. Enjoy!",
      "secondary_message": "¼ cup French vinaigrette"
    }
  ],
