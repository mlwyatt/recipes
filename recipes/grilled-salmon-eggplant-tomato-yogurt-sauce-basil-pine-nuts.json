        "instructions": [
          {
            "id": 280524,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 eggplants\n4 tomatoes\n1 small pkg fresh basil"
          },
          {
            "id": 280525,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 280526,
            "primary_message": "While the pan is heating, trim and slice eggplants lengthwise into ½-inch thick planks; transfer to a plate, drizzle with oil, and sprinkle with salt.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 280527,
            "primary_message": "Once the pan is hot, add eggplant and grill, flipping once, until tender, 3-4 minutes per side. Return to the plate and loosely cover with aluminum foil. (Reserve pan for later use.)",
            "secondary_message": null
          },
          {
            "id": 280528,
            "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 280529,
            "primary_message": "Add yogurt, water, and spices to the bowl with the garlic; whisk to combine the sauce and set aside.",
            "secondary_message": "1 ½ cups plain Greek yogurt\n¼ cup water\n1 tsp dill, dried\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 280530,
            "primary_message": "Pat salmon dry with paper towels, place on another plate, and season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb salmon fillet\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 280531,
            "primary_message": "Once the eggplant is done, coat the pan with oil; add salmon and grill until flakey and cooked through, 4-5 minutes per side. Remove from heat.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 280532,
            "primary_message": "While the salmon is cooking, thinly slice tomatoes.",
            "secondary_message": null
          },
          {
            "id": 280533,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 280534,
            "primary_message": "To serve, divide salmon, eggplant, and tomato slices between plates. Top veggies with yogurt sauce and pine nuts, then sprinkle basil over top. Enjoy!",
            "secondary_message": "¼ cup pine nuts"
          }
        ],
