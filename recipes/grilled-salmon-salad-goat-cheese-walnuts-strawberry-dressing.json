        "instructions": [
          {
            "id": 148996,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 (16 oz) pkg strawberries\n1 lemon\n2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 148997,
            "primary_message": "Trim and thinly slice the strawberries; place in a medium saucepan, reserving a small handful for garnish.",
            "secondary_message": null
          },
          {
            "id": 148998,
            "primary_message": "Add vinegar, honey, and Dijon to the saucepan; bring to a boil over medium-high heat. Reduce heat to a simmer and cook, stirring occasionally, until berries have softened and mixture thickens, 8-10 minutes.",
            "secondary_message": "¼ cup red wine vinegar\n2 tsp honey\n2 tsp Dijon mustard"
          },
          {
            "id": 148999,
            "primary_message": "Meanwhile, preheat a grill pan or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 149000,
            "primary_message": "Pat the salmon dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb salmon fillet\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 149001,
            "primary_message": "Once the grill pan or skillet is hot, coat with oil. Add salmon and cook until opaque, 4-5 minutes per side. Transfer to a clean plate.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 149002,
            "primary_message": "Meanwhile, zest the lemon.",
            "secondary_message": null
          },
          {
            "id": 149003,
            "primary_message": "Add lemon zest, salt, pepper, and water to the saucepan with the strawberries and remove from the heat.",
            "secondary_message": "½ tsp salt\n⅛ tsp black pepper\n2 tbsp water"
          },
          {
            "id": 149004,
            "primary_message": "Using a hand or regular blender, purée the dressing until smooth, adding additional water, 1 tbsp at a time, to reach drizzling consistency.",
            "secondary_message": null
          },
          {
            "id": 149005,
            "primary_message": "Cut lemon into wedges and set aside.",
            "secondary_message": null
          },
          {
            "id": 149006,
            "primary_message": "Roughly chop walnuts.",
            "secondary_message": "½ cup walnuts"
          },
          {
            "id": 149007,
            "primary_message": "Crumble goat cheese.",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 149008,
            "primary_message": "To serve, divide the spinach between plates. Top with grilled salmon, walnuts, goat cheese, and reserved strawberries. Place lemon wedges on the side and drizzle with dressing. Enjoy!",
            "secondary_message": null
          }
        ],
