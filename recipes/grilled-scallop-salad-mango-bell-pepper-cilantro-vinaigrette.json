        "instructions": [
          {
            "id": 240834,
            "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 240835,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 limes\n1 small bunch cilantro\n2 mangoes\n2 red bell peppers\n2 heads butter (Boston) lettuce\n1 avocado"
          },
          {
            "id": 240836,
            "primary_message": "Juice limes into a blender.",
            "secondary_message": null
          },
          {
            "id": 240837,
            "primary_message": "Shave cilantro leaves off the stems; discard stems. Add leaves to the blender with the lime juice.",
            "secondary_message": null
          },
          {
            "id": 240838,
            "primary_message": "Peel and roughly chop garlic. Add to the blender along with oil, honey, salt, and pepper. Blend on high until smooth; set dressing aside.",
            "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n4 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 240839,
            "primary_message": "Peel mangos and slice flesh away from the pit, starting with the flat sides; medium dice. Transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 240840,
            "primary_message": "Trim, seed, and cut bell peppers into thin matchsticks. Add to the bowl with the mango.",
            "secondary_message": null
          },
          {
            "id": 240841,
            "primary_message": "Chop or tear lettuce leaves into bite-sized pieces. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 240842,
            "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 240843,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 240844,
            "primary_message": "Meanwhile, pat scallops dry with paper towels and thread onto the skewers so that they lie flat; place on a plate. Drizzle with oil and season with salt and pepper on both sides. (Alternatively, you can cook the scallops directly on the grill pan without using skewers.)",
            "secondary_message": "1 ½ lb sea scallops\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 240845,
            "primary_message": "Once the grill pan is hot, working in batches if necessary, add skewers and cook, flipping once, until scallops are lightly charred and cooked through, about 5 minutes. Remove to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 240846,
            "primary_message": "To serve, divide salad between plates; top with cashews and grilled scallops. Drizzle with dressing and enjoy!",
            "secondary_message": "⅔ cup cashews, roasted unsalted"
          }
        ],
