        "instructions": [
          {
            "id": 407291,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 avocados\n2 limes\n1 small pineapple\n1 red bell pepper\n1 small bunch cilantro\n1 small head red cabbage"
          },
          {
            "id": 407292,
            "primary_message": "Halve and pit avocados. Scoop out into a small bowl and mash with a fork.",
            "secondary_message": null
          },
          {
            "id": 407293,
            "primary_message": "Peel and mince garlic; add to the bowl with the avocado.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 407294,
            "primary_message": "Juice one lime into the bowl with the avocado; add salt, stir to combine the guacamole, and set aside. (Reserve remaining lime for the salsa.)",
            "secondary_message": "¼ tsp salt"
          },
          {
            "id": 407295,
            "primary_message": "Cut off skin from pineapple, core, and small dice. Trim, seed, and small dice bell peppers; place both in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 407296,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the pineapple and bell pepper.",
            "secondary_message": null
          },
          {
            "id": 407297,
            "primary_message": "Peel and mince shallot; add to the bowl.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 407298,
            "primary_message": "Juice remaining lime into the bowl; add salt, stir to combine the pineapple salsa, and set aside.",
            "secondary_message": "½ tsp salt"
          },
          {
            "id": 407299,
            "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 407300,
            "primary_message": "While the pan heats up, quarter the cabbage lengthwise, then cut out and discard the core; slice crosswise into thin strips.",
            "secondary_message": null
          },
          {
            "id": 407301,
            "primary_message": "Once the pan is hot, coat with oil. Add cabbage and cook, stirring frequently, until softened, 4-5 minutes. Transfer cabbage to a plate and cover with aluminum foil to keep warm. (Reserve pan for the next step).",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 407302,
            "primary_message": "While the cabbage is cooking, pat scallops dry with paper towels and place on another plate; rub with oil and season with spices on both sides.",
            "secondary_message": "1 ½ lb sea scallops\n2 tsp extra virgin olive oil\n½ tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 407303,
            "primary_message": "Return pan to medium-high heat. Working in batches if necessary, add scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, add to the plate with the cabbage.",
            "secondary_message": null
          },
          {
            "id": 407304,
            "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
            "secondary_message": "12 small flour tortillas"
          },
          {
            "id": 407305,
            "primary_message": "To serve, spread tortillas with guacamole and top with scallops (cutting them in half if necessary); garnish with wilted cabbage and pineapple salsa. Enjoy!",
            "secondary_message": null
          }
        ],
