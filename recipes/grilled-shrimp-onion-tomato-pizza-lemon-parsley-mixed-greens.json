  "instructions": [
    {
      "id": 317914,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 317915,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n1 pint grape tomatoes\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 317916,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 317917,
      "primary_message": "Transfer shrimp to a plate; drizzle with oil and season with spices on both sides, then set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 317918,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 317919,
      "primary_message": "While the pan heats up, peel, halve, and cut onions lengthwise into 1-inch wide wedges.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 317920,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add shrimp and onion; cook, turning occasionally, until the shrimp are cooked through and onion is tender, 4-5 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 317921,
      "primary_message": "Meanwhile, peel and mince garlic; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 317922,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 317923,
      "primary_message": "Juice lemon into the bowl, then add oil, Dijon, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 317924,
      "primary_message": "Halve tomatoes.",
      "secondary_message": null
    },
    {
      "id": 317925,
      "primary_message": "Divide flatbreads between two baking sheet pans; top with grilled shrimp and onion, tomatoes, and feta. Sprinkle with oregano and crushed red pepper. ",
      "secondary_message": "4 flatbreads or naan\n1 (4 oz) pkg crumbled feta cheese\n1 tsp oregano, dried\n¼ tsp crushed red pepper"
    },
    {
      "id": 317926,
      "primary_message": "Place baking sheets in the oven and bake until the cheese starts to melt, about 5 minutes. Remove from oven and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 317927,
      "primary_message": "Meanwhile, add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 317928,
      "primary_message": "To serve, divide pizza and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
