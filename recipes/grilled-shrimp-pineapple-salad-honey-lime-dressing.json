        "instructions": [
          {
            "id": 214036,
            "primary_message": "If using wooden skewers, place 12-16 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 214037,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "1 lime\n1 small pineapple\n1 English cucumber\n2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 214038,
            "primary_message": "Peel and mince garlic; transfer to a large bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 214039,
            "primary_message": "Juice lime into the bowl with the garlic. Add mayo, honey, salt, and pepper; whisk to combine the dressing and set aside.",
            "secondary_message": "½ cup mayonnaise\n¼ cup honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 214040,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 214041,
            "primary_message": "Place spices in another large bowl and stir to combine.",
            "secondary_message": "1 tsp salt\n1 tsp garlic powder\n1 tsp cumin\n¼ tsp turmeric\n¼ tsp cayenne pepper"
          },
          {
            "id": 214042,
            "primary_message": "Cut skin off pineapple, core, and cut into bite-sized pieces; transfer to the bowl with the spice mix.",
            "secondary_message": null
          },
          {
            "id": 214043,
            "primary_message": "Add shrimp to the bowl with the pineapple, toss to coat, then thread shrimp and pineapple onto the skewers. Alternatively, you can cook the shrimp and pineapple directly on the grill/skillet without using skewers.",
            "secondary_message": null
          },
          {
            "id": 214044,
            "primary_message": "Preheat a large grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 214045,
            "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add skewers to the grill and cook, turning occasionally, until charred and the shrimp are cooked through, about 6 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 214046,
            "primary_message": "Trim and slice the cucumber into thin rounds. Add to the bowl with the dressing along with mixed greens; toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 214047,
            "primary_message": "To serve, divide salad between plates and top with skewers. Enjoy!",
            "secondary_message": null
          }
        ],
