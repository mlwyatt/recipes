        "instructions": [
          {
            "id": 29436,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water until there are no more ice chunks. Then, lay them out on a paper towel or clean cloth and pat dry. Transfer to a medium bowl. If using fresh shrimp, place them directly into a medium bowl.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 29437,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 mangoes\n2 avocados\n2 jalapeño peppers\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 29438,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add half of the cilantro to the shrimp and transfer the rest to a medium bowl (for the salsa).",
            "secondary_message": null
          },
          {
            "id": 29439,
            "primary_message": "Drizzle the shrimp with olive oil and season with chili powder; toss to combine. Set aside while you prepare the salsa.",
            "secondary_message": "1 tbsp extra virgin olive oil\n4 tsp chili powder"
          },
          {
            "id": 29440,
            "primary_message": "Peel the mangoes and discard the peels; slice the flesh away from the pit, starting with the flat sides. Small dice the mangoes and add to the cilantro.",
            "secondary_message": ""
          },
          {
            "id": 29441,
            "primary_message": "Halve and pit the avocados; scoop out the flesh from the skin. Small dice the avocados and add to the bowl.",
            "secondary_message": ""
          },
          {
            "id": 29442,
            "primary_message": "Halve the jalapeños lengthwise; remove and discard the seeds and white membranes. Finely dice the peppers and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 29443,
            "primary_message": "Preheat a grill pan or regular skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 29444,
            "primary_message": "Peel and small dice the onion; add to the bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 29445,
            "primary_message": "Juice the lime and pour over the salsa. Toss the salsa until well combined.",
            "secondary_message": ""
          },
          {
            "id": 29446,
            "primary_message": "Once the grill pan / skillet is hot, add the shrimp; cook until they are opaque, 1 to 2 minutes per side. Once done, transfer to a plate and set aside to cool.",
            "secondary_message": null
          },
          {
            "id": 29447,
            "primary_message": "Wrap the tortillas in a damp paper towel or cloth and microwave until they are heated through, 30 seconds to 1 minute.",
            "secondary_message": "16 small corn tortillas"
          },
          {
            "id": 29448,
            "primary_message": "Once the shrimp have cooled slightly, peel and discard the tails.",
            "secondary_message": null
          },
          {
            "id": 29449,
            "primary_message": "To serve, place 3 to 4 shrimp into each tortilla and spoon the mango-avocado salsa over top. Enjoy!",
            "secondary_message": null
          }
        ],
