        "instructions": [
          {
            "id": 15764,
            "primary_message": "Wash, peel, and large dice potatoes. Transfer to a medium saucepan, cover with water, and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to saucepan.",
            "secondary_message": "4 medium yellow potatoes"
          },
          {
            "id": 15765,
            "primary_message": "Wash carrots. Halve crosswise then halve or quarter lengthwise. Transfer to a medium bowl. Drizzle with olive oil and season with parsley flakes, salt, and pepper.",
            "secondary_message": "8 medium carrots\r\n2 tsp extra virgin olive oil\r\n½ tsp parsley flakes\r\n¼ tsp salt\r\n⅛ tsp black pepper"
          },
          {
            "id": 15766,
            "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 15767,
            "primary_message": "Peel and mince garlic. Wash and chop chives.",
            "secondary_message": "6 cloves garlic\r\n1 small pkg chives"
          },
          {
            "id": 15768,
            "primary_message": "Season steak generously with salt and pepper.",
            "secondary_message": "1 ½ lb ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 15769,
            "primary_message": "Coat grill or bottom of skillet with oil. Place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 15770,
            "primary_message": "Once steak has been transferred, place carrots on grill/skillet. Cook until tender-crisp, 4-5 minutes per side. Cook in two batches if all the carrots won't fit on grill/skillet.",
            "secondary_message": ""
          },
          {
            "id": 15771,
            "primary_message": "Add broth, oil, garlic, chives, salt, and pepper to potatoes. Mash until smooth.",
            "secondary_message": "1 tbsp virgin coconut oil\n8 fl oz (1 cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 15772,
            "primary_message": "To serve, arrange steak, carrots, and mashed potatoes on a plate. Enjoy!",
            "secondary_message": ""
          }
        ],
