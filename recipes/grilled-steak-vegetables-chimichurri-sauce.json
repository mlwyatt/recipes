  "instructions": [
    {
      "id": 15600,
      "primary_message": "Wash zucchini, bell peppers, and carrots. Slice zucchini diagonally into rounds. Seed and cut peppers into 8 strips. Peel, halve crosswise, then halve or quarter carrots lengthwise.",
      "secondary_message": "2 medium zucchini squash\r\n2 red bell peppers\r\n4 medium carrots"
    },
    {
      "id": 15601,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 15602,
      "primary_message": "Transfer vegetables to a large bowl. Drizzle with oil and season with Italian seasoning, salt, and pepper. Toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n½ tsp Italian seasoning\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 15603,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "1 ½ lb ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 15604,
      "primary_message": "Coat grill or bottom of skillet with oil. Place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 15605,
      "primary_message": "Add vegetables to grill/skillet and cook until tender and charred, 2-3 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 15606,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. In a medium bowl, prepare sauce by whisking together parsley, garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\r\n2 cloves garlic\r\n4 tbsp extra virgin olive oil\r\n2 tbsp red wine vinegar\r\n¼ tsp salt\r\n¼ tsp black pepper\r\n⅛ tsp crushed red pepper"
    },
    {
      "id": 15607,
      "primary_message": "To serve, place steak and vegetables on a plate and drizzle with chimichurri sauce. Enjoy!",
      "secondary_message": ""
    }
  ],
