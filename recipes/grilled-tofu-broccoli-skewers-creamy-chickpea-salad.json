  "instructions": [
    {
      "id": 485688,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 485689,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 485690,
      "primary_message": "Place mayo, Dijon, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp Dijon mustard\n4 tsp white wine vinegar\n1 tsp dill, dried\n½ tsp curry powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 485691,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; small dice stems. Place florets in a large bowl and set aside for the skewers. Add stems to the bowl with the dressing.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 485692,
      "primary_message": "Wash, dry, trim, and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": "4 sticks celery"
    },
    {
      "id": 485693,
      "primary_message": "Drain and rinse chickpeas in a colander. Add to the bowl and stir to combine the chickpea salad. Set aside.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 485694,
      "primary_message": "Large dice tofu and add to the bowl with the broccoli florets. Drizzle with soy sauce and oil, then season with spices. Gently toss to coat.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp extra virgin olive oil\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 485695,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485696,
      "primary_message": "While the pan heats up, thread tofu and broccoli onto skewers, alternating ingredients, and place on a plate. (If you don't have skewers, you can cook the tofu and broccoli directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 485697,
      "primary_message": "Once the pan is hot, working in batches if necessary, add skewers and cook, turning occasionally, until tofu is warmed through and broccoli is tender-crisp, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 485698,
      "primary_message": "To serve, divide chickpea salad and tofu-broccoli skewers between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
