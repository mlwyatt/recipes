        "instructions": [
          {
            "id": 429662,
            "primary_message": "Mince anchovy fillets. Place in a medium bowl along with tomato paste, oil, and spices. Stir to combine the marinade. ",
            "secondary_message": "4 anchovy fillets, packed in oil\n4 tbsp tomato paste\n3 tbsp extra virgin olive oil\n2 tsp garlic powder\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
          },
          {
            "id": 429663,
            "primary_message": "Pat chicken dry with paper towels and add to the bowl with the marinade. Using your hands, massage the marinade into the chicken. ",
            "secondary_message": "2 lb chicken thighs, boneless skinless"
          },
          {
            "id": 429664,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat. ",
            "secondary_message": null
          },
          {
            "id": 429665,
            "primary_message": "Once the grill pan is hot, coat with oil. Add the chicken and grill until cooked through, 3-4 minutes per side. Remove to a plate. ",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 429666,
            "primary_message": "Meanwhile, wash and dry bell peppers. Using a clean cutting board, trim, seed, and medium dice the peppers. Place in a clean medium bowl.",
            "secondary_message": "2 red bell peppers"
          },
          {
            "id": 429667,
            "primary_message": "Add shredded cabbage, pumpkin seeds, and dressing to the bowl with the bell pepper. Stir to combine the salad. ",
            "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n¼ cup pumpkin seeds\n¼ cup Italian salad dressing"
          },
          {
            "id": 429668,
            "primary_message": "To serve, divide chicken and cabbage salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
