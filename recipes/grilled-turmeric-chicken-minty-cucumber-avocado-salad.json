        "instructions": [
          {
            "id": 28399,
            "primary_message": "In a large bowl, combine and mix together the yogurt, lemon juice, turmeric, cumin, salt, and pepper. Transfer half of the yogurt mixture to another large bowl.",
            "secondary_message": "1 ½ cups plain Greek yogurt\n1 lemon\n2 tsp turmeric\n1 tsp cumin\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 28400,
            "primary_message": "Holding a knife parallel to the cutting board; cut the chicken in half horizontally to form thin fillets.",
            "secondary_message": "2 lb chicken breasts, boneless skinless"
          },
          {
            "id": 28401,
            "primary_message": "Place the chicken in one of the bowls and coat in the yogurt mixture; set aside for 15 minutes.",
            "secondary_message": null
          },
          {
            "id": 28402,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 English cucumbers\n2 avocados\n1 small pkg fresh mint"
          },
          {
            "id": 28403,
            "primary_message": "Trim and discard the cucumber ends; small dice the cucumbers and add to the other bowl of yogurt.",
            "secondary_message": null
          },
          {
            "id": 28404,
            "primary_message": "Halve and pit the avocados; scoop out the flesh and discard the skins. Small dice the flesh and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 28405,
            "primary_message": "Peel and mince the shallots; add to the bowl.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 28406,
            "primary_message": "Heat a grill pan or skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 28407,
            "primary_message": "While the pan/skillet heats up, pick the mint leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl and toss the salad until well combined.",
            "secondary_message": null
          },
          {
            "id": 28408,
            "primary_message": "Transfer the chicken to a plate, wiping off excess marinade.",
            "secondary_message": ""
          },
          {
            "id": 28409,
            "primary_message": "Coat the grill pan or skillet with coconut oil.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 28410,
            "primary_message": "Place the chicken in the grill pan or skillet; cook until cooked through and golden brown, 3 to 4 minutes per side. Transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 28411,
            "primary_message": "Divide the chicken and cucumber-avocado salad between four plates (or two plates and two lunch containers). Enjoy!",
            "secondary_message": null
          }
        ],
