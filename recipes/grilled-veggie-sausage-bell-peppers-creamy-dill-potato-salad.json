        "instructions": [
          {
            "id": 313886,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium yellow potatoes\n4 orange bell peppers\n2 sticks celery\n1 small bunch fresh dill"
          },
          {
            "id": 313887,
            "primary_message": "Peel and medium dice potatoes; place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
            "secondary_message": "1 tsp salt"
          },
          {
            "id": 313888,
            "primary_message": "Meanwhile, trim, seed, and quarter bell peppers. Place in a large bowl along with oil, salt, and pepper; toss to combine.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 313889,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 313890,
            "primary_message": "Once the grill pan is hot, working in batches if necessary, add peppers (reserve bowl for the next step) and cook, turning occasionally, until soft, 7-8 minutes. Transfer peppers to a plate and cover with aluminum foil (reserve grill pan for later use).",
            "secondary_message": null
          },
          {
            "id": 313891,
            "primary_message": "Meanwhile, place mayo, vinegar, Dijon, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
            "secondary_message": "¼ cup mayonnaise\n2 tbsp apple cider vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 313892,
            "primary_message": "Trim and small dice celery; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 313893,
            "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 313894,
            "primary_message": "Peel and mince shallot; add to the bowl.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 313895,
            "primary_message": "Return grill pan to medium heat. Once the pan is hot, coat with oil; add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook according to package instructions). Remove from heat.",
            "secondary_message": "2 tsp extra virgin olive oil\n4 pre-cooked vegan sausage"
          },
          {
            "id": 313896,
            "primary_message": "When the potatoes are done, drain and rinse under cold water to cool. Add potatoes to the bowl with the dressing and veggies; stir to combine the potato salad.",
            "secondary_message": null
          },
          {
            "id": 313897,
            "primary_message": "Slice cooked peppers into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 313898,
            "primary_message": "To serve, divide potato salad, peppers, and sausages between plates. Enjoy!",
            "secondary_message": null
          }
        ],
