  "instructions": [
    {
      "id": 188488,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 lemon\n2 tomatoes\n1 head butter (Boston) lettuce"
    },
    {
      "id": 188489,
      "primary_message": "Trim ends and slice zucchini lengthwise into ¼-inch thick planks. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 188490,
      "primary_message": "Peel and thinly slice onion into rings; add to the bowl with the zucchini. Add oil and salt; toss to coat.",
      "secondary_message": "1 medium red onion\n2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 188491,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188492,
      "primary_message": "Once the grill pan is hot, add the veggies (working in batches if necessary) and cook until tender, 3-4 minutes per side. Return veggies to the bowl and cover with foil.",
      "secondary_message": null
    },
    {
      "id": 188493,
      "primary_message": "Meanwhile, drain and rinse beans; transfer to a blender.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 188494,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 188495,
      "primary_message": "Juice lemon into the blender. Add water, oil, tahini, paprika, and salt. Blend on high for several minutes until smooth. Add more water, one tbsp at a time, if needed, to reach desired consistency. Set aside.",
      "secondary_message": "⅓ cup water\n¼ cup extra virgin olive oil\n2 tbsp tahini\n½ tsp paprika\n½ tsp salt"
    },
    {
      "id": 188496,
      "primary_message": "Thinly slice tomatoes into rounds.",
      "secondary_message": null
    },
    {
      "id": 188497,
      "primary_message": "Place tortillas on a flat surface and spread evenly with hummus. Divide zucchini, onion, tomato, and lettuce between them; roll tightly to close.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 188498,
      "primary_message": "Return grill pan to medium-high heat. Once the grill pan is hot, coat the bottom with oil. Place wraps on the grill and cook, rotating every 1-2 minutes, until tortillas are crispy and golden. Cut each wrap in half.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 188499,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
  ],
