  "instructions": [
    {
      "id": 29174,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb green beans\n2 red bell peppers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 29175,
      "primary_message": "Trim and discard the ends of the green beans; cut the beans into ½-inch pieces and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 29176,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the seeds and white membrane, then small dice the peppers. Add to the bowl with the beans.",
      "secondary_message": ""
    },
    {
      "id": 29177,
      "primary_message": "Peel and small dice the onion; add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 29178,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 29179,
      "primary_message": "Peel and mince the garlic; add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 29180,
      "primary_message": "Add coconut oil to the saucepan and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 29181,
      "primary_message": "Add the ground beef to the saucepan; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer to a bowl, leaving the juices in the saucepan.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 29182,
      "primary_message": "Once the beef has been transferred, add all of the vegetables to the pan. Cook, stirring frequently, until the vegetables have softened, 5 to 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 29183,
      "primary_message": "Return the beef to the saucepan and season with chili powder, salt, and black pepper; stir to combine.",
      "secondary_message": "2 tbsp chili powder\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 29184,
      "primary_message": "Add the diced tomatoes to the saucepan; bring to a boil, then reduce the heat to a simmer and cook for 5 to 10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 29185,
      "primary_message": "While the chili cooks, trim and discard the root ends of the green onions; chop the onions into ¼-inch pieces. Stir the white parts into the chili and transfer the green parts to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 29186,
      "primary_message": "To serve, spoon the chili into a bowl, add dollops of yogurt over top, and sprinkle with the green onions. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
