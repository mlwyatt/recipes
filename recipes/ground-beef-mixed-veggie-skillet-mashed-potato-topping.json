  "instructions": [
    {
      "id": 312771,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "4 medium yellow potatoes\n4 medium carrots\n4 sticks celery"
    },
    {
      "id": 312772,
      "primary_message": "Peel and medium dice potatoes; place in a medium saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 312773,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; trim and small dice celery. Place both in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 312774,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 312775,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add beef and cook, breaking it apart with a spoon, until just browned, 3-4 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ lb lean ground beef"
    },
    {
      "id": 312776,
      "primary_message": "While the beef cooks, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the carrot and celery. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 312777,
      "primary_message": "When the beef is done, add veggies and spices to the skillet; continue to cook, stirring occasionally, until veggies soften, 4-5 minutes more. ",
      "secondary_message": "1 tsp rosemary, dried\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 312778,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack about 6-inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 312779,
      "primary_message": "When the potatoes are done, drain in a colander and return to the saucepan. Add milk, salt, and pepper; using a potato masher, mash until smooth. Cover to keep warm and set aside. ",
      "secondary_message": "8 fl oz (1 cup) whole milk\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 312780,
      "primary_message": "When the veggies are soft, add flour and cook, stirring frequently, 1 minute more. ",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 312781,
      "primary_message": "Add tomato sauce, broth, peas, and Worcestershire to the skillet; stir to combine the beef filling and bring to a simmer. Once simmering, remove from heat. ",
      "secondary_message": "2 (8 oz) cans tomato sauce\n8 fl oz (1 cup) chicken or vegetable broth\n1 cup frozen peas\n4 tsp Worcestershire sauce"
    },
    {
      "id": 312782,
      "primary_message": "Spoon mashed potatoes over the beef filling; using a fork, evenly spread mashed potatoes over the top, creating ridges.",
      "secondary_message": null
    },
    {
      "id": 312783,
      "primary_message": "Place skillet in the oven and broil until the top is set and lightly golden, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 312784,
      "primary_message": "To serve, divide the skillet between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
