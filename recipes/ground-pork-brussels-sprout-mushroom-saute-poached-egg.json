  "instructions": [
    {
      "id": 275325,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb Brussels sprouts\n½ lb white mushrooms\n1 small pkg chives"
    },
    {
      "id": 275326,
      "primary_message": "Trim and thinly slice Brussels sprouts; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 275327,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the Brussels sprouts; set aside.",
      "secondary_message": null
    },
    {
      "id": 275328,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 275329,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 275330,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, pork, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb lean ground pork\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 275331,
      "primary_message": "While the pork is cooking, fill a medium saucepan about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pan is boiling, reduce heat to medium-low.",
      "secondary_message": "2 tbsp apple cider vinegar"
    },
    {
      "id": 275332,
      "primary_message": "When the pork is done, reduce heat to medium. Add Brussels sprouts, mushrooms, water, and Dijon to the skillet; stir to combine, cover, and cook, undisturbed, until veggies are tender, 5-7 minutes.",
      "secondary_message": "½ cup water\n2 tsp Dijon mustard"
    },
    {
      "id": 275333,
      "primary_message": "Meanwhile, gently crack eggs into small bowls, 2 eggs per bowl.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 275334,
      "primary_message": "Adjust the heat of the saucepan as necessary so that the water is simmering. Gently tip bowls into the pan, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 275335,
      "primary_message": "While the eggs are poaching, mince the chives.",
      "secondary_message": null
    },
    {
      "id": 275336,
      "primary_message": "To serve, divide pork and veggie sauté between plates or bowls. Top with a poached egg, season with salt and pepper, then sprinkle with chives. Enjoy!",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    }
  ],
