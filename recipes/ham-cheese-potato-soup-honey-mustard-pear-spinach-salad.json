  "instructions": [
    {
      "id": 422640,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lb new potatoes\n2 pears\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 422641,
      "primary_message": "Cut potatoes into quarters, then slice into ⅛-inch thick pieces. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 422642,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 422643,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 422644,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion, Italian seasoning, and salt; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n1 tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 422645,
      "primary_message": "Add potatoes and broth to the pot. Stir to combine and bring to a simmer. (Reserve bowl for the salad.)",
      "secondary_message": "40 fl oz (5 cups) chicken or vegetable broth"
    },
    {
      "id": 422646,
      "primary_message": "While the soup is heating, small dice ham.",
      "secondary_message": "16 oz ham steak, boneless"
    },
    {
      "id": 422647,
      "primary_message": "Once the soup is simmering, add ham, stir to combine, and simmer until potatoes are fork-tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 422648,
      "primary_message": "Meanwhile, using a clean cutting board, quarter, core, and thinly slice pears. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 422649,
      "primary_message": "When the potatoes are tender, add cream and cheese; stir to combine. Continue to cook, stirring occasionally, until the cheese is melted and soup is heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "8 fl oz (1 cup) heavy whipping cream\n⅔ cup shredded cheese, Italian blend"
    },
    {
      "id": 422650,
      "primary_message": "Add spinach and dressing to the bowl with the pear. Toss to combine the salad.",
      "secondary_message": "¼ cup honey mustard dressing"
    },
    {
      "id": 422651,
      "primary_message": "Divide soup between bowls and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
