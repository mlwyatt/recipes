        "instructions": [
          {
            "id": 331715,
            "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a medium bowl, and set aside.",
            "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
          },
          {
            "id": 331716,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 sticks celery\n2 yellow bell peppers\n1 small pkg fresh thyme\n2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 331717,
            "primary_message": "Using a clean cutting board, trim and small dice celery; place in another medium bowl.",
            "secondary_message": null
          },
          {
            "id": 331718,
            "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the celery.",
            "secondary_message": null
          },
          {
            "id": 331719,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 331720,
            "primary_message": "While the pot heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the other veggies.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 331721,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies and cook, stirring occasionally, until soft, 4-5 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 331722,
            "primary_message": "Meanwhile, slide thyme leaves off the stems; discard the stems.",
            "secondary_message": null
          },
          {
            "id": 331723,
            "primary_message": "When the veggies are soft, add shredded chicken, thyme, broth, gnocchi, salt, and pepper to the pot; bring the soup to a boil over high heat.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n2 (16 oz) pkg potato gnocchi\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 331724,
            "primary_message": "Once the soup is boiling, reduce heat to medium-low; continue to cook, stirring occasionally, until flavors blend and gnocchi are soft, 8 minutes more.",
            "secondary_message": null
          },
          {
            "id": 331725,
            "primary_message": "When the soup is done, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 331726,
            "primary_message": "To serve, divide soup between bowls and enjoy!",
            "secondary_message": null
          }
        ],
