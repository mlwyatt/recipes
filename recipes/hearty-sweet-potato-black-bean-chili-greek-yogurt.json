  "instructions": [
    {
      "id": 20390,
      "primary_message": "Heat a large pot over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 20391,
      "primary_message": "Peel and small dice onion. Wash and medium dice sweet potatoes (without peeling).",
      "secondary_message": "1 medium yellow onion\n1 ½ lb sweet potatoes"
    },
    {
      "id": 20392,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and potatoes. Stirring frequently, cook until onion is softened, 3-4 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 20393,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 20394,
      "primary_message": "Once onion is softened, add garlic, chili powder, cumin, salt, and pepper to saucepan. Stir and cook until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp chili powder\r\n2 tsp cumin\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 20395,
      "primary_message": "Add broth and tomatoes; bring to a boil. Reduce heat to a simmer, cover, and cook chili until potatoes are tender, about 15 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 20396,
      "primary_message": "Drain and rinse beans; add to saucepan while the chili is simmering.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 20397,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Add ¾ of the cilantro (save the rest for garnishing) to saucepan; stir to combine. Continue cooking until potatoes are tender.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 20398,
      "primary_message": "Serve chili in a bowl and garnish with dollops of yogurt and remaining cilantro. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
