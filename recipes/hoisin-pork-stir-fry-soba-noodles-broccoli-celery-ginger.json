        "instructions": [
          {
            "id": 359973,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 359974,
            "primary_message": "Meanwhile, wash and dry the fresh produce. ",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n4 sticks celery"
          },
          {
            "id": 359975,
            "primary_message": "Once the water is boiling, add noodles and cook according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water; set aside.",
            "secondary_message": "10 oz soba (buckwheat) noodles"
          },
          {
            "id": 359976,
            "primary_message": "While the noodles are cooking, peel and mince ginger. Place in a medium bowl. ",
            "secondary_message": null
          },
          {
            "id": 359977,
            "primary_message": "Trim and thinly slice green onions crosswise; add to the bowl with the ginger. ",
            "secondary_message": null
          },
          {
            "id": 359978,
            "primary_message": "Trim and thinly slice celery crosswise; add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 359979,
            "primary_message": "Preheat a large skillet over medium-high heat. ",
            "secondary_message": null
          },
          {
            "id": 359980,
            "primary_message": "While the skillet heats up, pat pork dry with paper towels and slice crosswise into ½-inch thick strips. Add to the bowl with the veggies. ",
            "secondary_message": "4 pork chops, boneless"
          },
          {
            "id": 359981,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, pork, garlic powder, and salt; stir-fry until the meat is browned and cooked through, 4-5 minutes.",
            "secondary_message": "4 tsp toasted sesame oil\n1 tsp garlic powder\n½ tsp salt"
          },
          {
            "id": 359982,
            "primary_message": "Add broccoli, hoisin sauce, and water to the skillet; stir to combine and cover with a lid. Continue to cook, stirring occasionally, until broccoli is tender and sauce is warmed through, 2-3 minutes more. Remove from heat.",
            "secondary_message": "1 (18 oz) bag broccoli florets\n⅓ cup hoisin sauce\n⅓ cup water"
          },
          {
            "id": 359983,
            "primary_message": "To serve, divide noodles, stir-fry, and sauce between plates or bowls. Enjoy! ",
            "secondary_message": null
          }
        ],
