        "instructions": [
          {
            "id": 400074,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
            "secondary_message": "10 oz flat rice (pad thai) noodles"
          },
          {
            "id": 400075,
            "primary_message": "Meanwhile, wash, dry, and cut off skin from pineapple; quarter, core, and medium dice the flesh. Place in a large bowl.",
            "secondary_message": "1 small pineapple"
          },
          {
            "id": 400076,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry. Add to the bowl with the pineapple.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 400077,
            "primary_message": "Peel, halve, and medium dice onion. Peel and mince garlic. Add both to the bowl.",
            "secondary_message": "1 medium red onion\n2 cloves garlic"
          },
          {
            "id": 400078,
            "primary_message": "Preheat another large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 400079,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pineapple, shrimp, onion, garlic, shredded cabbage, and salt. Stir-fry until the pineapple is tender and shrimp are cooked through, 5-6 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil\n1 (14 oz) bag shredded cabbage (coleslaw mix)\n½ tsp salt"
          },
          {
            "id": 400080,
            "primary_message": "When the shrimp are done, add noodles, hoisin sauce, and water to the pot. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
            "secondary_message": "⅓ cup hoisin sauce\n⅓ cup water"
          },
          {
            "id": 400081,
            "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
