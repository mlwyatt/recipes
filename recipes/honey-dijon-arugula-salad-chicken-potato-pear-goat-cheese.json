  "instructions": [
    {
      "id": 358242,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 358243,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lb new potatoes\n2 pears\n2 (5 oz) pkgs baby arugula"
    },
    {
      "id": 358244,
      "primary_message": "Quarter potatoes and transfer to one half of a large baking sheet pan. Drizzle potatoes with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 358245,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Place cutlets on the other side of the baking sheet; drizzle with oil, then season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 358246,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing potatoes and flipping chicken halfway through, until cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 358247,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n4 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 358248,
      "primary_message": "Quarter, core, and thinly slice pears; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 358249,
      "primary_message": "Roughly chop pecans and add to the bowl.",
      "secondary_message": "½ cup pecans, dry roasted"
    },
    {
      "id": 358250,
      "primary_message": "Crumble goat cheese into the bowl and set aside.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 358251,
      "primary_message": "When the chicken and potatoes are done, transfer chicken to a cutting board and slice into thin strips.",
      "secondary_message": null
    },
    {
      "id": 358252,
      "primary_message": "Add roast potatoes and arugula to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 358253,
      "primary_message": "To serve, divide salad between plates or bowls and top with sliced chicken. Enjoy!",
      "secondary_message": null
    }
  ],
