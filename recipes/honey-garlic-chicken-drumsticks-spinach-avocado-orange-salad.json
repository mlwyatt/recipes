        "instructions": [
          {
            "id": 10153,
            "primary_message": "Preheat oven to 450°F. Using a paper towel, lightly coat a large baking dish with oil.",
            "secondary_message": "about 1 tsp extra virgin olive oil"
          },
          {
            "id": 10154,
            "primary_message": "Add chicken to the dish, place in the oven, and bake for 10 minutes.",
            "secondary_message": "2 ½ lb chicken drumsticks"
          },
          {
            "id": 10155,
            "primary_message": "Peel and mince garlic. In a small bowl, prepare sauce by mixing together ⅔ of the garlic (save the rest for dressing), soy sauce, honey, and parsley flakes. Set aside.",
            "secondary_message": "6 cloves garlic\r\n2 tbsp soy sauce\r\n4 tbsp honey\r\n1 tsp parsley flakes"
          },
          {
            "id": 10156,
            "primary_message": "Wash, dry and transfer spinach to a large bowl. Halve and pit avocados; scoop out, medium dice, and add to bowl. Wash, peel, and quarter oranges. Slice 6 of the quarters (save 2 for the dressing) into wedges and add to bowl. Toss salad.",
            "secondary_message": "1 (5 oz) pkg baby spinach\r\n2 avocados\r\n2 oranges"
          },
          {
            "id": 10157,
            "primary_message": "Remove dish from oven, pour honey garlic sauce over the drumsticks and turn to coat. Place back in the oven and bake until cooked through, another 20-25 minutes.",
            "secondary_message": ""
          },
          {
            "id": 10158,
            "primary_message": "In a small bowl, prepare dressing by whisking together juice of remaining orange, remaining garlic, oil, salt, and pepper.",
            "secondary_message": "2 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 10159,
            "primary_message": "To serve, place drumsticks on a plate, add salad on the side, and drizzle with dressing. Enjoy!",
            "secondary_message": ""
          }
        ],
