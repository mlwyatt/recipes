        "instructions": [
          {
            "id": 382789,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 382790,
            "primary_message": "While the skillet heats up, small dice bacon.",
            "secondary_message": "8 slices bacon"
          },
          {
            "id": 382791,
            "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside.",
            "secondary_message": null
          },
          {
            "id": 382792,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 pint grape tomatoes\n2 avocados\n4 hearts romaine hearts"
          },
          {
            "id": 382793,
            "primary_message": "Using a clean cutting board, roughly chop eggs. Place on a large plate.",
            "secondary_message": "4 hard-cooked eggs, peeled"
          },
          {
            "id": 382794,
            "primary_message": "Halve tomatoes lengthwise. Add to the plate with the egg.",
            "secondary_message": null
          },
          {
            "id": 382795,
            "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the plate and set aside.",
            "secondary_message": null
          },
          {
            "id": 382796,
            "primary_message": "Chop (or tear) lettuce into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 382797,
            "primary_message": "To serve, divide lettuce between plates or bowls; top with tomatoes, avocado, bacon, eggs, and feta. Drizzle with dressing and enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese\n½ cup honey mustard dressing"
          }
        ],
