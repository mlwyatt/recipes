        "instructions": [
          {
            "id": 12474,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": ""
          },
          {
            "id": 12478,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) water"
          },
          {
            "id": 12475,
            "primary_message": "Peel and mince garlic and ginger. In a medium bowl, whisk together ½ of the garlic and ginger (save the rest for the bok choy), lemon juice, soy sauce, and honey.",
            "secondary_message": "4 cloves garlic\r\n2 (1 inch) pieces ginger\r\n1 lemon\r\n8 tbsp soy sauce\r\n2 tbsp honey"
          },
          {
            "id": 40488,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 12476,
            "primary_message": "Place salmon in a baking dish and spoon ½ of the sauce over top.",
            "secondary_message": "1 ½ lb salmon fillet"
          },
          {
            "id": 12477,
            "primary_message": "Place in the oven and bake, spooning remaining sauce over top halfway through, until salmon is opaque, 12-15 minutes.",
            "secondary_message": ""
          },
          {
            "id": 12479,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 12480,
            "primary_message": "Wash bok choy, trim ends, and separate into leaves.",
            "secondary_message": "12 baby bok choy"
          },
          {
            "id": 12481,
            "primary_message": "Coat bottom of skillet with oil. Add remaining garlic and ginger and pepper; cook until fragrant, 15-30 seconds.",
            "secondary_message": "about 2 tbsp virgin coconut oil\r\n¼ tsp crushed red pepper"
          },
          {
            "id": 12482,
            "primary_message": "Add bok choy and soy sauce. Tossing occasionally, cook until greens are just wilted and stalks are tender-crisp, 2-3 minutes.",
            "secondary_message": "1 tbsp soy sauce"
          },
          {
            "id": 40487,
            "primary_message": "Uncover the rice and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 12483,
            "primary_message": "To serve, arrange salmon, rice, and bok choy on a plate. Enjoy!",
            "secondary_message": ""
          }
        ],
