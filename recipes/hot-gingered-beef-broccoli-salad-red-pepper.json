        "instructions": [
          {
            "id": 179542,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "2 (1 inch) pieces ginger root\n2 crowns broccoli\n2 red bell peppers\n2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 179543,
            "primary_message": "Peel and mince garlic and ginger; place both in a large bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 179544,
            "primary_message": "Add oils, soy sauce, vinegar, and chili-garlic sauce to the bowl; whisk to combine the dressing.",
            "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp toasted sesame oil\n2 tbsp soy sauce\n2 tbsp rice vinegar\n2 tsp chili-garlic sauce"
          },
          {
            "id": 179545,
            "primary_message": "Slice the steak into thin strips and place in a medium bowl. Add ⅓ of the dressing and toss to coat; set aside to marinate.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak"
          },
          {
            "id": 179546,
            "primary_message": "Using a clean cutting board, separate broccoli into bite-sized florets and cut stems into smaller pieces.",
            "secondary_message": null
          },
          {
            "id": 179547,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 179548,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 179549,
            "primary_message": "Add broccoli to the skillet and cook, stirring often, until bright green and almost cooked through, about 6 minutes.",
            "secondary_message": null
          },
          {
            "id": 179550,
            "primary_message": "Add steak strips and marinade to the skillet. Cook, stirring often, until desired doneness, 3-4 minutes for medium. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 179551,
            "primary_message": "Meanwhile, seed and slice bell peppers into thin strips.",
            "secondary_message": null
          },
          {
            "id": 179552,
            "primary_message": "Add bell pepper and mixed greens to the bowl with the remaining dressing; toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 179553,
            "primary_message": "To serve, divide salad between plates or bowls and top with steak-broccoli stir-fry and sesame seeds. Enjoy!",
            "secondary_message": "2 tsp sesame seeds"
          }
        ],
