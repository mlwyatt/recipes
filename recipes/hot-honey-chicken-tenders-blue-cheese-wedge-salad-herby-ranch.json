        "instructions": [
          {
            "id": 466975,
            "primary_message": "Preheat oven to 375°F. Coat a large baking sheet pan with a thin layer of oil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 466976,
            "primary_message": "Place bread crumbs and spices in a small bowl. Stir to combine the coating.",
            "secondary_message": "1 cup panko bread crumbs\n½ tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 466977,
            "primary_message": "Place mayo, soy sauce, and salt in a medium bowl; stir to combine.",
            "secondary_message": "¼ cup mayonnaise\n2 tsp soy sauce\n½ tsp salt"
          },
          {
            "id": 466978,
            "primary_message": "Pat chicken dry with paper towels, then slice into ¾-inch strips. Add to the bowl with the mayo mixture and toss to coat.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 466979,
            "primary_message": "Add bread crumb coating to the bowl with the chicken and toss well to coat. Transfer coated chicken to the baking sheet and arrange in a single layer. (Reserve small bowl for later use.)",
            "secondary_message": null
          },
          {
            "id": 466980,
            "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 15-18 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 466981,
            "primary_message": "Meanwhile, place honey, hot sauce, and salt in the reserved bowl. Whisk to combine the hot honey and set aside.",
            "secondary_message": "¼ cup honey\n2 tbsp hot sauce\n⅛ tsp salt"
          },
          {
            "id": 466982,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n1 small bunch fresh dill\n1 small pkg chives\n1 head romaine lettuce\n1 pint grape tomatoes"
          },
          {
            "id": 466983,
            "primary_message": "Juice lemon into a blender.",
            "secondary_message": null
          },
          {
            "id": 466984,
            "primary_message": "Using a clean cutting board, shave dill leaves off the stems; discard stems and add leaves to the blender.",
            "secondary_message": null
          },
          {
            "id": 466985,
            "primary_message": "Roughly chop chives. Add half to the blender along with yogurt, mayo, and spices. Blend on high until herby ranch dressing is smooth; set aside. (Reserve remaining chives for serving.)",
            "secondary_message": "½ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 466986,
            "primary_message": "Trim and cut romaine into quarters lengthwise, to make 4 wedges.",
            "secondary_message": null
          },
          {
            "id": 466987,
            "primary_message": "Halve grape tomatoes lengthwise. Season with salt.",
            "secondary_message": "⅛ tsp salt"
          },
          {
            "id": 466988,
            "primary_message": "Divide chicken tenders and romaine wedges between plates. Top wedges with dressing, tomatoes, blue cheese, and remaining chives. Serve with hot honey for dipping chicken. Enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
          }
        ],
