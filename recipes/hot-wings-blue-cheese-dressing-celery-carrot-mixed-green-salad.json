  "instructions": [
    {
      "id": 371936,
      "primary_message": "Preheat oven to 500°F. Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 371937,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "2 lb chicken wings, split with tips removed\n2 tbsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 371938,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until wings are cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 371939,
      "primary_message": "About 5 minutes before the wings are done, wash, dry, trim, and thinly slice celery. Place in a medium bowl.",
      "secondary_message": "4 sticks celery"
    },
    {
      "id": 371940,
      "primary_message": "Wash and dry the mixed greens (skip if they came pre-washed). Add to the bowl with the celery along with carrots and dressing. Toss to combine the salad.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n1 (10 oz) bag shredded carrots\n¼ cup blue cheese dressing"
    },
    {
      "id": 371941,
      "primary_message": "Place hot sauce and oil in a clean large bowl. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup hot sauce\n4 tsp extra virgin olive oil"
    },
    {
      "id": 371942,
      "primary_message": "When the wings are done, remove from the oven and add to the bowl with the sauce. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 371943,
      "primary_message": "To serve, divide hot wings and salad between plates. Serve with additional dressing on the side for dipping. Enjoy!",
      "secondary_message": "½ cup blue cheese dressing"
    }
  ],
