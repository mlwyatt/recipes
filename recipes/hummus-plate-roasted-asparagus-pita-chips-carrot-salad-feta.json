  "instructions": [
    {
      "id": 141023,
      "primary_message": "Preheat oven to 425°F and position racks in the upper and lower thirds of the oven. ",
      "secondary_message": null
    },
    {
      "id": 141024,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n2 lemons\n2 medium carrots\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 141025,
      "primary_message": "Snap or cut off woody ends of the asparagus, then cut in half crosswise. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 141026,
      "primary_message": "Place the pitas on a flat surface. Holding a knife parallel to the cutting board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces and place on a separate baking sheet pan. ",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 141027,
      "primary_message": "Grate zest from the lemons and transfer to a small bowl. Add oil and spices to the bowl and whisk to combine the herb oil. ",
      "secondary_message": "¼ cup extra virgin olive oil\n½ tsp salt\n½ tsp thyme\n½ tsp basil\n½ tsp oregano"
    },
    {
      "id": 141028,
      "primary_message": "Spoon the herb oil over the asparagus and pita. Toss the asparagus and pita with your hands, then spread out in an even layer. ",
      "secondary_message": null
    },
    {
      "id": 141029,
      "primary_message": "Place the asparagus on the upper rack of the oven and the pita on the rack below. Bake, tossing halfway through, until the asparagus is cooked through and pita chips are crisp, 6-8 minutes. Remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 141030,
      "primary_message": "Meanwhile, drain and rinse the beans. Measure out a ½ cup of beans and set aside in a small bowl.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 141031,
      "primary_message": "Peel the garlic. Add garlic and remaining beans to a blender. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 141032,
      "primary_message": "Juice 1 lemon into the blender. Add water, oil, tahini, and spices, then blend on high for several minutes until smooth. Add more water, one tbsp at a time, if needed, to reach desired consistency. Set aside.",
      "secondary_message": "⅓ cup water\n¼ cup extra virgin olive oil\n2 tbsp tahini\n½ tsp salt\n¼ tsp cumin\n¼ tsp paprika"
    },
    {
      "id": 141033,
      "primary_message": "Juice remaining lemon into a medium bowl. Add maple syrup and spices to the bowl and whisk to combine.",
      "secondary_message": "1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp cumin\n⅛ tsp cinnamon\n⅛ tsp cayenne pepper"
    },
    {
      "id": 141034,
      "primary_message": "Peel and trim carrot; using a box grater, coarsely grate the carrot and place in the bowl with the lemon dressing. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 141035,
      "primary_message": "Trim cucumber and slice crosswise into ¼-inch-thick pieces at an angle. ",
      "secondary_message": null
    },
    {
      "id": 141036,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 141037,
      "primary_message": "To serve, divide hummus between bowls or plates; garnish with reserved beans and drizzle with oil. Arrange the asparagus, pita chips, carrot salad, sliced cucumber, and feta around the hummus. Sprinkle parsley over top and enjoy!",
      "secondary_message": "1 tsp extra virgin olive oil\n1 (4 oz) pkg crumbled feta cheese"
    }
  ],
