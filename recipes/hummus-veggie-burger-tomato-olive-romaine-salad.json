  "instructions": [
    {
      "id": 369558,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 369559,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. ",
      "secondary_message": "4 tomatoes\n2 red bell peppers\n2 hearts romaine hearts"
    },
    {
      "id": 369560,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove from heat. ",
      "secondary_message": "4 tsp extra virgin olive oil\n4 veggie burger patties, plant-based"
    },
    {
      "id": 369561,
      "primary_message": "Meanwhile, thinly slice half of the tomatoes and place on a plate; season with salt. Medium dice remaining tomatoes and place in a medium bowl. ",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 369562,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the tomato. ",
      "secondary_message": null
    },
    {
      "id": 369563,
      "primary_message": "Separate lettuce into leaves. Set aside one leaf per burger, adding them to the plate with the sliced tomato. Chop (or tear) remaining leaves into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369564,
      "primary_message": "Roughly chop olives. Add to the bowl, along with the vinaigrette, and toss to combine the salad. Set aside.",
      "secondary_message": "½ cup Kalamata olives, pitted\n¼ cup balsamic vinaigrette"
    },
    {
      "id": 369565,
      "primary_message": "Toast buns if desired. ",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 369566,
      "primary_message": "Spread top and bottom halves of each bun with hummus. Layer the bottom halves with lettuce, tomato, and burger patties, then close with the top half of each bun. ",
      "secondary_message": "1 cup hummus"
    },
    {
      "id": 369567,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
