        "instructions": [
          {
            "id": 266980,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n2 (1 inch) pieces ginger root\n2 medium yellow potatoes\n2 tomatoes\n1 small bunch cilantro\n1 English cucumber"
          },
          {
            "id": 266981,
            "primary_message": "Cut off leaves from the cauliflower, separate into small florets, and cut the thick stems into smaller pieces. Place in a medium bowl and set aside. ",
            "secondary_message": null
          },
          {
            "id": 266982,
            "primary_message": "Peel and mince ginger and garlic. ",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 266983,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 266984,
            "primary_message": "While the pot heats up, peel, halve, and small dice onion.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 266985,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, onion, and salt; cook, stirring occasionally, until softened, about 5 minutes.",
            "secondary_message": "4 tsp virgin coconut oil\n½ tsp salt"
          },
          {
            "id": 266986,
            "primary_message": "Meanwhile, peel and small dice potatoes; medium dice tomatoes. Add both to the bowl with the cauliflower. ",
            "secondary_message": null
          },
          {
            "id": 266987,
            "primary_message": "Add spices to the pot and continue to cook, stirring constantly, until fragrant, about 1 minute. ",
            "secondary_message": "2 tsp curry powder\n2 tsp cumin, ground\n2 tsp coriander, ground\n1 tsp turmeric, ground\n1 tsp chili powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 266988,
            "primary_message": "Add cauliflower, potato, tomato, and broth to the pot; stir to combine and bring to a boil over medium-high heat. Once boiling, reduce heat to a simmer and cover; cook, stirring occasionally, until veggies are tender, 15-18 minutes. (Reserve bowl for the next step.)",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 266989,
            "primary_message": "While the curry cooks, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in the reserved bowl (reserving the rest for the curry). ",
            "secondary_message": null
          },
          {
            "id": 266990,
            "primary_message": "Trim and grate cucumber into the bowl with the cilantro; add yogurt, water, salt, and pepper. Stir to combine the raita and set aside. ",
            "secondary_message": "1 cup plain Greek yogurt\n2 tbsp water\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 266991,
            "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
            "secondary_message": null
          },
          {
            "id": 266992,
            "primary_message": "Divide naan between two baking sheet pans. Working in batches, place in the oven and broil, flipping once, until golden brown and toasted, 1-2 minutes. Remove from oven, spread with oil, and cut into quarters.",
            "secondary_message": "4 flatbreads or naan\n1 tsp virgin coconut oil"
          },
          {
            "id": 266993,
            "primary_message": "When the curry is done, stir in reserved cilantro and remove from the heat. ",
            "secondary_message": null
          },
          {
            "id": 266994,
            "primary_message": "Divide curry between bowls; serve with raita and naan on the side. Enjoy! ",
            "secondary_message": null
          }
        ],
