        "instructions": [
          {
            "id": 147294,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 lb sweet potato\n1 medium head cauliflower\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 147295,
            "primary_message": "Peel and small dice the onion. Peel and mince the garlic.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 147296,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 147297,
            "primary_message": "Peel and mince or grate the ginger. ",
            "secondary_message": null
          },
          {
            "id": 147298,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 147299,
            "primary_message": "Add onion and garlic to the pot; cook, stirring occasionally, until softened, 3-4 minutes.",
            "secondary_message": null
          },
          {
            "id": 147300,
            "primary_message": "Meanwhile, rinse the lentils in a colander or strainer.",
            "secondary_message": "1 cup red lentils"
          },
          {
            "id": 147301,
            "primary_message": "Add ginger and spices to the pot; cook, stirring frequently, until fragrant, about 1 minute.",
            "secondary_message": "2 tbsp curry powder\n2 tsp coriander\n1 tsp cumin"
          },
          {
            "id": 147302,
            "primary_message": "Add the lentils, broth, water, salt and pepper to the pot; bring the mixture to a boil.",
            "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 cup water\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 147303,
            "primary_message": "Meanwhile, peel and small dice the sweet potatoes; add to the pot.",
            "secondary_message": null
          },
          {
            "id": 147304,
            "primary_message": "Trim and discard the leaves and thick stem of the cauliflower and cut into small, bite-sized pieces; add to the pot.",
            "secondary_message": null
          },
          {
            "id": 147305,
            "primary_message": "Stir to combine the soup, then cover and reduce the heat to a simmer. Cook, stirring occasionally, until lentils and vegetables are tender, about 15 minutes.",
            "secondary_message": null
          },
          {
            "id": 147306,
            "primary_message": "Cut pita into wedges.",
            "secondary_message": "2 whole grain pitas"
          },
          {
            "id": 147307,
            "primary_message": "Uncover the soup and stir in the spinach. Cook until spinach is wilted and soup is heated through, about 3 more minutes.",
            "secondary_message": null
          },
          {
            "id": 147308,
            "primary_message": "To serve, divide soup between bowls and serve with pita on the side. Enjoy! ",
            "secondary_message": null
          }
        ],
