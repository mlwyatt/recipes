        "instructions": [
          {
            "id": 146963,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium yellow potatoes\n4 (1 inch) pieces ginger root\n2 jalapeño peppers\n1 lemon\n1 small bunch cilantro\n1 small pkg fresh mint"
          },
          {
            "id": 146964,
            "primary_message": "Medium dice potatoes. Transfer to a medium saucepan, add salt, cover with water, and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and set aside.",
            "secondary_message": "2 tsp salt"
          },
          {
            "id": 146965,
            "primary_message": "Peel and grate or mince the ginger. Transfer half of the ginger to a blender; place the other half in a small bowl.",
            "secondary_message": null
          },
          {
            "id": 146966,
            "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely dice; add half to the blender and half to the small bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
            "secondary_message": null
          },
          {
            "id": 146967,
            "primary_message": "Juice lemon into the blender.",
            "secondary_message": null
          },
          {
            "id": 146968,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems. Add cilantro to the blender, along with coconut, water, salt, chili powder, and sugar. Blend on high until smooth and creamy. Transfer cilantro chutney to a small bowl and set aside. Rinse blender.",
            "secondary_message": "½ cup shredded unsweetened coconut\n¼ cup water\n½ tsp salt\n¼ tsp chili powder\n¼ tsp brown sugar"
          },
          {
            "id": 146969,
            "primary_message": "Pick mint leaves off the stems; discard the stems. Transfer mint leaves to the blender along with yogurt, water, sugar, and spices. Blend on high until smooth and creamy. Transfer mint raita to a small bowl and set aside.",
            "secondary_message": "1 cup plain Greek yogurt\n2 tbsp water\n¼ tsp brown sugar\n¼ tsp salt\n¼ tsp cumin\n¼ tsp chili powder"
          },
          {
            "id": 146970,
            "primary_message": "Peel and mince the onion.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 146971,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 146972,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add reserved ginger, jalapeño, and onion to the skillet; cook, stirring constantly, until softened, 4-6 minutes.",
            "secondary_message": "¼ cup virgin coconut oil"
          },
          {
            "id": 146973,
            "primary_message": "Add cooked potatoes, water, Dijon, and spices to the skillet; mash with a fork or potato masher, leaving some small pieces whole.",
            "secondary_message": "1 cup water\n2 tsp Dijon mustard\n1 tsp salt\n1 tsp curry powder\n1 tsp turmeric\n1 tsp cumin\n½ tsp chili powder"
          },
          {
            "id": 146974,
            "primary_message": "Add peas, and cook, stirring often, until peas are tender and potatoes are soft and fragrant, 3-4 minutes.",
            "secondary_message": "2 cups frozen peas"
          },
          {
            "id": 146975,
            "primary_message": "Toast pita if desired, then slice in half and carefully open using your fingers. Fill each pita with an equal portion of the potato filling.",
            "secondary_message": "4 whole grain pitas"
          },
          {
            "id": 146976,
            "primary_message": "To serve, divide spiced potato pockets between plates. Enjoy with cilantro chutney and mint raita on the side!",
            "secondary_message": null
          }
        ],
