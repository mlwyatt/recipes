        "instructions": [
          {
            "id": 361035,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 361036,
            "primary_message": "While the pot heats up, wash, dry, trim, and thinly slice celery crosswise. ",
            "secondary_message": "4 sticks celery"
          },
          {
            "id": 361037,
            "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom; add celery and cook, stirring occasionally, until softened, 2-3 minutes.",
            "secondary_message": "4 tsp butter, unsalted"
          },
          {
            "id": 361038,
            "primary_message": "Add broth, marinara, garam masala, and salt to the pot; stir to combine the soup and bring to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until flavors blend, 8-10 minutes.",
            "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 (24 oz) jar marinara sauce\n4 tsp garam masala\n½ tsp salt"
          },
          {
            "id": 361039,
            "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
            "secondary_message": null
          },
          {
            "id": 361040,
            "primary_message": "Arrange naan on a large baking sheet pan; place in the oven and broil, flipping once, until golden brown and toasted, 1-2 minutes.",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 361041,
            "primary_message": "While the naan is toasting, slice peppers into strips. ",
            "secondary_message": "1 (12 oz) jar roasted red bell peppers"
          },
          {
            "id": 361042,
            "primary_message": "Remove naan from oven and top with sliced peppers and blue cheese. ",
            "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
          },
          {
            "id": 361043,
            "primary_message": "When the soup is almost done, return naan to the oven and broil until cheese is melted and warmed through, 1-2 minutes. Remove from oven and cut into quarters. ",
            "secondary_message": null
          },
          {
            "id": 361044,
            "primary_message": "When the soup is done, wash and dry the spinach (skip this step if it came pre-washed). Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat. ",
            "secondary_message": "1 (5 oz) pkg baby spinach"
          },
          {
            "id": 361045,
            "primary_message": "Divide soup between bowls and serve with naan on the side. Enjoy!",
            "secondary_message": null
          }
        ],
