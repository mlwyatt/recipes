        "instructions": [
          {
            "id": 281500,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 281501,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb sweet potatoes\n1 pint grape tomatoes\n2 yellow bell peppers\n1 small pkg fresh basil"
          },
          {
            "id": 281502,
            "primary_message": "Peel and cut sweet potatoes lengthwise into ¼-inch thick strips; place in a medium bowl. Add oil and salt, toss to coat, then spread out on a large baking sheet pan. (Reserve bowl for later use.)",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt"
          },
          {
            "id": 281503,
            "primary_message": "Place sweet potato in the oven (it doesn't have to be fully heated) and bake, tossing once, until golden and fork-tender, about 25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 281504,
            "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
            "secondary_message": "4 tsp balsamic vinegar\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 281505,
            "primary_message": "Halve tomatoes lengthwise and add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 281506,
            "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 281507,
            "primary_message": "Medium dice mozzarella and add to the bowl.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 281508,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl, stir to combine the salad, and set aside.",
            "secondary_message": null
          },
          {
            "id": 281509,
            "primary_message": "Pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with spices.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 281510,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 281511,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat and cover to keep warm.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 281512,
            "primary_message": "To serve, divide chicken, sweet potatoes, and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
