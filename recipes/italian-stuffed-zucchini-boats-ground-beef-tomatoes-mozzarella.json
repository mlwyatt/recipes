        "instructions": [
          {
            "id": 10239,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": ""
          },
          {
            "id": 10240,
            "primary_message": "Wash and halve zucchini lengthwise. Scrape out and discard the soft flesh from the middle of each half.",
            "secondary_message": "4 zucchini"
          },
          {
            "id": 10241,
            "primary_message": "Place zucchini halves in a baking dish cut side up. Rub with a little olive oil and season with a little salt and pepper. Place in the oven and bake while you prepare the filling, 15-20 minutes.",
            "secondary_message": "about 1 tsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
          },
          {
            "id": 10242,
            "primary_message": "Heat a sauté pan over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 10243,
            "primary_message": "Wash and small dice mushrooms. Wash and dice tomatoes. Peel and mince onion and garlic.",
            "secondary_message": "½ lb white mushrooms\n2 tomatoes\n1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 10244,
            "primary_message": "Coat bottom of pan with oil. Add onion, garlic, and mushrooms. Stirring frequently, cook until vegetables are softened, 3-4 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 10245,
            "primary_message": "Add beef and, breaking apart with a spoon, cook until browned and crumbly, 3-4 minutes.",
            "secondary_message": "1 ½ lb lean ground beef"
          },
          {
            "id": 10246,
            "primary_message": "Add diced tomatoes, tomato sauce, Italian seasoning, salt, and pepper. Cook until most of the liquid has evaporated, 2-3 minutes.",
            "secondary_message": "2 (8 oz) cans tomato sauce\r\n2 tsp Italian seasoning\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 10247,
            "primary_message": "Coarsely grate 1 cup of mozzarella.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 10248,
            "primary_message": "Remove dish from oven. Fill zucchini halves with beef mixture and sprinkle with cheese. Place back in the oven and bake until cheese melts, 4-5 minutes.",
            "secondary_message": ""
          },
          {
            "id": 10249,
            "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 10250,
            "primary_message": "To serve, place zucchini boats on a plate and garnish with parsley. Enjoy!",
            "secondary_message": ""
          }
        ],
