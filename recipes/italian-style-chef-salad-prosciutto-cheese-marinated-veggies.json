        "instructions": [
          {
            "id": 430772,
            "primary_message": "Place dressing, mayo, and salt in a small bowl. Stir to combine and set aside.",
            "secondary_message": "½ cup Italian salad dressing\n¼ cup mayonnaise\n¼ tsp salt"
          },
          {
            "id": 430773,
            "primary_message": "Drain and roughly chop roasted peppers and artichoke hearts. Transfer both to a plate.",
            "secondary_message": "1 (12 oz) jar roasted red bell peppers\n2 (6 oz) jars artichoke hearts, marinated"
          },
          {
            "id": 430774,
            "primary_message": "Cut or tear each slice of prosciutto in half; roll each piece and add to the plate with the roasted peppers and artichokes.",
            "secondary_message": "12 slices prosciutto"
          },
          {
            "id": 430775,
            "primary_message": "Slice eggs crosswise. Season with salt and add to the plate.",
            "secondary_message": "8 hard-cooked eggs, peeled\n⅛ tsp salt"
          },
          {
            "id": 430776,
            "primary_message": "Wash, dry, and halve tomatoes lengthwise. Add to the plate.",
            "secondary_message": "1 pint grape tomatoes"
          },
          {
            "id": 430777,
            "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces.",
            "secondary_message": "4 hearts romaine hearts"
          },
          {
            "id": 430778,
            "primary_message": "To serve, divide lettuce between plates or bowls. Top with roasted peppers, artichoke hearts, prosciutto, eggs, tomatoes, and cheese. Drizzle with the dressing and enjoy!",
            "secondary_message": "1 ⅓ cups shredded cheese, Italian blend"
          }
        ],
