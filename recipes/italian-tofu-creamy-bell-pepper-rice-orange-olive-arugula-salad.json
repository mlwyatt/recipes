        "instructions": [
          {
            "id": 243822,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 243823,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 243824,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "2 red bell peppers\n2 oranges\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 243825,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and salt to the pan; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n20 fl oz (2 ½ cups) chicken or vegetable broth\n½ tsp salt"
          },
          {
            "id": 243826,
            "primary_message": "While the broth is heating up, trim, seed, and mince bell peppers.",
            "secondary_message": null
          },
          {
            "id": 243827,
            "primary_message": "Once the broth comes to a boil, add bell pepper and stir to combine; cover the saucepan and reduce heat to low. Cook bell pepper-rice until liquid is mostly absorbed, 18-20 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 243828,
            "primary_message": "Meanwhile, place oil and spices in a large bowl; stir to combine the spice paste. ",
            "secondary_message": "3 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp onion powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 243829,
            "primary_message": "Medium dice tofu, add to the bowl with the spice paste, and gently stir to coat. Transfer tofu to a large baking sheet and spread out in a single layer. (Reserve bowl for later use.)",
            "secondary_message": null
          },
          {
            "id": 243830,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, about 20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 243831,
            "primary_message": "While the tofu is cooking, peel and mince garlic. Place in the reserved bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
            "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n4 tsp white wine vinegar\n½ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 243832,
            "primary_message": "Peel and thinly slice shallot into rings. Add to the bowl with the dressing.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 243833,
            "primary_message": "Cut off skin and white pith from the oranges; slice between the membranes to release segments. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 243834,
            "primary_message": "Halve olives lengthwise. Add to the bowl along with the arugula and toss to combine the salad. Set aside.",
            "secondary_message": "¼ cup Kalamata olives, pitted"
          },
          {
            "id": 243835,
            "primary_message": "Finely grate Parmesan. When the bell pepper-rice is done, add Parmesan to the pan and stir until creamy and combined.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 243836,
            "primary_message": "To serve, divide tofu, creamy bell pepper-rice, and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
