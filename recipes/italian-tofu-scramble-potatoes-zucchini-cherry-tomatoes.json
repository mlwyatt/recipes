        "instructions": [
          {
            "id": 98918,
            "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 98919,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium yellow potatoes\n2 medium zucchini squash\n1 pint grape tomatoes"
          },
          {
            "id": 98920,
            "primary_message": "Small dice the potatoes (cut into ¼-inch cubes). Transfer to a medium saucepan and cover with hot water (from the tap). Bring to a boil over high heat; reduce heat and simmer, covered, for 9 minutes. Once finished, drain the potatoes and set aside.",
            "secondary_message": null
          },
          {
            "id": 98921,
            "primary_message": "Peel and small dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 98922,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 98923,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and garlic, and cook, stirring occasionally, 3-4 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 98924,
            "primary_message": "Halve zucchinis lengthwise, then slice crosswise into half rounds. Add the zucchinis and spices to the skillet and stir to combine.",
            "secondary_message": "1 tsp turmeric\n1 tsp salt\n½ tsp basil\n½ tsp oregano"
          },
          {
            "id": 98925,
            "primary_message": "Crumble the tofu with your fingers into the skillet. Add the cooked potatoes and stir to combine. Sauté until the veggies are softened, 7-8 minutes.",
            "secondary_message": null
          },
          {
            "id": 98926,
            "primary_message": "Halve the grape tomatoes.",
            "secondary_message": null
          },
          {
            "id": 98927,
            "primary_message": "Remove from the heat and stir in the grape tomatoes. Divide between plates and enjoy!",
            "secondary_message": null
          }
        ],
