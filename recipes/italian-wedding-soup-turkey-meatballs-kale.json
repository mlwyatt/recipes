        "instructions": [
          {
            "id": 40965,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium carrots\n2 sticks celery\n2 bunches kale\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 40966,
            "primary_message": "Trim off and discard the ends of the celery; small dice the celery (cut into ¼-inch cubes) and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 40967,
            "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Small dice the carrots (cut into ¼-inch cubes) and add to the bowl with the celery.",
            "secondary_message": null
          },
          {
            "id": 40968,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 40969,
            "primary_message": "While the pot heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces) and add to the bowl with the celery and carrots.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 40970,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the other vegetables.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 40971,
            "primary_message": "Once the pot is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 40972,
            "primary_message": "Add the carrots, celery, onion, and garlic to the pot; season with salt and pepper. Cook, stirring occasionally, until the vegetables are softened, 5 to 6 minutes.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 40973,
            "primary_message": "Finely grate about 1 ½ cups of Parmesan and transfer to a small bowl.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 40974,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 40975,
            "primary_message": "In a medium bowl, combine the ground turkey, ¾ of the grated Parmesan (save the rest for garnishing), salt, and pepper; mix together until well combined. Form the mixture into meatballs, each about 1 inch in diameter.",
            "secondary_message": "1 ½ lb ground turkey\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 40976,
            "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 40977,
            "primary_message": "Add the meatballs to the skillet; cook, turning occasionally, until browned on all sides (they don't need to be cooked through), 5 to 7 minutes. Once done, transfer to a bowl.",
            "secondary_message": null
          },
          {
            "id": 40978,
            "primary_message": "Once the vegetables are softened, add broth, Italian seasoning, and crushed red pepper to the saucepan and bring the mixture to a boil.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n1 tsp Italian seasoning\n¼ tsp crushed red pepper"
          },
          {
            "id": 40979,
            "primary_message": "Cut out and discard the center stems from the kale leaves; slice the leaves crosswise into 1-inch strips and transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 40980,
            "primary_message": "Once boiling, add the kale and meatballs to the pot; season with additional salt and pepper. Reduce the heat to a simmer and cook until the meatballs are cooked through, 6 to 8 minutes.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 40981,
            "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Stir the parsley into the soup.",
            "secondary_message": null
          },
          {
            "id": 40982,
            "primary_message": "To serve, divide the soup between bowls and garnish with the remaining Parmesan. Enjoy!",
            "secondary_message": null
          }
        ],
