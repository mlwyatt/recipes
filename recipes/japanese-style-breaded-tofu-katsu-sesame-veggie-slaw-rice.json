        "instructions": [
          {
            "id": 409419,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 409420,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 409421,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
          },
          {
            "id": 409422,
            "primary_message": "Meanwhile, place mayo and spices in a small bowl. Whisk to combine the curried mayo.",
            "secondary_message": "¼ cup mayonnaise\n1 ½ tsp curry powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 409423,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 409424,
            "primary_message": "While the rice is cooking, cut the tofu planks in half crosswise and return to the baking sheet. ",
            "secondary_message": null
          },
          {
            "id": 409425,
            "primary_message": "Spread half of the curried mayo over the top side of the tofu, sprinkle with half of the bread crumbs (pressing gently to adhere), and drizzle with half of the oil. Carefully flip tofu and repeat with remaining mayo, bread crumbs, and oil. (Reserve bowl for later use.)",
            "secondary_message": "1 cup panko bread crumbs\n4 tsp toasted sesame oil"
          },
          {
            "id": 409426,
            "primary_message": "Place tofu in the oven and bake, turning halfway through, until the breading is crispy and golden brown, 15-18 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 409427,
            "primary_message": "Meanwhile, place ketchup, soy sauce, maple syrup, chili-garlic sauce, and garlic powder in the reserved bowl. Whisk to combine the \"tonkatsu\" sauce and set aside.",
            "secondary_message": "¼ cup ketchup\n2 tbsp soy sauce\n1 tbsp pure maple syrup\n2 tsp chili-garlic sauce\n½ tsp garlic powder"
          },
          {
            "id": 409428,
            "primary_message": "Place additional mayo, vinegar, soy sauce, oil, and chili-garlic sauce in a medium bowl. Whisk to combine the dressing.",
            "secondary_message": "2 tbsp mayonnaise\n4 tsp rice vinegar\n4 tsp soy sauce\n1 tbsp toasted sesame oil\n2 tsp chili-garlic sauce"
          },
          {
            "id": 409429,
            "primary_message": "Wash, dry, trim, and quarter cucumber lengthwise, then cut crosswise into thin pieces. Add to the bowl with the dressing.",
            "secondary_message": "1 English cucumber"
          },
          {
            "id": 409430,
            "primary_message": "Wash, dry, trim, and thinly slice radishes. Add to the bowl, along with the broccoli slaw, and toss to combine.",
            "secondary_message": "1 bunch radish\n1 (12 oz) pkg broccoli slaw"
          },
          {
            "id": 409431,
            "primary_message": "To serve, divide rice, tofu, and slaw between plates or bowls; drizzle sauce over tofu and enjoy!",
            "secondary_message": null
          }
        ],
