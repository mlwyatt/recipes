  "instructions": [
    {
      "id": 223448,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 small pkg chives\n1 lime"
    },
    {
      "id": 223449,
      "primary_message": "Peel and mince ginger and garlic. Transfer both to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 223450,
      "primary_message": "Add eggs and broth to the bowl with the ginger and garlic; whisk to combine and set aside.",
      "secondary_message": "4 eggs\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 223451,
      "primary_message": "Place flour, baking powder, and salt in a large  bowl; whisk to combine. Gradually add the egg mixture to the bowl with the flour, whisking to create a smooth batter.",
      "secondary_message": "1 cup all-purpose flour\n2 tsp baking powder\n1 tsp salt"
    },
    {
      "id": 223452,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 223453,
      "primary_message": "While the skillet heats up, add broccoli slaw to the bowl with the batter and stir until thoroughly combined.",
      "secondary_message": "2 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 223454,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add one-quarter of the pancake batter (1¼-cups per pancake) to the skillet and smooth out into a large, ½-inch thick pancake. Cook, flipping once, until golden brown and cooked through, 3-4 minutes per side. Remove to a plate and cover with foil.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 223455,
      "primary_message": "While the pancake is cooking, preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 223456,
      "primary_message": "While the pan heats up, use the tip of a knife to slice down the length of each sausage. Peel off casings and discard.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 223457,
      "primary_message": "Add sausage meat to the pan and cook, breaking apart with a spoon, until crispy and cooked through, about 7 minutes. Remove from heat, cover, and set aside.",
      "secondary_message": null
    },
    {
      "id": 223458,
      "primary_message": "Once the first pancake is done cooking, add more oil (1 teaspoon per pancake) to the skillet and repeat with remaining batter.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 223459,
      "primary_message": "Meanwhile, chop chives into small pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 223460,
      "primary_message": "Juice the lime into a small bowl. Add mayo and chili-garlic sauce; whisk to combine the spicy mayo.",
      "secondary_message": "¼ cup mayonnaise\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 223461,
      "primary_message": "To serve, place a pancake on each plate. Top with crispy sausage, drizzle with spicy mayo, and sprinkle with chives. Enjoy!",
      "secondary_message": null
    }
  ],
