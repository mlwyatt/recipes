        "instructions": [
          {
            "id": 263357,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n2 Gala apples\n2 bunches kale"
          },
          {
            "id": 263358,
            "primary_message": "Peel and mince garlic; mince anchovy fillets. Divide both evenly between two large bowls; set one bowl aside.",
            "secondary_message": "4 cloves garlic\n4 anchovy fillets, packed in oil"
          },
          {
            "id": 263359,
            "primary_message": "Add beef, salt, and pepper to the first bowl with garlic and anchovy. Use your hands to thoroughly combine. Form into 4 equal-sized patties, place on a plate, and set aside.",
            "secondary_message": "1 ½ lb lean ground beef\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 263360,
            "primary_message": "Zest and juice lemon into the second bowl with garlic and anchovy. Add mayo and whisk to combine the dressing.",
            "secondary_message": "3 tbsp mayonnaise"
          },
          {
            "id": 263361,
            "primary_message": "Quarter and core apples, then thinly slice each quarter; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 263362,
            "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces, add to the bowl with the dressing, and toss to combine the salad. Set aside.",
            "secondary_message": null
          },
          {
            "id": 263363,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 263364,
            "primary_message": "Once the grill pan is hot, coat with oil. Place burger patties on the grill and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 263365,
            "primary_message": "Meanwhile, finely grate Parmesan.",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 263366,
            "primary_message": "Toast buns on the grill pan (if desired).",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 263367,
            "primary_message": "Place a burger on the bottom half of each bun; top with half the Parmesan and a small portion of salad. Close with the top half of each bun.",
            "secondary_message": null
          },
          {
            "id": 263368,
            "primary_message": "To serve, divide burgers and remaining salad between plates. Top salad with remaining Parmesan and enjoy!",
            "secondary_message": null
          }
        ],
