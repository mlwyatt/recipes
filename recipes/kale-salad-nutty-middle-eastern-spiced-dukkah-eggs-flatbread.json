        "instructions": [
          {
            "id": 337254,
            "primary_message": "Mince walnuts.",
            "secondary_message": "½ cup walnuts"
          },
          {
            "id": 337255,
            "primary_message": "Preheat a medium saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 337256,
            "primary_message": "While the pan heats up, peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 337257,
            "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add walnuts, garlic, sesame seeds, and spices to the pan. Cook, stirring constantly, until fragrant and toasted, 1-2 minutes. Transfer the \"dukkah\" spice mix to a small bowl to keep the garlic from overcooking. (Reserve pan for next step.)",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tbsp sesame seeds\n2 tsp coriander, ground\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 337258,
            "primary_message": "Wipe the saucepan clean with paper towels. Place eggs in the pan, cover with water (from the tap), and bring to a boil; reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
            "secondary_message": "8 eggs"
          },
          {
            "id": 337259,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n1 bunch kale\n1 English cucumber\n1 pint grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 337260,
            "primary_message": "Peel and mince additional garlic; place in a medium bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 337261,
            "primary_message": "Zest and juice lemon into the bowl with the garlic, then add oil, salt, and pepper; whisk to combine the dressing.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 337262,
            "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
            "secondary_message": null
          },
          {
            "id": 337263,
            "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons; halve tomatoes. Add both to the bowl.",
            "secondary_message": null
          },
          {
            "id": 337264,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, toss to combine the salad, and set aside.",
            "secondary_message": null
          },
          {
            "id": 337265,
            "primary_message": "Peel eggs, roll in the dukkah to coat, and halve lengthwise. (Reserve remaining dukkah for the flatbread.)",
            "secondary_message": null
          },
          {
            "id": 337266,
            "primary_message": "Toast flatbread if desired; drizzle with oil, sprinkle with remaining dukkah, and cut into wedges.",
            "secondary_message": "2 flatbreads or naan\n2 tsp extra virgin olive oil"
          },
          {
            "id": 337267,
            "primary_message": "To serve, divide salad, eggs, and flatbread between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
