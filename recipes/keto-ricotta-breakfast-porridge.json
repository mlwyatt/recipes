  "instructions": [
    {
      "id": 96728,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 96729,
      "primary_message": "Melt butter in the saucepan.",
      "secondary_message": "½ cup butter, unsalted"
    },
    {
      "id": 96730,
      "primary_message": "Add cinnamon and cream and cook, stirring occasionally, until cream is warm.",
      "secondary_message": "½ tsp cinnamon\n4 fl oz (½ cup) heavy cream"
    },
    {
      "id": 96731,
      "primary_message": "Remove from heat and stir in ricotta cheese.",
      "secondary_message": "1 (15 oz) pkg ricotta cheese"
    },
    {
      "id": 96732,
