  "instructions": [
    {
      "id": 356903,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 medium carrots\n2 green bell peppers\n2 (1 inch) pieces ginger root\n4 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 356904,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further. ",
      "secondary_message": "2 (15 oz) cans kidney beans"
    },
    {
      "id": 356905,
      "primary_message": "Peel, halve, and small dice onion. Peel, trim, and small dice carrots. Place both in a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 356906,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 356907,
      "primary_message": "While the pot heats up, trim, seed, and small dice bell peppers. Add to the bowl with the other veggies. ",
      "secondary_message": null
    },
    {
      "id": 356908,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp virgin coconut oil\n½ tsp salt"
    },
    {
      "id": 356909,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Small dice tomatoes. Add both to the reserved bowl. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 356910,
      "primary_message": "Once the veggies are soft, add ginger, garlic, tomato, and spices to the pot. Cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "1 tbsp garam masala\n1 tsp chili powder\n1 tsp salt\n½ tsp turmeric, ground"
    },
    {
      "id": 356911,
      "primary_message": "Add beans, coconut milk, and water to the pot; bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until beans are tender and curry has thickened, about 10 minutes. ",
      "secondary_message": "1 (13.5 fl oz) can coconut milk\n¼ cup water"
    },
    {
      "id": 356912,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 356913,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 356914,
      "primary_message": "Arrange naan on a baking sheet pan and place in the oven; broil, flipping once, until golden brown and toasted, 1-2 minutes. ",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 356915,
      "primary_message": "Remove naan from the oven, spread with oil, and sprinkle with half of the cilantro; cut into wedges. (Reserve remaining cilantro for the curry.)",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 356916,
      "primary_message": "When the curry is done, remove from heat. Add reserved cilantro and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 356917,
      "primary_message": "Divide curry between bowls and serve with naan on the side. Enjoy!",
      "secondary_message": null
    }
  ],
