        "instructions": [
          {
            "id": 386705,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 386706,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
          },
          {
            "id": 386707,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 386708,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 386709,
            "primary_message": "While the skillet heats up, medium dice tofu. Place in a medium bowl, sprinkle with cornstarch and salt, then gently toss to coat.",
            "secondary_message": "¼ cup cornstarch\n½ tsp salt"
          },
          {
            "id": 386710,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tofu and cook, turning every few minutes, until golden brown and crispy, about 10 minutes; remove to a plate. (Reserve bowl for later use.)",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 386711,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n2 orange bell peppers\n2 sticks celery\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
          },
          {
            "id": 386712,
            "primary_message": "Trim, seed, and large dice bell peppers. Trim and large dice celery. Place both in the reserved bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 386713,
            "primary_message": "Peel and mince ginger and garlic. Place both in a small bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 386714,
            "primary_message": "Trim and cut green onions crosswise into 1-inch pieces. Add to the bowl with the ginger and garlic.",
            "secondary_message": null
          },
          {
            "id": 386715,
            "primary_message": "When the tofu is done, return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add the bell pepper and celery; cook, stirring occasionally, until tender-crisp, about 5 minutes.",
            "secondary_message": "4 tsp toasted sesame oil"
          },
          {
            "id": 386716,
            "primary_message": "While the veggies are cooking, add water, soy sauce, vinegar, sugar, chili-garlic sauce, additional cornstarch, and oil to the small bowl. Whisk to combine the sauce.",
            "secondary_message": "½ cup water\n¼ cup soy sauce\n2 tbsp rice vinegar\n2 tbsp brown sugar\n1 tbsp chili-garlic sauce\n1 tbsp cornstarch\n2 tsp toasted sesame oil"
          },
          {
            "id": 386717,
            "primary_message": "When the veggies are done, add crispy tofu, sauce, and cashews to the skillet. Bring the sauce to a boil and cook, stirring frequently, until thickened, about 1 minute. Remove from heat.",
            "secondary_message": "½ cup cashews, roasted unsalted"
          },
          {
            "id": 386718,
            "primary_message": "To serve, divide rice and stir-fry between bowls. Enjoy!",
            "secondary_message": null
          }
        ],
