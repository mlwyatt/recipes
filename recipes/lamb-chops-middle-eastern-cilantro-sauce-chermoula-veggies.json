  "instructions": [
    {
      "id": 237624,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 237625,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 lemon\n4 medium carrots\n4 medium zucchini squash"
    },
    {
      "id": 237626,
      "primary_message": "Peel and mince garlic; transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 237627,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 237628,
      "primary_message": "Juice lemon into the bowl. Add oil and spices; stir to combine the chermoula and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp paprika\n¼ tsp cayenne pepper\n¼ tsp salt"
    },
    {
      "id": 237629,
      "primary_message": "Peel, trim, and thinly slice carrots into ¼-inch thick rounds. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 237630,
      "primary_message": "Trim and halve zucchini lengthwise; cut crosswise into ½-inch thick half-moons and add to the baking sheet with the carrots.",
      "secondary_message": null
    },
    {
      "id": 237631,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 237632,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 237633,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237634,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "8 lamb loin chops\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 237635,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add lamb chops and cook, flipping once, until cooked through, 5-6 minutes. Remove to a plate, cover loosely with aluminum foil, and rest 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 237636,
      "primary_message": "To serve, divide lamb chops and roasted veggies between plates; drizzle with chermoula and enjoy!",
      "secondary_message": null
    }
  ],
