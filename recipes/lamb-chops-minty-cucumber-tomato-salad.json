        "instructions": [
          {
            "id": 31284,
            "primary_message": "Place the lamb chops on a plate; rub with olive oil and season with salt and pepper on both sides; set aside.",
            "secondary_message": "12 lamb rib chops\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 31285,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 English cucumbers\n2 pints grape tomatoes\n1 small pkg fresh mint\n1 lemon"
          },
          {
            "id": 31286,
            "primary_message": "Cut the cucumber in half crosswise, then cut quarter lengthwise into 4 wedges; cut the wedges crosswise into bite-sized chunks. Transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 31287,
            "primary_message": "Halve the tomatoes and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 31288,
            "primary_message": "Pick the mint leaves off the stems; discard the stems. Stack the leaves and cut crosswise into thin ribbons; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 31289,
            "primary_message": "Preheat a grill pan or skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 31290,
            "primary_message": "While the pan/skillet heats up, peel and small dice the onion; add to the bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 31291,
            "primary_message": "Place the lamb chops on the grill or skillet and cook until desired doneness, 2 to 5 minutes per side.",
            "secondary_message": null
          },
          {
            "id": 31292,
            "primary_message": "Halve the lemon and juice one half over the salad. Cut the other half into wedges for serving.",
            "secondary_message": ""
          },
          {
            "id": 31293,
            "primary_message": "Drizzle the salad with olive oil and season with salt and pepper. Toss to combine.",
            "secondary_message": "4 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 31294,
            "primary_message": "To serve, place the salad on plate, add the lamb chops on the side, and squeeze the lemon wedges over the lamb. Enjoy!",
            "secondary_message": null
          }
        ],
