  "instructions": [
    {
      "id": 256811,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook for 10 minutes (the lentils will not be cooked all the way through).",
      "secondary_message": "1 cup brown lentils, dried\n40 fl oz (5 cups) chicken or vegetable broth\n¼ tsp salt"
    },
    {
      "id": 256812,
      "primary_message": "Meanwhile, preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 256813,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion into half-moons.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 256814,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion, cumin, and salt; cook, stirring occasionally, until soft and golden brown, about 15 minutes. Remove from heat and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 256815,
      "primary_message": "While the onions are cooking, wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 tomatoes\n1 head romaine lettuce\n1 small pkg fresh mint"
    },
    {
      "id": 256816,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and add to the saucepan with the lentils; return to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice"
    },
    {
      "id": 256817,
      "primary_message": "Once the liquid returns to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook lentils and rice until tender and liquid is mostly absorbed, 18-20 minutes more. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 256818,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n½ tsp oregano, dried\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 256819,
      "primary_message": "Trim and small dice cucumber; small dice tomatoes. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 256820,
      "primary_message": "Stack lettuce leaves, one on top of another; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256821,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256822,
      "primary_message": "Add feta to the bowl and toss to combine the salad.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 256823,
      "primary_message": "To serve, divide salad and the lentil-rice mixture between plates; top lentils and rice with fried onions. Enjoy!",
      "secondary_message": null
    }
  ],
