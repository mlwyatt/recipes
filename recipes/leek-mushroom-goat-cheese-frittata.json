        "instructions": [
          {
            "id": 22136,
            "primary_message": "Wash and thinly slice leeks.",
            "secondary_message": "2 leeks"
          },
          {
            "id": 22137,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 22138,
            "primary_message": "Preheat oven to broil setting and position rack about 6 inches from the top.",
            "secondary_message": ""
          },
          {
            "id": 22139,
            "primary_message": "Melt butter in skillet. Add leeks and season with salt pepper. Cook, stirring occasionally, until softened, 4-5 minutes.",
            "secondary_message": "2 tbsp butter, unsalted\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 22140,
            "primary_message": "Wash and slice mushrooms. Peel and mince garlic.",
            "secondary_message": "1 lb white mushrooms\r\n2 cloves garlic"
          },
          {
            "id": 22141,
            "primary_message": "Add mushrooms and garlic to skillet and cook, stirring frequently, until softened, 4-5 minutes.",
            "secondary_message": ""
          },
          {
            "id": 22142,
            "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 22143,
            "primary_message": "In a medium bowl, whisk together eggs, water, ¾ of the parsley (save the rest for garnishing), salt, and pepper.",
            "secondary_message": "12 eggs\r\n4 tbsp water\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 22144,
            "primary_message": "Crumble goat cheese and stir about ½ into egg mixture (save the rest for sprinkling overtop).",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 22145,
            "primary_message": "Spread out leeks and mushrooms evenly in the skillet. Pour in egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
            "secondary_message": ""
          },
          {
            "id": 22146,
            "primary_message": "Sprinkle with remaining goat cheese. Place skillet in the oven until the top is set and lightly browned, 2-3 minutes.",
            "secondary_message": ""
          },
          {
            "id": 22147,
            "primary_message": "To serve, cut frittata into wedges, place on a plate, and garnish with remaining parsley. Enjoy!",
            "secondary_message": ""
          }
        ],
