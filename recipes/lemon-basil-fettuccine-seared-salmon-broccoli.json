  "instructions": [
    {
      "id": 486410,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until almost done, about 8 minutes.",
      "secondary_message": "1 tsp salt\n10 oz fettuccine pasta"
    },
    {
      "id": 486411,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a medium bowl along with oil and spices.",
      "secondary_message": "4 cloves garlic\n2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n1 tsp paprika\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 486412,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end (or corner) firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin.",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "id": 486413,
      "primary_message": "Cut the salmon into 1-inch cubes. Add to the bowl with the garlic-oil, stir to coat, and set aside to marinate.",
      "secondary_message": null
    },
    {
      "id": 486414,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 crowns broccoli\n1 small pkg fresh basil\n1 lemon"
    },
    {
      "id": 486415,
      "primary_message": "Using a clean cutting board, separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 486416,
      "primary_message": "When the pasta is almost done, add broccoli to the pot. Continue to cook, stirring occasionally, until pasta reaches desired firmness and broccoli is tender, 2-3 minutes more. Drain pasta and set aside. (Reserve a ⅓-cup pasta water before draining.)",
      "secondary_message": null
    },
    {
      "id": 486417,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 486418,
      "primary_message": "Once the skillet is hot, add salmon and cook, turning occasionally, until cooked through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 486419,
      "primary_message": "While the salmon is cooking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 486420,
      "primary_message": "When the salmon is done, juice lemon into the skillet.",
      "secondary_message": null
    },
    {
      "id": 486421,
      "primary_message": "Add drained pasta, broccoli, reserved pasta cooking water, and half of the basil to the skillet. Toss to combine and continue to cook until heated through, about 2 minutes. Remove from heat. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 486422,
      "primary_message": "To serve, divide pasta between plates or bowls and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
