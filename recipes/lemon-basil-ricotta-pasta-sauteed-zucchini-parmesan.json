        "instructions": [
          {
            "id": 409868,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil over medium-high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ½-cup of cooking water before draining and set aside.)",
            "secondary_message": "1 tsp salt\n10 oz penne pasta"
          },
          {
            "id": 409869,
            "primary_message": "Meanwhile, wash and dry the fresh produce. ",
            "secondary_message": "6 medium zucchini squash\n1 lemon\n1 small pkg fresh basil"
          },
          {
            "id": 409870,
            "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into ¼-inch thick pieces. Place in a large bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 409871,
            "primary_message": "Peel, halve, and small dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 409872,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 409873,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring frequently, until starting to soften, 2-3 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 409874,
            "primary_message": "Add zucchini and salt to the skillet. Continue to cook, stirring occasionally, until zucchini is tender, 6-8 minutes. (Reserve bowl for the next step.)",
            "secondary_message": "½ tsp salt"
          },
          {
            "id": 409875,
            "primary_message": "Meanwhile, zest and juice lemon into the reserved bowl.",
            "secondary_message": null
          },
          {
            "id": 409876,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl with the lemon. (Reserve remaining basil for serving.)",
            "secondary_message": null
          },
          {
            "id": 409877,
            "primary_message": "Finely grate Parmesan. Add half to the bowl along with the ricotta and spices. Stir to combine. (Reserve remaining Parmesan for serving.)",
            "secondary_message": "4 oz Parmesan cheese\n1 (15 oz) pkg ricotta cheese\n½ tsp salt\n½ tsp black pepper\n¼ tsp cayenne pepper"
          },
          {
            "id": 409878,
            "primary_message": "When the zucchini is done, add pasta, reserved pasta water, and ricotta mixture to the skillet. Continue to cook, stirring occasionally, until the sauce coats the pasta and Parmesan has melted, about 2 minutes. Remove from heat. ",
            "secondary_message": null
          },
          {
            "id": 409879,
            "primary_message": "To serve, divide the pasta between plates or bowls; top with reserved Parmesan and basil. Enjoy!",
            "secondary_message": null
          }
        ],
