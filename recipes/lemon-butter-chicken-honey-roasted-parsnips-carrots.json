        "instructions": [
          {
            "id": 33042,
            "primary_message": "Heat the oven to 450°F.",
            "secondary_message": ""
          },
          {
            "id": 33043,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "8 medium carrots\n4 parsnips\n1 small pkg fresh rosemary\n2 lemons"
          },
          {
            "id": 33044,
            "primary_message": "Trim and discard the stem ends and peel the carrots; quarter lengthwise into wedges and transfer to a baking sheet.",
            "secondary_message": ""
          },
          {
            "id": 33045,
            "primary_message": "Trim and discard the stem ends and peel the parsnips; cut lengthwise into uniform wedges (about the same size as the carrots); add to the baking sheet.",
            "secondary_message": ""
          },
          {
            "id": 33046,
            "primary_message": "Pinch the top of the rosemary stems with one hand while sliding the other hand down to remove the leaves; discard the stems and roughly chop the leaves. Sprinkle half of the rosemary over the vegetables (save the rest for the chicken).",
            "secondary_message": ""
          },
          {
            "id": 33047,
            "primary_message": "Drizzle the vegetables with olive oil and honey and season with salt and pepper; toss to coat.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp honey\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 33048,
            "primary_message": "Spread the vegetables in an even layer and place the sheet in the oven. Roast, stirring once halfway through the cooking time, until browned and tender, 15 to 20 minutes.",
            "secondary_message": null
          },
          {
            "id": 33049,
            "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 33050,
            "primary_message": "Season the chicken with salt and pepper on both sides.",
            "secondary_message": "½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 33051,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 33052,
            "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 33053,
            "primary_message": "Place the chicken in the skillet and cook until browned and cooked through, 3 to 4 minutes per side. Transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 33054,
            "primary_message": "Zest and juice one of the lemons into a small bowl, then add the remaining rosemary. Thinly slice the other lemon into rounds.",
            "secondary_message": null
          },
          {
            "id": 33055,
            "primary_message": "Once the chicken has been transferred, add more butter and the lemon slices to the skillet. Cook the lemon, turning once, until lightly browned, 2 to 3 minutes.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 33056,
            "primary_message": "Return the chicken to the skillet and pour in the lemon-rosemary sauce. Turn the chicken over a few times to coat it in the sauce. Cook until the juices are reduced, 1 to 2 minutes.",
            "secondary_message": null
          },
          {
            "id": 33057,
            "primary_message": "Divide the chicken and lemon slices between plates and add the roasted vegetables on the side. Enjoy!",
            "secondary_message": null
          }
        ],
