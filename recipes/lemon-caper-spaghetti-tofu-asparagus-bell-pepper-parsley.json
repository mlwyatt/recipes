        "instructions": [
          {
            "id": 305075,
            "primary_message": "Cut tofu in half along the long side. Sprinkle each tofu plank with salt on both sides and sandwich between clean towels or paper towels; place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu\n1 tsp salt"
          },
          {
            "id": 305076,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes; drain and set aside.",
            "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
          },
          {
            "id": 305077,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 small bunches asparagus\n2 orange bell peppers\n2 lemons\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 305078,
            "primary_message": "Snap or cut off the woody ends of the asparagus; cut crosswise into 1-inch pieces and place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 305079,
            "primary_message": "Trim, seed, and slice bell peppers into thin strips; add to the bowl with the asparagus and set aside.",
            "secondary_message": null
          },
          {
            "id": 305080,
            "primary_message": "Cut the tofu planks in half, then cut each half into 2 triangles; place in another medium bowl. Sprinkle with flour and pepper on both sides.",
            "secondary_message": "4 tsp all-purpose flour\n½ tsp black pepper"
          },
          {
            "id": 305081,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 305082,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add tofu and cook until golden, 2-3 minutes per side. Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 305083,
            "primary_message": "Meanwhile, peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 305084,
            "primary_message": "When the tofu is done, return the skillet to medium heat; add more oil and swirl to coat the bottom. Add garlic and additional flour; cook, stirring constantly, until fragrant, about 30 seconds.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tbsp all-purpose flour"
          },
          {
            "id": 305085,
            "primary_message": "Zest and juice one lemon into the skillet; add broth, capers, salt, and pepper. Cook, stirring often, until the sauce has thickened, 2-3 minutes. (Reserve remaining lemon for the next step.)",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n4 tbsp capers\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 305086,
            "primary_message": "While the sauce is cooking, cut the remaining lemon into wedges and set aside for serving.",
            "secondary_message": null
          },
          {
            "id": 305087,
            "primary_message": "Add asparagus and bell pepper to the skillet with the sauce; cook, stirring occasionally, until veggies are fork-tender, about 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 305088,
            "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 305089,
            "primary_message": "When the veggies are done, add drained pasta and parsley to the skillet; toss to combine and continue to cook until heated through, 1-2 minutes more.",
            "secondary_message": null
          },
          {
            "id": 305090,
            "primary_message": "To serve, divide pasta, veggies, sauce, and tofu between plates or bowls. Squeeze lemon over top and enjoy!",
            "secondary_message": null
          }
        ],
