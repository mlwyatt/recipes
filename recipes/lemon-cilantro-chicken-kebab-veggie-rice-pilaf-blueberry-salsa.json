        "instructions": [
          {
            "id": 288117,
            "primary_message": "If using wooden skewers, place 4-8 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 288118,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium carrots\n2 medium zucchini squash\n1 small bunch cilantro\n1 lemon\n1 jalapeño pepper\n2 (6 oz) pkgs blueberries"
          },
          {
            "id": 288119,
            "primary_message": "Peel, trim, and small dice carrots; peel, halve, and small dice onion. Place both in a medium bowl.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 288120,
            "primary_message": "Preheat a medium saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 288121,
            "primary_message": "While the pan heats up, trim and small dice zucchini; add to the bowl with the carrot and onion.",
            "secondary_message": null
          },
          {
            "id": 288122,
            "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for later use.)",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 288123,
            "primary_message": "While the veggies are cooking, using a strainer or colander, rinse the rice under cold, running water.",
            "secondary_message": "1 cup jasmine rice"
          },
          {
            "id": 288124,
            "primary_message": "Add rice and water to the pan, stir to combine, and bring to a boil over high heat. Once the liquid comes to a boil, cover the pan and reduce heat to low. Cook rice pilaf until liquid is mostly absorbed, 15-18 minutes. Once done, remove from heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": "2 cup water"
          },
          {
            "id": 288125,
            "primary_message": "Meanwhile, peel and mince garlic. Shave cilantro leaves off the stems; discard stems and mince the leaves. Place garlic and half of the cilantro in the reserved bowl. (Place remaining cilantro in a small bowl and set aside for the salsa.)",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 288126,
            "primary_message": "Zest and juice lemon into the bowl with the garlic and cilantro, then add oil and spices; stir to combine the marinade.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp basil, dried\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 288127,
            "primary_message": "Cut chicken into bite-sized pieces, add to the bowl with the marinade, and stir to coat. Thread chicken onto skewers and place on a plate; alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.",
            "secondary_message": "2 lb chicken thighs, boneless skinless"
          },
          {
            "id": 288128,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 288129,
            "primary_message": "Once the grill pan is hot, add the kebabs and cook, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 288130,
            "primary_message": "Meanwhile, using a clean cutting board, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the small bowl with the cilantro. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 288131,
            "primary_message": "Roughly chop blueberries and add to the bowl along with vinegar, oil, honey, salt, and pepper. Stir to combine the salsa and set aside. ",
            "secondary_message": "2 tbsp balsamic vinegar\n2 tsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 288132,
            "primary_message": "To serve, divide rice pilaf, chicken kebabs, and blueberry salsa between plates. Enjoy!",
            "secondary_message": null
          }
        ],
