        "instructions": [
          {
            "id": 230362,
            "primary_message": "Preheat oven to 450°F. ",
            "secondary_message": null
          },
          {
            "id": 230363,
            "primary_message": "Using a strainer, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth, cumin, and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes.",
            "secondary_message": "1 ⅓ cups brown lentils, dried\n32 fl oz (4 cups) chicken or vegetable broth\n1 tsp cumin, ground\n1 tsp salt"
          },
          {
            "id": 230364,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "1 medium head cauliflower\n2 lemons\n1 small bunch green onions (scallions)\n4 sticks celery\n1 English cucumber\n1 small bunch cilantro\n2 (5 oz) pkgs baby arugula"
          },
          {
            "id": 230365,
            "primary_message": "Remove leaves and thick stems from the cauliflower, then cut into bite-sized pieces. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to combine, then spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp turmeric, ground\n¼ tsp black pepper"
          },
          {
            "id": 230366,
            "primary_message": "Place cauliflower in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender and golden, about 15 minutes.",
            "secondary_message": null
          },
          {
            "id": 230367,
            "primary_message": "While the cauliflower is roasting, peel and mince garlic; place in a large bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 230368,
            "primary_message": "Zest and juice lemons into the bowl with the garlic. Add oil and spices; whisk to combine the dressing. ",
            "secondary_message": "¼ cup extra virgin olive oil\n½ tsp curry powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 230369,
            "primary_message": "Trim green onions and celery; cut both crosswise into ¼-inch pieces. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 230370,
            "primary_message": "Trim and small dice cucumber. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 230371,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 230372,
            "primary_message": "When the cauliflower is done, remove from the oven and set aside to cool, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 230373,
            "primary_message": "When the lentils are done, drain in a colander, rinse with cold water, and add to the bowl with the dressing and veggies.",
            "secondary_message": null
          },
          {
            "id": 230374,
            "primary_message": "Add roasted cauliflower to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 230375,
            "primary_message": "To serve, divide arugula and lentil salad between plates. Top with pine nuts and enjoy!",
            "secondary_message": "½ cup pine nuts"
          }
        ],
