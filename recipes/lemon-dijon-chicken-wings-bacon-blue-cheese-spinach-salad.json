        "instructions": [
          {
            "id": 292327,
            "primary_message": "Preheat oven to 475°F. Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
            "secondary_message": null
          },
          {
            "id": 292328,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 lemon\n2 medium carrots\n1 English cucumber\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 292329,
            "primary_message": "Zest lemon into a large bowl, then add oil, Dijon, salt, and pepper; whisk to combine the marinade. (Set lemon aside for later use.)",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 292330,
            "primary_message": "Pat chicken wings dry with paper towels and add to the bowl with the marinade; toss to coat and spread out on the baking sheet in an even layer.",
            "secondary_message": "2 lb chicken wings, split with tips removed"
          },
          {
            "id": 292331,
            "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 292332,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 292333,
            "primary_message": "While the skillet heats up, medium dice bacon.",
            "secondary_message": "8 slices bacon"
          },
          {
            "id": 292334,
            "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate.",
            "secondary_message": null
          },
          {
            "id": 292335,
            "primary_message": "While the bacon is cooking, juice reserved lemon into a medium bowl; add Dijon, salt, and pepper.",
            "secondary_message": "2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 292336,
            "primary_message": "When the bacon is done, add drippings from the skillet to the bowl with the lemon juice and Dijon; whisk to combine the dressing.",
            "secondary_message": null
          },
          {
            "id": 292337,
            "primary_message": "Using a clean cutting board, peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 292338,
            "primary_message": "Trim and medium dice cucumber; add to the bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 292339,
            "primary_message": "Right before serving, add crispy bacon, spinach, and blue cheese to the bowl with the dressing and veggies; toss to combine the salad.",
            "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
          },
          {
            "id": 292340,
            "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
