        "instructions": [
          {
            "id": 364605,
            "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
            "secondary_message": null
          },
          {
            "id": 364606,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 lemon\n1 lb new potatoes\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 364607,
            "primary_message": "Peel and mince garlic; place in a large bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 364608,
            "primary_message": "Juice lemon into the bowl with the garlic, then add oil, Dijon, and spices; whisk to combine the marinade.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 364609,
            "primary_message": "Quarter potatoes and add to the bowl with the marinade.",
            "secondary_message": null
          },
          {
            "id": 364610,
            "primary_message": "Pat chicken dry with paper towels, add to the bowl, and toss to coat. Transfer potatoes and drumsticks to the baking sheet, arranging them in an even layer; drizzle any leftover marinade over top.",
            "secondary_message": "2 ½ lb chicken drumsticks"
          },
          {
            "id": 364611,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until potatoes and chicken are cooked through, 25-30 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 364612,
            "primary_message": "Meanwhile, place mayo, oil, vinegar, Dijon, salt, and pepper in a medium bowl; whisk to combine the dressing.",
            "secondary_message": "4 tsp mayonnaise\n2 tsp extra virgin olive oil\n2 tsp white wine vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 364613,
            "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing.",
            "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
          },
          {
            "id": 364614,
            "primary_message": "Right before serving, add spinach to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 364615,
            "primary_message": "To serve, divide chicken, potatoes, and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
