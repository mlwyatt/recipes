        "instructions": [
          {
            "id": 29551,
            "primary_message": "Heat the oven to 500°F.",
            "secondary_message": null
          },
          {
            "id": 29552,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 ears corn\n4 medium zucchini squash\n2 lemons\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 29553,
            "primary_message": "Peel and mince the garlic; divide between two large bowls.",
            "secondary_message": "6 cloves garlic"
          },
          {
            "id": 29554,
            "primary_message": "Juice the lemons and divide between the two bowls.",
            "secondary_message": null
          },
          {
            "id": 29555,
            "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves. Divide the minced parsley between the two bowls.",
            "secondary_message": null
          },
          {
            "id": 29556,
            "primary_message": "Add olive oil, salt, and pepper to both of the bowls (divide the amounts between the two).",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp salt\n2 tsp black pepper"
          },
          {
            "id": 29557,
            "primary_message": "Add the chicken drumsticks to one of the bowls and toss to coat in the marinade.",
            "secondary_message": "2 ½ lb chicken drumsticks"
          },
          {
            "id": 29558,
            "primary_message": "Arrange the drumsticks in a baking dish and place in the oven (even if it is not fully heated yet). Bake, turning halfway through cooking time, until cooked through, 25-30 minutes.",
            "secondary_message": null
          },
          {
            "id": 29559,
            "primary_message": "Shuck the corn to remove the leaves and silk threads; stand the corn vertically in a large, empty bowl and slice the kernels off the cob.",
            "secondary_message": ""
          },
          {
            "id": 29560,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 29561,
            "primary_message": "Trim and discard the ends of the zucchini, medium dice the zucchini and add to the bowl with the corn.",
            "secondary_message": null
          },
          {
            "id": 29562,
            "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 29563,
            "primary_message": "Add the corn and zucchini to the skillet; cook, stirring occasionally, until the vegetables are lightly browned and softened, 4 to 6 minutes. Once done, return the vegetables to the bowl to cool.",
            "secondary_message": ""
          },
          {
            "id": 29564,
            "primary_message": "Place the feta into a small bowl.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 29565,
            "primary_message": "Transfer the zucchini and corn to the other bowl with the dressing and stir to combine.",
            "secondary_message": ""
          },
          {
            "id": 29566,
            "primary_message": "To serve, place the chicken drumsticks and salad on a plate and sprinkle the salad with the feta. Enjoy!",
            "secondary_message": null
          }
        ],
