        "instructions": [
          {
            "id": 363720,
            "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 363721,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n1 English cucumber\n4 peaches\n1 small pkg fresh basil"
          },
          {
            "id": 363722,
            "primary_message": "Zest lemon into a medium bowl (set lemon aside for later use).",
            "secondary_message": null
          },
          {
            "id": 363723,
            "primary_message": "Peel and mince garlic. Add to the bowl with the lemon zest along with mayo, salt, and pepper; stir to combine the marinade.",
            "secondary_message": "2 cloves garlic\n¼ cup mayonnaise\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 363724,
            "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Add to the bowl with the marinade and stir to coat.",
            "secondary_message": "2 lb chicken thighs, boneless skinless"
          },
          {
            "id": 363725,
            "primary_message": "Thread chicken onto skewers and place on a plate. Alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.",
            "secondary_message": null
          },
          {
            "id": 363726,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 363727,
            "primary_message": "Once the pan is hot, add the skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 363728,
            "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in another medium bowl.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 363729,
            "primary_message": "Juice lemon into the bowl with the shallot. Add oil, honey, Dijon, and spices; whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp Dijon mustard\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 363730,
            "primary_message": "Trim and medium dice cucumber. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 363731,
            "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 363732,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, along with the feta, and stir to combine the salad.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 363733,
            "primary_message": "To serve, divide salad and skewers between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
