        "instructions": [
          {
            "id": 85324,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 lemons\n6 medium zucchini squash\n1 small pkg fresh basil"
          },
          {
            "id": 85325,
            "primary_message": "Trim the zucchini ends. Using a spiralizer, julienne peeler (or regular peeler) peel into noodle-like sticks; transfer to colander and sprinkle with salt. Set the colander in a bowl to catch the excess moisture.",
            "secondary_message": "1 tsp salt"
          },
          {
            "id": 85326,
            "primary_message": "Grate all the zest from the lemons, then juice the lemons; transfer both to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 85327,
            "primary_message": "Peel and mince or press the garlic; transfer to the bowl, whisking together with oil, lemon juice, and pepper.",
            "secondary_message": "2 cloves garlic\n⅓ cup extra virgin olive oil\n½ tsp black pepper"
          },
          {
            "id": 85328,
            "primary_message": "Place a skillet over medium heat. Coarsely chop walnuts. Toast walnuts until fragrant (2-4 minutes) stirring regularly.",
            "secondary_message": "½ cup walnuts"
          },
          {
            "id": 85329,
            "primary_message": "Pick the basil leaves off the stems and slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 85330,
            "primary_message": "Shake the zucchini noodles in the colander over the sink to remove excess water. Transfer the noodles to the centre of a clean towel, roll up the towel and wring it over the sink to remove as much moisture as possible (you should squeeze out at least ½ a cup). Process in batches if necessary.",
            "secondary_message": null
          },
          {
            "id": 85331,
            "primary_message": "Add zucchini to the bowl with the dressing and toss until coated with dressing.",
            "secondary_message": null
          },
          {
            "id": 85332,
            "primary_message": "To serve, arrange zucchini noodles on a plate and top with walnuts and teaspoon sized scoops of ricotta cheese. Sprinkle with basil ribbons and enjoy!",
            "secondary_message": "1 (15 oz) pkg ricotta cheese"
          }
        ],
