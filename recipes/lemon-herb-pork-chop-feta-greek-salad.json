  "instructions": [
    {
      "id": 286018,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 English cucumber\n2 tomatoes\n2 yellow bell peppers"
    },
    {
      "id": 286019,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 286020,
      "primary_message": "Juice lemon into the bowl with the garlic; add oil and spices. Whisk to combine the marinade.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp rosemary, dried\n½ tsp basil, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 286021,
      "primary_message": "Pat pork chops dry with paper towels and place in a baking dish. Pour marinade over the chops, turn to coat, and set aside. (Reserve bowl for next step.)",
      "secondary_message": "4 pork chops, bone-in"
    },
    {
      "id": 286022,
      "primary_message": "While the chops are marinating, peel and mince additional garlic; place in the reserved bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 286023,
      "primary_message": "Peel, halve, and thinly slice shallots; add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 286024,
      "primary_message": "Trim and medium dice cucumber; medium dice tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 286025,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 286026,
      "primary_message": "Thinly slice olives and add to the bowl; stir to combine the salad and set aside.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 286027,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 286028,
      "primary_message": "Once the skillet is hot, add chops and marinade; pan-fry until golden brown on one side, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 286029,
      "primary_message": "Flip chops and sprinkle the top side with half of the feta (reserve remaining feta for the salad). Continue to pan-fry until cheese has softened and chops are cooked through, 3-4 minutes more. Remove from heat. ",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 286030,
      "primary_message": "To serve, divide chops and salad between plates; top salad with reserved feta and enjoy!",
      "secondary_message": null
    }
  ],
