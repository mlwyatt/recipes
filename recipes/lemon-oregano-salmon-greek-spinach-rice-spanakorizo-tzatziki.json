        "instructions": [
          {
            "id": 224686,
            "primary_message": "Preheat oven to 425°F. ",
            "secondary_message": null
          },
          {
            "id": 224687,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 English cucumber\n1 small bunch fresh dill\n2 (5 oz) pkgs baby spinach\n1 lemon"
          },
          {
            "id": 224688,
            "primary_message": "Peel, trim, and quarter the cucumber lengthwise; thinly slice crosswise. Transfer to a colander and sprinkle with salt. Place the colander in a bowl to catch the excess moisture and set aside.",
            "secondary_message": "½ tsp salt"
          },
          {
            "id": 224689,
            "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n4 cloves garlic"
          },
          {
            "id": 224690,
            "primary_message": "Preheat a medium saucepan over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 224691,
            "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until softened, 4-5 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 224692,
            "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 224693,
            "primary_message": "Roughly chop the spinach. Add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
            "secondary_message": null
          },
          {
            "id": 224694,
            "primary_message": "Using a strainer, rinse rice under cold, running water, then drain and add to the saucepan with the spinach. Add half the dill (reserving the rest for the tzatziki), broth, salt, and pepper; stir to combine, then scrape down the edges of the pan to submerge the rice. Bring to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n24 fl oz (3 cups) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 224695,
            "primary_message": "Once the liquid comes to a boil, cover the saucepan, and reduce heat to low. Cook rice until tender and liquid is mostly absorbed, 15-18 minutes (the rice should resemble a saucy risotto). Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 224696,
            "primary_message": "While the rice is cooking, place the salmon, skin-side down, on a baking sheet pan. Rub with oil and season with spices on both sides. ",
            "secondary_message": "1 ½ lb salmon fillet\n4 tsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 224697,
            "primary_message": "Trim, halve, and slice lemon into thin half-moons. Arrange lemon slices over the salmon, place in the oven, and bake until flakey and cooked through, about 12 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 224698,
            "primary_message": "Meanwhile, peel and mince additional garlic. Add to the bowl with the reserved dill, along with yogurt, pepper, and salt; stir to combine.",
            "secondary_message": "2 cloves garlic\n1 cup plain Greek yogurt\n¼ tsp black pepper\n⅛ tsp salt"
          },
          {
            "id": 224699,
            "primary_message": "Use paper towels or a clean cloth to squeeze excess moisture out of the sliced cucumber. Add cucumber to the yogurt mixture and stir to combine the tzatziki; set aside.",
            "secondary_message": null
          },
          {
            "id": 224700,
            "primary_message": "Finely grate Parmesan. When the spinach-rice is done, add half of the Parmesan to the pan and stir to combine. Set remaining Parmesan aside for garnish.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 224701,
            "primary_message": "To serve, divide spinach-rice, salmon, and tzatziki between plates. Sprinkle remaining Parmesan over the spinach-rice and enjoy!",
            "secondary_message": null
          }
        ],
