  "instructions": [
    {
      "id": 13154,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil.",
      "secondary_message": "about 7 cups water"
    },
    {
      "id": 13155,
      "primary_message": "Wash, peel, and large dice potatoes; add to saucepan. Once boiling, cook until potatoes are tender, 10-12 minutes.",
      "secondary_message": "4 medium yellow potatoes"
    },
    {
      "id": 13156,
      "primary_message": "Peel and mince garlic. Grate 2 tsp of lemon zest. In a medium bowl, prepare marinade by mixing together ¼ of the garlic (save the rest for the green beans), lemon zest, lemon juice, oil, oregano, pepper, and salt.",
      "secondary_message": "8 cloves garlic\r\n1 lemon\r\n2 tbsp extra virgin olive oil\r\n½ tsp oregano\r\n½ tsp black pepper\r\n¼ tsp salt"
    },
    {
      "id": 13157,
      "primary_message": "Place steak in bowl and coat with marinade.",
      "secondary_message": "1 ½ lb ribeye steak"
    },
    {
      "id": 13159,
      "primary_message": "Wash green beans and trim ends.",
      "secondary_message": "1 ½ lb green beans"
    },
    {
      "id": 13158,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 13160,
      "primary_message": "Coat grill or bottom of skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "about 1 tbsp virgin coconut oil"
    },
    {
      "id": 13161,
      "primary_message": "Heat a sauté pan over medium heat and add coconut oil. Add remaining garlic and crushed red pepper. Cook until fragrant, 15-30 seconds.",
      "secondary_message": "about 1 tbsp virgin coconut oil\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 13162,
      "primary_message": "Add green beans to the sauté pan and, stirring occasionally, cook until tender crisp, 5-7 minutes.",
      "secondary_message": ""
    },
    {
      "id": 13163,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 13164,
      "primary_message": "Drain potatoes and return back to saucepan. Add parsley, chicken broth, oil, salt, and pepper. Mash until smooth.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp virgin coconut oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 13165,
      "primary_message": "Remove beans from heat. Season with salt and pepper; toss to coat.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 13166,
      "primary_message": "To serve, arrange steak, mashed potatoes and green beans on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
