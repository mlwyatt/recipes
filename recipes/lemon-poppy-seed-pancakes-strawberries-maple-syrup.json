  "instructions": [
    {
      "id": 157883,
      "primary_message": "Wash, trim, and thinly slice strawberries; set aside.",
      "secondary_message": "1 (16 oz) pkg strawberries"
    },
    {
      "id": 157884,
      "primary_message": "Place flour, sugar, poppy seeds, baking powder, and salt in a medium bowl; whisk to combine.",
      "secondary_message": "1 ½ cup all-purpose flour\n3 tbsp brown sugar\n2 tsp poppy seeds\n2 tsp baking powder\n½ tsp salt"
    },
    {
      "id": 157885,
      "primary_message": "Melt butter in a large nonstick skillet over low heat; transfer to another medium bowl.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 157886,
      "primary_message": "Add eggs and milk to the bowl with the melted butter and whisk quickly to combine.",
      "secondary_message": "2 eggs\n8 fl oz (1 cup) whole milk"
    },
    {
      "id": 157887,
      "primary_message": "Create a well in the center of the flour mixture. Add the egg mixture and whisk to make a smooth batter.",
      "secondary_message": null
    },
    {
      "id": 157888,
      "primary_message": "Wash and dry lemon. Zest and juice into the pancake batter; whisk to combine, being careful not to over-mix the batter.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 157889,
      "primary_message": "Return skillet to medium-high heat. Add more butter and swirl to coat the bottom.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 157890,
      "primary_message": "Working in batches, use a ¼-cup measure to pour the batter into the skillet. Cook for 1-2 minutes on each side, until golden and cooked through.",
      "secondary_message": null
    },
    {
      "id": 157891,
      "primary_message": "To serve, divide pancakes between plates. Top with more butter, strawberries, and maple syrup. Enjoy!",
      "secondary_message": "4 tsp butter, unsalted\n2 tbsp pure maple syrup"
    }
  ],
