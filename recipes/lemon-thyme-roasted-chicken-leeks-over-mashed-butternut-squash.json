        "instructions": [
          {
            "id": 314042,
            "primary_message": "Preheat the oven to 425°F. ",
            "secondary_message": null
          },
          {
            "id": 314043,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 small pkg fresh thyme\n1 lemon\n4 leeks\n1 small butternut squash"
          },
          {
            "id": 314044,
            "primary_message": "Slide thyme leaves off the stems; discard stems and place leaves in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 314045,
            "primary_message": "Zest and juice lemon into the bowl with the thyme; add honey and spices. Whisk to combine the marinade. ",
            "secondary_message": "2 tsp honey\n2 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 314046,
            "primary_message": "Pat chicken dry with paper towels, add to the bowl with the marinade, and turn to coat; set aside. ",
            "secondary_message": "2 lb chicken thighs, boneless skinless"
          },
          {
            "id": 314047,
            "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. ",
            "secondary_message": null
          },
          {
            "id": 314048,
            "primary_message": "Slice leeks crosswise into 4-inch pieces. Transfer to a large baking dish and arrange side-by-side, cut-side down. ",
            "secondary_message": null
          },
          {
            "id": 314049,
            "primary_message": "Cut butter into small pieces.",
            "secondary_message": "3 tbsp butter, unsalted"
          },
          {
            "id": 314050,
            "primary_message": "Arrange chicken on top of the leeks, pouring any leftover marinade on top. Sprinkle butter over leeks and chicken, then season with additional salt and pepper.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 314051,
            "primary_message": "Place baking dish in the oven and roast, turning chicken halfway through, until leeks are tender and chicken is cooked through, about 20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 314052,
            "primary_message": "Meanwhile, trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice. Place squash in a medium saucepan, cover with hot water (from the tap), and bring to a boil. Once boiling, reduce heat to medium and simmer until squash is fork-tender, 12-14 minutes.",
            "secondary_message": null
          },
          {
            "id": 314053,
            "primary_message": "When the squash is done, drain in a colander and return to the saucepan; add cream, salt, and pepper. Using a potato masher, mash until smooth.",
            "secondary_message": "8 fl oz (1 cup) heavy whipping cream\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 314054,
            "primary_message": "To serve, divide mashed butternut squash, roasted leeks, and chicken between plates. Enjoy! ",
            "secondary_message": null
          }
        ],
