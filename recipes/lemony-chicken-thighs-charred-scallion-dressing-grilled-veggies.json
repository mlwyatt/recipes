        "instructions": [
          {
            "id": 413722,
            "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 413723,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 lemons\n4 medium zucchini squash\n2 avocados\n2 small bunches green onions (scallions)"
          },
          {
            "id": 413724,
            "primary_message": "Zest lemons into a small bowl. Add salt and pepper, then stir to combine the lemon seasoning. (Reserve lemons for later use.)",
            "secondary_message": "1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 413725,
            "primary_message": "Pat chicken dry with paper towels and transfer to the baking sheet. Drizzle with oil and sprinkle with lemon seasoning on both sides. (Reserve bowl for later use.)",
            "secondary_message": "2 lb chicken thighs, boneless skinless\n2 tsp extra virgin olive oil"
          },
          {
            "id": 413726,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken is golden and cooked through, 18-20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 413727,
            "primary_message": "Meanwhile, trim and slice zucchini lengthwise into ¼-inch thick planks. Place on a large plate. ",
            "secondary_message": null
          },
          {
            "id": 413728,
            "primary_message": "Halve and pit avocados. Add to the plate with the zucchini.",
            "secondary_message": null
          },
          {
            "id": 413729,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 413730,
            "primary_message": "While the pan heats up, trim green onions and add to the plate. Drizzle veggies with oil, then season with salt and pepper.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 413731,
            "primary_message": "Once the pan is hot, working in batches if necessary, add the green onions. Grill until tender and charred, 2-3 minutes per side; return to the plate.",
            "secondary_message": null
          },
          {
            "id": 413732,
            "primary_message": "Working in batches if necessary, place zucchini on the pan. Grill until tender and charred, 2-3 minutes per side. Return to the plate.",
            "secondary_message": null
          },
          {
            "id": 413733,
            "primary_message": "Meanwhile, roughly chop ⅓ of the green onions. Place in the reserved bowl. (Set remainder aside for serving.)",
            "secondary_message": null
          },
          {
            "id": 413734,
            "primary_message": "Juice one reserved lemon into the bowl with the onions (set remaining lemon aside for the veggies). Add yogurt and spices, then stir to combine. Add water, 1 teaspoon at a time, if needed, to reach a drizzling consistency. Set dressing aside. ",
            "secondary_message": "1 cup plain Greek yogurt\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 413735,
            "primary_message": "When the zucchini is done, place avocado, cut-side down, on the pan. Grill until charred on the cut-side and warmed through, 1-2 minutes per side; return to the plate.",
            "secondary_message": null
          },
          {
            "id": 413736,
            "primary_message": "When the avocados are done, squeeze the reserved lemon over the veggies, then drizzle with additional oil.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 413737,
            "primary_message": "To serve, divide chicken and veggies between plates; drizzle dressing over chicken. Enjoy!",
            "secondary_message": null
          }
        ],
