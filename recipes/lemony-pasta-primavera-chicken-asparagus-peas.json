        "instructions": [
          {
            "id": 43088,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
            "secondary_message": ""
          },
          {
            "id": 43089,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 small bunches asparagus\n1 lemon"
          },
          {
            "id": 43090,
            "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears into 2-inch pieces at an angle and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 43091,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the asparagus.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 43092,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 43093,
            "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season generously with salt and pepper.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 43094,
            "primary_message": "When the water in the pot comes to a boil, uncover the pot and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions). Drain the pasta in a colander, reserving 1 cup of the cooking water.",
            "secondary_message": "2 tbsp salt\n10 oz (about 1 ⅜-inch diameter bunch) fettuccine pasta"
          },
          {
            "id": 43095,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
            "secondary_message": "1 tbsp butter, unsalted"
          },
          {
            "id": 43096,
            "primary_message": "Place the chicken cutlets in the skillet; cook until the chicken is golden brown and cooked through, 4-6 minutes per side. Once done, transfer to a plate.",
            "secondary_message": ""
          },
          {
            "id": 43097,
            "primary_message": "Once the chicken has been transferred, add more butter to the skillet followed by the asparagus, garlic, and peas; season with salt and pepper. Cook, tossing frequently, until the asparagus is bright green and just tender, 4 to 6 minutes.",
            "secondary_message": "1 tbsp butter, unsalted\n1 cup frozen peas\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 43098,
            "primary_message": "Finely grate 1 cup of Parmesan and transfer to a small bowl. Add the yogurt and stir to combine. ",
            "secondary_message": "1 oz Parmesan cheese\n½ cup plain Greek yogurt"
          },
          {
            "id": 43099,
            "primary_message": "Grate the zest from the lemon and transfer to the bowl with the Parmesan, then juice the lemon into the same bowl; stir to combine.",
            "secondary_message": ""
          },
          {
            "id": 43100,
            "primary_message": "To the asparagus and peas, add the cooked pasta, butter, Parmesan mixture, and half of the reserved pasta water. Cook, tossing constantly, until the mixture is well combined, 2 to 3 minutes. (If the sauce is dry, gradually add the remaining pasta cooking water to achieve your desired consistency.)",
            "secondary_message": "2 tbsp butter, unsalted\n"
          },
          {
            "id": 43101,
            "primary_message": "Slice the chicken crosswise into strips.",
            "secondary_message": null
          },
          {
            "id": 43102,
            "primary_message": "To serve, divide the pasta between plates and top with the chicken slices. Enjoy!",
            "secondary_message": null
          }
        ],
