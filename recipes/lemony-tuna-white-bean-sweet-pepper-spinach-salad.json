        "instructions": [
          {
            "id": 164129,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 lemons\n2 (5 oz) pkgs baby spinach\n2 yellow bell peppers\n1 pint grape tomatoes\n1 small bunch green onions (scallions)"
          },
          {
            "id": 164130,
            "primary_message": "Grate the zest from the lemon and transfer to a small bowl, then juice the lemon into the same bowl. Peel and mince (or press) the garlic; add to bowl with the lemon.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 164131,
            "primary_message": "Add oil, salt, and pepper to the bowl with the lemon juice and whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 164132,
            "primary_message": "Drain and rinse the beans; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 164133,
            "primary_message": "Drain the tuna and transfer to a large salad bowl; flake with a fork. Place the spinach in the bowl with the tuna.",
            "secondary_message": "2 (6 oz) cans chunk light tuna in water"
          },
          {
            "id": 164134,
            "primary_message": "Cut the bell pepper into quarters lengthwise; remove and discard the seeds and white membranes. Medium dice the pepper and add to the bowl with the spinach.",
            "secondary_message": null
          },
          {
            "id": 164135,
            "primary_message": "Remove the root ends from the green onions and cut them crosswise, into ¼ inch pieces at an angle; add them to the salad bowl. ",
            "secondary_message": null
          },
          {
            "id": 164136,
            "primary_message": "Halve the tomatoes and add them to the salad bowl as well.",
            "secondary_message": null
          },
          {
            "id": 164137,
            "primary_message": "Add beans to the salad bowl along with the dressing; toss to coat.",
            "secondary_message": null
          },
          {
            "id": 164138,
            "primary_message": "Halve avocado and remove pit; scoop out the flesh and cut into slices; set aside.",
            "secondary_message": "2 avocados"
          },
          {
            "id": 164139,
            "primary_message": "To serve, divide the salad between plates or bowls and top with avocado slices. Enjoy!",
            "secondary_message": null
          }
        ],
