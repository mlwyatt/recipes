        "instructions": [
          {
            "id": 253542,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 253543,
            "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a medium saucepan. Add water and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 20-25 minutes.",
            "secondary_message": "1 cup brown lentils, dried\n3 cup water\n½ tsp salt"
          },
          {
            "id": 253544,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 pint grape tomatoes\n2 sticks celery\n1 small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 253545,
            "primary_message": "Peel and mince garlic; halve grape tomatoes. Transfer both to a baking dish, drizzle with oil, and season with spices. Toss to combine and spread out in an even layer.",
            "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 253546,
            "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until tomatoes have softened and released their juices, 10-12 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 253547,
            "primary_message": "Meanwhile, peel, halve, and slice shallot into thin half-moons. Peel and mince additional garlic. Place both in a medium bowl along with vinegar and spices; stir to combine.",
            "secondary_message": "1 shallot\n2 cloves garlic\n2 tbsp red wine vinegar\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 253548,
            "primary_message": "Trim and slice celery crosswise into thin pieces. Add to the bowl with the shallot and garlic.",
            "secondary_message": null
          },
          {
            "id": 253549,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 253550,
            "primary_message": "Slice sun-dried tomatoes into thin strips and add to the bowl.",
            "secondary_message": "8 sun-dried tomatoes, oil-packed"
          },
          {
            "id": 253551,
            "primary_message": "Crumble goat cheese into the bowl and set aside.",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 253552,
            "primary_message": "When the roasted tomatoes are done, add cream to the baking dish, and stir to combine the warm tomato dressing. Set aside.",
            "secondary_message": "2 fl oz (¼ cup) heavy whipping cream"
          },
          {
            "id": 253553,
            "primary_message": "When the lentils are done, drain in a colander. Add to the bowl with the goat cheese mixture and stir until creamy and combined. ",
            "secondary_message": null
          },
          {
            "id": 253554,
            "primary_message": "Toast bread in the oven or toaster (if desired). Divide lentil mixture between bread slices, spreading it out in an even layer.",
            "secondary_message": "8 slices whole grain bread"
          },
          {
            "id": 253555,
            "primary_message": "To serve, divide lentil tartines and spinach between plates. Spoon the warm tomato dressing over the spinach and enjoy!",
            "secondary_message": null
          }
        ],
