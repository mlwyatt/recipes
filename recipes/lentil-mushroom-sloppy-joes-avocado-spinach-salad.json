  "instructions": [
    {
      "id": 213262,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes.",
      "secondary_message": "1 cup brown lentils\n24 fl oz (3 cups) chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 213263,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lb cremini mushrooms\n2 green bell peppers\n1 avocado\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 213264,
      "primary_message": "Peel and mince onion and garlic; transfer both to a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 213265,
      "primary_message": "Roughly chop mushrooms. Trim, seed, and roughly chop peppers. Add both to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 213266,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 213267,
      "primary_message": "Add vegetables, sugar, and spices to the skillet; stir to combine. Cook, stirring occasionally, until the vegetables are tender-crisp, 3-4 minutes. ",
      "secondary_message": "4 tsp brown sugar\n1 tsp cumin\n1 tsp paprika\n1 tsp salt\n½ tsp chili powder"
    },
    {
      "id": 213268,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, sugar, and salt in the bowl used for the veggies. Whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp Dijon mustard\n2 tsp brown sugar\n⅛ tsp salt"
    },
    {
      "id": 213269,
      "primary_message": "Add tomato sauce to the skillet, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium-low, and continue to cook, stirring occasionally, until the vegetables are tender, 3-4 minutes. ",
      "secondary_message": "2 (8 oz) cans tomato sauce"
    },
    {
      "id": 213270,
      "primary_message": "Meanwhile, halve and pit avocado. Slice thinly while still in skin, then scoop out into the bowl with the dressing. Add spinach and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 213271,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 213272,
      "primary_message": "When the lentils are tender, drain, and add to the skillet with the vegetables; stir to combine the sloppy joe mix. ",
      "secondary_message": null
    },
    {
      "id": 213273,
      "primary_message": "To serve, place the bottom half of a bun on each plate. Top with sloppy joe mix and close with top half of the bun. Divide salad between plates and enjoy! ",
      "secondary_message": null
    }
  ],
