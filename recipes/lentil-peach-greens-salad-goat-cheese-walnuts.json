  "instructions": [
    {
      "id": 45384,
      "primary_message": "Rinse the lentils, then transfer to a small saucepan and cover with hot water (from the tap) by about 2 inches; bring to a boil over high heat.",
      "secondary_message": "1 cup green lentils"
    },
    {
      "id": 45385,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n4 peaches"
    },
    {
      "id": 45386,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl (that will be used to prepare the dressing).",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 45387,
      "primary_message": "Once the water in the saucepan is boiling, reduce the heat to a simmer and cook the lentils until they are just tender, 15 to 20 minutes. Drain in a colander, rinse under cold water, and set aside to cool and drain further.",
      "secondary_message": null
    },
    {
      "id": 45388,
      "primary_message": "To the garlic, add olive oil, balsamic vinegar, Dijon, salt, and pepper; whisk together and set aside.",
      "secondary_message": "6 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n½ tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 45389,
      "primary_message": "Transfer the greens to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 45390,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard the pit; cut each quarter lengthwise into thin wedges. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 45391,
      "primary_message": "Roughly chop the walnuts and add to the salad bowl.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 45392,
      "primary_message": "Crumble the goat cheese with your hands and place in a small bowl.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 45393,
      "primary_message": "Once drained, add the lentils to the salad bowl; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 45394,
      "primary_message": "To serve, divide the salad between plates or bowls, top with the goat cheese, and drizzle with the dressing. Enjoy!",
      "secondary_message": null
    }
  ],
