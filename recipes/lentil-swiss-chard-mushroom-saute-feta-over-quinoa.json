        "instructions": [
          {
            "id": 472443,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 472444,
            "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces, keeping them separate. Place leaves in a medium bowl and set aside.",
            "secondary_message": "1 bunch Swiss chard"
          },
          {
            "id": 472445,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 472446,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, mushrooms, and spices. Cook, stirring often, until veggies are tender, about 5 minutes.",
            "secondary_message": "3 tbsp extra virgin olive oil\n2 (8 oz) pkgs sliced white mushrooms\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 472447,
            "primary_message": "Meanwhile, drain and rinse lentils.",
            "secondary_message": "2 (15 oz) cans lentils"
          },
          {
            "id": 472448,
            "primary_message": "When the veggies are tender, add lentils to the skillet and continue to cook until warmed through, about 1 minute.",
            "secondary_message": null
          },
          {
            "id": 472449,
            "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Add vinaigrette and stir to combine. Remove from heat and cover to keep warm.",
            "secondary_message": "⅓ cup French vinaigrette"
          },
          {
            "id": 472450,
            "primary_message": "To serve, divide quinoa and lentil sauté between plates or bowls, then crumble goat cheese over top. Enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          }
        ],
