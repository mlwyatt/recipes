  "instructions": [
    {
      "id": 130035,
      "primary_message": "Rinse lentils under cold water and transfer to a medium saucepan. Add water and bring to a boil, then reduce the heat to a simmer, cover with a lid, and cook until the lentils are just tender, 15 minutes.",
      "secondary_message": "1 cup red lentils\n2 cup water"
    },
    {
      "id": 130036,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 pint grape tomatoes\n1 avocado\n1 small bunch cilantro\n1 lime\n1 head butter (Boston) lettuce"
    },
    {
      "id": 130037,
      "primary_message": "Seed bell peppers, slice into thin strips. Peel, halve, and thinly slice onion.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 130038,
      "primary_message": "Preheat a skillet over medium heat. Once the skillet is hot, add oil and swirl to coat. Add onions, bell peppers, salt, and pepper; cook, stirring occasionally, until soft, about 8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 130039,
      "primary_message": "Quarter tomatoes and set aside. ",
      "secondary_message": null
    },
    {
      "id": 130040,
      "primary_message": "Halve and pit the avocado; slice crosswise and then lengthwise to form cubes while still in the skin and scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 130041,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and roughly chop the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 130042,
      "primary_message": "Finely chop walnuts and place in a medium bowl. ",
      "secondary_message": "1 cup walnuts"
    },
    {
      "id": 130043,
      "primary_message": "Peel and mince garlic; add to the bowl with the walnuts. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 130044,
      "primary_message": "Add oil, water, and spices to the bowl.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp water\n2 tsp chili powder\n1 tsp oregano\n1 tsp cumin\n½ tsp salt"
    },
    {
      "id": 130045,
      "primary_message": "Add the cooked lentils to the bowl and stir until well combined. ",
      "secondary_message": null
    },
    {
      "id": 130046,
      "primary_message": "To make the crema, juice the lime into a small bowl; add mayo and whisk to combine. ",
      "secondary_message": "¼ cup vegan mayonnaise"
    },
    {
      "id": 130047,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Top with lentil taco \"meat\", veggies, cilantro, and crema. Enjoy!",
      "secondary_message": null
    }
  ],
