        "instructions": [
          {
            "id": 12930,
            "primary_message": "Preheat oven to 350°F.",
            "secondary_message": ""
          },
          {
            "id": 12931,
            "primary_message": "Rinse lentils under cold water and transfer to a small saucepan. Add water and salt; bring to a boil. Reduce heat to a simmer and cook until tender 15-20 minutes.",
            "secondary_message": "1 cup brown lentils\r\n2 cups water\r\n¼ tsp salt"
          },
          {
            "id": 12932,
            "primary_message": "Peel and mince garlic. In a small bowl, mix together ¾ of the garlic (save the rest for the salad), oil, and Italian seasoning.",
            "secondary_message": "8 cloves garlic\n4 tbsp extra virgin olive oil\n2 tsp Italian seasoning"
          },
          {
            "id": 12933,
            "primary_message": "Place buns or rolls cut side up in a small baking dish. Spoon olive oil and garlic mixture on the bread.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 12934,
            "primary_message": "Place in the oven and bake until bread is crusty, 10-12 minutes.",
            "secondary_message": ""
          },
          {
            "id": 12935,
            "primary_message": "In a small bowl, prepare dressing by whisking together remaining garlic, oil, vinegar, Dijon, salt, and pepper.",
            "secondary_message": "6 tbsp extra virgin olive oil\r\n2 tbsp balsamic vinegar\r\n½ tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 12936,
            "primary_message": "Wash and dry greens. Wash, dry, and cut tomatoes into wedges. Halve and pit avocados; scoop out and medium dice. Wash, trim root ends, and chop green onions. Transfer everything to a large bowl.",
            "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n2 tomatoes\n2 avocados\n1 small bunch green onions"
          },
          {
            "id": 12937,
            "primary_message": "Drain lentils and add to bowl. Toss salad.",
            "secondary_message": ""
          },
          {
            "id": 12938,
            "primary_message": "To serve, place salad on a plate, drizzle with dressing, and have with garlic bread on the side. Enjoy!",
            "secondary_message": ""
          }
        ],
