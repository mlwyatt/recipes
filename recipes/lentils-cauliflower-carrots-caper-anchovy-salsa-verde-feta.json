        "instructions": [
          {
            "id": 415951,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 415952,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n4 medium carrots\n2 small bunches Italian (flat-leaf) parsley"
          },
          {
            "id": 415953,
            "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to a large baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 415954,
            "primary_message": "Peel, trim, and medium dice carrots. Add to the baking sheet with the cauliflower.",
            "secondary_message": null
          },
          {
            "id": 415955,
            "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces. Add to the baking sheet along with whole (unpeeled) garlic cloves. Drizzle with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
            "secondary_message": "2 medium red onions\n4 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 415956,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the veggies are golden and fork-tender, 20-25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 415957,
            "primary_message": "Meanwhile, using a strainer, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes.",
            "secondary_message": "1 ½ cups green lentils, dried\n32 fl oz (4 cups) chicken or vegetable broth\n½ tsp salt"
          },
          {
            "id": 415958,
            "primary_message": "While the lentils are cooking, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
            "secondary_message": null
          },
          {
            "id": 415959,
            "primary_message": "Mince anchovy fillets and capers. Add both to the bowl with the parsley along with additional oil, vinegar, and pepper; set aside.",
            "secondary_message": "2 anchovy fillets, packed in oil\n2 tbsp capers\n3 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n½ tsp black pepper"
          },
          {
            "id": 415960,
            "primary_message": "When the lentils are done, drain and return to the pan. Cover and set aside.",
            "secondary_message": null
          },
          {
            "id": 415961,
            "primary_message": "When the veggies are done, carefully transfer roasted garlic to the cutting board. Using the back of a spoon, press on the cloves to remove the skins. Mash with a fork, add to the bowl with the parsley mixture, and stir to combine the salsa verde.",
            "secondary_message": null
          },
          {
            "id": 415962,
            "primary_message": "Add half of the salsa verde to the pan with the lentils. Stir to combine. (Reserve remaining salsa verde for serving.)",
            "secondary_message": null
          },
          {
            "id": 415963,
            "primary_message": "To serve, divide lentils between plates or bowls; top with the veggies, feta, and reserved salsa verde. Enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          }
        ],
