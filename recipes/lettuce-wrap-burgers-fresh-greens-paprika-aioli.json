        "instructions": [
          {
            "id": 289217,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n2 green bell peppers\n1 pint grape tomatoes\n2 heads butter (Boston) lettuce"
          },
          {
            "id": 289218,
            "primary_message": "Zest lemon into a small bowl.",
            "secondary_message": null
          },
          {
            "id": 289219,
            "primary_message": "Juice half of the lemon into the bowl with the zest. Add mayo and spices; whisk to combine the aioli and set aside.",
            "secondary_message": "¼ cup mayonnaise\n1 tsp garlic powder\n1 tsp paprika\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 289220,
            "primary_message": "Juice remaining lemon into a large salad bowl. Add oil, salt, and pepper; whisk to combine the dressing and set aside.",
            "secondary_message": "¼ cup extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 289221,
            "primary_message": "Form the ground beef into 4 equal-sized patties, place on a plate, and season with salt and pepper.",
            "secondary_message": "1 ½ lb lean ground beef\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 289222,
            "primary_message": "Preheat a large grill pan or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 289223,
            "primary_message": "Once the grill pan or skillet is hot, coat with oil.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 289224,
            "primary_message": "Place the burger patties in the grill pan and cook, undisturbed, 3-4 minutes; flip patties and cook an additional 2-3 minutes, until cooked through. Once done, transfer to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 289225,
            "primary_message": "Meanwhile, seed and slice the bell peppers into thin strips; add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 289226,
            "primary_message": "Halve the tomatoes and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 289227,
            "primary_message": "Separate the lettuce leaves. Set aside two large leaves per burger; chop or tear remaining leaves into bite-sized pieces and add to the bowl with the dressing. Toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 289228,
            "primary_message": "Pile leaves, in stacks of two per wrap, onto plates. Top with a burger patty and a spoonful of aioli. Serve with salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
