        "instructions": [
          {
            "id": 15935,
            "primary_message": "In a small bowl, prepare dressing by whisking together lime juice, olive oil, honey, cumin, salt, and pepper.",
            "secondary_message": "juice of 2 limes\r\n6 tbsp extra virgin olive oil\r\n1 tsp honey\r\n½ tsp cumin\r\n¼ tsp salt\r\n¼ tsp black pepper\r\n⅛ tsp crushed red pepper"
          },
          {
            "id": 15936,
            "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Add to dressing and mix. Set aside.",
            "secondary_message": "1 small bunch cilantro"
          },
          {
            "id": 15937,
            "primary_message": "Wash and dry arugula.",
            "secondary_message": "1 (5 oz) pkg baby arugula"
          },
          {
            "id": 15938,
            "primary_message": "Halve and pit avocados; scoop out and medium dice the flesh. Wash and peel mangoes; slice flesh away from pit and medium dice. Peel and thinly slice onion into half rings.",
            "secondary_message": "2 avocados\r\n2 mangoes\r\n1 medium red onion"
          },
          {
            "id": 15939,
            "primary_message": "To serve, arrange a bed of arugula on a plate and top with onion, avocado, and mango. Drizzle with dressing and sprinkle with pine nuts. Enjoy!",
            "secondary_message": "½ cup pine nuts"
          }
        ],
