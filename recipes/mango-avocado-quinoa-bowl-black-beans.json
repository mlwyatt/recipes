        "instructions": [
          {
            "id": 49848,
            "primary_message": "In a small saucepan, combine the quinoa and water; bring to a boil over high heat.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) water"
          },
          {
            "id": 49849,
            "primary_message": "Drain and rinse the black beans in a colander; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 49850,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 mangoes\n1 avocado\n1 lime\n1 small bunch cilantro"
          },
          {
            "id": 49851,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the quinoa for 15 minutes. Once done, remove the quinoa from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 49852,
            "primary_message": "Juice the lime and transfer to a medium salad bowl.",
            "secondary_message": ""
          },
          {
            "id": 49853,
            "primary_message": "To the lime juice, add olive oil, honey, salt, and pepper; whisk together.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 49854,
            "primary_message": "Peel the mangoes, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and small dice the flesh into ¼-inch cubes. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 49855,
            "primary_message": "Halve the avocado lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and small dice the flesh into ¼-inch cubes. Add to the salad bowl.",
            "secondary_message": ""
          },
          {
            "id": 49856,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 49857,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces. Add to the salad bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 49858,
            "primary_message": "Preheat a nonstick skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 49859,
            "primary_message": "Once the skillet is hot, add the black beans and cook until heated through, 2 to 3 minutes. Remove from the heat.",
            "secondary_message": null
          },
          {
            "id": 49860,
            "primary_message": "Uncover the quinoa and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 49861,
            "primary_message": "To serve, arrange the quinoa, black beans, and mango-avocado mixture in a bowl. Enjoy!",
            "secondary_message": null
          }
        ],
