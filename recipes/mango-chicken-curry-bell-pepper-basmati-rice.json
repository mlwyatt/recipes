        "instructions": [
          {
            "id": 49755,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) water"
          },
          {
            "id": 49756,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n2 mangoes\n2 (1 inch) pieces ginger root\n1 small bunch cilantro\n"
          },
          {
            "id": 49757,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 49758,
            "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Large dice the peppers into ¾-inch cubes. Transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 49759,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces. Add to the bowl with the bell peppers.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 49760,
            "primary_message": "Peel the mangoes, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and large dice the flesh into ¾-inch cubes. Transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 49761,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 49762,
            "primary_message": "Peel and grate or mince the ginger. Transfer to a small bowl.",
            "secondary_message": ""
          },
          {
            "id": 49763,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the ginger.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 49764,
            "primary_message": "To the ginger and garlic, add curry powder, cumin, salt, and pepper.",
            "secondary_message": "2 tbsp curry powder\n1 tsp cumin\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 49765,
            "primary_message": "Preheat a sauté pan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 49766,
            "primary_message": "While the pan heats up, pat the chicken dry with paper towels, then cut into 1-inch cubes.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 49767,
            "primary_message": "Once the pan is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 49768,
            "primary_message": "Add the chicken to the pan and season with salt and pepper; cook, stirring occasionally, until the chicken is browned but not cooked through, 1 to 2 minutes. Transfer to a bowl.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 49769,
            "primary_message": "Once the chicken has been transferred, add the bell peppers and onion to the pan; cook, stirring frequently, until softened, 3 to 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 49770,
            "primary_message": "Add the spice mixture to the pan; stir until fragrant and well combined, 15 to 30 seconds.",
            "secondary_message": null
          },
          {
            "id": 49771,
            "primary_message": "Add the coconut milk and mangoes to the pan; bring to a boil.",
            "secondary_message": "1 (13.5 fl oz) can coconut milk"
          },
          {
            "id": 49772,
            "primary_message": "Once boiling, reduce the heat to a simmer. Add the chicken and about ¾ of the cilantro (save the rest for garnishing) to the pan. Cook, stirring occasionally, until the chicken is cooked through, 4 to 6 minutes.",
            "secondary_message": null
          },
          {
            "id": 49773,
            "primary_message": "Uncover the rice and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 49774,
            "primary_message": "To serve, divide the rice between bowls, top with the curry, and garnish with the remaining cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
