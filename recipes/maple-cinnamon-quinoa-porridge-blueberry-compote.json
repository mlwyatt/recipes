        "instructions": [
          {
            "id": 178436,
            "primary_message": "Place quinoa, almond milk, maple syrup, salt, and cinnamon in a medium saucepan. Bring to a boil over medium-high heat.",
            "secondary_message": "1 cup quinoa\n24 fl oz (3 cups) almond milk, unsweetened\n2 tbsp pure maple syrup\n¼ tsp salt\n2 tsp cinnamon"
          },
          {
            "id": 178437,
            "primary_message": "Once the quinoa mixture comes to a boil, reduce heat to low, allow to cool slightly, and cover with a lid. Cook until most of the liquid is absorbed, about 20 minutes. ",
            "secondary_message": null
          },
          {
            "id": 178438,
            "primary_message": "Add the blueberries and maple syrup to a small saucepan. Heat on medium-high, 3-4 minutes.",
            "secondary_message": "2 cup frozen blueberries\n2 tbsp pure maple syrup"
          },
          {
            "id": 178439,
            "primary_message": "To serve, divide porridge between bowls, drizzle with more milk, and top with blueberry compote. Enjoy!",
            "secondary_message": "4 fl oz (½ cup) almond milk, unsweetened"
          }
        ],
