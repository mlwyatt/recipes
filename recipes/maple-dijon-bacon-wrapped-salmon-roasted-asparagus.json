        "instructions": [
          {
            "id": 487973,
            "primary_message": "Preheat oven to 400°F. Line a large baking sheet pan with aluminum foil (for easier cleanup).",
            "secondary_message": null
          },
          {
            "id": 487974,
            "primary_message": "Wash and dry asparagus. Snap (or cut) off woody ends and arrange on one half of the prepared baking sheet. Drizzle with oil, then season with salt and pepper; set aside.",
            "secondary_message": "2 small bunches asparagus\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 487975,
            "primary_message": "Place maple syrup and Dijon in a small bowl; whisk to combine the sauce and set aside.",
            "secondary_message": "2 tbsp pure maple syrup\n2 tbsp Dijon mustard"
          },
          {
            "id": 487976,
            "primary_message": "If using salmon with skin, place the fillet, skin-side down, on the cutting board. Holding the tail end firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin). Discard the skin.",
            "secondary_message": "1 ½ lb salmon fillet"
          },
          {
            "id": 487977,
            "primary_message": "Cut salmon into portions. Spread half of the sauce over the salmon, then wrap with bacon. Spread remaining sauce over the bacon, then arrange, seam-side down, on the other side of the baking sheet.",
            "secondary_message": "8 slices bacon"
          },
          {
            "id": 487978,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through and asparagus is tender, 10-12 minutes. Remove from oven and transfer asparagus to a plate; cover with aluminum foil.",
            "secondary_message": null
          },
          {
            "id": 487979,
            "primary_message": "Change the oven to broil on high and position rack in the upper third of the oven. Return salmon to the oven and broil until bacon is crispy, 2-3 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 487980,
            "primary_message": "To serve, divide salmon and asparagus between plates. Enjoy!",
            "secondary_message": null
          }
        ],
