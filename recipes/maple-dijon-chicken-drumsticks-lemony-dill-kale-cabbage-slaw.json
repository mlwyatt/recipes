        "instructions": [
          {
            "id": 429179,
            "primary_message": "Preheat oven to 450°F. ",
            "secondary_message": null
          },
          {
            "id": 429180,
            "primary_message": "Place oil, maple syrup, Dijon, salt, and pepper in a large baking dish; whisk to combine the marinade.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n4 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 429181,
            "primary_message": "Pat chicken dry with paper towels, add to the baking dish with the marinade, and turn to coat. ",
            "secondary_message": "2 ½ lb chicken drumsticks"
          },
          {
            "id": 429182,
            "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until chicken is cooked through, 25-30 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 429183,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 lemons\n1 bunch kale\n1 medium head napa cabbage\n1 small bunch fresh dill"
          },
          {
            "id": 429184,
            "primary_message": "Zest and juice lemons into a large bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
            "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 429185,
            "primary_message": "Wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 429186,
            "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise. Add to the bowl. Using your hands, massage the greens with the dressing until wilted, about 2 minutes.",
            "secondary_message": null
          },
          {
            "id": 429187,
            "primary_message": "Shave the dill leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl and toss to combine the slaw.",
            "secondary_message": null
          },
          {
            "id": 429188,
            "primary_message": "To serve, divide chicken and slaw between plates. Enjoy!",
            "secondary_message": null
          }
        ],
