  "instructions": [
    {
      "id": 251836,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n1 head romaine lettuce\n2 Granny Smith apples"
    },
    {
      "id": 251837,
      "primary_message": "Peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 251838,
      "primary_message": "Juice lemons into the bowl with the garlic; add soy sauce, vinegar, Worcestershire, Dijon, and pepper. Whisk to combine the marinade.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp white wine vinegar\n2 tsp Worcestershire sauce\n1 tsp Dijon mustard\n1 tsp black pepper"
    },
    {
      "id": 251839,
      "primary_message": "Place the steak in the marinade, turn to coat, and set aside.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak"
    },
    {
      "id": 251840,
      "primary_message": "Peel and mince additional garlic; transfer to another medium bowl along with yogurt, blue cheese, water, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n¼ cup plain Greek yogurt\n1 (4 oz) pkg crumbled blue cheese\n4 tsp water\n2 tsp white wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 251841,
      "primary_message": "Chop or tear romaine into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 251842,
      "primary_message": "Roughly chop walnuts and add to the bowl.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 251843,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 251844,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and let rest for 5 minutes.",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "id": 251845,
      "primary_message": "Meanwhile, quarter, core, and cut apples into matchsticks, add to the bowl with the romaine, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 251846,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 251847,
      "primary_message": "To serve, divide salad and steak between plates. Enjoy!",
      "secondary_message": null
    }
  ],
