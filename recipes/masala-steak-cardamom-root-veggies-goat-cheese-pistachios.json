  "instructions": [
    {
      "id": 381605,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 381606,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh basil\n4 medium carrots\n4 medium parsnips"
    },
    {
      "id": 381607,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 381608,
      "primary_message": "Add goat cheese to the bowl with the basil; set aside to soften.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 381609,
      "primary_message": "Peel, trim, and slice carrots and parsnips crosswise into ¼-inch thick rounds. Transfer both to a large baking sheet pan, season with cardamom and salt, then stir to combine. Spread out in an even layer and drizzle with honey.",
      "secondary_message": "1 ½ tsp cardamom, ground\n½ tsp salt\n4 tsp honey"
    },
    {
      "id": 381610,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies. Place baking sheet in the oven (it doesn't need to be fully heated) and roast, stirring halfway through, until veggies are tender, about 20 minutes. Remove from oven.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 381611,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381612,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate. Season with spices on both sides. ",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 ½ tsp garam masala\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 381613,
      "primary_message": "Once the pan is hot, coat with butter. Add steak and grill until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 381614,
      "primary_message": "While the steak is cooking, use the back of a spoon to mash and combine the basil-goat cheese. Set aside.",
      "secondary_message": null
    },
    {
      "id": 381615,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 381616,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 381617,
      "primary_message": "To serve, divide steak and veggies between plates. Top veggies with basil-goat cheese and pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
