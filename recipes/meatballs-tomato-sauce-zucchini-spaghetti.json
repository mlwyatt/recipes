  "instructions": [
    {
      "id": 22877,
      "primary_message": "Peel and mince onion. Peel and mince garlic. Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 medium yellow onion\r\n6 cloves garlic\r\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 22878,
      "primary_message": "In a medium bowl, combine beef, eggs, almond meal, ½ of the onion, ½ of the garlic, cumin, basil, salt, pepper, and a ¼ of the minced parsley. Mix together.",
      "secondary_message": "1 ½ lb lean ground beef\n2 eggs\n¼ cup almond meal/flour\n½ tsp cumin\n2 tsp basil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 22879,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 22880,
      "primary_message": "Form beef mixture into small balls and place on a plate.",
      "secondary_message": ""
    },
    {
      "id": 22881,
      "primary_message": "Coat bottom of skillet with oil and add meatballs. Turning occasionally, cook until browned but not cooked through, 2-3 minutes. Transfer to a plate once done.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 22882,
      "primary_message": "Once meatballs have been transferred, add more oil to skillet. Add remaining onion and cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 22883,
      "primary_message": "Add remaining garlic and red pepper to skillet and cook until fragrant, 15-30 seconds.",
      "secondary_message": "¼ tsp crushed red pepper\r\n"
    },
    {
      "id": 22884,
      "primary_message": "Add tomatoes, remaining parsley, oregano, basil, salt, and pepper. Mash tomatoes with a potato masher. Bring to a boil. Reduce heat, add meatballs, and simmer until meatballs are cooked through, 5-10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\r\n½ tsp oregano\r\n½ tsp basil\r\n1 tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 22885,
      "primary_message": "Wash zucchini, trim ends, and use a julienne (or regular) peeler to make noodles.",
      "secondary_message": "4 medium zucchini squash\r\n"
    },
    {
      "id": 22886,
      "primary_message": "To serve, place zucchini noodles in a bowl, top with meatballs and sauce, and enjoy!",
      "secondary_message": ""
    }
  ],
