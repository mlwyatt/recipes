        "instructions": [
          {
            "id": 264492,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 264493,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 green bell peppers\n4 tomatoes\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 264494,
            "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 264495,
            "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season both sides with spices.",
            "secondary_message": "8 lamb loin chops\n1 tsp paprika\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 264496,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add lamb chops and pan-fry until browned, flipping once, 4-6 minutes (the chops will not be cooked all the way through).",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 264497,
            "primary_message": "While the lamb is cooking, peel, halve, and slice onion lengthwise into thin wedges.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 264498,
            "primary_message": "Trim, seed, and slice bell peppers into thin strips.",
            "secondary_message": null
          },
          {
            "id": 264499,
            "primary_message": "When the lamb is browned, remove skillet from heat and add the onion and bell pepper, nestling them around the chops.",
            "secondary_message": null
          },
          {
            "id": 264500,
            "primary_message": "Place skillet in the oven and roast until the veggies are fork-tender and chops are cooked through, 6-8 minutes more. Remove skillet from the oven.",
            "secondary_message": null
          },
          {
            "id": 264501,
            "primary_message": "Meanwhile, halve and slice tomatoes into 1-inch thick wedges; place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 264502,
            "primary_message": "Halve olives and add to the bowl with the tomatoes.",
            "secondary_message": "⅔ cup Kalamata olives, pitted"
          },
          {
            "id": 264503,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 264504,
            "primary_message": "When the chops are done, transfer to a clean plate and loosely cover with aluminum foil.",
            "secondary_message": null
          },
          {
            "id": 264505,
            "primary_message": "Add tomatoes, olives, and parsley to the skillet and toss to combine. Return skillet to the oven and roast until tomatoes are warmed through, about 4 minutes. Remove from the oven.",
            "secondary_message": null
          },
          {
            "id": 264506,
            "primary_message": "To serve, divide the veggies and lamb chops between plates. Top veggies with feta and enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          }
        ],
