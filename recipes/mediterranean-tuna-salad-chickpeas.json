        "instructions": [
          {
            "id": 38604,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 pint grape tomatoes\n1 English cucumber\n2 sticks celery\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 38605,
            "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 38606,
            "primary_message": "Halve the grape tomatoes and transfer to a large salad bowl.",
            "secondary_message": null
          },
          {
            "id": 38607,
            "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into ¼-inch-thick pieces on an angle and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 38608,
            "primary_message": "Trim off and discard the ends of the celery; halve the celery lengthwise, then slice crosswise at an angle into ¼-inch-thick pieces and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 38609,
            "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 38610,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces) and add to the salad bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 38611,
            "primary_message": "Halve the olives lengthwise and add to the salad bowl.",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 38612,
            "primary_message": "Add the capers to the salad bowl.",
            "secondary_message": "4 tbsp capers"
          },
          {
            "id": 38613,
            "primary_message": "Open the tuna cans and drain the liquid; add to the salad bowl.",
            "secondary_message": "4 (6 oz) cans chunk light tuna, packed in water"
          },
          {
            "id": 38614,
            "primary_message": "Transfer the chickpeas to a clean towel or paper towels and pat dry; add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 38615,
            "primary_message": "Juice the lemon into a small bowl.",
            "secondary_message": null
          },
          {
            "id": 38616,
            "primary_message": "Add olive oil, Dijon, salt, and pepper to the bowl with the lemon juice; whisk together until well combined.",
            "secondary_message": "6 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 38617,
            "primary_message": "Pour the dressing over the salad and toss to coat.",
            "secondary_message": null
          },
          {
            "id": 38618,
            "primary_message": "To serve, spoon the salad into a bowl. Enjoy!",
            "secondary_message": null
          }
        ],
