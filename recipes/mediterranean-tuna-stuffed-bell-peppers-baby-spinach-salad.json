  "instructions": [
    {
      "id": 27611,
      "primary_message": "Preheat the broiler. Line a baking sheet with foil.",
      "secondary_message": ""
    },
    {
      "id": 27612,
      "primary_message": "Wash, halve lengthwise, and seed the bell peppers.",
      "secondary_message": "2 red bell peppers\n2 orange bell peppers"
    },
    {
      "id": 27613,
      "primary_message": "Place the peppers cut-side down on the baking sheet. Place in the oven and broil until the peppers start to soften and brown, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 27614,
      "primary_message": "Drain the tuna and transfer to a large bowl.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 27615,
      "primary_message": "Wash and halve the tomatoes; add to the tuna bowl.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 27616,
      "primary_message": "Wash and dry the parsley. Shave the leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 27617,
      "primary_message": "Peel and mince the shallots; add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 27618,
      "primary_message": "Halves the olives and add to the bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted "
    },
    {
      "id": 27619,
      "primary_message": "Add the capers, feta, lemon juice, olive oil, Dijon, and pepper to tuna mixture. Mix until well combined.",
      "secondary_message": "2 tbsp capers\n1 (4 oz) pkg crumbled feta cheese\n½ lemon\n2 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp black pepper"
    },
    {
      "id": 27620,
      "primary_message": "Remove the peppers from the oven and carefully flip them over. Fill the peppers with the tuna mixture. Return to the oven and broil for another 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 27621,
      "primary_message": "Wash and dry the spinach.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 27622,
      "primary_message": "Cut the remaining piece of lemon into wedges.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 27623,
      "primary_message": "Place the stuffed peppers on a plate. Arrange a bed of greens on the side; drizzle with olive oil and squeeze lemon juice over top. Enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil"
    }
  ],
