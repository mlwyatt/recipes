        "instructions": [
          {
            "id": 373095,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 373096,
            "primary_message": "Drain and rinse chickpeas. Transfer to a large baking sheet pan.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 373097,
            "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Add to the baking sheet with the chickpeas.",
            "secondary_message": "4 green bell peppers"
          },
          {
            "id": 373098,
            "primary_message": "Wash and dry tomatoes. Add to the baking sheet.",
            "secondary_message": "2 pints grape tomatoes"
          },
          {
            "id": 373099,
            "primary_message": "Peel, halve, and thinly slice onions lengthwise. Add to the baking sheet, drizzle with vinaigrette, and season with spices. Toss to combine and spread out in an even layer.",
            "secondary_message": "2 medium red onions\n⅓ cup balsamic vinaigrette\n1 ½ tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 373100,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are tender and tomatoes start to burst, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 373101,
            "primary_message": "Meanwhile, arrange pitas on another baking sheet. Add to the oven and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven, cut into wedges, and set aside.",
            "secondary_message": "4 whole grain pitas"
          },
          {
            "id": 373102,
            "primary_message": "When the chickpeas and veggies are done, remove from oven. Sprinkle with feta and toss to combine.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 373103,
            "primary_message": "Divide chickpea and veggie bake between plates or bowls. Serve with pita wedges and tzatziki on the side. Enjoy!",
            "secondary_message": "1 cup tzatziki sauce"
          }
        ],
