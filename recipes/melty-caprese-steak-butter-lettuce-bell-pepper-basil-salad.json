  "instructions": [
    {
      "id": 310286,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 310287,
      "primary_message": "Add oil, vinegar, and spices to the bowl with the garlic; whisk to combine the dressing. Pour half into a large baking dish, then set the bowl aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp balsamic vinegar\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 310288,
      "primary_message": "Cut steak into portions, pat dry with paper towels, and add to the baking dish; turn to coat and set aside to marinate.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak"
    },
    {
      "id": 310289,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 yellow bell peppers\n2 tomatoes\n1 small pkg fresh basil\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 310290,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310291,
      "primary_message": "While the skillet heats up, using a clean cutting board, trim, seed, and medium dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 310292,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper, salt, and pepper. Cook, stirring occasionally, until fork-tender, 3-4 minutes. Remove to a plate, loosely cover with aluminum foil, and set aside. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 310293,
      "primary_message": "When the peppers are done, return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 310294,
      "primary_message": "Meanwhile, thinly slice tomatoes and mozzarella crosswise into rounds.",
      "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 310295,
      "primary_message": "When the steak is done, remove skillet from heat; top with tomatoes and mozzarella. Cover with a lid and let sit until cheese starts to melt, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 310296,
      "primary_message": "While the cheese melts, pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Add half to the bowl with the dressing. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 310297,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces; add to the bowl, along with the cooked peppers, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 310298,
      "primary_message": "To serve, divide salad and steaks between plates. Top steaks with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
