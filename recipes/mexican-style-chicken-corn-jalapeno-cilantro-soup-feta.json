  "instructions": [
    {
      "id": 310364,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 sticks celery\n1 orange bell pepper\n2 jalapeño peppers\n1 bunch radish\n1 small bunch cilantro"
    },
    {
      "id": 310365,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 310366,
      "primary_message": "Trim and small dice celery; trim, seed, and medium dice bell pepper. Add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 310367,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 310368,
      "primary_message": "While the pot heats up, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the veggies. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 310369,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring frequently, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 310370,
      "primary_message": "Add flour and spices to the pot; continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "2 tbsp all-purpose flour\n4 tsp chili powder\n2 tsp cumin, ground\n2 tsp coriander, ground\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 310371,
      "primary_message": "Add chicken, broth, and tomato sauce to the pot. Stir to combine, cover, and bring to a boil over high heat; once boiling, reduce heat to medium-low and simmer, stirring occasionally, until chicken is cooked through, 10-12 minutes.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n32 fl oz (4 cups) chicken or vegetable broth\n2 (8 oz) cans tomato sauce"
    },
    {
      "id": 310372,
      "primary_message": "Meanwhile, trim, halve, and thinly slice radishes crosswise; place in the reserved bowl. Drizzle with vinegar, sprinkle with salt, and stir to combine; set aside to marinate. ",
      "secondary_message": "4 tsp apple cider vinegar\n¼ tsp salt"
    },
    {
      "id": 310373,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 310374,
      "primary_message": "When the chicken is done, remove thighs to a plate using tongs (continue to simmer soup over low heat). Shred the chicken using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat.",
      "secondary_message": null
    },
    {
      "id": 310375,
      "primary_message": "Return shredded chicken to the pot, along with cilantro, corn, and additional vinegar; stir to combine the soup and continue to simmer until warmed through, 2-3 minutes more.",
      "secondary_message": "1 cup frozen corn\n4 tsp apple cider vinegar"
    },
    {
      "id": 310376,
      "primary_message": "To serve, divide soup between bowls; top with pickled radish and feta. Enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
