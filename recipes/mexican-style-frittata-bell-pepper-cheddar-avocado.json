        "instructions": [
          {
            "id": 44652,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n2 jalapeño peppers\n2 avocados\n1 small bunch green onions (scallions)"
          },
          {
            "id": 44653,
            "primary_message": "Preheat the oven to the broil setting and position the rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 44654,
            "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stems, seeds, and membranes. Slice the quarters crosswise into small strips and transfer to a medium bowl.",
            "secondary_message": ""
          },
          {
            "id": 44655,
            "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stems, seeds, and membranes. Finely dice the peppers and add to the bowl with the bell peppers.",
            "secondary_message": null
          },
          {
            "id": 44656,
            "primary_message": "Preheat an ovenproof skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 44657,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; quarter the onion lengthwise, then thinly slice crosswise. Add to the bowl with the peppers.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 44658,
            "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 44659,
            "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 44660,
            "primary_message": "Add the peppers, onion, and about ¾ of the green onions (save the rest for garnishing) to the skillet; season with chili powder, cumin, salt, and pepper. Cook, stirring frequently, until the vegetables have softened, 4 to 6 minutes.",
            "secondary_message": "1 tsp chili powder\n½ tsp cumin\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 44661,
            "primary_message": "Coarsely grate about 1 cup of cheddar.",
            "secondary_message": "½ (8 oz) block cheddar cheese"
          },
          {
            "id": 44662,
            "primary_message": "In a large bowl, combine and whisk together the cheddar, eggs, water, salt, and pepper.",
            "secondary_message": "12 eggs\n4 tbsp water\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 44663,
            "primary_message": "Pour the egg mixture into the skillet. While tilting the skillet with one hand, lift up the edges of the frittata with a spatula and let the eggs run underneath during the first few minutes of cooking. Cook until most of the frittata is set, but the top is still runny, 4 to 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 44664,
            "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; thinly slice the flesh crosswise (without piercing the skin) and scoop out.",
            "secondary_message": null
          },
          {
            "id": 44665,
            "primary_message": "Transfer the skillet to the oven and broil until the top is set and lightly browned, 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 44666,
            "primary_message": "To serve, separate the frittata into wedges and divide between plates; top with avocado slices and remaining green onions. Enjoy!",
            "secondary_message": null
          }
        ],
