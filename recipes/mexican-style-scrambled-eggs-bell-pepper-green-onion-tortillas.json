  "instructions": [
    {
      "id": 444158,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 small bunch green onions (scallions)\n1 jalapeño pepper\n1 small bunch cilantro"
    },
    {
      "id": 444159,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 444160,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 444161,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 444162,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 444163,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl. (Reserve the remainder for serving.)",
      "secondary_message": null
    },
    {
      "id": 444164,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, cilantro, and spices; cook, stirring occasionally, until softened, 2-3 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ½ tsp chili powder\n½ tsp coriander, ground\n½ tsp salt"
    },
    {
      "id": 444165,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl. Whisk to combine.",
      "secondary_message": "12 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 444166,
      "primary_message": "Once the veggies are soft, pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 444167,
      "primary_message": "Warm tortillas in another skillet or the microwave (optional).",
      "secondary_message": "8 small flour tortillas"
    },
    {
      "id": 444168,
      "primary_message": "Divide egg scramble and tortillas between plates; sprinkle eggs with reserved cilantro. Serve with hot sauce on the side and enjoy!",
      "secondary_message": "2 tsp hot sauce"
    }
  ],
