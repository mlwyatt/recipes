  "instructions": [
    {
      "id": 230596,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 tomatoes\n2 medium carrots\n½ lb green beans\n1 avocado\n1 lime"
    },
    {
      "id": 230597,
      "primary_message": "Peel and large dice onion. Large dice tomatoes; place both in a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 230598,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 230599,
      "primary_message": "While the pot heats up, peel and roughly chop garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 230600,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion, tomatoes, garlic, and salt; cook, stirring occasionally, until veggies start to soften, about 5 minutes. Remove from heat. (Reserve bowl for next step.)",
      "secondary_message": "¼ cup butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 230601,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots. Trim and cut green beans into 1-inch pieces. Place both in the reserved bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 230602,
      "primary_message": "Working in batches if necessary, transfer the tomato-onion mixture to a blender and blend on high until smooth; set aside.",
      "secondary_message": null
    },
    {
      "id": 230603,
      "primary_message": "Use your hands to break the pasta into 1-inch pieces.",
      "secondary_message": "6 oz spaghetti pasta"
    },
    {
      "id": 230604,
      "primary_message": "Return pot to the stove over medium-high heat; add more butter and swirl to coat the bottom. Add the pasta and cook, stirring constantly, until it turns golden, 1-2 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 230605,
      "primary_message": "Add tomato-onion pureé, broth, tomato sauce, carrots, green beans, and spices to the pot. Stir to combine, bring to a boil, then reduce the heat to medium-low and cover the pot. Simmer, stirring occasionally, until pasta and vegetables are tender, 8-10 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n2 (8 oz) cans tomato sauce\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper\n½ tsp cumin, ground"
    },
    {
      "id": 230606,
      "primary_message": "Add peas to the soup during the last 2 minutes of cooking; continue to simmer until heated through, about 2 minutes.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 230607,
      "primary_message": "Meanwhile, halve and pit the avocado; scoop out flesh with a spoon and medium dice.",
      "secondary_message": null
    },
    {
      "id": 230608,
      "primary_message": "Cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 230609,
      "primary_message": "Divide soup between bowls; top with avocado and feta. Serve with lime wedges on the side and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
