        "instructions": [
          {
            "id": 278784,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium carrots\n2 sticks celery\n1 lb green beans"
          },
          {
            "id": 278785,
            "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a small bowl.",
            "secondary_message": null
          },
          {
            "id": 278786,
            "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the carrot and celery.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 278787,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 278788,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 278789,
            "primary_message": "Meanwhile, drain and rinse kidney beans; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans kidney beans"
          },
          {
            "id": 278790,
            "primary_message": "When the veggies are soft, add broth and tomatoes; stir to combine the soup and bring to a boil.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes"
          },
          {
            "id": 278791,
            "primary_message": "Once the soup is boiling, add the kidney beans and pasta; stir to combine. Reduce heat to medium, cover, and cook, stirring occasionally until the pasta is partially cooked, about 5 minutes.",
            "secondary_message": "6 oz macaroni (elbow) pasta"
          },
          {
            "id": 278792,
            "primary_message": "Meanwhile, trim and cut green beans into 1-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 278793,
            "primary_message": "Add green beans to the soup and continue to cook, stirring occasionally, until pasta and veggies are tender, 3-5 minutes more.",
            "secondary_message": null
          },
          {
            "id": 278794,
            "primary_message": "To serve, divide soup between bowls and enjoy!",
            "secondary_message": null
          }
        ],
