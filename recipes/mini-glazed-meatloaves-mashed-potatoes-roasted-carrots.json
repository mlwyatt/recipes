  "instructions": [
    {
      "id": 292757,
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 292758,
      "primary_message": "Peel and mince onion; place in a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 292759,
      "primary_message": "Add ground beef, eggs, milk, bread crumbs, salt, and pepper to the bowl with the onions. Mix with your hands until well combined.",
      "secondary_message": "1 ½ lb lean ground beef\n2 eggs\n4 fl oz (½ cup) whole milk\n½ cup panko bread crumbs\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 292760,
      "primary_message": "Place ketchup, Dijon, and brown sugar in a small bowl; whisk to combine.",
      "secondary_message": "3 tbsp ketchup\n2 tsp Dijon mustard\n1 tsp brown sugar"
    },
    {
      "id": 292761,
      "primary_message": "Divide meatloaf mixture between 12 muffin cups and top with ketchup glaze. Place in the oven and bake until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 292762,
      "primary_message": "Meanwhile, wash, peel, and medium dice potatoes. Transfer to a medium saucepan, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. ",
      "secondary_message": "2 medium yellow potatoes"
    },
    {
      "id": 292763,
      "primary_message": "Wash, trim, and peel carrots. Slice lengthwise into quarters. Place on a baking sheet pan, drizzle with oil, and season with salt and pepper. Place in the oven and bake until golden and fork-tender, about 10 minutes.",
      "secondary_message": "6 medium carrots\n4 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 292764,
      "primary_message": "When the potatoes are done, drain, and return to the pan.",
      "secondary_message": null
    },
    {
      "id": 292765,
      "primary_message": "Add milk, butter, salt, and pepper to the potatoes. Mash until smooth.",
      "secondary_message": "4 fl oz (½ cup) whole milk\n4 tsp butter, unsalted\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 292766,
      "primary_message": "To serve, divide the meatloaves, roasted carrots, and mashed potatoes between plates. Enjoy!",
      "secondary_message": null
    }
  ],
