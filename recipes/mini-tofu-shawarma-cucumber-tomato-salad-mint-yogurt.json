  "instructions": [
    {
      "id": 235098,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 235099,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 235100,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n1 English cucumber\n1 small pkg fresh mint"
    },
    {
      "id": 235101,
      "primary_message": "Place oil and spices in a medium bowl; stir to combine the spice paste. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper\n½ tsp cinnamon, ground\n¼ tsp cardamom, ground\n¼ tsp nutmeg, ground\n¼ tsp cloves, ground\n¼ tsp turmeric, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 235102,
      "primary_message": "Medium dice tofu, add to the bowl with the spice paste, and gently toss to coat. Transfer tofu to a large baking sheet and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 235103,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235104,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp red wine vinegar\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 235105,
      "primary_message": "Peel, halve, and thinly slice shallots; add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 235106,
      "primary_message": "Small dice tomatoes. Peel, trim, and small dice cucumber. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 235107,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 235108,
      "primary_message": "Peel and mince garlic. Add to the bowl with the mint, along with yogurt, salt, and pepper; stir to combine the yogurt sauce.",
      "secondary_message": "2 cloves garlic\n1 ½ cups plain Greek yogurt\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 235109,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 235110,
      "primary_message": "To serve, fill tortillas with tofu, cucumber-tomato salad, and mint yogurt. Divide between plates and enjoy!",
      "secondary_message": null
    }
  ],
