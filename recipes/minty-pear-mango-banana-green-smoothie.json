  "instructions": [
    {
      "id": 170778,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 170779,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed). ",
      "secondary_message": "1 English cucumber\n2 pears\n1 lime\n1 small pkg fresh mint\n2 bananas\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 170780,
      "primary_message": "Roughly chop cucumber; transfer to a blender along with cold water and maple syrup. Blend until smooth.",
      "secondary_message": "1 cup water\n2 tbsp pure maple syrup"
    },
    {
      "id": 170781,
      "primary_message": "Core and roughly chop pears; add to the blender. ",
      "secondary_message": null
    },
    {
      "id": 170782,
      "primary_message": "Juice lime into the blender. ",
      "secondary_message": null
    },
    {
      "id": 170783,
      "primary_message": "Pick mint leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 170784,
      "primary_message": "Peel the bananas, break into chunks and add to the blender along with the spinach.",
      "secondary_message": null
    },
    {
      "id": 170785,
      "primary_message": "Add 8 ice cubes, edamame, and mango to the blender. Blend on high speed for several minutes until smooth. ",
      "secondary_message": "1 ½ cups edamame\n1 cup frozen mangoes"
    },
    {
      "id": 170786,
      "primary_message": "Pour the smoothie into glasses and enjoy! ",
      "secondary_message": null
    }
  ],
