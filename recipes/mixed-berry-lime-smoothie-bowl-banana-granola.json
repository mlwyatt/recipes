        "instructions": [
          {
            "id": 283320,
            "primary_message": "This recipe will make about 6 cups of smoothie. Work in batches to best fit your blender.",
            "secondary_message": null
          },
          {
            "id": 283321,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 bananas\n1 lime\n1 (6 oz) pkg blackberries"
          },
          {
            "id": 283322,
            "primary_message": "Peel and thinly slice bananas; set aside.",
            "secondary_message": null
          },
          {
            "id": 283323,
            "primary_message": "Zest and juice lime into a blender.",
            "secondary_message": null
          },
          {
            "id": 283324,
            "primary_message": "Add frozen mixed berries, yogurt, milk, honey, and cinnamon to the blender.",
            "secondary_message": "4 cup frozen mixed berries\n2 cups plain Greek yogurt\n8 fl oz (1 cup) whole milk\n¼ cup honey\n½ tsp cinnamon, ground"
          },
          {
            "id": 283325,
            "primary_message": "Blend on high speed until smooth, 1-2 minutes.",
            "secondary_message": null
          },
          {
            "id": 283326,
            "primary_message": "To serve, divide smoothie between bowls and top with banana, blackberries, and granola. Enjoy!",
            "secondary_message": "1 ⅓ cup granola"
          }
        ],
