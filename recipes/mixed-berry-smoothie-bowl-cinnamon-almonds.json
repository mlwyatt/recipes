        "instructions": [
          {
            "id": 175036,
            "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
            "secondary_message": null
          },
          {
            "id": 175037,
            "primary_message": "Peel the bananas. Break into chunks and add to blender.",
            "secondary_message": "2 bananas"
          },
          {
            "id": 175038,
            "primary_message": "Add almond milk, raspberries, blueberries, almond butter, and cinnamon to the blender. ",
            "secondary_message": "16 fl oz (2 cups) almond milk, unsweetened\n2 cup frozen raspberries\n2 cup frozen blueberries\n¼ cup natural almond butter\n1 tsp cinnamon"
          },
          {
            "id": 175039,
            "primary_message": "Blend on high speed for several minutes until smooth. ",
            "secondary_message": null
          },
          {
            "id": 175040,
            "primary_message": "Divide the smoothie between bowls and top with additional raspberries, blueberries, and almonds. ",
            "secondary_message": "½ cup frozen raspberries\n½ cup frozen blueberries\n½ cup almonds, sliced"
          }
        ],
