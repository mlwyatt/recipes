        "instructions": [
          {
            "id": 430600,
            "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes, then fluff with a fork.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
          },
          {
            "id": 430601,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 medium carrots\n2 red bell peppers\n2 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 430602,
            "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 430603,
            "primary_message": "Trim, seed, and thinly slice bell peppers. Add to the bowl with the carrot.",
            "secondary_message": null
          },
          {
            "id": 430604,
            "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl.",
            "secondary_message": "1 medium red onion\n4 cloves garlic"
          },
          {
            "id": 430605,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 430606,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the veggies and spices; cook, stirring occasionally, until the veggies start to soften, about 5 minutes. (Reserve bowl for the next step.)",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 tbsp garam masala\n1 tsp salt\n¼ tsp cinnamon, ground\n¼ tsp cayenne pepper"
          },
          {
            "id": 430607,
            "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Place in the reserved bowl.",
            "secondary_message": null
          },
          {
            "id": 430608,
            "primary_message": "Roughly chop apricots and add to the bowl with the zucchini.",
            "secondary_message": "16 dried apricots"
          },
          {
            "id": 430609,
            "primary_message": "Drain and rinse chickpeas in a colander.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 430610,
            "primary_message": "Once the veggies start to soften, add zucchini, apricots, chickpeas, tomatoes, broth, tomato paste, and sugar to the skillet. Stir to combine the curry and bring to a boil over high heat. ",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n16 fl oz (2 cups) chicken or vegetable broth\n4 tbsp tomato paste\n4 tsp brown sugar"
          },
          {
            "id": 430611,
            "primary_message": "Once boiling, reduce heat to medium-low, and cook, stirring occasionally, until veggies and chickpeas are tender, 10-15 minutes. ",
            "secondary_message": null
          },
          {
            "id": 430612,
            "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
            "secondary_message": null
          },
          {
            "id": 430613,
            "primary_message": "When the curry is done, remove from heat, add half of the parsley, and stir to combine. (Reserve remaining parsley for serving.)",
            "secondary_message": null
          },
          {
            "id": 430614,
            "primary_message": "To serve, divide couscous and curry between plates or bowls. Top with reserved parsley and pine nuts. Enjoy!",
            "secondary_message": "¼ cup pine nuts"
          }
        ],
