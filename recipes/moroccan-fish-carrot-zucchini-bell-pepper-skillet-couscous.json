  "instructions": [
    {
      "id": 169821,
      "primary_message": "In a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes. Uncover couscous and fluff with a fork.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n2 cups whole wheat couscous"
    },
    {
      "id": 169822,
      "primary_message": "Meanwhile, preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 169823,
      "primary_message": "Pat the fish dry with paper towels and place on a plate. Season with salt and pepper on both sides. ",
      "secondary_message": "1 ½ lb tilapia fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 169824,
      "primary_message": "Sprinkle flour over both sides of each fillet and press gently to adhere.",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 169825,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fish to the skillet and cook until opaque and cooked through, about 3 minutes per side. Remove to a plate and cover with foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 169826,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 medium carrots\n2 medium zucchini squash\n1 small bunch cilantro\n1 lemon"
    },
    {
      "id": 169827,
      "primary_message": "Seed and slice bell peppers into thin strips. Peel, halve, and thinly slice onion. Peel and thinly slice garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 169828,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 169829,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add the bell pepper, onion, and garlic; cook, stirring occasionally, until softened, 5-7 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 169830,
      "primary_message": "Meanwhile, peel and thinly slice carrots. Trim and thinly slice zucchini. Add both to the skillet along with the spices. Cook, stirring constantly, until fragrant, about 1 minute. ",
      "secondary_message": "1 tsp paprika\n1 tsp cumin\n1 tsp salt\n½ tsp chili powder\n½ tsp turmeric\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 169831,
      "primary_message": "Stir in the tomatoes, broth, tomato paste, and sugar. Increase temperature to high and bring to a boil; then reduce heat to medium and let simmer, stirring occasionally, until slightly thickened, 3-4 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth\n4 tbsp tomato paste\n1 tsp brown sugar"
    },
    {
      "id": 169832,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add half of the cilantro to the skillet (reserve the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 169833,
      "primary_message": "Place fish fillets in the skillet over the vegetables, spooning a thin layer of sauce over the top to cover. Cover with a lid and let simmer until veggies are soft and fish is warmed through, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 169834,
      "primary_message": "Cut the lemon into wedges.",
      "secondary_message": null
    },
    {
      "id": 169835,
      "primary_message": "To serve, divide couscous and vegetable-fish sauté between plates or bowls. Garnish with cilantro and lemon wedges. Enjoy!",
      "secondary_message": null
    }
  ],
