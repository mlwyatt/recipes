  "instructions": [
    {
      "id": 15998,
      "primary_message": "Wash zucchini and tomatoes. Halve zucchini lengthwise, then slice crosswise into half rounds. Medium dice tomatoes. Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "2 medium zucchini squash\r\n4 tomatoes\r\n1 medium yellow onion\r\n2 cloves garlic"
    },
    {
      "id": 15999,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 16000,
      "primary_message": "In a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 ⅓ cups whole wheat couscous"
    },
    {
      "id": 16001,
      "primary_message": "Coat bottom of pan with oil. Add chicken and cook until lightly browned but not cooked through, 1-2 minutes per side. Transfer to a plate.",
      "secondary_message": "2 tbsp virgin coconut oil\n2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 16002,
      "primary_message": "Return pan to stove and add more oil. Add onion, garlic, and zucchini. Stirring frequently, cook until vegetables begin to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 16003,
      "primary_message": "Return chicken to pan. Add tomatoes, honey, cinnamon, cumin, salt, and pepper. Stir to combine and bring to a boil. Reduce heat, cover, and cook until chicken is cooked through and zucchini is tender, 8-10 minutes.",
      "secondary_message": "2 tsp honey\r\n½ tsp cinnamon\r\n½ tsp cumin\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 16004,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Add ½ to pan (save the rest for garnishing) while the ingredients cook.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 16005,
      "primary_message": "Uncover couscous and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 16006,
      "primary_message": "To serve, place couscous on a plate, top with chicken and sauce, and garnish with remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
