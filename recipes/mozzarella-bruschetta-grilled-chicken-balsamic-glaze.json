        "instructions": [
          {
            "id": 106528,
            "primary_message": "Place a small saucepan on medium-high heat; add balsamic vinegar and brown sugar; stir until sugar is dissolved. Cook until reduced by half, or until thick enough to coat the back of a spoon, 10-15 minutes. Once done, remove from heat.",
            "secondary_message": "½ cup balsamic vinegar\n1 tbsp brown sugar"
          },
          {
            "id": 106529,
            "primary_message": "Holding a knife parallel to the cutting board, cut the chicken breasts in half horizontally, forming thin fillets.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 106530,
            "primary_message": "Mix the spices together in a small bowl. Rub chicken fillets with the spice mixture on both sides.",
            "secondary_message": "½ tsp oregano\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 106531,
            "primary_message": "Heat a grill pan or skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 106532,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 small pkgs fresh basil\n8 tomatoes"
          },
          {
            "id": 106533,
            "primary_message": "When hot, coat grill pan with oil.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 106534,
            "primary_message": "Place the chicken fillets in the grill pan; cook until they are golden brown and cooked through, 5-6 minutes per side. Once done, remove from heat.",
            "secondary_message": null
          },
          {
            "id": 106535,
            "primary_message": "Preheat oven to broil and position rack under the broiler. Line a baking sheet with foil for easy clean-up (optional).",
            "secondary_message": null
          },
          {
            "id": 106536,
            "primary_message": "Small dice the tomatoes and transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 106537,
            "primary_message": "Peel and mince the shallots and garlic and add to the bowl with the tomatoes.",
            "secondary_message": "2 shallots\n4 cloves garlic"
          },
          {
            "id": 106538,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the tomatoes. Add the oil, salt, and pepper and stir to combine. Set aside.",
            "secondary_message": "4 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 106539,
            "primary_message": "Slice the fresh mozzarella.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 106540,
            "primary_message": "Place cooked chicken on the baking sheet pan. Top with sliced mozzarella. Place in the oven and cook for 2-3 minutes, until the cheese begins to melt.",
            "secondary_message": null
          },
          {
            "id": 106541,
            "primary_message": "To serve, divide the chicken between plates, top with tomato mixture, and a drizzle of balsamic glaze. Enjoy!",
            "secondary_message": null
          }
        ],
