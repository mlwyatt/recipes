        "instructions": [
          {
            "id": 177267,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 177268,
            "primary_message": "Place corn in a medium bowl and cover with hot water from the tap. ",
            "secondary_message": "2 cups frozen corn"
          },
          {
            "id": 177269,
            "primary_message": "Peel and mince garlic; transfer to a small bowl. Add oil and stir to combine.",
            "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil"
          },
          {
            "id": 177270,
            "primary_message": "Using a strainer or colander, drain the corn and transfer to a clean towel; pat dry.",
            "secondary_message": null
          },
          {
            "id": 177271,
            "primary_message": "Grate cheese.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 177272,
            "primary_message": "Divide the flatbreads between two baking sheets and spread with the garlic oil.",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 177273,
            "primary_message": "Layer cheese, corn, and prosciutto onto the flatbreads.",
            "secondary_message": "12 slices prosciutto"
          },
          {
            "id": 177274,
            "primary_message": "Place pizzas in the oven and bake, until the cheese is golden and melted, about 7 minutes.",
            "secondary_message": null
          },
          {
            "id": 177275,
            "primary_message": "Meanwhile, wash and dry the basil and arugula. (Skip the arugula if it came pre-washed.) Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": "1 small pkg fresh basil\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 177276,
            "primary_message": "When pizzas are done top with arugula, basil, and crushed red pepper.",
            "secondary_message": "½ tsp crushed red pepper"
          },
          {
            "id": 177277,
            "primary_message": "To serve, cut pizzas into wedges and divide between plates. Enjoy!",
            "secondary_message": null
          }
        ],
