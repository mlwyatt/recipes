        "instructions": [
          {
            "id": 136606,
            "primary_message": "Wash and thinly slice the tomatoes. Set half aside for garnish.",
            "secondary_message": "4 tomatoes"
          },
          {
            "id": 136607,
            "primary_message": "Wash and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": "1 small pkg fresh basil"
          },
          {
            "id": 136608,
            "primary_message": "Coarsely grate cheese.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 136609,
            "primary_message": "Preheat a nonstick skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 136610,
            "primary_message": "In a medium bowl, whisk together eggs, salt, and pepper.",
            "secondary_message": "12 eggs\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 136611,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
            "secondary_message": "1 tbsp butter, unsalted"
          },
          {
            "id": 136612,
            "primary_message": "Add ½ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing the uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
            "secondary_message": null
          },
          {
            "id": 136613,
            "primary_message": "Sprinkle ½ of the cheese over one side of the omelet; layer ½ of the reserved tomato slices and ½ the basil on top. Fold the omelet in half and cook until cheese is melted, about 1 minute.",
            "secondary_message": null
          },
          {
            "id": 136614,
            "primary_message": "Add more butter to the skillet and repeat with remaining egg mixture, cheese, tomato, and basil.",
            "secondary_message": "1 tbsp butter, unsalted"
          },
          {
            "id": 136615,
            "primary_message": "To serve, cut omelets in half and divide between plates; enjoy with remaining tomato slices on the side!",
            "secondary_message": null
          }
        ],
