        "instructions": [
          {
            "id": 233576,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 233577,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 233578,
            "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms; transfer to a medium bowl and set aside.",
            "secondary_message": "1 lb cremini mushrooms"
          },
          {
            "id": 233579,
            "primary_message": "Pat the pork chops dry with paper towels and place on a cutting board; thinly slice crosswise into bite-sized strips and season with salt and pepper.",
            "secondary_message": "4 pork chops, boneless\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 233580,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 233581,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork strips and stir-fry until browned and cooked through, 4-5 minutes.",
            "secondary_message": "4 tsp toasted sesame oil"
          },
          {
            "id": 233582,
            "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with soy sauce, cornstarch, peanut butter, chili-garlic sauce, oil, vinegar, honey, and spices. Whisk to combine the sauce and set aside.",
            "secondary_message": "4 cloves garlic\n¼ cup soy sauce\n2 tbsp cornstarch\n4 tsp natural peanut butter\n2 tsp chili-garlic sauce\n2 tsp toasted sesame oil\n2 tsp rice vinegar\n1 tsp honey\n¼ tsp cinnamon, ground\n⅛ tsp clove, ground\n⅛ tsp black pepper"
          },
          {
            "id": 233583,
            "primary_message": "When the pork is done, use a slotted spoon to transfer the strips to a plate and set aside.",
            "secondary_message": null
          },
          {
            "id": 233584,
            "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until they start to soften, about 3 minutes.",
            "secondary_message": "4 tsp toasted sesame oil"
          },
          {
            "id": 233585,
            "primary_message": "Add broccoli slaw and sauce to the skillet; continue to cook, stirring occasionally, until the veggies are tender-crisp and sauce thickens, 2-3 minutes.",
            "secondary_message": "2 (12 oz) pkg broccoli slaw"
          },
          {
            "id": 233586,
            "primary_message": "Return pork to the skillet, along with any accumulated juices; stir to combine and cook until heated through, about 1 minute. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 233587,
            "primary_message": "To serve, divide rice and pork stir-fry between plates. Enjoy!",
            "secondary_message": null
          }
        ],
