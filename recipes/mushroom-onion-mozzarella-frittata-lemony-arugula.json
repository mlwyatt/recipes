        "instructions": [
          {
            "id": 149147,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "1 lb cremini mushrooms\n1 lemon\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 149148,
            "primary_message": "Peel and small dice onion; peel and mince garlic. Transfer both to a medium bowl.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 149149,
            "primary_message": "Thinly slice the mushrooms.",
            "secondary_message": null
          },
          {
            "id": 149150,
            "primary_message": "Preheat a large ovenproof skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 149151,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 149152,
            "primary_message": "Add onion and garlic to the skillet and cook, stirring occasionally, until softened, about 4 minutes. Reserve bowl for later.",
            "secondary_message": null
          },
          {
            "id": 149153,
            "primary_message": "Increase heat to medium-high and add mushrooms; season with salt and thyme. Cook, stirring occasionally, until mushrooms are softened and liquid has evaporated, about 8-10 minutes.",
            "secondary_message": "½ tsp salt\n½ tsp thyme"
          },
          {
            "id": 149154,
            "primary_message": "Meanwhile, roughly grate the cheese.",
            "secondary_message": "1 (8 oz) block mozzarella cheese"
          },
          {
            "id": 149155,
            "primary_message": "Combine eggs, half the cheese, salt, and pepper in the reserved bowl; whisk to combine.",
            "secondary_message": "12 eggs\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 149156,
            "primary_message": "Preheat oven to broil on high.",
            "secondary_message": null
          },
          {
            "id": 149157,
            "primary_message": "Spread the mushrooms evenly in the skillet. Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
            "secondary_message": null
          },
          {
            "id": 149158,
            "primary_message": "Sprinkle remaining cheese over the frittata. Place skillet in the oven until the top is set, 2-3 minutes.",
            "secondary_message": null
          },
          {
            "id": 149159,
            "primary_message": "Meanwhile, juice the lemon into a medium salad bowl. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing. Add arugula and toss to combine the salad.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 149160,
            "primary_message": "To serve, cut frittata into wedges and place on plates; top with arugula and enjoy!",
            "secondary_message": null
          }
        ],
