  "instructions": [
    {
      "id": 218258,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 218259,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 caps portobello mushrooms\n1 avocado\n2 tomatoes\n2 medium carrots\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 218260,
      "primary_message": "Place oil, soy sauce, vinegar, maple syrup, paprika, and pepper in a small bowl. Whisk to combine the marinade. ",
      "secondary_message": "¼ cup extra virgin olive oil\n4 tsp soy sauce\n4 tsp balsamic vinegar\n2 tsp pure maple syrup\n½ tsp paprika\n⅛ tsp black pepper"
    },
    {
      "id": 218261,
      "primary_message": "Remove mushroom stems and carefully scrape out the gills. Transfer to a baking sheet pan, drizzle with marinade, and turn to coat. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 218262,
      "primary_message": "Place mushrooms in the oven and roast until tender, 10-12 minutes. Remove from oven and set aside. ",
      "secondary_message": null
    },
    {
      "id": 218263,
      "primary_message": "Meanwhile, halve and pit the avocado. Slice thinly while still in skin, then scoop out into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 218264,
      "primary_message": "Add nutritional yeast, mayo, and spices to the bowl with the avocado; mash with a potato masher or fork until smooth. Set avocado mayo aside.",
      "secondary_message": "½ cup nutritional yeast flakes\n⅓ cup mayonnaise\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 218265,
      "primary_message": "Slice tomatoes. Peel, trim, and coarsely grate the carrots. Transfer both to a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 218266,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 218267,
      "primary_message": "Slice mushrooms into strips.",
      "secondary_message": null
    },
    {
      "id": 218268,
      "primary_message": "Place bread slices on a flat surface and spread evenly with avocado mayo. Top half the slices with mushrooms, tomato, carrot, and arugula. Cover sandwiches with remaining bread slices.",
      "secondary_message": null
    },
    {
      "id": 218269,
      "primary_message": "To serve, divide sandwiches between plates and enjoy! ",
      "secondary_message": null
    }
  ],
