        "instructions": [
          {
            "id": 138897,
            "primary_message": "Peel and thinly slice the shallots into rings. ",
            "secondary_message": "2 shallots"
          },
          {
            "id": 138898,
            "primary_message": "Wash and slice mushrooms. ",
            "secondary_message": "1 lb white mushrooms"
          },
          {
            "id": 138899,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 138900,
            "primary_message": "Peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 138901,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the mushrooms and shallot; cook, stirring occasionally, until mushrooms begin to soften, about 4 minutes. ",
            "secondary_message": "¼ cup butter, unsalted"
          },
          {
            "id": 138902,
            "primary_message": "Preheat oven to broil on high; position rack under the broiler. ",
            "secondary_message": null
          },
          {
            "id": 138903,
            "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
            "secondary_message": "½ small pkg fresh thyme"
          },
          {
            "id": 138904,
            "primary_message": "Add garlic, vinegar, salt, and pepper to the skillet and cook, stirring often, until fragrant, 1-2 minutes. Remove from the heat.",
            "secondary_message": "2 tsp balsamic vinegar\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 138905,
            "primary_message": "Place bread slices on top of a large baking sheet pan. Place in the oven and broil, flipping halfway through, 2-3 minutes, or until toasted. Remove from the oven. ",
            "secondary_message": "8 slices whole grain bread"
          },
          {
            "id": 138906,
            "primary_message": "Spread goat cheese over toast and top with warm mushrooms.",
            "secondary_message": "2 (4 oz) logs goat cheese"
          },
          {
            "id": 138907,
            "primary_message": "To serve, divide toasts between dishes and garnish with thyme. Enjoy!",
            "secondary_message": null
          }
        ],
