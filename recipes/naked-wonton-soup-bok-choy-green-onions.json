  "instructions": [
    {
      "id": 167765,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n8 baby bok choy"
    },
    {
      "id": 167766,
      "primary_message": "Pour broth, oil, and sauces into a large pot and heat over medium-high. ",
      "secondary_message": "56 fl oz (7 cups) chicken or vegetable broth\n4 tsp toasted sesame oil\n2 tbsp soy sauce\n2 tsp chili-garlic sauce"
    },
    {
      "id": 167767,
      "primary_message": "Peel and mince garlic. Peel and mince or grate ginger. Add half of each to the pot and transfer the rest to a medium bowl. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 167768,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Transfer half to the medium bowl and set the other half aside in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 167769,
      "primary_message": "Trim and finely chop green onions. Add half to the medium bowl and half to the small bowl.",
      "secondary_message": null
    },
    {
      "id": 167770,
      "primary_message": "Add pork, eggs, sauces, and pepper to the medium bowl and mix with your hands until well combined. ",
      "secondary_message": "1 ½ lb lean ground pork\n2 eggs\n2 tsp soy sauce\n½ tsp Worcestershire sauce\n½ tsp black pepper"
    },
    {
      "id": 167771,
      "primary_message": "Using a tablespoon measure, form the pork mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 167772,
      "primary_message": "Once the broth begins to boil, turn down to a simmer. Carefully add the meatballs (a few at a time, to avoid splashing) to the pot. Simmer until pork is cooked through, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 167773,
      "primary_message": "Meanwhile, trim bok choy and slice in half lengthwise. Add to the soup along with the remaining cilantro and green onion.",
      "secondary_message": null
    },
    {
      "id": 167774,
      "primary_message": "Return soup to a simmer and cook until bok choy is tender, 4-5 minutes more. ",
      "secondary_message": null
    },
    {
      "id": 167775,
      "primary_message": "To serve, divide soup between bowls and enjoy! ",
      "secondary_message": null
    }
  ],
