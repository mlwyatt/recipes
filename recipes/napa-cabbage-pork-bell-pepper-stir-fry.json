  "instructions": [
    {
      "id": 28959,
      "primary_message": "In a small bowl, combine and whisk together water, soy sauce, rice vinegar, sesame oil, and cornstarch.",
      "secondary_message": "2 tbsp water\n4 tbsp soy sauce\n2 tbsp rice vinegar\n2 tsp toasted sesame oil\n2 tsp cornstarch"
    },
    {
      "id": 28960,
      "primary_message": "Thinly slice the pork chops crosswise into strips; transfer to a medium bowl.",
      "secondary_message": "4 pork chops, boneless"
    },
    {
      "id": 28961,
      "primary_message": "Pour ½ of the sauce over the pork; toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 28962,
      "primary_message": "Wash and dry the cutting board, knife, and fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n2 red bell peppers\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 28963,
      "primary_message": "Quarter the cabbage lengthwise (into wedges) and cut out the core; chop crosswise into bite-sized pieces (about 1-inch-wide). Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 28964,
      "primary_message": "Cut the bell peppers into 4 wedges lengthwise, then remove and discard the seeds. Thinly slice into strips lengthwise and add to the bowl of cabbage.",
      "secondary_message": ""
    },
    {
      "id": 28965,
      "primary_message": "Trim and discard the ends of the green onions; chop the onions into ¼-inch pieces. Separate the white parts from the greens and transfer to two small bowls.",
      "secondary_message": null
    },
    {
      "id": 28966,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 28967,
      "primary_message": "While the skillet heats up, peel and mince or grate the ginger; add to the white parts of the green onions.",
      "secondary_message": null
    },
    {
      "id": 28968,
      "primary_message": "Peel and mince the garlic; add to the onions and ginger.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 28969,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 28970,
      "primary_message": "Place the pork strips in the skillet; cook until browned, 1 to 2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 28971,
      "primary_message": "Once the pork has been transferred, add more coconut oil to the skillet.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 28972,
      "primary_message": "Add the ginger, garlic, and white parts of green onions; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 28973,
      "primary_message": "Add the bell peppers and cabbage to the skillet. Cook, stirring regularly, until the vegetables are tender-crisp and lightly browned, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 28974,
      "primary_message": "Add the pork (along with any juices), remaining sauce, and ½ of the remaining green onions (save the rest for garnishing) to the skillet; stir to combine and cook until the sauce is slightly thickened, 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 28975,
      "primary_message": "Divide the stir fry between bowls and sprinkle with the remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
