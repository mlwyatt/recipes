        "instructions": [
          {
            "id": 31309,
            "primary_message": "Heat the oven to 425°F and position rack in the center. Place a baking sheet in the oven to warm up.",
            "secondary_message": null
          },
          {
            "id": 31310,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 small bunches asparagus\n1 lb new potatoes\n1 small pkg chives\n1 lemon"
          },
          {
            "id": 31311,
            "primary_message": "Cut the potatoes into ¼-inch-thick slices. Remove the baking sheet from the oven and add the potatoes.",
            "secondary_message": ""
          },
          {
            "id": 31312,
            "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears into 2-inch pieces. Add to the potatoes.",
            "secondary_message": null
          },
          {
            "id": 31313,
            "primary_message": "Drizzle the potatoes and asparagus with olive oil and season with salt and pepper; toss to coat, then spread out in an even layer.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 31314,
            "primary_message": "Place the sheet in the oven and roast until the vegetables are tender, 12 to 15 minutes. Once done, remove from the oven.",
            "secondary_message": ""
          },
          {
            "id": 31315,
            "primary_message": "Preheat a grill pan or skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 31316,
            "primary_message": "Place the steak on a plate and season with salt and pepper.",
            "secondary_message": "1 ½ lb ribeye steak\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 31317,
            "primary_message": "Juice the lemon into a large bowl, then add olive oil, Dijon, salt, and pepper; whisk together. Set aside.",
            "secondary_message": "1 lemon\n2 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 31318,
            "primary_message": "Coat the grill pan or skillet with coconut oil.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 31319,
            "primary_message": "Place the steak in the grill pan or skillet; cook until desired doneness, 2 to 5 minutes per side. Once done, transfer to a plate and loosely cover with foil.",
            "secondary_message": null
          },
          {
            "id": 31320,
            "primary_message": "Chop the chives into ¼-inch pieces; transfer to the bowl with the dressing.",
            "secondary_message": ""
          },
          {
            "id": 31321,
            "primary_message": "Transfer the roasted vegetables to the bowl with the dressing and toss to coat.",
            "secondary_message": null
          },
          {
            "id": 31322,
            "primary_message": "To serve, divide the steak and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
