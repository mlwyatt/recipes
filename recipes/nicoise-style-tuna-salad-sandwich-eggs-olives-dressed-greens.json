        "instructions": [
          {
            "id": 359478,
            "primary_message": "Wash and dry lettuce, then separate the leaves; set aside one leaf per sandwich and chop or tear remaining leaves into bite-sized pieces. Place in a large bowl.",
            "secondary_message": "2 heads butter (Boston) lettuce"
          },
          {
            "id": 359479,
            "primary_message": "Add broccoli slaw to the bowl with the lettuce, toss to combine the salad, and set aside.",
            "secondary_message": "1 (12 oz) pkg broccoli slaw"
          },
          {
            "id": 359480,
            "primary_message": "Drain tuna, place in a medium bowl, and flake with a fork.",
            "secondary_message": "2 (6 oz) cans chunk light tuna in water"
          },
          {
            "id": 359481,
            "primary_message": "Roughly chop eggs and add to the bowl with the tuna.",
            "secondary_message": "4 hard-cooked eggs, peeled"
          },
          {
            "id": 359482,
            "primary_message": "Mince olives and capers; add to the bowl.",
            "secondary_message": "⅔ cup Kalamata olives, pitted\n2 tbsp capers"
          },
          {
            "id": 359483,
            "primary_message": "Add pesto and mayo to the bowl, then stir to combine the sandwich filling.",
            "secondary_message": "⅔ cup sun-dried tomato pesto\n2 tbsp mayonnaise"
          },
          {
            "id": 359484,
            "primary_message": "To assemble sandwiches, layer reserved lettuce leaves and filling on the bottom half of each roll; close with the top half.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 359485,
            "primary_message": "To serve, divide sandwiches and salad between plates. Drizzle salad with vinaigrette and enjoy!",
            "secondary_message": "¼ cup French vinaigrette"
          }
        ],
