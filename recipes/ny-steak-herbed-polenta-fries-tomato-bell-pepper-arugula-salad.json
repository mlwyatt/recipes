  "instructions": [
    {
      "id": 361469,
      "primary_message": "Preheat oven to 475°F.",
      "secondary_message": null
    },
    {
      "id": 361470,
      "primary_message": "Halve each tube of polenta crosswise, then cut each half lengthwise into ½-inch thick \"fries.\" Transfer to a large baking sheet pan, spreading the fries out in a single layer.",
      "secondary_message": "2 (18 oz) tubes polenta, pre-cooked"
    },
    {
      "id": 361471,
      "primary_message": "Drizzle fries with oil and season with spices; carefully toss to coat, then spread out on the baking sheet so that none of the fries are touching. ",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 361472,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping fries halfway through, until golden brown and slightly crisp on the outside, 30-35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 361473,
      "primary_message": "When the fries have about 12 minutes left of cooking, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 361474,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 361475,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 361476,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 pint grape tomatoes\n1 yellow bell pepper\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 361477,
      "primary_message": "Halve tomatoes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 361478,
      "primary_message": "Trim, seed, and halve bell pepper crosswise, then slice into thin strips; add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 361479,
      "primary_message": "Add arugula to the bowl, along with the dressing, and toss to combine the salad; set aside.",
      "secondary_message": "¼ cup Italian salad dressing"
    },
    {
      "id": 361480,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 361481,
      "primary_message": "To serve, divide steak, polenta fries, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
