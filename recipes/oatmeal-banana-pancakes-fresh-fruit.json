  "instructions": [
    {
      "id": 105267,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (16 oz) pkg strawberries\n2 kiwifruit\n½ (6 oz) pkg blueberries"
    },
    {
      "id": 105268,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 105269,
      "primary_message": "Add the bananas, oats, milk, and cinnamon to the blender. Purée for 30 seconds, until smooth.",
      "secondary_message": "4 bananas\n2 ⅔ cup oats, quick cooking\n8 fl oz (1 cup) whole milk\n½ tsp cinnamon"
    },
    {
      "id": 105270,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 105271,
      "primary_message": "Using a ¼-cup measure, pour the batter into the skillet. Cook for 1-2 minutes on each side, until browned. Work in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 105272,
      "primary_message": "Slice the strawberries in half. Peel and slice the kiwis.",
      "secondary_message": null
    },
    {
      "id": 105273,
      "primary_message": "Divide the pancakes, strawberries, kiwis, and blueberries between plates. Top with maple syrup and enjoy!",
      "secondary_message": "¼ cup pure maple syrup"
    }
  ],
