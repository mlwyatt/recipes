        "instructions": [
          {
            "id": 437493,
            "primary_message": "Place water and salt in a medium saucepan, cover, and bring to a boil over high heat.",
            "secondary_message": "28 fl oz (3 ½ cups) water\n⅛ tsp salt"
          },
          {
            "id": 437494,
            "primary_message": "Once boiling, stir in oats, honey, and nutmeg. Cover and let simmer on low until oats reach desired consistency, 3-5 minutes.",
            "secondary_message": "2 cup oats, quick cooking\n2 tsp honey\n½ tsp nutmeg, ground"
          },
          {
            "id": 437495,
            "primary_message": "Meanwhile, place yogurt and additional honey in a small bowl. Stir to combine and set aside.",
            "secondary_message": "1 ⅓ cups plain Greek yogurt\n2 tbsp honey"
          },
          {
            "id": 437496,
            "primary_message": "Place cherries in a colander and rinse under hot water (from the tap) to thaw. Roughly chop.",
            "secondary_message": "2 cup frozen cherries"
          },
          {
            "id": 437497,
            "primary_message": "When the oatmeal is done, add cherries to the pan and stir to combine. Continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 437498,
            "primary_message": "To serve, divide oatmeal between bowls and top with honey yogurt. Enjoy!",
            "secondary_message": null
          }
        ],
