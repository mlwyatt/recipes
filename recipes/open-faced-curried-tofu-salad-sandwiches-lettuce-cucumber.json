  "instructions": [
    {
      "id": 262770,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 262771,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 red bell pepper\n1 English cucumber\n1 head butter (Boston) lettuce"
    },
    {
      "id": 262772,
      "primary_message": "Place mayo, nutritional yeast, Dijon, vinegar, and spices in a medium bowl; stir to combine the creamy dressing.",
      "secondary_message": "½ cup vegan mayonnaise\n¼ cup nutritional yeast flakes\n1 tsp Dijon mustard\n1 tsp rice vinegar\n4 tsp curry powder\n1 ½ tsp salt\n1 tsp onion powder\n½ tsp turmeric, ground\n½ tsp black pepper"
    },
    {
      "id": 262773,
      "primary_message": "Crumble tofu with your fingers into the bowl with the dressing; using a fork, mash to combine the tofu mixture.",
      "secondary_message": null
    },
    {
      "id": 262774,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the tofu mixture.",
      "secondary_message": null
    },
    {
      "id": 262775,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 262776,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl. Stir to combine the tofu salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 262777,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 262778,
      "primary_message": "Peel and mince garlic; place in a small bowl along with oil and salt. Stir to combine the garlic oil.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 262779,
      "primary_message": "Arrange bread on the baking sheet and drizzle with garlic oil. Place in the oven and broil until golden brown and toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 262780,
      "primary_message": "Meanwhile, trim and slice cucumber crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 262781,
      "primary_message": "Separate lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 262782,
      "primary_message": "To serve, divide toast between plates; top with lettuce, tofu salad, and cucumber slices. Season cucumber with salt and pepper. Enjoy!",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    }
  ],
