  "instructions": [
    {
      "id": 260621,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 260622,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n4 tomatoes\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 260623,
      "primary_message": "Place mayo, nutritional yeast, and spices in a medium bowl; whisk to combine the creamy dressing.",
      "secondary_message": "½ cup vegan mayonnaise\n¼ cup nutritional yeast flakes\n1 tsp garlic powder\n1 tsp onion powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 260624,
      "primary_message": "Finely chop pine nuts and add to the bowl with the creamy dressing.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 260625,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 260626,
      "primary_message": "Crumble tofu with your fingers into the bowl; using a fork, mash to combine the tofu salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 260627,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 260628,
      "primary_message": "Slice tomatoes into rounds.",
      "secondary_message": null
    },
    {
      "id": 260629,
      "primary_message": "Arrange bread on a large baking sheet. Place in the oven and broil until bread is golden brown and toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 260630,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, salt, and pepper in another medium bowl. Whisk to combine the vinaigrette.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n⅛ tsp brown sugar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 260631,
      "primary_message": "Add mixed greens to the bowl with the vinaigrette and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 260632,
      "primary_message": "To serve, divide toast between plates; top with dressed greens, tofu salad, and tomato slices. Season tomatoes with salt and pepper. Enjoy!",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    }
  ],
