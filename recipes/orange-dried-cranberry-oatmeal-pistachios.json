        "instructions": [
          {
            "id": 131064,
            "primary_message": "Wash and juice oranges into a medium saucepan.",
            "secondary_message": "2 oranges"
          },
          {
            "id": 131065,
            "primary_message": "Add salt and water to the saucepan, cover, and bring to a boil over high heat. Once boiling, stir in oats, cranberries, cinnamon, and maple syrup; reduce heat to medium-low. Cover and let simmer for 3-5 minutes or until oats reach desired consistency. ",
            "secondary_message": "⅛ tsp salt\n3 ½ cup water\n2 cup oats, quick cooking\n1 cup dried cranberries\n1 tsp cinnamon\n4 tsp pure maple syrup"
          },
          {
            "id": 131066,
            "primary_message": "Roughly chop the pistachios.",
            "secondary_message": "½ cup pistachios, unsalted"
          },
          {
            "id": 131067,
            "primary_message": "To serve, divide oats between bowls and top with pistachios and milk. Enjoy! ",
            "secondary_message": "8 fl oz (1 cup) whole milk"
          }
        ],
