  "instructions": [
    {
      "id": 20910,
      "primary_message": "Halve oranges. Grate zest from 1 orange into a large bowl, then juice it into the same bowl. Cut other orange into wedges.",
      "secondary_message": "2 oranges"
    },
    {
      "id": 20911,
      "primary_message": "Peel and mince garlic. Add ½ of the garlic (save the rest for the beans), honey, salt, and pepper to bowl and mix.",
      "secondary_message": "4 cloves garlic\r\n2 tbsp honey\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 20912,
      "primary_message": "Preheat broiler and place rack about 6 inches from the top.",
      "secondary_message": ""
    },
    {
      "id": 20913,
      "primary_message": "Wash rosemary and add to bowl with marinade.",
      "secondary_message": "1 small pkg fresh rosemary"
    },
    {
      "id": 20914,
      "primary_message": "Add pork chops to marinade and turn to coat.",
      "secondary_message": "4 pork chops, bone-in"
    },
    {
      "id": 20915,
      "primary_message": "Place orange wedges in marinade.",
      "secondary_message": ""
    },
    {
      "id": 20916,
      "primary_message": "Lightly coat a baking dish with olive oil. Place pork chops and orange wedges in dish, leaving rosemary in the marinade. Spoon ½ of the marinade over top the pork.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 20917,
      "primary_message": "Place dish in the oven and broil until pork is golden on top, 7-9 minutes. Then flip pork and orange wedges, spoon remaining marinade over top pork, and add rosemary sprigs to the dish. Return to oven and broil until pork is cooked through, 7-9 minutes more.",
      "secondary_message": ""
    },
    {
      "id": 20918,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 20919,
      "primary_message": "Wash green beans and trim ends.",
      "secondary_message": "2 lb green beans"
    },
    {
      "id": 20920,
      "primary_message": "Add salt and green beans to boiling water. Cook until bright green and tender-crisp, 2-3 minutes. Drain in a colander and rinse under cold water. Transfer to a medium bowl.",
      "secondary_message": "1 tbsp salt"
    },
    {
      "id": 20921,
      "primary_message": "Add remaining garlic, lemon juice, olive oil, almonds, salt, and pepper to green beans; toss.",
      "secondary_message": "juice of 1 lemon\r\n2 tbsp extra virgin olive oil\r\n¼ cup almonds, sliced\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 20922,
      "primary_message": "Serve pork, orange wedges, and green beans on a plate and enjoy!",
      "secondary_message": ""
    }
  ],
