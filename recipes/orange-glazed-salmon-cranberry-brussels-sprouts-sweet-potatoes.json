  "instructions": [
    {
      "id": 83114,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 83115,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 oranges\n2 lb brussels sprouts\n1 lb sweet potato"
    },
    {
      "id": 83116,
      "primary_message": "Grate zest from the oranges. (Reserve oranges for later use.)",
      "secondary_message": null
    },
    {
      "id": 83117,
      "primary_message": "Measure out and roughly chop the cranberries.",
      "secondary_message": "½ cup dried cranberries"
    },
    {
      "id": 83118,
      "primary_message": "In a medium bowl, combine vinegar, honey, olive oil, salt, pepper, cranberries, and half of the orange zest.",
      "secondary_message": "4 tsp balsamic vinegar\n4 tsp honey\n2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 83119,
      "primary_message": "Remove the outer layer of leaves from the brussels sprouts, then trim off and discard the stem ends. Halve the sprouts lengthwise and add to vinegar mixture; toss until well coated.",
      "secondary_message": null
    },
    {
      "id": 83120,
      "primary_message": "Transfer Brussels sprouts to one half of a large baking sheet pan and spread out in an even layer. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 83121,
      "primary_message": "Peel and cut the sweet potatoes into ½-inch cubes; place in the reserved bowl. Toss with olive oil, salt, and pepper. Transfer to the other half of the baking sheet with the Brussels sprouts and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 434453,
      "primary_message": "Place baking sheet in the oven and roast, tossing halfway through, until veggies are tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 83122,
      "primary_message": "Meanwhile, halve the oranges. Juice one of the oranges and slice the other into rings.",
      "secondary_message": null
    },
    {
      "id": 83123,
      "primary_message": "Combine orange juice with remaining zest, honey, salt, and pepper.",
      "secondary_message": "4 tsp honey\n⅛ tsp salt"
    },
    {
      "id": 83124,
      "primary_message": "Line a second sheet pan with aluminum foil. Place the salmon fillets, skin-side down, in the middle of the sheet pan. Drizzle the orange juice mixture over the salmon and top with slices of orange. Place in the oven and bake until salmon is cooked through, 12-14 minutes.",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "id": 83125,
      "primary_message": "To serve, divide salmon and roasted veggies between plates, spoon warm orange sauce over top. Enjoy!",
      "secondary_message": null
    }
  ],
