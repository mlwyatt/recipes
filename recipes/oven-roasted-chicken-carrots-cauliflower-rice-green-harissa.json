        "instructions": [
          {
            "id": 98838,
            "primary_message": "Preheat oven to 450°F and position racks in the upper and lower thirds of the oven.",
            "secondary_message": null
          },
          {
            "id": 98839,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n2 lemons\n2 jalapeño peppers\n1 small bunch cilantro\n2 medium carrots"
          },
          {
            "id": 98840,
            "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stems. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a baking dish.",
            "secondary_message": null
          },
          {
            "id": 98841,
            "primary_message": "In a medium bowl whisk together oil and spices to make a smooth paste. Add half of the spice paste to the baking dish with the cauliflower and stir to combine.",
            "secondary_message": "¼ cup extra virgin olive oil\n2 tsp cumin\n2 tsp coriander\n1 tsp salt"
          },
          {
            "id": 98842,
            "primary_message": "Pat dry the chicken breasts with paper towels and place in the bowl with the remaining spice paste; turn to coat.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 98843,
            "primary_message": "Line a baking sheet with parchment paper and place the chicken on top.",
            "secondary_message": null
          },
          {
            "id": 98844,
            "primary_message": "Grate all of the zest from the lemons; add to a small bowl and set aside. Cut the lemons into wedges and add to the pan with the chicken.",
            "secondary_message": null
          },
          {
            "id": 98845,
            "primary_message": "Place the chicken on the upper rack of the oven and the cauliflower rice on the rack below. Bake until the cauliflower rice has softened and the chicken is golden brown and cooked through, about 20 minutes.",
            "secondary_message": null
          },
          {
            "id": 98846,
            "primary_message": "While the chicken and cauliflower cook, quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely mince and add to the bowl with the lemon zest. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
            "secondary_message": null
          },
          {
            "id": 98847,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and finely mince the leaves. Peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 98848,
            "primary_message": "To make the harissa, add cilantro, garlic, olive oil, and spices to the bowl with the jalapeno and zest; stir to combine.",
            "secondary_message": "⅓ cup extra virgin olive oil\n1 tsp coriander\n1 tsp cumin\n¼ tsp salt"
          },
          {
            "id": 98849,
            "primary_message": "Peel the carrots; then using the peeler, run it along the carrot to make long, noodle-like strips; add carrot strips to a large bowl with 2 tbsp of the harissa; toss to coat.",
            "secondary_message": null
          },
          {
            "id": 98850,
            "primary_message": "When the chicken is done, slice into strips.",
            "secondary_message": null
          },
          {
            "id": 98851,
            "primary_message": "To serve, divide chicken, crisp carrots, and cauliflower rice between plates. Drizzle remaining harissa over the chicken and serve with warm lemon wedges. Enjoy!",
            "secondary_message": null
          }
        ],
