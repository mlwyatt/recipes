  "instructions": [
    {
      "id": 151707,
      "primary_message": "Peel and thinly slice shallots into rings. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 151708,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 151709,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 151710,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the shallots and cook, stirring often, until soft and caramelized, 3-4 minutes.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 151711,
      "primary_message": "Meanwhile, wash and dry the tomatoes; cut in half crosswise.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 151712,
      "primary_message": "Add tomatoes, garlic, and spices to the skillet. Cook, stirring often, until tomatoes begin to soften and juices have thickened, 4-5 minutes.",
      "secondary_message": "½ tsp oregano\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 151713,
      "primary_message": "Toast the bread.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 151714,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 151715,
      "primary_message": "Add basil to the skillet and stir to combine; remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 151716,
      "primary_message": "To serve, divide toast between plates. Spoon warm tomato mixture over the toast and top with feta. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
