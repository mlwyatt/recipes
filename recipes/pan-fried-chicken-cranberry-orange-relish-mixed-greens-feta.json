        "instructions": [
          {
            "id": 415227,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 415228,
            "primary_message": "While the skillet heats up, pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Sprinkle both sides with flour and salt.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n2 tbsp all-purpose flour\n½ tsp salt"
          },
          {
            "id": 415229,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove chicken to a plate. (Reserve skillet with cooking juices for later use.)",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 415230,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "2 oranges\n1 small bunch green onions (scallions)\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 415231,
            "primary_message": "Using a clean cutting board, peel and separate oranges into segments; cut segments crosswise into bite-sized pieces. Place in a small bowl.",
            "secondary_message": null
          },
          {
            "id": 415232,
            "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the orange and set aside.",
            "secondary_message": null
          },
          {
            "id": 415233,
            "primary_message": "When the chicken is done, return skillet (with cooking juices) to medium heat. Add orange, green onion, water, cranberries, coriander, and salt. Cook, stirring occasionally, until orange softens and relish has slightly thickened, 2-3 minutes. Remove from heat.",
            "secondary_message": "½ cup water\n¼ cup dried cranberries\n½ tsp coriander, ground\n½ tsp salt"
          },
          {
            "id": 415234,
            "primary_message": "Meanwhile, place mixed greens, carrots, feta, and vinaigrette in a medium bowl. Gently toss to combine the salad.",
            "secondary_message": "1 (10 oz) bag shredded carrots\n1 (4 oz) pkg crumbled feta cheese\n⅓ cup French vinaigrette"
          },
          {
            "id": 415235,
            "primary_message": "To serve, divide chicken and salad between plates; top chicken with orange relish. Enjoy!",
            "secondary_message": null
          }
        ],
