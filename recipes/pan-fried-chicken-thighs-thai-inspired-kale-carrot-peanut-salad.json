  "instructions": [
    {
      "id": 46868,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 bunch kale\n1 small bunch green onions (scallions)\n2 carrots\n1 lime"
    },
    {
      "id": 46869,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 46870,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 46871,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 46872,
      "primary_message": "Carefully place the chicken thighs in the skillet; sear on both sides until golden brown, 2 to 3 minutes per side. Then, reduce the heat to medium and continue to cook until they are cooked through, 3 to 5 minutes total. Once done, transfer to a plate and cover with foil to keep warm.",
      "secondary_message": null
    },
    {
      "id": 46873,
      "primary_message": "Cut out and discard the kale stems; halve the leaves lengthwise, then chop crosswise into ¼-inch-thick strips. Transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 46874,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Using a box grater, coarsely grate the carrots. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 46875,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 46876,
      "primary_message": "Juice the lime and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 46877,
      "primary_message": "To the lime juice, add peanut butter, water, soy sauce, honey, sesame oil, and crushed red pepper; whisk together.",
      "secondary_message": "4 tbsp natural peanut butter\n2 tbsp warm water\n2 tbsp soy sauce\n2 tsp honey\n1 tsp toasted sesame oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 46878,
      "primary_message": "Pour the dressing over the salad and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 46879,
      "primary_message": "To serve, divide the chicken thighs and salad between plates; sprinkle the salad with sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
