        "instructions": [
          {
            "id": 289352,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 289353,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and spread it out on a baking sheet pan to cool slightly, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 289354,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "2 oranges\n1 lime\n2 grapefruits\n1 English cucumber\n1 avocado\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 289355,
            "primary_message": "Zest and juice one orange into a large bowl. (Set remaining orange aside for later use.)",
            "secondary_message": null
          },
          {
            "id": 289356,
            "primary_message": "Juice lime into the bowl with the orange zest and juice. Add oil, honey, salt, and crushed red pepper; whisk to combine the dressing.",
            "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp honey\n½ tsp salt\n⅛ tsp crushed red pepper"
          },
          {
            "id": 289357,
            "primary_message": "Peel and thinly slice shallots into rings; peel and mince garlic. Add both to the bowl with the dressing. ",
            "secondary_message": "2 shallots\n2 cloves garlic"
          },
          {
            "id": 289358,
            "primary_message": "Cut off skin and white pith from the remaining orange and the grapefruits; slice into thin rounds. Add both to the bowl and set aside. ",
            "secondary_message": null
          },
          {
            "id": 289359,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 289360,
            "primary_message": "While the skillet heats up, pat the cod dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb cod fillet\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 289361,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fish and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 289362,
            "primary_message": "Meanwhile, trim, halve, and slice cucumber crosswise into thin half-moons; add to the bowl with the dressing and citrus fruit.",
            "secondary_message": null
          },
          {
            "id": 289363,
            "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 289364,
            "primary_message": "Once the cod is done, use your fingers to flake the fish into bite-sized pieces; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 289365,
            "primary_message": "Add arugula to the bowl and gently toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 289366,
            "primary_message": "To serve, divide cooled rice between bowls and top with cod and citrus salad. Enjoy!",
            "secondary_message": null
          }
        ],
