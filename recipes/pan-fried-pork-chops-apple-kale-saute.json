        "instructions": [
          {
            "id": 45634,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 Granny Smith apples\n2 bunches kale"
          },
          {
            "id": 45635,
            "primary_message": "Quarter the apples lengthwise, then cut out the core and stem from each section; cut each quarter lengthwise into 4 thin wedges and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 45636,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 45637,
            "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, bone-in\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 45638,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 45639,
            "primary_message": "Place the pork chops in the skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
            "secondary_message": null
          },
          {
            "id": 45640,
            "primary_message": "While the pork chops cook, trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds and leave on cutting board.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 45641,
            "primary_message": "Once the pork has been transferred, add the shallots to the skillet; cook, stirring frequently, until softened, 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 45642,
            "primary_message": "Add the apple slices to the skillet; cook, stirring occasionally, until they are lightly browned and just tender, 3 to 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 45643,
            "primary_message": "While the apples cook, cut out and discard the stems from each kale leaf; chop leaves crosswise into 1-inch strips.",
            "secondary_message": null
          },
          {
            "id": 45644,
            "primary_message": "Add the kale and ½ cup of water to the skillet; cook, stirring frequently, until it is wilted, 3 to 4 minutes. Once done, remove from the heat.",
            "secondary_message": ""
          },
          {
            "id": 45645,
            "primary_message": "Drizzle the kale with apple cider vinegar and season with salt and pepper.",
            "secondary_message": "2 tsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 45646,
            "primary_message": "To serve, divide the pork chops and sauté between plates. Add a dollop of mustard on the side for the pork if desired. Enjoy!",
            "secondary_message": null
          }
        ],
