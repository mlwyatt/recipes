        "instructions": [
          {
            "id": 27559,
            "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
            "secondary_message": null
          },
          {
            "id": 27560,
            "primary_message": "Place the pork chops on a plate, rub both sides with chili powder, and season with salt and pepper. Set aside.",
            "secondary_message": "4 pork chops, boneless\n2 tsp chili powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 27561,
            "primary_message": "Wash the green beans, then trim off and discard the ends.",
            "secondary_message": "1 ½ lb green beans"
          },
          {
            "id": 27562,
            "primary_message": "Once the water in the saucepan is boiling, add the green beans and cook until bright green and tender-crisp, 2-3 minutes. Drain in a colander and rinse under cold water. Set aside to drain further.",
            "secondary_message": null
          },
          {
            "id": 27563,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 27564,
            "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom. Add the pork chops and cook until browned and cooked through, 3-4 minutes per side. Transfer to a plate and let them rest for 2-3 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 27565,
            "primary_message": "Peel and mince or press the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 27566,
            "primary_message": "Once the chops have been removed, reduce the heat to medium and add more coconut oil to the skillet. Add the garlic and cook until fragrant, 15-30 seconds. Add the green beans and season with salt and pepper. Cook, stirring frequently, for 2-3 minutes. Remove from heat.",
            "secondary_message": "1 tbsp virgin coconut oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 27567,
            "primary_message": "Wash the peaches, halve, core, and small dice; transfer to a medium bowl.",
            "secondary_message": "2 peaches"
          },
          {
            "id": 27568,
            "primary_message": "Peel and mince the shallots; add to the bowl.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 27569,
            "primary_message": "Wash and dry the basil. Pick the leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
            "secondary_message": "1 small pkg fresh basil"
          },
          {
            "id": 27570,
            "primary_message": "Drizzle lime juice over the salsa and season with salt and pepper. Mix well.",
            "secondary_message": "1 lime\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 27571,
            "primary_message": "To serve, place pork chops on plates, spoon peach salsa over top, and add green beans to the side. Enjoy!",
            "secondary_message": null
          }
        ],
