  "instructions": [
    {
      "id": 26074,
      "primary_message": "Preheat the oven to 450°F and position rack in the centre. Line a baking sheet with parchment paper.",
      "secondary_message": ""
    },
    {
      "id": 26075,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 26076,
      "primary_message": "Wash, peel, and medium dice the sweet potatoes; add to the water in the saucepan. Once the water is boiling, cook the potatoes until tender when pierced with a fork, 8-10 minutes. Drain in a colander and return back to saucepan.",
      "secondary_message": "1 ½ lb sweet potatoes"
    },
    {
      "id": 26077,
      "primary_message": "Wash the broccoli and cut into bite-sized florets; transfer to the baking sheet.",
      "secondary_message": "4 crowns broccoli\r\n"
    },
    {
      "id": 26078,
      "primary_message": "Peel and mince the garlic. Wash the lemon and grate the zest from it.",
      "secondary_message": "4 cloves garlic\r\n1 lemon"
    },
    {
      "id": 26079,
      "primary_message": "Drizzle the broccoli with olive oil and lemon juice and season with the zest, minced garlic, salt, black pepper, and red pepper (optional). Toss to coat, then spread out in a single layer.",
      "secondary_message": "4 tbsp extra virgin olive oil\r\njuice of 1 lemon\r\n½ tsp salt\r\n½ tsp black pepper\r\n¼ tsp crushed red pepper (optional)"
    },
    {
      "id": 26080,
      "primary_message": "Place broccoli in the oven and roast until tender and browned, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 26081,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 26082,
      "primary_message": "Season the pork chops with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, bone-in\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 26083,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the pork chops and cook until browned and cooked through, 3-4 minutes per side. Transfer to a plate and let them rest for 2-3 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 26084,
      "primary_message": "Grate ¼ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese\r\n"
    },
    {
      "id": 26085,
      "primary_message": "Remove broccoli from oven, sprinkle with Parmesan, and toss.",
      "secondary_message": ""
    },
    {
      "id": 26086,
      "primary_message": "Add butter to the sweet potatoes and season with salt and pepper. Mash with a potato masher (or a fork) until smooth.",
      "secondary_message": "2 tbsp butter, unsalted\r\n¼ tsp salt\r\n¼ tsp black pepper\r\n"
    },
    {
      "id": 26087,
      "primary_message": "Serve pork chops with sweet potato mash and broccoli on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
