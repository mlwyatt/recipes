        "instructions": [
          {
            "id": 41380,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium heads cauliflower\n6 medium carrots"
          },
          {
            "id": 41381,
            "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); bring to a boil.",
            "secondary_message": null
          },
          {
            "id": 41382,
            "primary_message": "Trim off and discard the stem ends and leaves of the cauliflower; cut the heads into large florets and thinly slice the stem portions. Transfer to a medium bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 41383,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 41384,
            "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, bone-in\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 41385,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 41386,
            "primary_message": "Place the pork chops in the skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the chops to a plate and cover with foil to keep warm.",
            "secondary_message": null
          },
          {
            "id": 41387,
            "primary_message": "Once the water in the saucepan is boiling, add the cauliflower. Bring to a boil again, then cook until the cauliflower is tender, 6 to 8 minutes. Once done, drain the cauliflower in a colander, then return back to the saucepan and cover to keep warm.",
            "secondary_message": null
          },
          {
            "id": 41388,
            "primary_message": "While the pork chops cook, peel the carrots, then trim off the ends; discard the peels and trimmings. Cut the carrots into ¼-inch-thick rounds at a 45° angle.",
            "secondary_message": null
          },
          {
            "id": 41389,
            "primary_message": "Once the pork chops have been transferred, add the carrots to the skillet and season with salt and pepper. Cook, stirring occasionally, until the carrots are tender, 6 to 8 minutes. Once done, remove the skillet from the heat.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 41390,
            "primary_message": "Add butter, salt, and pepper to the cauliflower; mash with a potato masher (or blend with a hand blender for a smoother consistency).",
            "secondary_message": "4 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 41391,
            "primary_message": "To serve, divide the cauliflower mash, carrots, and pork chops between plates. Enjoy!",
            "secondary_message": null
          }
        ],
