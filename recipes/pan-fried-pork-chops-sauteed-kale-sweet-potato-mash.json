        "instructions": [
          {
            "id": 47270,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb sweet potatoes\n1 bunch kale"
          },
          {
            "id": 47271,
            "primary_message": "Cut out and discard the stems from the kale leaves; chop the leaves into 1-inch pieces and transfer to a medium bowl.",
            "secondary_message": ""
          },
          {
            "id": 47272,
            "primary_message": "Peel and cut the sweet potatoes into 1-inch cubes; transfer to a small saucepan. Cover the potatoes with hot water (from the tap) by about 1 inch; bring to a boil over high heat.",
            "secondary_message": ""
          },
          {
            "id": 47273,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 47274,
            "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, bone-in\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 47275,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 47276,
            "primary_message": "Place the pork chops in the skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
            "secondary_message": null
          },
          {
            "id": 47277,
            "primary_message": "Once the water in the saucepan is boiling, reduce the heat to medium-high and boil the potatoes until they can be easily pierced with a fork, 8 to 10 minutes. Scoop out 1 cup of the cooking water and drain the rest. Cover the potatoes to keep warm.",
            "secondary_message": null
          },
          {
            "id": 47278,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 47279,
            "primary_message": "Once the pork has been transferred, add the garlic, crushed red pepper, kale, and 1 cup water to the skillet; toss to combine. Cover with a lid and cook until the kale is wilted but still green, 4 to 6 minutes. Remove the cover and continue to cook, stirring, until all of the liquid has evaporated, another 1 to 2 minutes.",
            "secondary_message": "¼ tsp crushed red pepper"
          },
          {
            "id": 47280,
            "primary_message": "Remove the kale from the heat, then drizzle with apple cider vinegar and season with salt and pepper, toss to combine.",
            "secondary_message": "1 tbsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 47281,
            "primary_message": "Add ½ of the reserved liquid, butter, salt, and pepper to the potatoes; mash with a potato masher until smooth. Add more of the liquid to thin out the mash if needed.",
            "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 47282,
            "primary_message": "To serve, divide the sweet potato mash, sautéed kale, and pork chops between plates. Enjoy!",
            "secondary_message": null
          }
        ],
