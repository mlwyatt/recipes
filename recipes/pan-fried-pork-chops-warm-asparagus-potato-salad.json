        "instructions": [
          {
            "id": 42707,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 small bunches asparagus\n4 medium red potatoes\n1 small bunch green onions (scallions)\n1 lemon"
          },
          {
            "id": 42708,
            "primary_message": "Halve the potatoes lengthwise, then place in a small saucepan and cover with hot water (from the tap); bring to a boil. Once boiling, cook until the potatoes are tender (but not falling apart) when pierced with a knife, 12 to 18 minutes. Once done, take the potatoes out of the saucepan with a spoon and place on a plate.",
            "secondary_message": ""
          },
          {
            "id": 42709,
            "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears into 1-inch pieces at an angle and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 42710,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 42711,
            "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, bone-in\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 42712,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 42713,
            "primary_message": "Place the pork chops in the skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
            "secondary_message": null
          },
          {
            "id": 42714,
            "primary_message": "While the pork chops cook, juice the lemon into a large salad bowl, then add yogurt, Dijon, salt, and pepper; whisk together.",
            "secondary_message": "½ cup plain Greek yogurt\n2 tbsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 42715,
            "primary_message": "Once the pork chops have been transferred, add the asparagus to the skillet. Cook, tossing frequently, until the asparagus is bright green and just tender, 4 to 6 minutes, lowering the heat if needed to keep it from burning. Once done, add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 42716,
            "primary_message": "While the asparagus cooks, trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and add to the salad bowl.",
            "secondary_message": ""
          },
          {
            "id": 42717,
            "primary_message": "Transfer the cooked potatoes to the cutting board. Halve each half lengthwise, then cut crosswise into ¼-inch-thick pieces. Add to the salad bowl.",
            "secondary_message": ""
          },
          {
            "id": 42718,
            "primary_message": "Toss the salad until it is thoroughly coated in the dressing.",
            "secondary_message": null
          },
          {
            "id": 42719,
            "primary_message": "To serve, divide the pork chops and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
