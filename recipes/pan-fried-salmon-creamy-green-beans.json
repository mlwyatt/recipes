        "instructions": [
          {
            "id": 45345,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb green beans\n1 lemon"
          },
          {
            "id": 45346,
            "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 45347,
            "primary_message": "Trim and discard the ends of the green beans, then halve the green beans and transfer to a medium bowl.",
            "secondary_message": ""
          },
          {
            "id": 45348,
            "primary_message": "Juice the lemon into a large salad bowl.",
            "secondary_message": null
          },
          {
            "id": 45349,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the lemon juice.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 45350,
            "primary_message": "Once the water in the saucepan is boiling, add the green beans. Cook until bright green and tender-crisp, 3 to 4 minutes. Once done, drain in a colander and rinse under cold water to stop the cooking process. Set aside to drain further.",
            "secondary_message": null
          },
          {
            "id": 45351,
            "primary_message": "To the lemon juice and garlic, add yogurt, olive oil, salt, and pepper; whisk together.",
            "secondary_message": "½ cup plain Greek yogurt\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 45352,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 45353,
            "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb salmon fillet\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 45354,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 45355,
            "primary_message": "Carefully place the salmon, skin-side-down, in the skillet; cook until the flesh is opaque and flaky, 3 to 4 minutes per side (depending on thickness). Once done, transfer the salmon to a plate.",
            "secondary_message": ""
          },
          {
            "id": 45356,
            "primary_message": "Add the green beans to the salad bowl and toss to thoroughly coat in the dressing.",
            "secondary_message": ""
          },
          {
            "id": 45357,
            "primary_message": "To serve, divide the green beans and salmon between plates. Enjoy!",
            "secondary_message": null
          }
        ],
