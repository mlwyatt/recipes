        "instructions": [
          {
            "id": 50358,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lb green beans\n4 medium yellow potatoes"
          },
          {
            "id": 50359,
            "primary_message": "Peel the potatoes, then halve lengthwise and crosswise; transfer the quarters to a small saucepan. Cover with hot water (from the tap) by about 1 inch and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 50360,
            "primary_message": "Trim and discard the ends of the green beans, then halve the green beans. Transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 50361,
            "primary_message": "Once the water in the saucepan is boiling, reduce the heat to medium and cook until the potatoes are tender when pierced with a knife, 8 to 12 minutes. Once done, reserve about 1 cup of liquid and drain the rest. Cover the saucepan to keep warm.",
            "secondary_message": null
          },
          {
            "id": 50362,
            "primary_message": "Add butter to a nonstick skillet and preheat over medium heat.",
            "secondary_message": "1 tbsp butter, unsalted"
          },
          {
            "id": 50363,
            "primary_message": "Pat the sole dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb sole fillets\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 50364,
            "primary_message": "Once the skillet is hot, add the sole; cook until it is cooked through and golden brown, 2 to 4 minutes per side. Once done, transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 50365,
            "primary_message": "Once the sole has been transferred, add the green beans to the skillet and pour in ¼ cup of water. Bring to a boil over high heat; once boiling, cook until bright green, 2 to 3 minutes.",
            "secondary_message": ""
          },
          {
            "id": 50366,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 50367,
            "primary_message": "Add the garlic, butter, salt, and pepper to the green beans. Cook until the water is fully evaporated, another 1 to 2 minutes.",
            "secondary_message": "1 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 50368,
            "primary_message": "Add ½ of the reserved liquid, butter, salt, and pepper to the potatoes; mash with a potato masher until smooth. Add more liquid to thin out the mash if needed.",
            "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 50369,
            "primary_message": "To serve, divide the mashed potatoes, green beans, and sole between plates. Enjoy!",
            "secondary_message": null
          }
        ],
