        "instructions": [
          {
            "id": 329297,
            "primary_message": "In a medium saucepan, bring broth and spices to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 tsp coriander, ground\n½ tsp salt\n½ tsp black pepper\n1 cup whole wheat couscous"
          },
          {
            "id": 329298,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 oranges\n2 yellow bell peppers\n1 small bunch green onions (scallions)\n1 small pkg fresh basil\n2 avocados"
          },
          {
            "id": 329299,
            "primary_message": "Zest oranges into a medium bowl, then add oil, vinegar, and spices; whisk to combine the dressing. (Reserve oranges for the next step.)",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cayenne pepper"
          },
          {
            "id": 329300,
            "primary_message": "Cut off skin and white pith from the oranges; slice between the membranes to release segments. Cut each segment crosswise into bite-sized pieces and add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 329301,
            "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 329302,
            "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 329303,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 329304,
            "primary_message": "While the skillet heats up, pat tilapia dry with paper towels and place on a plate; season with spices on both sides.",
            "secondary_message": "1 ½ lb tilapia fillet\n2 tsp cumin, ground\n1 tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 329305,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tilapia and cook, flipping once, until fish is crispy and easily flakes with a fork, about 6 minutes; remove from heat.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 329306,
            "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl with orange and bell pepper.",
            "secondary_message": null
          },
          {
            "id": 329307,
            "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl and stir to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 329308,
            "primary_message": "To serve, divide couscous, tilapia, and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
