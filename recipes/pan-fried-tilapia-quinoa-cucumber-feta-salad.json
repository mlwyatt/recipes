        "instructions": [
          {
            "id": 40286,
            "primary_message": "In a small saucepan, combine the quinoa and water; bring to a boil over high heat.",
            "secondary_message": "1 cup quinoa\n1 ½ cups water "
          },
          {
            "id": 40287,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 English cucumbers\n1 lemon\n1 small bunch fresh dill"
          },
          {
            "id": 40288,
            "primary_message": "Add olive oil to a nonstick skillet and heat over medium heat.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 40289,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the quinoa for 15 minutes. Once done, remove the quinoa from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 40290,
            "primary_message": "Pat the tilapia dry with paper towels and place on a plate; season with paprika, salt, and pepper on both sides.",
            "secondary_message": "1 ½ lb tilapia fillet\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 40291,
            "primary_message": "Place the fish in the skillet; cook until opaque throughout, 3 to 5 minutes per side. Once done, transfer to a plate.",
            "secondary_message": ""
          },
          {
            "id": 40292,
            "primary_message": "While the fish cooks, trim off and discard the ends of the cucumbers; quarter the cucumbers lengthwise, then slice crosswise into ¼-inch-thick pieces. Transfer to a large salad bowl.",
            "secondary_message": null
          },
          {
            "id": 40293,
            "primary_message": "Cut off and discard the large stems from the dill; chop the dill leaves and tender stems. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 40294,
            "primary_message": "Add the feta to the salad bowl.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese."
          },
          {
            "id": 40295,
            "primary_message": "Juice the lemon and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 40296,
            "primary_message": "Add olive oil, salt, and pepper to the salad bowl.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 40297,
            "primary_message": "Uncover the quinoa and fluff with a fork; add to the salad bowl and toss to combine.",
            "secondary_message": null
          },
          {
            "id": 40298,
            "primary_message": "To serve, divide the quinoa between plates and top with the fish. Enjoy!",
            "secondary_message": null
          }
        ],
