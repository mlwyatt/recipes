        "instructions": [
          {
            "id": 48948,
            "primary_message": "In a small saucepan, combine the quinoa and broth; bring to a boil over high heat.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 48949,
            "primary_message": "Roughly chop the pistachios and transfer to a small bowl.",
            "secondary_message": "½ cup pistachios, unsalted"
          },
          {
            "id": 48950,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 48951,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the quinoa for 15 minutes. Once done, remove the quinoa from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 48952,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 48953,
            "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season the cutlets with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 48954,
            "primary_message": "Add the pistachios to the skillet; cook, stirring frequently, until the nuts are toasted and fragrant, 3 to 5 minutes. Return to the small bowl and wipe out the pan.",
            "secondary_message": ""
          },
          {
            "id": 48955,
            "primary_message": "Once the pistachios have been transferred, add olive oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 48956,
            "primary_message": "Place the chicken cutlets in the skillet; cook until they are golden brown on the outside and cooked through in the center, 2 to 4 minutes per side. Once done, transfer to a plate and cover with foil to keep warm. Cook in batches if necessary.",
            "secondary_message": null
          },
          {
            "id": 48957,
            "primary_message": "Uncover the quinoa and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 48958,
            "primary_message": "Once the chicken has been transferred, add olive oil to the skillet followed by the garlic, spinach, cooked quinoa, pistachios, and cranberries. Season with salt and pepper and cook for 1 to 2 minutes. Remove from the heat.",
            "secondary_message": "1 tbsp extra virgin olive oil\n1 (5 oz) pkg baby spinach\n¼ cup dried cranberries\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 48959,
            "primary_message": "To serve, divide the quinoa salad and chicken between plates. Enjoy!",
            "secondary_message": null
          }
        ],
