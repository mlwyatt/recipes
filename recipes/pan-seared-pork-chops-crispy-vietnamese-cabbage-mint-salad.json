  "instructions": [
    {
      "id": 231094,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 medium head napa cabbage\n1 English cucumber\n2 medium carrots\n1 small pkg fresh mint"
    },
    {
      "id": 231095,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231096,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 231097,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork chops and sear until golden and cooked through, 3-4 minutes per side. Remove from heat and transfer to a clean plate. Cover loosely with aluminum foil and set aside.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 231098,
      "primary_message": "Meanwhile, place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 231099,
      "primary_message": "Juice limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 231100,
      "primary_message": "Add fish sauce, oil, sugar, and, chili-garlic sauce to the bowl with the lime juice; whisk to combine the dressing.",
      "secondary_message": "¼ cup fish sauce\n2 tbsp toasted sesame oil\n2 tsp brown sugar\n2 tsp chili-garlic sauce"
    },
    {
      "id": 231101,
      "primary_message": "Peel, halve, and thinly slice the shallots into half-moons; add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 231102,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise into shreds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231103,
      "primary_message": "Trim cucumber, halve lengthwise, and thinly slice crosswise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231104,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231105,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the edamame and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 231106,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 231107,
      "primary_message": "To serve, divide salad and pork chops between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
