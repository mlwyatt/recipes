        "instructions": [
          {
            "id": 40641,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium yellow potatoes\n2 bunches kale"
          },
          {
            "id": 40642,
            "primary_message": "Peel and quarter the potatoes; transfer to a medium saucepan.",
            "secondary_message": null
          },
          {
            "id": 40643,
            "primary_message": "Cover the potatoes with hot water (from the tap); bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 40644,
            "primary_message": "Cut out and discard the center stems from the kale leaves; slice the leaves crosswise into ⅛-inch strips and transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 40645,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 40646,
            "primary_message": "While the skillet heats up, pat dry the steak with paper towels and place on a plate. Season the steak generously with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 40647,
            "primary_message": "Once the water in the saucepan is boiling, reduce the heat to medium and cook until the potatoes are tender when pierced with a knife, 15 to 20 minutes. Once done, drain the potatoes and return to the saucepan; cover to keep warm.",
            "secondary_message": null
          },
          {
            "id": 40648,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 40649,
            "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 40650,
            "primary_message": "While the steak cooks, trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 40651,
            "primary_message": "Once the steak has been transferred, reduce the heat to medium. Add the garlic and kale; season with salt and pepper. Cook, stirring frequently, until the kale is wilted, 3 to 4 minutes.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 40652,
            "primary_message": "Add butter, broth, salt, and pepper to the potatoes; mash with a potato masher until smooth.",
            "secondary_message": "4 tbsp butter, unsalted\n8 fl oz (1 cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 40653,
            "primary_message": "Add the kale to the saucepan and mash with the potatoes.",
            "secondary_message": null
          },
          {
            "id": 40654,
            "primary_message": "To serve, divide the colcannon and steak between plates. Enjoy!",
            "secondary_message": null
          }
        ],
