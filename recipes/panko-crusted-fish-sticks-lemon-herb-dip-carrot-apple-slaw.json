        "instructions": [
          {
            "id": 33363,
            "primary_message": "Preheat the oven to 450°F and place the rack in the center position.",
            "secondary_message": null
          },
          {
            "id": 33364,
            "primary_message": "Crack the eggs into a shallow bowl and season with salt and pepper, then beat with a whisk or fork.",
            "secondary_message": "2 eggs\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 33365,
            "primary_message": "On a large plate, combine bread crumbs and olive oil; mix together.",
            "secondary_message": "2 cups panko bread crumbs\n2 tbsp extra virgin olive oil"
          },
          {
            "id": 33366,
            "primary_message": "Slice the fish fillets crosswise into ½-inch-wide strips.",
            "secondary_message": "1 ½ lb cod fillet"
          },
          {
            "id": 33367,
            "primary_message": "Line a baking sheet with parchment paper or foil.",
            "secondary_message": null
          },
          {
            "id": 33368,
            "primary_message": "Working in batches, dip the fish in the egg mixture (allowing excess to drip back into bowl), then coat with the bread crumbs (pressing gently to help them adhere); transfer to the baking sheet.",
            "secondary_message": ""
          },
          {
            "id": 33369,
            "primary_message": "Place the fish sticks in the oven and bake until the bread crumbs are golden brown and the fish is opaque in the middle, 15 to 18 minutes.",
            "secondary_message": ""
          },
          {
            "id": 33370,
            "primary_message": "While the fish cooks, wash and dry the fresh produce.",
            "secondary_message": "2 Granny Smith apples\n4 medium carrots\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 33371,
            "primary_message": "Quarter the apples, then cut out the core and stem from each section. Using a box grater, coarsely grate the apple sections and transfer to a medium salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33372,
            "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Using a box grater, coarsely grate the carrots and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 33373,
            "primary_message": "Using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Transfer ½ of the parsley to the salad bowl and the other ½ to a medium bowl (that will be used for the dip and salad dressing).",
            "secondary_message": null
          },
          {
            "id": 33374,
            "primary_message": "Measure out the raisins and add to the salad bowl.",
            "secondary_message": "½ cup raisins"
          },
          {
            "id": 33375,
            "primary_message": "Juice the lemon and pour into the medium bowl with the parsley.",
            "secondary_message": null
          },
          {
            "id": 33376,
            "primary_message": "Add mayo, yogurt, Dijon, salt, and pepper to the bowl with the parsley and lemon juice; whisk together.",
            "secondary_message": "½ cup mayonnaise\n½ cup plain Greek yogurt\n2 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 33377,
            "primary_message": "Reserve half of the sauce as a dip for the fish sticks and transfer the rest to the salad bowl; toss the salad to coat.",
            "secondary_message": null
          },
          {
            "id": 33378,
            "primary_message": "To serve, place the fish sticks and slaw on a plate and serve with the remaining dip. Enjoy!",
            "secondary_message": null
          }
        ],
