  "instructions": [
    {
      "id": 12548,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 12549,
      "primary_message": "In a small bowl, mix together oil, paprika, cumin, salt, and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\r\n¼ tsp paprika\r\n¼ tsp cumin\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 12550,
      "primary_message": "Rub salmon with spice mixture.",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "id": 12551,
      "primary_message": "Coat grill or bottom of skillet with oil. Add salmon and cook until opaque, 4-5 minutes per side. Transfer to a plate.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 12552,
      "primary_message": "Wash, dry, and slice eggplant into ¼ inch thick pieces. Transfer to a large bowl, drizzle with oil, and season with salt; toss to coat.",
      "secondary_message": "2 eggplant\r\n2 tbsp extra virgin olive oil\r\n¼ tsp salt"
    },
    {
      "id": 12553,
      "primary_message": "Add eggplant to grill/skillet and cook until tender and lightly browned, 2-3 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 12554,
      "primary_message": "Wash and dry basil. Pick leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. In a medium bowl, whisk together basil, garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "1 small pkg fresh basil\r\n2 cloves garlic\r\n4 tbsp extra virgin olive oil\r\n2 tbsp red wine vinegar\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 12555,
      "primary_message": "To serve, place salmon and eggplant on a plate and drizzle with basil vinaigrette. Enjoy!",
      "secondary_message": ""
    }
  ],
