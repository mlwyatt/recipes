        "instructions": [
          {
            "id": 17976,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": ""
          },
          {
            "id": 17977,
            "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper. Place on a baking sheet pan.",
            "secondary_message": "1 lb chicken breasts, boneless skinless\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
          },
          {
            "id": 17978,
            "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 17979,
            "primary_message": "Grate ½ cup of Parmesan cheese. Peel and mince garlic.",
            "secondary_message": "2 oz Parmesan cheese\r\n2 cloves garlic"
          },
          {
            "id": 17980,
            "primary_message": "In a medium bowl, combine parsley, Parmesan, garlic, bread crumbs, and olive oil. Mix well and pat onto chicken fillets.",
            "secondary_message": "½ cup panko bread crumbs\r\n4 tbsp extra virgin olive oil"
          },
          {
            "id": 17981,
            "primary_message": "Place chicken in the oven and bake while you prepare the romaine, about 5 minutes.",
            "secondary_message": ""
          },
          {
            "id": 17982,
            "primary_message": "Wash and dry lettuce. Quarter lengthwise. Place on sheet with chicken and season with salt and pepper.",
            "secondary_message": "2 heads romaine lettuce\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 17983,
            "primary_message": "Return sheet to the oven and roast until chicken is cooked through and romaine is browned at the edges, another 5-10 minutes.",
            "secondary_message": ""
          },
          {
            "id": 17984,
            "primary_message": "Cut 1 lemon into wedges.",
            "secondary_message": ""
          },
          {
            "id": 17985,
            "primary_message": "To serve, place chicken and romaine hearts on a plate. Garnish with lemon wedges and sprinkle romaine hearts with pine nuts. Enjoy!",
            "secondary_message": "¼ cup pine nuts"
          }
        ],
