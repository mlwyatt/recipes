        "instructions": [
          {
            "id": 375351,
            "primary_message": "Preheat the oven to 400°F. Line a baking sheet pan with parchment paper. ",
            "secondary_message": null
          },
          {
            "id": 375352,
            "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost. Transfer edamame to the baking sheet and pat dry with paper towels.",
            "secondary_message": "2 cups edamame"
          },
          {
            "id": 375353,
            "primary_message": "Finely grate Parmesan over the edamame.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 375354,
            "primary_message": "Drizzle oil over the edamame, then sprinkle with spices. Stir to coat, then spread out in an even layer. ",
            "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp garlic powder\n¼ tsp onion powder\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 375355,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 375356,
            "primary_message": "Meanwhile, wash and dry lemon. ",
            "secondary_message": "1 lemon"
          },
          {
            "id": 375357,
            "primary_message": "Remove edamame from the oven and juice lemon over the top. Stir to combine, then spread out in an even layer. Return to the oven and continue to roast until edamame is golden and Parmesan is crispy, 5-6 minutes more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 375358,
            "primary_message": "Add almonds to the baking sheet with the edamame and stir to combine.",
            "secondary_message": "⅔ cup almonds"
          },
          {
            "id": 375359,
            "primary_message": "To serve divide roasted edamame and almond mix between bowls. Enjoy!",
            "secondary_message": null
          }
        ],
