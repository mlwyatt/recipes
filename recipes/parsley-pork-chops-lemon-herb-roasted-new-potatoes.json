        "instructions": [
          {
            "id": 11222,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": ""
          },
          {
            "id": 11223,
            "primary_message": "Wash and dry potatoes, lemon, and parsley. Halve or quarter (depending on their size) the potatoes. Thinly slice the lemon into rounds. Shave parsley leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic.",
            "secondary_message": "3 lb new potatoes\r\n1 lemon\r\n1 small bunch Italian (flat-leaf) parsley\r\n6 cloves garlic"
          },
          {
            "id": 11224,
            "primary_message": "Transfer potatoes, lemon slices, and ½ of the parsley and garlic (save the rest for garnishing) to a sheet pan. Drizzle with oil and season with salt and pepper; toss to coat.",
            "secondary_message": "2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 11225,
            "primary_message": "Place in the oven and roast, tossing once halfway through, until golden and tender, 15-20 minutes.",
            "secondary_message": ""
          },
          {
            "id": 11226,
            "primary_message": "Heat a sauté pan over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 11227,
            "primary_message": "Season pork with salt and pepper.",
            "secondary_message": "4 pork chops, boneless\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
          },
          {
            "id": 11228,
            "primary_message": "Coat bottom of pan with oil. Add pork and cook until browned, 2-3 minutes per side.",
            "secondary_message": "about 2 tbsp virgin coconut oil"
          },
          {
            "id": 11229,
            "primary_message": "Add water to pan and bring to a boil. Reduce heat to medium-low, cover, and cook until pork is cooked through, 5-6 minutes.",
            "secondary_message": "½ cup water"
          },
          {
            "id": 11230,
            "primary_message": "Add remaining parsley and garlic to pan juices.",
            "secondary_message": ""
          },
          {
            "id": 11231,
            "primary_message": "To serve, arrange pork chops and potatoes on a plate and drizzle with pan juices. Enjoy!",
            "secondary_message": ""
          }
        ],
