  "instructions": [
    {
      "id": 410920,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 410921,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 small bunch green onions (scallions)\n1 English cucumber"
    },
    {
      "id": 410922,
      "primary_message": "Juice limes into a large bowl. Add peanut sauce and stir to combine the dressing.",
      "secondary_message": "1 cup peanut sauce"
    },
    {
      "id": 410923,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 410924,
      "primary_message": "Trim and small dice cucumber. Add to the bowl along with the carrots.",
      "secondary_message": "1 (10 oz) bag shredded carrots"
    },
    {
      "id": 410925,
      "primary_message": "Place edamame in a colander.",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 410926,
      "primary_message": "When the pasta is done, drain over the edamame to defrost. Rinse pasta and edamame under cold water to cool. Add to the bowl and stir to combine the pasta salad.",
      "secondary_message": null
    },
    {
      "id": 410927,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
