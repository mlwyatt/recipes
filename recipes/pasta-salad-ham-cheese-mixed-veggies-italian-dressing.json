        "instructions": [
          {
            "id": 423190,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 6 minutes.",
            "secondary_message": "1 tsp salt\n10 oz rotini pasta"
          },
          {
            "id": 423191,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 English cucumber\n2 yellow bell peppers\n2 medium carrots"
          },
          {
            "id": 423192,
            "primary_message": "Trim and medium dice cucumber. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 423193,
            "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the cucumber.",
            "secondary_message": null
          },
          {
            "id": 423194,
            "primary_message": "Medium dice ham and add to the bowl. Set aside. ",
            "secondary_message": "16 oz ham steak, boneless"
          },
          {
            "id": 423195,
            "primary_message": "Peel, trim, and medium dice carrots.",
            "secondary_message": null
          },
          {
            "id": 423196,
            "primary_message": "When the pasta is almost done, add carrot and broccoli to the pot. Continue to cook, stirring occasionally, until pasta reaches desired firmness and veggies are tender, 3-4 minutes more.",
            "secondary_message": "1 (18 oz) bag broccoli florets"
          },
          {
            "id": 423197,
            "primary_message": "Drain and rinse pasta and veggies under cold water to cool. Add to the bowl with the other ingredients.",
            "secondary_message": null
          },
          {
            "id": 423198,
            "primary_message": "Add cheese and dressing to the bowl, then stir to combine the pasta salad.",
            "secondary_message": "1 cup shredded cheese, Italian blend\n½ cup Italian salad dressing"
          },
          {
            "id": 423199,
            "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
