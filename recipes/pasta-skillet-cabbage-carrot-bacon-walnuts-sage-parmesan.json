  "instructions": [
    {
      "id": 371990,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ½-cup cooking water before draining and set aside.)",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 371991,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small head red cabbage\n2 medium carrots\n½ small pkg fresh sage"
    },
    {
      "id": 371992,
      "primary_message": "Halve cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 371993,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the cabbage and set aside.",
      "secondary_message": null
    },
    {
      "id": 371994,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 371995,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 371996,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 371997,
      "primary_message": "While the bacon is cooking, using a clean cutting board, peel and mince shallots and garlic.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 371998,
      "primary_message": "Return the skillet (with drippings) to medium heat, add oil, and swirl to coat the bottom. Add cabbage, carrot, shallot, and garlic; cook, stirring occasionally, until cabbage is tender, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 371999,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 372000,
      "primary_message": "Pick sage leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 372001,
      "primary_message": "When the cabbage is done, add pasta, reserved pasta water, Parmesan, sage, vinegar, salt, and pepper to the skillet. Continue to cook, stirring occasionally, until water has evaporated and Parmesan has melted, about 2 minutes. Remove from heat. ",
      "secondary_message": "2 tbsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 372002,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 372003,
      "primary_message": "To serve, divide pasta between plates or bowls; top with crispy bacon and walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
