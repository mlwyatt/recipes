        "instructions": [
          {
            "id": 386352,
            "primary_message": "Place tortillas on a cutting board. Spread peanut butter evenly over each tortilla, then drizzle with honey.",
            "secondary_message": "2 large flour tortillas\n⅓ cup natural peanut butter\n2 tsp honey"
          },
          {
            "id": 386353,
            "primary_message": "Peel bananas and place at one end of each tortilla. Roll each tortilla up around the banana, then slice crosswise into 1-inch rounds.",
            "secondary_message": "2 bananas"
          },
          {
            "id": 386354,
            "primary_message": "To serve, divide roll-ups between plates. Enjoy!",
            "secondary_message": null
          }
