        "instructions": [
          {
            "id": 398746,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
            "secondary_message": "10 oz flat rice (pad thai) noodles"
          },
          {
            "id": 398747,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small bunch green onions (scallions)\n1 (8 oz) pkg sugar snap peas\n1 English cucumber"
          },
          {
            "id": 398748,
            "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 398749,
            "primary_message": "Halve snap peas crosswise. Add to the bowl with the green onions and set aside.",
            "secondary_message": null
          },
          {
            "id": 398750,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 398751,
            "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and cut into bite-sized pieces. Season with salt and pepper.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 398752,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the chicken and cook, stirring occasionally, until golden and almost cooked through, 3-4 minutes.",
            "secondary_message": "4 tsp toasted sesame oil"
          },
          {
            "id": 398753,
            "primary_message": "Add green onions and snap peas to the skillet. Cook, stirring occasionally, until the veggies are tender and chicken is cooked through, 3-4 minutes.",
            "secondary_message": null
          },
          {
            "id": 398754,
            "primary_message": "Meanwhile, using a clean cutting board, trim and halve cucumber lengthwise, then cut crosswise into thin half-moons.",
            "secondary_message": null
          },
          {
            "id": 398755,
            "primary_message": "When the chicken and veggies are done, add peanut sauce, water, and soy sauce to the skillet. Continue to cook, stirring occasionally, until sauce is warmed through and thickened slightly, 2-3 minutes more.",
            "secondary_message": "⅔ cup peanut sauce\n¼ cup water\n2 tbsp soy sauce"
          },
          {
            "id": 398756,
            "primary_message": "Add drained noodles to the skillet, toss to combine, and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 398757,
            "primary_message": "To serve, divide saucy noodles, chicken, and veggies between bowls; top with cucumber and carrots. Enjoy!",
            "secondary_message": "1 (10 oz) bag shredded carrots"
          }
        ],
