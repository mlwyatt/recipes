        "instructions": [
          {
            "id": 36366,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water to the saucepan; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n16 fl oz (2 cups) water"
          },
          {
            "id": 36367,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 crowns broccoli\n4 medium carrots\n2 (1 inch) pieces ginger root\n1 lime\n"
          },
          {
            "id": 36368,
            "primary_message": "Peel and grate or mince the ginger; transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 36369,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": ""
          },
          {
            "id": 36370,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 36371,
            "primary_message": "While the skillet heats up, drain and large dice the tofu (cut into ¾-inch cubes); place the cubes on paper towels or a clean towel and pat dry.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 36372,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom, then add the ginger and cook until fragrant, 15 to 30 seconds.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 36373,
            "primary_message": "Add the tofu to the skillet and season with salt and pepper; cook, stirring occasionally, until golden brown, 8 to 10 minutes. Once done, remove skillet from the heat.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 36374,
            "primary_message": "Cut the broccoli heads into small, bite-sized florets and thinly slice the thicker stem portions; transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 36375,
            "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Using a box grater, coarsely grate the carrots. Transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 40910,
            "primary_message": "Once the tofu has been transferred, add the broccoli to the skillet and cook until slightly softened, 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 36376,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl (that will be used to make the dressing).",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 36377,
            "primary_message": "Juice the lime and add to the garlic.",
            "secondary_message": null
          },
          {
            "id": 36378,
            "primary_message": "Add peanut butter, soy sauce, water, honey, and crushed red pepper to the garlic, and lime juice; whisk together until well combined.",
            "secondary_message": "6 tbsp natural peanut butter\n2 tbsp soy sauce\n4 tbsp water\n2 tsp honey\n¼ tsp crushed red pepper"
          },
          {
            "id": 36379,
            "primary_message": "To serve, arrange rice, tofu, broccoli, and carrots in a bowl, then drizzle with the peanut sauce, and sprinkle with the sesame seeds. Enjoy!",
            "secondary_message": "2 tsp sesame seeds"
          }
        ],
