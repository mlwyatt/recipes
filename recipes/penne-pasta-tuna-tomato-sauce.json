  "instructions": [
    {
      "id": 11066,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain.",
      "secondary_message": "about 14 cups water\n2 tbsp salt\n12 oz (4 ½ cups) penne pasta"
    },
    {
      "id": 11067,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 11068,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\r\n4 cloves garlic"
    },
    {
      "id": 11069,
      "primary_message": "Coat bottom of pan with oil. Add onion and, stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "about 2 tbsp extra virgin olive oil"
    },
    {
      "id": 11070,
      "primary_message": "Add garlic and pepper; cook until fragrant, 15-30 seconds.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 11071,
      "primary_message": "Add tomatoes, Italian seasoning, salt, and pepper; bring to a boil. Reduce heat to a simmer and cook until sauce begins to thicken, 5-6 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\r\n½ tsp Italian seasoning\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 11072,
      "primary_message": "Grate ¼ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 11073,
      "primary_message": "Drain tuna and stir into the sauce. Cook for an additional 2-3 minutes.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 11074,
      "primary_message": "Add pasta and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 11075,
      "primary_message": "To serve, place pasta in a bowl and sprinkle with Parmesan. Enjoy!",
      "secondary_message": ""
    }
  ],
