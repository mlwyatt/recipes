        "instructions": [
          {
            "id": 195985,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n2 yellow bell peppers\n2 red bell peppers\n2 sticks celery"
          },
          {
            "id": 195986,
            "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large pot.",
            "secondary_message": null
          },
          {
            "id": 195987,
            "primary_message": "Peel and mince garlic. Add to the pot along with coconut milk and salt; stir to combine. Bring to a simmer over medium heat and cook, stirring occasionally, until cauliflower is soft and creamy, 10-12 minutes. Remove from heat, cover, and set aside. ",
            "secondary_message": "4 cloves garlic\n1 (13.5 fl oz) can coconut milk\n1 tsp salt"
          },
          {
            "id": 195988,
            "primary_message": "Meanwhile, seed and slice peppers into strips; transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 195989,
            "primary_message": "Cut celery crosswise into ¼-inch pieces at an angle; add to the bowl with the peppers and set aside. ",
            "secondary_message": null
          },
          {
            "id": 195990,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 195991,
            "primary_message": "While the skillet heats up, pat steak dry with paper towels and thinly slice against the grain. Cut slices into bite-sized pieces.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak"
          },
          {
            "id": 195992,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
            "secondary_message": "2 tsp toasted sesame oil"
          },
          {
            "id": 195993,
            "primary_message": "Add steak and stir-fry until golden brown and cooked through, 3-4 minutes. Add peppers and celery; continue to cook, stirring often, until veggies begin to soften, 3-4 minutes more.",
            "secondary_message": null
          },
          {
            "id": 195994,
            "primary_message": "Meanwhile, place broth, soy sauce, vinegar, cornstarch, and pepper in the bowl used for the veggies; whisk to combine the sauce. ",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp soy sauce\n2 tbsp rice vinegar\n2 tsp cornstarch\n1 tsp black pepper"
          },
          {
            "id": 195995,
            "primary_message": "Pour sauce into the skillet. Reduce heat to medium and cook, stirring often, until the sauce thickens, 3-4 minutes.",
            "secondary_message": null
          },
          {
            "id": 195996,
            "primary_message": "To serve, divide cauliflower rice and stir-fry between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
