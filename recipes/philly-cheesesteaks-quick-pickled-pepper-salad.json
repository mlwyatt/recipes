  "instructions": [
    {
      "id": 186840,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a large baking sheet pan with aluminum foil. Turn on overhead exhaust fan or open a window (this may get a little smoky). ",
      "secondary_message": null
    },
    {
      "id": 186841,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 red bell peppers\n1 yellow bell pepper\n1 small pkg fresh basil\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 186842,
      "primary_message": "Seed and slice bell peppers into thin strips, transfer to the baking sheet, and drizzle with oil. Place in the oven and broil, until peppers are soft and lightly charred around the edges, 4-5 minutes. Remove from oven.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 186843,
      "primary_message": "Meanwhile, coarsely grate cheese and set aside.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 186844,
      "primary_message": "Combine vinegar, honey, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "¼ cup red wine vinegar\n4 tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 186845,
      "primary_message": "Transfer the cooked peppers to the bowl with the dressing and stir to combine; set aside.",
      "secondary_message": null
    },
    {
      "id": 186846,
      "primary_message": "Pat the steaks dry with paper towels and place on the baking sheet used for the peppers. Drizzle with oil and season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 186847,
      "primary_message": "Place steaks in the oven and broil, flipping halfway through, until desired doneness, 8-10 minutes for medium. Remove from oven and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 186848,
      "primary_message": "Meanwhile, whisk together flour, spices, and half of the milk in a small saucepan. Heat over medium, whisking frequently, until thick, about 2 minutes. Pour in remaining milk and whisk to combine.",
      "secondary_message": "4 tsp all-purpose flour\n¼ tsp onion powder\n¼ tsp garlic powder\n8 fl oz (1 cup) whole milk"
    },
    {
      "id": 186849,
      "primary_message": "Once the milk is steaming, remove from heat, and add the cheese. Continue whisking until the cheese has melted, creating a thick sauce, about 3 minutes; set aside.",
      "secondary_message": null
    },
    {
      "id": 186850,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the peppers and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 186851,
      "primary_message": "Split and toast the buns, if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 186852,
      "primary_message": "Thinly slice steak against the grain. Fill buns with steak and drizzle with cheese sauce.",
      "secondary_message": null
    },
    {
      "id": 186853,
      "primary_message": "To serve, divide cheesesteaks and mixed greens between plates. Top greens with roasted peppers and dressing. Enjoy!",
      "secondary_message": null
    }
  ],
