  "instructions": [
    {
      "id": 304857,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 304858,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 304859,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small pineapple\n1 small bunch green onions (scallions)\n4 sticks celery\n2 medium carrots\n2 (1 inch) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 304860,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 304861,
      "primary_message": "Trim and slice green onion and celery crosswise into ¼-inch pieces; add both to the bowl with the pineapple.",
      "secondary_message": null
    },
    {
      "id": 304862,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 304863,
      "primary_message": "Peel and mince ginger and garlic; add to the bowl and set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 304864,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 304865,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on the cutting board; thinly slice crosswise into bite-sized strips, then season with salt and pepper.",
      "secondary_message": "4 pork chops, boneless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 304866,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add pork and stir-fry until browned and cooked through, 3-4 minutes. Transfer to a plate. ",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "id": 304867,
      "primary_message": "When the pork is done, return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add pineapple, veggies, and edamame; stir-fry until veggies are fork-tender, 4-5 minutes.",
      "secondary_message": "4 tsp virgin coconut oil\n1 cup edamame, shelled"
    },
    {
      "id": 304868,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 304869,
      "primary_message": "When the veggies are done, add cooked rice, pork (with any accumulated juices), and soy sauce to the skillet; continue to cook, stirring constantly, until combined and heated through, 1-2 minutes more. Remove from heat, add cilantro, and stir to combine.",
      "secondary_message": "⅓ cup soy sauce"
    },
    {
      "id": 304870,
      "primary_message": "To serve, divide fried rice between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
