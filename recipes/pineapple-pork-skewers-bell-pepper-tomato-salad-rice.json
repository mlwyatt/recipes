        "instructions": [
          {
            "id": 397743,
            "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 397744,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n2 cup water"
          },
          {
            "id": 397745,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small pineapple\n1 small bunch cilantro\n2 limes\n2 orange bell peppers\n2 tomatoes"
          },
          {
            "id": 397746,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 397747,
            "primary_message": "While the rice is cooking, cut off skin from pineapple; quarter, core, and large dice the flesh. Place in a medium bowl. ",
            "secondary_message": null
          },
          {
            "id": 397748,
            "primary_message": "Pat the pork dry with paper towels and cut into 1-inch cubes. Add to the bowl with the pineapple along with oil and spices; stir to coat. ",
            "secondary_message": "4 pork chops, boneless\n2 tbsp extra virgin olive oil\n2 tsp chili powder\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 397749,
            "primary_message": "Thread pineapple and pork onto skewers, alternating ingredients; place on a plate. Alternatively, you can cook the pork and pineapple pieces directly on the grill pan without using skewers.",
            "secondary_message": null
          },
          {
            "id": 397750,
            "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 397751,
            "primary_message": "Once the pan is hot, working in batches if necessary, add the skewers and grill, turning occasionally, until pineapple is golden brown and pork is cooked through, about 10 minutes. Remove to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 397752,
            "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a clean medium bowl. ",
            "secondary_message": null
          },
          {
            "id": 397753,
            "primary_message": "Juice one lime into the bowl with the cilantro. (Cut remaining lime into wedges and set aside for serving.)",
            "secondary_message": null
          },
          {
            "id": 397754,
            "primary_message": "Peel and mince shallot. Add to the bowl along with oil, honey, and spices. Stir to combine the dressing. ",
            "secondary_message": "1 shallot\n4 tsp extra virgin olive oil\n2 tsp honey\n½ tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 397755,
            "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 397756,
            "primary_message": "Small dice tomatoes. Add to the bowl and stir to combine the salad. ",
            "secondary_message": null
          },
          {
            "id": 397757,
            "primary_message": "Divide rice, salad, and skewers between plates. Serve with lime wedges on the side. Enjoy!",
            "secondary_message": null
          }
        ],
