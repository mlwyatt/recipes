        "instructions": [
          {
            "id": 234252,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt; bring the mixture to a boil over high heat.",
            "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
          },
          {
            "id": 234253,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 small pineapple\n2 (1 inch) pieces ginger root\n2 crowns broccoli\n1 small bunch green onions (scallions)"
          },
          {
            "id": 234254,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 234255,
            "primary_message": "Meanwhile, cut skin off pineapple, core, and medium dice (cut into ¾-inch cubes). Add a 1 cup diced pineapple to a blender; set remaining pineapple aside in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 234256,
            "primary_message": "Peel the garlic and ginger; add to the blender along with soy sauce, honey, vinegar, and pepper. Blend on high until smooth. Set teriyaki sauce aside.",
            "secondary_message": "2 cloves garlic\n⅓ cup soy sauce\n2 tbsp honey\n¼ cup rice vinegar\n¼ tsp black pepper"
          },
          {
            "id": 234257,
            "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin. If you don’t have a tail end, start at one corner of the fillet and work your way in until the knife is between the skin and flesh. ",
            "secondary_message": "1 ½ lb salmon fillet"
          },
          {
            "id": 234258,
            "primary_message": "Cut salmon into bite-sized pieces. ",
            "secondary_message": null
          },
          {
            "id": 234259,
            "primary_message": "Preheat a large nonstick skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tsp virgin coconut oil"
          },
          {
            "id": 234260,
            "primary_message": "Add salmon to the skillet; cook, stirring occasionally, until almost cooked through, 2-3 minutes. Transfer to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 234261,
            "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces.",
            "secondary_message": null
          },
          {
            "id": 234262,
            "primary_message": "Return skillet to the stove over medium heat. Add more oil to melt. Add broccoli and cook, stirring often, until slightly softened, 1-2 minutes.",
            "secondary_message": "2 tsp virgin coconut oil"
          },
          {
            "id": 234263,
            "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
            "secondary_message": "¼ cup water\n4 tsp cornstarch"
          },
          {
            "id": 234264,
            "primary_message": "Add diced pineapple and teriyaki sauce to the skillet. Increase heat to high and add the cornstarch slurry in a steady stream while stirring quickly. Cook, stirring often, until sauce thickens, 2-3 minutes. ",
            "secondary_message": null
          },
          {
            "id": 234265,
            "primary_message": "Add salmon back to the skillet; gently stir to combine and heat through, about 1 minute. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 234266,
            "primary_message": "Trim off and discard the ends of the green onions; cut the crosswise into ¼-inch pieces at an angle.",
            "secondary_message": null
          },
          {
            "id": 234267,
            "primary_message": "To serve, divide rice and salmon stir-fry between bowls. Garnish with green onion and enjoy!",
            "secondary_message": null
          }
        ],
