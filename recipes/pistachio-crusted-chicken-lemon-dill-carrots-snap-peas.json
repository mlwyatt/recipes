        "instructions": [
          {
            "id": 246013,
            "primary_message": "Preheat oven to 425°F. Coat a large baking sheet pan with a thin layer of oil and set aside.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 246014,
            "primary_message": "Finely chop pistachios and place in a medium bowl. Add spices and stir to combine the coating.",
            "secondary_message": "1 cup pistachios, unsalted\n2 tsp paprika\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 246015,
            "primary_message": "Crack eggs into another medium bowl and beat with a whisk or fork.",
            "secondary_message": "2 eggs"
          },
          {
            "id": 246016,
            "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 246017,
            "primary_message": "Working one by one, dip chicken cutlets into the egg, shake off excess, then dredge in the pistachio coating, pressing to adhere. Transfer to the baking sheet.",
            "secondary_message": null
          },
          {
            "id": 246018,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until the chicken is golden and cooked through, 15-18 minutes.",
            "secondary_message": null
          },
          {
            "id": 246019,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "4 medium carrots\n2 (8 oz) pkg sugar snap peas\n1 lemon"
          },
          {
            "id": 246020,
            "primary_message": "Using a clean cutting board, peel, trim, and slice carrots crosswise into thin rounds.",
            "secondary_message": null
          },
          {
            "id": 246021,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 246022,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the carrots and snap peas; cook, stirring occasionally, until starting to soften, about 4 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 246023,
            "primary_message": "Zest lemon into the skillet and add spices; continue to cook, stirring occasionally, until veggies are fork-tender, 2 minutes more.",
            "secondary_message": "1 tsp dill, dried\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 246024,
            "primary_message": "Meanwhile, cut lemon into wedges for serving.",
            "secondary_message": null
          },
          {
            "id": 246025,
            "primary_message": "To serve, divide chicken and veggies between plates. Squeeze lemon over the chicken and enjoy!",
            "secondary_message": null
          }
        ],
