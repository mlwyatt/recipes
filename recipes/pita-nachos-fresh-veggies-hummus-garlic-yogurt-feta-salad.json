        "instructions": [
          {
            "id": 269765,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 269766,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "2 lemons\n2 tomatoes\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 269767,
            "primary_message": "Place pita breads on a cutting board. Holding a knife parallel to the board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces and place on a large baking sheet pan. ",
            "secondary_message": "4 whole grain pitas"
          },
          {
            "id": 269768,
            "primary_message": "Zest lemons into a small bowl (set lemons aside for later use). Add oil and spices to the bowl; stir to combine the herb oil. ",
            "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp oregano, dried\n½ tsp thyme, dried"
          },
          {
            "id": 269769,
            "primary_message": "Spoon herb oil over the pita, toss with your hands to coat, then spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until the pita chips are crisp, 6-8 minutes. Remove from the oven. (Reserve bowl for next step.)",
            "secondary_message": null
          },
          {
            "id": 269770,
            "primary_message": "Meanwhile, peel and mince garlic. Place in the reserved bowl along with yogurt, water, vinegar, and spices; whisk to combine the garlic yogurt and set aside.",
            "secondary_message": "2 cloves garlic\n1 cup plain Greek yogurt\n2 tbsp water\n2 tsp red wine vinegar\n½ tsp dill, dried\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 269771,
            "primary_message": "Peel additional garlic and place in a blender.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 269772,
            "primary_message": "Juice one lemon into the blender with the garlic (reserve remaining lemon for the salad dressing).",
            "secondary_message": null
          },
          {
            "id": 269773,
            "primary_message": "Drain and rinse chickpeas; add to the blender along with water, tahini, and spices. Blend on high until hummus is smooth; set aside.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n½ cup water\n2 tbsp tahini\n½ tsp salt\n¼ tsp cumin, ground\n¼ tsp paprika"
          },
          {
            "id": 269774,
            "primary_message": "Trim and small dice cucumber; small dice tomatoes. Place both in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 269775,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the cucumber and tomato; stir to combine the veggie topping and set aside.",
            "secondary_message": null
          },
          {
            "id": 269776,
            "primary_message": "Juice remaining lemon into another medium bowl. Add oil, honey, and spices; whisk to combine the dressing. Add mixed greens and toss to combine the salad.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tsp honey\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp oregano, dried"
          },
          {
            "id": 269777,
            "primary_message": "To assemble the \"nachos,\" spoon hummus, garlic yogurt, and veggie topping over the pita chips. Sprinkle with feta.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 269778,
            "primary_message": "To serve, divide \"nachos\" and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
