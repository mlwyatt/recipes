  "instructions": [
    {
      "id": 182304,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 182305,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 182306,
      "primary_message": "Place chicken, salt, and pepper in a large pot and cover with water by 1-inch; bring to a boil. Reduce heat and simmer until chicken is cooked through, 8-10 minutes. Transfer chicken to a plate to cool.",
      "secondary_message": "1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 182307,
      "primary_message": "Using a clean cutting board, peel and mince garlic; transfer to a medium bowl. Add oil and spices, then whisk to combine.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n½ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 182308,
      "primary_message": "Cut bread into bite-sized pieces and add to the bowl; toss to coat. Transfer to a baking sheet pan. Reserve bowl for later use.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 182309,
      "primary_message": "Place croutons in the oven and cook, tossing halfway through, until golden and crisp, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 182310,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "4 sticks celery\n2 lemons\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 182311,
      "primary_message": "Trim and medium dice celery; place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 182312,
      "primary_message": "Zest lemons into the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 182313,
      "primary_message": "Roughly chop pistachios; add to the bowl along with yogurt, cranberries, and spices. Stir to combine and set aside.",
      "secondary_message": "½ cup pistachios, unsalted\n1 cup plain Greek yogurt\n½ cup dried cranberries\n½ tsp thyme\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 182314,
      "primary_message": "Juice the lemons into a large bowl. Add oil and whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 182315,
      "primary_message": "Add mixed greens and croutons to the bowl with the dressing; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 182316,
      "primary_message": "Using two forks, shred chicken and add to the bowl with the yogurt mixture. Mix well to combine.",
      "secondary_message": null
    },
    {
      "id": 182317,
      "primary_message": "To serve, place salad greens on a plate and top with chicken salad. Enjoy!",
      "secondary_message": null
    }
  ],
