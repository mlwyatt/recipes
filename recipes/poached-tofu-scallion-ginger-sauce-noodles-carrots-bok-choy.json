        "instructions": [
          {
            "id": 486036,
            "primary_message": "Cut tofu in half along the short side to make 4 smaller \"blocks.\" Place in a large pot and cover with hot water (from the tap). Bring to a boil over high heat. Once boiling, reduce to a simmer and cook until tofu is warmed through, about 15 minutes.",
            "secondary_message": "2 (12 oz) pkgs extra firm tofu"
          },
          {
            "id": 486037,
            "primary_message": "Meanwhile, fill another large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 486038,
            "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n8 baby bok choy\n4 medium carrots"
          },
          {
            "id": 486039,
            "primary_message": "Once the water in the pot is boiling, remove from heat. Carefully pour water into a large, heat-proof bowl, and add rice noodles. Soak for 10 minutes (or prepare according to package instructions). Drain in a colander and set aside. (Reserve pot for later use.)",
            "secondary_message": "10 oz flat rice (pad thai) noodles"
          },
          {
            "id": 486040,
            "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 486041,
            "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the ginger and garlic along with soy sauce, oil, sugar, and crushed red pepper. Stir to combine the sauce and set aside.",
            "secondary_message": "¼ cup soy sauce\n2 tbsp toasted sesame oil\n2 tsp brown sugar\n1 tsp crushed red pepper"
          },
          {
            "id": 486042,
            "primary_message": "Trim and separate bok choy into leaves. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 486043,
            "primary_message": "Peel and trim carrots; run the peeler along each carrot to make long, noodle-like strips. Add to the bowl with the bok choy.",
            "secondary_message": null
          },
          {
            "id": 486044,
            "primary_message": "Return pot to medium-high heat. Once hot, add oil and swirl to coat the bottom; add bok choy, carrot, and soy sauce. Stir-fry until veggies are fork-tender, about 4 minutes.",
            "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp soy sauce"
          },
          {
            "id": 486045,
            "primary_message": "Add drained noodles to the pot and stir to combine. Continue to cook, stirring occasionally, until warmed through, 1-2 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 486046,
            "primary_message": "To serve, divide noodles and veggies between bowls. Top with poached tofu and drizzle with sauce. Enjoy!",
            "secondary_message": null
          }
        ],
