        "instructions": [
          {
            "id": 314871,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 314872,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "1 small head red cabbage\n2 pears\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 314873,
            "primary_message": "Place Dijon, oil, water, honey, salt, and pepper in a medium bowl; whisk to combine the Dijon sauce. ",
            "secondary_message": "2 tbsp Dijon mustard\n4 tsp extra virgin olive oil\n4 tsp water\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 314874,
            "primary_message": "Halve cabbage lengthwise and cut out the core; slice crosswise into 1-inch thick wedges. Transfer to a large baking sheet pan, then drizzle both sides of the cabbage with Dijon sauce. (Reserve bowl for later use.) ",
            "secondary_message": null
          },
          {
            "id": 314875,
            "primary_message": "Place baking sheet in the oven and roast, gently flipping cabbage halfway through, until tender and golden around the edges, 18-20 minutes. Remove from oven. ",
            "secondary_message": null
          },
          {
            "id": 314876,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 314877,
            "primary_message": "While the skillet heats up, pat pork chops dry with paper towels. Place on a plate and season both sides with salt and pepper. ",
            "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 314878,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 314879,
            "primary_message": "While the chops are cooking, place oil, vinegar, Dijon, and salt in the reserved bowl; whisk to combine the dressing. ",
            "secondary_message": "4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp Dijon mustard\n¼ tsp salt"
          },
          {
            "id": 314880,
            "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the bowl with the dressing and toss to combine. ",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 314881,
            "primary_message": "Quarter, core, and thinly slice pears; add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 314882,
            "primary_message": "Roughly chop walnuts and add to the bowl. ",
            "secondary_message": "¼ cup walnuts"
          },
          {
            "id": 314883,
            "primary_message": "Just before serving, add arugula and blue cheese to the bowl; toss to combine the salad. ",
            "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
          },
          {
            "id": 314884,
            "primary_message": "To serve, divide roasted cabbage, chops, and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
