        "instructions": [
          {
            "id": 282108,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "1 ½ lb new potatoes\n2 Granny Smith apples\n1 pint grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 282109,
            "primary_message": "Halve potatoes, place in a medium saucepan, cover with hot water (from the tap), and bring to a boil. Once boiling, reduce heat to medium and simmer until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to the saucepan; cover to keep warm. ",
            "secondary_message": null
          },
          {
            "id": 282110,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 282111,
            "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, boneless\n1 tsp salt\n1 tsp black pepper"
          },
          {
            "id": 282112,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
            "secondary_message": "4 tsp butter, unsalted"
          },
          {
            "id": 282113,
            "primary_message": "While the chops are cooking, peel, halve, and thinly slice onions into half-moons; peel and mince garlic. Place both in a medium bowl. ",
            "secondary_message": "2 medium yellow onions\n4 cloves garlic"
          },
          {
            "id": 282114,
            "primary_message": "Quarter and core apples, then slice into ¼-inch thick wedges; add to the bowl with the onion and garlic. ",
            "secondary_message": null
          },
          {
            "id": 282115,
            "primary_message": "When the chops are done, return the skillet (with cooking juices) to medium-low heat. Add onion, garlic, and apple; cook, stirring occasionally, until the onion and apple are soft, 4-5 minutes. (Reserve bowl for the next step.)",
            "secondary_message": null
          },
          {
            "id": 282116,
            "primary_message": "Meanwhile, place vinegar, mayo, Dijon, honey, salt, and pepper in the reserved bowl; whisk to combine the dressing. ",
            "secondary_message": "4 tsp apple cider vinegar\n2 tsp mayonnaise\n2 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 282117,
            "primary_message": "Halve tomatoes lengthwise and add to the bowl with the dressing; set aside. ",
            "secondary_message": null
          },
          {
            "id": 282118,
            "primary_message": "When the onion and apple are soft, add broth, Dijon, and honey to the skillet; bring to a simmer and cook, stirring occasionally, until slightly thickened, 3-4 minutes. Remove from heat. ",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n4 tsp Dijon mustard\n2 tsp honey"
          },
          {
            "id": 282119,
            "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
            "secondary_message": null
          },
          {
            "id": 282120,
            "primary_message": "Return the saucepan with potatoes to low heat; add butter, parsley, and salt. Cook, stirring frequently, until butter and parsley coat the potatoes, 2-3 minutes. Remove from heat.",
            "secondary_message": "2 tbsp butter, unsalted\n¼ tsp salt"
          },
          {
            "id": 282121,
            "primary_message": "Add mixed greens to bowl with dressing and tomatoes; toss to combine the salad. ",
            "secondary_message": null
          },
          {
            "id": 282122,
            "primary_message": "To serve, divide pork chops, apple sauté, potatoes, and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
