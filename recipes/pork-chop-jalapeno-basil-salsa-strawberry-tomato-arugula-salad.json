        "instructions": [
          {
            "id": 258325,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "1 lime\n2 jalapeño peppers\n1 small pkg fresh basil\n1 (16 oz) pkg strawberries\n1 pint grape tomatoes\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 258326,
            "primary_message": "Juice lime into a small bowl.",
            "secondary_message": null
          },
          {
            "id": 258327,
            "primary_message": "Peel and mince garlic and shallots; add to the bowl with the lime juice along with oil, honey, and salt.",
            "secondary_message": "2 cloves garlic\n2 shallots\n3 tbsp extra virgin olive oil\n2 tsp honey\n½ tsp salt"
          },
          {
            "id": 258328,
            "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 258329,
            "primary_message": "Pick basil leaves off the stems, discard stems, and mince the leaves. Add to the bowl and stir to combine the salsa; set aside.",
            "secondary_message": null
          },
          {
            "id": 258330,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 258331,
            "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 258332,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer chops to a clean plate and loosely cover with aluminum foil.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 258333,
            "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
            "secondary_message": "4 tsp extra virgin olive oil\n4 tsp balsamic vinegar\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 258334,
            "primary_message": "Trim and quarter strawberries lengthwise; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 258335,
            "primary_message": "Halve tomatoes; add to the bowl along with the arugula and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 258336,
            "primary_message": "To serve, divide pork chops and salad between plates; spoon salsa over the chops and enjoy!",
            "secondary_message": null
          }
        ],
