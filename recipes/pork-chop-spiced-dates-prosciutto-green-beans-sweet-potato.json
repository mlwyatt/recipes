        "instructions": [
          {
            "id": 311906,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 311907,
            "primary_message": "Wash and dry sweet potatoes, then peel and large dice; place on a large baking sheet pan, drizzle with oil, and season with spices. Toss to combine and spread out in an even layer on one half of the baking sheet.",
            "secondary_message": "1 lb sweet potato\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper\n¼ tsp cinnamon, ground"
          },
          {
            "id": 311908,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until sweet potatoes start to soften, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 311909,
            "primary_message": "Meanwhile, peel and mince garlic; mince dates. Place both in a small bowl along with oil and spices; stir to combine the date topping and set aside.",
            "secondary_message": "2 cloves garlic\n¼ cup medjool dates, pitted\n2 tsp extra virgin olive oil\n½ tsp cinnamon, ground\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 311910,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 311911,
            "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, boneless\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 311912,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add chops and cook until golden, about 2 minutes per side. Once golden, transfer to a clean plate (the pork will not be cooked all the way through). Reserve skillet with juices for later use.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 311913,
            "primary_message": "Divide date topping between chops and layer each with two slices of prosciutto.",
            "secondary_message": "8 slices prosciutto"
          },
          {
            "id": 311914,
            "primary_message": "Remove sweet potatoes from the oven and toss; add layered pork chops to the other half of the baking sheet. Return baking sheet to the oven and roast until sweet potatoes are tender and chops are cooked through, 8-10 minutes more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 311915,
            "primary_message": "Meanwhile, wash, dry, and trim green beans.",
            "secondary_message": "1 lb green beans"
          },
          {
            "id": 311916,
            "primary_message": "Peel and mince additional garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 311917,
            "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom; add beans and salt. Stir-fry until lightly charred and fork-tender, 3-4 minutes. Add garlic and continue to cook, stirring constantly, until fragrant, about 30 seconds; remove from heat.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 311918,
            "primary_message": "To serve, divide layered pork chops, sweet potatoes, and green beans between plates. Enjoy!",
            "secondary_message": null
          }
        ],
