  "instructions": [
    {
      "id": 48200,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 pears"
    },
    {
      "id": 48201,
      "primary_message": "Quarter the pears lengthwise, then cut out the core and stem from each section; cut each quarter lengthwise into 4 thin wedges.",
      "secondary_message": null
    },
    {
      "id": 48202,
      "primary_message": "Trim off and discard the ends of the onions and remove the outer layer; halve lengthwise, then cut the halves into 4 wedges.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 48203,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 48204,
      "primary_message": "Halve the pork chops horizontally to form thin fillets; pat dry with paper towels and place on a plate. Season generously with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 48205,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 48206,
      "primary_message": "Place the pork fillets in the skillet; cook until golden brown, 3 to 4 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 48207,
      "primary_message": "Once the pork has been transferred, reduce the heat to medium. Add the pears and onions to the skillet; cook, stirring frequently, until they are softened and lightly browned, 4 to 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 48208,
      "primary_message": "Add broth to the skillet and scrape up any browned bits from the bottom.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 48209,
      "primary_message": "Return the pork fillets to the skillet and arrange among the pears and onions.",
      "secondary_message": null
    },
    {
      "id": 48210,
      "primary_message": "Top the mixture with blue cheese and continue to cook until the pork is cooked through and the cheese begins to melt.",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
    },
    {
      "id": 48211,
      "primary_message": "To serve, divide the pork and pear mixture between plates and spoon the pan sauce overtop. Enjoy!",
      "secondary_message": null
    }
  ],
