        "instructions": [
          {
            "id": 46548,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb Brussels sprouts\n2 Gala apples"
          },
          {
            "id": 46549,
            "primary_message": "Trim off and discard the ends of the shallots; peel and small dice the shallots (cut into ¼-inch pieces). Transfer to a small bowl.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 46550,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 46551,
            "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "4 pork chops, bone-in\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 46552,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 46553,
            "primary_message": "Place the pork chops in the skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
            "secondary_message": null
          },
          {
            "id": 46554,
            "primary_message": "While the pork chops cook, trim off and discard the stems ends of the Brussels sprouts, then remove the outer layer of leaves; quarter the sprouts lengthwise.",
            "secondary_message": null
          },
          {
            "id": 46555,
            "primary_message": "Once the pork has been transferred, add the shallots to the skillet; cook, stirring frequently, until softened, 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 46556,
            "primary_message": "Add the Brussels sprouts to the skillet; cook until they have a nice sear on one side, 4 to 6 minutes. Then, give them a stir and continue cooking until they are browned all over and tender on the inside, another 4 to 6 minutes.",
            "secondary_message": ""
          },
          {
            "id": 46557,
            "primary_message": "While the Brussels sprouts cook, quarter the apples lengthwise, then cut out the core and stem from each section; large dice the apples (cut into ¾-inch cubes).",
            "secondary_message": null
          },
          {
            "id": 46558,
            "primary_message": "In the last few minutes of cooking time, add the apples to the Brussels sprouts; cook, stirring occasionally, until the apples are softened, 3 to 4 minutes.",
            "secondary_message": ""
          },
          {
            "id": 46559,
            "primary_message": "Drizzle the sprouts and apples with apple cider vinegar and season with salt and pepper; toss to combine.",
            "secondary_message": "1 tbsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 46560,
            "primary_message": "To serve, divide the pork chops and the sautéed Brussels sprouts and apples between plates. Add a dollop of Dijon to the side for dipping the pork if desired. Enjoy!",
            "secondary_message": null
          }
        ],
