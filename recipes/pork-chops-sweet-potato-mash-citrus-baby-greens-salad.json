  "instructions": [
    {
      "id": 20762,
      "primary_message": "Wash and medium dice sweet potatoes (without peeling). Place in a medium saucepan, cover with water, and bring to a boil. Cook until tender, 10-15 minutes.",
      "secondary_message": "1 ½ lb sweet potatoes"
    },
    {
      "id": 20763,
      "primary_message": "Heat broiler and position rack about 6 inches from the top.",
      "secondary_message": ""
    },
    {
      "id": 20764,
      "primary_message": "Place pork chops in a baking dish. Rub with olive oil and season with salt and pepper.",
      "secondary_message": "4 pork chops, boneless\r\n2 tsp extra virgin olive oil\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 20765,
      "primary_message": "Place in the oven and broil until pork is cooked through, 7-9 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 20766,
      "primary_message": "Wash and dry greens. Transfer to a medium bowl.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 20767,
      "primary_message": "Slice off top and bottom from oranges, then cut off the skin and white pith from the sides so you can see the orange flesh. Cut in between the membranes to release the segments and add to bowl with greens.",
      "secondary_message": "2 oranges"
    },
    {
      "id": 20768,
      "primary_message": "Add cranberries to bowl with greens and orange.",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 20769,
      "primary_message": "In a small bowl, prepare salad dressing by whisking together olive oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\r\n1 tbsp white wine vinegar\r\n¼ tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 20770,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 20771,
      "primary_message": "Drain potatoes and return to saucepan. Add broth, olive oil, garlic, salt, and pepper; mash until smooth.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 20772,
      "primary_message": "Serve pork with mash and salad on the side. Drizzle dressing over salad and enjoy!",
      "secondary_message": ""
    }
  ],
