        "instructions": [
          {
            "id": 19802,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "about 14 cups water\n2 tbsp salt\n12 oz (1 quarter coin = 2 oz) linguine pasta"
          },
          {
            "id": 19803,
            "primary_message": "In a medium bowl, whisk together soy sauce, vinegar, sesame oil, cornstarch, honey, and crushed red pepper. Set aside.",
            "secondary_message": "4 tbsp soy sauce\n2 tbsp rice vinegar\n2 tsp toasted sesame oil\n2 tsp cornstarch\n½ tsp honey\n¼ tsp crushed red pepper"
          },
          {
            "id": 19804,
            "primary_message": "Thinly slice pork crosswise into strips; transfer to a small bowl.",
            "secondary_message": "4 pork chops, boneless"
          },
          {
            "id": 19805,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 19806,
            "primary_message": "Peel and mince garlic. Peel and mince or grate ginger.",
            "secondary_message": "6 cloves garlic\r\n2 (1 inch) pieces ginger root"
          },
          {
            "id": 19807,
            "primary_message": "Wash peas and bell peppers. Seed and slice the peppers into strips.",
            "secondary_message": "2 (8 oz) pkg sugar snap peas\r\n2 orange bell peppers"
          },
          {
            "id": 19808,
            "primary_message": "Coat bottom of skillet with oil. Add pork and stir fry until no longer pink, 2-3 minutes. Transfer to a plate.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 19809,
            "primary_message": "Once pork has been transferred, coat skillet with more oil. Add garlic, ginger, peas, and peppers; stir fry until peas are bright green and peppers are tender-crisp, 2-3 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 19810,
            "primary_message": "Drain pasta in a colander.",
            "secondary_message": ""
          },
          {
            "id": 19811,
            "primary_message": "Add pork, pasta, and sauce to skillet. Toss until noodles are well coated and sauce thickens, 1-2 minutes.",
            "secondary_message": ""
          },
          {
            "id": 19812,
            "primary_message": "To serve, place lo mein on a plate and enjoy!",
            "secondary_message": ""
          }
        ],
