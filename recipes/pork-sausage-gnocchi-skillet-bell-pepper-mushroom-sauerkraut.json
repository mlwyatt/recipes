  "instructions": [
    {
      "id": 467295,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 467296,
      "primary_message": "Meanwhile, peel, halve, and slice onion crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 467297,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "2 (16 oz) pkgs potato gnocchi\n1 tsp salt"
    },
    {
      "id": 467298,
      "primary_message": "While the gnocchi are cooking, wash, dry, trim, and seed bell pepper; medium dice. Add bell pepper and mushrooms to the bowl with the onion.",
      "secondary_message": "1 red bell pepper\n2 (8 oz) pkgs sliced white mushrooms"
    },
    {
      "id": 467299,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467300,
      "primary_message": "While the skillet heats up, slice sausages crosswise into 1-inch thick rounds.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 467301,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, sausage, salt, and pepper; cook, stirring occasionally, until veggies soften and sausage is cooked through, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 467302,
      "primary_message": "Meanwhile, drain sauerkraut in a colander to remove excess liquid.",
      "secondary_message": "1 ⅓ cups sauerkraut"
    },
    {
      "id": 467303,
      "primary_message": "When the veggies and sausage are done, add cooked gnocchi and sauerkraut to the skillet; stir to combine. Continue to cook, stirring occasionally, until gnocchi are warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 467304,
      "primary_message": "To serve, divide gnocchi, sausage, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
