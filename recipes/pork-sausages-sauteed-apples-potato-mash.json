        "instructions": [
          {
            "id": 48521,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium yellow potatoes\n4 Granny Smith apples"
          },
          {
            "id": 48522,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 48523,
            "primary_message": "Peel the potatoes, then halve lengthwise and crosswise; transfer the quarters to a small saucepan. Cover with hot water (from the tap) by about 1 inch and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 48524,
            "primary_message": "Place the sausages on a plate and rub with a little olive oil.",
            "secondary_message": "6 pork sausages\n1 tbsp extra virgin olive oil"
          },
          {
            "id": 48525,
            "primary_message": "Once the skillet is hot, add the sausages. Cook, turning occasionally, until the sausages are browned and cooked through, 10 to 15 minutes. Once done, transfer to a plate and cover with foil to keep warm.",
            "secondary_message": null
          },
          {
            "id": 48526,
            "primary_message": "Quarter the apples lengthwise, then cut out the core and stem from each section; cut each quarter lengthwise into 4 thin wedges.",
            "secondary_message": null
          },
          {
            "id": 48527,
            "primary_message": "Once the water in the saucepan is boiling, reduce the heat to medium and cook until the potatoes are tender when pierced with a knife, 8 to 12 minutes. Once done, reserve about 1 cup of liquid and drain the rest. Cover the saucepan to keep warm.",
            "secondary_message": null
          },
          {
            "id": 48528,
            "primary_message": "Once the sausages have been transferred, add the apples to the skillet. Cook, stirring frequently, until they are lightly browned and softened, 4 to 6 minutes. Once done, remove from the heat.",
            "secondary_message": null
          },
          {
            "id": 48529,
            "primary_message": "Add ½ of the reserved liquid, butter, salt, and pepper to the potatoes; mash with a potato masher until smooth. Add more liquid to thin out the mash if needed.",
            "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 48530,
            "primary_message": "To serve, divide the mashed potatoes, sautéed apples, and sausages between plates. Enjoy!",
            "secondary_message": null
          }
        ],
