        "instructions": [
          {
            "id": 413911,
            "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
            "secondary_message": null
          },
          {
            "id": 413912,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "1 jalapeño pepper\n2 (6 oz) pkgs blueberries\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 413913,
            "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and place in a medium saucepan. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 413914,
            "primary_message": "Add blueberries to the pan with the jalapeño along with maple syrup, vinegar, ketchup, Worcestershire, and salt. Stir to combine.",
            "secondary_message": "2 tbsp pure maple syrup\n2 tbsp apple cider vinegar\n2 tbsp ketchup\n1 tsp Worcestershire sauce\n¼ tsp salt"
          },
          {
            "id": 413915,
            "primary_message": "Set pan over high heat and bring to a boil. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until saucy and thickened, 6-8 minutes. Remove from heat and allow to cool slightly.",
            "secondary_message": null
          },
          {
            "id": 413916,
            "primary_message": "Meanwhile, pat the pork dry with paper towels and cut into 1-inch cubes. Place in a medium bowl along with oil and spices; stir to coat.",
            "secondary_message": "4 pork chops, boneless\n2 tbsp extra virgin olive oil\n1 ½ tsp paprika\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 413917,
            "primary_message": "Thread pork onto skewers and place on a plate. Alternatively, you can cook the pork pieces directly on the grill pan without using skewers. ",
            "secondary_message": null
          },
          {
            "id": 413918,
            "primary_message": "Preheat a grill pan, outdoor skillet, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 413919,
            "primary_message": "Once the pan is hot, add the skewers and grill, turning occasionally, until pork is cooked through, about 8 minutes. Remove to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 413920,
            "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in a clean medium bowl along with oil, vinegar, Dijon, salt, and pepper; stir to combine the dressing.",
            "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 413921,
            "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl with dressing.",
            "secondary_message": "1 cup frozen corn"
          },
          {
            "id": 413922,
            "primary_message": "Roughly chop pecans. Add to the bowl along with mixed greens and feta. Gently toss to combine the salad.",
            "secondary_message": "¼ cup pecan halves\n1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 413923,
            "primary_message": "To serve, divide skewers and salad between plates. Top skewers with sauce and enjoy!",
            "secondary_message": null
          }
        ],
