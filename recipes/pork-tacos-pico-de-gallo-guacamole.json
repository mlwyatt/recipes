        "instructions": [
          {
            "id": 29527,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 pints grape tomatoes\n2 avocados\n2 jalapeño peppers\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 29528,
            "primary_message": "Quarter the tomatoes and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 29529,
            "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the seeds and white membranes. Finely dice the peppers and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 29530,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add half of the cilantro to the bowl with the tomatoes and pepper and transfer the rest to a small bowl (for the guacamole).",
            "secondary_message": null
          },
          {
            "id": 29531,
            "primary_message": "Peel and small dice the onion; add to the medium bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 29532,
            "primary_message": "Peel and mince the garlic; add half to the medium bowl and the other half to the small bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 29533,
            "primary_message": "Halve the avocados lengthwise and twist to open, then remove the pit with a knife or spoon; scoop out and large dice the flesh. Add to the small bowl.",
            "secondary_message": ""
          },
          {
            "id": 29534,
            "primary_message": "Juice the limes and divide between the two bowls.",
            "secondary_message": null
          },
          {
            "id": 29535,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 29536,
            "primary_message": "Slice the pork chops crosswise into thin strips and transfer to a medium bowl.",
            "secondary_message": "4 pork chops, boneless"
          },
          {
            "id": 29537,
            "primary_message": "Season the pork with chili powder, salt, and pepper; toss to coat.",
            "secondary_message": "2 tsp chili powder\n1 tsp salt\n1 tsp black pepper"
          },
          {
            "id": 29538,
            "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 29539,
            "primary_message": "Place the pork strips in the skillet; cook until browned and cooked through, 2 to 3 minutes per side.",
            "secondary_message": null
          },
          {
            "id": 29540,
            "primary_message": "Season the salsa with salt and mix to combine.",
            "secondary_message": "½ tsp salt"
          },
          {
            "id": 29541,
            "primary_message": "Season the guacamole with salt and pepper; mash with a fork until smooth.",
            "secondary_message": "½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 29542,
            "primary_message": "Wrap the tortillas in a damp towel and microwave until heated through, 30 to 60 seconds.",
            "secondary_message": "16 small corn tortillas"
          },
          {
            "id": 29543,
            "primary_message": "To serve, spread the guacamole in the middle of the tortillas, add the pork strips, and top with the pico de gallo. Enjoy!",
            "secondary_message": null
          }
        ],
