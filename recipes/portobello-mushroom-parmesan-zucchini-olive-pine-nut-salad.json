  "instructions": [
    {
      "id": 454664,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 454665,
      "primary_message": "Wash, dry, and remove stems from portobello mushrooms, then carefully scrape out the gills. Transfer to a baking sheet pan, rub with oil, and season with salt and pepper on both sides; arrange cap-side up.",
      "secondary_message": "8 caps portobello mushrooms\n4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 454666,
      "primary_message": "Place mushrooms in the oven and broil until starting to soften, about 6 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 454667,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a medium saucepan along with tomato sauce, crushed red pepper, and salt. Stir to combine the sauce and bring to a simmer over high heat. Once simmering, remove from heat and set aside.",
      "secondary_message": "2 cloves garlic\n2 (8 oz) cans tomato sauce\n½ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 454668,
      "primary_message": "While the sauce is heating, finely grate Parmesan. Place in a medium bowl along with bread crumbs and spices, then stir to combine the Parmesan topping.",
      "secondary_message": "4 oz Parmesan cheese\n1 cup panko bread crumbs\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 454669,
      "primary_message": "Using tongs, carefully flip the mushrooms, cap-side down. Spread evenly with warm tomato sauce and sprinkle with Parmesan topping. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 454670,
      "primary_message": "Return baking sheet to the oven and continue to broil until the mushrooms are soft and cheese topping is golden brown, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 454671,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 454672,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 454673,
      "primary_message": "Roughly chop olives. Add to the bowl.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 454674,
      "primary_message": "Wash, dry, and trim zucchini, then run a vegetable peeler along the length of the zucchini to make ribbons. Add to the bowl, along with the pine nuts, and toss to combine the salad.",
      "secondary_message": "4 medium zucchini squash\n½ cup pine nuts"
    },
    {
      "id": 454675,
      "primary_message": "To serve, divide the mushrooms and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
