        "instructions": [
          {
            "id": 171653,
            "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
            "secondary_message": "4 caps portobello mushrooms\n1 small pkg fresh basil\n2 tomatoes\n2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 171654,
            "primary_message": "In a medium bowl, prepare the dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
            "secondary_message": "½ cup extra virgin olive oil\n¼ cup balsamic vinegar\n2 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 171655,
            "primary_message": "Remove the stems of the mushrooms and carefully scrape out the gills using a spoon.",
            "secondary_message": null
          },
          {
            "id": 171656,
            "primary_message": "Toss mushrooms in the dressing, making sure both sides are well coated; leave the mushrooms in the dressing to marinate and set aside.",
            "secondary_message": null
          },
          {
            "id": 171657,
            "primary_message": "Preheat oven to broil and position rack under the broiler.",
            "secondary_message": null
          },
          {
            "id": 171658,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 171659,
            "primary_message": "Slice the tomatoes.",
            "secondary_message": null
          },
          {
            "id": 171660,
            "primary_message": "Grate the cheese.",
            "secondary_message": "1 (8 oz) block mozzarella cheese"
          },
          {
            "id": 171661,
            "primary_message": "Remove mushrooms from the dressing, shaking off excess; transfer mushrooms, stem side down, to a baking sheet lined with aluminum foil. (Reserve remaining dressing for the salad.)",
            "secondary_message": null
          },
          {
            "id": 171662,
            "primary_message": "Place mushrooms under the broiler and cook until tender, 2-3 minutes per side.",
            "secondary_message": null
          },
          {
            "id": 171663,
            "primary_message": "Peel and mince garlic; place in a small bowl, add oil, and mix to combine.",
            "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil"
          },
          {
            "id": 171664,
            "primary_message": "Drizzle bread with oil and garlic mixture.",
            "secondary_message": "4 slices whole grain bread"
          },
          {
            "id": 171665,
            "primary_message": "Remove mushrooms from oven and pour off any excess moisture. Place mushrooms back on the sheet pan, stem side up, and fill with tomato slices and cheese. Add bread to the baking sheet next to the mushrooms; return to the broiler until cheese is melted and bread is toasted 1-2 minutes.",
            "secondary_message": null
          },
          {
            "id": 171666,
            "primary_message": "Add spring mix, sliced almonds, and half the basil to the bowl with the remaining dressing, toss to combine.",
            "secondary_message": "½ cup almonds, sliced"
          },
          {
            "id": 171667,
            "primary_message": "To serve, divide salad and toast between plates; top toast with broiled mushroom and garnish with remaining basil. Enjoy!",
            "secondary_message": null
          }
        ],
