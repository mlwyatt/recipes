        "instructions": [
          {
            "id": 48984,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium yellow potatoes\n2 red bell peppers"
          },
          {
            "id": 48985,
            "primary_message": "Peel and large dice the potatoes into ¾-inch cubes; transfer to a bowl.",
            "secondary_message": null
          },
          {
            "id": 48986,
            "primary_message": "Preheat a (stainless steel or cast-iron) skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 48987,
            "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Large dice the peppers into ¾-inch cubes and transfer to a separate medium bowl.",
            "secondary_message": null
          },
          {
            "id": 48988,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 48989,
            "primary_message": "Add the potatoes to the skillet; cook, stirring occasionally, until the potatoes are tender, 8 to 10 minutes.",
            "secondary_message": ""
          },
          {
            "id": 48990,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces. Add to the bell peppers.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 48991,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bell peppers and onion.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 48992,
            "primary_message": "Add the bell peppers, onion, and garlic to the skillet; cook, stirring frequently, until the vegetables are tender and browned, 4 to 6 minutes.",
            "secondary_message": null
          },
          {
            "id": 48993,
            "primary_message": "Add coconut oil to a nonstick skillet and preheat over medium heat.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 48994,
            "primary_message": "Gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 3 to 4 minutes. Once done, separate the eggs. Cook in batches if necessary.",
            "secondary_message": "12 eggs"
          },
          {
            "id": 48995,
            "primary_message": "Season the hash with salt and pepper; stir to combine and remove from the heat.",
            "secondary_message": "1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 48996,
            "primary_message": "Finely grate 1 cup of Parmesan.",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 48997,
            "primary_message": "To serve, divide the hash between plates, top with the fried eggs, and sprinkle with the Parmesan. Season with additional salt and pepper if desired. Enjoy!",
            "secondary_message": null
          }
        ],
