        "instructions": [
          {
            "id": 147475,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium yellow potatoes\n1 lime\n2 avocados\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n2 tomatoes"
          },
          {
            "id": 147476,
            "primary_message": "Small dice potatoes into ¼-inch cubes.",
            "secondary_message": null
          },
          {
            "id": 147477,
            "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 147478,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add potatoes and salt; cook, stirring often, until golden and crisp, 12-15 minutes. ",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 147479,
            "primary_message": "Meanwhile, finely chop the walnuts and transfer to a medium bowl. ",
            "secondary_message": "1 ⅓ cups walnuts"
          },
          {
            "id": 147480,
            "primary_message": "Peel and mince the garlic. Mince the sun-dried tomatoes; add both to the bowl with the walnuts.",
            "secondary_message": "4 cloves garlic\n8 sun-dried tomatoes, oil-packed"
          },
          {
            "id": 147481,
            "primary_message": "Add water, sugar, and spices to the bowl with the walnuts and stir to combine. ",
            "secondary_message": "1 ½ cup water\n1 tsp brown sugar\n1 ½ tsp paprika\n1 ½ tsp cumin\n1 ½ tsp chili powder\n½ tsp salt"
          },
          {
            "id": 147482,
            "primary_message": "When the potatoes are done, add the walnut mixture to the skillet; cook, stirring often, until the liquid has evaporated, 4-5 minutes. Remove from the heat. ",
            "secondary_message": null
          },
          {
            "id": 147483,
            "primary_message": "Juice the lime into a blender.",
            "secondary_message": null
          },
          {
            "id": 147484,
            "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out into the blender.",
            "secondary_message": null
          },
          {
            "id": 147485,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and add leaves to the blender. ",
            "secondary_message": null
          },
          {
            "id": 147486,
            "primary_message": "Peel garlic; add to the blender along with almond milk and salt. Blend on high until smooth; set avocado cream aside. ",
            "secondary_message": "2 cloves garlic\n4 fl oz (½ cup) almond milk, unsweetened\n½ tsp salt"
          },
          {
            "id": 147487,
            "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
            "secondary_message": null
          },
          {
            "id": 147488,
            "primary_message": "Small dice the tomatoes. ",
            "secondary_message": null
          },
          {
            "id": 147489,
            "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15-30 seconds.",
            "secondary_message": "12 small corn tortillas"
          },
          {
            "id": 147490,
            "primary_message": "To serve, divide the tortillas between plates and fill with potato-walnut mixture. Top with green onion, tomato, and avocado cream. Enjoy! ",
            "secondary_message": null
          }
        ],
