        "instructions": [
          {
            "id": 405852,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n2 leeks\n1 small bunch asparagus\n1 bunch radish\n1 head butter (Boston) lettuce"
          },
          {
            "id": 405853,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 405854,
            "primary_message": "Add eggs, pepper, and salt to the bowl with the parsley. Whisk to combine.",
            "secondary_message": "12 eggs\n½ tsp black pepper\n¼ tsp salt"
          },
          {
            "id": 405855,
            "primary_message": "Crumble the goat cheese. Add half to the bowl with the egg. (Set remaining cheese aside for the salad.)",
            "secondary_message": "2 (4 oz) logs goat cheese"
          },
          {
            "id": 405856,
            "primary_message": "Chop (or tear) prosciutto into bite-sized pieces. Add to the bowl, stir to combine, and set aside.",
            "secondary_message": "12 slices prosciutto"
          },
          {
            "id": 405857,
            "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 405858,
            "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 405859,
            "primary_message": "While the skillet heats up, snap (or cut) off the woody ends of the asparagus; cut spears into bite-sized pieces. Add to the bowl with the leek.",
            "secondary_message": null
          },
          {
            "id": 405860,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add leek, asparagus, peas, pepper, and salt; cook, stirring occasionally, until veggies are bright green and starting to soften, about 3 minutes. (Reserve bowl for later use.)",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 cup frozen peas\n½ tsp black pepper\n¼ tsp salt"
          },
          {
            "id": 405861,
            "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 405862,
            "primary_message": "When the veggies are soft, reduce heat to medium and pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 405863,
            "primary_message": "While the frittata is cooking, place additional oil, vinegar, salt, and pepper in the reserved bowl. Whisk to combine the dressing and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 405864,
            "primary_message": "Place skillet in the oven and broil until top of the frittata is just set, 2-3 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 405865,
            "primary_message": "Meanwhile, trim and thinly slice radishes. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 405866,
            "primary_message": "Separate lettuce into leaves. Chop (or tear) leaves into bite-sized pieces. Add to the bowl, along with the reserved goat cheese, and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 405867,
            "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
