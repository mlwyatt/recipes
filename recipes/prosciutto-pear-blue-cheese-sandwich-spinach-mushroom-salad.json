  "instructions": [
    {
      "id": 267149,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 267150,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lb white mushrooms\n2 pears\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 267151,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 267152,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 267153,
      "primary_message": "Arrange bread slices on a large baking sheet pan, place in the oven, and broil until toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 267154,
      "primary_message": "Meanwhile, peel and thinly slice shallots.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 267155,
      "primary_message": "Quarter, core, and thinly slice pears.",
      "secondary_message": null
    },
    {
      "id": 267156,
      "primary_message": "Spread mayo and Dijon over half of the toasted bread slices. Layer a small handful of spinach, shallot, pear, prosciutto, and blue cheese over top (reserving remaining spinach for the salad). Close with remaining toast slices.",
      "secondary_message": "3 tbsp mayonnaise\n2 tsp Dijon mustard\n16 slices prosciutto\n1 (4 oz) pkg crumbled blue cheese"
    },
    {
      "id": 267157,
      "primary_message": "Add remaining spinach to the bowl with the dressing and mushrooms; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 267158,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
