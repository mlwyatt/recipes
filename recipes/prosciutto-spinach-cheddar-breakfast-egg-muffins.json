        "instructions": [
          {
            "id": 194192,
            "primary_message": "Preheat oven to 400°F and position a rack near the bottom of the oven; grease 12 muffin cups with butter.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 194193,
            "primary_message": "Chop the prosciutto into ½-inch pieces.",
            "secondary_message": "8 slices prosciutto"
          },
          {
            "id": 194194,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 194195,
            "primary_message": "Wash and chop the spinach. Add to the skillet and wilt for 1-2 minutes.",
            "secondary_message": "1 (5 oz) pkg baby spinach"
          },
          {
            "id": 194196,
            "primary_message": "Divide the prosciutto and spinach between the greased muffin tins.",
            "secondary_message": null
          },
          {
            "id": 194197,
            "primary_message": "Crack the eggs into a medium bowl and season pepper; whisk together and pour on top of the prosciutto and spinach.",
            "secondary_message": "10 eggs\n½ tsp black pepper"
          },
          {
            "id": 194198,
            "primary_message": "Coarsely grate the cheddar and add to the muffin tins. ",
            "secondary_message": "½ (8 oz) block cheddar cheese"
          },
          {
            "id": 194199,
            "primary_message": "Bake for 12-15 minutes, until eggs are no longer soft in the center. Remove from the oven and let cool for 1 minute. Use a spatula to wedge each egg muffin out of its cup.",
            "secondary_message": null
          },
          {
            "id": 194200,
            "primary_message": "Serve warm or cool for breakfast on the go. Enjoy! ",
            "secondary_message": null
          }
        ],
