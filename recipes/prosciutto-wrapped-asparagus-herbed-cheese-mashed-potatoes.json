        "instructions": [
          {
            "id": 483752,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 483753,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "6 medium yellow potatoes\n2 small bunches asparagus\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg chives"
          },
          {
            "id": 483754,
            "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
            "secondary_message": null
          },
          {
            "id": 483755,
            "primary_message": "While the potatoes are cooking, snap (or cut) off woody ends of the asparagus. Transfer to a large baking sheet pan, drizzle with oil, and spread out in an even layer.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 483756,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until asparagus is just tender, 5-7 minutes, depending on the thickness of the spears. Remove baking sheet from oven and set aside to cool slightly, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 483757,
            "primary_message": "Meanwhile, using a box grater, coarsely grate cream cheese into a small bowl.",
            "secondary_message": "1 (8 oz) block cream cheese"
          },
          {
            "id": 483758,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the cream cheese.",
            "secondary_message": null
          },
          {
            "id": 483759,
            "primary_message": "Chop chives into small pieces. Add to the bowl along with salt and pepper, then stir to combine.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 483760,
            "primary_message": "Lay prosciutto on a flat surface and spread each slice evenly with the cream cheese mixture.",
            "secondary_message": "12 slices prosciutto"
          },
          {
            "id": 483761,
            "primary_message": "When the asparagus is cool enough to handle, divide into 12 equal piles. Wrap each pile with a slice of the prepared prosciutto, gently pressing the cream cheese-side around the asparagus to secure. Arrange, seam-side down, on the baking sheet.",
            "secondary_message": null
          },
          {
            "id": 483762,
            "primary_message": "Return baking sheet to the oven and continue to roast until prosciutto is golden and asparagus is fork-tender, about 5 minutes. Remove from oven and let cool slightly, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 483763,
            "primary_message": "When the potatoes are done, drain in a colander and return to the pot. Add oil, salt, and pepper, then using a potato masher, mash until smooth.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 483764,
            "primary_message": "To serve, divide mashed potatoes and prosciutto-wrapped asparagus between plates. Enjoy!",
            "secondary_message": null
          }
        ],
