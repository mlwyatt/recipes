        "instructions": [
          {
            "id": 417233,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 tomatoes\n4 peaches\n1 small pkg fresh basil"
          },
          {
            "id": 417234,
            "primary_message": "Place oil, vinegar, salt, and crushed red pepper in a medium bowl. Whisk to combine the dressing.",
            "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp salt\n½ tsp crushed red pepper"
          },
          {
            "id": 417235,
            "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 417236,
            "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 417237,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 417238,
            "primary_message": "While the skillet heats up, pat cod dry with paper towels and cut into portions (if necessary). Season with salt and pepper, then wrap 2 slices of prosciutto around each portion.",
            "secondary_message": "1 ½ lb cod fillet\n½ tsp salt\n¼ tsp black pepper\n8 slices prosciutto"
          },
          {
            "id": 417239,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cod and cook until golden on one side, 3-4 minutes; flip and continue to pan-fry until the fish is cooked through and the prosciutto is crisp, 3-4 minutes more. Remove to a plate. ",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 417240,
            "primary_message": "Meanwhile, place corn in the colander and rinse under hot water (from the tap) to defrost. Add to the bowl with the tomatoes and peaches.",
            "secondary_message": "2 cups frozen corn"
          },
          {
            "id": 417241,
            "primary_message": "Pick basil leaves off the stems; discard stems and tear the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 417242,
            "primary_message": "Crumble goat cheese into the bowl, then gently stir to combine the salad.",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 417243,
            "primary_message": "To serve, divide prosciutto-wrapped cod and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
