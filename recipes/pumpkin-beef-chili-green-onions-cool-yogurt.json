        "instructions": [
          {
            "id": 19216,
            "primary_message": "Heat a medium saucepan over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 19217,
            "primary_message": "Peel and small dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\r\n2 cloves garlic"
          },
          {
            "id": 19218,
            "primary_message": "Coat bottom of saucepan with oil. Add ground beef. Breaking apart with a spoon, cook until browned, 2-3 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil\n1 ½ lb lean ground beef"
          },
          {
            "id": 19219,
            "primary_message": "Add onion and garlic to saucepan. Reduce heat to medium. Stirring frequently, cook until onion softens, 3-4 minutes.",
            "secondary_message": ""
          },
          {
            "id": 19220,
            "primary_message": "Drain and rinse beans.",
            "secondary_message": "1 (15 oz) can black beans"
          },
          {
            "id": 19221,
            "primary_message": "In a small bowl, mix together chili powder, cumin, cinnamon, salt, and pepper.",
            "secondary_message": "1 tbsp chili powder\r\n2 tsp cumin\r\n½ tsp cinnamon\r\n1 tsp salt\r\n1 tsp black pepper"
          },
          {
            "id": 19222,
            "primary_message": "Add spice mixture, beans, tomatoes, and pumpkin purée to saucepan. Stir to combine and simmer for 10-15 minutes.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\r\n1 (15 oz) can pure pumpkin purée"
          },
          {
            "id": 19223,
            "primary_message": "Wash green onions, trim and discard root ends, and chop. Stir ½ into the chili and save the rest for garnishing.",
            "secondary_message": "1 small bunch green onions (scallions)"
          },
          {
            "id": 19224,
            "primary_message": "Serve chili in a bowl, garnish with remaining green onions and spoonfuls of yogurt. Enjoy!",
            "secondary_message": "½ cup plain Greek yogurt"
          }
        ],
