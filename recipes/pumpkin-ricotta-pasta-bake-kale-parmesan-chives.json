        "instructions": [
          {
            "id": 16154,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "about 14 cups water\n2 tbsp salt\n12 oz (4 ½ cups) rotini pasta"
          },
          {
            "id": 16156,
            "primary_message": "Peel and mince garlic. Peel and small dice the onion.",
            "secondary_message": "4 cloves garlic\n1 yellow onion"
          },
          {
            "id": 16155,
            "primary_message": "Heat a sauté pan over medium-low heat.",
            "secondary_message": ""
          },
          {
            "id": 16157,
            "primary_message": "Coat bottom of pan with oil. Add garlic, onion, sage, and thyme. Cook until soft, 3-4 minutes.",
            "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp sage\n1 tsp thyme"
          },
          {
            "id": 135204,
            "primary_message": "Meanwhile, wash kale leaves, then fold in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces. Add to the pan with the onions; cook, stirring often, until kale begins to wilt, 5-6 minutes.",
            "secondary_message": "1 bunch kale"
          },
          {
            "id": 16158,
            "primary_message": "Add broth, pumpkin, ricotta, salt, and pepper. Stir to combine. Simmer, stirring occasionally, while pasta is cooking.",
            "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n1 (15 oz) can pure pumpkin purée\n1 (15 oz) pkg ricotta cheese\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 16159,
            "primary_message": "Preheat oven to broil and position rack 4 inches under the broiler.",
            "secondary_message": ""
          },
          {
            "id": 16160,
            "primary_message": "Wash and chop chives into small pieces.",
            "secondary_message": "1 small pkg chives"
          },
          {
            "id": 16161,
            "primary_message": "Grate ½ cup of Parmesan.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 16162,
            "primary_message": "Add ½ of the chives and Parmesan (save the rest for garnishing) to pan and stir to combine.",
            "secondary_message": ""
          },
          {
            "id": 16163,
            "primary_message": "Drain pasta, add to pan with sauce, and stir to combine.",
            "secondary_message": ""
          },
          {
            "id": 16164,
            "primary_message": "Place pan in the oven and broil until slightly browned, 3-4 minutes.",
            "secondary_message": ""
          },
          {
            "id": 16165,
            "primary_message": "To serve, place pasta on a plate and garnish with remaining chives and Parmesan. Enjoy!",
            "secondary_message": ""
          }
        ],
