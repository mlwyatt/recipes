        "instructions": [
          {
            "id": 48340,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 bunch kale\n1 lemon"
          },
          {
            "id": 48341,
            "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 48342,
            "primary_message": "Preheat a medium saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 48343,
            "primary_message": "While the saucepan heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 48344,
            "primary_message": "Once the saucepan is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 48345,
            "primary_message": "Add the onion to the saucepan; cook, stirring frequently, until softened, 3 to 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 48346,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
            "secondary_message": "6 cloves garlic"
          },
          {
            "id": 48347,
            "primary_message": "Add ½ of the garlic, cinnamon, and crushed red pepper to the saucepan; stir until fragrant, 15 to 30 seconds.",
            "secondary_message": "½ tsp cinnamon\n¼ tsp crushed red pepper"
          },
          {
            "id": 48348,
            "primary_message": "Add the pumpkin purée and broth to the saucepan; stir to incorporate and season with salt and pepper. Bring to a boil, then reduce the heat to low and simmer for 10 to 15 minutes.",
            "secondary_message": "1 (15 oz) can pure pumpkin purée\n40 fl oz (5 cups) chicken or vegetable broth\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 48349,
            "primary_message": "Preheat a nonstick skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 48350,
            "primary_message": "While the skillet heats up, cut out and discard the kale stems; chop the leaves into 1-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 48351,
            "primary_message": "Once the pan is hot, add olive oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 48352,
            "primary_message": "Add the remaining garlic and crushed red pepper to the pan; stir until fragrant, 15 to 30 seconds.",
            "secondary_message": "¼ tsp crushed red pepper"
          },
          {
            "id": 48353,
            "primary_message": "Add the kale to the skillet and toss with the garlic and olive oil; cook until it is tender, 4 to 6 minutes.",
            "secondary_message": null
          },
          {
            "id": 48354,
            "primary_message": "Crumble the goat cheese and place in a small bowl.",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 48355,
            "primary_message": "Add the chickpeas to the kale and season the mixture with salt and pepper; mix together and continue to cook until the chickpeas are heated through, 1 to 2 minutes.",
            "secondary_message": "1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 48356,
            "primary_message": "Juice the lemon and drizzle over the kale and chickpeas.",
            "secondary_message": null
          },
          {
            "id": 48357,
            "primary_message": "Using an immersion (hand) blender, purée the soup until smooth.",
            "secondary_message": null
          },
          {
            "id": 48358,
            "primary_message": "To serve, divide the soup between bowls and top with the goat cheese; serve with the sautéed chickpeas and kale on the side. Enjoy!",
            "secondary_message": null
          }
        ],
