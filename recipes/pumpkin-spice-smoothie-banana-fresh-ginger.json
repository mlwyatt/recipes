  "instructions": [
    {
      "id": 326894,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 326895,
      "primary_message": "Wash, dry, peel, and mince ginger; place in a blender.",
      "secondary_message": "2 (1 inch) pieces ginger root"
    },
    {
      "id": 326896,
      "primary_message": "Peel the bananas, break into chunks, and add to the blender. ",
      "secondary_message": "2 bananas"
    },
    {
      "id": 326897,
      "primary_message": "Add pumpkin purée, milk, maple syrup, spices, and 8 ice cubes to the blender. ",
      "secondary_message": "2 (15 oz) cans pure pumpkin purée\n24 fl oz (3 cups) whole milk\n¼ cup pure maple syrup\n2 tsp cinnamon, ground\n1 tsp nutmeg, ground\n½ tsp cardamom, ground\n½ tsp cloves, ground"
    },
    {
      "id": 326898,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 326899,
      "primary_message": "Pour the smoothie into glasses. Top with a sprinkle of cinnamon and enjoy!",
      "secondary_message": "⅛ tsp cinnamon, ground"
    }
  ],
