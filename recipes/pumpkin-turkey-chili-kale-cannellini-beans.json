  "instructions": [
    {
      "id": 46717,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 jalapeño peppers\n1 bunch kale"
    },
    {
      "id": 46718,
      "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 46719,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 46720,
      "primary_message": "While the saucepan heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces). Add to the bowl with the pepper.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 46721,
      "primary_message": "Once the saucepan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 46722,
      "primary_message": "Add the ground turkey to the saucepan; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer to a bowl, leaving some of the juices in the saucepan.",
      "secondary_message": "1 ½ lb ground turkey"
    },
    {
      "id": 46723,
      "primary_message": "Once the turkey has been transferred, add the pepper and onion to the saucepan; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 46724,
      "primary_message": "Drain and rinse the beans in a colander.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 46725,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 46726,
      "primary_message": "Add the garlic, chili powder, cumin, and oregano to the saucepan; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "2 tbsp chili powder\n2 tsp cumin\n1 tsp oregano"
    },
    {
      "id": 46727,
      "primary_message": "Return the turkey to the saucepan, then add in the beans, diced tomatoes, and pumpkin purée; season with salt and pepper. Bring the mixture to a boil, then reduce to a simmer and cook for 10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n1 (15 oz) can pure pumpkin purée\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 46728,
      "primary_message": "Cut out and discard the kale stems; chop leaves crosswise into bite-sized pieces. Stir the kale into the chili while it is cooking.",
      "secondary_message": null
    },
    {
      "id": 46729,
      "primary_message": "To serve, divide the chili between bowls and top with spoonfuls of Greek yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
