        "instructions": [
          {
            "id": 175298,
            "primary_message": "Wash and dry thyme. Add thyme sprigs, water, vinegar, salt, and coriander to a large pot; cover and bring to a boil over high heat.",
            "secondary_message": "1 small pkg fresh thyme\n8 cup water\n1 cup apple cider vinegar\n2 tbsp salt\n2 tsp coriander"
          },
          {
            "id": 175299,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) ",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 175300,
            "primary_message": "Once the liquid comes to a boil, uncover, add shrimp, and stir for a few seconds. Remove from heat, and let the shrimp pickle in the cooking liquid while you prepare the rest of the salad, about 20 minutes. ",
            "secondary_message": null
          },
          {
            "id": 175301,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 lemons\n1 jalapeño pepper\n1 red bell pepper\n1 English cucumber\n2 medium carrots\n2 avocados"
          },
          {
            "id": 175302,
            "primary_message": "Grate the zest from the lemons and transfer to a large bowl, then juice the lemons into the same bowl.",
            "secondary_message": null
          },
          {
            "id": 175303,
            "primary_message": "Peel and mince the garlic; transfer to the bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 175304,
            "primary_message": "Add additional vinegar, oil, salt, and pepper to the bowl and whisk to combine the dressing.",
            "secondary_message": "2 tbsp apple cider vinegar\n¼ cup extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 175305,
            "primary_message": "Thinly slice the jalapeño into rounds (be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
            "secondary_message": null
          },
          {
            "id": 175306,
            "primary_message": "Peel and thinly slice the shallot into rings. Add shallots and jalapeños to the bowl with the dressing.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 175307,
            "primary_message": "Seed and slice bell pepper into thin strips. Peel and medium dice the cucumber. Peel and thinly slice carrots into rounds. Add vegetables to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 175308,
            "primary_message": "Halve and pit avocados; scoop out the flesh and medium dice. Add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 175309,
            "primary_message": "Drain the shrimp and discard the liquid. Remove tails, then add shrimp to the bowl with the vegetables and stir to combine the salad; set aside.",
            "secondary_message": null
          },
          {
            "id": 175310,
            "primary_message": "Toast and butter the bread, then slice on the diagonal to make toast points.",
            "secondary_message": "8 slices whole grain bread\n2 tbsp butter, unsalted"
          },
          {
            "id": 175311,
            "primary_message": "To serve, divide shrimp salad between bowls. Enjoy with a side of buttered toast points for dipping. ",
            "secondary_message": null
          }
        ],
