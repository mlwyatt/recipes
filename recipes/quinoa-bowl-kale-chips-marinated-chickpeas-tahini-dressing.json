  "instructions": [
    {
      "id": 363636,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 363637,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 363638,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 bunch kale\n2 lemons\n1 English cucumber\n1 bunch radish"
    },
    {
      "id": 363639,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into large bite-sized pieces and place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 363640,
      "primary_message": "Add nutritional yeast, oil, vinegar, and salt to the bowl with the kale; using your hands, toss the leaves well to coat. Transfer to a large baking sheet pan and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": "½ cup nutritional yeast flakes\n4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n¼ tsp salt"
    },
    {
      "id": 363641,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing once, until the kale is crispy, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 363642,
      "primary_message": "Meanwhile, drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 363643,
      "primary_message": "Zest and juice one of the lemons into the reserved bowl. (Reserve remaining lemon for the dressing.)",
      "secondary_message": null
    },
    {
      "id": 363644,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil, maple syrup, Dijon, and spices; stir to combine the marinade. Add chickpeas, stir to combine, and set aside to marinate.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n2 tsp pure maple syrup\n1 tsp Dijon mustard\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 363645,
      "primary_message": "Peel and mince additional garlic; place in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 363646,
      "primary_message": "Juice the reserved lemon into the bowl with the garlic. Add tahini, water, maple syrup, Dijon, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "⅓ cup tahini\n¼ cup water\n2 tsp pure maple syrup\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 363647,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 363648,
      "primary_message": "Trim and thinly slice radishes.",
      "secondary_message": null
    },
    {
      "id": 363649,
      "primary_message": "To serve, divide quinoa, kale chips, chickpeas, cucumber, and radish between bowls. Drizzle with lemon-tahini dressing and enjoy!",
      "secondary_message": null
    }
  ],
