        "instructions": [
          {
            "id": 194295,
            "primary_message": "Preheat the oven to 425°F and place the rack in the center position. Line a large sheet pan with parchment paper (optional).",
            "secondary_message": null
          },
          {
            "id": 194296,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "8 medium carrots\n1 small bunch Italian (flat-leaf) parsley\n2 limes"
          },
          {
            "id": 194297,
            "primary_message": "Peel carrots, cut in half lengthwise, and add to the baking sheet.",
            "secondary_message": null
          },
          {
            "id": 194298,
            "primary_message": "Drizzle oil and honey over carrots and sprinkle with spices. Place carrots in the oven and cook, until tender, 15-20 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil\n4 tsp honey\n1 tsp salt\n½ tsp black pepper\n½ tsp chili powder"
          },
          {
            "id": 194299,
            "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 194300,
            "primary_message": "Meanwhile, shave the parsley leaves off the stems; discard the stems and mince the leaves. Add to a medium bowl (reserving some for garnish). ",
            "secondary_message": null
          },
          {
            "id": 194301,
            "primary_message": "Peel and mince garlic. Zest the limes and add both to the bowl with the parsley. Add salt, pepper, and oil; stir to combine. ",
            "secondary_message": "2 cloves garlic\n1 tsp salt\n½ tsp black pepper\n4 tsp extra virgin olive oil"
          },
          {
            "id": 194302,
            "primary_message": "Drain and rinse chickpeas. Add to the lime zest mixture​, along with the corn, and toss to coat. Spread out on another baking sheet and place in the oven with the carrots for the last 5 minutes of cooking.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n2 cups frozen corn"
          },
          {
            "id": 194303,
            "primary_message": "Juice the limes into a small bowl. Add yogurt, cumin, and salt; whisk to combine.",
            "secondary_message": "1 cup plain Greek yogurt\n2 tsp cumin\n1 tsp salt"
          },
          {
            "id": 194304,
            "primary_message": "To serve, divide quinoa between bowls, add roasted carrots, chickpeas, and corn. Drizzle with cumin yogurt and top with reserved parsley. Enjoy!",
            "secondary_message": null
          }
        ],
