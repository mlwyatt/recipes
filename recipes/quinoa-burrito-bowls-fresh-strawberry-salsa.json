  "instructions": [
    {
      "id": 174608,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook 15 minutes. Remove from heat and let stand, covered, 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 174609,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "id": 174610,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (16 oz) pkg strawberries\n1 jalapeño pepper\n1 small bunch cilantro\n2 limes"
    },
    {
      "id": 174611,
      "primary_message": "Peel and small dice onions. ",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 174612,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 174613,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 174614,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and garlic to the skillet and cook, stirring occasionally, until soft, 3-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 174615,
      "primary_message": "Remove stems and roughly chop strawberries; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 174616,
      "primary_message": "Add drained beans, frozen corn, broth, and spices to the skillet. Cook, stirring occasionally, until heated through, 5-7 minutes.",
      "secondary_message": "1 cup frozen corn\n8 fl oz (1 cup) chicken or vegetable broth\n1 tsp chili powder\n1 tsp salt\n½ tsp cumin\n½ tsp oregano\n½ tsp paprika\n¼ tsp crushed red pepper"
    },
    {
      "id": 174617,
      "primary_message": "Quarter the jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the bowl with the strawberries. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 174618,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the strawberries.",
      "secondary_message": null
    },
    {
      "id": 174619,
      "primary_message": "Juice one lime into the bowl with the strawberries; cut the other lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 174620,
      "primary_message": "Peel and mince the shallot; add to the bowl. Stir to combine the salsa.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 174621,
      "primary_message": "To serve, divide quinoa between bowls, top with bean mixture, salsa, and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
