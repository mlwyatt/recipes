  "instructions": [
    {
      "id": 320832,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small butternut squash\n1 red bell pepper\n1 (5 oz) pkg baby spinach\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 320833,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out seeds, and small dice. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 320834,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the squash and set aside.",
      "secondary_message": null
    },
    {
      "id": 320835,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 320836,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion; peel and mince garlic. ",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 320837,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until softened, about 2 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 320838,
      "primary_message": "Add squash, bell pepper, tomatoes, water, quinoa, and spices to the pot. Stir to combine the stew and bring to a boil over high heat; once boiling, reduce heat to low, cover, and cook until squash and quinoa are tender, about 20 minutes. (Reserve bowl for next step.)",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n3 cup water\n1 cup quinoa\n2 tsp chili powder\n1 tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 320839,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 320840,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 320841,
      "primary_message": "When the quinoa is tender, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 320842,
      "primary_message": "Add peanut butter, additional water, raisins, and half of the cilantro to the stew. Stir to combine and continue to cook until warmed through, about 3 minutes. (Reserve remaining cilantro for serving.) ",
      "secondary_message": "½ cup natural peanut butter\n½ cup water\n¼ cup raisins"
    },
    {
      "id": 320843,
      "primary_message": "Meanwhile, roughly chop peanuts. Slice lime into wedges.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 320844,
      "primary_message": "Divide stew between bowls; top with reserved cilantro and peanuts. Serve with lime wedges for squeezing over and enjoy!",
      "secondary_message": null
    }
  ],
