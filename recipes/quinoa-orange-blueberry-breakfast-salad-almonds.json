        "instructions": [
          {
            "id": 130951,
            "primary_message": "In a medium saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n2 cup water"
          },
          {
            "id": 130952,
            "primary_message": "Meanwhile, in a small bowl, combine oil, vinegar, maple syrup, Dijon, salt, and pepper; whisk to combine the dressing.",
            "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp balsamic vinegar\n2 tsp pure maple syrup\n1 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 130953,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 oranges\n1 (6 oz) pkg blueberries\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 130954,
            "primary_message": "Quarter oranges; peel and slice the quarters into wedges.",
            "secondary_message": null
          },
          {
            "id": 130955,
            "primary_message": "To serve, divide the quinoa and spinach between plates or bowls; top with orange wedges, blueberries, and sliced almonds. Drizzle with dressing and enjoy!",
            "secondary_message": "½ cup almonds, sliced"
          }
        ],
