  "instructions": [
    {
      "id": 175129,
      "primary_message": "In a medium saucepan, combine quinoa and broth. Bring to a boil. Reduce heat to low, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 175130,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 eggplant\n6 tomatoes\n2 red bell peppers\n2 medium zucchini squash\n1 small pkg fresh basil\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 175131,
      "primary_message": "Trim ends and medium dice eggplant. Transfer to a medium bowl, add salt, and toss to coat; set aside.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 175132,
      "primary_message": "Medium dice tomatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 175133,
      "primary_message": "Seed and medium dice bell peppers; add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 175134,
      "primary_message": "Trim ends and medium dice zucchini; add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 175135,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 175136,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "1 medium red onion\n4 cloves garlic"
    },
    {
      "id": 175137,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 175138,
      "primary_message": "Add onion and garlic. Stirring frequently, cook until onion begins to soften, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 175139,
      "primary_message": "Using a clean towel or paper towel, squeeze the eggplant to release excess moisture. Add eggplant to the pot along with the chopped veggies, corn, tomato sauce, and salt. Cook, stirring occasionally, until veggies begin to soften, about 15 minutes.",
      "secondary_message": "1 cup frozen corn\n3 (8 oz) cans tomato sauce\n1 tsp salt"
    },
    {
      "id": 175140,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 175141,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 175142,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add quinoa and half of the Parmesan; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 175143,
      "primary_message": "To serve, divide the risotto between bowls and garnish with remaining Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
