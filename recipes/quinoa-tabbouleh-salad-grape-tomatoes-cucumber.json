        "instructions": [
          {
            "id": 12570,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
          },
          {
            "id": 12571,
            "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by whisking together garlic, lemon juice, oil, salt, pepper, and cumin.",
            "secondary_message": "4 cloves garlic\n2 lemons\n6 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper\n¼ tsp cumin"
          },
          {
            "id": 12572,
            "primary_message": "Wash and dry tomatoes, cucumbers, parsley, and mint. Halve and add tomatoes to bowl with dressing. Medium dice and add cucumbers to bowl. Shave parsley leaves off the stems; discard the stems, mince the leaves, and add to bowl. Pick mint leaves off the stems; discard the stems, mince the leaves, and add to bowl.",
            "secondary_message": "2 pints grape tomatoes\r\n2 English cucumbers\r\n1 small bunch Italian (flat-leaf) parsley\r\n1 small pkg fresh mint"
          },
          {
            "id": 12573,
            "primary_message": "Uncover quinoa, fluff with a fork, and drain any excess liquid. Add quinoa to bowl and toss salad.",
            "secondary_message": ""
          },
          {
            "id": 12574,
            "primary_message": "To serve, place salad in a bowl. Enjoy!",
            "secondary_message": ""
          }
        ],
