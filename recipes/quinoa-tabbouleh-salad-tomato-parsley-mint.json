  "instructions": [
    {
      "id": 385944,
      "primary_message": "In a small saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "⅔ cup quinoa\n1 ⅓ cup water\n¼ tsp salt"
    },
    {
      "id": 385945,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 tomatoes\n2 small bunches Italian (flat-leaf) parsley\n1 small pkg fresh mint"
    },
    {
      "id": 385946,
      "primary_message": "Juice lemons into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 385947,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon juice along with oil and spices. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n3 tbsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp cumin, ground\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 385948,
      "primary_message": "Small dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 385949,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 385950,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 385951,
      "primary_message": "When the quinoa is done, transfer to a baking sheet pan. Spread out in an even layer and let cool for 5 minutes. Once cool, add to the bowl with the other ingredients and stir to combine the tabbouleh.",
      "secondary_message": null
    },
    {
      "id": 385952,
      "primary_message": "To serve, divide tabbouleh between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
