        "instructions": [
          {
            "id": 423415,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "1 ½ lb new potatoes\n1 small bunch fresh dill\n4 sticks celery\n1 (5 oz) pkg baby arugula\n1 lemon"
          },
          {
            "id": 423416,
            "primary_message": "Quarter potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, 10-15 minutes.",
            "secondary_message": "1 tsp salt"
          },
          {
            "id": 423417,
            "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl along with dressing and salt; stir to combine.",
            "secondary_message": "⅔ cup ranch dressing\n¼ tsp salt"
          },
          {
            "id": 423418,
            "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 423419,
            "primary_message": "Roughly chop eggs. Add to the bowl, along with the cheese, and set aside.",
            "secondary_message": "8 hard-cooked eggs, peeled\n1 cup shredded cheese, Italian blend"
          },
          {
            "id": 423420,
            "primary_message": "When the potatoes are done, drain and rinse under cold water to cool, then pat dry with paper towels. Add to the bowl and stir to combine the potato salad.",
            "secondary_message": null
          },
          {
            "id": 423421,
            "primary_message": "To serve, divide arugula between plates or bowls; squeeze lemon over top and drizzle with oil. Top with potato-egg salad and enjoy!",
            "secondary_message": "4 tsp extra virgin olive oil"
          }
        ],
