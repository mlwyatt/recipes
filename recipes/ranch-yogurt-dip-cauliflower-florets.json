  "instructions": [
    {
      "id": 394417,
      "primary_message": "Wash, dry, and mince chives. Place in a small bowl.",
      "secondary_message": "1 small pkg chives"
    },
    {
      "id": 394418,
      "primary_message": "Wash, dry, and juice lime into the bowl with the chives. ",
      "secondary_message": "1 lime"
    },
    {
      "id": 394419,
      "primary_message": "Add yogurt, mayo, and spices to the bowl; whisk to combine the ranch dip. ",
      "secondary_message": "⅔ cup plain Greek yogurt\n¼ cup mayonnaise\n1 tsp parsley flakes\n½ tsp dill, dried\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 394420,
      "primary_message": "To serve, divide dip and cauliflower florets between plates. Enjoy!",
      "secondary_message": "2 (10 oz) bags cauliflower florets"
    }
  ],
