  "instructions": [
    {
      "id": 186504,
      "primary_message": "In a medium saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15-18 minutes. Transfer cooked quinoa to a baking sheet pan and spread out in a thin layer to cool. ",
      "secondary_message": "1 cup quinoa\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 186505,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 limes\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 small pkg fresh mint\n1 small bunch cilantro\n1 small head red cabbage\n1 (5 oz) pkg baby spinach\n1 avocado"
    },
    {
      "id": 186506,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 186507,
      "primary_message": "Zest and juice limes into a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 186508,
      "primary_message": "Peel and mince garlic and ginger; transfer both to the salad bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 186509,
      "primary_message": "Trim and mince green onions; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186510,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186511,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186512,
      "primary_message": "Roughly chop peanuts and add half to the bowl (reserve the rest for garnish).",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 186513,
      "primary_message": "Add soy sauce, oils, and crushed red pepper to the bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup soy sauce\n3 tbsp extra virgin olive oil\n2 tbsp toasted sesame oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 186514,
      "primary_message": "Halve the cabbage lengthwise and cut out the core; thinly slice crosswise and add to the bowl with the dressing. Using tongs, toss cabbage with the dressing to thoroughly coat.",
      "secondary_message": null
    },
    {
      "id": 186515,
      "primary_message": "Add spinach, edamame, and quinoa to the bowl; toss once more to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 186516,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 186517,
      "primary_message": "To serve, divide salad between plates or bowls. Top with avocado and reserved peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
