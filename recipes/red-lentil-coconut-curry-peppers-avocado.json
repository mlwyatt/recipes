        "instructions": [
          {
            "id": 139188,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n2 jalapeño peppers\n2 red bell peppers\n2 avocados\n1 small bunch cilantro"
          },
          {
            "id": 139189,
            "primary_message": "Heat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 139190,
            "primary_message": "Peel and mince the garlic and red onion. Peel and mince or grate the ginger. ",
            "secondary_message": "4 cloves garlic\n½ medium red onion"
          },
          {
            "id": 139191,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 139192,
            "primary_message": "Add the garlic, onion, and ginger to the pot and cook, stirring occasionally, 2-3 minutes. ",
            "secondary_message": null
          },
          {
            "id": 139193,
            "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely dice (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
            "secondary_message": null
          },
          {
            "id": 139194,
            "primary_message": "Small dice the bell peppers. Add the jalapeños, bell peppers, curry powder, and salt to the pot. Cook, stirring occasionally, 2-3 minutes. ",
            "secondary_message": "1 tsp curry powder\n1 tsp salt"
          },
          {
            "id": 139195,
            "primary_message": "Add the diced tomatoes, coconut milk, and broth to the pot. Stir and bring to a boil over high heat, then add the red lentils. Reduce heat to medium-low and cook, stirring occasionally, until lentils are tender, 22-25 minutes.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n1 (13.5 fl oz) can coconut milk\n16 fl oz (2 cups) chicken or vegetable broth\n1 cup red lentils"
          },
          {
            "id": 139196,
            "primary_message": "Meanwhile, halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon.",
            "secondary_message": null
          },
          {
            "id": 139197,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 139198,
            "primary_message": "To serve, divide the lentil curry between bowls; top with sliced avocado and minced cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
