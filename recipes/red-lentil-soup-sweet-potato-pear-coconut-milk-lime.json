  "instructions": [
    {
      "id": 231704,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 lb sweet potato\n1 lime\n2 pears"
    },
    {
      "id": 231705,
      "primary_message": "Rinse the lentils in a colander or strainer; set aside to drain.",
      "secondary_message": "1 cup red lentils, dried"
    },
    {
      "id": 231706,
      "primary_message": "Peel and small dice onion; transfer to a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 231707,
      "primary_message": "Peel, trim, and small dice carrots; add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 231708,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 231709,
      "primary_message": "While the pot heats up, trim and small dice celery; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 231710,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, carrot, celery, and spices to the pot; cook, stirring occasionally, until the veggies soften, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 231711,
      "primary_message": "Meanwhile, peel and small dice sweet potatoes.",
      "secondary_message": null
    },
    {
      "id": 231712,
      "primary_message": "Zest lime and then cut into wedges (set wedges aside for serving).",
      "secondary_message": null
    },
    {
      "id": 231713,
      "primary_message": "Add lentils, sweet potato, lime zest, broth, and coconut milk to the pot; stir to combine and bring to a boil over medium-high heat.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk"
    },
    {
      "id": 231714,
      "primary_message": "Peel, quarter, core, and small dice pears; add to the soup. Once the soup comes to a boil, reduce heat to a simmer, and cook until veggies and lentils are tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 231715,
      "primary_message": "Divide soup between bowls and serve with lime wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
