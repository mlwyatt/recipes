  "instructions": [
    {
      "id": 22699,
      "primary_message": "Wash green beans, carrots, and bell peppers.",
      "secondary_message": "1 lb green beans\r\n2 medium carrots\r\n2 red bell peppers"
    },
    {
      "id": 22700,
      "primary_message": "Trim green bean ends and transfer to a large bowl. Seed and slice peppers into strips lengthwise; add to bowl. Trim ends, peel, and thinly slice carrots on the diagonal; add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 22701,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 22702,
      "primary_message": "Season steak with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 22703,
      "primary_message": "Coat grill or skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 22704,
      "primary_message": "Heat a separate skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 22705,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "4 cloves garlic\r\n"
    },
    {
      "id": 22706,
      "primary_message": "Melt butter in skillet and add garlic; cook until fragrant, 15-30 seconds. Add vegetables and cook, stirring often, until tender-crisp, 5-6 minutes. Season with salt and pepper; toss to coat.",
      "secondary_message": "4 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 22707,
      "primary_message": "Serve steak with sautéed vegetables on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
