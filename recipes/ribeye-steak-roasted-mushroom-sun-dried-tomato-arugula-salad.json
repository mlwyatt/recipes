  "instructions": [
    {
      "id": 380924,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 380925,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lb cremini mushrooms\n1 lemon\n1 small pkg fresh basil\n2 (5 oz) pkgs baby arugula"
    },
    {
      "id": 380926,
      "primary_message": "Quarter mushrooms and transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 380927,
      "primary_message": "Peel and mince garlic; add to the baking sheet with the mushrooms. Drizzle with oil and vinegar, then season with salt and pepper. Stir to combine and spread out in an even layer.",
      "secondary_message": "4 cloves garlic\n4 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 380928,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring once, until mushrooms are browned and tender, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 380929,
      "primary_message": "Meanwhile, zest and juice lemon into a large bowl. Add additional oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 380930,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 380931,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 380932,
      "primary_message": "Once the grill pan is hot, coat with oil. Add steak and grill until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 380933,
      "primary_message": "Meanwhile, peel, halve, and slice shallot crosswise into thin half-moons. Roughly chop sun-dried tomatoes. Place both in a small bowl.",
      "secondary_message": "1 shallot\n8 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 380934,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the shallot and sun-dried tomato.",
      "secondary_message": null
    },
    {
      "id": 380935,
      "primary_message": "Finely grate Parmesan. Add to the bowl and stir to combine.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 380936,
      "primary_message": "Once the mushrooms are tender, remove from oven and top with the Parmesan mixture. Return to the oven and continue to roast until Parmesan has melted, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 380937,
      "primary_message": "Meanwhile, thinly slice steak.",
      "secondary_message": null
    },
    {
      "id": 380938,
      "primary_message": "Once the Parmesan has melted, remove mushrooms from oven. Add to the bowl with the dressing, along with the arugula, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 380939,
      "primary_message": "To serve, divide salad between plates or bowls and top with steak. Enjoy!",
      "secondary_message": null
    }
  ],
