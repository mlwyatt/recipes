        "instructions": [
          {
            "id": 330429,
            "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stems into smaller pieces. Transfer to a medium saucepan.",
            "secondary_message": "1 medium head cauliflower"
          },
          {
            "id": 330430,
            "primary_message": "Add hot water (from the tap) to the pan, so that the cauliflower is just covered. Bring to a boil over high heat. Cook until fork-tender, 4-5 minutes. Drain and set aside. ",
            "secondary_message": null
          },
          {
            "id": 330431,
            "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 330432,
            "primary_message": "Roughly chop the sausages. ",
            "secondary_message": "2 pork sausages"
          },
          {
            "id": 330433,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add the sausage. Cook, stirring often, until browned and cooked through, 5-6 minutes. Once done, transfer to a plate and reduce heat to low. ",
            "secondary_message": "2 tsp butter, unsalted"
          },
          {
            "id": 330434,
            "primary_message": "Meanwhile, using a clean cutting board, wash, dry, and chop chives into small pieces; set aside. ",
            "secondary_message": "1 small pkg chives"
          },
          {
            "id": 330435,
            "primary_message": "Coarsely grate cheddar. Finely grate Parmesan. ",
            "secondary_message": "½ (8 oz) block cheddar cheese\n4 oz Parmesan cheese"
          },
          {
            "id": 330436,
            "primary_message": "Peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 330437,
            "primary_message": "Melt more butter in skillet. Add garlic and stir until fragrant, 1-2 minutes. ",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 330438,
            "primary_message": "Stir in cream, Dijon, paprika, and pepper.",
            "secondary_message": "8 fl oz (1 cup) heavy whipping cream\n1 tsp Dijon mustard\n¼ tsp paprika\n¼ tsp black pepper"
          },
          {
            "id": 330439,
            "primary_message": "When the cream is warmed, add cheddar and Parmesan. Cook, stirring well, until the cheese is melted and the mixture is smooth. ",
            "secondary_message": null
          },
          {
            "id": 330440,
            "primary_message": "Add cauliflower to the cheese sauce and stir until well coated. Sprinkle with sausage and chives. Enjoy! ",
            "secondary_message": null
          }
        ],
