        "instructions": [
          {
            "id": 96087,
            "primary_message": "Preheat a skillet over medium-high heat. Add almonds and toast, stirring often, until golden brown, 2-3 minutes. Set aside to cool.",
            "secondary_message": "1 cup almonds, sliced"
          },
          {
            "id": 96088,
            "primary_message": "In a medium bowl, whisk together ricotta, milk, and honey.",
            "secondary_message": "1 (15 oz) pkg ricotta cheese\n4 fl oz (½ cup) whole milk\n2 tbsp honey"
          },
          {
            "id": 96089,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "½ lb red grapes\n2 bananas\n2 kiwifruit"
          },
          {
            "id": 96090,
            "primary_message": "Halve the grapes.",
            "secondary_message": null
          },
          {
            "id": 96091,
            "primary_message": "Peel the bananas, halve lengthwise, and slice.",
            "secondary_message": null
          },
          {
            "id": 96092,
            "primary_message": "Trim off the ends and peel the kiwis; quarter lengthwise, then chop crosswise.",
            "secondary_message": null
          },
          {
            "id": 96093,
            "primary_message": "To serve, transfer ricotta mixture to bowls; top with fruit and almonds. Enjoy!",
            "secondary_message": null
          }
        ],
