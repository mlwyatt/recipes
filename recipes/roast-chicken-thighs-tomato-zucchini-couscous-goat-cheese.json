        "instructions": [
          {
            "id": 324555,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 324556,
            "primary_message": "In a large pot, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, and stir to combine. Cover and let stand for 10 minutes.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous\n¼ tsp salt"
          },
          {
            "id": 324557,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "4 medium zucchini squash\n2 pints grape tomatoes\n1 small pkg fresh basil\n1 lemon"
          },
          {
            "id": 324558,
            "primary_message": "Peel, halve, and large dice onion; transfer to a large baking sheet pan.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 324559,
            "primary_message": "Trim and quarter zucchini lengthwise, then slice crosswise into ¼-inch thick pieces; add to the baking sheet with the onion, along with the tomatoes.",
            "secondary_message": null
          },
          {
            "id": 324560,
            "primary_message": "Peel and mince garlic; sprinkle over the veggies, then drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
            "secondary_message": "4 cloves garlic\n4 tsp extra virgin olive oil\n1 tsp salt\n1 tsp oregano, dried\n½ tsp rosemary, dried\n½ tsp thyme, dried"
          },
          {
            "id": 324561,
            "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides. Add chicken to the baking sheet and nestle into the veggies.",
            "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 324562,
            "primary_message": "Place baking sheet in the oven and roast until veggies are tender and chicken is cooked through, 18-20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 324563,
            "primary_message": "Meanwhile, roughly chop olives; pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add both to the pot with the couscous.",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 324564,
            "primary_message": "Juice lemon into the pot and stir to combine. Cover to keep warm.",
            "secondary_message": null
          },
          {
            "id": 324565,
            "primary_message": "Just before serving, transfer roasted veggies to the pot with the couscous and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 324566,
            "primary_message": "To serve, divide veggie couscous and chicken thighs between plates; crumble goat cheese over couscous. Enjoy!",
            "secondary_message": "1 (4 oz) log goat cheese"
          }
        ],
