  "instructions": [
    {
      "id": 462694,
      "primary_message": "Drain and roughly chop roasted peppers. Divide between two medium bowls. (Set one bowl aside for the salad.)",
      "secondary_message": "1 (12 oz) jar roasted red bell peppers"
    },
    {
      "id": 462695,
      "primary_message": "Add pork, bread crumbs, eggs, salt, and pepper to the first bowl with the peppers. Use your hands to combine the pork mixture. Using a ¼-cup measure, form the mixture into ½-inch thick patties and place on a plate.",
      "secondary_message": "1 ½ lb lean ground pork\n½ cup panko bread crumbs\n2 eggs\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 462696,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462697,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties and cook, flipping once, until golden and cooked through, 3-4 minutes per side. Transfer to a clean plate. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 462698,
      "primary_message": "Meanwhile, wash, dry, and shave dill leaves off the stems; discard stems and mince the leaves. Add to the second bowl with the peppers. ",
      "secondary_message": "1 small bunch fresh dill"
    },
    {
      "id": 462699,
      "primary_message": "Wash, dry, trim, and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "1 English cucumber"
    },
    {
      "id": 462700,
      "primary_message": "Add carrots, almonds, and vinaigrette to the bowl, then stir to combine the salad.",
      "secondary_message": "1 (10 oz) bag shredded carrots\n¼ cup almonds, sliced\n¼ cup French vinaigrette"
    },
    {
      "id": 462701,
      "primary_message": "To serve, divide patties and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
