  "instructions": [
    {
      "id": 209943,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 209944,
      "primary_message": "Wash, dry, and snap or cut off woody ends of the asparagus and transfer to a large baking sheet pan. ",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 209945,
      "primary_message": "Wash, dry, trim, seed, and thinly slice bell peppers; add to the baking sheet with the asparagus. Drizzle veggies with oil, season with salt and pepper, and toss to coat. ",
      "secondary_message": "2 red bell peppers\n4 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 209946,
      "primary_message": "Place veggies in the oven and roast until slightly charred and fork-tender, about 12 minutes. Remove from the oven and set aside. ",
      "secondary_message": null
    },
    {
      "id": 209947,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 209948,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but yolks are still runny, about 4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n8 eggs\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 209949,
      "primary_message": "While the eggs are cooking, peel and mince garlic; transfer to a blender. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 209950,
      "primary_message": "Add roasted peppers, sun-dried tomatoes, almonds, oil, vinegar, and paprika to the blender. Blend until smooth. ",
      "secondary_message": "6 sun-dried tomatoes, oil-packed\n¼ cup almonds\n⅓ cup extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp paprika"
    },
    {
      "id": 209951,
      "primary_message": "To serve, divide asparagus, eggs, and Romesco sauce between plates. Top with feta and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
