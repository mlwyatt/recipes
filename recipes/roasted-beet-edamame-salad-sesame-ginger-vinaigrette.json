        "instructions": [
          {
            "id": 373467,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 373468,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "6 medium beets\n1 (1 inch) piece ginger root\n½ small pkg chives"
          },
          {
            "id": 373469,
            "primary_message": "Trim, peel, and cut beets into ½-inch cubes. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, then toss to coat. Spread out in an even layer.",
            "secondary_message": "1 tbsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 373470,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, stirring halfway through, until beets are fork-tender, about 25 minutes.",
            "secondary_message": null
          },
          {
            "id": 373471,
            "primary_message": "Meanwhile, place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
            "secondary_message": "2 cups edamame"
          },
          {
            "id": 373472,
            "primary_message": "Peel and mince ginger and garlic. Place in a medium bowl along with vinegar, soy sauce, oil, and maple syrup. Whisk to combine the dressing.",
            "secondary_message": "2 cloves garlic\n2 tbsp apple cider vinegar\n4 tsp soy sauce\n2 tsp toasted sesame oil\n2 tsp pure maple syrup"
          },
          {
            "id": 373473,
            "primary_message": "Chop chives into small pieces. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 373474,
            "primary_message": "When the beets are done, carefully transfer to the bowl with the dressing. Add edamame and stir to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 373475,
            "primary_message": "To serve, divide salad between bowls and enjoy!",
            "secondary_message": null
          }
        ],
