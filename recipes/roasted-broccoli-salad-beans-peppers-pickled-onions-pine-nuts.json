  "instructions": [
    {
      "id": 415724,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 415725,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n4 crowns broccoli\n1 small pkg fresh mint"
    },
    {
      "id": 415726,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 415727,
      "primary_message": "Separate broccoli into bite-sized florets. Add to the baking sheet with the bell peppers, drizzle with oil, and season with salt; stir to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 415728,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are starting to char, 20-25 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 415729,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup red wine vinegar\n1 ½ tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 415730,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 415731,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 415732,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to another small bowl and set aside to cool.",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 415733,
      "primary_message": "Place oil, vinegar, salt, and crushed red pepper in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 415734,
      "primary_message": "Drain and rinse beans in a colander. Add to the bowl with the dressing.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 415735,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 415736,
      "primary_message": "Add cooled veggies, pickled onions, pine nuts, and feta to the bowl. Gently stir to combine the salad. ",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 415737,
      "primary_message": "To serve, divide the salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
