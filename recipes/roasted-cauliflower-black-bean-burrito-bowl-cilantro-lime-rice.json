        "instructions": [
          {
            "id": 112687,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 112688,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 112689,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n2 tomatoes\n1 small bunch cilantro\n2 avocados\n2 limes"
          },
          {
            "id": 112690,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 112691,
            "primary_message": "Remove leaves and thick stems from cauliflower; cut into bite-sized florets and set aside.",
            "secondary_message": null
          },
          {
            "id": 112692,
            "primary_message": "In a small bowl, combine the spices.",
            "secondary_message": "1 tbsp chili powder\n½ tsp cumin\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp cayenne pepper\n1 tsp salt"
          },
          {
            "id": 112693,
            "primary_message": "Place the cauliflower on the baking sheet. Drizzle with oil and sprinkle with half of the seasoning mixture; toss to coat. Spread out in a single layer. Place in the oven and roast for 20 minutes, flipping once halfway through.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 112694,
            "primary_message": "Small dice the onion.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 112695,
            "primary_message": "Heat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 112696,
            "primary_message": "Add the onion to the skillet; cook, stirring frequently, until softened, 3-4 minutes.",
            "secondary_message": null
          },
          {
            "id": 112697,
            "primary_message": "Drain and rinse the black beans in a colander.",
            "secondary_message": "1 (15 oz) can black beans"
          },
          {
            "id": 112698,
            "primary_message": "Add the black beans, corn, and the rest of the seasoning mixture to the skillet and cook, stirring frequently, until the corn is softened, 3-4 minutes. Remove from heat and set aside.",
            "secondary_message": "1 cup frozen corn"
          },
          {
            "id": 112699,
            "primary_message": "Small dice the tomatoes.",
            "secondary_message": null
          },
          {
            "id": 112700,
            "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out with a spoon.",
            "secondary_message": null
          },
          {
            "id": 112701,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. When the rice is finished, add half of the cilantro to the rice.",
            "secondary_message": null
          },
          {
            "id": 112702,
            "primary_message": "Juice one lime into the rice and stir to combine. Slice the other lime into wedges for garnish.",
            "secondary_message": null
          },
          {
            "id": 112703,
            "primary_message": "To serve, divide the rice between bowls. Top with cauliflower, bean mixture, diced tomatoes, cilantro, avocado slices, and lime wedges. Enjoy!",
            "secondary_message": null
          }
        ],
