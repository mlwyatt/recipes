        "instructions": [
          {
            "id": 322236,
            "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
            "secondary_message": null
          },
          {
            "id": 322237,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n1 mango\n1 jalapeño pepper\n1 small bunch cilantro\n2 limes"
          },
          {
            "id": 322238,
            "primary_message": "Peel and mince garlic; place in a medium bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 322239,
            "primary_message": "Add oil and spices to the bowl with the garlic; whisk to combine the spice oil.",
            "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp paprika\n1 ½ tsp chili powder\n½ tsp salt"
          },
          {
            "id": 322240,
            "primary_message": "Cut leaves from the cauliflower, separate into bite-sized florets, and cut the thick stems into smaller pieces; add to the bowl with the spice oil and toss to coat. Transfer to the baking sheet and spread out in an even layer. (Reserve bowl for later use.)",
            "secondary_message": null
          },
          {
            "id": 322241,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until cauliflower is golden brown and tender, 15-20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 322242,
            "primary_message": "Meanwhile, peel mango and slice flesh away from the pit, starting with the flat sides. Small dice and place in the reserved bowl.",
            "secondary_message": null
          },
          {
            "id": 322243,
            "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the mango. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 322244,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the bowl. (Place remaining cilantro in a small bowl and set aside for the sauce.)",
            "secondary_message": null
          },
          {
            "id": 322245,
            "primary_message": "Juice one lime into the bowl with the mango. Add broccoli slaw, pumpkin seeds, and salt; toss to combine the slaw and set aside. (Reserve remaining lime for the next step.)",
            "secondary_message": "1 (12 oz) pkg broccoli slaw\n⅔ cup pumpkin seeds\n¼ tsp salt"
          },
          {
            "id": 322246,
            "primary_message": "Juice reserved lime into the bowl with the cilantro; add yogurt and salt. Whisk to combine the sauce and set aside.",
            "secondary_message": "½ cup plain Greek yogurt\n¼ tsp salt"
          },
          {
            "id": 322247,
            "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
            "secondary_message": "12 small corn tortillas"
          },
          {
            "id": 322248,
            "primary_message": "To serve, divide tortillas between plates; fill with slaw, cauliflower, and sauce. Enjoy!",
            "secondary_message": null
          }
        ],
