  "instructions": [
    {
      "id": 16594,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 16595,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 16596,
      "primary_message": "Peel and thinly slice onion into half rings. Wash and halve tomatoes.",
      "secondary_message": "1 medium red onion\r\n1 pint grape tomatoes"
    },
    {
      "id": 16597,
      "primary_message": "Place chickpeas, onion, and tomatoes on a baking sheet pan. Drizzle with olive oil and season with salt and pepper. Toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 16598,
      "primary_message": "Place in the oven and roast until chickpeas are golden and tomatoes begin to collapse, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 16599,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lemon juice, olive oil, Dijon, oregano, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\njuice of 1 lemon\r\n4 tbsp extra virgin olive oil\r\n1 tsp Dijon mustard\r\n1 tsp oregano\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 16600,
      "primary_message": "Wash and dry arugula. Transfer to a large bowl.",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 16601,
      "primary_message": "Add chickpeas, onion, tomatoes, and feta to bowl with arugula and toss.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 16602,
      "primary_message": "To serve, arrange salad on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
