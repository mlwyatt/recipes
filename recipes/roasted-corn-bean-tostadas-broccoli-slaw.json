  "instructions": [
    {
      "id": 97331,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 97332,
      "primary_message": "Remove the husks from the corn and brush with oil. Place on the top rack in the oven and cook for 6-8 minutes, flipping halfway through, until the corn begins to turn golden brown.",
      "secondary_message": "4 ears corn\n2 tsp extra virgin olive oil"
    },
    {
      "id": 97333,
      "primary_message": "Wash and dry the fresh produce. Skip the broccoli slaw if it came pre-washed.",
      "secondary_message": "2 tomatoes\n1 small bunch cilantro\n1 (12 oz) pkg broccoli slaw\n3 limes"
    },
    {
      "id": 97334,
      "primary_message": "Small dice the tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 97335,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 97336,
      "primary_message": "When the corn is done cooking, remove from oven and let cool for 5-6 minutes, until slightly warm to the touch.",
      "secondary_message": null
    },
    {
      "id": 97337,
      "primary_message": "Preheat oven to 400°F. Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 97338,
      "primary_message": "Drizzle both sides of the tortillas with oil and sprinkle with salt; place in a single layer on two baking sheets. Bake for 10-15 minutes, flipping halfway through, until the tortillas are crispy and lightly browned on both sides.",
      "secondary_message": "12 small corn tortillas\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 97339,
      "primary_message": "While tortillas bake, drain and rinse the beans in a colander; add to a medium bowl.",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "id": 97340,
      "primary_message": "Juice two limes and add to the bowl with the beans.",
      "secondary_message": null
    },
    {
      "id": 97341,
      "primary_message": "Add oil, spices, and water to the bowl. Use a fork or potato masher to mash the mixture until smooth.",
      "secondary_message": "¼ cup extra virgin olive oil\n½ tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp chili powder\n½ tsp cumin\n2 tbsp water"
    },
    {
      "id": 97342,
      "primary_message": "When the tortillas are done, remove from the oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 97343,
      "primary_message": "Stand corn upright on a cutting board and use a sharp knife to carefully cut kernels off of the cob.",
      "secondary_message": null
    },
    {
      "id": 97344,
      "primary_message": "Cut the remaining lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 97345,
      "primary_message": "To assemble, top the tortillas with bean mixture, tomatoes, broccoli slaw, roasted corn, and cilantro. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
