        "instructions": [
          {
            "id": 246751,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 246752,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "2 eggplants\n1 lemon\n1 (5 oz) pkg baby arugula\n1 small pkg fresh basil"
          },
          {
            "id": 246753,
            "primary_message": "Trim and cut eggplants into ¾-inch cubes; transfer to a large baking sheet pan. Drizzle with oil and season with spices; toss to coat, then spread out in a single layer.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 246754,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until eggplant is soft and browned, 20-25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 246755,
            "primary_message": "Meanwhile, arrange flatbreads on another large baking sheet. Place in the oven and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from oven and set aside.",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 246756,
            "primary_message": "While the flatbreads are toasting, juice lemon into a large bowl. Add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 246757,
            "primary_message": "Place tomato sauce and spices in a small bowl; whisk to combine and set aside.",
            "secondary_message": "1 (8 oz) can tomato sauce\n½ tsp Italian seasoning\n⅛ tsp onion powder\n⅛ tsp garlic powder\n⅛ tsp crushed red pepper\n⅛ tsp salt"
          },
          {
            "id": 246758,
            "primary_message": "Coarsely grate mozzarella.",
            "secondary_message": "½ (8 oz) block mozzarella cheese"
          },
          {
            "id": 246759,
            "primary_message": "When the eggplant is done, prepare the flatbreads. Spread tomato sauce over each flatbread; top with mozzarella and eggplant. ",
            "secondary_message": null
          },
          {
            "id": 246760,
            "primary_message": "Return flatbreads to the oven and bake until warmed through and cheese is melted, about 5 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 246761,
            "primary_message": "Meanwhile, add arugula to the bowl with the dressing and toss to coat.",
            "secondary_message": null
          },
          {
            "id": 246762,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 246763,
            "primary_message": "Slice flatbreads, divide between plates, and sprinkle with basil. Serve with lemony arugula on the side and enjoy!",
            "secondary_message": null
          }
        ],
