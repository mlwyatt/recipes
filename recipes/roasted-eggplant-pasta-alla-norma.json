  "instructions": [
    {
      "id": 12614,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": ""
    },
    {
      "id": 12615,
      "primary_message": "Wash and large dice eggplant. Transfer to a sheet pan. Drizzle with oil and season with oregano, salt, and pepper; toss to coat.",
      "secondary_message": "2 eggplant\n4 tbsp extra virgin olive oil\n1 tsp oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 12616,
      "primary_message": "Place in the oven and, stirring halfway though, bake until softened and browned, about 20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 12617,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "about 14 cups water\n2 tbsp salt\n12 oz (1 quarter coin = 2 oz) linguine pasta"
    },
    {
      "id": 12618,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 12619,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "1 medium yellow onion\r\n6 cloves garlic"
    },
    {
      "id": 12620,
      "primary_message": "Coat bottom of pan with oil. Add onion and, stirring frequently, cook until softened, 4-5 minutes.",
      "secondary_message": "about 2 tbsp extra virgin olive oil"
    },
    {
      "id": 12621,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 12622,
      "primary_message": "Add garlic and pepper to pan. Stir until fragrant, 15-30 seconds.",
      "secondary_message": "½ tsp crushed red pepper"
    },
    {
      "id": 12623,
      "primary_message": "Add tomatoes, vinegar, sugar, spices, and ½ of the basil (save the rest for garnishing). Cook for 4-6 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n1 tsp white wine vinegar\n⅛ tsp brown sugar\n1 tsp Italian seasoning\n½ tsp salt  "
    },
    {
      "id": 12624,
      "primary_message": "Shave or grate ¼ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 12625,
      "primary_message": "Drain pasta and add to pan with tomatoes. Add eggplant and toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 12626,
      "primary_message": "To serve, place pasta in a shallow bowl or on a plate. Garnish with remaining basil and sprinkle with Parmesan. Enjoy!",
      "secondary_message": ""
    }
  ],
