        "instructions": [
          {
            "id": 100370,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 100371,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 eggplants\n2 English cucumbers\n4 tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
          },
          {
            "id": 100372,
            "primary_message": "Large dice the eggplant. Transfer to a parchment lined sheet pan. Drizzle with oil and season with salt, pepper, and oregano; toss to coat. Bake for 20 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n1 tsp oregano"
          },
          {
            "id": 100373,
            "primary_message": "Use a grater to coarsely grate the cucumber. Transfer to a medium bowl. Add the salt, stir, and let sit for 5 minutes.",
            "secondary_message": "½ tsp salt"
          },
          {
            "id": 100374,
            "primary_message": "Peel and mince garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 100375,
            "primary_message": "Peel and thinly slice onion into half rings. Add to a small bowl along with the vinegar and salt. Toss to combine and set aside.",
            "secondary_message": "1 medium red onion\n2 tbsp red wine vinegar\n¼ tsp salt"
          },
          {
            "id": 100376,
            "primary_message": "Halve and thinly slice the tomato.",
            "secondary_message": null
          },
          {
            "id": 100377,
            "primary_message": "Shave leaves off the parsley stems; discard the stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 100378,
            "primary_message": "Gather the grated cucumber in the middle of a clean dish towel and gently squeeze out the water. Add the cucumber back to the medium bowl. Stir in the minced garlic, yogurt, salt, and dill. Juice the lemon and add to the mixture. Set aside.",
            "secondary_message": "1 cup plain Greek yogurt\n1 tsp salt\n¼ tsp dill"
          },
          {
            "id": 100379,
            "primary_message": "To assemble, slice the pita bread into halves and open the pocket. Stuff with roasted eggplant, sliced tomato, onion, parsley, and cucumber sauce. Enjoy!",
            "secondary_message": "8 whole grain pitas"
          }
        ],
