        "instructions": [
          {
            "id": 466679,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 466680,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 466681,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "4 fennel bulbs\n1 lemon\n1 bunch radish\n1 small bunch fresh dill\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 466682,
            "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to combine and spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 466683,
            "primary_message": "Place fennel in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until slightly browned and tender, about 20 minutes. Remove from oven and set aside to cool, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 466684,
            "primary_message": "Meanwhile, juice lemon into a large bowl. Add oil, maple syrup, and spices, then whisk to combine the dressing.",
            "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
          },
          {
            "id": 466685,
            "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 466686,
            "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 466687,
            "primary_message": "Roughly chop dates and pistachios. Add both to the bowl. ",
            "secondary_message": "⅔ cup medjool dates, pitted\n⅔ cup pistachios, unsalted"
          },
          {
            "id": 466688,
            "primary_message": "Transfer the cooked quinoa to another baking sheet. Spread out in an even layer and let cool for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 466689,
            "primary_message": "Add cooled fennel and quinoa to the bowl, along with arugula and feta, then toss to combine the salad.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 466690,
            "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
