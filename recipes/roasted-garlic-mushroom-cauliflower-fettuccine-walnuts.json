  "instructions": [
    {
      "id": 294555,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 294556,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 lb cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley\n2 tomatoes\n1 lemon"
    },
    {
      "id": 294557,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 294558,
      "primary_message": "Quarter mushrooms and add to the baking sheet with the cauliflower. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 294559,
      "primary_message": "Peel garlic, place in the center of a small square of aluminum foil, and drizzle with oil; fold foil around garlic to close the packet. Add to the baking sheet with the veggies.",
      "secondary_message": "8 cloves garlic\n2 tsp extra virgin olive oil"
    },
    {
      "id": 294560,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing veggies halfway through, until golden brown and tender (and garlic is soft), 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 294561,
      "primary_message": "While the veggies are roasting, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and return pasta to the pot. (Reserve 1 cup pasta cooking water.)",
      "secondary_message": "2 tsp salt\n10 oz fettuccine pasta"
    },
    {
      "id": 294562,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 294563,
      "primary_message": "Small dice tomatoes; add to the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 294564,
      "primary_message": "Finely grate Parmesan; add to the bowl.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 294565,
      "primary_message": "Once the garlic is ready, carefully open the packet; use a fork to mash the roasted garlic. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 294566,
      "primary_message": "Juice lemon into the pot with the pasta; add roasted veggies, parsley, tomato, Parmesan, roasted garlic, and reserved pasta water. Return to low heat and cook, stirring occasionally, until pasta is heated through and cheese is melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 294567,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 294568,
      "primary_message": "To serve, divide pasta between plates or bowls and top with chopped walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
