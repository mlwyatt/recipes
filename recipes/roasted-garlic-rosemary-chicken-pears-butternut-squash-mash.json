        "instructions": [
          {
            "id": 12218,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": ""
          },
          {
            "id": 12219,
            "primary_message": "Peel and mince garlic. In a large bowl, mix together ½ of the garlic (save the rest for the mash), oil, rosemary, salt, and pepper.",
            "secondary_message": "8 cloves garlic\r\n2 tbsp extra virgin olive oil\r\n1 tsp rosemary\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 12220,
            "primary_message": "Place chicken in bowl and toss to coat.",
            "secondary_message": "2 lb chicken thighs, boneless skinless"
          },
          {
            "id": 12221,
            "primary_message": "Wash, core, and slice pears into wedges.",
            "secondary_message": "4 pears"
          },
          {
            "id": 12222,
            "primary_message": "Fill a medium saucepan halfway with water and bring to a boil.",
            "secondary_message": "about 7 cups water"
          },
          {
            "id": 12223,
            "primary_message": "Transfer chicken and pears to a baking dish. Place in the oven and roast for 15 minutes. Then broil until lightly browned, an additional 3-4 minutes.",
            "secondary_message": ""
          },
          {
            "id": 12224,
            "primary_message": "Wash and peel squash. Halve, scrape out and discard the seeds, and medium dice the flesh.",
            "secondary_message": "2 small butternut squash"
          },
          {
            "id": 12225,
            "primary_message": "Add squash to saucepan once water is boiling. Cook until very tender, 10-12 minutes.",
            "secondary_message": ""
          },
          {
            "id": 12226,
            "primary_message": "Drain and return back to saucepan. Add broth, oil, salt, pepper, and remaining garlic. Mash until smooth.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 12227,
            "primary_message": "To serve, arrange squash mash on a plate and place chicken thighs and pears on top. Enjoy!",
            "secondary_message": ""
          }
        ],
