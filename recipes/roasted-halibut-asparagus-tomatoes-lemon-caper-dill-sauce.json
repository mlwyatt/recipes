        "instructions": [
          {
            "id": 271037,
            "primary_message": "Preheat oven to 425°F. Position racks in the upper and lower thirds of the oven.",
            "secondary_message": null
          },
          {
            "id": 271038,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 small bunches asparagus\n1 pint grape tomatoes\n1 lemon\n1 small bunch fresh dill"
          },
          {
            "id": 271039,
            "primary_message": "Cut butter into small pieces and place in a small bowl; set aside.",
            "secondary_message": "⅓ cup butter, unsalted"
          },
          {
            "id": 271040,
            "primary_message": "Snap or cut off woody ends of the asparagus; halve tomatoes. Transfer both to a large baking sheet pan, spreading them out in an even layer. Season with salt and pepper, then sprinkle ⅓ of the butter over veggies. ",
            "secondary_message": "½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 271041,
            "primary_message": "Place baking sheet on lower rack of the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until crisp-tender, 12-15 minutes. Remove from the oven. ",
            "secondary_message": null
          },
          {
            "id": 271042,
            "primary_message": "Meanwhile, pat halibut dry with paper towels, cut into portions (if necessary), and transfer to a baking sheet. Season with spices, then sprinkle ½ of the remaining butter over fish. ",
            "secondary_message": "1 ½ lb halibut fillet\n1 tsp salt\n½ tsp black pepper\n½ tsp thyme, dried"
          },
          {
            "id": 271043,
            "primary_message": "Place baking sheet on upper rack of the oven and roast until fish is cooked through, about 12 minutes. Remove from the oven. ",
            "secondary_message": null
          },
          {
            "id": 271044,
            "primary_message": "While the fish is roasting, preheat a small saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 271045,
            "primary_message": "While the pan heats up, using a clean cutting board, peel and mince garlic. ",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 271046,
            "primary_message": "Once the pan is hot, add remaining butter and swirl to coat the bottom. Add garlic and cook, stirring frequently, until fragrant, about 1 minute.",
            "secondary_message": null
          },
          {
            "id": 271047,
            "primary_message": "Zest and juice lemon into the pan with the garlic; add cream, capers, salt, and pepper. Bring sauce to a simmer and cook, stirring occasionally, until slightly thickened, 4-5 minutes.",
            "secondary_message": "8 fl oz (1 cup) heavy whipping cream\n2 tbsp capers\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 271048,
            "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. ",
            "secondary_message": null
          },
          {
            "id": 271049,
            "primary_message": "Add half of the dill (reserving the rest for garnish) to the sauce and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 271050,
            "primary_message": "To serve, divide fish and veggies between plates; spoon sauce over fish and sprinkle with reserved dill. Enjoy!",
            "secondary_message": null
          }
        ],
