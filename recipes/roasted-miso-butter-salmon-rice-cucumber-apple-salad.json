        "instructions": [
          {
            "id": 399917,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 399918,
            "primary_message": "Cut butter into small pieces, place in a small bowl, and set aside to soften.",
            "secondary_message": "3 tbsp butter, unsalted"
          },
          {
            "id": 399919,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 399920,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 399921,
            "primary_message": "Add miso paste, salt, and pepper to the bowl with the butter. Using the back of a spoon, mash and combine the miso butter until smooth.",
            "secondary_message": "4 tsp miso paste, red\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 399922,
            "primary_message": "Pat the fish dry with paper towels and place, skin-side down, on a baking sheet pan. Spread ⅔ of the miso butter over the top-side of the salmon (reserve remaining miso butter for the rice).",
            "secondary_message": "1 ½ lb salmon fillet"
          },
          {
            "id": 399923,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until salmon is golden and cooked through, 10-12 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 399924,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small pkg chives\n1 English cucumber\n2 Gala apples"
          },
          {
            "id": 399925,
            "primary_message": "Cut chives into small pieces. Place in a medium bowl along with the dressing and salt, then stir to combine. ",
            "secondary_message": "¼ cup ranch dressing\n⅛ tsp salt"
          },
          {
            "id": 399926,
            "primary_message": "Trim and quarter cucumber lengthwise, then slice crosswise into thin pieces. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 399927,
            "primary_message": "Quarter, core, and small dice apples. Add to the bowl, stir to combine the salad, and set aside.",
            "secondary_message": null
          },
          {
            "id": 399928,
            "primary_message": "When the rice is done, add remaining miso butter to the pan. Stir to combine. ",
            "secondary_message": null
          },
          {
            "id": 399929,
            "primary_message": "To serve, divide salmon, salad, and rice between plates. Enjoy!",
            "secondary_message": null
          }
        ],
