  "instructions": [
    {
      "id": 23555,
      "primary_message": "Preheat oven to 475°F and position rack in the centre. Place a baking sheet pan in the oven to warm up.",
      "secondary_message": ""
    },
    {
      "id": 23556,
      "primary_message": "Peel, cut into thin wedges, and transfer onion to a large bowl.",
      "secondary_message": "1 medium red onion\r\n"
    },
    {
      "id": 23557,
      "primary_message": "Wash and dry beets, carrots, celery, potatoes, and thyme.",
      "secondary_message": "4 medium beets\r\n4 medium carrots\r\n2 sticks celery\r\n2 medium yellow potatoes\r\n1 small pkg fresh thyme"
    },
    {
      "id": 23558,
      "primary_message": "Peel and cut beets into thin wedges; add to bowl with onion. Peel and cut carrots diagonally into ¼ inch thick rounds; add to bowl. Cut celery crosswise into ¼ inch thick pieces; add to bowl. Cut potatoes into thin wedges; add to bowl. Slide leaves off most of the thyme stems (saving a couple stems for garnishing); add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 23559,
      "primary_message": "Drizzle vegetables with olive oil and season with salt, and pepper; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n¼ tsp black pepper "
    },
    {
      "id": 23560,
      "primary_message": "Remove sheet from oven and, using a paper towel, rub with a little olive oil. Place vegetables on sheet and spread out. Place in the oven and roast until vegetables are tender, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23561,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 23562,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "1 cup walnuts\r\n"
    },
    {
      "id": 23563,
      "primary_message": "Add walnuts to skillet and, stirring constantly, cook until toasted, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23564,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, olive oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "4 cloves garlic\r\n6 tbsp extra virgin olive oil\r\n2 tbsp balsamic vinegar\r\n½ tsp Dijon mustard\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23565,
      "primary_message": "Serve salad on a plate or in a bowl, sprinkle with walnuts, crumble goat cheese over top, drizzle with dressing, and garnish with remaining thyme. Enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese\r\n"
    }
  ],
