  "instructions": [
    {
      "id": 25828,
      "primary_message": "Preheat the oven to 425°F and position rack in the centre. Line a baking sheet with parchment paper.",
      "secondary_message": ""
    },
    {
      "id": 25829,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "4 cloves garlic\r\n"
    },
    {
      "id": 25830,
      "primary_message": "Wash the asparagus and snap (or cut) off the woody ends. Transfer to the baking sheet. Drizzle with olive oil and season with the minced garlic and salt and pepper; toss to coat. Spread out in a single layer, leaving room for the salmon in the middle.",
      "secondary_message": "2 bunches asparagus\r\n2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25831,
      "primary_message": "Place the salmon fillets, skin-side down, in the middle of the baking sheet. Rub with olive oil and season with salt and pepper.",
      "secondary_message": "1 ½ lb salmon fillet\r\n2 tsp extra virgin olive oil\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 25832,
      "primary_message": "Place in the oven and bake until the salmon is opaque and the asparagus is tender, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25833,
      "primary_message": "In a small saucepan, melt the butter over medium heat. Let it brown slightly, then remove from heat. Stir in the balsamic vinegar and soy sauce. Cover to keep warm.",
      "secondary_message": "4 tbsp butter, unsalted\r\n2 tbsp balsamic vinegar\r\n2 tsp soy sauce"
    },
    {
      "id": 25834,
      "primary_message": "To serve, arrange asparagus on a plate and place the salmon on top. Spoon the balsamic-butter sauce over top. Enjoy!",
      "secondary_message": ""
    }
  ],
