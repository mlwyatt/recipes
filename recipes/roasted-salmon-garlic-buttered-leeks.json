  "instructions": [
    {
      "id": 22809,
      "primary_message": "Preheat oven to 425°F and position rack in the centre.",
      "secondary_message": ""
    },
    {
      "id": 22810,
      "primary_message": "Pat salmon dry with a paper towel and place, skin-side down, on a baking sheet. Rub with olive oil, drizzle with lemon juice, and season with salt and freshly ground pepper. Set aside.",
      "secondary_message": "1 ½ lb salmon fillet\r\n2 tsp extra virgin olive oil\r\njuice of ½ lemon\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 22811,
      "primary_message": "Wash leeks and trim ends. Slice on the diagonal into ¼ inch thick pieces.",
      "secondary_message": "6 leeks\r\n"
    },
    {
      "id": 22812,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 22813,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic\r\n"
    },
    {
      "id": 22814,
      "primary_message": "Place salmon in the oven and roast until it's opaque, 10-15 minutes (depending on thickness).",
      "secondary_message": ""
    },
    {
      "id": 22815,
      "primary_message": "Melt butter in skillet. Add garlic and stir until fragrant, 15-30 seconds. Add leeks and season with thyme, salt, and freshly ground pepper; stir to coat in the butter. Reduce heat to low and cook, stirring occasionally, until leeks are tender, about 10 minutes.",
      "secondary_message": "6 tbsp butter, unsalted\r\n1 tsp thyme\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 22816,
      "primary_message": "Serve salmon with buttered leeks on the side. Drizzle with juice from remaining ¼ lemon and enjoy!",
      "secondary_message": ""
    }
  ],
