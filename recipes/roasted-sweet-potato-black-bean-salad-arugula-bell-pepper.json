  "instructions": [
    {
      "id": 16926,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 16927,
      "primary_message": "Wash, peel, and medium dice potatoes. Transfer to a baking sheet pan. Drizzle with olive oil and season with salt and pepper; toss to coat.",
      "secondary_message": "1 lb sweet potatoes\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 16928,
      "primary_message": "Place in the oven and roast until tender, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 16929,
      "primary_message": "Drain and rinse beans. Place on paper towels and pat dry.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 16930,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lime juice, olive oil, vinegar, Dijon, honey, cumin, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\njuice of 1 lime\r\n6 tbsp extra virgin olive oil\r\n2 tbsp red wine vinegar\r\n1 tsp Dijon mustard\r\n1 tsp honey\r\n½ tsp cumin\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 16931,
      "primary_message": "Wash and dry arugula.",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 16932,
      "primary_message": "Wash, seed, and medium dice bell peppers.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 16933,
      "primary_message": "To serve, arrange a bed of arugula on a plate, top with potatoes, beans, and bell pepper. Drizzle with dressing and enjoy!",
      "secondary_message": ""
    }
  ],
