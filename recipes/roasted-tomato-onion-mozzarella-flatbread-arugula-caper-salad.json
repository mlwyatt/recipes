  "instructions": [
    {
      "id": 312045,
      "primary_message": "Preheat oven to 450°F. Place oven racks in the upper and middle positions.",
      "secondary_message": null
    },
    {
      "id": 312046,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 pints grape tomatoes\n1 lemon\n1 yellow bell pepper\n1 small pkg fresh basil\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 312047,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick pieces; halve tomatoes. Transfer both to a baking sheet pan, drizzle with oil, and season with spices. Toss to combine, then spread out in an even layer.",
      "secondary_message": "1 medium red onion\n2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 312048,
      "primary_message": "Place baking sheet on the upper rack of the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies soften, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 312049,
      "primary_message": "Meanwhile, arrange flatbreads on a large baking sheet. Place on the lower rack and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from oven and set aside.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 312050,
      "primary_message": "While the flatbreads are baking, juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 312051,
      "primary_message": "Peel and mince garlic; mince capers. Add both to the bowl with the lemon juice along with oil, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp capers\n4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 312052,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 312053,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 312054,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 312055,
      "primary_message": "When the veggies are done, sprinkle mozzarella over the flatbreads; top with the roasted veggies and half of the basil. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 312056,
      "primary_message": "Return flatbreads to the oven and bake until warmed through and cheese is melted, about 5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 312057,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and bell pepper; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 312058,
      "primary_message": "Slice flatbreads, divide between plates, and sprinkle with reserved basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
