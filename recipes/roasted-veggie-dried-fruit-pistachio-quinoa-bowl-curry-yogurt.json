        "instructions": [
          {
            "id": 205808,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 205809,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 205810,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 small bunches asparagus\n2 medium zucchini squash\n1 lime"
          },
          {
            "id": 205811,
            "primary_message": "Snap or cut off the woody ends of the asparagus and cut into 2-inch pieces. Place on a large baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 205812,
            "primary_message": "Trim and cut the zucchini crosswise into thin rounds; add to the baking sheet. Drizzle veggies with oil, season with spices, and toss to coat.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp cumin\n½ tsp turmeric\n½ tsp cinnamon\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 205813,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are fork-tender, 15-18 minutes. Remove from the oven.",
            "secondary_message": null
          },
          {
            "id": 205814,
            "primary_message": "Meanwhile, zest and juice lime into a small bowl. Add yogurt and spices; whisk to combine the sauce.",
            "secondary_message": "1 cup plain Greek yogurt\n2 tsp curry powder\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 205815,
            "primary_message": "Coarsely chop pistachios and place in another small bowl along with the raisins.",
            "secondary_message": "1 cup pistachios, unsalted\n½ cup raisins"
          },
          {
            "id": 205816,
            "primary_message": "Medium dice apricots and add to the bowl with the pistachios; stir to combine.",
            "secondary_message": "12 dried apricots"
          },
          {
            "id": 205817,
            "primary_message": "To serve, divide quinoa between bowls and top with roasted veggies; sprinkle with fruit and nut mix. Drizzle with sauce and enjoy!",
            "secondary_message": null
          }
        ],
