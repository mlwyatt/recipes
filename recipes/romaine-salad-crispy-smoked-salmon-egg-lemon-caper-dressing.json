        "instructions": [
          {
            "id": 265451,
            "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
            "secondary_message": "4 eggs"
          },
          {
            "id": 265452,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n1 bunch radish\n2 tomatoes\n2 avocados\n2 heads romaine lettuce"
          },
          {
            "id": 265453,
            "primary_message": "Zest and juice lemon into a large bowl.",
            "secondary_message": null
          },
          {
            "id": 265454,
            "primary_message": "Peel and mince garlic; add to the bowl with the lemon zest.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 265455,
            "primary_message": "Mince capers; add to the bowl along with cream, mayo, Dijon, honey, salt, and pepper. Whisk to combine the dressing and set aside.",
            "secondary_message": "1 tbsp capers\n2 fl oz (¼ cup) heavy whipping cream\n⅓ cup mayonnaise\n4 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 265456,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 265457,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add smoked salmon slices to the skillet in a single layer; cook, flipping once, until crispy, about 4 minutes. Remove to a paper towel-lined plate and set aside.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 (4 oz) pkgs smoked salmon"
          },
          {
            "id": 265458,
            "primary_message": "Meanwhile, peel, halve, and thinly slice shallot; add to the bowl with the dressing.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 265459,
            "primary_message": "Trim and thinly slice radishes; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 265460,
            "primary_message": "Medium dice tomatoes and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 265461,
            "primary_message": "Halve avocados and remove pits; scoop out the flesh and medium dice. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 265462,
            "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 265463,
            "primary_message": "Peel and slice eggs crosswise into thin rounds. Chop or tear crispy smoked salmon into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 265464,
            "primary_message": "To serve, divide salad between plates or bowls; top with eggs and crispy smoked salmon. Enjoy!",
            "secondary_message": null
          }
        ],
