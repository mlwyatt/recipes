        "instructions": [
          {
            "id": 237702,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 small pkg fresh basil\n1 lemon\n2 (5 oz) pkgs baby spinach\n2 avocados\n4 tomatoes"
          },
          {
            "id": 237703,
            "primary_message": "Mince olives and sun-dried tomatoes; transfer both to a small bowl along with oil, vinegar, salt, and pepper. Stir to combine the tapenade and set aside.",
            "secondary_message": "¼ cup Kalamata olives, pitted\n8 sun-dried tomatoes, oil-packed\n2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 237704,
            "primary_message": "Pour broth into a large pot, add spices, and bring to a boil over medium heat. Once boiling, reduce to a simmer.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n1 tsp salt\n½ tsp black pepper\n¼ tsp nutmeg, ground"
          },
          {
            "id": 237705,
            "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 237706,
            "primary_message": "Finely grate Parmesan; add to the bowl with the basil (setting a small handful aside for garnish).",
            "secondary_message": "4 oz Parmesan cheese"
          },
          {
            "id": 237707,
            "primary_message": "Juice lemon into the bowl.",
            "secondary_message": null
          },
          {
            "id": 237708,
            "primary_message": "Add eggs to the bowl and whisk until well blended; set aside.",
            "secondary_message": "8 eggs"
          },
          {
            "id": 237709,
            "primary_message": "Roughly chop spinach.",
            "secondary_message": null
          },
          {
            "id": 237710,
            "primary_message": "Add spinach to the simmering broth in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
            "secondary_message": null
          },
          {
            "id": 237711,
            "primary_message": "Slowly pour the egg mixture into the soup, while gently stirring, to separate into ribbons. Simmer until the egg is cooked through, 2-3 minutes; cover and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 237712,
            "primary_message": "Meanwhile, halve and pit the avocados. Slice thinly while still in skin and scoop out with a spoon. Thinly slice tomatoes.",
            "secondary_message": null
          },
          {
            "id": 237713,
            "primary_message": "Arrange avocado and tomato slices on plates and spoon tapenade over top.",
            "secondary_message": null
          },
          {
            "id": 237714,
            "primary_message": "Divide soup between bowls and top with reserved Parmesan. Serve with salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
