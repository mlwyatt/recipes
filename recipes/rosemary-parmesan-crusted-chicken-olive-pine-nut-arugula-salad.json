  "instructions": [
    {
      "id": 294387,
      "primary_message": "Preheat oven to 425°F. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional). Coat with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 294388,
      "primary_message": "Finely grate Parmesan and place in a medium bowl.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 294389,
      "primary_message": "Add bread crumbs and spices to the bowl with the Parmesan; stir to combine the coating.",
      "secondary_message": "1 cup panko bread crumbs\n2 tsp rosemary, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 294390,
      "primary_message": "Crack eggs into another medium bowl and beat with a whisk or fork.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 294391,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Sprinkle flour over both sides to coat.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n2 tbsp all-purpose flour"
    },
    {
      "id": 294392,
      "primary_message": "Dip chicken cutlets, one at a time, into the egg; shake off excess, then dredge in the bread crumb coating, pressing to adhere. Transfer to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 294393,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until the chicken is golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 294394,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 lemons\n1 English cucumber\n2 medium carrots\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 294395,
      "primary_message": "Using a clean cutting board, slice one lemon into wedges and set aside for serving. Juice remaining lemon into a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 294396,
      "primary_message": "Add oil, Dijon, maple syrup, salt, and pepper to the bowl with the lemon juice; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp pure maple syrup\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 294397,
      "primary_message": "Trim, halve, and thinly slice cucumber crosswise into half-moons; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 294398,
      "primary_message": "Trim, peel, halve, and thinly slice carrots crosswise into half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 294399,
      "primary_message": "Halve olives; add to the bowl along with the arugula and pine nuts. Toss to combine the salad.",
      "secondary_message": "½ cup Kalamata olives, pitted\n¼ cup pine nuts"
    },
    {
      "id": 294400,
      "primary_message": "To serve, divide chicken and salad between plates. Squeeze lemon over the chicken and enjoy!",
      "secondary_message": null
    }
  ],
