        "instructions": [
          {
            "id": 277579,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 277580,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "½ small pkg fresh rosemary\n2 small butternut squash\n2 caps portobello mushrooms\n1 lemon"
          },
          {
            "id": 277581,
            "primary_message": "Slide rosemary leaves off the stems; discard the stems and mince the leaves. Place in a small bowl.",
            "secondary_message": null
          },
          {
            "id": 277582,
            "primary_message": "Peel and mince garlic. Add to the bowl with the rosemary along with oil, vinegar, salt, and pepper; stir to combine the marinade.",
            "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 277583,
            "primary_message": "Trim and peel each squash. Halve lengthwise, scrape out seeds, and cut into 1-inch cubes; transfer to a large baking sheet pan. Spoon half of the marinade over the squash (reserving the rest for the salmon), toss to coat, and spread out in an even layer.",
            "secondary_message": null
          },
          {
            "id": 277584,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, about 25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 277585,
            "primary_message": "Meanwhile, peel and mince shallots and additional garlic; place in another small bowl.",
            "secondary_message": "2 shallots\n2 cloves garlic"
          },
          {
            "id": 277586,
            "primary_message": "Using a box grater, coarsely grate the mushrooms; add to the bowl with the shallot and garlic. (Alternatively, you can mince the mushrooms.)",
            "secondary_message": null
          },
          {
            "id": 277587,
            "primary_message": "Preheat a medium saucepan over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 277588,
            "primary_message": "While the pan heats up, using a strainer or colander, rinse the rice under cold, running water, then set aside to drain.",
            "secondary_message": "1 cup basmati rice"
          },
          {
            "id": 277589,
            "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add shallot, garlic, mushroom, salt, and pepper; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 277590,
            "primary_message": "Add rice and broth to the pan, stir to combine, and bring to a boil over high heat. Once the broth comes to a boil, cover the pan and reduce heat to low. Cook mushroom-rice until liquid is mostly absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
          },
          {
            "id": 277591,
            "primary_message": "Meanwhile, coat another baking sheet with a thin layer of oil. Pat salmon dry with paper towels and place, skin-side down, on the baking sheet; drizzle with remaining marinade. Add salmon to the oven and roast until flakey and cooked through, about 12 minutes. Remove from oven.",
            "secondary_message": "1 tsp extra virgin olive oil\n1 ½ lb salmon fillet"
          },
          {
            "id": 277592,
            "primary_message": "While the salmon is roasting, cut lemon into wedges and set aside for serving.",
            "secondary_message": null
          },
          {
            "id": 277593,
            "primary_message": "Finely grate Parmesan. When the mushroom-rice is done, add Parmesan to the pan and stir until creamy and combined. ",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 277594,
            "primary_message": "Divide squash, creamy mushroom-rice, and salmon between plates; serve with lemon wedges for squeezing. Enjoy!",
            "secondary_message": null
          }
        ],
