        "instructions": [
          {
            "id": 399571,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth, then bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 399572,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 399573,
            "primary_message": "Meanwhile, place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a medium bowl, and set aside.",
            "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
          },
          {
            "id": 399574,
            "primary_message": "Wash and dry bell peppers. Using a clean cutting board, trim, seed, and halve crosswise; slice each half into thin strips. Place in another medium bowl along with the butternut squash.",
            "secondary_message": "2 red bell peppers\n2 yellow bell peppers\n4 cup frozen butternut squash, pieces"
          },
          {
            "id": 399575,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 399576,
            "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the bell pepper and squash.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 399577,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, cover with a lid, and cook, stirring occasionally, until just tender, 4-5 minutes.",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 399578,
            "primary_message": "When the veggies are done, add chicken and stir-fry sauce to the skillet. Continue to cook, stirring occasionally, until chicken and sauce are warmed through, 1-2 minutes more. Remove from heat.",
            "secondary_message": "½ cup stir-fry sauce"
          },
          {
            "id": 399579,
            "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
