        "instructions": [
          {
            "id": 370135,
            "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a medium bowl, and set aside.",
            "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
          },
          {
            "id": 370136,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium carrots\n2 sticks celery\n2 medium zucchini squash\n1 lime\n1 small bunch cilantro"
          },
          {
            "id": 370137,
            "primary_message": "Using a clean cutting board, peel, halve, and small dice onion; peel and mince garlic. Place both in another medium bowl.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 370138,
            "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the onion and garlic.",
            "secondary_message": null
          },
          {
            "id": 370139,
            "primary_message": "Trim and slice celery crosswise into thin pieces; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 370140,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 370141,
            "primary_message": "While the pot heats up, trim and halve zucchini lengthwise, then slice crosswise into thin half-moons; add to the bowl with the other veggies.",
            "secondary_message": null
          },
          {
            "id": 370142,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
            "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n½ tsp oregano, dried\n½ tsp salt"
          },
          {
            "id": 370143,
            "primary_message": "Meanwhile, cut lime into wedges and set aside.",
            "secondary_message": null
          },
          {
            "id": 370144,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
            "secondary_message": null
          },
          {
            "id": 370145,
            "primary_message": "When the veggies have softened, add shredded chicken, broth, and pasta to the pot; cover and bring to a boil. Once the soup is boiling, reduce heat to medium and simmer, stirring occasionally, until veggies and pasta are cooked through, about 8 minutes.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n4 oz penne pasta"
          },
          {
            "id": 370146,
            "primary_message": "When the soup is done, add cilantro and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 370147,
            "primary_message": "Divide soup between bowls and serve with lime wedges on the side. Enjoy!",
            "secondary_message": null
          }
        ],
