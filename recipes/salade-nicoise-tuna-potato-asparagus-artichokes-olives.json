        "instructions": [
          {
            "id": 396214,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lb new potatoes\n2 small bunches asparagus\n1 bunch radish\n2 lemons"
          },
          {
            "id": 396215,
            "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
            "secondary_message": "6 eggs"
          },
          {
            "id": 396216,
            "primary_message": "While the eggs are cooking, halve potatoes. Place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to medium, and simmer until starting to soften, 8-10 minutes.",
            "secondary_message": "1 tsp salt"
          },
          {
            "id": 396217,
            "primary_message": "Meanwhile, snap (or cut) off the woody ends of asparagus; cut spears in half crosswise. Once the potatoes start to soften, add asparagus to the pot and continue to cook until veggies are tender, 2-3 minutes more. Drain and rinse under cold water to cool.",
            "secondary_message": null
          },
          {
            "id": 396218,
            "primary_message": "While the veggies are cooking, trim and halve radishes lengthwise. Transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 396219,
            "primary_message": "Drain artichokes. Add to the plate with the radish.",
            "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
          },
          {
            "id": 396220,
            "primary_message": "Halve olives lengthwise and add to the plate. Set aside.",
            "secondary_message": "1 cup Kalamata olives, pitted"
          },
          {
            "id": 396221,
            "primary_message": "Peel and mince shallot. Place in a small bowl.",
            "secondary_message": "1 shallot"
          },
          {
            "id": 396222,
            "primary_message": "Juice lemons into the bowl with the shallot. Add oil, Dijon, salt, and pepper, then whisk to combine the dressing.",
            "secondary_message": "⅓ cup extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 396223,
            "primary_message": "When potatoes and asparagus are cool, return to the pot and drizzle with half of the dressing. Gently toss to coat and set aside. (Reserve remaining dressing for serving.)",
            "secondary_message": null
          },
          {
            "id": 396224,
            "primary_message": "Drain tuna, place in another small bowl, and flake with a fork.",
            "secondary_message": "2 (6 oz) cans chunk light tuna in water"
          },
          {
            "id": 396225,
            "primary_message": "Peel and halve eggs. Season with salt and pepper.",
            "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 396226,
            "primary_message": "To serve, divide tuna, eggs, potatoes, asparagus, radishes, artichokes, and olives between plates or bowls. Top with capers, drizzle with remaining dressing, and enjoy!",
            "secondary_message": "2 tbsp capers"
          }
        ],
