        "instructions": [
          {
            "id": 253891,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 253892,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lb new potatoes\n1 lb cremini mushrooms\n2 crowns broccoli"
          },
          {
            "id": 253893,
            "primary_message": "Halve potatoes and place on a large baking sheet pan; drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
            "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp basil, dried\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 253894,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until the potatoes start to soften, about 15 minutes.",
            "secondary_message": null
          },
          {
            "id": 253895,
            "primary_message": "Meanwhile, peel and mince garlic; peel and thinly slice onion. Transfer both to a medium bowl.",
            "secondary_message": "2 cloves garlic\n1 medium yellow onion"
          },
          {
            "id": 253896,
            "primary_message": "Thinly slice mushrooms, add to the bowl with the garlic and onion, and set aside.",
            "secondary_message": null
          },
          {
            "id": 253897,
            "primary_message": "Place beef, eggs, bread crumbs, Dijon, Worcestershire, and spices in another medium bowl; mix with your hands until well combined. Form the beef mixture into 4 equal-sized patties and place on a plate.",
            "secondary_message": "1 ½ lb lean ground beef\n2 eggs\n½ cup panko bread crumbs\n2 tbsp Dijon mustard\n2 tsp Worcestershire sauce\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 253898,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 253899,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties and cook, undisturbed, for 5 minutes; flip and pan-fry until cooked through, 3-4 minutes more. Once done, transfer to a clean plate (leaving the cooking juices in the skillet) and loosely cover with aluminum foil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 253900,
            "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
            "secondary_message": null
          },
          {
            "id": 253901,
            "primary_message": "Remove baking sheet from the oven; add broccoli, drizzle with additional oil, and season with salt and pepper. Stir to combine with the potatoes and return to the oven. Roast until the veggies are fork-tender, 10 minutes more.",
            "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 253902,
            "primary_message": "Return the skillet (with cooking juices) to medium heat, add more oil, and swirl to coat the bottom. Add garlic, onion, and mushrooms; cook, stirring often, until softened, about 5 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 253903,
            "primary_message": "Sprinkle flour into the skillet and cook, stirring constantly, until fragrant, about 1 minute. Add broth and Worcestershire, stir to combine, and bring the gravy to a boil.",
            "secondary_message": "2 tbsp all-purpose flour\n16 fl oz (2 cups) chicken or vegetable broth\n2 tsp Worcestershire sauce"
          },
          {
            "id": 253904,
            "primary_message": "Return patties to the skillet and cook, stirring occasionally, until the gravy has thickened and patties are warmed through, about 3 minutes. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 253905,
            "primary_message": "To serve, divide potatoes, broccoli, and beef patties between plates. Top patties with mushroom gravy and enjoy!",
            "secondary_message": null
          }
        ],
