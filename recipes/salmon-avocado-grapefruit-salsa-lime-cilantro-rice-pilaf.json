        "instructions": [
          {
            "id": 20856,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": ""
          },
          {
            "id": 20860,
            "primary_message": "Heat small saucepan over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 20861,
            "primary_message": "Peel and small dice onion.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 20862,
            "primary_message": "Coat bottom of pan with oil. Add ½ of the onion (save the rest for the salsa) and cook until softened, 4-5 minutes. Transfer remaining onion to a medium bowl.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 20857,
            "primary_message": "In a small bowl, mix together olive oil, paprika, salt, and pepper.",
            "secondary_message": "2 tsp extra virgin olive oil\r\n½ tsp paprika\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 20858,
            "primary_message": "Place salmon in a baking dish and rub with spice mixture.",
            "secondary_message": "1 ½ lb salmon fillet"
          },
          {
            "id": 20859,
            "primary_message": "Place in the oven and roast until salmon is opaque in the centre, 15-20 minutes.",
            "secondary_message": ""
          },
          {
            "id": 20865,
            "primary_message": "Once onion has softened, add rice and water to saucepan; bring to a boil.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) water"
          },
          {
            "id": 40513,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 20863,
            "primary_message": "Halve and pit avocados; scoop out the flesh, small dice, and add to bowl with onion.",
            "secondary_message": "2 avocados\r\n"
          },
          {
            "id": 20864,
            "primary_message": "Slice off top and bottom from grapefruits, then cut off the skin and white pith from the sides so you can see the pink flesh. Cut in between the membranes to release the segments. Cut segments crosswise into medium pieces and transfer to bowl with onion.",
            "secondary_message": "2 grapefruits"
          },
          {
            "id": 20866,
            "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": "1 small bunch cilantro"
          },
          {
            "id": 20867,
            "primary_message": "Add ½ of the cilantro (save the rest for the rice pilaf), lime juice, crushed red pepper, salt, and pepper to salsa bowl; gently toss to combine. Set aside.",
            "secondary_message": "juice of 1 lime\r\n⅛ tsp crushed red pepper\r\n⅛ tsp salt\r\n⅛ tsp black pepper "
          },
          {
            "id": 20868,
            "primary_message": "Add remaining cilantro, lime juice, olive oil, salt, and pepper to rice; stir to mix.",
            "secondary_message": "juice of 1 lime\r\n1 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 20869,
            "primary_message": "Serve salmon with rice pilaf on the side and spoon salsa over top. Enjoy!",
            "secondary_message": ""
          }
        ],
