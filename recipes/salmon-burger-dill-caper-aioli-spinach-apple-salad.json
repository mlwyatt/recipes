  "instructions": [
    {
      "id": 301046,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 sticks celery\n2 Gala apples\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 301047,
      "primary_message": "Drain salmon, place in a medium bowl, and flake with a fork; add eggs, bread crumbs, mayo, and spices. Stir to combine the salmon mixture, form into 4 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "2 (7.5 oz) cans wild pink salmon, traditional style\n2 eggs\n⅔ cup panko bread crumbs\n2 tbsp mayonnaise\n1 tsp dill, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 301048,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl, add mayo, and stir to combine the aioli; set aside.",
      "secondary_message": "2 cloves garlic\n2 tbsp capers\n¼ cup mayonnaise"
    },
    {
      "id": 301049,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 301050,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add salmon patties and cook until browned and warmed through, about 5 minutes per side. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 301051,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a clean medium bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 301052,
      "primary_message": "Trim and thinly slice celery crosswise; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 301053,
      "primary_message": "Quarter, core, and thinly slice apples; add to the bowl along with spinach and cranberries. Toss to combine the salad and set aside.",
      "secondary_message": "¼ cup dried cranberries"
    },
    {
      "id": 301054,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 301055,
      "primary_message": "To assemble the burgers, spread the bottom half of each bun with aioli; layer with a salmon patty and the top half of each bun.",
      "secondary_message": null
    },
    {
      "id": 301056,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
