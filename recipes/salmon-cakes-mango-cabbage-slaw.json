        "instructions": [
          {
            "id": 35295,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head napa cabbage\n2 mangoes\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 35296,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Transfer ½ of the cilantro to a medium bowl (that will be used to mix the salmon mixture) and the other ½ to a large salad bowl.",
            "secondary_message": ""
          },
          {
            "id": 35297,
            "primary_message": "Drain and add the salmon to the medium bowl with the cilantro.",
            "secondary_message": "4 (7.5 oz) cans wild pink salmon, traditional style"
          },
          {
            "id": 35298,
            "primary_message": "Add the eggs, mayonnaise, Dijon, bread crumbs, salt, and pepper to the salmon and cilantro; mix together until well combined. Form the mixture into 8 patties and place on a plate.",
            "secondary_message": "2 eggs\n4 tbsp mayonnaise\n2 tsp Dijon mustard\n1 cup panko bread crumbs\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 35299,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 35300,
            "primary_message": "While the skillet heats up, trim off and discard the root end of the cabbage; quarter the cabbage lengthwise, then thinly slice crosswise into shreds and add to the salad bowl.",
            "secondary_message": ""
          },
          {
            "id": 35301,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 35302,
            "primary_message": "Carefully place the salmon patties in the skillet; cook until golden brown, 3 to 5 minutes per side. Once done, transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 35303,
            "primary_message": "Peel the mangoes, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and small dice the flesh (cut into ¼-inch cubes). Add the mangoes to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 35304,
            "primary_message": "Juice the limes and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 35305,
            "primary_message": "Season the salad with salt and pepper; toss to coat.",
            "secondary_message": "1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 35306,
            "primary_message": "To serve, place 2 salmon patties on a plate and add the mange cabbage slaw on the side. Enjoy!",
            "secondary_message": null
          }
        ],
