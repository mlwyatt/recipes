  "instructions": [
    {
      "id": 238704,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "½ cup rice vinegar\n2 tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 238705,
      "primary_message": "Wash, dry, peel, trim, and thinly slice carrots. Peel and thinly slice shallots; add both to the bowl with the marinade.",
      "secondary_message": "2 medium carrots\n2 shallots"
    },
    {
      "id": 238706,
      "primary_message": "Wash, dry, trim, and thinly slice cucumber; add to the bowl, toss to combine, and set the veggies aside to marinate.",
      "secondary_message": "1 English cucumber"
    },
    {
      "id": 238707,
      "primary_message": "Thinly slice mozzarella.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 238708,
      "primary_message": "Place the bread slices on a flat surface and spread with Dijon. Evenly top half the slices with the mozzarella and prosciutto. Cover the sandwiches with remaining bread slices.",
      "secondary_message": "8 slices whole grain bread\n4 tsp Dijon mustard\n12 slices prosciutto"
    },
    {
      "id": 238709,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 238710,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 238711,
      "primary_message": "Remove sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up; cook until golden brown on the other side and the cheese is melted, 2-4 minutes. Once done, transfer to a cutting board.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 238712,
      "primary_message": "Wipe the skillet clean with a paper towel; return to medium heat, and add more butter. Gently crack eggs into the skillet and cook until whites are set but yolks are still runny, about 3 minutes. Remove from heat and season with salt and pepper. ",
      "secondary_message": "2 tsp butter, unsalted\n4 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 238713,
      "primary_message": "Meanwhile, preheat a small saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 238714,
      "primary_message": "Once the saucepan is hot, add butter and swirl to coat the bottom. Add flour, salt, and pepper; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "2 tbsp butter, unsalted\n2 tbsp all-purpose flour\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 238715,
      "primary_message": "Slowly whisk milk into the saucepan; bring to a boil and cook until sauce is thickened, 2-3 minutes.",
      "secondary_message": "8 fl oz (1 cup) whole milk"
    },
    {
      "id": 238716,
      "primary_message": "Divide sandwiches between plates; drizzle with sauce and top with a fried egg. Serve with pickled veggies on the side and enjoy!",
      "secondary_message": null
    }
  ],
