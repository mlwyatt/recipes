  "instructions": [
    {
      "id": 235857,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 lb white mushrooms\n2 medium zucchini squash\n1 small pkg fresh basil"
    },
    {
      "id": 235858,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 235859,
      "primary_message": "Trim, seed, and medium dice bell peppers. Peel and medium dice onion; transfer both to a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 235860,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 235861,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 235862,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices to the skillet; cook, stirring occasionally, until starting to soften, about 5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 235863,
      "primary_message": "Meanwhile, thinly slice mushrooms and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 235864,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons; add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 235865,
      "primary_message": "Add mushrooms, zucchini, and chickpeas to the skillet with the other veggies and continue to cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 235866,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 235867,
      "primary_message": "Peel and mince additional garlic and place in a small bowl. Add oil and spices; stir to combine and set aside.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 235868,
      "primary_message": "Add tomato sauce and vinegar to the skillet. Stir to combine and cook until heated through, 3 minutes more.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n2 tbsp white wine vinegar"
    },
    {
      "id": 235869,
      "primary_message": "Meanwhile, spread garlic oil on the bread and transfer to a large baking sheet pan. Place in the oven and broil until toasted, 1-2 minutes. Remove from the oven and cut toasts in half.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 235870,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. ",
      "secondary_message": null
    },
    {
      "id": 235871,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 235872,
      "primary_message": "Divide veggie-chickpea skillet between plates or bowls; sprinkle with basil and Parmesan. Serve with garlic toast on the side and enjoy!",
      "secondary_message": null
    }
  ],
