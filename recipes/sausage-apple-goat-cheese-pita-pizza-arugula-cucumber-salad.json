        "instructions": [
          {
            "id": 316141,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 316142,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 316143,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add sausages and cook, turning occasionally, until browned and cooked through, 10-15 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil\n4 pork sausages"
          },
          {
            "id": 316144,
            "primary_message": "Meanwhile, arrange pitas on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven and set aside.",
            "secondary_message": "4 whole grain pitas"
          },
          {
            "id": 316145,
            "primary_message": "While the pitas bake, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "2 Gala apples\n1 lemon\n1 English cucumber\n1 (5 oz) pkg baby arugula\n1 small pkg fresh basil"
          },
          {
            "id": 316146,
            "primary_message": "Quarter, core, and thinly slice apples.",
            "secondary_message": null
          },
          {
            "id": 316147,
            "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into thin rounds.",
            "secondary_message": null
          },
          {
            "id": 316148,
            "primary_message": "Layer baked pitas with apple and sausage slices, then crumble goat cheese over top. Return baking sheet to the oven and bake until warmed through and cheese is melted, about 5 minutes. Remove from oven.",
            "secondary_message": "1 (4 oz) log goat cheese"
          },
          {
            "id": 316149,
            "primary_message": "Meanwhile, juice lemon into a medium bowl; add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 316150,
            "primary_message": "Trim, halve, and slice cucumber into thin half-moons. Add to the bowl with the dressing, along with the arugula, and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 316151,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 316152,
            "primary_message": "Divide pita pizzas between plates and sprinkle with basil. Serve with salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
