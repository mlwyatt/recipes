  "instructions": [
    {
      "id": 315807,
      "primary_message": "Preheat oven to 450°F and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 315808,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 lb sweet potato\n2 sticks celery\n2 Gala apples"
    },
    {
      "id": 315809,
      "primary_message": "Peel, trim, and medium dice carrots and sweet potatoes. Transfer both to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 315810,
      "primary_message": "Trim and medium dice celery; peel, halve, and medium dice onion. Add both to the baking sheet with the other veggies, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n4 tsp extra virgin olive oil\n1 tsp sage, dried\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper\n½ tsp cinnamon, ground"
    },
    {
      "id": 315811,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 315812,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 315813,
      "primary_message": "While the skillet heats up, quarter, core, and medium dice apples.",
      "secondary_message": null
    },
    {
      "id": 315814,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add apple, sausage, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes; remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 lb ground pork sausage\n½ tsp sage, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 315815,
      "primary_message": "While the sausage and apple are cooking, place yogurt, water, honey, Dijon, and spices in a small bowl; whisk to combine the sauce. Add additional water, 1 tablespoon at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp water\n2 tsp honey\n2 tsp Dijon mustard\n2 tsp curry powder\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 315816,
      "primary_message": "Cut bread into 1-inch cubes.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 315817,
      "primary_message": "When the veggies are done, remove from oven and set oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 315818,
      "primary_message": "Sprinkle bread cubes over the veggies, return baking sheet to the oven, and broil until golden and toasted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 315819,
      "primary_message": "When the bread cubes are done, remove from the oven; add sausage mixture to the baking sheet and toss to combine the \"stuffing.\"",
      "secondary_message": null
    },
    {
      "id": 315820,
      "primary_message": "To serve, divide stuffing between bowls, drizzle with sauce, and enjoy!",
      "secondary_message": null
    }
  ],
