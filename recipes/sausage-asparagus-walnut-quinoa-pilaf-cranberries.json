  "instructions": [
    {
      "id": 187474,
      "primary_message": "In a small saucepan, combine quinoa and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "⅔ cup quinoa\n1 ⅓ cup water"
    },
    {
      "id": 187475,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 187476,
      "primary_message": "Cut the sausages at an angle into 1-inch pieces.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 187477,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 187478,
      "primary_message": "Add the sausage to the skillet and cook, stirring occasionally, until browned on all sides and almost cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 187479,
      "primary_message": "Meanwhile, wash and snap or cut off the woody ends of the asparagus; then cut into 2-inch pieces.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 187480,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 187481,
      "primary_message": "In a large bowl, prepare dressing by whisking together vinegar, oil, Dijon, salt, and pepper.",
      "secondary_message": "2 tbsp white wine vinegar\n4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 187482,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 187483,
      "primary_message": "When the sausage is almost cooked through, add asparagus, garlic, and walnuts; continue to cook, stirring occasionally, until asparagus is crisp-tender, about 4 minutes. When done, remove from the heat, cover, and set aside.",
      "secondary_message": null
    },
    {
      "id": 187484,
      "primary_message": "Uncover the quinoa and fluff with a fork. Add quinoa and asparagus-sausage mixture to the bowl with the sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 187485,
      "primary_message": "To serve, divide the pilaf between plates and garnish with cranberries. Enjoy!",
      "secondary_message": "¼ cup dried cranberries"
    }
  ],
