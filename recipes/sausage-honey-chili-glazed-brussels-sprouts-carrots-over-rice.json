        "instructions": [
          {
            "id": 297919,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 297920,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water\n½ tsp salt"
          },
          {
            "id": 297921,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove from the heat and let stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 297922,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "4 medium carrots\n1 ½ lb Brussels sprouts\n1 lime"
          },
          {
            "id": 297923,
            "primary_message": "Peel, trim, and cut carrots lengthwise into quarters, then crosswise into 2-inch long pieces; transfer to a large baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 297924,
            "primary_message": "Trim and halve Brussels sprouts; add to the baking sheet with the carrots. Drizzle with oil, season with spices, and toss to combine; spread out in an even layer.",
            "secondary_message": "4 tsp toasted sesame oil\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 297925,
            "primary_message": "Add sausages to the baking sheet, nestling them into the veggies.",
            "secondary_message": "4 pork sausages"
          },
          {
            "id": 297926,
            "primary_message": "Place baking sheet in the oven and roast, tossing once, until veggies are fork-tender and sausages are cooked through, about 15 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 297927,
            "primary_message": "Meanwhile, juice lime into a small bowl; add honey and chili-garlic sauce. Whisk to combine the honey-chili glaze.",
            "secondary_message": "2 tbsp honey\n4 tsp chili-garlic sauce"
          },
          {
            "id": 297928,
            "primary_message": "When the sausages and veggies are done, transfer sausages to a cutting board; drizzle veggies with the glaze and toss to combine. Return to the oven and continue to roast until caramelized, 4-5 minutes more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 297929,
            "primary_message": "Cut sausages in half lengthwise, then slice crosswise into ½-inch thick half-moons.",
            "secondary_message": null
          },
          {
            "id": 297930,
            "primary_message": "To serve, divide rice, veggies, and sausage between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
