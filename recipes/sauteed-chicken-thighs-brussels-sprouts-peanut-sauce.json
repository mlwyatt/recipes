        "instructions": [
          {
            "id": 46005,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 lb brussels sprouts\n1 lime"
          },
          {
            "id": 46006,
            "primary_message": "Remove the outer layer of leaves from the Brussels sprouts, then trim off and discard the stem ends; quarter the sprouts lengthwise and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 46007,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 46008,
            "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "2 lb chicken thighs, boneless skinless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 46009,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 46010,
            "primary_message": "Carefully place the chicken thighs in the skillet; sear on both sides until golden brown, 2 to 3 minutes per side. Then, reduce the heat to medium and continue to cook until they are cooked through, 3 to 5 minutes total. Once done, transfer to a plate and cover with foil to keep warm. Cook in batches if necessary.",
            "secondary_message": null
          },
          {
            "id": 46011,
            "primary_message": "While the chicken cooks, trim off and discard the ends of the shallots; peel and mince the shallots.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 46012,
            "primary_message": "Once the chicken has been transferred, add the shallots to the skillet and cook, stirring frequently, until softened, 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 46013,
            "primary_message": "Add the Brussels sprouts to the skillet; cook, stirring frequently, until lightly browned and tender, 4 to 6 minutes. Once done, remove from the heat.",
            "secondary_message": null
          },
          {
            "id": 46014,
            "primary_message": "While the sprouts cook, juice the lime and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 46015,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the lime juice.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 46016,
            "primary_message": "To the lime juice and garlic, add peanut butter, water, soy sauce, honey, and crushed red pepper; whisk together.",
            "secondary_message": "4 tbsp natural peanut butter\n3 tbsp water\n2 tbsp soy sauce\n2 tsp honey\n¼ tsp crushed red pepper"
          },
          {
            "id": 46017,
            "primary_message": "To serve, divide the chicken thighs and Brussels sprouts between dishes; drizzle with the peanut sauce or serve the sauce on the side for dipping. Enjoy!",
            "secondary_message": null
          }
        ],
