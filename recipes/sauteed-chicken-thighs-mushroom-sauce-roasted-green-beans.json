        "instructions": [
          {
            "id": 13503,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": ""
          },
          {
            "id": 13504,
            "primary_message": "Wash green beans and trim ends. Transfer to a sheet pan.",
            "secondary_message": "2 lb green beans"
          },
          {
            "id": 13505,
            "primary_message": "Drizzle green beans with oil and season with salt and pepper; toss to coat.",
            "secondary_message": "2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 13506,
            "primary_message": "Spread out evenly and place in the oven. Tossing once halfway through, roast until tender-crisp, 10-15 minutes.",
            "secondary_message": ""
          },
          {
            "id": 13507,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 13508,
            "primary_message": "In a medium bowl, mix together flour, salt, and pepper.",
            "secondary_message": "4 tbsp all-purpose flour\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 13509,
            "primary_message": "Add chicken to bowl and toss to coat.",
            "secondary_message": "2 lb chicken thighs, boneless skinless"
          },
          {
            "id": 13510,
            "primary_message": "Coat bottom of skillet with oil. Shake off excess flour from chicken and add to skillet. Cook until browned, 2-3 minutes per side.",
            "secondary_message": "about 2 tbsp virgin coconut oil"
          },
          {
            "id": 13511,
            "primary_message": "Wash, dry, and halve mushrooms.",
            "secondary_message": "½ lb white mushrooms"
          },
          {
            "id": 13512,
            "primary_message": "Transfer chicken to a plate and return skillet to stove. Add more oil and mushrooms. Stirring occasionally, cook until tender, 4-5 minutes.",
            "secondary_message": "about 2 tbsp virgin coconut oil"
          },
          {
            "id": 13513,
            "primary_message": "Return chicken to pan and add broth. Reduce heat to medium and cook until chicken is cooked through and liquid is reduced, 5-6 minutes.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
          },
          {
            "id": 13514,
            "primary_message": "To serve, arrange chicken with mushroom sauce and green beans on a plate. Enjoy!",
            "secondary_message": ""
          }
        ],
