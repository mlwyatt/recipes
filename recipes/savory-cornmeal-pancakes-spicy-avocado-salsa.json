  "instructions": [
    {
      "id": 228591,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 tomatoes\n1 small bunch cilantro\n2 jalapeño peppers\n1 lime\n2 avocados"
    },
    {
      "id": 228592,
      "primary_message": "Small dice tomatoes and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 228593,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 228594,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 228595,
      "primary_message": "Juice lime into the bowl.",
      "secondary_message": null
    },
    {
      "id": 228596,
      "primary_message": "Halve and pit the avocados; scoop out with a spoon and small dice. Add to the bowl along with spices and gently stir to combine the salsa. Set aside.",
      "secondary_message": "½ tsp chili powder\n½ tsp salt\n¼ tsp cumin, ground"
    },
    {
      "id": 228597,
      "primary_message": "Place corn in a colander and rinse under hot water (from the tap) to thaw. Set aside to drain.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 228598,
      "primary_message": "Place corn meal, flour, nutritional yeast, almond meal, baking powder, and salt in another medium bowl; whisk to combine.",
      "secondary_message": "1 ½ cups polenta (cornmeal)\n1 cup all-purpose flour\n¼ cup nutritional yeast flakes\n¼ cup almond meal/flour\n1 tbsp baking powder\n⅛ tsp salt"
    },
    {
      "id": 228599,
      "primary_message": "Whisk milk and maple syrup in a small bowl.",
      "secondary_message": "16 fl oz (2 cups) whole milk\n4 tsp pure maple syrup"
    },
    {
      "id": 228600,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 228601,
      "primary_message": "While the skillet heats up, create a well in the center of the flour mixture. Add the milk mixture and corn; whisk until just combined.",
      "secondary_message": null
    },
    {
      "id": 228602,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, use a ⅓-cup measure to pour the batter into the skillet. Cook for 1-2 minutes on each side, until golden and cooked through.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 228603,
      "primary_message": "To serve, divide pancakes and salsa between plates. Enjoy!",
      "secondary_message": null
    }
  ],
