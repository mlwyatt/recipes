        "instructions": [
          {
            "id": 285145,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium carrots\n4 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 285146,
            "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 285147,
            "primary_message": "Peel, halve, and small dice onion; add to the bowl with the carrot and celery.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 285148,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the veggies (reserve remaining parsley for serving).",
            "secondary_message": null
          },
          {
            "id": 285149,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 285150,
            "primary_message": "While the pot heats up, small dice bacon.",
            "secondary_message": "8 slices bacon"
          },
          {
            "id": 285151,
            "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes.",
            "secondary_message": null
          },
          {
            "id": 285152,
            "primary_message": "Meanwhile, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb sea scallops\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 285153,
            "primary_message": "Using a slotted spoon, remove the bacon to a clean, paper towel-lined plate. (Reserve pot with drippings for the next step.)",
            "secondary_message": null
          },
          {
            "id": 285154,
            "primary_message": "Return pot with drippings to medium-high heat. Add scallops in a single layer; cook until golden brown and opaque throughout, 1½-2 minutes per side. Once done, add to the plate with the bacon. (Reserve pot with drippings for the next step.)",
            "secondary_message": null
          },
          {
            "id": 285155,
            "primary_message": "Return pot with drippings to medium heat. Add the veggies and cook, stirring occasionally, until softened, 6-7 minutes.",
            "secondary_message": null
          },
          {
            "id": 285156,
            "primary_message": "Add flour to the pot with the veggies and cook, stirring frequently, for 1-2 minutes. ",
            "secondary_message": "2 tbsp all-purpose flour"
          },
          {
            "id": 285157,
            "primary_message": "Slowly add broth to the pot, while stirring constantly, and bring to a simmer. Once simmering, cook, stirring occasionally, until thickened, 4-5 minutes.",
            "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth"
          },
          {
            "id": 285158,
            "primary_message": "Meanwhile, chop scallops into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 285159,
            "primary_message": "Add tomatoes, cream, and spices to the pot; stir to combine the soup and remove from heat. Purée with an immersion or regular blender (return soup to the pot).",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n8 fl oz (1 cup) heavy whipping cream\n1 tsp salt\n½ tsp black pepper\n½ tsp cayenne pepper\n¼ tsp paprika"
          },
          {
            "id": 285160,
            "primary_message": "To serve, divide soup between bowls; top with scallops, bacon, and reserved parsley. Enjoy!",
            "secondary_message": null
          }
        ],
