        "instructions": [
          {
            "id": 211379,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 orange\n2 (1 inch) pieces ginger root\n4 medium zucchini squash\n1 bunch radish\n1 English cucumber\n1 (5 oz) pkg baby spinach\n2 avocados"
          },
          {
            "id": 211380,
            "primary_message": "Zest orange into a small bowl and set aside. Juice orange into a large bowl.",
            "secondary_message": null
          },
          {
            "id": 211381,
            "primary_message": "Peel and mince or grate ginger; add to the bowl with the orange juice along with oil, vinegar, and salt. Whisk to combine the dressing and set aside.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n½ tsp salt"
          },
          {
            "id": 211382,
            "primary_message": "Trim zucchini and, using a julienne (or regular) peeler, peel into thin noodles.",
            "secondary_message": null
          },
          {
            "id": 211383,
            "primary_message": "Preheat a large skillet over medium-high heat. Once it is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 211384,
            "primary_message": "Add zucchini noodles and salt to the skillet; cook, stirring occasionally, until just tender, 2-3 minutes. Transfer noodles to the bowl with the dressing and toss to coat. (Reserve skillet for later use.)",
            "secondary_message": "½ tsp salt"
          },
          {
            "id": 211385,
            "primary_message": "Trim and thinly slice radishes. Trim and medium dice cucumber. Add both to the bowl with the zucchini noodles and set aside.",
            "secondary_message": null
          },
          {
            "id": 211386,
            "primary_message": "Return the skillet to medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 211387,
            "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; rub with oil and season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb sea scallops\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 211388,
            "primary_message": "Once the skillet is hot, add scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Work in batches if necessary. Once done, transfer to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 211389,
            "primary_message": "Meanwhile, add spinach to the bowl with the zucchini and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 211390,
            "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out.",
            "secondary_message": null
          },
          {
            "id": 211391,
            "primary_message": "To serve, divide salad between plates or bowls and top with avocado, scallops, orange zest, and sesame seeds. Enjoy!",
            "secondary_message": "4 tsp sesame seeds"
          }
        ],
