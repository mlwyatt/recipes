        "instructions": [
          {
            "id": 192141,
            "primary_message": "Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 192142,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 medium carrots\n2 sticks celery\n1 small bunch cilantro\n1 lime"
          },
          {
            "id": 192143,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 192144,
            "primary_message": "While the skillet heats up, peel and small dice onion.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 192145,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until slightly softened, about 5 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 192146,
            "primary_message": "Meanwhile, peel and coarsely grate carrots. Trim and mince celery. Add both to the skillet and stir to combine. ",
            "secondary_message": null
          },
          {
            "id": 192147,
            "primary_message": "Peel and mince garlic; add to the skillet.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 192148,
            "primary_message": "Crumble the tofu with your fingers into the skillet. Add soy sauce and spices; increase heat to medium-high and continue to cook, stirring often, until veggies are soft and tofu begins to brown, about 6 minutes. Remove from heat.",
            "secondary_message": "¼ cup soy sauce\n1 ½ tsp turmeric\n1 ½ tsp curry powder\n1 ½ tsp cumin\n1 ½ tsp paprika"
          },
          {
            "id": 192149,
            "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 192150,
            "primary_message": "Juice lime into the skillet; add cilantro and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 192151,
            "primary_message": "Place tortillas on a flat surface, spread with mayo and top with tofu scramble. Tightly roll to close and cut in half. Enjoy! ",
            "secondary_message": "4 large flour tortillas\n4 tsp mayonnaise"
          }
        ],
