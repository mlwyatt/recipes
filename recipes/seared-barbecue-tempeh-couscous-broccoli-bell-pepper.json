        "instructions": [
          {
            "id": 474522,
            "primary_message": "Slice tempeh crosswise into thin strips and place in a medium bowl.",
            "secondary_message": "2 (8 oz) packages tempeh"
          },
          {
            "id": 474523,
            "primary_message": "Add barbecue sauce to the bowl with the tempeh and gently stir to coat; set aside.",
            "secondary_message": "⅔ cup barbecue sauce"
          },
          {
            "id": 474524,
            "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous and salt, then stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous\n½ tsp salt"
          },
          {
            "id": 474525,
            "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; medium dice.",
            "secondary_message": "2 red bell peppers"
          },
          {
            "id": 474526,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 474527,
            "primary_message": "While the skillet heats up, peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 474528,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, garlic, broccoli, salt, and pepper; cook, stirring occasionally, until veggies are tender-crisp, 5-6 minutes. Transfer to a plate and cover with foil. (Reserve skillet for the next step.)",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 (18 oz) bag broccoli florets\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 474529,
            "primary_message": "Return the skillet to medium heat, add more oil, and swirl to coat the bottom. Add tempeh in a single layer and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 474530,
            "primary_message": "To serve, divide couscous, tempeh, and veggies between plates. Enjoy!",
            "secondary_message": null
          }
        ],
