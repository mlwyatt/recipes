        "instructions": [
          {
            "id": 400520,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 400521,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n1 tsp black pepper"
          },
          {
            "id": 400522,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
            "secondary_message": "4 tsp butter, unsalted"
          },
          {
            "id": 400523,
            "primary_message": "Meanwhile, place spinach in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
            "secondary_message": "1 (16oz) bag frozen chopped spinach"
          },
          {
            "id": 400524,
            "primary_message": "Peel and mince shallots.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 400525,
            "primary_message": "When the steak is done, wipe the skillet clean with paper towels. Return to medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 400526,
            "primary_message": "Once the skillet is hot, add more butter and swirl to coat the bottom. Add shallot and mushrooms; cook, stirring occasionally, until mushrooms soften, 2-3 minutes. ",
            "secondary_message": "2 tsp butter, unsalted\n2 (8 oz) pkg sliced white mushrooms"
          },
          {
            "id": 400527,
            "primary_message": "Add spinach, cream, and spices to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook until spinach is warmed through and sauce thickens slightly, 1-2 minutes. Remove from heat. ",
            "secondary_message": "8 fl oz (1 cup) heavy whipping cream\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 400528,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 400529,
            "primary_message": "To serve, divide steak and creamy veggie sauté between plates. Enjoy!",
            "secondary_message": null
          }
        ],
