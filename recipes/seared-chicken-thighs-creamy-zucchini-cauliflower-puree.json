        "instructions": [
          {
            "id": 249856,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 249857,
            "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels. Season with salt and pepper on both sides.",
            "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 249858,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet and pan-fry until cooked through and golden brown, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet with drippings.)",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 249859,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n2 medium zucchini squash\n2 tomatoes"
          },
          {
            "id": 249860,
            "primary_message": "Fill a large pot with about 1-inch of hot water from the tap; cover and place over high heat.",
            "secondary_message": null
          },
          {
            "id": 249861,
            "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Roughly chop into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 249862,
            "primary_message": "Once the water in the pot is boiling, add cauliflower, reduce heat to medium, and cook until tender, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 249863,
            "primary_message": "Meanwhile, halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons.",
            "secondary_message": null
          },
          {
            "id": 249864,
            "primary_message": "Small dice tomatoes.",
            "secondary_message": null
          },
          {
            "id": 249865,
            "primary_message": "Return skillet (with drippings) to medium heat.",
            "secondary_message": null
          },
          {
            "id": 249866,
            "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add the zucchini, tomato, and spices; cook, stirring occasionally, until veggies start to soften, 3-4 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 249867,
            "primary_message": "While the veggies are cooking, cut cream cheese into small pieces. Finely grate Parmesan.",
            "secondary_message": "½ (8 oz) block cream cheese\n2 oz Parmesan cheese"
          },
          {
            "id": 249868,
            "primary_message": "Add cream cheese, Parmesan, and water to the skillet. Cook, stirring occasionally, until the cheeses melt and combine, 2-3 minutes. ",
            "secondary_message": "½ cup water"
          },
          {
            "id": 249869,
            "primary_message": "Return chicken to the skillet with the creamy zucchini and cook, turning to coat, until warmed through, about 2 minutes. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 249870,
            "primary_message": "When the cauliflower is done, drain in a colander, and transfer to a blender. Add oil, salt, and pepper; purée until smooth.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 249871,
            "primary_message": "To serve, divide cauliflower purée, chicken, veggies, and sauce between plates. Enjoy!",
            "secondary_message": null
          }
        ],
