  "instructions": [
    {
      "id": 267275,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 267276,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n1 lb sweet potato\n1 lemon\n2 pints grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 267277,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267278,
      "primary_message": "While the skillet heats up, medium dice bacon. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 267279,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate, leaving the drippings in the skillet. (Set skillet aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 267280,
      "primary_message": "Meanwhile, using a clean cutting board, snap or cut off woody ends of the asparagus; peel and small dice sweet potato. Transfer both to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 267281,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies. Squeeze lemon over top, drizzle with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 267282,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until crisp-tender, about 15 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 267283,
      "primary_message": "Meanwhile, return skillet (with bacon drippings) to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267284,
      "primary_message": "While the skillet heats up, pat fish dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb cod fillet\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 267285,
      "primary_message": "Once the skillet is hot, add fish and pan-fry until golden brown and cooked through, about 5 minutes per side. Remove to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 267286,
      "primary_message": "When the fish is done, remove all but 2 tablespoons of drippings from the skillet. Return to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 267287,
      "primary_message": "Once the skillet is hot, add tomatoes and cook, stirring occasionally, until they start to burst, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 267288,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 267289,
      "primary_message": "Add vinegar and half of the parsley (reserving the rest for garnish) to the skillet; continue to cook, crushing tomatoes with the back of a spoon to release their juices, until sauce is thickened, 1-2 minutes. Remove from heat.",
      "secondary_message": "¼ cup balsamic vinegar"
    },
    {
      "id": 267290,
      "primary_message": "To serve, divide fish, sauce, and roasted veggies between plates. Top fish with bacon and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
