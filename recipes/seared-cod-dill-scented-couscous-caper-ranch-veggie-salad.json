  "instructions": [
    {
      "id": 431702,
      "primary_message": "In a medium saucepan, bring broth to a boil over medium-high heat. Once boiling, remove from heat, add couscous, dill, and salt, then stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous\n1 tsp dill, dried\n½ tsp salt"
    },
    {
      "id": 431703,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431704,
      "primary_message": "While the skillet heats up, pat cod dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb cod fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 431705,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cod and pan-fry until golden and cooked through, 3-4 minutes per side. Transfer to a clean plate. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 431706,
      "primary_message": "Meanwhile, wash, dry, and quarter tomatoes. Place in a medium bowl.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 431707,
      "primary_message": "Drain and roughly chop capers. Add to the bowl with the tomatoes along with the carrots and dressing. Stir to combine the salad.",
      "secondary_message": "4 tbsp capers\n1 (10 oz) bag shredded carrots\n⅔ cup ranch dressing"
    },
    {
      "id": 431708,
      "primary_message": "To serve, divide cod, salad, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
