  "instructions": [
    {
      "id": 372694,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 372695,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Divide between two baking sheet pans.",
      "secondary_message": "4 green bell peppers"
    },
    {
      "id": 372696,
      "primary_message": "Wash and dry tomatoes. Add to the baking sheets with the peppers.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 372697,
      "primary_message": "Peel, halve, and thinly slice onions lengthwise. Add to the baking sheets, drizzle with vinaigrette, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 medium red onions\n3 tbsp balsamic vinaigrette\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 372698,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are tender and tomatoes start to burst, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 372699,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 372700,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, bone-in\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 372701,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 372702,
      "primary_message": "When the veggies are done, remove from oven. Sprinkle with feta and toss to combine.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 372703,
      "primary_message": "To serve, divide chops and veggies between plates. Spoon tzatziki over the chops and enjoy!",
      "secondary_message": "1 cup tzatziki sauce"
    }
  ],
