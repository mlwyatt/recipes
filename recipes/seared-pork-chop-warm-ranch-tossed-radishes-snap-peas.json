  "instructions": [
    {
      "id": 397030,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 397031,
      "primary_message": "Wash, dry, trim, and halve radishes. Transfer to a large baking sheet pan. ",
      "secondary_message": "2 bunches radish"
    },
    {
      "id": 397032,
      "primary_message": "Wash and dry snap peas. Add to the baking sheet with the radishes. ",
      "secondary_message": "2 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 397033,
      "primary_message": "Drizzle veggies with oil and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 397034,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are charred and fork-tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 397035,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 397036,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides. ",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 397037,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 397038,
      "primary_message": "When the veggies are done, remove from the oven and let cool slightly, about 5 minutes. Drizzle with dressing and toss to coat.",
      "secondary_message": "⅓ cup ranch dressing"
    },
    {
      "id": 397039,
      "primary_message": "To serve, divide chops and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
