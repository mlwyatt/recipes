        "instructions": [
          {
            "id": 429501,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 429502,
            "primary_message": "Place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
            "secondary_message": "⅓ cup rice vinegar\n2 tsp honey\n1 tsp salt"
          },
          {
            "id": 429503,
            "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 429504,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 yellow bell peppers\n2 pints grape tomatoes\n1 small pkg fresh basil"
          },
          {
            "id": 429505,
            "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a large baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 429506,
            "primary_message": "Peel garlic. Add to the baking sheet with the peppers along with the tomatoes. Drizzle veggies with oil, then season with salt and crushed red pepper; stir to coat and spread out in an even layer.",
            "secondary_message": "12 cloves garlic\n2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp crushed red pepper"
          },
          {
            "id": 429507,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are browned and fork-tender, 20-25 minutes. ",
            "secondary_message": null
          },
          {
            "id": 429508,
            "primary_message": "About 15 minutes before the veggies are done, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 429509,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb ribeye steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 429510,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, about 5 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 429511,
            "primary_message": "Meanwhile, pick basil leaves off the stems; discard stems and roughly chop the leaves.",
            "secondary_message": null
          },
          {
            "id": 429512,
            "primary_message": "When the veggies are done, remove from the oven. Add basil and pickled onion to the baking sheet, then stir to combine.",
            "secondary_message": null
          },
          {
            "id": 429513,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 429514,
            "primary_message": "To serve, divide steak and veggies between plates. Enjoy!",
            "secondary_message": null
          }
        ],
