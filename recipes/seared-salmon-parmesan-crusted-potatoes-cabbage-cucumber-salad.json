        "instructions": [
          {
            "id": 431938,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 431939,
            "primary_message": "Coat a baking dish with a thin layer of oil, then sprinkle Parmesan and Italian seasoning over the bottom of the dish.",
            "secondary_message": "4 tsp extra virgin olive oil\n⅔ cup Parmesan cheese, shredded\n2 tsp Italian seasoning"
          },
          {
            "id": 431940,
            "primary_message": "Wash, dry, and halve potatoes. Arrange in the baking dish, cut-side down, and press down firmly into the cheese. Drizzle with additional oil and season with salt.",
            "secondary_message": "1 ½ lb new potatoes\n4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 431941,
            "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, undisturbed, until potatoes are tender and Parmesan is browned and crispy, about 30 minutes. Remove from oven. ",
            "secondary_message": null
          },
          {
            "id": 431942,
            "primary_message": "When the potatoes have about 10 minutes left, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 431943,
            "primary_message": "While the skillet heats up, pat salmon dry with paper towels and place, skin-side down, on a plate. Season the top side of the salmon with salt and pepper.",
            "secondary_message": "1 ½ lb salmon fillet\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 431944,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Remove from heat.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 431945,
            "primary_message": "Meanwhile, wash, dry, and medium dice cucumber. Place in a medium bowl along with shredded cabbage and dressing, then stir to combine the salad.",
            "secondary_message": "1 English cucumber\n1 (14 oz) bag shredded cabbage (coleslaw mix)\n⅓ cup Italian salad dressing"
          },
          {
            "id": 431946,
            "primary_message": "To serve, divide salmon, potatoes, and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
