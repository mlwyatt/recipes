  "instructions": [
    {
      "id": 430163,
      "primary_message": "Wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. Place in a large bowl and set aside.",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 430164,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 430165,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 430166,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 430167,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Peel and mince garlic. Place both in a small bowl along with oil, crushed red pepper, and salt. Stir to combine the chili oil.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 cloves garlic\n⅓ cup toasted sesame oil\n2 tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 430168,
      "primary_message": "Return skillet to medium heat. Once hot, add chili oil and cook until sizzling and fragrant, about 30 seconds. Remove from heat and immediately drizzle over the zucchini noodles. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 430169,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 430170,
      "primary_message": "To serve, divide steak and zucchini noodles between plates. Enjoy!",
      "secondary_message": null
    }
  ],
