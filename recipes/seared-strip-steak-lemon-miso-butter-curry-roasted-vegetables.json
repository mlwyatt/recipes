        "instructions": [
          {
            "id": 402971,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 402972,
            "primary_message": "Wash, dry, and quarter potatoes. Transfer to a large baking sheet pan along with cauliflower and mushrooms. Season with spices, toss to coat, and spread out in an even layer.",
            "secondary_message": "1 lb new potatoes\n2 (10 oz) bags cauliflower florets\n2 (8 oz) pkg sliced white mushrooms\n2 tsp curry powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 402973,
            "primary_message": "Cut butter into small pieces. Sprinkle half of the butter over the veggies. (Place remaining butter in a small bowl and set aside to soften.)",
            "secondary_message": "¼ cup butter, unsalted"
          },
          {
            "id": 402974,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender, 20-25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 402975,
            "primary_message": "Meanwhile, wash, dry, and zest lemon into the bowl with the butter. Cut lemon into wedges and set aside for serving.",
            "secondary_message": "1 lemon"
          },
          {
            "id": 402976,
            "primary_message": "Add miso paste to the bowl and mash with the back of a spoon until combined. Set miso butter aside.",
            "secondary_message": "2 tbsp miso paste, white"
          },
          {
            "id": 402977,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 402978,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 402979,
            "primary_message": "Once the skillet is hot, add additional butter and swirl to coat the bottom. Add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to the cutting board.",
            "secondary_message": "2 tsp butter, unsalted"
          },
          {
            "id": 402980,
            "primary_message": "Just before serving, thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 402981,
            "primary_message": "Divide steak and veggies between plates. Top steak with miso butter and serve with lemon wedges for squeezing. Enjoy!",
            "secondary_message": null
          }
        ],
