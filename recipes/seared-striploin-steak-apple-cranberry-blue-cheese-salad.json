        "instructions": [
          {
            "id": 380352,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 380353,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 380354,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 380355,
            "primary_message": "Meanwhile, wash, dry, and chop or tear lettuce into bite-sized pieces. Place in a medium bowl.",
            "secondary_message": "2 hearts romaine hearts"
          },
          {
            "id": 380356,
            "primary_message": "Wash, dry, quarter, and core apples; thinly slice. Add to the bowl with the lettuce along with cranberries. Set aside.",
            "secondary_message": "2 Gala apples\n½ cup dried cranberries"
          },
          {
            "id": 380357,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 380358,
            "primary_message": "Just before serving, add dressing, salt, and pepper to the bowl, then toss to combine the salad.",
            "secondary_message": "⅓ cup blue cheese dressing\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 380359,
            "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
