  "instructions": [
    {
      "id": 384522,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 384523,
      "primary_message": "Once the water is boiling, add broccoli, noodles, and salt; cook until broccoli and noodles are tender, about 5 minutes. Once done, drain and rinse thoroughly under warm water (from the tap); set aside.",
      "secondary_message": "1 (18 oz) bag broccoli florets\n10 oz soba (buckwheat) noodles\n½ tsp salt"
    },
    {
      "id": 384524,
      "primary_message": "Meanwhile, wash, dry, and juice lime into a large bowl. ",
      "secondary_message": "1 lime"
    },
    {
      "id": 384525,
      "primary_message": "Add miso paste, vinegar, water, oil, and soy sauce to the bowl with the lime juice. Whisk to combine the dressing.",
      "secondary_message": "¼ cup miso paste, white\n¼ cup rice vinegar\n2 tbsp water\n2 tbsp toasted sesame oil\n2 tbsp soy sauce"
    },
    {
      "id": 384526,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the dressing along with the carrots.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 (10 oz) bag shredded carrots"
    },
    {
      "id": 384527,
      "primary_message": "Place chicken on the cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces. Add to the bowl, along with the broccoli and noodles, then toss to combine.",
      "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 384528,
      "primary_message": "To serve, divide noodles, chicken, and veggies between bowls; sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "4 tsp sesame seeds"
    }
  ],
