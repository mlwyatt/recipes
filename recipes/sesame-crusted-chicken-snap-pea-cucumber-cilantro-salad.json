        "instructions": [
          {
            "id": 348853,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 lime\n1 jalapeño pepper\n1 small bunch cilantro\n1 English cucumber\n2 (8 oz) pkg sugar snap peas"
          },
          {
            "id": 348854,
            "primary_message": "Peel and mince ginger; place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 348855,
            "primary_message": "Juice lime into the bowl with the ginger. ",
            "secondary_message": null
          },
          {
            "id": 348856,
            "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 348857,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil and salt; whisk to combine the dressing and set aside.",
            "secondary_message": "4 tsp toasted sesame oil\n¼ tsp salt"
          },
          {
            "id": 348858,
            "primary_message": "Place sesame seeds and cornstarch in another medium bowl; stir to combine.",
            "secondary_message": "⅔ cup sesame seeds\n½ cup cornstarch"
          },
          {
            "id": 348859,
            "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets; season with salt and pepper on both sides. ",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 348860,
            "primary_message": "Spread mayo over both sides of the chicken, then dredge in the sesame coating, pressing gently to adhere. Transfer to a plate.",
            "secondary_message": "2 tbsp mayonnaise"
          },
          {
            "id": 348861,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 348862,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add the chicken and cook until the coating is golden and chicken is cooked through, 3-4 minutes per side. Remove from heat.",
            "secondary_message": "4 tsp toasted sesame oil"
          },
          {
            "id": 348863,
            "primary_message": "Meanwhile, using a clean cutting board, trim and quarter cucumber lengthwise, then cut crosswise into thin pieces. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 348864,
            "primary_message": "Cut snap peas crosswise into thin pieces, add to the bowl, and toss to combine the salad. ",
            "secondary_message": null
          },
          {
            "id": 348865,
            "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
