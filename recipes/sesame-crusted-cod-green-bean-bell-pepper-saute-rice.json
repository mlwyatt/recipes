  "instructions": [
    {
      "id": 364739,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 364740,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 364741,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lb green beans\n2 yellow bell peppers\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 364742,
      "primary_message": "Trim green beans, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 364743,
      "primary_message": "Pat the cod dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb cod fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 364744,
      "primary_message": "Place eggs and cornstarch in another medium bowl; beat with a whisk or fork until smooth.",
      "secondary_message": "2 eggs\n2 tbsp cornstarch"
    },
    {
      "id": 364745,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 364746,
      "primary_message": "While the skillet heats up, place sesame seeds on another plate. Dip cod in the egg mixture, then dredge in the sesame seeds, pressing gently to adhere; return to the plate.",
      "secondary_message": "⅔ cup sesame seeds"
    },
    {
      "id": 364747,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cod and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 364748,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl with the green beans.",
      "secondary_message": null
    },
    {
      "id": 364749,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 364750,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until softened, 6-7 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 364751,
      "primary_message": "To serve, divide rice between plates or bowls; top with cod and veggies. Enjoy!",
      "secondary_message": null
    }
  ],
