        "instructions": [
          {
            "id": 157516,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 lemons\n2 heads romaine lettuce\n2 Gala apples"
          },
          {
            "id": 157517,
            "primary_message": "Zest the lemons into a large salad bowl. Juice 1 lemon into the same bowl. Cut remaining lemon into wedges and set aside.",
            "secondary_message": null
          },
          {
            "id": 157518,
            "primary_message": "Add water, tahini, Dijon, oil, salt, and pepper to the bowl with lemon juice and zest; whisk until the dressing becomes smooth and glossy.",
            "secondary_message": "¼ cup water\n¼ cup tahini\n4 tsp Dijon mustard\n4 tsp toasted sesame oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 157519,
            "primary_message": "Peel and finely mince garlic. Finely mince anchovy fillets; transfer both to the salad bowl.",
            "secondary_message": "2 cloves garlic\n2 anchovy fillets, packed in oil"
          },
          {
            "id": 157520,
            "primary_message": "Finely grate half of the Parmesan and add to the salad bowl (set the rest aside for garnish). Stir to combine and set aside.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 157521,
            "primary_message": "Pat the salmon fillets dry with paper towels and place on a plate; season with salt and pepper.",
            "secondary_message": "1 ½ lb salmon fillet\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 157522,
            "primary_message": "Combine the egg and cornstarch into a medium bowl; beat with a whisk or fork until smooth and frothy.",
            "secondary_message": "1 egg\n1 tbsp cornstarch"
          },
          {
            "id": 157523,
            "primary_message": "Dip the skinless side of the salmon into the egg mixture and place back on the plate, skin-side down. Sprinkle sesame seeds over the surface of the fish, pressing down gently with your fingers to adhere.",
            "secondary_message": "¼ cup sesame seeds"
          },
          {
            "id": 157524,
            "primary_message": "Preheat a large nonstick skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 157525,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tsp toasted sesame oil"
          },
          {
            "id": 157526,
            "primary_message": "Add salmon to the skillet, sesame-seed side down, and cook until crust is firm and seeds are golden brown, about 3 minutes. Flip and cook until salmon is cooked through and skin is crispy, 5-7 minutes longer. Remove skillet from the heat.",
            "secondary_message": null
          },
          {
            "id": 157527,
            "primary_message": "Meanwhile, chop or tear the romaine into bite-sized pieces and transfer to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 157528,
            "primary_message": "Wash, core, and thinly slice the apples; add to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 157529,
            "primary_message": "To serve, divide salad and salmon between bowls or plates. Grate reserved Parmesan over top and garnish with lemon wedges. Enjoy!",
            "secondary_message": null
          }
        ],
