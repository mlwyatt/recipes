        "instructions": [
          {
            "id": 445493,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 hearts romaine hearts\n1 English cucumber\n1 mango\n2 avocados"
          },
          {
            "id": 445494,
            "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 445495,
            "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the lettuce.",
            "secondary_message": null
          },
          {
            "id": 445496,
            "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; cut into bite-sized pieces. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 445497,
            "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; add to the bowl.",
            "secondary_message": "3 cups edamame"
          },
          {
            "id": 445498,
            "primary_message": "Add shredded cabbage, almonds, and dressing to the bowl. Toss to combine the salad.",
            "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n⅔ cup almonds, sliced\n⅔ cup sesame ginger dressing"
          },
          {
            "id": 445499,
            "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
            "secondary_message": null
          },
          {
            "id": 445500,
            "primary_message": "To serve, divide salad between plates or bowls; top with avocado and sesame seeds. Enjoy!",
            "secondary_message": "4 tsp sesame seeds"
          }
        ],
