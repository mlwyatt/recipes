        "instructions": [
          {
            "id": 360638,
            "primary_message": "Preheat oven to 450°F. Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
            "secondary_message": null
          },
          {
            "id": 360639,
            "primary_message": "Place miso, vinegar, oil, sesame seeds, and soy sauce in a medium bowl; whisk to combine the sauce.",
            "secondary_message": "2 tbsp miso paste, red\n2 tbsp rice vinegar\n2 tbsp toasted sesame oil\n4 tsp sesame seeds\n2 tsp soy sauce"
          },
          {
            "id": 360640,
            "primary_message": "Add cauliflower to the bowl with the sauce and stir to coat. Transfer to the baking sheet and spread out in an even layer. Drizzle with any remaining sauce in the bowl. (Reserve bowl for later use.)",
            "secondary_message": "2 (10 oz) bags cauliflower florets"
          },
          {
            "id": 360641,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until fork-tender, 15-20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 360642,
            "primary_message": "Meanwhile, peel and mince garlic; place in the reserved bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 360643,
            "primary_message": "Pat the steak dry with paper towels and slice crosswise into ¼-inch thick strips. Add to the bowl with the garlic, season with salt and pepper, then toss to combine.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 360644,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 360645,
            "primary_message": "While the skillet heats up, wash and dry snap peas.",
            "secondary_message": "2 (8 oz) pkg sugar snap peas"
          },
          {
            "id": 360646,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, steak, and snap peas to the skillet; stir-fry until snap peas are tender and steak is just cooked through, 4-5 minutes. Cover and remove from heat.",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 360647,
            "primary_message": "To serve, divide stir-fry and roasted cauliflower between plates. Enjoy!",
            "secondary_message": null
          }
        ],
