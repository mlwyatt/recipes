  "instructions": [
    {
      "id": 439130,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 439131,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 English cucumber\n1 bunch radish\n1 avocado\n1 head butter (Boston) lettuce"
    },
    {
      "id": 439132,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 439133,
      "primary_message": "While the rice is cooking, trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 439134,
      "primary_message": "Drain tuna, add to the bowl with the green onion, and flake with a fork. Add mayo, oil, vinegar, soy sauce, and chili-garlic sauce; stir to combine and set aside. ",
      "secondary_message": "4 (6 oz) cans chunk light tuna in water\n½ cup mayonnaise\n4 tsp toasted sesame oil\n2 tsp rice vinegar\n2 tsp soy sauce\n1 tsp chili-garlic sauce"
    },
    {
      "id": 439135,
      "primary_message": "Place additional mayo, vinegar, soy sauce, sugar, and garlic powder in a small bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "4 tsp mayonnaise\n4 tsp rice vinegar\n4 tsp soy sauce\n2 tsp brown sugar\n1 tsp garlic powder"
    },
    {
      "id": 439136,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 439137,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 439138,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 439139,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 439140,
      "primary_message": "Divide rice, tuna, and veggies between bowls; top with reserved green onions and sesame seeds. Serve with dressing on the side and enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
