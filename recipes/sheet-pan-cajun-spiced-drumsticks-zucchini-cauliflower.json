  "instructions": [
    {
      "id": 370669,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": null
    },
    {
      "id": 370670,
      "primary_message": "Pat chicken dry with paper towels and place in a large bowl.",
      "secondary_message": "2 ½ lb chicken drumsticks"
    },
    {
      "id": 370671,
      "primary_message": "Wash, dry, trim, and slice zucchini crosswise into ½-inch thick rounds. Add to the bowl with the chicken along with the cauliflower.",
      "secondary_message": "4 medium zucchini squash\n2 (10 oz) bags cauliflower florets"
    },
    {
      "id": 370672,
      "primary_message": "Drizzle chicken and veggies with oil, then sprinkle with Cajun seasoning and salt. Toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp Cajun seasoning\n½ tsp salt"
    },
    {
      "id": 370673,
      "primary_message": "Divide chicken and veggies between two baking sheet pans, then spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 370674,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until veggies are tender and chicken is cooked through, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370675,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
