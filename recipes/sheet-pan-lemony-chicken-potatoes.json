        "instructions": [
          {
            "id": 187838,
            "primary_message": "Preheat the oven to 400°F and position the rack in the center. Line a baking sheet pan with parchment paper.",
            "secondary_message": null
          },
          {
            "id": 187839,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n1 lb new potatoes\n2 lemons"
          },
          {
            "id": 187840,
            "primary_message": "Halve the new potatoes and cut the cauliflower into florets. Toss in a bowl with olive oil, salt, and pepper. Arrange in a single layer on the baking sheet pan and bake for 15 minutes.",
            "secondary_message": "2 tsp salt\n2 tsp black pepper\n2 tbsp extra virgin olive oil"
          },
          {
            "id": 187841,
            "primary_message": "Season the chicken with salt and pepper on both sides, set aside.",
            "secondary_message": "1 lb chicken thighs, boneless skinless\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 187842,
            "primary_message": "Grate all of the zest from the lemons, then juice the lemons into a small bowl.",
            "secondary_message": null
          },
          {
            "id": 187843,
            "primary_message": "Peel and mince the garlic, add to bowl with the lemon juice and zest. Add olive oil, mustard, honey, and oregano and whisk together.",
            "secondary_message": "¼ cup extra virgin olive oil\n¼ cup honey\n2 tsp oregano\n4 cloves garlic\n¼ cup Dijon mustard"
          },
          {
            "id": 187844,
            "primary_message": "Quarter and thinly slice the red onion. Remove the sheet pan from the oven and add onions on top, dispersing evenly.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 187845,
            "primary_message": "Lay the chicken on top of the vegetables and drizzle evenly with the lemon sauce.",
            "secondary_message": null
          },
          {
            "id": 187846,
            "primary_message": "Return the sheet pan to the oven and bake until chicken is golden brown and cooked through, about 20 minutes. ",
            "secondary_message": null
          },
          {
            "id": 187847,
            "primary_message": "To serve, divide chicken and vegetables between plates and top with sauce from pans. Enjoy!",
            "secondary_message": null
          }
        ],
