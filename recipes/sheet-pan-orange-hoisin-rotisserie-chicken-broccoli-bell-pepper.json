  "instructions": [
    {
      "id": 469177,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 469178,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Transfer to a large baking sheet pan along with broccoli. Drizzle with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "4 yellow bell peppers\n1 (18 oz) bag broccoli florets\n3 tbsp toasted sesame oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 469179,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies soften, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 469180,
      "primary_message": "Meanwhile, wash, dry, and juice oranges into a medium bowl. Add hoisin sauce and stir to combine.",
      "secondary_message": "2 oranges\n⅔ cup hoisin sauce"
    },
    {
      "id": 469181,
      "primary_message": "Place chicken on the cutting board and, using your hands, remove meat from the skin and bones; separate the meat into shred-like pieces. Add chicken to the bowl with the sauce and stir to coat.",
      "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 469182,
      "primary_message": "When the veggies are soft, remove from the oven. Add chicken and sauce to the baking sheet; stir to combine with the veggies, then spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 469183,
      "primary_message": "Return the baking sheet to the oven and continue to bake until veggies are tender and chicken is warmed through, 5-6 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 469184,
      "primary_message": "To serve, divide chicken-veggie bake between plates or bowls and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
