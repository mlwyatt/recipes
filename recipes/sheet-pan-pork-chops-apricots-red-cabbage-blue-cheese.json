        "instructions": [
          {
            "id": 82436,
            "primary_message": "Preheat oven to 425°F. Line a baking sheet with aluminum paper (optional).",
            "secondary_message": null
          },
          {
            "id": 82437,
            "primary_message": "Wash cabbage, quarter, and cut off core. Thinly slice crosswise into shreds and transfer to a medium bowl. Toss with oil, balsamic vinegar, salt, and pepper.",
            "secondary_message": "1 small head red cabbage\n3 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 82438,
            "primary_message": "Use tongs to transfer cabbage to a baking sheet pan, leaving the excess vinegar in the bowl. Spread cabbage out in an even layer on a baking sheet and place in the oven.",
            "secondary_message": null
          },
          {
            "id": 82439,
            "primary_message": "Slice the apricots in half lengthwise. Add to the bowl and toss in the remaining oil and vinegar; allow to soak in the vinegar mixture while the cabbage cooks.",
            "secondary_message": "8 dried apricots"
          },
          {
            "id": 82440,
            "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
            "secondary_message": "½ small pkg fresh thyme"
          },
          {
            "id": 82441,
            "primary_message": "Pat the pork chops dry, rub with olive oil, and season with salt, pepper, and thyme. Arrange on a baking sheet and place in the oven. Roast until pork chops are cooked through and cabbage is fork-tender (18-20 minutes).",
            "secondary_message": "4 pork chops, bone-in\n4 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 82442,
            "primary_message": "During the last 5 minutes of cooking, sprinkle the apricots and the blue cheese over the cabbage.",
            "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
          },
          {
            "id": 82443,
            "primary_message": "To serve, arrange a bed of cabbage, apricots, and blue cheese on a plate and top with a pork chop. Enjoy!",
            "secondary_message": null
          }
        ],
