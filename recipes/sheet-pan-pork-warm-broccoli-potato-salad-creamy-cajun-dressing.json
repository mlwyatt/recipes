        "instructions": [
          {
            "id": 379271,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 379272,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb new potatoes\n2 red bell peppers\n1 small bunch green onions (scallions)"
          },
          {
            "id": 379273,
            "primary_message": "Quarter potatoes and transfer to a large baking sheet pan. ",
            "secondary_message": null
          },
          {
            "id": 379274,
            "primary_message": "Trim, seed, and roughly chop bell peppers into bite-sized pieces. Add to the baking sheet with the potatoes along with the broccoli.",
            "secondary_message": "1 (18 oz) bag broccoli florets"
          },
          {
            "id": 379275,
            "primary_message": "Drizzle veggies with oil and season with salt; toss to combine and spread out in an even layer. ",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 379276,
            "primary_message": "Pat the pork chops dry with paper towels and add to the baking sheet, nestling them into the veggies. Drizzle chops with additional oil and season both sides with salt. ",
            "secondary_message": "4 pork chops, boneless\n2 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 379277,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring veggies and turning pork halfway through, until veggies are fork-tender and pork is cooked through, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 379278,
            "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Place in a large bowl. ",
            "secondary_message": null
          },
          {
            "id": 379279,
            "primary_message": "Add dressing, vinegar, Cajun seasoning, and salt to the bowl with the green onion. Stir to combine the dressing. ",
            "secondary_message": "⅓ cup ranch dressing\n1 tbsp white wine vinegar\n1 tbsp Cajun seasoning\n¼ tsp salt"
          },
          {
            "id": 379280,
            "primary_message": "When the veggies and pork are done, remove from the oven. Add roasted veggies to the bowl with the dressing and toss to combine the warm broccoli-potato salad.",
            "secondary_message": null
          },
          {
            "id": 379281,
            "primary_message": "To serve, divide broccoli-potato salad and pork between plates. Enjoy! ",
            "secondary_message": null
          }
        ],
