        "instructions": [
          {
            "id": 46164,
            "primary_message": "Preheat the oven to 450°F and place the rack in the center position.",
            "secondary_message": null
          },
          {
            "id": 46165,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium yellow potatoes\n1 bunch kale"
          },
          {
            "id": 46166,
            "primary_message": "Medium dice the potatoes and transfer to a sheet pan.",
            "secondary_message": null
          },
          {
            "id": 46167,
            "primary_message": "Drizzle the potatoes with olive oil and season with salt and pepper; toss thoroughly to coat, then arrange in a single layer.",
            "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 46168,
            "primary_message": "Place the potatoes in the oven and roast for 10 minutes while you prepare the kale and salmon.",
            "secondary_message": ""
          },
          {
            "id": 46169,
            "primary_message": "In a large bowl, combine and whisk together olive oil, Dijon, honey, salt, and pepper.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 46170,
            "primary_message": "Cut out and discard the kale stems; chop leaves crosswise into 1-inch strips. Add the kale to the bowl with the dressing and toss to coat.",
            "secondary_message": ""
          },
          {
            "id": 46171,
            "primary_message": "Pat dry the salmon with paper towels and place on a plate; rub with olive oil and season with salt and pepper.",
            "secondary_message": "1 ½ lb salmon fillet\n1 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 46172,
            "primary_message": "Remove the sheet pan from the oven. Evenly spread the kale over the potatoes, then top with the salmon.",
            "secondary_message": null
          },
          {
            "id": 46173,
            "primary_message": "Return the pan to the oven; roast until the salmon is cooked through and the kale is crispy; 8 to 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 46174,
            "primary_message": "To serve, divide the potatoes and kale between plates and top with the salmon. Enjoy!",
            "secondary_message": null
          }
        ],
