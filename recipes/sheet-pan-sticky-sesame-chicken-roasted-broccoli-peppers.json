        "instructions": [
          {
            "id": 190241,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 190242,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n2 crowns broccoli\n1 (8 oz) pkg sugar snap peas\n2 (1 inch) pieces ginger root"
          },
          {
            "id": 190243,
            "primary_message": "Pat the chicken breasts dry with paper towels, rub with olive oil, season generously with salt and pepper on both sides and place in the middle of a parchment paper lined baking sheet. ",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 190244,
            "primary_message": "Peel and medium dice the onion. Cut the sugar snap peas crosswise (at an angle) into 1-inch pieces and add to a mixing bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 190245,
            "primary_message": "Cut the bell peppers into quarters lengthwise; remove and discard the seeds and white membranes. Medium dice, add to the bowl with the onion.",
            "secondary_message": null
          },
          {
            "id": 190246,
            "primary_message": "Separate broccoli into bite-sized florets and cut stems into bite-sized pieces and add to bowl with other vegetables.",
            "secondary_message": null
          },
          {
            "id": 190247,
            "primary_message": "Drizzle the vegetables with oil and season with salt and pepper; toss to coat, then arrange in a single layer on baking sheet around the chicken breasts. Bake in the oven for 20 minutes. ",
            "secondary_message": "2 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 190248,
            "primary_message": "Heat a small saucepan over medium heat. Once the pan is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "2 tsp virgin coconut oil"
          },
          {
            "id": 190249,
            "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add to the saucepan, cook stirring until fragrant, about 30 seconds.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 190250,
            "primary_message": "Add soy sauce, honey, sesame oil, sesame seeds and water to the saucepan. Bring sauce to a boil, then reduce heat to low, stirring frequently.",
            "secondary_message": "¼ cup tamari soy sauce\n3 tbsp honey\n2 tsp toasted sesame oil\n2 tbsp sesame seeds\n¼ cup water"
          },
          {
            "id": 190251,
            "primary_message": "Combine cornstarch with water in a small bowl and pour into sauce. Let sauce thicken for 2-3 minutes then remove from heat and set aside.",
            "secondary_message": "2 tsp cornstarch\n2 tbsp water"
          },
          {
            "id": 190252,
            "primary_message": "Remove chicken from oven, drizzle sauce over top and return to oven for another 5 minutes or until sauce is sticky and chicken is cooked through.",
            "secondary_message": null
          },
          {
            "id": 190253,
            "primary_message": "To serve, slice chicken into strips. Divide between plates and sprinkle sesame seeds over top. Enjoy!",
            "secondary_message": "2 tbsp sesame seeds"
          }
        ],
