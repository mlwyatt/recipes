        "instructions": [
          {
            "id": 16509,
            "primary_message": "If using frozen shrimp, place in a medium bowl, cover with water, and set aside to thaw. If using fresh shrimp, skip this step.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 16510,
            "primary_message": "Wash and dry the lettuce. Tear into smaller pieces.",
            "secondary_message": "2 head butter (Boston) lettuce"
          },
          {
            "id": 16511,
            "primary_message": "Wash and quarter grapefruit. Peel and slice 6 of the quarters into wedges (save 2 for the dressing). Halve and pit avocado; thinly slice flesh while still in skin and scoop out (save a quarter of the avocado for the dressing).",
            "secondary_message": "2 grapefruit\r\n2 avocados"
          },
          {
            "id": 16512,
            "primary_message": "Wash and juice the lime and remaining grapefruit wedge into a small bowl; add saved avocado and mash thoroughly. Add honey, salt, and pepper; whisk to combine and set aside.",
            "secondary_message": "½ lime\n¼ tsp honey\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 16513,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 16514,
            "primary_message": "Peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 16515,
            "primary_message": "Drain and rinse shrimp under cold water until there are no more ice chunks. Place on paper towels and pat dry. If using fresh shrimp, skip this step.",
            "secondary_message": ""
          },
          {
            "id": 16516,
            "primary_message": "Coat bottom of skillet with oil. Add garlic and cook until fragrant, 15-30 seconds. Add shrimp and cook until opaque, 2-3 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 16517,
            "primary_message": "To serve, arrange lettuce on a plate and top with avocado, grapefruit, and shrimp. Drizzle with dressing and enjoy!",
            "secondary_message": ""
          }
        ],
