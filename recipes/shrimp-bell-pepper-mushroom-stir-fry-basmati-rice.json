        "instructions": [
          {
            "id": 21011,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n¼ tsp salt\n16 fl oz (2 cups) water"
          },
          {
            "id": 21012,
            "primary_message": "If using frozen shrimp, place in a large bowl, cover with cold water, and set aside to thaw. If using fresh shrimp, skip this step.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 40472,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 21013,
            "primary_message": "Wash bell peppers and mushrooms. Seed and slice peppers into strips. Slice mushrooms. Transfer to a bowl.",
            "secondary_message": "2 red bell peppers\r\n2 yellow bell peppers\r\n½ lb white mushrooms"
          },
          {
            "id": 21014,
            "primary_message": "Peel and mince garlic. Peel and mince or grate ginger.",
            "secondary_message": "4 cloves garlic\r\n2 (1 inch) pieces ginger root"
          },
          {
            "id": 21015,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 21016,
            "primary_message": "Drain shrimp in a colander and rinse under cold water until there are no more ice chunks. Spread out on a clean towel and pat dry.",
            "secondary_message": ""
          },
          {
            "id": 21017,
            "primary_message": "Coat bottom of skillet with oil. Add shrimp and cook, stirring frequently, until opaque and pink, 2-3 minutes. Transfer to a plate.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 21018,
            "primary_message": "Once shrimp have been transferred, add more oil to skillet. Add garlic, ginger, bell peppers, and mushrooms. Stir fry until peppers are tender-crisp, 3-4 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 21019,
            "primary_message": "In a medium bowl, prepare sauce by whisking together soy sauce, vinegar, sesame oil, honey, and cornstarch.",
            "secondary_message": "4 tbsp soy sauce\r\n1 tbsp rice vinegar\r\n2 tsp toasted sesame oil\r\n1 tsp honey\r\n2 tsp cornstarch"
          },
          {
            "id": 21020,
            "primary_message": "Return shrimp to skillet and pour in the sauce. Stir fry until sauce thickens, 1-2 minutes.",
            "secondary_message": ""
          },
          {
            "id": 40471,
            "primary_message": "Uncover the rice and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 21021,
            "primary_message": "Serve by placing rice in a bowl or on a plate and adding stir fry over top. Enjoy!",
            "secondary_message": ""
          }
        ],
