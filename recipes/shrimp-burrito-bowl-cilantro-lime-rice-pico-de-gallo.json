        "instructions": [
          {
            "id": 50310,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n2 cups water"
          },
          {
            "id": 50311,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 pints grape tomatoes\n2 green bell peppers\n2 jalapeño peppers\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 50312,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 50313,
            "primary_message": "Quarter the grape tomatoes and transfer to a medium bowl (that will be used for the salsa).",
            "secondary_message": null
          },
          {
            "id": 50314,
            "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the salsa bowl.",
            "secondary_message": null
          },
          {
            "id": 50315,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces. Transfer one ½ to the salsa bowl and the other ½ to a separate medium bowl.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 50316,
            "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Small dice the peppers into ¼-inch pieces. Add to the medium bowl with the onion.",
            "secondary_message": null
          },
          {
            "id": 50317,
            "primary_message": "Juice the limes into a small bowl; add about ½ of the juice to the salsa bowl and save the rest for the rice.",
            "secondary_message": null
          },
          {
            "id": 50318,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add about ½ of the cilantro to the salsa bowl and add the rest to the bowl with the remaining lime juice.",
            "secondary_message": null
          },
          {
            "id": 50319,
            "primary_message": "Season the salsa with salt; stir to combine and set aside.",
            "secondary_message": "½ tsp salt"
          },
          {
            "id": 50320,
            "primary_message": "Add coconut oil to a nonstick skillet and preheat over medium heat.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 50321,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water until there are no more ice chunks. Then, lay them out on a clean towel or paper towels and pat dry. If using fresh shrimp, skip the first step.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 50322,
            "primary_message": "Once the skillet is hot, add the shrimp and cook until they are opaque, 1 to 2 minutes per side. Once done, transfer to a bowl and set aside to cool.",
            "secondary_message": null
          },
          {
            "id": 50323,
            "primary_message": "Once the shrimp has been transferred, add more coconut oil to the skillet followed by the onion and bell peppers. Cook, stirring frequently, until the vegetables are browned and softened, 2 to 3 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 50324,
            "primary_message": "Uncover the rice and fluff with a fork. Add the remaining lime juice and cilantro to the rice and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 50325,
            "primary_message": "To serve, arrange the rice, veggie mixture, shrimp, and salsa in a bowl. Enjoy!",
            "secondary_message": null
          }
        ],
