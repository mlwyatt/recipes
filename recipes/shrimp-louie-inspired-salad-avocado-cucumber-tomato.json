        "instructions": [
          {
            "id": 491618,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n2 tomatoes\n1 English cucumber\n2 avocados"
          },
          {
            "id": 491619,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 491620,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 491621,
            "primary_message": "While the skillet heats up, roughly chop shrimp.",
            "secondary_message": null
          },
          {
            "id": 491622,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper; cook, stirring occasionally, until just cooked through, 1-2 minutes. Remove from heat and set aside to cool, 5 minutes.",
            "secondary_message": "2 tsp neutral vegetable oil\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 491623,
            "primary_message": "Meanwhile, using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with ranch, ketchup, hot sauce, and spices. Stir to combine the dressing.",
            "secondary_message": "3 tbsp ranch dressing\n2 tbsp ketchup\n1 tbsp hot sauce\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 491624,
            "primary_message": "Medium dice tomatoes. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 491625,
            "primary_message": "Trim and medium dice cucumber. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 491626,
            "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 491627,
            "primary_message": "When the shrimp are cool, add to the bowl and stir to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 491628,
            "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
            "secondary_message": null
          }
        ],
