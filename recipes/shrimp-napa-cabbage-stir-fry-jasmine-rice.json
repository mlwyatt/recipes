        "instructions": [
          {
            "id": 31047,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n½ tsp salt\n2 cups water"
          },
          {
            "id": 31048,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head napa cabbage\n1 small bunch green onions (scallions)\n2 (1 inch) pieces ginger root"
          },
          {
            "id": 31049,
            "primary_message": "Peel and grate or mince the ginger; transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 31050,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic and transfer to the bowl with the ginger.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 31051,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 31052,
            "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 31053,
            "primary_message": "Trim off and discard the root end of the cabbage; quarter the cabbage lengthwise, then chop crosswise into 1-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 31054,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 31055,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 31056,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 31057,
            "primary_message": "Add the shrimp to the skillet and stir-fry until lightly browned and almost cooked through, 2 to 4 minutes. Once done, transfer to a bowl or plate.",
            "secondary_message": null
          },
          {
            "id": 31058,
            "primary_message": "Once the shrimp have been transferred, add more oil to the skillet, followed by the garlic, ginger, and crushed red pepper; stir until fragrant, 15 to 30 seconds.",
            "secondary_message": "2 tbsp virgin coconut oil\n½ tsp crushed red pepper"
          },
          {
            "id": 31059,
            "primary_message": "Add the cabbage to the skillet; cook, stirring frequently, until the cabbage is softened, 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 31060,
            "primary_message": "While the cabbage cooks, in a small bowl, combine and whisk together soy sauce, sesame oil, honey, and cornstarch.",
            "secondary_message": "4 tbsp soy sauce\n2 tsp toasted sesame oil\n2 tsp honey\n2 tsp cornstarch\n"
          },
          {
            "id": 31061,
            "primary_message": "Return the shrimp to the skillet along with any accumulated juices, add about ¾ of the green onions (save the rest for garnishing), and pour the sauce overtop; stir-fry until the ingredients are well combined, about 1 minute.",
            "secondary_message": null
          },
          {
            "id": 31062,
            "primary_message": "Uncover the rice and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 31063,
            "primary_message": "To serve, spoon the rice onto a plate, top with the stir-fry, and garnish with the remaining green onions. Enjoy!",
            "secondary_message": null
          }
        ],
