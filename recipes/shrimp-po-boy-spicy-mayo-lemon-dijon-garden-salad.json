        "instructions": [
          {
            "id": 163309,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 163310,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 lemons\n2 heads butter (Boston) lettuce\n2 medium carrots\n2 tomatoes"
          },
          {
            "id": 163311,
            "primary_message": "Peel and mince garlic. Transfer to a small bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 163312,
            "primary_message": "Juice one lemon into the bowl with the garlic. Add mayonnaise, chili-garlic sauce, and salt; whisk to combine and set the spicy mayo aside.",
            "secondary_message": "¼ cup mayonnaise\n2 tsp chili-garlic sauce\n½ tsp salt"
          },
          {
            "id": 163313,
            "primary_message": "In a medium bowl, combine bread crumbs, flour, and spices. Add shrimp and toss to combine.",
            "secondary_message": "¼ cup panko bread crumbs\n2 tbsp all-purpose flour\n½ tsp paprika\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt"
          },
          {
            "id": 163314,
            "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "¼ cup extra virgin olive oil"
          },
          {
            "id": 163315,
            "primary_message": "Working in batches if necessary, add shrimp to the skillet; cook until opaque, 1-2 minutes per side. Once done, transfer to a paper-towel lined plate.",
            "secondary_message": null
          },
          {
            "id": 163316,
            "primary_message": "Meanwhile, juice the remaining lemon into a large bowl. Add oil, vinegar, Dijon, honey, and spices; whisk to combine the dressing.",
            "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp white wine vinegar\n½ tsp Dijon mustard\n½ tsp honey\n½ tsp thyme\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 163317,
            "primary_message": "Separate the lettuce leaves. Set aside 2 large leaves per sandwich; chop or tear remaining leaves into bite-sized pieces and add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 163318,
            "primary_message": "Trim carrots and peel into thin noodle-like sticks using a julienne (or regular) peeler. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 163319,
            "primary_message": "Slice one tomato and set aside for the sandwiches. Small dice the remaining tomato and add to the salad bowl. Toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 163320,
            "primary_message": "Toast buns if desired.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 163321,
            "primary_message": "Place the bottom half of a bun on each plate. Layer with lettuce, shrimp, tomato, and spicy mayo; close with top half of the bun. Serve salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
