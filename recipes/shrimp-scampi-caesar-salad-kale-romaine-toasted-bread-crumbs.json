        "instructions": [
          {
            "id": 406488,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 406489,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 lemons\n1 small bunch Italian (flat-leaf) parsley\n1 bunch kale\n1 head romaine lettuce"
          },
          {
            "id": 406490,
            "primary_message": "Zest one lemon into a large bowl. (Reserve remaining lemons for later use.)",
            "secondary_message": null
          },
          {
            "id": 406491,
            "primary_message": "Cut butter into small pieces. Add to the bowl with the lemon zest along with bread crumbs, salt, and pepper; stir to combine. Transfer bread crumb mixture to a baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
            "secondary_message": "2 tbsp butter, unsalted\n⅔ cup panko bread crumbs\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 406492,
            "primary_message": "Place baking sheet in the oven (it doesn't need to be fully heated) and bake, stirring halfway through, until bread crumbs are golden and toasted, about 5 minutes. Remove from oven and set aside to cool.",
            "secondary_message": null
          },
          {
            "id": 406493,
            "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 406494,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 406495,
            "primary_message": "While the skillet heats up, peel and thinly slice garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 406496,
            "primary_message": "Once the skillet is hot, add additional butter and swirl to coat the bottom. Add garlic and spices; cook, stirring occasionally, until garlic is golden and fragrant, 1-2 minutes.",
            "secondary_message": "¼ cup butter, unsalted\n½ tsp salt\n½ tsp crushed red pepper\n¼ tsp black pepper"
          },
          {
            "id": 406497,
            "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
            "secondary_message": null
          },
          {
            "id": 406498,
            "primary_message": "When the garlic is golden, juice one lemon into the skillet, then add parsley and shrimp. Cook, stirring occasionally, until the shrimp are opaque and cooked through, about 3 minutes. Remove from heat. (Reserve remaining lemon for the next step.)",
            "secondary_message": null
          },
          {
            "id": 406499,
            "primary_message": "While the shrimp are cooking, juice remaining lemon into the reserved bowl. ",
            "secondary_message": null
          },
          {
            "id": 406500,
            "primary_message": "Finely grate Parmesan. Add to the bowl with the lemon juice.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 406501,
            "primary_message": "Peel and mince additional garlic; mince anchovy fillets. Add both to the bowl along with mayo, Dijon, salt, and pepper. Whisk to combine the dressing.",
            "secondary_message": "2 cloves garlic\n4 anchovy fillets, packed in oil\n½ cup mayonnaise\n1 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 406502,
            "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear kale and lettuce leaves into bite-sized pieces. Add both to the bowl with the dressing and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 406503,
            "primary_message": "To serve, divide salad between plates or bowls; top with shrimp scampi and bread crumbs. Enjoy!",
            "secondary_message": null
          }
        ],
