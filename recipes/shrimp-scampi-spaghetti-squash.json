        "instructions": [
          {
            "id": 31424,
            "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line a baking sheet with aluminum foil to make cleanup easier (optional).",
            "secondary_message": null
          },
          {
            "id": 31425,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium spaghetti squash\n1 lemon\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 31426,
            "primary_message": "Halve the squash lengthwise and scrape out the seeds; Rub each half with olive oil and season with salt and freshly ground pepper. Place halves, cut side down, on a baking sheet.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 31428,
            "primary_message": "Place the squash in the oven (it doesn't have to be fully heated) and roast until tender so a knife can easily pierce though the flesh, 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 31429,
            "primary_message": "While the squash cooks, using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Transfer the parsley to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 31430,
            "primary_message": "Grate all of the zest from the lemon, then juice the lemon. Add the zest and juice to the bowl with the parsley.",
            "secondary_message": null
          },
          {
            "id": 31431,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "6 cloves garlic"
          },
          {
            "id": 31432,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 31433,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 31434,
            "primary_message": "Once the skillet is hot, add olive oil and butter and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil\n6 tbsp butter, unsalted"
          },
          {
            "id": 31435,
            "primary_message": "Add the garlic and crushed red pepper to the skillet; stir until fragrant, 15-30 seconds.",
            "secondary_message": "¼ tsp crushed red pepper"
          },
          {
            "id": 31436,
            "primary_message": "Add the shrimp to the skillet; cook, tossing occasionally, until opaque and cooked through, 2-4 minutes total.",
            "secondary_message": ""
          },
          {
            "id": 31437,
            "primary_message": "Add the lemon zest, lemon juice, and parsley to the shrimp; season with salt and pepper and stir to combine.",
            "secondary_message": "½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 31438,
            "primary_message": "Remove the squash from the oven; allow squash to cool slightly, about 5 minutes. Using a fork, scrape up the squash flesh to make spaghetti-like strings (use an oven mitt or towel to hold it with your other hand).",
            "secondary_message": null
          },
          {
            "id": 31439,
            "primary_message": "To serve, top the squash with the shrimp scampi. Enjoy!",
            "secondary_message": null
          }
        ],
