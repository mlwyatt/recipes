        "instructions": [
          {
            "id": 191485,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 191486,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 191487,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 red bell peppers\n4 tomatoes\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 191488,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 191489,
            "primary_message": "When the water in the pot comes to a boil, uncover the pot and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11-12 minutes (or according to package directions). Once done, drain the pasta in a colander.",
            "secondary_message": "10 oz linguine pasta\n2 tsp salt"
          },
          {
            "id": 191490,
            "primary_message": "Peel and chop onion into 2-inch pieces; peel garlic. Spread out on a baking sheet.",
            "secondary_message": "1 medium red onion\n4 cloves garlic"
          },
          {
            "id": 191491,
            "primary_message": "Cut the bell peppers lengthwise; remove and discard the seeds and white membrane and chop into 2-inch pieces. Chop tomatoes into quarters and place on the baking sheet along with the peppers.",
            "secondary_message": null
          },
          {
            "id": 191492,
            "primary_message": "Drizzle veggies with oil and season with salt and pepper; place in the oven and roast for 13-14 minutes. During that last 3-4 minutes of cooking, change the setting to broil and cook until they begin to char slightly.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 191493,
            "primary_message": "Meanwhile, heat a skillet over medium-high heat. Once the skillet is hot, add butter and swirl to coat the bottom. ",
            "secondary_message": "2 tsp butter, unsalted"
          },
          {
            "id": 191494,
            "primary_message": "Add shrimp to the pan, season with salt and pepper. Cook until golden brown and pink all the way through, about 2-3 minutes.",
            "secondary_message": "2 tsp salt\n2 tsp black pepper"
          },
          {
            "id": 191495,
            "primary_message": "Finely grate Parmesan.",
            "secondary_message": "4 oz Parmesan cheese"
          },
          {
            "id": 191496,
            "primary_message": "When vegetables are done cooking let cool for 3-4 minutes. Once cooled, peel the skin off the peppers and tomatoes and discard them.",
            "secondary_message": null
          },
          {
            "id": 191497,
            "primary_message": "Add vegetables to the blender and blend until mostly smooth. Add half the Parmesan and season with salt and crushed red pepper. Pulse to combine. ",
            "secondary_message": "½ tsp salt\n½ tsp crushed red pepper"
          },
          {
            "id": 191498,
            "primary_message": "Return pasta to the pot, add shrimp, sauce and spinach and stir to until spinach is wilted slightly. ",
            "secondary_message": null
          },
          {
            "id": 191499,
            "primary_message": "To serve, divide pasta between plates, top with remaining Parmesan. Enjoy!",
            "secondary_message": null
          }
        ],
