  "instructions": [
    {
      "id": 196979,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 196980,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 mangoes\n1 small bunch cilantro\n1 jalapeño pepper\n½ small head red cabbage\n2 avocados"
    },
    {
      "id": 196981,
      "primary_message": "Zest and juice limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 196982,
      "primary_message": "Peel mangoes and slice the flesh away from the pit, starting with the flat sides. Medium dice and add to the bowl with the lime.",
      "secondary_message": null
    },
    {
      "id": 196983,
      "primary_message": "Shave the cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 196984,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 196985,
      "primary_message": "Peel and mince onion; add to the bowl along with salt and pepper. Stir to combine the salsa and set aside.",
      "secondary_message": "1 medium red onion\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 196986,
      "primary_message": "Place yogurt, chili-garlic sauce, and salt in a small bowl; whisk to combine and set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n1 tsp chili-garlic sauce\n½ tsp salt"
    },
    {
      "id": 196987,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 196988,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 196989,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and stir until fragrant, about 30 seconds.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 196990,
      "primary_message": "Add shrimp to the skillet and season with salt and pepper. Cook until opaque, 1-2 minutes per side. Once done, chop into small pieces and set aside.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 196991,
      "primary_message": "Meanwhile, trim off and discard the root end of the cabbage; quarter cabbage lengthwise and remove the core. Slice crosswise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 196992,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 196993,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 196994,
      "primary_message": "To serve, divide tortillas between plates, top with cabbage, avocado, shrimp, salsa, and spicy yogurt. Enjoy!",
      "secondary_message": null
    }
  ],
