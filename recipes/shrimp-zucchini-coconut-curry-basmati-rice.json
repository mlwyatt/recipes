        "instructions": [
          {
            "id": 45199,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n½ tsp salt\n2 cups water"
          },
          {
            "id": 45200,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water until there are no more ice chunks. Then, lay them out on a clean towel or paper towels and pat dry. If using fresh shrimp, skip the first step.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 45201,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium zucchini squash\n2 (1 inch) pieces ginger root\n1 small bunch cilantro"
          },
          {
            "id": 45202,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": ""
          },
          {
            "id": 45203,
            "primary_message": "Preheat a sauté pan over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 45204,
            "primary_message": "While the pan heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces).",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 45205,
            "primary_message": "Once the pan is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 45206,
            "primary_message": "Add the onion to the pan; cook, stirring frequently, until slightly softened, 3 to 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 45207,
            "primary_message": "While the onion cooks, trim off and discard the ends of the zucchini; quarter the zucchini lengthwise, then slice crosswise into ¼-inch-thick pieces.",
            "secondary_message": null
          },
          {
            "id": 45208,
            "primary_message": "Add the zucchini to the pan; cook, stirring occasionally, until slightly softened, 2 to 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 45209,
            "primary_message": "While the zucchini cooks, trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 45210,
            "primary_message": "Peel and grate or mince the ginger. Add to the bowl with the garlic.",
            "secondary_message": null
          },
          {
            "id": 45211,
            "primary_message": "Add the garlic, ginger, curry powder, turmeric, salt, and pepper to the pan; cook, stirring, until fragrant, 15 to 30 seconds.",
            "secondary_message": "2 tsp curry powder\n1 tsp turmeric\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 45212,
            "primary_message": "Add the coconut milk, and fish sauce to the pan; bring to a boil, then reduce the heat to medium-low and cook for 2 to 3 minutes.",
            "secondary_message": "1 (13.5 fl oz) can coconut milk\n2 tsp fish sauce"
          },
          {
            "id": 45213,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves.",
            "secondary_message": null
          },
          {
            "id": 45214,
            "primary_message": "Add the shrimp and ¾ of the cilantro (save the rest for garnishing) to the pan; cook until the shrimp are opaque and pink, 3 to 4 minutes, then remove from the heat.",
            "secondary_message": ""
          },
          {
            "id": 45215,
            "primary_message": "Uncover the rice and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 45216,
            "primary_message": "To serve, divide the rice between bowls, top with the shrimp and zucchini curry, and garnish with the remaining cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
