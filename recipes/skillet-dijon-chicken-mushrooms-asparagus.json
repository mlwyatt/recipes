        "instructions": [
          {
            "id": 26986,
            "primary_message": "Fill a large pot about halfway with water, cover, and bring to a boil.",
            "secondary_message": ""
          },
          {
            "id": 26987,
            "primary_message": "Wash the asparagus and snap (or cut) off and discard the woody ends.",
            "secondary_message": "2 bunches asparagus\r\n"
          },
          {
            "id": 26988,
            "primary_message": "Once the water in the pot is boiling, add the asparagus and cover. Cook until bright green and tender, 3-4 minutes. Drain and thoroughly rinse under cold water to stop the cooking process. Set aside.",
            "secondary_message": ""
          },
          {
            "id": 26989,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 26990,
            "primary_message": "Slice the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
            "secondary_message": "1 lb chicken breasts, boneless skinless\r\n½ tsp salt\r\n½ tsp black pepper"
          },
          {
            "id": 26991,
            "primary_message": "Add butter to the skillet and swirl to coat bottom. Add the chicken and cook until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 26992,
            "primary_message": "Wash and slice the mushrooms. Peel and finely dice the shallots.",
            "secondary_message": "½ lb white mushrooms\r\n2 shallots"
          },
          {
            "id": 26993,
            "primary_message": "Once the chicken has been removed, add more butter to the skillet. Add the mushrooms and shallots. Cook, stirring occasionally, until the mushrooms are tender and any liquid has evaporated, 5-6 minutes.",
            "secondary_message": "2 tbsp butter, unsalted\r\n"
          },
          {
            "id": 26994,
            "primary_message": "Peel and mince the garlic.",
            "secondary_message": "4 cloves garlic\r\n"
          },
          {
            "id": 26995,
            "primary_message": "Add the garlic and thyme and cook until fragrant, 15-30 seconds.",
            "secondary_message": "1 tsp thyme\r\n"
          },
          {
            "id": 26996,
            "primary_message": "Add the broth and scrape up any browned bits from the bottom of the skillet. Stir in the cream and Dijon and season with salt and pepper.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n4 fl oz (½ cup) heavy cream\n2 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 26997,
            "primary_message": "Return the chicken to the skillet and bring to a boil. Simmer until the sauce is thickened, 4-5 minutes.",
            "secondary_message": ""
          },
          {
            "id": 26998,
            "primary_message": "Arrange asparagus on a plate and top with the chicken and mushrooms. Enjoy!",
            "secondary_message": ""
          }
        ],
