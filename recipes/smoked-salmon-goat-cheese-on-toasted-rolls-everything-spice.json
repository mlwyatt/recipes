        "instructions": [
          {
            "id": 160669,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 160670,
            "primary_message": "Peel and mince shallots.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 160671,
            "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom. Add shallots and cook, stirring often, until softened, 2-3 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 160672,
            "primary_message": "Peel and mince garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 160673,
            "primary_message": "Add garlic, seeds, salt, and pepper to the skillet with the shallots. Continue to cook, stirring often, until the shallots and garlic become golden, 2-3 minutes. Transfer to a small bowl to keep the garlic from overcooking. ",
            "secondary_message": "4 tsp sesame seeds\n2 tsp poppy seeds\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 160674,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 bunch radish\n1 English cucumber\n1 tomato"
          },
          {
            "id": 160675,
            "primary_message": "Trim off and discard tops and root ends of radishes. Thinly slice and transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 160676,
            "primary_message": "Trim off and discard ends of the cucumber; slice crosswise into ¼-inch pieces at an angle. Add to the plate.",
            "secondary_message": null
          },
          {
            "id": 160677,
            "primary_message": "Slice tomato into rounds and add to the plate. Season veggies with salt and pepper.",
            "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 160678,
            "primary_message": "Halve and toast rolls.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 160679,
            "primary_message": "Combine goat cheese and yogurt in a medium bowl and mash with a fork until smooth and creamy. ",
            "secondary_message": "2 (4 oz) logs goat cheese\n1 cup plain Greek yogurt"
          },
          {
            "id": 160680,
            "primary_message": "Spread goat cheese mixture over toasted rolls. Layer with smoked salmon, cucumber, tomato, radish, and capers. ",
            "secondary_message": "2 (4 oz) pkgs smoked salmon\n2 tbsp capers"
          },
          {
            "id": 160681,
            "primary_message": "To serve, divide between plates and top with \"Everything\" spice. Enjoy!",
            "secondary_message": null
          }
        ],
