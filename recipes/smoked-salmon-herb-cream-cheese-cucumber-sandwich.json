  "instructions": [
    {
      "id": 375203,
      "primary_message": "Cut cream cheese into small pieces. Place in a small bowl.",
      "secondary_message": "⅔ (8 oz) block cream cheese"
    },
    {
      "id": 375204,
      "primary_message": "Wash, dry, and chop chives into small pieces. Add to the bowl with the cream cheese along with dill and pepper. Using the back of a spoon, mash and combine the herb cream cheese. Set aside.",
      "secondary_message": "½ small pkg chives\n¼ tsp dill, dried\n⅛ tsp black pepper"
    },
    {
      "id": 375205,
      "primary_message": "Wash, dry, trim, and peel cucumber; slice crosswise into thin rounds.",
      "secondary_message": "1 English cucumber"
    },
    {
      "id": 375206,
      "primary_message": "Place bread on a flat surface. Divide the herb cream cheese between the slices and spread out in an even layer. Layer half of the slices with cucumber and salmon, then close sandwiches with remaining slices of bread.",
      "secondary_message": "8 slices whole grain bread\n1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 375207,
      "primary_message": "To serve, slice sandwiches in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
