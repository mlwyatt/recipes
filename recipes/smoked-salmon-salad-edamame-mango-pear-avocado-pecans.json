        "instructions": [
          {
            "id": 240063,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "1 lemon\n2 mangoes\n2 avocados\n2 pears\n2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 240064,
            "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
            "secondary_message": "2 cups edamame"
          },
          {
            "id": 240065,
            "primary_message": "Juice lemon into a large bowl. Add oil, vinegar, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 240066,
            "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice and add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 240067,
            "primary_message": "Halve and pit avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 240068,
            "primary_message": "Quarter, core, and medium dice pears; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 240069,
            "primary_message": "Roughly chop pecans and add to the bowl.",
            "secondary_message": "½ cup pecans, dry roasted"
          },
          {
            "id": 240070,
            "primary_message": "Chop or tear salmon into bite-sized pieces and add to the bowl.",
            "secondary_message": "2 (4 oz) pkgs smoked salmon"
          },
          {
            "id": 240071,
            "primary_message": "Add mixed greens and edamame to the bowl; toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 240072,
            "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
            "secondary_message": null
          }
        ],
