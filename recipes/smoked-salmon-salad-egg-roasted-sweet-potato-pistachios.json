        "instructions": [
          {
            "id": 301638,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 301639,
            "primary_message": "Wash, dry, peel, and small dice sweet potatoes. Transfer to a baking sheet pan, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer.",
            "secondary_message": "1 lb sweet potato\n4 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 301640,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until sweet potato is fork-tender, 10-12 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 301641,
            "primary_message": "Meanwhile, halve eggs and transfer to a large plate.",
            "secondary_message": "4 hard-cooked eggs, peeled"
          },
          {
            "id": 301642,
            "primary_message": "Cut or tear salmon into bite-sized pieces and add to the plate with the eggs.",
            "secondary_message": "2 (4 oz) pkgs smoked salmon"
          },
          {
            "id": 301643,
            "primary_message": "Peel, halve, and slice shallots into thin half-moons; add to the plate.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 301644,
            "primary_message": "Roughly chop pistachios, add to the plate, and set aside.",
            "secondary_message": "1 cup pistachios, unsalted"
          },
          {
            "id": 301645,
            "primary_message": "Wash and dry mixed greens. (Skip this step if they came pre-washed.)",
            "secondary_message": "2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 301646,
            "primary_message": "To serve, divide mixed greens, shallot, salmon, roasted sweet potato, pistachios, and eggs between plates. Drizzle with vinaigrette and enjoy!",
            "secondary_message": "⅓ cup French vinaigrette"
          }
        ],
