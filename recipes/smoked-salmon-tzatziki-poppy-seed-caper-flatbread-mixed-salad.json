  "instructions": [
    {
      "id": 425192,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 425193,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven and set aside to cool slightly, about 3 minutes. ",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 425194,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl along with the vinaigrette.",
      "secondary_message": "1 shallot\n⅓ cup French vinaigrette"
    },
    {
      "id": 425195,
      "primary_message": "Wash, dry, trim, and thinly slice radishes. Add to the bowl with the vinaigrette and set aside. ",
      "secondary_message": "1 bunch radish"
    },
    {
      "id": 425196,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "2 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 425197,
      "primary_message": "Once the flatbreads have cooled slightly, spread tzatziki over the surface. Top with smoked salmon, capers, and poppy seeds. Slice flatbreads into wedges.",
      "secondary_message": "1 cup tzatziki sauce\n2 tbsp capers\n1 tsp poppy seeds"
    },
    {
      "id": 425198,
      "primary_message": "Wash and dry mixed greens (skip this step if they came pre-washed). Add to the bowl with the vinaigrette and radishes, then toss to combine the salad. ",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 425199,
      "primary_message": "To serve, divide flatbread and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
