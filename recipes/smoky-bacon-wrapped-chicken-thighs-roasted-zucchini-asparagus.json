        "instructions": [
          {
            "id": 82363,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 82364,
            "primary_message": "In a small bowl, combine chili powder, paprika, onion powder, cinnamon, salt, and pepper.",
            "secondary_message": "1 tsp chili powder\n1 tsp paprika\n1 tsp onion powder\n½ tsp cinnamon\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 82365,
            "primary_message": "Pat the chicken dry with paper towel; sprinkle chicken with half of the spice blend. Wrap each thigh in 1-2 strips of bacon, place in a baking dish, and sprinkle with the remaining spice blend.",
            "secondary_message": "2 lb chicken thighs, boneless skinless\n10 slices bacon"
          },
          {
            "id": 82366,
            "primary_message": "Place chicken in the oven and bake until chicken is golden brown and cooked through (internal temperature of chicken reaches 165°F), 20-25 minutes.",
            "secondary_message": null
          },
          {
            "id": 82367,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 medium zucchini squash\n2 small bunches asparagus\n1 small bunch green onions (scallions)\n1 small pkg fresh mint\n1 lemon"
          },
          {
            "id": 82368,
            "primary_message": "Trim off and discard the ends of the zucchini; medium dice the zucchini (cut into ½-inch cubes) and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 82369,
            "primary_message": "Snap or cut off and discard the woody ends of the asparagus; transfer to the medium bowl.",
            "secondary_message": null
          },
          {
            "id": 82370,
            "primary_message": "Trim off and discard the root ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and transfer to the medium bowl.",
            "secondary_message": null
          },
          {
            "id": 82371,
            "primary_message": "Pick the mint leaves off the stems; discard the stems and mince the leaves. Save some of the mint for garnish and add the rest to the medium bowl.",
            "secondary_message": null
          },
          {
            "id": 82372,
            "primary_message": "Juice the lemon and add the juice to the medium bowl.",
            "secondary_message": null
          },
          {
            "id": 82373,
            "primary_message": "Drizzle the vegetables with olive oil and season with salt and pepper; toss to coat, then arrange in a single layer on a baking sheet and place in the oven. Cook until vegetables are fork tender, 12-15 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 82374,
            "primary_message": "Remove both pans from oven. Change oven setting to broil and position rack near the top. Return chicken pan to oven and broil until bacon crisps, 2-3 minutes.",
            "secondary_message": null
          },
          {
            "id": 82375,
            "primary_message": "To serve, divide the chicken and vegetables between plates and garnish with fresh mint. Enjoy!",
            "secondary_message": null
          }
        ],
