        "instructions": [
          {
            "id": 210133,
            "primary_message": "In a medium bowl, stir together flour and spices; remove 2 tablespoons seasoned flour and set aside for later use.",
            "secondary_message": "½ cup all-purpose flour\n½ tsp garlic powder\n½ tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 210134,
            "primary_message": "Pat pork chops dry with paper towels, add to the bowl with the flour, and toss to coat.",
            "secondary_message": "4 pork chops, boneless"
          },
          {
            "id": 210135,
            "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 210136,
            "primary_message": "Add chops to the skillet; cook until golden brown, about 2 minutes per side. Once golden, transfer to a plate and loosely cover with aluminum foil (the pork will not be cooked all the way through).",
            "secondary_message": null
          },
          {
            "id": 210137,
            "primary_message": "Meanwhile, peel and thinly slice onions into half rings.",
            "secondary_message": "2 medium yellow onions"
          },
          {
            "id": 210138,
            "primary_message": "Return skillet to medium heat. Once hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 210139,
            "primary_message": "Add onions, salt, and pepper to the skillet. Cook, stirring occasionally, until onions are soft and slightly caramelized, 10-15 minutes.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 210140,
            "primary_message": "Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces; transfer to a large bowl.",
            "secondary_message": "2 crowns broccoli"
          },
          {
            "id": 210141,
            "primary_message": "Wash, dry, and thinly slice mushrooms. Peel and mince garlic. Transfer both to the bowl with the broccoli.",
            "secondary_message": "1 lb cremini mushrooms\n2 cloves garlic"
          },
          {
            "id": 210142,
            "primary_message": "Add reserved flour to the skillet and stir to coat onions. Cook, stirring frequently, about 1 minute.",
            "secondary_message": null
          },
          {
            "id": 210143,
            "primary_message": "Add broth and cream to the skillet, stir to combine, and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until sauce begins to thicken, 4-5 minutes.",
            "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n4 fl oz (½ cup) heavy cream"
          },
          {
            "id": 210144,
            "primary_message": "Return pork chops to the skillet and turn to coat in sauce. Cover and simmer until chops are cooked through, 5 minutes more.",
            "secondary_message": null
          },
          {
            "id": 210145,
            "primary_message": "Meanwhile, heat another large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 210146,
            "primary_message": "Add veggies, salt, and pepper to the skillet; stir-fry until broccoli is bright green and tender-crisp, 4-5 minutes.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 210147,
            "primary_message": "To serve, divide pork chops, sauce, and veggies between plates. Enjoy!",
            "secondary_message": null
          }
        ],
