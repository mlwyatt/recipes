        "instructions": [
          {
            "id": 397574,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
            "secondary_message": "1 tsp salt"
          },
          {
            "id": 397575,
            "primary_message": "Meanwhile, wash and dry the fresh produce. ",
            "secondary_message": "1 lime\n2 (1 inch) pieces ginger root\n6 baby bok choy\n1 bunch radish\n1 small pkg fresh mint"
          },
          {
            "id": 397576,
            "primary_message": "Once the water in the pot is boiling, add the noodles. Cook noodles according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water.",
            "secondary_message": "10 oz soba (buckwheat) noodles"
          },
          {
            "id": 397577,
            "primary_message": "Meanwhile, zest and juice lime into a large bowl.",
            "secondary_message": null
          },
          {
            "id": 397578,
            "primary_message": "Peel and mince ginger. Add to the bowl with the lime juice along with soy sauce, chili-garlic sauce, and oil. Stir to combine the dressing and set aside.",
            "secondary_message": "¼ cup soy sauce\n2 tsp chili-garlic sauce\n1 tsp toasted sesame oil"
          },
          {
            "id": 397579,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 397580,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 397581,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes. (Reserve skillet with cooking juices for later use.)",
            "secondary_message": "2 tsp toasted sesame oil"
          },
          {
            "id": 397582,
            "primary_message": "While the steak is cooking, trim and cut bok choy in half lengthwise.",
            "secondary_message": null
          },
          {
            "id": 397583,
            "primary_message": "Return skillet (with cooking juices) to medium-high heat. Add bok choy, salt, and pepper; cook, flipping occasionally, until tender, 5-6 minutes. Remove from heat.",
            "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 397584,
            "primary_message": "Meanwhile, trim and thinly slice radishes. Add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 397585,
            "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl along with the cooled noodles and broccoli slaw. Toss to combine the noodle salad. (Reserve remaining mint for serving.)",
            "secondary_message": "1 (12 oz) pkg broccoli slaw"
          },
          {
            "id": 397586,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 397587,
            "primary_message": "To serve, divide noodle salad between bowls; top with steak and bok choy. Sprinkle with reserved mint and enjoy!",
            "secondary_message": null
          }
        ],
