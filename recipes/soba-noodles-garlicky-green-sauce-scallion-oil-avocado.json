        "instructions": [
          {
            "id": 440272,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
            "secondary_message": "½ tsp salt"
          },
          {
            "id": 440273,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 (5 oz) pkgs baby spinach\n1 lime\n2 small bunches green onions (scallions)\n2 avocados"
          },
          {
            "id": 440274,
            "primary_message": "Once the water is boiling, add spinach and cook until bright green and just tender, about 15 seconds. Using tongs, transfer spinach to the colander, and set aside to drain (reserve boiling water in pot for the next step).",
            "secondary_message": null
          },
          {
            "id": 440275,
            "primary_message": "Add the noodles to the pot and cook according to package directions, about 5 minutes. Once done, drain in the colander. (Reserve pot for later use.)",
            "secondary_message": "10 oz soba (buckwheat) noodles"
          },
          {
            "id": 440276,
            "primary_message": "While the noodles are cooking, transfer drained spinach to a blender. (Reserve colander for the noodles.)",
            "secondary_message": null
          },
          {
            "id": 440277,
            "primary_message": "Juice lime into the blender.",
            "secondary_message": null
          },
          {
            "id": 440278,
            "primary_message": "Add nutritional yeast, soy sauce, oil, and garlic powder to the blender. Blend on high until sauce is smooth, adding water, 1 teaspoon at a time, if needed to reach a drizzling consistency. Set green sauce aside. ",
            "secondary_message": "¼ cup nutritional yeast flakes\n¼ cup soy sauce\n2 tbsp toasted sesame oil\n1 tsp garlic powder"
          },
          {
            "id": 440279,
            "primary_message": "Trim and thinly slice green onions crosswise.",
            "secondary_message": null
          },
          {
            "id": 440280,
            "primary_message": "Wipe the pot used for the noodles clean with paper towels and return to medium heat.",
            "secondary_message": null
          },
          {
            "id": 440281,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add green onions, crushed red pepper, and salt; cook, stirring frequently, until bright green and just tender, about 30 seconds. Remove from heat.",
            "secondary_message": "¼ cup toasted sesame oil\n½ tsp crushed red pepper\n¼ tsp salt"
          },
          {
            "id": 440282,
            "primary_message": "Transfer drained noodles to a medium bowl. Add green sauce, then stir to coat noodles; add additional water, a tablespoon at a time, if necessary, to coat the noodles in sauce.",
            "secondary_message": null
          },
          {
            "id": 440283,
            "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin pieces. Season with salt.",
            "secondary_message": "⅛ tsp salt"
          },
          {
            "id": 440284,
            "primary_message": "To serve, divide noodles and avocado between plates or bowls; top noodles with scallion oil. Enjoy!",
            "secondary_message": null
          }
        ],
