  "instructions": [
    {
      "id": 267453,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 267454,
      "primary_message": "Place pine nuts on a large baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and toast, stirring every 2-3 minutes, until golden brown, 5-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 267455,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 tomatoes\n1 lemon\n2 bunches kale"
    },
    {
      "id": 267456,
      "primary_message": "Place oil, vinegar, salt, and pepper in a baking dish; whisk to combine the marinade.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 267457,
      "primary_message": "Slice tomatoes into ¼-inch thick rounds; add to the dish with the marinade, turn to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 267458,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 267459,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 267460,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 267461,
      "primary_message": "Turn oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 267462,
      "primary_message": "While the broiler heats up, finely grate Parmesan and add to the bowl with the kale.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 267463,
      "primary_message": "Roughly chop toasted pine nuts. Add to the bowl and toss to combine the salad; set aside. (Reserve baking sheet for next step.)",
      "secondary_message": null
    },
    {
      "id": 267464,
      "primary_message": "Arrange bread on the baking sheet. Place in the oven and toast, flipping once, until golden brown, 1-2 minutes. Remove from the oven. ",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 267465,
      "primary_message": "Spread each slice of toast with a thick layer of mayo. Top half of the slices with marinated tomatoes, then close with remaining toast slices.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 267466,
      "primary_message": "To serve, divide tomato sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
