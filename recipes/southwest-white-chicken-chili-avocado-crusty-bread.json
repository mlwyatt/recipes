  "instructions": [
    {
      "id": 11437,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 11438,
      "primary_message": "Peel and small dice onion. Peel and mince garlic. Wash, seed, and mince jalapeño.",
      "secondary_message": "1 medium yellow onion\r\n4 cloves garlic\r\n2 jalapeño peppers"
    },
    {
      "id": 11439,
      "primary_message": "Coat bottom of pot with oil. Add onion, garlic, and jalapeño. Stirring frequently, cook until onion is softened, 3-4 minutes.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 11440,
      "primary_message": "Cut chicken into bite-sized pieces.",
      "secondary_message": "1 lb chicken breasts, boneless skinless"
    },
    {
      "id": 11441,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 11442,
      "primary_message": "Add chicken to pot and, stirring occasionally, cook until no longer pink, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11443,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 11444,
      "primary_message": "Add beans, broth, ½ of the cilantro (save the rest for garnishing), cumin, oregano, salt, and pepper. Bring to a boil. Reduce heat to medium-low and simmer, stirring occasionally, for about 10 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 tsp cumin\n1 tsp oregano\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 11445,
      "primary_message": "Toast bread.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 11446,
      "primary_message": "Halve and pit avocados; scoop out and medium dice.",
      "secondary_message": "2 avocados"
    },
    {
      "id": 11447,
      "primary_message": "To serve, add chili to a bowl and garnish with avocado and remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
