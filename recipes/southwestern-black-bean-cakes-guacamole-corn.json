  "instructions": [
    {
      "id": 19602,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 19603,
      "primary_message": "Wash and dry jalapeños and cilantro. Seed and mince jalapeño. Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "2 jalapeño peppers\r\n1 small bunch cilantro"
    },
    {
      "id": 19604,
      "primary_message": "Transfer beans to a large bowl and mash with a fork. Add eggs, jalapeños, ½ of the cilantro (save the rest for the guacamole), bread crumbs, cumin, salt, and pepper. Mix until well combined.",
      "secondary_message": "2 eggs\r\n½ cup panko bread crumbs\r\n1 tsp cumin\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 19605,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 19606,
      "primary_message": "Halve and pit avocados; scoop out the flesh into a medium bowl. Add remaining cilantro, lime juice, salt, and pepper. Mash with a fork until smooth.",
      "secondary_message": "2 avocados\r\njuice of 1 lime\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19607,
      "primary_message": "Measure out corn.",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 19608,
      "primary_message": "Coat bottom of skillet with oil. Add corn and cook until heated through, 2-3 minutes. Transfer to a bowl.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 19609,
      "primary_message": "Shape black bean mixture into 12-16 patties and place on a plate.",
      "secondary_message": ""
    },
    {
      "id": 19610,
      "primary_message": "Once corn has been transferred, wipe skillet and coat with more oil. Working in batches, add patties and cook until browned and crisp, 3-4 minutes per side.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 19611,
      "primary_message": "Peel and mince garlic. Add garlic, lime juice, salt, and pepper to corn; mix to combine.",
      "secondary_message": "2 cloves garlic\r\njuice of 1 lime\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 19612,
      "primary_message": "Serve black bean cakes with guacamole and corn. Enjoy!",
      "secondary_message": ""
    }
  ],
