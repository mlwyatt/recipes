        "instructions": [
          {
            "id": 20046,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "about 14 cups water\n2 tbsp salt\n12 oz spaghetti pasta"
          },
          {
            "id": 20047,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 20048,
            "primary_message": "Peel and mince garlic. Halves olives. Measure out capers.",
            "secondary_message": "4 cloves garlic\r\n1 cup Kalamata olives, pitted\r\n4 tbsp capers"
          },
          {
            "id": 20049,
            "primary_message": "Coat bottom of skillet with oil. Add garlic, olives, capers, oregano, and crushed red pepper. Stir and cook for 1-2 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\r\n1 tbsp oregano\r\n¼ tsp crushed red pepper"
          },
          {
            "id": 20050,
            "primary_message": "Add tomatoes and bring to a boil. Reduce heat and simmer the sauce while the pasta cooks.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes"
          },
          {
            "id": 20051,
            "primary_message": "Wash basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons.",
            "secondary_message": "1 small pkg fresh basil"
          },
          {
            "id": 20052,
            "primary_message": "Drain pasta in a colander.",
            "secondary_message": ""
          },
          {
            "id": 20053,
            "primary_message": "Add pasta to sauce and drizzle with olive oil. Stir in the basil and season with salt and pepper. Toss to combine.",
            "secondary_message": "1 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 20054,
            "primary_message": "To serve, add pasta to a shallow bowl or plate and enjoy!",
            "secondary_message": ""
          }
        ],
