        "instructions": [
          {
            "id": 459110,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
            "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
          },
          {
            "id": 459111,
            "primary_message": "Meanwhile, fill another large pot about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pot is boiling, reduce heat to medium-low.",
            "secondary_message": "2 tsp white wine vinegar"
          },
          {
            "id": 459112,
            "primary_message": "While the water is heating, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 small bunch green onions (scallions)\n1 small bunch asparagus\n1 (5 oz) pkg baby spinach\n1 lemon"
          },
          {
            "id": 459113,
            "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 459114,
            "primary_message": "Snap (or cut) off woody ends of the asparagus; cut into 1-inch pieces. Add to the bowl with the green onions.",
            "secondary_message": null
          },
          {
            "id": 459115,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 459116,
            "primary_message": "While the skillet heats up, peel and mince garlic. Add garlic and peas to the bowl.",
            "secondary_message": "2 cloves garlic\n1 cup frozen peas"
          },
          {
            "id": 459117,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until fork-tender, 5-6 minutes. (Reserve bowl for the next step.)",
            "secondary_message": "¼ cup butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 459118,
            "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl and set aside.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 459119,
            "primary_message": "Gently crack eggs into additional small bowls (two eggs per bowl).",
            "secondary_message": "8 eggs"
          },
          {
            "id": 459120,
            "primary_message": "Adjust heat of the pot as necessary so that the vinegar water is simmering. Working in batches if necessary, gently tip bowls into the pot, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a plate.",
            "secondary_message": null
          },
          {
            "id": 459121,
            "primary_message": "When the veggies are done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
            "secondary_message": null
          },
          {
            "id": 459122,
            "primary_message": "Zest and juice lemon into the skillet, then add drained spaghetti. Continue to cook, tossing occasionally, until warmed through, 1-2 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 459123,
            "primary_message": "To serve, divide pasta and eggs between bowls. Top with Parmesan and enjoy! ",
            "secondary_message": null
          }
        ],
