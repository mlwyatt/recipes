  "instructions": [
    {
      "id": 486708,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 486709,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 small bunch green onions (scallions)\n1 small bunch fresh dill\n2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 486710,
      "primary_message": "Zest lemon into a medium bowl. Add ⅔ of the feta, yogurt, oil, pepper, and salt. Mash with a fork until semi-smooth and combined, then set aside. (Reserve lemon and remaining feta for later use.)",
      "secondary_message": "2 (4 oz) pkgs crumbled feta cheese\n1 cup plain Greek yogurt\n2 tsp extra virgin olive oil\n½ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 486711,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until flatbreads are slightly crispy, about 8 minutes. Remove from oven and set aside.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 486712,
      "primary_message": "Meanwhile, juice reserved lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 486713,
      "primary_message": "Trim and thinly slice green onions crosswise. Add to the bowl with the lemon juice.",
      "secondary_message": null
    },
    {
      "id": 486714,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 486715,
      "primary_message": "While the skillet heats up, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil and salt, then stir to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 486716,
      "primary_message": "Once the skillet is hot, add lemon-oil mixture. Add spinach to the skillet in handfuls, waiting for spinach to wilt slightly before adding the next handful. Cook, stirring frequently, until wilted, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 486717,
      "primary_message": "Spread the creamy feta over each flatbread, then top with sautéed greens and reserved feta.",
      "secondary_message": null
    },
    {
      "id": 486718,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
