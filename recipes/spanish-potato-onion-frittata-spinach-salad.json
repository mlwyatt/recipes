        "instructions": [
          {
            "id": 191385,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach and chives if they came pre-washed.)",
            "secondary_message": "4 medium yellow potatoes\n1 small pkg chives\n1 (5 oz) pkg baby spinach\n2 medium carrots\n2 tomatoes"
          },
          {
            "id": 191386,
            "primary_message": "Using a mandoline or knife, slice the potatoes into very thin slices and transfer to a colander. Sprinkle with salt and toss to coat; set aside in the sink or on a plate to drain.",
            "secondary_message": "1 tsp salt"
          },
          {
            "id": 191387,
            "primary_message": "Heat a non-stick skillet over medium high heat.",
            "secondary_message": null
          },
          {
            "id": 191388,
            "primary_message": "Peel and thinly slice onion into half rings. Peel and mince (or press) the garlic.",
            "secondary_message": "2 medium yellow onions\n2 cloves garlic"
          },
          {
            "id": 191389,
            "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom. Add onion, garlic, thyme, and oregano to the pan, stirring until soft and golden brown, 4-5 minutes; remove from skillet and set aside.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp thyme\n½ tsp oregano"
          },
          {
            "id": 191390,
            "primary_message": "Meanwhile, shake excess water from the potato slices and quickly pat dry with a paper towel.",
            "secondary_message": null
          },
          {
            "id": 191391,
            "primary_message": "Add more oil and the potatoes to the pan; turn the heat down to low and cover with a lid. Cook potatoes, stirring occasionally, until tender, 5-7 minutes. Once cooked, spread onion in a layer on top of the potatoes.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 191392,
            "primary_message": "While the potatoes are cooking, crack the eggs into a medium bowl, add water and season with salt and pepper. Whisk to combine.",
            "secondary_message": "12 eggs\n¼ cup water\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 191393,
            "primary_message": "Pour the egg mixture into the skillet gently so you don't disturb the potatoes. Cover with a lid and cook until the base and sides are set, about 5-6 minutes.",
            "secondary_message": null
          },
          {
            "id": 191394,
            "primary_message": "Preheat oven to broil and position rack under the broiler.",
            "secondary_message": null
          },
          {
            "id": 191395,
            "primary_message": "While frittata is cooking on the stove, combine balsamic, oil, honey, Dijon, salt, and pepper in a large bowl to make the dressing for the salad. ",
            "secondary_message": "2 tbsp balsamic vinegar\n¼ cup extra virgin olive oil\n2 tsp honey\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 191396,
            "primary_message": "Peel the carrots, then trim off the ends. Using a box grater, coarsely grate. Medium dice tomatoes and add both to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 191397,
            "primary_message": "Once frittata edges are set transfer the pan to the oven and broil until the center eggs are firm and the top becomes golden brown, 5-7 minutes.",
            "secondary_message": null
          },
          {
            "id": 191398,
            "primary_message": "Add spinach to the bowl with the dressing and toss to combine.",
            "secondary_message": null
          },
          {
            "id": 191399,
            "primary_message": "Chop chives into small pieces.",
            "secondary_message": null
          },
          {
            "id": 191400,
            "primary_message": "When frittata is done cooking, remove from oven and place a cutting board on top of the skillet. Using oven mitts, flip the pan to turn the frittata out onto the cutting board so that potatoes are facing up.",
            "secondary_message": null
          },
          {
            "id": 191401,
            "primary_message": "To serve, cut frittata into wedges and divide between plates. Garnish with chives and serve with spinach salad. Enjoy!",
            "secondary_message": null
          }
        ],
