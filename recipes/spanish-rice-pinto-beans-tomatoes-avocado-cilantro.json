  "instructions": [
    {
      "id": 447346,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n2 avocados\n1 small bunch cilantro"
    },
    {
      "id": 447347,
      "primary_message": "Peel, trim, and small dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 447348,
      "primary_message": "Trim and small dice celery. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 447349,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 447350,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 447351,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 2-3 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp chili powder\n1 tsp oregano, dried\n1 tsp salt\n¼ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "id": 447352,
      "primary_message": "Meanwhile, drain and rinse beans. Place in the reserved bowl and set aside.",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "id": 447353,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain. When the veggies are soft, add rice to the pot; cook, stirring constantly, until rice is slightly translucent, 1-2 minutes.",
      "secondary_message": "1 cup basmati rice"
    },
    {
      "id": 447354,
      "primary_message": "Add beans, tomatoes, and broth to the pot. Stir to combine and bring to a boil over high heat.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 447355,
      "primary_message": "Once the liquid in the pot comes to a boil, stir the mixture, cover the pot, and reduce heat to low. Simmer until rice is tender and the liquid is mostly absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 447356,
      "primary_message": "When the rice is almost done, halve and pit avocados; using a spoon, scoop out the flesh and thinly slice. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 447357,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the rice and stir to combine (reserve the rest for serving).",
      "secondary_message": null
    },
    {
      "id": 447358,
      "primary_message": "To serve, divide rice between plates or bowls; top with avocado and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
