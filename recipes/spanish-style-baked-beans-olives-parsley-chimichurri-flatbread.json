  "instructions": [
    {
      "id": 448007,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 448008,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n2 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 448009,
      "primary_message": "Halve grape tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 448010,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 448011,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448012,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 448013,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tomatoes, bell pepper, garlic, and spices to the skillet. Cook, stirring occasionally, until tomatoes are starting to burst, 7-8 minutes. (Reserve bowl for later use.)",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tsp smoked paprika\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 448014,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 448015,
      "primary_message": "Halve olives lengthwise.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 448016,
      "primary_message": "When the veggies are done, add beans, olives, broth, and vinegar to the skillet, then stir to combine. Place skillet in the oven and bake until beans are tender and sauce has thickened slightly, 15-20 minutes. Remove from oven.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 tsp rice vinegar"
    },
    {
      "id": 448017,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 448018,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the parsley along with oil, vinegar, oregano, and salt. Stir to combine the chimichurri and set aside.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n2 tsp rice vinegar\n½ tsp oregano, dried\n½ tsp salt"
    },
    {
      "id": 448019,
      "primary_message": "When the beans have about 5 minutes left, cut flatbread into wedges and arrange on a baking sheet pan. Add to the oven and bake until warmed through and slightly golden, 4-5 minutes. Remove from oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 448020,
      "primary_message": "To serve, divide beans and flatbread wedges between plates or bowls. Drizzle beans with chimichurri and enjoy!",
      "secondary_message": null
    }
  ],
