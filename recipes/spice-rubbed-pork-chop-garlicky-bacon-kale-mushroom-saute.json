  "instructions": [
    {
      "id": 249770,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 249771,
      "primary_message": "Once the skillet is hot, add bacon and cook until crispy, 3-5 minutes per side. Remove to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 249772,
      "primary_message": "Meanwhile, preheat the broiler to high and position rack about 6 inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 249773,
      "primary_message": "Place spices in a medium bowl and stir to combine the spice rub.",
      "secondary_message": "1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper\n½ tsp turmeric, ground"
    },
    {
      "id": 249774,
      "primary_message": "Pat pork chops dry with paper towels and place on a broiler pan; season with spice rub on both sides. (Reserve bowl for later use.)",
      "secondary_message": "4 pork chops, bone-in"
    },
    {
      "id": 249775,
      "primary_message": "Place pork chops in the oven and broil, flipping halfway through, until chops are no longer pink in the center and are browned at the edges, 12-14 minutes, or until they reach an internal temperature of 145°F. Remove from the oven and let rest for 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 249776,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms; place in the reserved bowl and set aside.",
      "secondary_message": "1 lb white mushrooms"
    },
    {
      "id": 249777,
      "primary_message": "Peel and thinly slice garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 249778,
      "primary_message": "Return skillet (with bacon drippings) to medium heat. Once the skillet is hot, add mushrooms and garlic; cook, stirring occasionally, until mushrooms are soft and golden, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 249779,
      "primary_message": "While the mushrooms are cooking, wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. ",
      "secondary_message": "2 bunches kale"
    },
    {
      "id": 249780,
      "primary_message": "When the mushrooms are done, add kale to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Add water, salt, and pepper; stir to combine and cover. Cook until the kale is wilted and tender, 1-2 minutes; remove from heat.",
      "secondary_message": "¼ cup water\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 249781,
      "primary_message": "Meanwhile, chop or crumble bacon into pieces.",
      "secondary_message": null
    },
    {
      "id": 249782,
      "primary_message": "Add bacon to the skillet with the veggies and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 249783,
      "primary_message": "To serve, divide pork chops and veggie sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
