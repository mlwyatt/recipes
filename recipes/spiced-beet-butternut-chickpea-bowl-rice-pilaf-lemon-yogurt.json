        "instructions": [
          {
            "id": 233792,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 233793,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium beets\n1 small butternut squash\n1 lemon\n1 small bunch cilantro"
          },
          {
            "id": 233794,
            "primary_message": "Trim, peel, and cut beets into ½-inch cubes. Transfer to a large baking sheet pan. ",
            "secondary_message": null
          },
          {
            "id": 233795,
            "primary_message": "Trim and peel butternut squash. Halve lengthwise, scrape out seeds, and cut flesh into ½-inch cubes; add to the baking sheet with the beets.",
            "secondary_message": null
          },
          {
            "id": 233796,
            "primary_message": "Drain and rinse chickpeas; add to the baking sheet. ",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 233797,
            "primary_message": "Drizzle veggies and chickpeas with oil and sprinkle with spices. Toss to coat and spread out in an even layer. Place in the oven and roast, stirring halfway through, until fork-tender, about 25 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp paprika\n1 tsp garlic powder\n½ tsp coriander, ground\n½ tsp salt"
          },
          {
            "id": 233798,
            "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and spices; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water\n1 tsp turmeric, ground\n½ tsp paprika\n½ tsp salt"
          },
          {
            "id": 233799,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 233800,
            "primary_message": "While the rice cooks, juice lemon into a small bowl. Add yogurt, maple syrup, and spices to the bowl; whisk to combine the lemon yogurt.",
            "secondary_message": "⅔ cup plain Greek yogurt\n2 tsp pure maple syrup\n1 tsp garlic powder\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 233801,
            "primary_message": "Pick cilantro leaves off the stems; discard stems and mince the leaves. ",
            "secondary_message": null
          },
          {
            "id": 233802,
            "primary_message": "Add almonds and half the cilantro to the cooked rice; stir to combine the pilaf. (Reserve remaining cilantro for garnish.)",
            "secondary_message": "¼ cup almonds, sliced"
          },
          {
            "id": 233803,
            "primary_message": "To serve, divide rice pilaf, veggies, and chickpeas between bowls. Drizzle with lemon yogurt, sprinkle with reserved cilantro, and enjoy! ",
            "secondary_message": null
          }
        ],
