  "instructions": [
    {
      "id": 166735,
      "primary_message": "Preheat the oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 166736,
      "primary_message": "Peel and mince garlic; combine with chili garlic sauce, soy sauce, honey, and sesame oil in a small bowl; whisk to combine.",
      "secondary_message": "4 cloves garlic\n4 tsp chili-garlic sauce\n½ cup soy sauce\n2 tbsp honey\n2 tbsp toasted sesame oil"
    },
    {
      "id": 166737,
      "primary_message": "Place chicken in a baking dish, making sure to unroll the thigh pieces and lay them flat. Drizzle with half the marinade and place in the oven. Reserve the remaining, untouched marinade for later. Bake chicken until cooked through and golden, 20 minutes, flipping once halfway through.",
      "secondary_message": "1 ½ lb chicken thighs, boneless skinless"
    },
    {
      "id": 166738,
      "primary_message": "While chicken is cooking, wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 medium head napa cabbage\n2 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 166739,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 166740,
      "primary_message": "Peel and thinly slice onions into half rings.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 166741,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 166742,
      "primary_message": "Add onions to the skillet and stir-fry until tender, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 166743,
      "primary_message": "Peel and grate or julienne the carrots.",
      "secondary_message": null
    },
    {
      "id": 166744,
      "primary_message": "Add peas and carrots to the skillet with the onions and stir-fry, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 166745,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 166746,
      "primary_message": "Add cabbage and remaining marinade to skillet and stir-fry until cabbage is just wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 166747,
      "primary_message": "To serve, divide stir-fried vegetables between plates; top with chicken and sesame seeds. Enjoy!",
      "secondary_message": "¼ cup sesame seeds"
    }
  ],
