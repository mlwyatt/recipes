  "instructions": [
    {
      "id": 301694,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 301695,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 acorn squash\n2 Gala apples\n4 sticks celery"
    },
    {
      "id": 301696,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 301697,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 301698,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic. Place both in a small bowl.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 301699,
      "primary_message": "Quarter and core apples, then medium dice; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 301700,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301701,
      "primary_message": "While the skillet heats up, trim and small dice celery; add to the bowl with the veggies and apple.",
      "secondary_message": null
    },
    {
      "id": 301702,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, apple, pork, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb lean ground pork\n1 tsp salt\n1 tsp cinnamon, ground\n½ tsp nutmeg, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 301703,
      "primary_message": "When the pork is done, add broth, cranberries, and sugar; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and continue to cook, stirring occasionally, until slightly thickened, 2-3 minutes more. Cover and remove from heat.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n¼ cup dried cranberries\n4 tsp brown sugar"
    },
    {
      "id": 301704,
      "primary_message": "To serve, divide squash halves between plates and fill with the pork and veggie stuffing. Enjoy!",
      "secondary_message": null
    }
  ],
