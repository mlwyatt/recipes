  "instructions": [
    {
      "id": 277158,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n2 avocados\n1 lemon\n1 bunch radish"
    },
    {
      "id": 277159,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 277160,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 277161,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 277162,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 277163,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and set aside. ",
      "secondary_message": "1 ⅓ cup red lentils, dried"
    },
    {
      "id": 277164,
      "primary_message": "When the veggies have softened, add lentils, broth, tomatoes, and spices to the pot; stir to combine, cover, and bring to a boil over medium-high heat. Once boiling, reduce heat to a simmer, cover, and cook, stirring occasionally, until lentils are tender, 15-20 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes\n1 tbsp cumin, ground\n1 tbsp coriander, ground\n1 tbsp paprika\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 277165,
      "primary_message": "Meanwhile, halve and pit avocados. Scoop out the flesh and place in the reserved bowl; mash with a fork.",
      "secondary_message": null
    },
    {
      "id": 277166,
      "primary_message": "Peel and mince additional garlic; add to the bowl with the avocado.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 277167,
      "primary_message": "Juice half of the lemon into the bowl; add salt, stir to combine the guacamole, and set aside. (Reserve remaining lemon for the soup.)",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 277168,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Arrange bread slices on a baking sheet pan and place in the oven; broil until toasted, flipping halfway, 1-2 minutes. Remove from oven. ",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 277169,
      "primary_message": "Trim and small dice radishes.",
      "secondary_message": null
    },
    {
      "id": 277170,
      "primary_message": "Once the lentils are tender, juice remaining lemon into the pot and stir to combine the soup. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 277171,
      "primary_message": "Divide guacamole between toast slices and top with radish; season with salt and pepper.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 277172,
      "primary_message": "Divide soup between bowls and serve with guacamole-radish toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
