        "instructions": [
          {
            "id": 273227,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 273228,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 ½ lb sweet potatoes\n1 small bunch fresh dill\n1 lemon\n4 medium carrots\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 273229,
            "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 273230,
            "primary_message": "Place oil, sesame seeds, spices, and sugar in a large bowl; stir to combine the spice oil.",
            "secondary_message": "¼ cup extra virgin olive oil\n4 tsp sesame seeds\n1 tsp cumin, ground\n1 tsp coriander, ground\n1 tsp paprika\n1 tsp chili powder\n1 tsp salt\n½ tsp black pepper\n½ tsp brown sugar"
          },
          {
            "id": 273231,
            "primary_message": "Peel, trim, and slice sweet potatoes crosswise into ½-inch thick rounds. Add to the bowl with the spice oil along with chickpeas; using your hands, gently toss to coat. ",
            "secondary_message": null
          },
          {
            "id": 273232,
            "primary_message": "Transfer chickpeas and sweet potato to a large baking sheet pan, then spread out in a single layer. (Reserve bowl for later use.)",
            "secondary_message": null
          },
          {
            "id": 273233,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping sweet potato halfway through, until sweet potato is tender and chickpeas are crisp, about 20 minutes. Remove from oven. ",
            "secondary_message": null
          },
          {
            "id": 273234,
            "primary_message": "Meanwhile, wipe reserved bowl clean with paper towels. ",
            "secondary_message": null
          },
          {
            "id": 273235,
            "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in the bowl. ",
            "secondary_message": null
          },
          {
            "id": 273236,
            "primary_message": "Juice lemon into the bowl with the dill. ",
            "secondary_message": null
          },
          {
            "id": 273237,
            "primary_message": "Add feta, yogurt, mayo, water, salt, and pepper to the bowl; whisk to combine the dressing. (Add additional water, a few teaspoons at a time, if necessary, to reach a drizzling consistency.)",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese\n½ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tbsp water\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 273238,
            "primary_message": "Peel, trim, and julienne or coarsely grate carrots; add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 273239,
            "primary_message": "Roughly chop spinach, add to the bowl, and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 273240,
            "primary_message": "To serve, divide chickpeas, sweet potato, and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
