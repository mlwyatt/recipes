  "instructions": [
    {
      "id": 285595,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 small pkgs fresh basil\n2 medium carrots\n1 English cucumber\n1 avocado"
    },
    {
      "id": 285596,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 285597,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 285598,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, turkey, and spices; cook, breaking the turkey apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp toasted sesame oil\n1 ½ lb ground turkey\n1 tsp cumin, ground\n1 tsp turmeric, ground\n½ tsp coriander, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 285599,
      "primary_message": "Meanwhile, peel and mince ginger; place in a small bowl along with tahini, oil, vinegar, water, soy sauce, and maple syrup. Whisk to combine the sauce and set aside. ",
      "secondary_message": "¼ cup tahini\n2 tbsp toasted sesame oil\n2 tbsp rice vinegar\n2 tbsp water\n2 tbsp soy sauce\n1 tsp pure maple syrup"
    },
    {
      "id": 285600,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a large bowl (reserving a small amount for garnish).",
      "secondary_message": null
    },
    {
      "id": 285601,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the basil, along with broccoli slaw, and toss to combine.",
      "secondary_message": "2 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 285602,
      "primary_message": "Trim and thinly slice cucumber crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 285603,
      "primary_message": "Halve and pit avocado. Slice thinly while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 285604,
      "primary_message": "Divide slaw between bowls; top with turkey, cucumber, avocado, and reserved basil. Drizzle sauce over top and enjoy!",
      "secondary_message": null
    }
  ],
