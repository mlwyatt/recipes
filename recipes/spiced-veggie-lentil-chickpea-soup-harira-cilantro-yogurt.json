  "instructions": [
    {
      "id": 265619,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 lemon\n1 small bunch cilantro"
    },
    {
      "id": 265620,
      "primary_message": "Rinse chickpeas and lentils in a colander or strainer; set aside to drain. ",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n1 cup brown lentils, dried"
    },
    {
      "id": 265621,
      "primary_message": "Peel and small dice onion; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 265622,
      "primary_message": "Peel, trim, and small dice carrots; add to the bowl with onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 265623,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 265624,
      "primary_message": "While the pot heats up, trim and small dice celery; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 265625,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, carrot, celery, spices, and sugar to the pot; cook, stirring occasionally, until the veggies soften, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp cumin, ground\n2 tsp chili powder\n1 tsp turmeric, ground\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper\n½ tsp brown sugar"
    },
    {
      "id": 265626,
      "primary_message": "Add chickpeas, lentils, broth, and tomatoes to the pot; stir to combine, cover, and bring to a boil over medium-high heat.",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 265627,
      "primary_message": "Once the soup comes to a boil, reduce heat to a simmer and cover; cook, stirring occasionally, until lentils are tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 265628,
      "primary_message": "Meanwhile, juice lemon into the reserved bowl; add water, flour, and eggs. Whisk to combine the thickening liquid. ",
      "secondary_message": "1 cup water\n4 tsp all-purpose flour\n2 eggs"
    },
    {
      "id": 265629,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the thickening liquid and whisk to combine; set aside. (Reserve remaining cilantro for the next step.)",
      "secondary_message": null
    },
    {
      "id": 265630,
      "primary_message": "Place remaining cilantro in a small bowl. Add yogurt and water; stir to combine the cilantro yogurt and set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp water"
    },
    {
      "id": 265631,
      "primary_message": "When the lentils are tender, slowly pour the thickening liquid into the soup while gently stirring. Simmer until soup thickens, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 265632,
      "primary_message": "To serve, divide soup between bowls and top with cilantro yogurt. Enjoy! ",
      "secondary_message": null
    }
  ],
