  "instructions": [
    {
      "id": 319964,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 319965,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 baby bok choy\n2 (8 oz) pkg sugar snap peas\n2 (1 inch) pieces ginger root\n2 small bunches green onions (scallions)"
    },
    {
      "id": 319966,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 319967,
      "primary_message": "While the rice cooks, place broth, chili-garlic sauce, soy sauce, vinegar, sugar, and cornstarch in a small bowl; whisk to combine the sauce and set aside. ",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp chili-garlic sauce\n2 tbsp soy sauce\n4 tsp rice vinegar\n2 tsp brown sugar\n2 tsp cornstarch"
    },
    {
      "id": 319968,
      "primary_message": "Trim and cut bok choy crosswise into 1-inch strips; place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 319969,
      "primary_message": "Halve snap peas crosswise and add to the bowl with the bok choy; set aside. ",
      "secondary_message": null
    },
    {
      "id": 319970,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 319971,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp toasted sesame oil\n1 ½ lb lean ground pork"
    },
    {
      "id": 319972,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Add both to the bowl with the veggies. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 319973,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 319974,
      "primary_message": "When the pork is done, add veggies, ginger, garlic, salt, and pepper to the skillet; stir-fry until veggies soften, about 3 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 319975,
      "primary_message": "Add sauce to the skillet and continue to cook, stirring occasionally, until sauce thickens, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 319976,
      "primary_message": "To serve, divide rice and stir-fry between plates; sprinkle with reserved green onion and enjoy! ",
      "secondary_message": null
    }
  ],
