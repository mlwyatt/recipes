  "instructions": [
    {
      "id": 268619,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz penne pasta"
    },
    {
      "id": 268620,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n½ lb white mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 268621,
      "primary_message": "Trim and small dice eggplants; quarter mushrooms. Transfer both to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 268622,
      "primary_message": "Small dice bacon. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 268623,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 268624,
      "primary_message": "Once the pot is hot, add the bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate, leaving the drippings in the pot.",
      "secondary_message": null
    },
    {
      "id": 268625,
      "primary_message": "While the bacon cooks, using a clean cutting board, peel and mince onion and garlic. ",
      "secondary_message": "½ medium red onion\n4 cloves garlic"
    },
    {
      "id": 268626,
      "primary_message": "Return the pot (with bacon drippings) to medium heat. Once the pot is hot, add eggplant, mushrooms, onion, garlic, and salt; cook, stirring occasionally, until eggplant and mushrooms are soft and golden, 8-10 minutes. ",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 268627,
      "primary_message": "When the pasta is done, drain in a colander and return to the pot; cover and set aside. ",
      "secondary_message": null
    },
    {
      "id": 268628,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 268629,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 268630,
      "primary_message": "When the veggies are done, add tomato sauce and spices to pot. Stir to combine the veggie sauce and bring to a simmer; cook, stirring occasionally, until warmed through, about 3 minutes.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n½ tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 268631,
      "primary_message": "Add veggie sauce, bacon, and half of the parsley (reserving the rest for garnish) to the pot with the pasta; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 268632,
      "primary_message": "To serve, divide pasta between plates or bowls; top with reserved parsley, additional crushed red pepper, and Parmesan. Enjoy! ",
      "secondary_message": "½ tsp crushed red pepper"
    }
  ],
