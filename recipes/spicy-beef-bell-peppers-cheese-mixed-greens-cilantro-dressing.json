        "instructions": [
          {
            "id": 251754,
            "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
            "secondary_message": null
          },
          {
            "id": 251755,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "4 green bell peppers\n2 red chili peppers\n1 small bunch cilantro\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 251756,
            "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 251757,
            "primary_message": "Place baking sheet in the oven and broil until peppers are tender and charred, 5-6 minutes. Remove from oven and set aside to cool.",
            "secondary_message": null
          },
          {
            "id": 251758,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 251759,
            "primary_message": "While the skillet heats up, quarter chili peppers lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 251760,
            "primary_message": "Once the skillet is hot, add the ground beef and chili pepper; cook, breaking the meat apart with a spoon, until the beef is browned and cooked through, 3-4 minutes.",
            "secondary_message": "1 ½ lb lean ground beef"
          },
          {
            "id": 251761,
            "primary_message": "While the beef is cooking, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl and set aside (reserve remaining cilantro for the next step).",
            "secondary_message": null
          },
          {
            "id": 251762,
            "primary_message": "Add reserved cilantro and spices to the skillet with the beef; stir to combine and remove from the heat.",
            "secondary_message": "2 tsp chili powder\n1 tsp paprika\n1 tsp cumin, ground\n½ tsp garlic powder\n½ tsp salt"
          },
          {
            "id": 251763,
            "primary_message": "Coarsely grate mozzarella.",
            "secondary_message": "1 (8 oz) block mozzarella cheese"
          },
          {
            "id": 251764,
            "primary_message": "Divide beef mixture between pepper halves and top with cheese. Return baking sheet to the oven and broil until cheese is melted and bubbly, 2-3 minutes.",
            "secondary_message": null
          },
          {
            "id": 251765,
            "primary_message": "Meanwhile, add oil, vinegar, and spices to the bowl with the cilantro; stir to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp balsamic vinegar\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 251766,
            "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 251767,
            "primary_message": "To serve, divide stuffed peppers and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
