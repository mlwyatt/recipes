  "instructions": [
    {
      "id": 300191,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 yellow bell peppers\n2 jalapeño peppers\n1 small bunch cilantro\n1 tomato\n1 lime"
    },
    {
      "id": 300192,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300193,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 300194,
      "primary_message": "Once the skillet is hot, add ground beef and spices. Cook, breaking the meat apart with a spoon, until the beef is browned and no longer pink, 4-5 minutes. Stir in the garlic, then remove skillet from the heat. ",
      "secondary_message": "1 ½ lb lean ground beef\n4 tsp cumin, ground\n4 tsp chili powder\n1 tsp salt"
    },
    {
      "id": 300195,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Slice each quarter crosswise into 3 or 4 pieces to make the \"chips.\"",
      "secondary_message": null
    },
    {
      "id": 300196,
      "primary_message": "Line a large baking sheet with aluminum foil. Place bell pepper pieces, skin-side down, in a single layer on the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 300197,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 300198,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 300199,
      "primary_message": "Thinly slice jalapeños into rounds. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 300200,
      "primary_message": "Top the bell pepper with an even layer of ground beef, cheese, and jalapeños. ",
      "secondary_message": null
    },
    {
      "id": 300201,
      "primary_message": "Place the baking sheet in the oven; cook until cheese is melted and bubbly, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 300202,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 300203,
      "primary_message": "Small dice the tomato. Cut the lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 300204,
      "primary_message": "To serve, divide the nachos between plates. Garnish with cilantro, tomatoes, and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
