        "instructions": [
          {
            "id": 412844,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 412845,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head cauliflower\n1 small bunch green onions (scallions)\n2 small bunches cilantro\n2 limes\n1 avocado"
          },
          {
            "id": 412846,
            "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 412847,
            "primary_message": "Trim and thinly slice green onions crosswise. Add half to the bowl with the cauliflower. (Place remaining onions on a plate and set aside.)",
            "secondary_message": null
          },
          {
            "id": 412848,
            "primary_message": "Add oil and spices to the bowl, then stir to combine. Transfer cauliflower rice to a large baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp cumin, ground\n½ tsp crushed red pepper\n½ tsp salt"
          },
          {
            "id": 412849,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until rice is tender and golden, 15-18 minutes.",
            "secondary_message": null
          },
          {
            "id": 412850,
            "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Place half in the reserved bowl. (Add remaining cilantro to the plate with the onions.)",
            "secondary_message": null
          },
          {
            "id": 412851,
            "primary_message": "Juice one lime into the bowl with the cilantro. Cut remaining lime into wedges and add to the plate.",
            "secondary_message": null
          },
          {
            "id": 412852,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 412853,
            "primary_message": "While the skillet heats up, drain and rinse beans in a colander. ",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 412854,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beans, corn, and spices; cook, stirring occasionally, until beans and corn are warmed through and spices are fragrant, 3-5 minutes. Remove from heat, add feta, and stir to combine.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 cups frozen corn\n1 tbsp chili powder\n1 tsp cumin, ground\n1 tsp salt\n½ tsp crushed red pepper\n1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 412855,
            "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh. Slice crosswise into thin pieces. Add to the plate.",
            "secondary_message": null
          },
          {
            "id": 412856,
            "primary_message": "When the cauliflower is done, remove from the oven. Add lime and cilantro mixture, then stir to combine. ",
            "secondary_message": null
          },
          {
            "id": 412857,
            "primary_message": "Divide cauliflower rice between bowls; top with spicy bean sauté, reserved cilantro, green onions, and avocado. Serve with lime wedges for squeezing and enjoy!",
            "secondary_message": null
          }
        ],
