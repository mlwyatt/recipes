        "instructions": [
          {
            "id": 318003,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb new potatoes\n2 (1 inch) pieces ginger root\n2 orange bell peppers\n2 medium zucchini squash\n2 jalapeño peppers\n1 small bunch cilantro"
          },
          {
            "id": 318004,
            "primary_message": "Halve potatoes, place in a large pot, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until potatoes are fork-tender, 10-15 minutes.",
            "secondary_message": null
          },
          {
            "id": 318005,
            "primary_message": "Meanwhile, peel and mince ginger and garlic; place both in a large bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 318006,
            "primary_message": "Peel, halve, and medium dice onion; add to the bowl with the ginger and garlic.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 318007,
            "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 318008,
            "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 318009,
            "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 318010,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 318011,
            "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels. Cut into bite-sized pieces.",
            "secondary_message": "2 lb chicken thighs, boneless skinless"
          },
          {
            "id": 318012,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and chicken; cook, stirring occasionally, until chicken is golden brown and almost cooked through, 6-7 minutes. ",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 318013,
            "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 318014,
            "primary_message": "When the chicken is done, add half of the cilantro (reserving the rest for garnish), tomatoes, pine nuts, and spices to the skillet; stir to combine. Continue to cook, stirring occasionally, until sauce thickens, 3-4 minutes more.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n¼ cup pine nuts\n1 tsp coriander, ground\n1 tsp turmeric, ground\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp crushed red pepper"
          },
          {
            "id": 318015,
            "primary_message": "When the potatoes are done, drain and add to the skillet; stir to combine and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 318016,
            "primary_message": "To serve, divide the chicken skillet between plates or bowls and top with reserved cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
