  "instructions": [
    {
      "id": 427622,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 427623,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 427624,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 427625,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 427626,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Add to the bowl with the other veggies along with the carrots.",
      "secondary_message": "1 medium yellow onion\n1 (10 oz) bag shredded carrots"
    },
    {
      "id": 427627,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, chicken, Cajun seasoning, and salt. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 lb ground chicken\n3 tbsp Cajun seasoning\n½ tsp salt"
    },
    {
      "id": 427628,
      "primary_message": "Add water, tomato sauce, and pasta to the pot. Stir to combine, cover, and bring to a boil. Once boiling, reduce heat to medium-low and simmer (while covered) until pasta is tender and the liquid is mostly absorbed, 8-10 minutes.",
      "secondary_message": "2 cup water\n2 (8 oz) cans tomato sauce\n10 oz macaroni (elbow) pasta"
    },
    {
      "id": 427629,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 427630,
      "primary_message": "When the pasta is done, add parsley, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 427631,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with cheese. Enjoy!",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
