  "instructions": [
    {
      "id": 230932,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 230933,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 medium carrots\n1 small pkg fresh mint\n1 lime\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 230934,
      "primary_message": "Peel, trim, and slice carrots into ¼-inch thick rounds. Place in a large bowl along with maple syrup, oil, and salt; toss to coat.",
      "secondary_message": "4 tsp pure maple syrup\n2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 230935,
      "primary_message": "Transfer carrots to a large baking sheet pan and spread out in a single layer. Place in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until fork-tender, about 12 minutes. Remove from oven and set aside to cool. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 230936,
      "primary_message": "While the carrots are roasting, arrange flatbreads on another large baking sheet. Add to the oven and bake, flipping halfway through, until slightly crispy, about 8 minutes. Remove from the oven and set aside to cool.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 230937,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place in a small bowl along with yogurt and salt; stir to combine and set aside.",
      "secondary_message": "1 ⅓ cups plain Greek yogurt\n¼ tsp salt"
    },
    {
      "id": 230938,
      "primary_message": "Peel and mince the garlic. Transfer to the reserved bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 230939,
      "primary_message": "Juice lime into the bowl with the garlic; add oil, maple syrup, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 230940,
      "primary_message": "Thinly slice apricots and add to the bowl with the dressing.",
      "secondary_message": "12 dried apricots"
    },
    {
      "id": 230941,
      "primary_message": "Roughly chop almonds and set aside.",
      "secondary_message": "¼ cup almonds"
    },
    {
      "id": 230942,
      "primary_message": "Once the carrots have cooled to room temperature, transfer to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 230943,
      "primary_message": "Add arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 230944,
      "primary_message": "Divide minted yogurt between flatbreads and spread out in an even layer. Top each flatbread with carrot-arugula salad and slice into wedges.",
      "secondary_message": null
    },
    {
      "id": 230945,
      "primary_message": "To serve, divide flatbreads between plates. Sprinkle with almonds and drizzle with vinegar. Enjoy!",
      "secondary_message": "4 tsp balsamic vinegar"
    }
  ],
