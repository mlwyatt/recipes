        "instructions": [
          {
            "id": 365797,
            "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a large bowl.",
            "secondary_message": "2 bunches kale"
          },
          {
            "id": 365798,
            "primary_message": "Peel and thinly slice garlic. Add to the bowl with the kale and set aside.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 365799,
            "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Place half in a small bowl. (Set remaining basil aside for serving.)",
            "secondary_message": "1 small pkg fresh basil"
          },
          {
            "id": 365800,
            "primary_message": "Add tomato sauce, Italian seasoning, and crushed red pepper to the bowl with the basil. Stir to combine the sauce and set aside.",
            "secondary_message": "2 (8 oz) cans tomato sauce\n1 tsp Italian seasoning\n½ tsp crushed red pepper"
          },
          {
            "id": 365801,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 365802,
            "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 365803,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken cutlets and pan-fry until golden and cooked through, 3-4 minutes per side.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 365804,
            "primary_message": "While the cutlets are cooking, preheat oven to broil on high and position rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 365805,
            "primary_message": "Coarsely grate cheeses into a medium bowl and stir to combine.",
            "secondary_message": "1 (8 oz) block mozzarella cheese\n3 oz Parmesan cheese"
          },
          {
            "id": 365806,
            "primary_message": "When the cutlets are done, transfer to a large baking dish. Pour tomato sauce over chicken and top with cheeses. (Reserve skillet for later use.)",
            "secondary_message": null
          },
          {
            "id": 365807,
            "primary_message": "Place baking dish in the oven and broil until the sauce is warmed through and cheese is melted, 2-3 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 365808,
            "primary_message": "Meanwhile, wipe the skillet clean with paper towels, then return to medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 365809,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and kale to the skillet in handfuls, waiting for kale to wilt slightly before adding the next handful. Season with crushed red pepper and salt. Continue to cook, stirring frequently, until the kale is tender, 1-2 minutes more.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp crushed red pepper\n¼ tsp salt"
          },
          {
            "id": 365810,
            "primary_message": "Remove skillet from the heat, add vinegar, and stir to combine.",
            "secondary_message": "2 tsp balsamic vinegar"
          },
          {
            "id": 365811,
            "primary_message": "To serve, divide the chicken, sauce, and kale between plates. Top chicken with reserved basil. Enjoy!",
            "secondary_message": null
          }
        ],
