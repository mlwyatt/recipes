        "instructions": [
          {
            "id": 239150,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 239151,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 jalapeño pepper\n2 limes\n1 small bunch cilantro\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 239152,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes. ",
            "secondary_message": null
          },
          {
            "id": 239153,
            "primary_message": "While the rice is cooking, peel and mince garlic and ginger; place in a small bowl. ",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 239154,
            "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the garlic and ginger; set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 239155,
            "primary_message": "Preheat another medium saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 239156,
            "primary_message": "While the pan heats up, peel and small dice onion. ",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 239157,
            "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, 3-4 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 239158,
            "primary_message": "Meanwhile, drain and rinse chickpeas in a colander. Set aside to drain further. ",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 239159,
            "primary_message": "Add garlic, ginger, jalapeño, and spices to the pan with the onion. Continue to cook, stirring constantly, until fragrant, 1-2 minutes. (Reserve bowl for later use.)",
            "secondary_message": "2 tsp cumin, ground\n2 tsp coriander, ground\n2 tsp curry powder\n1 tsp salt\n½ tsp black pepper\n⅛ tsp turmeric, ground\n⅛ tsp chili powder"
          },
          {
            "id": 239160,
            "primary_message": "Add chickpeas, broth, and diced tomatoes to the pan; stir to combine and bring to a boil over medium-high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until chickpeas are soft and stew has thickened, 15-20 minutes.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes"
          },
          {
            "id": 239161,
            "primary_message": "While the stew cooks, juice one lime into the reserved bowl. Cut remaining lime into wedges and set aside for serving. ",
            "secondary_message": null
          },
          {
            "id": 239162,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice along with yogurt, salt, and pepper; whisk to combine the raita. ",
            "secondary_message": "1 cup plain Greek yogurt\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 239163,
            "primary_message": "When the stew is done, add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
            "secondary_message": null
          },
          {
            "id": 239164,
            "primary_message": "Divide rice and chickpea stew between bowls; serve with lime wedges and raita on the side. Enjoy! ",
            "secondary_message": null
          }
        ],
