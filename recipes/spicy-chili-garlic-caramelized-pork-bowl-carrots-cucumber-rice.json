        "instructions": [
          {
            "id": 368193,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 368194,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 368195,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 English cucumber\n2 medium carrots"
          },
          {
            "id": 368196,
            "primary_message": "Peel and mince garlic and ginger.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 368197,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 368198,
            "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces; place in a small bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 368199,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, ginger, chili-garlic sauce, and salt; cook, stirring occasionally, until fragrant, about 1 minute.",
            "secondary_message": "2 tsp extra virgin olive oil\n2 tsp chili-garlic sauce\n½ tsp salt"
          },
          {
            "id": 368200,
            "primary_message": "Add pork to the skillet and cook, breaking apart with a spoon, until the pork begins to brown, 3-4 minutes.",
            "secondary_message": "1 ½ lb lean ground pork"
          },
          {
            "id": 368201,
            "primary_message": "Add sugar and fish sauce to the skillet with the pork, stir to combine, and continue to cook, undisturbed, for 5 minutes.",
            "secondary_message": "¼ cup brown sugar\n4 tsp fish sauce"
          },
          {
            "id": 368202,
            "primary_message": "Meanwhile, trim, halve lengthwise, and cut cucumber crosswise into thin half-moons.",
            "secondary_message": null
          },
          {
            "id": 368203,
            "primary_message": "Stir the pork, then continue to cook, undisturbed, until the sugar begins to caramelize and the pork becomes dark brown, 4-5 minutes more. Remove from heat and stir in half of the green onions (reserving the rest for garnish).",
            "secondary_message": null
          },
          {
            "id": 368204,
            "primary_message": "While the pork finishes cooking, peel and trim the carrots; using the peeler, run it along the carrots to make long, noodle-like strips. Roughly chop into bite-sized pieces.",
            "secondary_message": null
          },
          {
            "id": 368205,
            "primary_message": "To serve, divide rice between bowls. Top with pork, cucumbers, carrots, and remaining green onions. Enjoy!",
            "secondary_message": null
          }
        ],
