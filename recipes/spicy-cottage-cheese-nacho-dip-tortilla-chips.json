        "instructions": [
          {
            "id": 484091,
            "primary_message": "Peel garlic and place in a blender.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 484092,
            "primary_message": "Wash, dry, and juice lime into the blender.",
            "secondary_message": "1 lime"
          },
          {
            "id": 484093,
            "primary_message": "Add cottage cheese, shredded cheese, salsa, and chili powder to the blender. Blend on high for several minutes until smooth, scraping down the sides of the blender as needed. Add water, 1 tablespoon at a time, if needed, to reach desired consistency.",
            "secondary_message": "1 ½ cups cottage cheese\n⅔ cup shredded cheese, Mexican blend\n1 cup salsa\n1 ½ tsp chili powder"
          },
          {
            "id": 484094,
            "primary_message": "Divide dip between bowls and serve with tortilla chips on the side. Enjoy!",
            "secondary_message": "4 oz tortilla chips"
          }
        ],
