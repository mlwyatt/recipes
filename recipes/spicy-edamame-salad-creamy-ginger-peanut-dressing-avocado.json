        "instructions": [
          {
            "id": 217958,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 217959,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 English cucumber\n2 red chili peppers\n2 avocados\n1 head romaine lettuce"
          },
          {
            "id": 217960,
            "primary_message": "Once the water in the pot is boiling, add edamame and cook until tender, 5-7 minutes. Drain and rinse under cold water. Set aside to drain further.",
            "secondary_message": "4 cups edamame"
          },
          {
            "id": 217961,
            "primary_message": "Meanwhile, peel and mince or grate ginger; transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 217962,
            "primary_message": "Add peanut butter, water, soy sauce, vinegar, and chili-garlic sauce to the bowl with the ginger; whisk to combine the dressing.",
            "secondary_message": "3 tbsp natural peanut butter\n2 tbsp water\n2 tbsp soy sauce\n2 tbsp rice vinegar\n2 tsp chili-garlic sauce"
          },
          {
            "id": 217963,
            "primary_message": "Trim and slice cucumber into thin rounds; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 217964,
            "primary_message": "Quarter chili peppers lengthwise; seed and remove ribs with a spoon. Thinly slice and add to the bowl. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 217965,
            "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 217966,
            "primary_message": "Cut romaine crosswise into thin (shred-like) strips; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 217967,
            "primary_message": "Add edamame to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 217968,
            "primary_message": "Roughly chop peanuts.",
            "secondary_message": "½ cup peanuts, roasted unsalted"
          },
          {
            "id": 217969,
            "primary_message": "To serve, divide salad between plates or bowls, top with peanuts, and enjoy!",
            "secondary_message": null
          }
        ],
