        "instructions": [
          {
            "id": 368423,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
          },
          {
            "id": 368424,
            "primary_message": "Meanwhile, peel, halve, and thinly slice onion lengthwise. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 368425,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 368426,
            "primary_message": "While the skillet heats up, wash, dry, and mince ginger.",
            "secondary_message": "2 (1 inch) pieces ginger root"
          },
          {
            "id": 368427,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, ginger, and chicken; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
            "secondary_message": "4 tsp toasted sesame oil\n1 lb ground chicken"
          },
          {
            "id": 368428,
            "primary_message": "Meanwhile, wash, dry, and trim bok choy; cut crosswise into strips.",
            "secondary_message": "6 baby bok choy"
          },
          {
            "id": 368429,
            "primary_message": "When the chicken is done, add bok choy, carrots, stir-fry sauce, and chili-garlic sauce to the skillet. Cook, stirring occasionally, until the veggies have softened, 3-4 minutes.",
            "secondary_message": "1 (10 oz) bag shredded carrots\n⅔ cup stir-fry sauce\n4 tsp chili-garlic sauce"
          },
          {
            "id": 368430,
            "primary_message": "When the pasta is done, drain in a colander. Add to the skillet, stir to combine, and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 368431,
            "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
