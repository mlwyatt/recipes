  "instructions": [
    {
      "id": 489940,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 jalapeño peppers\n1 English cucumber\n2 tomatoes\n½ small bunch cilantro"
    },
    {
      "id": 489941,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans kidney beans"
    },
    {
      "id": 489942,
      "primary_message": "Juice limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 489943,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lime juice along with oil, maple syrup, sesame seeds, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n4 tsp pure maple syrup\n4 tsp sesame seeds\n2 tsp garam masala\n1 tsp salt\n½ tsp cumin, ground"
    },
    {
      "id": 489944,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 489945,
      "primary_message": "Trim and small dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 489946,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 489947,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the beans. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 489948,
      "primary_message": "To serve, divide bean salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
