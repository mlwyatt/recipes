        "instructions": [
          {
            "id": 115235,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n2 cup water"
          },
          {
            "id": 115236,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n2 oranges\n2 crowns broccoli\n1 small bunch green onions (scallions)"
          },
          {
            "id": 115237,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes.",
            "secondary_message": null
          },
          {
            "id": 115238,
            "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Set both aside in a small bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 115239,
            "primary_message": "Use a grater to zest the oranges and transfer to the bowl with the garlic and ginger. Juice the orange into a separate small bowl.",
            "secondary_message": null
          },
          {
            "id": 115240,
            "primary_message": "Heat the oil in a small saucepan over medium-low heat. Once the oil is hot, add the garlic, ginger, orange zest, and chili-garlic sauce. Sauté until ingredients soften, 2-3 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil\n2 tsp chili-garlic sauce"
          },
          {
            "id": 115241,
            "primary_message": "Add orange juice, brown sugar, rice vinegar, and soy sauce to the saucepan. Bring to a boil, then lower the heat and simmer, uncovered and stirring occasionally, until sauce thickens and reduces by half, about 10 minutes.",
            "secondary_message": "2 tbsp brown sugar\n½ cup rice vinegar\n½ cup soy sauce"
          },
          {
            "id": 115242,
            "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 115243,
            "primary_message": "Slice the steak against the grain into ½-inch strips.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak"
          },
          {
            "id": 115244,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 115245,
            "primary_message": "Add the beef to the skillet and cook, without stirring, for 1 minute. Then turn the beef pieces over and cook, stirring occasionally, 2-3 minutes for medium-rare. Transfer beef to a plate and set aside.",
            "secondary_message": null
          },
          {
            "id": 115246,
            "primary_message": "Meanwhile, separate broccoli into bite-sized florets. Return the skillet to medium heat and add the broccoli. Stir-fry until tender-crisp, about 7 minutes.",
            "secondary_message": null
          },
          {
            "id": 115247,
            "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
            "secondary_message": null
          },
          {
            "id": 115248,
            "primary_message": "Add the beef back into the skillet with the broccoli. Add green onions and orange sauce to the skillet and stir well.",
            "secondary_message": null
          },
          {
            "id": 115249,
            "primary_message": "To serve, divide the rice into bowls and top with the beef and veggie mixture. Enjoy!",
            "secondary_message": null
          }
        ],
