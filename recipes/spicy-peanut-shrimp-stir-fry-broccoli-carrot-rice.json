        "instructions": [
          {
            "id": 366173,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 366174,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 366175,
            "primary_message": "Meanwhile, place peanut sauce, water, and chili-garlic sauce in a medium bowl. Stir to combine the sauce and set aside.",
            "secondary_message": "½ cup peanut sauce\n¼ cup water\n4 tsp chili-garlic sauce"
          },
          {
            "id": 366176,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 366177,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 366178,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp and stir-fry until just cooked through, 2-3 minutes. Transfer cooked shrimp to the bowl with the sauce and set aside. (Reserve skillet for later use.)",
            "secondary_message": "4 tsp virgin coconut oil"
          },
          {
            "id": 366179,
            "primary_message": "Meanwhile, peel, halve, and slice onion lengthwise into thin strips. Peel and mince garlic.",
            "secondary_message": "1 medium red onion\n4 cloves garlic"
          },
          {
            "id": 366180,
            "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add onion, garlic, broccoli, carrots, salt, and pepper. Stir-fry until the broccoli is fork-tender, 4-5 minutes.",
            "secondary_message": "4 tsp virgin coconut oil\n1 (18 oz) bag broccoli florets\n1 (10 oz) bag shredded carrots\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 366181,
            "primary_message": "When the broccoli is done, return shrimp and sauce to the skillet, then stir to combine. Continue to cook, stirring occasionally, until warmed through, 1-2 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 366182,
            "primary_message": "Meanwhile, roughly chop peanuts.",
            "secondary_message": "½ cup peanuts, roasted unsalted"
          },
          {
            "id": 366183,
            "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Sprinkle with peanuts and enjoy!",
            "secondary_message": null
          }
        ],
