        "instructions": [
          {
            "id": 242554,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 242555,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 lb cremini mushrooms\n2 jalapeño peppers\n2 orange bell peppers\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 242556,
            "primary_message": "Thinly slice mushrooms and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 242557,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 242558,
            "primary_message": "While the skillet heats up, slice the sausages crosswise into ½-inch thick rounds.",
            "secondary_message": "4 pork sausages"
          },
          {
            "id": 242559,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until starting to brown, about 4 minutes. Use a slotted spoon to transfer the sausage to a plate (the sausage will not be cooked all the way through).",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 242560,
            "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic; peel and medium dice onion. Add both to the bowl with the mushrooms.",
            "secondary_message": "2 cloves garlic\n1 medium yellow onion"
          },
          {
            "id": 242561,
            "primary_message": "Return skillet (with cooking juices) to medium-high heat; add veggies and Italian seasoning. Cook, stirring occasionally, until the mushrooms have softened, about 6 minutes. (Reserve bowl for the next step.)",
            "secondary_message": "2 tsp Italian seasoning"
          },
          {
            "id": 242562,
            "primary_message": "While the mushrooms are cooking, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and place in the reserved bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 242563,
            "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the jalapeño.",
            "secondary_message": null
          },
          {
            "id": 242564,
            "primary_message": "Add jalapeño, bell pepper, browned sausage, salt, and pepper to the skillet; cook, stirring occasionally, until the bell pepper starts to soften and sausage is cooked through, about 4 minutes.",
            "secondary_message": "1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 242565,
            "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
            "secondary_message": null
          },
          {
            "id": 242566,
            "primary_message": "To serve, divide quinoa, sausage, and veggies between bowls. Enjoy!",
            "secondary_message": null
          }
        ],
