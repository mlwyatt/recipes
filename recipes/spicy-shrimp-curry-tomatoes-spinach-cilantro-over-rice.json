        "instructions": [
          {
            "id": 275713,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 275714,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes. ",
            "secondary_message": null
          },
          {
            "id": 275715,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "6 tomatoes\n2 (1 inch) pieces ginger root\n1 lime\n1 small bunch cilantro\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 275716,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 275717,
            "primary_message": "Small dice tomatoes; place in a medium bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 275718,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 275719,
            "primary_message": "While the pot heats up, peel, halve, and small dice onion. ",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 275720,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until softened, about 3 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 275721,
            "primary_message": "While the onion cooks, peel and mince ginger and garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 275722,
            "primary_message": "Add ginger, garlic, sugar, and spices to the pot with the onion. Continue to cook, stirring constantly, until fragrant, about 1 minute.",
            "secondary_message": "2 tsp brown sugar\n2 tsp curry powder\n2 tsp chili powder\n2 tsp coriander, ground\n2 tsp cumin, ground\n1 ½ tsp salt\n1 tsp black pepper\n1 tsp turmeric, ground"
          },
          {
            "id": 275723,
            "primary_message": "Add tomatoes, coconut milk, and broth to the pot; stir to combine the curry and bring to a boil over medium-high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until slightly thickened, about 8 minutes.",
            "secondary_message": "1 (13.5 fl oz) can coconut milk\n8 fl oz (1 cup) chicken or vegetable broth"
          },
          {
            "id": 275724,
            "primary_message": "While the curry cooks, cut lime into wedges and set aside for serving. ",
            "secondary_message": null
          },
          {
            "id": 275725,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. ",
            "secondary_message": null
          },
          {
            "id": 275726,
            "primary_message": "Once the curry has thickened, add shrimp and half of the cilantro (reserving the rest for garnish) to the pot; stir to combine. Return to a simmer and cook, stirring occasionally, until the shrimp are cooked through, 3-4 minutes. ",
            "secondary_message": null
          },
          {
            "id": 275727,
            "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful; stir to combine.",
            "secondary_message": null
          },
          {
            "id": 275728,
            "primary_message": "Divide rice and shrimp curry between bowls; sprinkle with reserved cilantro and serve with lime wedges. Enjoy!",
            "secondary_message": null
          }
        ],
