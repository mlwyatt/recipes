  "instructions": [
    {
      "id": 157348,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 lb sweet potato\n1 small bunch cilantro"
    },
    {
      "id": 157349,
      "primary_message": "Peel and small dice onion. Small dice bell peppers. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 157350,
      "primary_message": "Heat a large pot over medium heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 157351,
      "primary_message": "Add onions and bell peppers to the pot; cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 157352,
      "primary_message": "Peel and small dice sweet potatoes.",
      "secondary_message": null
    },
    {
      "id": 157353,
      "primary_message": "Add sweet potatoes and broth to the pot and bring to a boil; reduce heat and simmer, 10-12 minutes, until potatoes are fork-tender.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth"
    },
    {
      "id": 157354,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 157355,
      "primary_message": "Grate cheddar. Shave cilantro leaves off the stems; discard stems and mince leaves.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 157356,
      "primary_message": "Once potatoes are tender, drain vegetables; return them to the pot and place on low heat.",
      "secondary_message": null
    },
    {
      "id": 157357,
      "primary_message": "Add beans, cheddar, cilantro, yogurt, and spices to the pot. Stir to combine and remove from the heat.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp chili powder\n1 ½ tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp cumin\n½ tsp cayenne pepper"
    },
    {
      "id": 157358,
      "primary_message": "Lay tortillas on a flat surface. Divide vegetable mixture evenly and place in the middle of each tortilla. Fold in sides of the tortilla and roll tightly.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 157359,
      "primary_message": "Heat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 157360,
      "primary_message": "Lay burritos seam side down and cook for 2-3 minutes on each side, until golden brown and crispy. ",
      "secondary_message": null
    },
    {
      "id": 157361,
      "primary_message": "Remove burritos from heat, cut in half, and enjoy!",
      "secondary_message": null
    }
  ],
