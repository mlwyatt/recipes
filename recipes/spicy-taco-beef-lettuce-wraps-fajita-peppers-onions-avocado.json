  "instructions": [
    {
      "id": 384891,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 yellow bell peppers\n2 green bell peppers\n1 lime\n2 avocados\n1 head butter (Boston) lettuce"
    },
    {
      "id": 384892,
      "primary_message": "Peel, halve, and small dice onion. Place in a medium bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 384893,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 384894,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384895,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the beef and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb lean ground beef"
    },
    {
      "id": 384896,
      "primary_message": "When the beef is done, add onion, bell pepper, and spices to the skillet. Continue to cook, stirring occasionally, until veggies start to soften, 3-4 minutes more.",
      "secondary_message": "2 tbsp chili powder\n2 tsp oregano, dried\n1 tsp salt\n½ tsp garlic powder\n¼ tsp crushed red pepper"
    },
    {
      "id": 384897,
      "primary_message": "While the veggies are cooking, cut lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 384898,
      "primary_message": "When the veggies are soft, add water to the skillet. Cook, stirring occasionally, until sauce is thickened, 1-2 minutes. Remove from heat.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 384899,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 384900,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with beef, veggies, and avocado. Serve with lime wedges and enjoy! ",
      "secondary_message": null
    }
  ],
