        "instructions": [
          {
            "id": 136669,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n2 cup water"
          },
          {
            "id": 136670,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 jalapeño peppers\n2 (5 oz) pkgs baby spinach\n4 small pkgs fresh basil"
          },
          {
            "id": 136671,
            "primary_message": "In a medium bowl, combine the broth, soy sauce, fish sauce, and brown sugar. Whisk to combine the sauce and set aside.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n¼ cup soy sauce\n4 tsp fish sauce\n4 tsp brown sugar"
          },
          {
            "id": 136672,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 136673,
            "primary_message": "Roughly chop the chicken thighs into ½-inch pieces.",
            "secondary_message": "1 ½ lb chicken thighs, boneless skinless"
          },
          {
            "id": 136674,
            "primary_message": "Peel and mince the garlic and shallot. Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely dice and set aside. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
            "secondary_message": "4 cloves garlic\n2 shallots"
          },
          {
            "id": 136675,
            "primary_message": "Heat a large skillet over high heat. ",
            "secondary_message": null
          },
          {
            "id": 136676,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "¼ cup extra virgin olive oil"
          },
          {
            "id": 136677,
            "primary_message": "Add chicken and stir-fry for 3-4 minutes, then add the garlic, shallot, and jalapeño. Continue cooking on high heat for 3-4 more minutes, stirring often. ",
            "secondary_message": null
          },
          {
            "id": 136678,
            "primary_message": "Chop the baby spinach into small pieces. ",
            "secondary_message": null
          },
          {
            "id": 136679,
            "primary_message": "Pour the sauce into the skillet. Cook on high, stirring often, until the sauce thickens and glazes the meat, 8-12 minutes. Remove from heat. ",
            "secondary_message": null
          },
          {
            "id": 136680,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Reserve a few leaves for garnish. ",
            "secondary_message": null
          },
          {
            "id": 136681,
            "primary_message": "Add the baby spinach (one handful at a time) and basil to the skillet and stir until wilted. ",
            "secondary_message": null
          },
          {
            "id": 136682,
            "primary_message": "To serve, divide the rice and chicken between bowls. Garnish with reserved basil and enjoy!",
            "secondary_message": null
          }
        ],
