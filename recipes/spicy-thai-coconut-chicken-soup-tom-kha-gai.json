        "instructions": [
          {
            "id": 159776,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 lb white mushrooms\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 lime"
          },
          {
            "id": 159777,
            "primary_message": "Peel and thinly slice onion into half rings.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 159778,
            "primary_message": "Heat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 159779,
            "primary_message": "Peel and mince ginger and garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 159780,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 159781,
            "primary_message": "Add onion, ginger, garlic, and chili-garlic sauce to the pot. Cook, stirring frequently, until onion begins to soften, 3-4 minutes.",
            "secondary_message": "2 tbsp chili-garlic sauce"
          },
          {
            "id": 159782,
            "primary_message": "Add broth, coconut milk, sugar, fish sauce, and salt to the pot. Bring to a boil over high heat, then reduce heat to a simmer.",
            "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n1 tbsp brown sugar\n2 tsp fish sauce\n1 tsp salt"
          },
          {
            "id": 159783,
            "primary_message": "Thinly slice mushrooms.",
            "secondary_message": null
          },
          {
            "id": 159784,
            "primary_message": "Slice chicken crosswise into thin strips. ",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 159785,
            "primary_message": "Add mushrooms and chicken to the pot and continue to simmer until chicken is cooked through, 10-12 minutes.",
            "secondary_message": null
          },
          {
            "id": 159786,
            "primary_message": "Meanwhile, using a fresh cutting board, trim green onions; cut crosswise into ¼-inch pieces.",
            "secondary_message": null
          },
          {
            "id": 159787,
            "primary_message": "Shave cilantro leaves off the stems; discard stems.",
            "secondary_message": null
          },
          {
            "id": 159788,
            "primary_message": "When the soup is done, juice lime into the pot and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 159789,
            "primary_message": "To serve, divide soup between bowls. Top with green onions and cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
