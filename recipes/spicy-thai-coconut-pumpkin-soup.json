        "instructions": [
          {
            "id": 190065,
            "primary_message": "Heat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 190066,
            "primary_message": "Meanwhile, peel and small dice onion. Trim off and discard the root ends of the garlic and press or mince.",
            "secondary_message": "2 medium yellow onions\n2 cloves garlic"
          },
          {
            "id": 190067,
            "primary_message": "Once the pot is hot, add coconut oil and swirl to coat the bottom. Add the onion and garlic to the pot.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 190068,
            "primary_message": "Wash and peel the carrots, then trim off the ends. Using a box grater, coarsely grate and add to pot.",
            "secondary_message": "2 medium carrots"
          },
          {
            "id": 190069,
            "primary_message": "Wash the cilantro and shave the cilantro leaves off the stems. Chop the stems into small pieces and add to the pot. Mince the leaves and set half aside for garnish, add the rest to the pot. ",
            "secondary_message": "1 small bunch cilantro"
          },
          {
            "id": 190070,
            "primary_message": "Season mixture with salt and pepper. Cook until all vegetables have softened, 3-4 minutes.",
            "secondary_message": "1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 190071,
            "primary_message": "Reduce heat to low. Wash, peel and mince or grate the ginger. Add to the pot.",
            "secondary_message": "2 (1 inch) pieces ginger root"
          },
          {
            "id": 190072,
            "primary_message": "Add pumpkin, honey and cayenne pepper, stirring to combine.",
            "secondary_message": "1 (15 oz) can pure pumpkin purée\n2 tbsp honey\n½ tsp cayenne pepper"
          },
          {
            "id": 190073,
            "primary_message": "Shake can of coconut milk vigorously before opening. Add to the soup, reserving a few tablespoons for garnish.",
            "secondary_message": "1 (13.5 fl oz) can coconut milk"
          },
          {
            "id": 190074,
            "primary_message": "Add broth and bring to a boil. Reduce heat and simmer stirring occasionally, 8-10 minutes.",
            "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth"
          },
          {
            "id": 190075,
            "primary_message": "Meanwhile, melt butter and oil over medium heat in a small saucepan.",
            "secondary_message": "2 tbsp butter, unsalted\n2 tbsp virgin coconut oil"
          },
          {
            "id": 190076,
            "primary_message": "Peel and thinly slice the shallots into rings. Add to pan breaking up as you go.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 190077,
            "primary_message": "Turn heat up to medium-high. Cook until shallots are starting to darken around the edges, about 2 minutes. Reduce heat to low and continue to cook until golden brown and crispy, 2-3 minutes more. Watch carefully as they can burn easily.",
            "secondary_message": null
          },
          {
            "id": 190078,
            "primary_message": "Transfer shallots to a paper towel-lined plate and discard oil. Season with salt. ",
            "secondary_message": "⅛ tsp salt"
          },
          {
            "id": 190079,
            "primary_message": "Using an immersion (hand) blender, purée the soup until smooth.",
            "secondary_message": null
          },
          {
            "id": 190080,
            "primary_message": "Wash and cut the lime into wedges.",
            "secondary_message": "1 lime"
          },
          {
            "id": 190081,
            "primary_message": "To serve, ladle soup into bowls. Top with a swirl of coconut milk, crispy shallots, cilantro leaves and a squeeze of lime. Enjoy!",
            "secondary_message": null
          }
        ],
