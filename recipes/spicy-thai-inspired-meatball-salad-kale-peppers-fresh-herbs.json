  "instructions": [
    {
      "id": 347743,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 small pkg fresh mint\n2 limes\n2 bunches kale\n2 red chili peppers\n2 yellow bell peppers\n1 avocado"
    },
    {
      "id": 347744,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Divide herbs between two large bowls.",
      "secondary_message": null
    },
    {
      "id": 347745,
      "primary_message": "Add beef and spices to one of the bowls with the herbs (set the other bowl aside for the dressing); use your hands to combine the beef mixture. Using a scant tablespoon, form the mixture into mini meatballs and place on a plate.",
      "secondary_message": "1 ½ lb lean ground beef\n1 tsp coriander, ground\n1 tsp turmeric, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 347746,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347747,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add meatballs and cook, turning occasionally, until cooked through, about 5 minutes. Remove from heat.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 347748,
      "primary_message": "Meanwhile, peel and mince garlic; add to the second bowl with the herbs.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 347749,
      "primary_message": "Juice limes into the bowl, then add oil, fish sauce, sugar, soy sauce, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp toasted sesame oil\n4 tsp fish sauce\n4 tsp brown sugar\n2 tsp soy sauce\n½ tsp black pepper"
    },
    {
      "id": 347750,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 347751,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon. Thinly slice and add to the bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 347752,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 347753,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 347754,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 347755,
      "primary_message": "To serve, divide salad between plates or bowls; top with meatballs and enjoy!",
      "secondary_message": null
    }
  ],
