        "instructions": [
          {
            "id": 366896,
            "primary_message": "Preheat oven to 450°F and arrange racks in the upper and lower thirds of the oven.",
            "secondary_message": null
          },
          {
            "id": 366897,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 366898,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 366899,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 366900,
            "primary_message": "Meanwhile, place soy sauce, chili-garlic sauce, oil, and maple syrup in a medium bowl. Whisk to combine the marinade.",
            "secondary_message": "⅓ cup soy sauce\n2 tbsp chili-garlic sauce\n4 tsp toasted sesame oil\n2 tsp pure maple syrup"
          },
          {
            "id": 366901,
            "primary_message": "Medium dice tofu, add to the bowl with the marinade, and gently stir to coat. Set aside to marinate. (Wipe baking sheet dry with paper towels and reserve for later use.)",
            "secondary_message": null
          },
          {
            "id": 366902,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 crowns broccoli\n1 lb cremini mushrooms\n1 small bunch green onions (scallions)"
          },
          {
            "id": 366903,
            "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Transfer to the reserved baking sheet.",
            "secondary_message": null
          },
          {
            "id": 366904,
            "primary_message": "Quarter mushrooms and add to the baking sheet with the broccoli. Drizzle veggies with oil and season with salt. Toss to combine, then spread out in an even layer.",
            "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt"
          },
          {
            "id": 366905,
            "primary_message": "Transfer tofu to another large baking sheet, spreading out in a single layer. Drizzle with any marinade left in the bowl. (Reserve bowl for later use.)",
            "secondary_message": null
          },
          {
            "id": 366906,
            "primary_message": "Place baking sheets in the oven and roast, stirring halfway through, until veggies are tender and tofu is golden, 15-20 minutes. ",
            "secondary_message": null
          },
          {
            "id": 366907,
            "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Set aside.",
            "secondary_message": null
          },
          {
            "id": 366908,
            "primary_message": "Place tahini, vinegar, maple syrup, soy sauce, and water in the reserved bowl. Whisk to combine the sauce and set aside.",
            "secondary_message": "⅓ cup tahini\n2 tbsp rice vinegar\n2 tbsp pure maple syrup\n2 tbsp soy sauce\n2 tbsp water"
          },
          {
            "id": 366909,
            "primary_message": "When the veggies and tofu are done, remove from the oven. Add half of the green onions and toss to combine. (Reserve remaining green onions for serving.)",
            "secondary_message": null
          },
          {
            "id": 366910,
            "primary_message": "To serve, divide the rice, tofu, and veggies between plates or bowls. Drizzle with sauce and top with the remaining green onion. Enjoy!",
            "secondary_message": null
          }
        ],
