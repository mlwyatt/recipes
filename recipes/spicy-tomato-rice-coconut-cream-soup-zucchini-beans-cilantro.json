        "instructions": [
          {
            "id": 223914,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n2 medium zucchini squash\n1 small bunch cilantro"
          },
          {
            "id": 223915,
            "primary_message": "Peel and mince garlic and ginger.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 223916,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 223917,
            "primary_message": "While the pot heats up, peel and small dice onion.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 223918,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic, ginger, onion, chili-garlic sauce, and salt; cook, stirring occasionally, until onion begins to soften, 3-4 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil\n2 tsp chili-garlic sauce\n1 tsp salt"
          },
          {
            "id": 223919,
            "primary_message": "Add broth, tomatoes, and coconut milk to the pot. Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, for 5 minutes.",
            "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes\n1 (13.5 fl oz) can coconut milk"
          },
          {
            "id": 223920,
            "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then slice crosswise into half rounds.",
            "secondary_message": null
          },
          {
            "id": 223921,
            "primary_message": "Drain and rinse beans.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 223922,
            "primary_message": "Purée the soup with an immersion (hand) blender or regular blender. Return puréed soup to the pot and stir in zucchini, beans, and rice.",
            "secondary_message": "1 cup basmati rice"
          },
          {
            "id": 223923,
            "primary_message": "Bring soup to a boil over high heat, then reduce heat to low. Cover and simmer, stirring occasionally, until rice is tender, about 15-18 minutes.",
            "secondary_message": null
          },
          {
            "id": 223924,
            "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 223925,
            "primary_message": "To serve, divide soup between bowls and top with cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
