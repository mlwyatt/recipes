        "instructions": [
          {
            "id": 171052,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 English cucumber\n1 pint grape tomatoes\n1 red bell pepper\n1 small bunch cilantro\n1 lime\n1 avocado"
          },
          {
            "id": 171053,
            "primary_message": "Peel and mince garlic; transfer to a large bowl. ",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 171054,
            "primary_message": "Trim cucumber, then halve lengthwise and slice thinly crosswise. Add to the bowl with the garlic.",
            "secondary_message": null
          },
          {
            "id": 171055,
            "primary_message": "Halve grape tomatoes. Seed and slice bell pepper into thin strips; transfer both to the bowl with the garlic. ",
            "secondary_message": null
          },
          {
            "id": 171056,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 171057,
            "primary_message": "Juice the lime into the bowl and season with salt and pepper. Stir to combine the salad, then set aside. ",
            "secondary_message": "½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 171058,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 171059,
            "primary_message": "Crack the eggs into another medium bowl and season with salt and pepper; whisk together.",
            "secondary_message": "8 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 171060,
            "primary_message": "Once the skillet is hot, add the oil and swirl to coat the bottom. ",
            "secondary_message": "½ tsp extra virgin olive oil"
          },
          {
            "id": 171061,
            "primary_message": "Pour one-quarter of the egg mixture (or about ⅓ cup) into the skillet and swirl to make an omelet the size of a tortilla. Let cook, undisturbed, for 30 seconds. Before the egg fully sets, place a tortilla on top and press down gently with a spatula. When egg is cooked, after about 1 minute, flip tortilla and cook for 30 seconds more; transfer to a plate and cover with aluminum foil.",
            "secondary_message": "1 large flour tortilla"
          },
          {
            "id": 171062,
            "primary_message": "Add more oil (½ tsp per tortilla) to the skillet and repeat with remaining egg mixture and tortillas.  ",
            "secondary_message": "1 ½ tsp extra virgin olive oil\n3 large flour tortillas"
          },
          {
            "id": 171063,
            "primary_message": "Meanwhile, halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon.",
            "secondary_message": null
          },
          {
            "id": 171064,
            "primary_message": "Lay the tortillas, egg-side-up, on a flat surface; divide the avocado, pico de gallo salad, and chili-garlic sauce between them. Roll tightly to close, then slice each roll in half. ",
            "secondary_message": "2 tbsp chili-garlic sauce"
          },
          {
            "id": 171065,
            "primary_message": "To serve, divide rolls between plates. Enjoy!",
            "secondary_message": null
          }
        ],
