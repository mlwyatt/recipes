        "instructions": [
          {
            "id": 483674,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 limes\n4 medium carrots\n1 bunch radish\n2 heads butter (Boston) lettuce\n1 small bunch cilantro\n1 small pkg fresh mint"
          },
          {
            "id": 483675,
            "primary_message": "Juice limes into a small bowl.",
            "secondary_message": null
          },
          {
            "id": 483676,
            "primary_message": "Peel and mince shallot and garlic. Add both to the bowl with the lime juice along with fish sauce, soy sauce, sugar, and crushed red pepper. Whisk to combine the dressing and set aside.",
            "secondary_message": "1 shallot\n2 cloves garlic\n2 tbsp fish sauce\n2 tbsp soy sauce\n4 tsp brown sugar\n1 tsp crushed red pepper"
          },
          {
            "id": 483677,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 483678,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 483679,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
            "secondary_message": "2 tsp toasted sesame oil"
          },
          {
            "id": 483680,
            "primary_message": "Meanwhile, peel and trim carrots; run the peeler along each carrot to make long, noodle-like strips. Place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 483681,
            "primary_message": "Trim and thinly slice radishes. Add to the bowl with the carrot.",
            "secondary_message": null
          },
          {
            "id": 483682,
            "primary_message": "Chop or tear lettuce leaves into bite-sized pieces; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 483683,
            "primary_message": "Pick cilantro and mint leaves off the stems; discard stems and roughly chop the leaves. Add both to the bowl.",
            "secondary_message": null
          },
          {
            "id": 483684,
            "primary_message": "Roughly chop cashews. Add to the bowl, gently toss to combine the salad, and set aside.",
            "secondary_message": "½ cup cashews, roasted unsalted"
          },
          {
            "id": 483685,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 483686,
            "primary_message": "Divide salad and steak between plates or bowls. Drizzle with dressing and enjoy!",
            "secondary_message": null
          }
        ],
