        "instructions": [
          {
            "id": 424108,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 424109,
            "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
            "secondary_message": null
          },
          {
            "id": 424110,
            "primary_message": "While the water heats up, drain and roughly chop artichoke hearts. Place in a large baking dish. ",
            "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
          },
          {
            "id": 424111,
            "primary_message": "Add Alfredo sauce and spices to the baking dish with the artichokes. Stir to combine and set aside. ",
            "secondary_message": "1 (16 oz) jar Alfredo sauce\n1 tsp onion powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 424112,
            "primary_message": "Once the water in the pot is boiling, add gnocchi and cauliflower. Cook, stirring occasionally, until gnocchi begins to float to the surface, 3-4 minutes.",
            "secondary_message": "2 (16 oz) pkgs potato gnocchi\n2 (10 oz) bags cauliflower florets"
          },
          {
            "id": 424113,
            "primary_message": "Meanwhile, place frozen spinach in a colander. ",
            "secondary_message": "1 (16oz) bag frozen chopped spinach"
          },
          {
            "id": 424114,
            "primary_message": "When the gnocchi and cauliflower are done, drain in the colander over the spinach. ",
            "secondary_message": null
          },
          {
            "id": 424115,
            "primary_message": "Add gnocchi, cauliflower, and spinach to the baking dish. Stir to combine with the sauce, then top with cheese.",
            "secondary_message": "⅔ cup Parmesan cheese, shredded"
          },
          {
            "id": 424116,
            "primary_message": "Place baking dish in the oven and bake until cheese is golden, about 10 minutes. Remove from oven. ",
            "secondary_message": null
          },
          {
            "id": 424117,
            "primary_message": "To serve, divide gnocchi bake between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
