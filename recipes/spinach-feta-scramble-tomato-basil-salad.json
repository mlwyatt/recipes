  "instructions": [
    {
      "id": 171904,
      "primary_message": "Wash and dry tomatoes; slice into wedges and place in a medium bowl with oil, salt, and pepper.",
      "secondary_message": "4 tomatoes\n2 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 171905,
      "primary_message": "Wash and dry the basil; pick the leaves off the stems and slice into ribbons. Add to the bowl with the tomatoes and toss gently to combine the salad; set aside. ",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 171906,
      "primary_message": "Crack the eggs into a medium bowl and season with pepper; whisk together.",
      "secondary_message": "8 eggs\n½ tsp black pepper"
    },
    {
      "id": 171907,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 171908,
      "primary_message": "Add spinach and feta to eggs and stir gently to combine.",
      "secondary_message": "1 (5 oz) pkg baby spinach\n1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 171909,
      "primary_message": "Add oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 171910,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 171911,
      "primary_message": "To serve, divide eggs and tomato salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
