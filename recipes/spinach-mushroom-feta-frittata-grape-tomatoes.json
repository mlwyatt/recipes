        "instructions": [
          {
            "id": 28060,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 pint grape tomatoes\n1 lb white mushrooms\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 28061,
            "primary_message": "Slice the mushrooms; transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 28062,
            "primary_message": "Peel and small dice the onion; transfer to a small bowl.",
            "secondary_message": "1 medium yelllow onion"
          },
          {
            "id": 28063,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 28064,
            "primary_message": "Preheat the oven to the broil setting.",
            "secondary_message": null
          },
          {
            "id": 28065,
            "primary_message": "Add olive oil to the skillet and swirl to coat the bottom. Add the diced onion and cook, stirring frequently, until translucent, 2 to 3 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 28066,
            "primary_message": "Add more olive oil and the mushrooms to the skillet; cook, stirring occasionally, until the mushrooms are tender, 3 to 4 minutes.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 28067,
            "primary_message": "While the mushrooms cook, in a large bowl, combine and whisk together the eggs, water, salt, and black pepper.",
            "secondary_message": "12 eggs\n4 tbsp water\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 28068,
            "primary_message": "Add the spinach (a handful at a time) to the skillet and stir until wilted, 1 to 2 minutes.",
            "secondary_message": null
          },
          {
            "id": 28069,
            "primary_message": "Pour the egg mixture over top the vegetables and sprinkle with the feta cheese.",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 28070,
            "primary_message": "While tilting the skillet with one hand, lift up the edges of the frittata with a spatula and let the eggs run underneath during the first few minutes of cooking. Cook until most of the frittata is set, but the top is still runny, 4 to 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 28071,
            "primary_message": "Transfer the skillet to the oven and broil until the top is set and lightly browned, 2 to 3 minutes.",
            "secondary_message": ""
          },
          {
            "id": 28072,
            "primary_message": "Separate the frittata into wedges and divide between four plates (or two plates and two lunch containers). Serve with the grape tomatoes on the side. Enjoy!",
            "secondary_message": null
          }
        ],
