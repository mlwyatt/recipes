        "instructions": [
          {
            "id": 342031,
            "primary_message": "Using a strainer, rinse lentils under cold water and place in a medium saucepan; add broth and bring to a boil over high heat.",
            "secondary_message": "1 cup brown lentils, dried\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 342032,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook lentils until tender, about 15 minutes; drain and rinse with cold water (from the tap) to cool. Set aside.",
            "secondary_message": null
          },
          {
            "id": 342033,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley\n2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 342034,
            "primary_message": "Zest and juice lemon into a large bowl; add oil, Dijon, maple syrup, and spices. Whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 342035,
            "primary_message": "Peel, halve, and slice shallots into thin half-moons; add to the bowl with the dressing.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 342036,
            "primary_message": "Trim and medium dice cucumber; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 342037,
            "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 342038,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 342039,
            "primary_message": "Once the grill pan is hot, coat with oil. Place sausages on the pan and cook, turning occasionally, until warmed through, about 5 minutes (or cook according to package instructions).",
            "secondary_message": "2 tsp extra virgin olive oil\n4 pre-cooked vegan sausage"
          },
          {
            "id": 342040,
            "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into thin rounds.",
            "secondary_message": null
          },
          {
            "id": 342041,
            "primary_message": "Add lentils, sausage, and spinach to the bowl with the dressing and veggies; toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 342042,
            "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
