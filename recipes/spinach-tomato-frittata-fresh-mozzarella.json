        "instructions": [
          {
            "id": 12346,
            "primary_message": "Preheat oven to broil and position rack under the broiler.",
            "secondary_message": ""
          },
          {
            "id": 12347,
            "primary_message": "Wash and dry spinach and tomatoes. Slice tomatoes into rounds. Peel and mince garlic.",
            "secondary_message": "1 (5 oz) pkg baby spinach\r\n2 tomatoes\r\n4 cloves garlic"
          },
          {
            "id": 12348,
            "primary_message": "Thinly slice mozzarella.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 12349,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 12350,
            "primary_message": "In a large bowl, whisk together eggs, water, Italian seasoning, salt, and pepper.",
            "secondary_message": "12 eggs\r\n4 tbsp water\r\n½ tsp Italian seasoning\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 12351,
            "primary_message": "Coat bottom of skillet with oil. Add garlic and spinach. Cook until spinach begins to wilt, 1-2 minutes.",
            "secondary_message": "about 2 tbsp extra virgin olive oil"
          },
          {
            "id": 12352,
            "primary_message": "Pour in egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 8-10 minutes.",
            "secondary_message": ""
          },
          {
            "id": 12353,
            "primary_message": "Add tomatoes and mozzarella.",
            "secondary_message": ""
          },
          {
            "id": 12354,
            "primary_message": "Place skillet in the oven and broil until the top is set, 2-3 minutes.",
            "secondary_message": ""
          },
          {
            "id": 12355,
            "primary_message": "To serve, cut frittata into wedges and place on a plate. Enjoy!",
            "secondary_message": ""
          }
        ],
