        "instructions": [
          {
            "id": 252402,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 252403,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "2 small bunches asparagus\n1 (16 oz) pkg strawberries\n1 bunch radish\n1 small pkg fresh basil\n2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 252404,
            "primary_message": "Snap or cut off woody ends of the asparagus; cut into bite-sized pieces. Transfer to a large baking sheet pan, drizzle with oil, and sprinkle with salt and pepper; toss to combine and spread out in an even layer.",
            "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 252405,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until asparagus is tender-crisp, 8-10 minutes. Remove from oven and set aside to cool.",
            "secondary_message": null
          },
          {
            "id": 252406,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 252407,
            "primary_message": "While the skillet heats up, pat steak dry with paper towels and season with spices on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 252408,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with aluminum foil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 252409,
            "primary_message": "Meanwhile, place oil, vinegar, sugar, poppy seeds, Dijon, and spices in a large bowl. Whisk to combine the dressing.",
            "secondary_message": "¼ cup extra virgin olive oil\n¼ cup balsamic vinegar\n1 tbsp brown sugar\n1 tsp poppy seeds\n½ tsp Dijon mustard\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 252410,
            "primary_message": "Trim and slice strawberries crosswise into ¼-inch thick pieces; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 252411,
            "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 252412,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 252413,
            "primary_message": "Add roasted asparagus and mixed greens to the bowl; toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 252414,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 252415,
            "primary_message": "To serve, divide salad between plates. Top with steak and enjoy!",
            "secondary_message": null
          }
        ],
