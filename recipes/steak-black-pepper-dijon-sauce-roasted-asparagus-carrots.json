        "instructions": [
          {
            "id": 214485,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 214486,
            "primary_message": "Meanwhile, wash and dry the asparagus. Snap or cut off woody ends, then cut into bite-sized pieces. Transfer to a large baking sheet pan.",
            "secondary_message": "2 small bunches asparagus"
          },
          {
            "id": 214487,
            "primary_message": "Wash, dry, peel, and slice carrots into thin rounds. Add to the baking sheet with the asparagus. ",
            "secondary_message": "2 medium carrots"
          },
          {
            "id": 214488,
            "primary_message": "Peel and mince garlic and onion; sprinkle both over the veggies. Drizzle with oil, season with salt, and toss to combine.",
            "secondary_message": "2 cloves garlic\n½ medium red onion\n4 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 214489,
            "primary_message": "Place baking sheet in the oven and roast veggies, tossing once, until fork-tender, 12-15 minutes.",
            "secondary_message": null
          },
          {
            "id": 214490,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 214491,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 214492,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate and loosely cover with foil. ",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 214493,
            "primary_message": "Return skillet to medium-high heat; add cream, Dijon, salt, and pepper. Whisk to combine the sauce and bring to a simmer. Cook until heated through and slightly thickened, 1-2 minutes. Remove from the heat. ",
            "secondary_message": "8 fl oz (1 cup) heavy cream\n¼ cup Dijon mustard\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 214494,
            "primary_message": "Meanwhile, thinly slice steak into strips.",
            "secondary_message": null
          },
          {
            "id": 214495,
            "primary_message": "To serve, divide steak and veggies between plates. Top steak with sauce and enjoy! ",
            "secondary_message": null
          }
        ],
