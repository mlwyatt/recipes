  "instructions": [
    {
      "id": 11727,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 11728,
      "primary_message": "Peel and cut onions into 8 wedges. Transfer to a sheet pan. Wash and peel carrots. Slice into thirds crosswise, then halve or quarter lengthwise. Add to sheet.",
      "secondary_message": "2 medium red onions\r\n10 medium carrots"
    },
    {
      "id": 11729,
      "primary_message": "Drizzle with oil and season with salt and pepper; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 11730,
      "primary_message": "Arrange in a single layer and place in the oven. Roast, tossing once halfway through, until carrots are tender, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11731,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 11732,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\r\n2 cloves garlic"
    },
    {
      "id": 11733,
      "primary_message": "Coat bottom of skillet with oil. Season steak with salt and pepper. Add to skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp virgin coconut oil\n1 ½ lb ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 11734,
      "primary_message": "In a medium bowl, prepare sauce by whisking together parsley, garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "6 tbsp extra virgin olive oil\r\n2 tbsp red wine vinegar\r\n¼ tsp salt\r\n¼ tsp black pepper\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 11735,
      "primary_message": "To serve, place steak, carrots, and onion on a plate and drizzle with chimichurri sauce. Enjoy!",
      "secondary_message": ""
    }
  ],
