  "instructions": [
    {
      "id": 383676,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 383677,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 383678,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 383679,
      "primary_message": "Meanwhile, wash, dry, and chop or tear lettuce into bite-sized pieces. Place in a large bowl.",
      "secondary_message": "4 hearts romaine hearts"
    },
    {
      "id": 383680,
      "primary_message": "Wash, dry, and slice tomatoes into wedges. Add to the bowl with the lettuce.",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 383681,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 383682,
      "primary_message": "Crumble goat cheese into the bowl.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 383683,
      "primary_message": "Add vinaigrette to the bowl and toss to combine the salad.",
      "secondary_message": "½ cup balsamic vinaigrette"
    },
    {
      "id": 383684,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 383685,
      "primary_message": "To serve, divide salad between plates or bowls and top with steak. Enjoy!",
      "secondary_message": null
    }
  ],
