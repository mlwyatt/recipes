        "instructions": [
          {
            "id": 359625,
            "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "1 small pkg fresh basil\n2 (6 oz) pkgs blueberries\n1 English cucumber\n2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 359626,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 359627,
            "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 359628,
            "primary_message": "Once the pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 359629,
            "primary_message": "Meanwhile, pick basil off the stems and place in a blender.",
            "secondary_message": null
          },
          {
            "id": 359630,
            "primary_message": "Add half of the blueberries (reserve remaining blueberries for the salad), vinegar, water, oil, Dijon, honey, salt, and pepper to the blender. Blend on high until smooth, then set dressing aside.",
            "secondary_message": "¼ cup balsamic vinegar\n¼ cup water\n4 tsp extra virgin olive oil\n1 tbsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 359631,
            "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into thin pieces; place in a large bowl.",
            "secondary_message": null
          },
          {
            "id": 359632,
            "primary_message": "Roughly chop walnuts and add to the bowl with the cucumber. ",
            "secondary_message": "⅔ cup walnuts"
          },
          {
            "id": 359633,
            "primary_message": "Add mixed greens and remaining blueberries to the bowl. Toss to combine the salad. ",
            "secondary_message": null
          },
          {
            "id": 359634,
            "primary_message": "Thinly slice steak against the grain. ",
            "secondary_message": null
          },
          {
            "id": 359635,
            "primary_message": "To serve, divide salad and steak between plates or bowls. Crumble goat cheese over top and drizzle with dressing. Enjoy! ",
            "secondary_message": "1 (4 oz) log goat cheese"
          }
        ],
