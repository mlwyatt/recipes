        "instructions": [
          {
            "id": 371635,
            "primary_message": "Wash, dry, and halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Place in a medium bowl and set aside.",
            "secondary_message": "2 hearts romaine hearts"
          },
          {
            "id": 371636,
            "primary_message": "Wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips.",
            "secondary_message": "2 red bell peppers"
          },
          {
            "id": 371637,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 371638,
            "primary_message": "While the skillet heats up, pat steak dry with paper towels, then slice crosswise into thin strips.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak"
          },
          {
            "id": 371639,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell peppers, steak, taco seasoning, and salt. Cook, stirring occasionally, until bell peppers are soft and steak is cooked through, 4-5 minutes. Remove from heat.",
            "secondary_message": "2 tsp extra virgin olive oil\n3 tbsp taco seasoning\n½ tsp salt"
          },
          {
            "id": 371640,
            "primary_message": "Meanwhile, warm tortillas in another skillet, oven, or microwave (optional).",
            "secondary_message": "12 small corn tortillas"
          },
          {
            "id": 371641,
            "primary_message": "To serve, divide tortillas between plates. Fill with steak, peppers, guacamole, salsa, and lettuce. Enjoy!",
            "secondary_message": "1 cup guacamole\n½ cup salsa"
          }
        ],
