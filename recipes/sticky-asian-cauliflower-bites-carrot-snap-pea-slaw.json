        "instructions": [
          {
            "id": 208237,
            "primary_message": "Preheat oven to 400°F. Line a large baking sheet pan with aluminum foil and coat with a thin layer of oil.",
            "secondary_message": "2 tsp toasted sesame oil"
          },
          {
            "id": 208238,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium heads cauliflower\n1 small head red cabbage\n2 medium carrots\n2 (8 oz) pkg sugar snap peas\n2 (1 inch) pieces ginger root"
          },
          {
            "id": 208239,
            "primary_message": "Remove leaves and thick stems from cauliflower heads; separate the heads into bite-sized florets.",
            "secondary_message": null
          },
          {
            "id": 208240,
            "primary_message": "Whisk eggs, salt, and pepper in a large bowl. Add ⅓ of the cauliflower florets to the bowl and toss to dredge.",
            "secondary_message": "4 eggs\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 208241,
            "primary_message": "Transfer florets, shaking off excess egg, to another large bowl; add ⅓ of the bread crumbs and toss to coat, pressing gently to adhere. Transfer to the baking sheet and repeat twice more with remaining cauliflower.",
            "secondary_message": "2 cup panko bread crumbs"
          },
          {
            "id": 208242,
            "primary_message": "Place cauliflower in the oven and cook until golden and fork-tender, about 25 minutes.",
            "secondary_message": null
          },
          {
            "id": 208243,
            "primary_message": "Meanwhile, peel and mince garlic; transfer to a medium bowl along with oil, vinegar, maple syrup, soy sauce, and chili-garlic sauce. Whisk to combine the dressing.",
            "secondary_message": "2 cloves garlic\n2 tbsp toasted sesame oil\n2 tbsp rice vinegar\n4 tsp pure maple syrup\n2 tsp soy sauce\n½ tsp chili-garlic sauce"
          },
          {
            "id": 208244,
            "primary_message": "Quarter cabbage lengthwise, then cut out and discard the core; thinly slice crosswise and add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 208245,
            "primary_message": "Peel, trim, and coarsely grate carrots; halve snap peas. Add both to the bowl, toss to combine the salad, and set aside.",
            "secondary_message": null
          },
          {
            "id": 208246,
            "primary_message": "Peel and mince ginger and additional garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 208247,
            "primary_message": "Preheat a small saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 208248,
            "primary_message": "Once the saucepan is hot, add oil, ginger, and garlic to the saucepan; cook, stirring often, until fragrant, about 1 minute.",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 208249,
            "primary_message": "Add broth, soy sauce, maple syrup, vinegar, and chili-garlic sauce to the saucepan; whisk to combine the sauce and bring to a simmer over medium-high heat.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n⅓ cup soy sauce\n¼ cup pure maple syrup\n2 tbsp rice vinegar\n2 tsp chili-garlic sauce"
          },
          {
            "id": 208250,
            "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth. Add to the saucepan in a steady stream, while whisking constantly; continue to simmer, until thick, about 3 minutes. Remove from heat.",
            "secondary_message": "¼ cup water\n2 tbsp cornstarch"
          },
          {
            "id": 208251,
            "primary_message": "To serve, divide salad and roasted cauliflower between plates. Top cauliflower bites with sauce and enjoy!",
            "secondary_message": null
          }
        ],
