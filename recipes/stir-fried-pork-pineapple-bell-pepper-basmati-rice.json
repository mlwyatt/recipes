        "instructions": [
          {
            "id": 19928,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n¼ tsp salt\n16 fl oz (2 cups) water"
          },
          {
            "id": 19929,
            "primary_message": "In a medium bowl, whisk together soy sauce, vinegar, honey, and cornstarch.",
            "secondary_message": "4 tbsp soy sauce\r\n4 tbsp rice vinegar\r\n2 tsp honey\r\n2 tsp cornstarch"
          },
          {
            "id": 19930,
            "primary_message": "Thinly slice pork into strips. Add to bowl with sauce and toss to coat.",
            "secondary_message": "4 pork chops, boneless"
          },
          {
            "id": 40390,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 19931,
            "primary_message": "Peel and mince garlic. Peel and mince or grate ginger. Peel and medium dice onion.",
            "secondary_message": "2 cloves garlic\r\n2 (1 inch) pieces ginger root\r\n1 medium red onion"
          },
          {
            "id": 19932,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 19933,
            "primary_message": "Wash bell peppers and pineapple. Seed and large dice the peppers. Cut off skin from pineapple, core, and cut into bite-sized pieces.",
            "secondary_message": "1 small pineapple\r\n2 red bell peppers"
          },
          {
            "id": 19934,
            "primary_message": "Coat bottom of skillet with oil. Add pork, reserving sauce in bowl, and stir fry until no longer pink, 2-3 minutes. Transfer to a plate.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 19935,
            "primary_message": "Coat skillet with more oil. Add garlic, ginger, onion, and peppers. Stir fry until pepper is tender-crisp, 2-3 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 19936,
            "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": "1 small bunch cilantro"
          },
          {
            "id": 19937,
            "primary_message": "Add pork, pineapple, and sauce to skillet. Toss to coat and stir fry for 1-2 minutes.",
            "secondary_message": ""
          },
          {
            "id": 19938,
            "primary_message": "Remove from heat and stir in cilantro.",
            "secondary_message": ""
          },
          {
            "id": 40389,
            "primary_message": "Uncover the rice and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 19939,
            "primary_message": "Place rice on a plate, top with stir fry, and enjoy!",
            "secondary_message": ""
          }
        ],
