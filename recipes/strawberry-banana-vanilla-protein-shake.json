  "instructions": [
    {
      "id": 483468,
      "primary_message": "Not all protein powders are created equal. If desired, adjust shake consistency by adding more or less liquid per package instructions. This recipe will make about 8 cups of shake. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 483469,
      "primary_message": "Wash, dry, and trim strawberries. Place in a blender.",
      "secondary_message": "1 (16 oz) pkg strawberries"
    },
    {
      "id": 483470,
      "primary_message": "Peel bananas, break into chunks, and add to the blender.",
      "secondary_message": "2 bananas"
    },
    {
      "id": 483471,
      "primary_message": "Add milk, yogurt, protein powder, maple syrup, and vanilla to the blender. Blend on high speed for several minutes until smooth.",
      "secondary_message": "16 fl oz (2 cups) whole milk\n1 cup plain Greek yogurt\n4 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n4 tsp pure maple syrup\n½ tsp vanilla extract"
    },
    {
      "id": 483472,
      "primary_message": "To serve, divide shake between glasses, adding ice if desired. Enjoy!",
      "secondary_message": null
    }
  ],
