        "instructions": [
          {
            "id": 391503,
            "primary_message": "Place cream cheese on the counter and let soften slightly while you prepare the strawberries.",
            "secondary_message": "⅔ (8 oz) block cream cheese"
          },
          {
            "id": 391504,
            "primary_message": "Wash, dry, trim, and cut strawberries lengthwise into ½-inch thick slices. Set aside.",
            "secondary_message": "⅔ (16 oz) pkg strawberries"
          },
          {
            "id": 391505,
            "primary_message": "Place bread on a flat surface. Divide cream cheese between the slices and spread out in an even layer. Cover half of the slices with strawberries, then close sandwiches with remaining bread slices.",
            "secondary_message": "8 slices whole grain bread"
          },
          {
            "id": 391506,
            "primary_message": "To serve, cut sandwiches in half and divide between plates. Enjoy!",
            "secondary_message": null
          }
        ],
