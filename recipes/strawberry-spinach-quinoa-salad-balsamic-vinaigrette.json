  "instructions": [
    {
      "id": 17546,
      "primary_message": "In a small saucepan, combine quinoa and broth. Bring to a boil. Reduce heat to low, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 17547,
      "primary_message": "Wash and dry spinach and basil. Thinly slice the leaves into ribbons and transfer to a large bowl.",
      "secondary_message": "1 (5 oz) pkg baby spinach\r\n1 small pkg fresh basil"
    },
    {
      "id": 17548,
      "primary_message": "Wash, trim and discard stem ends, and slice strawberries. Add to bowl with spinach and basil.",
      "secondary_message": "1 (16 oz) pkg strawberries"
    },
    {
      "id": 17549,
      "primary_message": "In a small bowl, prepare dressing by whisking together oil, vinegar, Dijon, honey, salt, and pepper.",
      "secondary_message": "6 tbsp extra virgin olive oil\r\n2 tbsp balsamic vinegar\r\n½ tsp Dijon mustard\r\n½ tsp honey\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 17550,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 17551,
      "primary_message": "Coat bottom of skillet with oil. Add almonds and, stirring constantly, cook until golden brown, 1-2 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n½ cup almonds, sliced"
    },
    {
      "id": 17552,
      "primary_message": "Uncover quinoa and fluff with a fork. Drain any excess liquid and add to bowl with other ingredients. Toss salad.",
      "secondary_message": ""
    },
    {
      "id": 17553,
      "primary_message": "To serve, arrange salad on a plate, crumble goat cheese over top, sprinkle with almonds, and drizzle with dressing. Enjoy!",
      "secondary_message": "1 (4 oz) log goat cheese"
    }
  ],
