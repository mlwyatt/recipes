  "instructions": [
    {
      "id": 17702,
      "primary_message": "Wash and dry bell peppers. Seed and slice into thin strips. Peel and thinly slice onion into half rings. Peel and mince garlic.",
      "secondary_message": "2 red bell peppers\r\n2 yellow bell peppers\r\n1 medium red onion\r\n4 cloves garlic"
    },
    {
      "id": 17703,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 17704,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 17705,
      "primary_message": "Coat bottom of skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 17706,
      "primary_message": "Once the steak has been transferred, reduce the heat to medium and add sliced onion, peppers, and ½ of the garlic (save the rest for the guacamole) to the skillet. Stirring frequently, cook until vegetables are tender-crisp, 4-5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 17707,
      "primary_message": "Wash and dry cilantro and limes. Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 small bunch cilantro\r\n2 limes"
    },
    {
      "id": 17708,
      "primary_message": "Halve and pit avocados; medium dice the flesh while still in skin and scoop out into a medium bowl. Add ½ of the cilantro (save the rest for garnishing), remaining garlic, lime juice, salt, and pepper. Mash with a fork until smooth.",
      "secondary_message": "2 avocados\r\njuice of 1 lime\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 17709,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": ""
    },
    {
      "id": 17710,
      "primary_message": "Add steak slices and any juices to skillet. Season with chili powder, cumin, salt, and pepper. Stir and cook for 1-2 minutes.",
      "secondary_message": "½ tsp chili powder\r\n½ tsp cumin\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 17711,
      "primary_message": "In another skillet or pan, warm tortillas for 20-30 seconds per side if desired.",
      "secondary_message": "8 small flour tortillas"
    },
    {
      "id": 17712,
      "primary_message": "Cut remaining lime into wedges.",
      "secondary_message": "1 lime"
    },
    {
      "id": 17713,
      "primary_message": "To serve, place tortillas on a plate and fill with fajita filling. Garnish with guacamole, remaining cilantro, and lime wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
