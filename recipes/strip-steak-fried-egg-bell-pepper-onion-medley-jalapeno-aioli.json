        "instructions": [
          {
            "id": 376482,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 376483,
            "primary_message": "Wash and dry the fresh produce. ",
            "secondary_message": "4 red bell peppers\n2 green bell peppers\n1 jalapeño pepper"
          },
          {
            "id": 376484,
            "primary_message": "Trim, seed, and medium dice bell peppers. Transfer to a large baking sheet pan. ",
            "secondary_message": null
          },
          {
            "id": 376485,
            "primary_message": "Peel, halve, and medium dice onion; add to the baking sheet with the bell pepper. Drizzle veggies with oil, season with salt and pepper, then toss to combine and spread out in an even layer.",
            "secondary_message": "1 medium yellow onion\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 376486,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring veggies halfway through, until fork-tender, about 15 minutes. Remove from oven. ",
            "secondary_message": null
          },
          {
            "id": 376487,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 376488,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 376489,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest. (Reserve skillet for later use.)",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 376490,
            "primary_message": "Meanwhile, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and place in a small bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 376491,
            "primary_message": "Add mayo, garlic powder, and salt to the bowl with the jalapeño. Stir to combine the aioli and set aside. ",
            "secondary_message": "¼ cup mayonnaise\n½ tsp garlic powder\n¼ tsp salt"
          },
          {
            "id": 376492,
            "primary_message": "When the steak is done, wipe the reserved skillet clean with paper towels, then return to medium heat. ",
            "secondary_message": null
          },
          {
            "id": 376493,
            "primary_message": "Once the skillet is hot, add additional oil, and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
            "secondary_message": "2 tsp extra virgin olive oil\n4 eggs\n⅛ tsp salt"
          },
          {
            "id": 376494,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 376495,
            "primary_message": "To serve, divide, steak, veggies, fried eggs, and aioli between plates. Enjoy!",
            "secondary_message": null
          }
        ],
