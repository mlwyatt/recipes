        "instructions": [
          {
            "id": 410723,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 410724,
            "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 410725,
            "primary_message": "Once the pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate and set aside to rest, 5 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 410726,
            "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into bite-sized pieces.",
            "secondary_message": "2 small bunches asparagus"
          },
          {
            "id": 410727,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 410728,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, salt, and pepper; cook, stirring occasionally, until tender, 4-5 minutes. Remove from heat, cover with a lid to keep warm, and set aside.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 410729,
            "primary_message": "Meanwhile, wash, dry, and quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh. Place in a medium bowl, along with the salsa, and stir to combine.",
            "secondary_message": "4 peaches\n1 cup salsa"
          },
          {
            "id": 410730,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 410731,
            "primary_message": "Divide steak, asparagus, and chips between plates; top steak with half of the salsa. Serve remaining salsa on the side for dipping. Enjoy!",
            "secondary_message": "4 oz tortilla chips"
          }
        ],
