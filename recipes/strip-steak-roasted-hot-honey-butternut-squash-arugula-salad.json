        "instructions": [
          {
            "id": 453093,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 453094,
            "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "1 small butternut squash\n1 lemon\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 453095,
            "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice the flesh. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
            "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 453096,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden and fork-tender, about 20 minutes.",
            "secondary_message": null
          },
          {
            "id": 453097,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 453098,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt"
          },
          {
            "id": 453099,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 453100,
            "primary_message": "When the squash is done, remove from the oven, then drizzle with honey and hot sauce. Stir to coat and set aside to cool slightly, about 5 minutes.",
            "secondary_message": "3 tbsp honey\n4 tsp hot sauce"
          },
          {
            "id": 453101,
            "primary_message": "Meanwhile, zest and juice lemon into a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 453102,
            "primary_message": "Peel and mince shallot. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
            "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 453103,
            "primary_message": "Add arugula and cooled squash to the bowl with the dressing, then toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 453104,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 453105,
            "primary_message": "To serve, divide steak and salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
