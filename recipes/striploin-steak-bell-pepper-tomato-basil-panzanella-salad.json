        "instructions": [
          {
            "id": 44527,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 pint grape tomatoes\n2 red bell peppers\n2 yellow bell peppers\n1 small pkg fresh basil"
          },
          {
            "id": 44528,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a large salad bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 44529,
            "primary_message": "To the garlic, add olive oil, red wine vinegar, Dijon, salt, and pepper; whisk together and set aside.",
            "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 44530,
            "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stems, seeds, and membranes. Large dice the peppers (cut into ¾-inch cubes) and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 44531,
            "primary_message": "Preheat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 44532,
            "primary_message": "Cut the buns into 1-inch cubes.",
            "secondary_message": "2 whole grain buns or rolls"
          },
          {
            "id": 44533,
            "primary_message": "Once the skillet is hot, add olive oil and the bread cubes. Cook, tossing occasionally, until the bread is crisp and lightly browned, 4 to 6 minutes. Once done, transfer to a bowl.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 44534,
            "primary_message": "Pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 44535,
            "primary_message": "Once the bread cubes have been transferred, increase the heat to medium-high. Once heated, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 44536,
            "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 44537,
            "primary_message": "Once the steak has been transferred, add the bell peppers to the skillet. Cook, tossing occasionally, until just tender, 3 to 4 minutes. Once done, return to the bowl.",
            "secondary_message": null
          },
          {
            "id": 44538,
            "primary_message": "Halve the grape tomatoes crosswise and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 44539,
            "primary_message": "Pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 44540,
            "primary_message": "Add the bell peppers and bread to the salad bowl; toss to combine.",
            "secondary_message": null
          },
          {
            "id": 44541,
            "primary_message": "Slice the steak against the grain into thin strips.",
            "secondary_message": ""
          },
          {
            "id": 44542,
            "primary_message": "To serve, divide the steak strips and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
