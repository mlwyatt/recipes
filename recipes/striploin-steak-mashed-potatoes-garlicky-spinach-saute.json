        "instructions": [
          {
            "id": 45697,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "4 medium yellow potatoes\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 45698,
            "primary_message": "Peel and quarter the potatoes lengthwise (into wedges); transfer to a medium saucepan. Cover with hot water (from the tap) by about 1 inch and bring to a boil over high heat.",
            "secondary_message": ""
          },
          {
            "id": 45699,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 45700,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 45701,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 45702,
            "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate, leaving any juices in the skillet, and let it rest for 5 to 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 45703,
            "primary_message": "Once the water in the saucepan is boiling, reduce the heat to medium and cook until the potatoes are tender when pierced with a knife, 8 to 12 minutes. Once done, reserve about 1 cup of liquid and drain the rest. Cover the saucepan to keep warm.",
            "secondary_message": ""
          },
          {
            "id": 45704,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 45705,
            "primary_message": "Once the steak has been transferred, reduce the heat to medium and add the garlic and spinach to the skillet; season with salt and pepper. Stir until the spinach is just wilted, 1 to 2 minutes, then remove from the heat.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 45706,
            "primary_message": "Add ½ of the reserved liquid, butter, salt, and pepper to the potatoes; mash with a potato masher until smooth. Add more liquid to thin out the mash if needed.",
            "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 45707,
            "primary_message": "To serve, divide the mashed potatoes between plates and top with the spinach sauté, then add the steak on the side. Enjoy!",
            "secondary_message": null
          }
        ],
