        "instructions": [
          {
            "id": 286167,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 286168,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb new potatoes\n1 small bunch fresh dill\n2 (8 oz) pkg sugar snap peas"
          },
          {
            "id": 286169,
            "primary_message": "Quarter potatoes, transfer to a large baking sheet pan, and drizzle with oil. Season with salt and pepper, toss to combine, and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and roast until starting to soften, about 15 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 286170,
            "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl, then add mayo, vinegar, Dijon, and spices; whisk to combine the dressing and set aside.",
            "secondary_message": "¼ cup mayonnaise\n4 tsp white wine vinegar\n4 tsp Dijon mustard\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 286171,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 286172,
            "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 286173,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate and loosely cover with aluminum foil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 286174,
            "primary_message": "While the steak is cooking, peel, halve, and slice shallots into ¼-inch thick half-moons.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 286175,
            "primary_message": "When the potatoes have started to soften, remove from the oven. Add shallot and snap peas, toss to combine, then spread out in an even layer. Return to the oven and roast until veggies are fork-tender, 10-12 minutes more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 286176,
            "primary_message": "When the veggies are done, add to the bowl with the dressing and toss to combine the potato salad.",
            "secondary_message": null
          },
          {
            "id": 286177,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 286178,
            "primary_message": "To serve, divide steak and warm potato salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
