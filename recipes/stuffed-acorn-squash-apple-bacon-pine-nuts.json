  "instructions": [
    {
      "id": 198023,
      "primary_message": "Preheat the oven to 450°F and place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 198024,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 acorn squash\n2 Gala apples"
    },
    {
      "id": 198025,
      "primary_message": "Cut squash in half lengthwise. Scoop out seeds; discard. Slice a small piece off the bottom of each squash half just enough so that they will sit level.",
      "secondary_message": null
    },
    {
      "id": 198026,
      "primary_message": "Drizzle cut-side with olive oil and season with salt and pepper. Flip squash halves, scooped sides down, in cast iron skillet (or a baking sheet). Bake until golden and fork-tender, 30-35 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 198027,
      "primary_message": "Meanwhile, heat a nonstick skillet to medium-high heat. Chop bacon into ¼-inch pieces and cook until almost crispy. Drain most of the fat. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 198028,
      "primary_message": "Peel and dice onion. Add to pan, stirring to combine. Sprinkle with thyme and sage. Cook together until onion is soft and caramelized.",
      "secondary_message": "1 medium yellow onion\n2 tsp sage\n¼ tsp thyme"
    },
    {
      "id": 198029,
      "primary_message": "Core, peel, and medium dice the apples. Add to pan, drizzle with maple syrup and salt. Cook 2-3 minutes until apple just starts to soften.",
      "secondary_message": "2 tbsp pure maple syrup\n⅛ tsp salt"
    },
    {
      "id": 198030,
      "primary_message": "Add pine nuts and cook for 1 minute.",
      "secondary_message": "⅔ cup pine nuts"
    },
    {
      "id": 198031,
      "primary_message": "Remove the squash from the oven. Stuff each half with the bacon mixture. ",
      "secondary_message": null
    },
    {
      "id": 198032,
      "primary_message": "To serve, divide squash halves between plates. Enjoy!",
      "secondary_message": null
    }
  ],
