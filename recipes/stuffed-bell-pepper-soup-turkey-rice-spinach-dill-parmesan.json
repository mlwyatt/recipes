  "instructions": [
    {
      "id": 267928,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267929,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add turkey, salt, and pepper to the pot; cook, breaking apart with a spoon, until browned and crumbly, 3-4 minutes. Transfer turkey to a plate and set aside. (Reserve pot for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb ground turkey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 267930,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 sticks celery\n2 medium carrots\n2 green bell peppers\n1 (5 oz) pkg baby spinach\n1 small bunch fresh dill"
    },
    {
      "id": 267931,
      "primary_message": "Trim and small dice celery; peel, trim, and small dice carrots. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 267932,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips, then cut crosswise into bite-sized pieces. Add to the bowl with the celery and carrot.",
      "secondary_message": null
    },
    {
      "id": 267933,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 267934,
      "primary_message": "Return the pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267935,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add veggies and spices; sauté, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 267936,
      "primary_message": "Return turkey to the pot along with broth, tomatoes, and rice; stir to combine and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until rice is soft and veggies are tender, about 12 minutes.",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes\n⅔ cup basmati rice"
    },
    {
      "id": 267937,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 267938,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach and set aside.",
      "secondary_message": null
    },
    {
      "id": 267939,
      "primary_message": "Finely grate Parmesan and set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 267940,
      "primary_message": "When the soup is done, add spinach and dill to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 267941,
      "primary_message": "To serve, divide soup between bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
