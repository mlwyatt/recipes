        "instructions": [
          {
            "id": 442789,
            "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
            "secondary_message": null
          },
          {
            "id": 442790,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 red bell peppers\n2 jalapeño peppers\n2 (1 inch) pieces ginger root\n1 lime\n1 English cucumber\n1 small bunch cilantro"
          },
          {
            "id": 442791,
            "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, and season with salt; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt"
          },
          {
            "id": 442792,
            "primary_message": "Meanwhile, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and divide between a small and medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 442793,
            "primary_message": "Peel and mince ginger and garlic. Add both to the small bowl with the jalapeño, along with tomato paste and spices. Stir to combine the spice paste and set aside.",
            "secondary_message": "4 cloves garlic\n4 tbsp tomato paste\n2 tsp garam masala\n2 tsp coriander, ground\n1 ½ tsp salt\n1 tsp turmeric, ground\n1 tsp cumin, ground\n½ tsp cayenne pepper"
          },
          {
            "id": 442794,
            "primary_message": "Juice lime into the medium bowl with the jalapeño. Add honey, cumin, and salt, then stir to combine the dressing.",
            "secondary_message": "2 tsp honey\n1 tsp cumin, ground\n½ tsp salt"
          },
          {
            "id": 442795,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 442796,
            "primary_message": "While the skillet heats up, peel, halve, and mince onion. Add half to the medium bowl with the dressing and set aside for the salad. (Reserve remaining onion for the next step.)",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 442797,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add reserved onion and salt; cook, stirring occasionally, until beginning to soften and brown, 3-4 minutes. ",
            "secondary_message": "4 tsp extra virgin olive oil\n⅛ tsp salt"
          },
          {
            "id": 442798,
            "primary_message": "Add beef to the skillet and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
            "secondary_message": "1 ½ lb lean ground beef"
          },
          {
            "id": 442799,
            "primary_message": "Meanwhile, trim and medium dice cucumber. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 442800,
            "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl.",
            "secondary_message": "2 cups frozen corn"
          },
          {
            "id": 442801,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl and stir to combine the salad; set aside. (Reserve remaining cilantro for later use.)",
            "secondary_message": null
          },
          {
            "id": 442802,
            "primary_message": "When the beef is done, add spice paste to the skillet. Cook, stirring frequently, until fragrant, about 1 minute. ",
            "secondary_message": null
          },
          {
            "id": 442803,
            "primary_message": "Add peas, water, vinegar, and reserved cilantro to the skillet. Continue to cook, stirring occasionally, until peas are warmed through, about 1 minute. Remove from heat.",
            "secondary_message": "2 cups frozen peas\n¾ cup water\n2 tsp rice vinegar"
          },
          {
            "id": 442804,
            "primary_message": "Stuff pepper halves with beef mixture, then divide between plates. Serve with salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
