        "instructions": [
          {
            "id": 378454,
            "primary_message": "Wash and dry snap peas. Set aside.",
            "secondary_message": "2 (8 oz) pkg sugar snap peas"
          },
          {
            "id": 378455,
            "primary_message": "Wash, dry, and juice lemon into a blender. (Alternatively, the hummus can be prepared in a food processor.)",
            "secondary_message": "1 lemon"
          },
          {
            "id": 378456,
            "primary_message": "Drain and rinse chickpeas. Add to the blender.",
            "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
          },
          {
            "id": 378457,
            "primary_message": "Peel and roughly chop garlic. Add to the blender.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 378458,
            "primary_message": "Roughly chop sun-dried tomatoes. Add to the blender along with water, tahini, oil, and spices. Blend on high for several minutes until smooth. Add more water to the hummus, one tablespoon at a time, if needed, to reach desired consistency.",
            "secondary_message": "12 sun-dried tomatoes, oil-packed\n½ cup water\n2 tbsp tahini\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp cumin, ground\n¼ tsp paprika"
          },
          {
            "id": 378459,
            "primary_message": "To serve, divide hummus and snap peas between plates. Enjoy!",
            "secondary_message": null
          }
        ],
