  "instructions": [
    {
      "id": 117268,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap). Add salt, cover with a lid and bring to a boil over high heat.",
      "secondary_message": "2 tsp salt"
    },
    {
      "id": 117269,
      "primary_message": "Wash the broccoli and cut the florets into bite-sized pieces. Peel and small dice (or julienne) the stems. ",
      "secondary_message": "4 crowns broccoli"
    },
    {
      "id": 117270,
      "primary_message": "Once the water comes to a boil, uncover, add broccoli florets and stems, and stir for a few seconds. Cook until crisp-tender, about 3 minutes. Once done, drain in a colander and then lay the broccoli on a clean towel and pat dry. ",
      "secondary_message": null
    },
    {
      "id": 117271,
      "primary_message": "Cut chicken into 1-inch pieces. Season with spices and toss to coat. ",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 117272,
      "primary_message": "Preheat a skillet over medium-high heat. When the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 117273,
      "primary_message": "Add the chicken to the skillet; cook, stirring occasionally, until the pieces are browned and cooked through, 4-6 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 117274,
      "primary_message": "Meanwhile, peel and small dice onion. Peel and mince garlic. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 117275,
      "primary_message": "Thinly slice sun-dried tomatoes.",
      "secondary_message": "20 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 117276,
      "primary_message": "Return the pot to medium heat and add oil, onion, garlic, tomatoes, and crushed red peppers. Cook, stirring frequently, until onions are translucent, about 3 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp crushed red pepper"
    },
    {
      "id": 117277,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 117278,
      "primary_message": "Add the broccoli and chicken to the pot and continue to cook, stirring continuously, until broccoli and chicken are heated through, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 117279,
      "primary_message": "To serve, divide between plates and top with Parmesan cheese and pine nuts. Enjoy!",
      "secondary_message": "¼ cup pine nuts"
    }
  ],
