  "instructions": [
    {
      "id": 377014,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz spaghetti pasta"
    },
    {
      "id": 377015,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 377016,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, salt, and pepper; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 (8 oz) pkg sliced white mushrooms\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 377017,
      "primary_message": "Add spinach, Alfredo sauce, pesto, and water to the skillet; cook, stirring often, until heated through, about 5 minutes. Reduce heat to low and allow to simmer gently until the pasta is finished cooking.",
      "secondary_message": "1 (16oz) bag frozen chopped spinach\n1 (16 oz) jar Alfredo sauce\n⅔ cup sun-dried tomato pesto\n¼ cup water"
    },
    {
      "id": 377018,
      "primary_message": "When the pasta is done, drain in a colander and add to the skillet with the sauce. Toss to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 377019,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
