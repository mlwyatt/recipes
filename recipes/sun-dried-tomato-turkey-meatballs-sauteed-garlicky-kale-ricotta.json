        "instructions": [
          {
            "id": 383917,
            "primary_message": "Preheat the oven to 425°F. Coat a large baking dish with a thin layer of oil and set aside.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 383918,
            "primary_message": "Finely grate Parmesan. Place in a small bowl along with ricotta, salt, and pepper; stir to combine. Set aside.",
            "secondary_message": "2 oz Parmesan cheese\n1 (15 oz) pkg ricotta cheese\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 383919,
            "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve the other half for serving.)",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 383920,
            "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the parsley along with half of the cheese mixture, turkey, bread crumbs, eggs, and spices. Using your hands, mix well to combine. (Reserve remaining cheese mixture for serving.)",
            "secondary_message": "10 sun-dried tomatoes, oil-packed\n1 ½ lb ground turkey\n⅔ cup panko bread crumbs\n2 eggs\n1 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
          },
          {
            "id": 383921,
            "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs and place in the baking dish.",
            "secondary_message": null
          },
          {
            "id": 383922,
            "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until meatballs are lightly browned and nearly cooked through, about 15 minutes.",
            "secondary_message": null
          },
          {
            "id": 383923,
            "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a large bowl. ",
            "secondary_message": "2 bunches kale"
          },
          {
            "id": 383924,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 383925,
            "primary_message": "While the skillet heats up, peel and thinly slice garlic. Add to the bowl with the kale.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 383926,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and kale to the skillet in handfuls, waiting for kale to wilt slightly before adding the next handful. Cook, stirring frequently, until the kale is tender, 1-2 minutes more. (Reserve bowl for later use.)",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 383927,
            "primary_message": "Add vinegar, crushed red pepper, and salt to the skillet with the kale; stir to combine. Remove from heat and cover with a lid to keep warm.",
            "secondary_message": "2 tsp balsamic vinegar\n½ tsp crushed red pepper\n¼ tsp salt"
          },
          {
            "id": 383928,
            "primary_message": "Place tomato sauce, Italian seasoning, and additional crushed red pepper in the reserved bowl. Stir to combine the sauce.",
            "secondary_message": "2 (8 oz) cans tomato sauce\n1 tsp Italian seasoning\n½ tsp crushed red pepper"
          },
          {
            "id": 383929,
            "primary_message": "When the meatballs are lightly browned, remove from oven. Pour tomato sauce over meatballs, return to oven, and continue to bake until the sauce is warm and meatballs are cooked through, 2-3 minutes more. Remove from oven. ",
            "secondary_message": null
          },
          {
            "id": 383930,
            "primary_message": "To serve, divide meatballs, sauce, kale, and reserved cheese mixture between plates or bowls. Top with reserved parsley and enjoy!",
            "secondary_message": null
          }
        ],
