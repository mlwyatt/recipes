        "instructions": [
          {
            "id": 162198,
            "primary_message": "Wash and shave the dill leaves off the stems; discard the stems and mince the leaves. Reserve a small amount for garnish.",
            "secondary_message": "1 small bunch fresh dill"
          },
          {
            "id": 162199,
            "primary_message": "Preheat a nonstick skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 162200,
            "primary_message": "In a medium bowl, whisk together eggs, salt, and pepper.",
            "secondary_message": "12 eggs\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 162201,
            "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
            "secondary_message": "1 tbsp butter, unsalted"
          },
          {
            "id": 162202,
            "primary_message": "Add ½ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing the uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
            "secondary_message": null
          },
          {
            "id": 162203,
            "primary_message": "Sprinkle the cheese and ½ of the dill over one side of the omelet. Fold the omelet in half and cook until warmed through, about 1 minute. ",
            "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 162204,
            "primary_message": "Add more butter to the skillet and repeat with remaining egg mixture, cheese, and dill.",
            "secondary_message": "1 tbsp butter, unsalted\n½ (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 162205,
            "primary_message": "Wash and slice oranges into rounds.",
            "secondary_message": "2 oranges"
          },
          {
            "id": 162206,
            "primary_message": "To serve, cut omelets in half and divide between plates; garnish with reserved dill. Enjoy with orange slices on the side!",
            "secondary_message": null
          }
        ],
