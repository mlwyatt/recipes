        "instructions": [
          {
            "id": 428965,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 428966,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small bunch cilantro\n1 small pineapple\n4 red bell peppers"
          },
          {
            "id": 428967,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 428968,
            "primary_message": "While the rice is cooking, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a small bowl along with stir-fry sauce, hot sauce, and honey. Stir to combine the sauce and set aside. (Reserve remaining cilantro for serving.)",
            "secondary_message": "1 cup stir-fry sauce\n3 tbsp hot sauce\n4 tsp honey"
          },
          {
            "id": 428969,
            "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice the flesh. Place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 428970,
            "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Add to the bowl with the pineapple. ",
            "secondary_message": null
          },
          {
            "id": 428971,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 428972,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pineapple and bell pepper; cook, stirring occasionally, until bell pepper is starting to soften, 2-3 minutes.",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 428973,
            "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 428974,
            "primary_message": "When the bell pepper is soft, add shrimp to the skillet. Cook, stirring occasionally, until shrimp are almost cooked through, 2-3 minutes.",
            "secondary_message": null
          },
          {
            "id": 428975,
            "primary_message": "Add the sauce to the skillet. Continue to cook, stirring occasionally, until sauce thickens slightly and shrimp are cooked through, 1-2 minutes more. Remove from heat and cover to keep warm. ",
            "secondary_message": null
          },
          {
            "id": 428976,
            "primary_message": "To serve, divide rice and stir-fry between plates or bowls, then sprinkle with reserved cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
