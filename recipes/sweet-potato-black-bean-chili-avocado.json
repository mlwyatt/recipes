        "instructions": [
          {
            "id": 29727,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb sweet potatoes\n2 avocados\n1 small bunch cilantro"
          },
          {
            "id": 29728,
            "primary_message": "Peel and small dice the onion into ¼-inch pieces; transfer to a small bowl.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 29729,
            "primary_message": "Peel and mince the garlic; transfer to a small bowl.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 29730,
            "primary_message": "Preheat a medium saucepan over medium heat.",
            "secondary_message": null
          },
          {
            "id": 29731,
            "primary_message": "Drain and rinse the beans; set aside.",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 29732,
            "primary_message": "Once the saucepan is warm, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 29733,
            "primary_message": "Add the onion to the saucepan; cook, stirring frequently, until softened, 3 to 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 29734,
            "primary_message": "While the onion cooks, peel and medium dice the sweet potatoes into ½-inch cubes; leave on cutting board.",
            "secondary_message": null
          },
          {
            "id": 29735,
            "primary_message": "Add the garlic and sweet potatoes to the saucepan and stir to combine; cook, stirring occasionally, for 2 to 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 29736,
            "primary_message": "Add the beans to the saucepan and season with chili powder, cumin, salt, and pepper. Stir until fragrant, 15 to 30 seconds.",
            "secondary_message": "2 tbsp chili powder\n1 tsp cumin\n1 tsp salt\n1 tsp black pepper"
          },
          {
            "id": 29737,
            "primary_message": "Add the diced tomatoes to the saucepan and stir to combine. Bring to a boil, then reduce the heat to medium-low and cover with a lid. Cook the chili until the sweet potatoes are tender, 5 to 7 minutes.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes"
          },
          {
            "id": 29738,
            "primary_message": "While the chili cooks, halve the avocados lengthwise and twist to open, then remove the pit with a knife or spoon; scoop out and medium dice the flesh. Transfer to a small bowl.",
            "secondary_message": ""
          },
          {
            "id": 29739,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Stir half into the chili and transfer the rest to a small bowl (for garnishing).",
            "secondary_message": null
          },
          {
            "id": 29740,
            "primary_message": "To serve, spoon the chili into a bowl and garnish with the avocado and remaining cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
