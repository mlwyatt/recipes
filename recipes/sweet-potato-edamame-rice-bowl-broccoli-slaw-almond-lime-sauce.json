        "instructions": [
          {
            "id": 274739,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 274740,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 274741,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 274742,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb sweet potatoes\n2 (1 inch) pieces ginger root\n2 limes\n1 red bell pepper\n1 small bunch green onions (scallions)\n1 small bunch cilantro"
          },
          {
            "id": 274743,
            "primary_message": "Peel and medium dice sweet potatoes; transfer to a baking sheet pan, drizzle with oil, and season with spices. Toss to combine, then spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n¼ tsp coriander, ground\n¼ tsp cumin, ground"
          },
          {
            "id": 274744,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing once, until sweet potatoes are fork-tender, about 20 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 274745,
            "primary_message": "While the sweet potatoes are roasting, place edamame in a colander and rinse under hot water (from the tap) to thaw. Set aside to drain.",
            "secondary_message": "1 ½ cups edamame"
          },
          {
            "id": 274746,
            "primary_message": "Peel and mince ginger and garlic; place both in a small bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 274747,
            "primary_message": "Juice limes into the bowl with the ginger and garlic; add almond butter, water, and soy sauce. Whisk to combine the sauce, adding additional water, a few teaspoons at a time, if necessary, to reach a drizzling consistency. Set sauce aside.",
            "secondary_message": "⅓ cup natural almond butter\n¼ cup water\n1 tbsp soy sauce"
          },
          {
            "id": 274748,
            "primary_message": "Trim, seed, and cut bell pepper into thin strips; transfer to a plate.",
            "secondary_message": null
          },
          {
            "id": 274749,
            "primary_message": "Trim and cut green onions crosswise into ¼-inch pieces; add to the plate with the bell pepper.",
            "secondary_message": null
          },
          {
            "id": 274750,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 274751,
            "primary_message": "When the rice is done, add cilantro and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 274752,
            "primary_message": "To serve, divide rice, roasted sweet potatoes, broccoli slaw, edamame, bell pepper, and green onions between bowls. Drizzle with sauce and enjoy! ",
            "secondary_message": "1 (12 oz) pkg broccoli slaw"
          }
        ],
