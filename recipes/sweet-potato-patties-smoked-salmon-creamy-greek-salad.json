        "instructions": [
          {
            "id": 180136,
            "primary_message": "In a medium bowl, whisk the eggs.",
            "secondary_message": "2 eggs"
          },
          {
            "id": 180137,
            "primary_message": "Wash, peel, and coarsely grate the sweet potatoes. Use a paper towel or a clean cloth to squeeze out the excess moisture and add to the bowl with the eggs. ",
            "secondary_message": "2 lb sweet potatoes"
          },
          {
            "id": 180138,
            "primary_message": "Peel and mince shallots. Add to the bowl along with flour, salt, and pepper; stir to combine.",
            "secondary_message": "2 shallots\n2 tbsp all-purpose flour\n½ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 180139,
            "primary_message": "Heat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "¼ cup extra virgin olive oil"
          },
          {
            "id": 180140,
            "primary_message": "Using a ¼ cup measure, form the potato mixture into patties. Working in batches if necessary, add patties to the skillet and flatten into ½-thick circles using the back of a spatula. Cook, flipping once, until golden and cooked through, 6-8 minutes. Remove to a paper towel-lined plate.",
            "secondary_message": null
          },
          {
            "id": 180141,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 small bunch fresh dill\n1 pint grape tomatoes\n2 English cucumbers"
          },
          {
            "id": 180142,
            "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. Place in a large bowl. ",
            "secondary_message": null
          },
          {
            "id": 180143,
            "primary_message": "Add yogurt, feta, vinegar, capers, and honey to the bowl with the dill; whisk to combine the dressing.",
            "secondary_message": "1 cup plain Greek yogurt\n1 (4 oz) pkg crumbled feta cheese\n2 tbsp apple cider vinegar\n1 tbsp capers\n4 tsp honey"
          },
          {
            "id": 180144,
            "primary_message": "Halve olives and add to the bowl with the dressing.",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 180145,
            "primary_message": "Halve tomatoes lengthwise and add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 180146,
            "primary_message": "Trim cucumbers; quarter lengthwise, then slice crosswise into ¼-inch thick pieces. Add to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 180147,
            "primary_message": "To serve, divide patties, salmon, and salad between plates. Enjoy! ",
            "secondary_message": "2 (4 oz) pkgs smoked salmon"
          }
        ],
