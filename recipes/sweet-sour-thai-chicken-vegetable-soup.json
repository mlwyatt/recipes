        "instructions": [
          {
            "id": 191664,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n2 medium carrots\n1 orange bell pepper\n2 caps portobello mushrooms\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 191665,
            "primary_message": "Cut chicken into 1-inch pieces, set aside.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
          },
          {
            "id": 191666,
            "primary_message": "Heat coconut oil in a large pot over medium heat.",
            "secondary_message": "3 tbsp virgin coconut oil"
          },
          {
            "id": 191667,
            "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add both to the pot.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 191668,
            "primary_message": "Add to the pot turmeric and crushed red pepper, stirring until fragrant, about 30 seconds.",
            "secondary_message": "2 tsp turmeric\n⅛ tsp crushed red pepper"
          },
          {
            "id": 191669,
            "primary_message": "Add chicken pieces to pot, stirring occasionally. ",
            "secondary_message": null
          },
          {
            "id": 191670,
            "primary_message": "Peel and thinly slice carrots on the bias. Cut the bell pepper lengthwise into quarters; remove and discard the seeds and white membrane then slice thinly. Add veggies to the pot. ",
            "secondary_message": null
          },
          {
            "id": 191671,
            "primary_message": "Remove the stems from the mushrooms and carefully scrape out the gills with a spoon, making sure not to damage the rim of the mushrooms. Cut cap in half, thinly slice and add to the pot.",
            "secondary_message": null
          },
          {
            "id": 191672,
            "primary_message": "Cook chicken and vegetables, stirring occasionally, until vegetables are tender, about 5-7 minutes.",
            "secondary_message": null
          },
          {
            "id": 191673,
            "primary_message": "Add broth, coconut milk, fish sauce, honey, and vinegar and stir to combine.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n2 tbsp fish sauce\n2 tbsp honey\n1 tbsp rice vinegar"
          },
          {
            "id": 191674,
            "primary_message": "Bring soup to boil and then reduce heat to low. Simmer for 8-10 minutes, allowing the chicken to cook fully and flavors to blend.",
            "secondary_message": null
          },
          {
            "id": 191675,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. ",
            "secondary_message": null
          },
          {
            "id": 191676,
            "primary_message": "Juice the lime and add to the pot right before serving, stir to combine. ",
            "secondary_message": null
          },
          {
            "id": 191677,
            "primary_message": "To serve, divide soup between bowls and garnish with cilantro. Enjoy!",
            "secondary_message": null
          }
        ],
