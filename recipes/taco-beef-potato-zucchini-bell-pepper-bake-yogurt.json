  "instructions": [
    {
      "id": 327357,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 327358,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 yellow bell peppers\n1 ½ lb new potatoes"
    },
    {
      "id": 327359,
      "primary_message": "Peel, halve, and medium dice onion; transfer to a large baking sheet pan.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 327360,
      "primary_message": "Trim and medium dice zucchini; trim, seed, and medium dice bell peppers. Add both to the baking sheet with the onion.",
      "secondary_message": null
    },
    {
      "id": 327361,
      "primary_message": "Quarter potatoes and add to the baking sheet. Drizzle veggies with oil and sprinkle with taco seasoning; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp taco seasoning"
    },
    {
      "id": 327362,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are tender 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 327363,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 327364,
      "primary_message": "Once the skillet is hot, add beef and spices; cook, breaking the meat apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "1 ½ lb lean ground beef\n3 tbsp taco seasoning\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 327365,
      "primary_message": "Add water to the skillet with the beef; continue to cook, stirring occasionally, until sauce has thickened and beef is cooked through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 327366,
      "primary_message": "To serve, divide roasted veggies between plates or bowls; top with beef and a dollop yogurt. Enjoy!",
      "secondary_message": "1 cup plain Greek yogurt"
    }
  ],
