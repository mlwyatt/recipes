        "instructions": [
          {
            "id": 37960,
            "primary_message": "Wash and dry the fresh produce (skip the lettuce until the next step).",
            "secondary_message": "1 pint grape tomatoes\n1 small bunch green onions (scallions)"
          },
          {
            "id": 37961,
            "primary_message": "Trim off and discard the root end of the lettuce; separate the leaves, then wash and dry them. Transfer to a plate.",
            "secondary_message": "2 heads butter (Boston) lettuce"
          },
          {
            "id": 37962,
            "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 37963,
            "primary_message": "Quarter the grape tomatoes and transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 37964,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 37965,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces).",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 37966,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 37967,
            "primary_message": "Add the onion to the skillet; cook, stirring frequently, until softened, 3 to 4 minutes.",
            "secondary_message": null
          },
          {
            "id": 37968,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 37969,
            "primary_message": "Add the garlic, chili powder, cumin, salt, and pepper to the onion; stir until fragrant, 15 to 30 seconds.",
            "secondary_message": "1 tbsp chili powder\n1 tsp cumin\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 37970,
            "primary_message": "Add the ground beef to the skillet and; cook, breaking apart with a spoon, until browned and crumbly, 4 to 5 minutes.",
            "secondary_message": "1 ½ lb lean ground beef"
          },
          {
            "id": 37971,
            "primary_message": "Coarsely grate ½ cup of cheddar.",
            "secondary_message": "½ (8 oz) block cheddar cheese"
          },
          {
            "id": 37972,
            "primary_message": "To serve, double up the lettuce leaves and fill with the ground beef mixture, tomatoes, cheddar, and green onions. Alternatively, combine all of the ingredients in a bowl to make a salad. Enjoy!",
            "secondary_message": null
          }
        ],
