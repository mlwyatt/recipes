        "instructions": [
          {
            "id": 435633,
            "primary_message": "Place water and salt in a medium saucepan, cover, and bring to a boil over high heat.",
            "secondary_message": "28 fl oz (3 ½ cups) water\n⅛ tsp salt"
          },
          {
            "id": 435634,
            "primary_message": "Once boiling, stir in oats, honey, and cardamom. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency.",
            "secondary_message": "2 cup oats, quick cooking\n2 tsp honey\n¼ tsp cardamom, ground"
          },
          {
            "id": 435635,
            "primary_message": "Meanwhile, wash, dry, and peel oranges; separate into segments and roughly chop the flesh.",
            "secondary_message": "2 oranges"
          },
          {
            "id": 435636,
            "primary_message": "Roughly chop dates.",
            "secondary_message": "⅔ cup medjool dates, pitted"
          },
          {
            "id": 435637,
            "primary_message": "When the oatmeal is done, add tahini to the saucepan and stir to combine. Remove from heat.",
            "secondary_message": "2 tbsp tahini"
          },
          {
            "id": 435638,
            "primary_message": "To serve, divide oatmeal between bowls; top with oranges, dates, and sesame seeds. Drizzle with honey and enjoy!",
            "secondary_message": "2 tsp sesame seeds\n4 tsp honey"
          }
        ],
