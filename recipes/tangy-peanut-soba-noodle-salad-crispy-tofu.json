  "instructions": [
    {
      "id": 31094,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 31095,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "2 (8 oz) pkg sugar snap peas\n4 medium carrots\n2 (1 inch) pieces ginger root\n2 limes\n1 small bunch cilantro"
    },
    {
      "id": 31096,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 31097,
      "primary_message": "Drain and medium dice (cut into ¾-inch cubes) the tofu; place the cubes on paper towels and pat dry.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 31098,
      "primary_message": "Once the skillet is hot, add sesame oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 31099,
      "primary_message": "Add the tofu to the skillet; cook, stirring occasionally, until golden brown, 5 to 6 minutes. Once done, transfer the tofu to a plate.",
      "secondary_message": null
    },
    {
      "id": 31100,
      "primary_message": "Once the water in the saucepan is boiling, add the noodles; cook according to package directions, about 5 to 7 minutes. Once done, drain the noodles in a colander and rinse under cold water; set aside.",
      "secondary_message": "10 oz soba (buckwheat) noodles"
    },
    {
      "id": 31101,
      "primary_message": "Juice the limes into a medium bowl (that will be used for the salad dressing).",
      "secondary_message": null
    },
    {
      "id": 31102,
      "primary_message": "Peel and grate or mince the ginger; add the ginger to the medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 31103,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic and add to the medium bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 31104,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop about ¾ of the leaves (save the rest for garnishing). Add the chopped cilantro to the medium bowl.",
      "secondary_message": null
    },
    {
      "id": 31105,
      "primary_message": "To make the dressing, add peanut butter, soy sauce, honey, sesame oil, and crushed red pepper to the medium bowl; whisk the ingredients together.",
      "secondary_message": "6 tbsp natural peanut butter\n4 tbsp soy sauce\n2 tbsp honey\n2 tsp toasted sesame oil\n½ tsp crushed red pepper"
    },
    {
      "id": 31106,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Using a box grater, coarsely grate the carrots and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 31107,
      "primary_message": "Halve the sugar snap peas at an angle and add to the large bowl.",
      "secondary_message": null
    },
    {
      "id": 31108,
      "primary_message": "Add the noodles and tofu to the large bowl with the carrots and peas and pour the dressing over top; toss until everything is well coated with the sauce.",
      "secondary_message": null
    },
    {
      "id": 31109,
      "primary_message": "To serve, place the noodle mixture into a bowl and garnish with the remaining cilantro leaves. Enjoy!",
      "secondary_message": null
    }
  ],
