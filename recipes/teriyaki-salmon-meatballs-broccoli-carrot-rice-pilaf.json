  "instructions": [
    {
      "id": 184776,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 184777,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 medium carrots\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 184778,
      "primary_message": "Peel and mince the onions. Transfer half to a large bowl and set aside. Transfer the rest to a medium saucepan.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 184779,
      "primary_message": "Chop broccoli into small pieces. Peel, trim, and small dice carrots. Add both to the saucepan with the onion.",
      "secondary_message": null
    },
    {
      "id": 184780,
      "primary_message": "Add rice and broth to the pan with the veggies, stirring to combine. Bring to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 184781,
      "primary_message": "Meanwhile, drain salmon and place in the bowl with the onion. Add bread crumbs, eggs, salt, and pepper; mix well to combine.",
      "secondary_message": "2 (7.5 oz) cans wild pink salmon, traditional style\n½ cup panko bread crumbs\n2 eggs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 184782,
      "primary_message": "Once the liquid comes to a boil, scrape down the edges of the saucepan so that all of the rice grains are in the liquid. Cover the saucepan, reduce heat to low, and cook until the liquid is fully absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 184783,
      "primary_message": "Coat a large baking dish with a thin layer of oil. Form the salmon mixture into 2-inch rounded meatballs and place them in the baking dish. Place the dish in the oven and bake until set, 15-18 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 184784,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 184785,
      "primary_message": "Combine garlic, ginger, soy sauce, honey, and vinegar in small saucepan. Bring to a boil over high heat and cook until slightly thickened, 2 minutes.",
      "secondary_message": "½ cup soy sauce\n¼ cup honey\n¼ cup rice vinegar"
    },
    {
      "id": 184786,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "¼ cup water\n4 tsp cornstarch"
    },
    {
      "id": 184787,
      "primary_message": "Add cornstarch slurry to the saucepan in a steady stream while stirring quickly. Cook, stirring often, until sauce thickens, 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 184788,
      "primary_message": "Once the salmon meatballs are done, pour the teriyaki sauce over the meatballs and gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 184789,
      "primary_message": "To serve, divide rice and salmon meatballs between plates. Garnish with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
