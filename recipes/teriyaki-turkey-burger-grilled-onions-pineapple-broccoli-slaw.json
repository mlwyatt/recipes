        "instructions": [
          {
            "id": 331789,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 small pineapple\n6 baby bok choy"
          },
          {
            "id": 331790,
            "primary_message": "Peel and mince ginger and garlic; place both in a small saucepan.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 331791,
            "primary_message": "Add broth, soy sauce, vinegar, sugar, and chili-garlic sauce to the saucepan with the ginger and garlic; whisk to combine. Place over high heat and bring to a boil.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n¼ cup soy sauce\n4 tsp rice vinegar\n2 tsp brown sugar\n1 tsp chili-garlic sauce"
          },
          {
            "id": 331792,
            "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth. Once the liquid in the saucepan comes to a boil, add slurry in a steady stream while whisking quickly. Let boil for 1 minute, then remove teriyaki sauce from heat and set aside.",
            "secondary_message": "¼ cup water\n2 tbsp cornstarch"
          },
          {
            "id": 331793,
            "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 331794,
            "primary_message": "While the pan heats up, peel and slice onion crosswise into thin rings. Transfer to a plate, drizzle with oil, and season with salt on both sides. ",
            "secondary_message": "1 medium red onion\n1 tsp toasted sesame oil\n¼ tsp salt"
          },
          {
            "id": 331795,
            "primary_message": "Once the pan is hot, add the onions and grill, flipping once, until tender and lightly charred, 3-4 minutes. Return onions to the plate and loosely cover with aluminum foil. (Reserve pan for the burger patties.)",
            "secondary_message": null
          },
          {
            "id": 331796,
            "primary_message": "Meanwhile, place turkey, bread crumbs, salt, pepper, and half of the teriyaki sauce in a medium bowl; mix with your hands until well combined. Form the turkey mixture into 4 equal-sized patties and place on another plate. (Reserve remaining teriyaki sauce for serving.)",
            "secondary_message": "1 ½ lb ground turkey\n½ cup panko bread crumbs\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 331797,
            "primary_message": "When the onions are done, return the pan to medium-high heat and coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 5-6 minutes, until cooked through. Add to the plate with the onions and re-cover with foil.",
            "secondary_message": "4 tsp toasted sesame oil"
          },
          {
            "id": 331798,
            "primary_message": "While the patties are cooking, place additional oil, soy sauce, vinegar, sugar, and chili-garlic sauce in a clean medium bowl; whisk to combine the dressing.",
            "secondary_message": "2 tbsp toasted sesame oil\n4 tsp soy sauce\n2 tsp rice vinegar\n1 tsp brown sugar\n1 tsp chili-garlic sauce"
          },
          {
            "id": 331799,
            "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice. Add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 331800,
            "primary_message": "Trim and thinly slice bok choy crosswise into shred-like strips; add to the bowl, along with the broccoli slaw, and toss to combine.",
            "secondary_message": "1 (12 oz) pkg broccoli slaw"
          },
          {
            "id": 331801,
            "primary_message": "Toast buns if desired.",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 331802,
            "primary_message": "Place bottom half of each bun on a plate; layer with burger patties, remaining teriyaki sauce, onions, and a small portion of the slaw. Close with the top half of each bun and serve with remaining slaw on the side. Enjoy!",
            "secondary_message": null
          }
        ],
