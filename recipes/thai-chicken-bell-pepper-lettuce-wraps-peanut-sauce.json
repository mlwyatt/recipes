  "instructions": [
    {
      "id": 29289,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 heads butter (Boston) lettuce\n2 red bell peppers\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 29290,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Small dice the peppers and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 29291,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 29292,
      "primary_message": "Juice the lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 29293,
      "primary_message": "Peel and mince the garlic; add to the lime juice.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 29294,
      "primary_message": "Measure out the peanuts and roughly chop; transfer to a small bowl.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 29295,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 29296,
      "primary_message": "Cut the chicken into small bite-sized pieces, then season with salt and pepper.",
      "secondary_message": "2 lb chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 29297,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 29298,
      "primary_message": "Add the chicken to the skillet; cook, stirring occasionally, until golden brown and cooked through, 3 to 4 minutes. Once done, transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 29299,
      "primary_message": "Separate the lettuce head into leaves and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 29300,
      "primary_message": "Once the chicken has been transferred, add more coconut oil to the skillet followed by the bell peppers. Cook, stirring occasionally, until tender-crisp, 3 to 4 minutes. Once done, add to the bowl of chicken and mix together.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 29301,
      "primary_message": "To make the sauce, add peanut butter, soy sauce, honey, sesame oil, and crushed red pepper to the lime juice and minced garlic and whisk together. If the sauce is too thick, add a little bit of water.",
      "secondary_message": "4 tbsp natural peanut butter\n2 tbsp soy sauce\n1 tsp honey\n½ tsp toasted sesame oil\n¼ tsp crushed red pepper"
    },
    {
      "id": 29302,
      "primary_message": "To serve, scoop the chicken and pepper mixture into lettuce leaves, then top with the peanut sauce, cilantro, and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
