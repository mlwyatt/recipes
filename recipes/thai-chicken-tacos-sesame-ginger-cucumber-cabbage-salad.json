  "instructions": [
    {
      "id": 455021,
      "primary_message": "Place curry paste, oil, and fish sauce in a medium bowl. Whisk to combine the marinade.",
      "secondary_message": "4 tsp Thai curry paste, red\n2 tsp toasted sesame oil\n2 tsp fish sauce"
    },
    {
      "id": 455022,
      "primary_message": "Slice chicken into ½-inch thick strips. Add to the bowl with the marinade, stir to coat, and set aside for 10 minutes.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 455023,
      "primary_message": "When the chicken is done marinating, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455024,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken strips and marinade; cook, stirring occasionally, until cooked through, 5-6 minutes. Remove from heat.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 455025,
      "primary_message": "Meanwhile, place dressing and miso paste in a clean medium bowl. Whisk to combine.",
      "secondary_message": "½ cup sesame ginger dressing\n2 tbsp miso paste, white"
    },
    {
      "id": 455026,
      "primary_message": "Wash and dry cucumber; using a clean cutting board, trim and small dice. Add to the bowl with the dressing along with the shredded cabbage. Stir to combine the salad and set aside.",
      "secondary_message": "1 English cucumber\n1 (14 oz) bag shredded cabbage (coleslaw mix)"
    },
    {
      "id": 455027,
      "primary_message": "Wash, dry, and cut lime into wedges; set aside for serving.",
      "secondary_message": "1 lime"
    },
    {
      "id": 455028,
      "primary_message": "Warm taco shells in the microwave if desired.",
      "secondary_message": "12 hard taco shells"
    },
    {
      "id": 455029,
      "primary_message": "Divide taco shells between plates, then fill with a small portion of the salad and chicken. Serve with remaining salad and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
