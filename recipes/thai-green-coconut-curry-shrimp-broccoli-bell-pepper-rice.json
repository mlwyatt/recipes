        "instructions": [
          {
            "id": 382659,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water"
          },
          {
            "id": 382660,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 382661,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n1 lime"
          },
          {
            "id": 382662,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 382663,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 382664,
            "primary_message": "While the skillet heats up, trim and seed bell peppers; slice lengthwise into thin strips.",
            "secondary_message": null
          },
          {
            "id": 382665,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add curry paste and salt; cook, stirring constantly, until fragrant, about 1 minute.",
            "secondary_message": "4 tsp virgin coconut oil\n¼ cup Thai curry paste, green\n½ tsp salt"
          },
          {
            "id": 382666,
            "primary_message": "Add bell pepper, broccoli, coconut milk, and broth to the skillet. Stir to combine and bring to a simmer over medium-high heat. Once the curry is simmering, reduce heat to medium and cook until veggies start to soften, about 5 minutes.",
            "secondary_message": "1 (18 oz) bag broccoli florets\n1 (13.5 fl oz) can coconut milk\n8 fl oz (1 cup) chicken or vegetable broth"
          },
          {
            "id": 382667,
            "primary_message": "Meanwhile, cut lime into wedges. Set aside for serving.",
            "secondary_message": null
          },
          {
            "id": 382668,
            "primary_message": "When the veggies are softened, add shrimp to the skillet. Continue to cook until veggies are tender and shrimp are cooked through, 3-4 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 382669,
            "primary_message": "Divide rice and curry between plates or bowls; serve with lime wedges for squeezing. Enjoy!",
            "secondary_message": null
          }
        ],
