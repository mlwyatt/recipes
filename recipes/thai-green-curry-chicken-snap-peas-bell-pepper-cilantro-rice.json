        "instructions": [
          {
            "id": 385327,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
          },
          {
            "id": 385328,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 385329,
            "primary_message": "Meanwhile, place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces; place in a medium bowl and set aside.",
            "secondary_message": "1 (30 oz) whole chicken rotisserie chicken, white and dark meat"
          },
          {
            "id": 385330,
            "primary_message": "Place broth, coconut milk, curry paste, fish sauce, and salt in a large pot; stir to combine. Bring the curry to a simmer over medium heat.",
            "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n¼ cup Thai curry paste, green\n2 tsp fish sauce\n½ tsp salt"
          },
          {
            "id": 385331,
            "primary_message": "While the curry heats up, wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n1 lime\n1 small bunch cilantro"
          },
          {
            "id": 385332,
            "primary_message": "Using a clean cutting board, trim, seed, and medium dice bell peppers. Add to the bowl with the chicken along with the snap peas.",
            "secondary_message": "1 (8 oz) pkg sugar snap peas"
          },
          {
            "id": 385333,
            "primary_message": "Once the curry is simmering, add chicken and veggies to the pot; stir to combine. Return curry to a simmer and continue to cook until chicken is warmed through and veggies are tender, about 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 385334,
            "primary_message": "Meanwhile, cut lime into wedges and set aside for serving.",
            "secondary_message": null
          },
          {
            "id": 385335,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the curry, stir to combine, and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 385336,
            "primary_message": "Divide rice and curry between plates or bowls; serve with lime wedges for squeezing. Enjoy!",
            "secondary_message": null
          }
        ],
