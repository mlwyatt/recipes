        "instructions": [
          {
            "id": 423602,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 423603,
            "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Place in a medium bowl.",
            "secondary_message": "2 red bell peppers"
          },
          {
            "id": 423604,
            "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper along with the mushrooms.",
            "secondary_message": "1 small bunch green onions (scallions)\n2 (8 oz) pkgs sliced white mushrooms"
          },
          {
            "id": 423605,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 423606,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until starting to soften, 4-5 minutes. Remove from heat.",
            "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt"
          },
          {
            "id": 423607,
            "primary_message": "Arrange flatbreads on a large baking sheet pan; evenly spread with peanut sauce, then top with veggies and cheese.",
            "secondary_message": "4 flatbreads or naan\n½ cup peanut sauce\n1 cup shredded cheese, Italian blend"
          },
          {
            "id": 423608,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until pizzas are warmed through and cheese is melted, 6-8 minutes. Remove from oven and cut into wedges.",
            "secondary_message": null
          },
          {
            "id": 423609,
            "primary_message": "To serve, divide pizzas between plates. Enjoy!",
            "secondary_message": null
          }
        ],
