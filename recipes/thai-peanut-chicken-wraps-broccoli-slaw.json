  "instructions": [
    {
      "id": 18259,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 18260,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "1 lb chicken breasts, boneless skinless\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 18261,
      "primary_message": "Coat bottom of skillet with oil. Add broccoli slaw and, stirring frequently, cook until tender-crisp, 2-3 minutes. Transfer to a bowl.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 18262,
      "primary_message": "Peel and mince garlic and ginger.",
      "secondary_message": "2 cloves garlic\r\n2 (1 inch) pieces ginger"
    },
    {
      "id": 18263,
      "primary_message": "Return skillet to stove and add more oil. Add chicken and cook until cooked through, 2-3 minutes per side.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 18264,
      "primary_message": "In a small bowl, prepare sauce by whisking together the minced garlic and ginger, peanut butter, honey, soy sauce, and water.",
      "secondary_message": "4 tbsp natural peanut butter\r\n2 tbsp honey\r\n2 tbsp soy sauce\r\n2 tbsp water"
    },
    {
      "id": 18265,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 18266,
      "primary_message": "Add peanuts and sauce to bowl with broccoli and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 18267,
      "primary_message": "Wash and dry bell peppers. Seed and slice into thin strips.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 18268,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 18269,
      "primary_message": "Heat skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 18270,
      "primary_message": "Divide broccoli slaw, bell peppers, and chicken among tortillas. Roll up tightly and place seam side down in skillet. Cook until golden brown, 1-2 minutes per side.",
      "secondary_message": "8 small flour tortillas"
    },
    {
      "id": 18271,
      "primary_message": "To serve, place wraps on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
