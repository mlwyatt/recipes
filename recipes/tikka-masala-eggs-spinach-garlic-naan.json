        "instructions": [
          {
            "id": 175462,
            "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool; peel and halve. ",
            "secondary_message": "8 eggs"
          },
          {
            "id": 175463,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "2 red bell peppers\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 175464,
            "primary_message": "Seed and small dice bell peppers; transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 175465,
            "primary_message": "Peel and mince garlic, then set aside ⅓ of the garlic for the naan. Peel and small dice onion. Add to the bowl with the bell pepper. ",
            "secondary_message": "4 cloves garlic\n½ medium yellow onion"
          },
          {
            "id": 175466,
            "primary_message": "Heat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 175467,
            "primary_message": "Add bell pepper, garlic, and onion. Season with spices and cook, stirring frequently, until vegetables have softened, 3-4 minutes.",
            "secondary_message": "2 tsp cumin\n2 tsp curry powder\n1 tsp salt\n1 tsp coriander\n½ tsp chili powder"
          },
          {
            "id": 175468,
            "primary_message": "Add tomato sauce to the skillet and bring to a simmer. Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful; simmer 2-3 minutes, stirring frequently. Remove from heat. ",
            "secondary_message": "2 (8 oz) cans tomato sauce"
          },
          {
            "id": 175469,
            "primary_message": "Let the skillet sit for 5 minutes, then stir in yogurt. ",
            "secondary_message": "1 cup plain Greek yogurt"
          },
          {
            "id": 175470,
            "primary_message": "Meanwhile, quarter and toast the naan. Drizzle with oil and spread with reserved garlic. ",
            "secondary_message": "2 flatbreads or naan\n2 tsp extra virgin olive oil"
          },
          {
            "id": 175471,
            "primary_message": "To serve, divide masala, eggs, and naan between bowls. Enjoy!",
            "secondary_message": null
          }
        ],
