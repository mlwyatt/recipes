        "instructions": [
          {
            "id": 184080,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 184081,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 lemon\n½ small bunch fresh dill\n½ small bunch green onions (scallions)\n1 English cucumber\n1 bunch radish\n1 pint grape tomatoes"
          },
          {
            "id": 184082,
            "primary_message": "Zest lemon into a small bowl, then juice it into a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 184083,
            "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add half of the dill to each bowl.",
            "secondary_message": null
          },
          {
            "id": 184084,
            "primary_message": "Chop salmon into ¼-inch pieces and add to the small bowl with the lemon zest.",
            "secondary_message": "1 (4 oz) pkg smoked salmon"
          },
          {
            "id": 184085,
            "primary_message": "Crumble goat cheese into the bowl with the salmon. Add yogurt and crushed red pepper; mash with a fork to combine the spread and set aside.",
            "secondary_message": "1 (4 oz) log goat cheese\n½ cup plain Greek yogurt\n⅛ tsp crushed red pepper"
          },
          {
            "id": 184086,
            "primary_message": "Arrange naan on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until crispy, about 10 minutes. Remove from the oven.",
            "secondary_message": "4 flatbreads or naan"
          },
          {
            "id": 184087,
            "primary_message": "Meanwhile, peel and mince garlic. Add to the medium bowl with the lemon juice, along with oil, maple syrup, salt, and pepper. Whisk to combine the dressing.",
            "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 184088,
            "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces and add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 184089,
            "primary_message": "Trim and medium dice the cucumber; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 184090,
            "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 184091,
            "primary_message": "Halve tomatoes and add to the bowl. Toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 184092,
            "primary_message": "Divide salmon-goat cheese spread between toasted naan and smooth out in an even layer. Cut into quarters.",
            "secondary_message": null
          },
          {
            "id": 184093,
            "primary_message": "To serve, divide naan and salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
