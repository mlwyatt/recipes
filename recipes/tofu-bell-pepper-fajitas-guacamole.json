        "instructions": [
          {
            "id": 44885,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n2 green bell peppers\n2 avocados\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 44886,
            "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out the flesh into a medium bowl and mash with a fork until smooth.",
            "secondary_message": null
          },
          {
            "id": 44887,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add about ½ of the cilantro to the avocado and transfer the rest to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 44888,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the avocado.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 44889,
            "primary_message": "Juice one lime and add to the avocado, then cut the other lime into wedges and transfer to a small bowl.",
            "secondary_message": null
          },
          {
            "id": 44890,
            "primary_message": "Season the avocado and other ingredients with salt and pepper, then mix to combine and set aside.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 44891,
            "primary_message": "In a small bowl, combine and mix together chili powder, cumin, salt, and pepper.",
            "secondary_message": "1 tsp chili powder\n1 tsp cumin\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 44892,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 44893,
            "primary_message": "Drain the tofu and pat dry with paper towels; holding a knife parallel to the cutting board, cut the tofu in half horizontally, then cut each half lengthwise into ½-inch-thick strips and transfer to a plate. Sprinkle the tofu with the spice mixture and rub until the strips are evenly coated.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 44894,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 44895,
            "primary_message": "Add the tofu strips to the skillet; cook, turning occasionally, until they are golden brown, 8 to 12 minutes total. Once done, transfer to a large plate. Cook in batches if necessary.",
            "secondary_message": null
          },
          {
            "id": 44896,
            "primary_message": "While the tofu cooks, quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Cut the quarters lengthwise into ¼-inch-thick strips and transfer to a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 44897,
            "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; halve the onion, then thinly slice and add to the bowl with the peppers.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 44898,
            "primary_message": "Once the tofu has been transferred, add more coconut oil to the skillet, followed by the bell peppers and onion. Cook, stirring frequently, until the vegetables are tender-crisp, 3 to 5 minutes. Once done, transfer next to the tofu.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 44899,
            "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15 to 30 seconds.",
            "secondary_message": "8 small flour tortillas"
          },
          {
            "id": 44900,
            "primary_message": "To serve, divide the tortillas between plates and fill with the tofu strips and vegetables. Spoon the guacamole on top, sprinkle with the remaining cilantro, and garnish with lime wedges. Enjoy!",
            "secondary_message": null
          }
        ],
