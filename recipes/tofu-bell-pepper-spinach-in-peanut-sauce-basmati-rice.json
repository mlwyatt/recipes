        "instructions": [
          {
            "id": 20722,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and water; bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n12 fl oz (1 ½ cups) chicken or vegetable broth\n½ cup water"
          },
          {
            "id": 20723,
            "primary_message": "Wash and dry spinach.",
            "secondary_message": "1 (5 oz) pkg baby spinach"
          },
          {
            "id": 20724,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": ""
          },
          {
            "id": 20725,
            "primary_message": "Drain and pat dry tofu. Cut into ½ inch sticks.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 40267,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 20726,
            "primary_message": "Wash, seed, and slice pepper into strips.",
            "secondary_message": "2 red bell peppers"
          },
          {
            "id": 20727,
            "primary_message": "Coat bottom of skillet with oil. Add tofu and pepper. Gently stir fry until pepper is tender and tofu is lightly browned, 5-6 minutes.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 20728,
            "primary_message": "Peel and mince the garlic. Wash, peel, and mince the ginger. Place both in a bowl with peanut butter, soy sauce, chili-garlic sauce, water, and maple syrup. Whisk to combine.",
            "secondary_message": "2 clove garlic\n2 1-inch piece ginger\n¼ cup natural peanut butter\n¼ cup soy sauce\n2 tsp chili garlic sauce\n½ cup water\n2 tbsp maple syrup"
          },
          {
            "id": 20729,
            "primary_message": "Pour in sauce and add spinach to skillet. Remove from heat and stir until spinach is just wilted, 1-2 minutes.",
            "secondary_message": ""
          },
          {
            "id": 40266,
            "primary_message": "Uncover the rice and fluff with a fork.",
            "secondary_message": null
          },
          {
            "id": 20730,
            "primary_message": "Place rice in a bowl and top with tofu and veggies. Enjoy!",
            "secondary_message": ""
          }
        ],
