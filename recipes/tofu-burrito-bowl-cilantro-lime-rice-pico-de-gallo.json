        "instructions": [
          {
            "id": 42061,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n2 cups water"
          },
          {
            "id": 42062,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 pints grape tomatoes\n2 green bell peppers\n2 jalapeño peppers\n2 limes\n1 small bunch cilantro"
          },
          {
            "id": 42063,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 42064,
            "primary_message": "Quarter the grape tomatoes and transfer to a medium bowl (that will be used for the salsa).",
            "secondary_message": null
          },
          {
            "id": 42065,
            "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the salsa bowl.",
            "secondary_message": null
          },
          {
            "id": 42066,
            "primary_message": "Preheat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 42067,
            "primary_message": "While the skillet heats up, drain and large dice the tofu (cut into ¾-inch cubes); place the cubes on paper towels or a clean towel and pat dry.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 42068,
            "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp virgin coconut oil"
          },
          {
            "id": 42069,
            "primary_message": "Add the tofu to the skillet and season with chili powder, cumin, paprika, salt, and pepper; cook, stirring occasionally, until golden brown, 8 to 10 minutes. Once done, transfer the tofu to a bowl.",
            "secondary_message": "2 tsp chili powder\n1 tsp cumin\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 42070,
            "primary_message": "While the tofu cooks, trim off and discard the ends of the onion and remove the outer layer; thinly slice one half of the onion and transfer to a medium bowl, then small dice (cut into ¼-inch pieces) the other half and add to the salsa bowl.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 42071,
            "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Cut the quarters lengthwise into ¼-inch-thick strips and add to the medium bowl with the onion.",
            "secondary_message": null
          },
          {
            "id": 42072,
            "primary_message": "Once the tofu has been transferred, add more coconut oil to the skillet followed by the onion and bell pepper. Cook, stirring frequently, until the vegetables are browned and softened, 2 to 3 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil"
          },
          {
            "id": 42073,
            "primary_message": "Juice the limes; add about ½ of the juice to the salsa bowl and the other ½ to the rice.",
            "secondary_message": null
          },
          {
            "id": 42074,
            "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add about ½ of the cilantro to the salsa bowl and the other ½ to the rice.",
            "secondary_message": null
          },
          {
            "id": 42075,
            "primary_message": "Season the salsa with salt and stir to combine.",
            "secondary_message": "1 tsp salt"
          },
          {
            "id": 42076,
            "primary_message": "Fluff the rice with a fork and stir to combine with the lime and cilantro.",
            "secondary_message": null
          },
          {
            "id": 42077,
            "primary_message": "To serve, arrange the rice, veggie mixture, tofu, and salsa in a bowl. Enjoy!",
            "secondary_message": null
          }
        ],
