        "instructions": [
          {
            "id": 228413,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkg extra firm tofu"
          },
          {
            "id": 228414,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 caps portobello mushrooms\n1 lb white mushrooms\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
          },
          {
            "id": 228415,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 228416,
            "primary_message": "While the skillet heats up, transfer tofu planks to a plate; season with salt and coat with cornstarch on both sides.",
            "secondary_message": "½ tsp salt\n¼ cup cornstarch"
          },
          {
            "id": 228417,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu to the skillet and pan-fry, flipping once, until crispy and golden brown, 5-6 minutes per side. Remove to a clean plate and set aside.",
            "secondary_message": "2 tbsp toasted sesame oil"
          },
          {
            "id": 228418,
            "primary_message": "Meanwhile, peel and mince or grate the ginger. Transfer to a large pot along with broth, vinegar, soy sauce, oil, chili-garlic sauce, and salt.",
            "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n¼ cup rice vinegar\n3 tbsp soy sauce\n2 tbsp toasted sesame oil\n1 tbsp chili-garlic sauce\n½ tsp salt"
          },
          {
            "id": 228419,
            "primary_message": "Remove portobello mushroom stems and scrape out the gills. Cut mushroom caps in half and then crosswise into thin strips. Add to the pot with the broth.",
            "secondary_message": null
          },
          {
            "id": 228420,
            "primary_message": "Thinly slice white mushrooms and add to the pot; stir to combine and bring to a boil over high heat.",
            "secondary_message": null
          },
          {
            "id": 228421,
            "primary_message": "Meanwhile, in a small bowl, make a slurry by whisking water with cornstarch until smooth.",
            "secondary_message": "¼ cup water\n¼ cup cornstarch"
          },
          {
            "id": 228422,
            "primary_message": "Once the broth comes to a boil, add the cornstarch slurry in a steady stream while stirring quickly. (Reserve bowl for later use.) Return soup to a boil, then cover and reduce heat to medium-low; let simmer until soup thickens slightly and mushrooms begin to soften, 2-3 minutes.",
            "secondary_message": null
          },
          {
            "id": 228423,
            "primary_message": "Slice tofu into thin strips.",
            "secondary_message": null
          },
          {
            "id": 228424,
            "primary_message": "Whisk eggs and salt together in the reserved bowl. Slowly pour the egg mixture into the soup, while gently stirring, to separate into strands.",
            "secondary_message": "4 eggs\n¼ tsp salt"
          },
          {
            "id": 228425,
            "primary_message": "Add tofu to the soup and stir to combine; cover and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 228426,
            "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; stir half of the green onions into the soup (reserving the rest for garnish).",
            "secondary_message": null
          },
          {
            "id": 228427,
            "primary_message": "To serve, divide soup between bowls and sprinkle with reserved green onions. Enjoy!",
            "secondary_message": null
          }
        ],
