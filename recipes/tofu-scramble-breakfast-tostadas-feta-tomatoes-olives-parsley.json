        "instructions": [
          {
            "id": 435506,
            "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkgs extra firm tofu"
          },
          {
            "id": 435507,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 435508,
            "primary_message": "Arrange tortillas on a large baking sheet. Drizzle with oil on both sides, then season with salt.",
            "secondary_message": "8 small corn tortillas\n2 tsp extra virgin olive oil\n¼ tsp salt"
          },
          {
            "id": 435509,
            "primary_message": "Place tortillas in the oven (it doesn't have to be fully heated) and bake until starting to crisp, 5-7 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 435510,
            "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 435511,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble tofu into large pieces with your fingers and add to the skillet along with spices. Cook, stirring occasionally, until tofu is golden brown, 6-8 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp oregano, dried\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 435512,
            "primary_message": "While the tofu is cooking, wash, dry, and medium dice tomatoes. Place in a medium bowl. ",
            "secondary_message": "4 tomatoes"
          },
          {
            "id": 435513,
            "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomatoes. ",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 435514,
            "primary_message": "Roughly chop olives and add to the bowl. ",
            "secondary_message": "½ cup Kalamata olives, pitted"
          },
          {
            "id": 435515,
            "primary_message": "When the tofu is done, remove from the heat. Add tomatoes, parsley, and olives, then stir to combine the scramble. ",
            "secondary_message": null
          },
          {
            "id": 435516,
            "primary_message": "To serve, divide tortillas between plates; top with tofu scramble and feta. Enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          }
        ],
