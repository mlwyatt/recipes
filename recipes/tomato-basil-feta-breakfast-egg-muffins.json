        "instructions": [
          {
            "id": 194245,
            "primary_message": "Preheat oven to 400°F and position a rack near the bottom of the oven. Grease 12 muffin cups with butter.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 194246,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 pint grape tomatoes\n1 small pkg fresh basil"
          },
          {
            "id": 194247,
            "primary_message": "Quarter the grape tomatoes and add to the muffin tins.",
            "secondary_message": null
          },
          {
            "id": 194248,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the muffin tins.",
            "secondary_message": null
          },
          {
            "id": 194249,
            "primary_message": "Crack the eggs into a medium bowl and season with salt and pepper; whisk together and pour on top of the tomatoes and basil.",
            "secondary_message": "10 eggs\n1 tsp salt\n1 tsp black pepper"
          },
          {
            "id": 194250,
            "primary_message": "Top eggs with feta. ",
            "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
          },
          {
            "id": 194251,
            "primary_message": "Bake for 15-18 minutes, until eggs are set in the center. Remove from the oven and let cool for 1 minute. Use a spatula to wedge each egg out of its cup.",
            "secondary_message": null
          },
          {
            "id": 194252,
            "primary_message": "Serve warm or cool for breakfast on the go. Enjoy! ",
            "secondary_message": null
          }
        ],
