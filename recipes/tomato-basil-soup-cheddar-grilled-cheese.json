  "instructions": [
    {
      "id": 20572,
      "primary_message": "Remove butter from fridge and allow to soften in the microwave or on the counter.",
      "secondary_message": "4 tbsp butter, unsalted"
    },
    {
      "id": 20573,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 20574,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\r\n4 cloves garlic"
    },
    {
      "id": 20575,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and garlic; begin cooking while you chop the carrot and celery.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 20576,
      "primary_message": "Wash and thinly slice carrots and celery; add to saucepan. Stirring occasionally, cook until carrots and celery have softened, 6-7 minutes.",
      "secondary_message": "2 medium carrots\r\n2 sticks celery"
    },
    {
      "id": 20577,
      "primary_message": "Wash and medium dice tomatoes.",
      "secondary_message": "4 tomatoes"
    },
    {
      "id": 20578,
      "primary_message": "Wash basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 20579,
      "primary_message": "Add fresh and canned tomatoes, broth, salt, and pepper to saucepan. Stir and bring to a boil. Reduce heat, cover, and simmer for about 10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n16 fl oz (2 cups) chicken or vegetable broth\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 20580,
      "primary_message": "Heat a skillet over medium-low heat.",
      "secondary_message": ""
    },
    {
      "id": 20581,
      "primary_message": "Grate 1 cup of cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 20582,
      "primary_message": "Spread butter onto 1 side of each bread slice and place buttered-side down on a flat surface.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 20583,
      "primary_message": "Divide cheddar between 4 of the bread slices and top with the other slices. Place in the skillet and gently press down with a spatula. Cook until cheese is melted and bread is golden brown, 2-4 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 20584,
      "primary_message": "Add basil to the soup and stir. Purée soup until smooth using a hand or regular blender.",
      "secondary_message": ""
    },
    {
      "id": 20585,
      "primary_message": "Pour soup into a bowl and service with grilled cheese on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
