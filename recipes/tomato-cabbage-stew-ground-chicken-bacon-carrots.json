        "instructions": [
          {
            "id": 377088,
            "primary_message": "Preheat a large pot over medium heat.",
            "secondary_message": null
          },
          {
            "id": 377089,
            "primary_message": "While the pot heats up, small dice bacon.",
            "secondary_message": "8 slices bacon"
          },
          {
            "id": 377090,
            "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until bacon has released its fat and is starting to brown, about 3 minutes.",
            "secondary_message": null
          },
          {
            "id": 377091,
            "primary_message": "Meanwhile, using a clean cutting board, peel, halve, and small dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium yellow onion\n2 cloves garlic"
          },
          {
            "id": 377092,
            "primary_message": "Add onion, garlic, chicken, and spices to the pot with the bacon. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
            "secondary_message": "1 lb ground chicken\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 377093,
            "primary_message": "Add broth, marinara sauce, cabbage, and carrots to the pot. Stir to combine the stew and bring to a simmer over medium-high heat.",
            "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 (24 oz) jar marinara sauce\n1 (14 oz) bag shredded cabbage (coleslaw mix)\n1 (10 oz) bag shredded carrots"
          },
          {
            "id": 377094,
            "primary_message": "Once the stew is simmering, reduce heat to medium and cook until veggies are tender, 6-8 minutes. Remove from heat. ",
            "secondary_message": null
          },
          {
            "id": 377095,
            "primary_message": "To serve, divide stew between bowls. Enjoy!",
            "secondary_message": null
          }
        ],
