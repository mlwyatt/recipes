  "instructions": [
    {
      "id": 8758,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain.",
      "secondary_message": "about 14 cups water\n2 tbsp salt\n12 oz (4 ½ cups) penne pasta"
    },
    {
      "id": 8759,
      "primary_message": "Wash tomatoes and mushrooms. Halve the tomatoes. Thinly slice the mushrooms. Peel and mince garlic.",
      "secondary_message": "2 pints grape tomatoes\r\n½ lb white mushrooms\r\n4 cloves garlic"
    },
    {
      "id": 8760,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 8761,
      "primary_message": "Coat bottom of skillet with oil. Add garlic and crushed red pepper and cook until fragrant, 15-30 seconds.",
      "secondary_message": "about 2 tbsp extra virgin olive oil\r\n¼ tsp crushed red pepper"
    },
    {
      "id": 8762,
      "primary_message": "Add tomatoes, mushrooms, Italian seasoning, salt, and pepper. Stirring occasionally, cook until mushrooms are tender and tomatoes are juicy, 2-3 minutes.",
      "secondary_message": "2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 8763,
      "primary_message": "Shave or grate Parmesan cheese.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 8764,
      "primary_message": "Add olives and pasta to pan and toss to combine.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 8765,
      "primary_message": "To serve, place pasta on a plate or in a bowl and garnish with Parmesan. Enjoy!",
      "secondary_message": ""
    }
  ],
