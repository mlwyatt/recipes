        "instructions": [
          {
            "id": 8699,
            "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
          },
          {
            "id": 8700,
            "primary_message": "Cut off skin from pineapple, core, and cut into bite-sized pieces. Transfer to a large mixing bowl.",
            "secondary_message": "1 small pineapple"
          },
          {
            "id": 8701,
            "primary_message": "Wash mangoes, kiwis, bell peppers, and jalapeños. Peel the mangoes, slice flesh away from pit, and medium dice. Peel and medium dice the kiwifruit. Seed and medium dice bell peppers. Seed and mince jalapeños. Peel and small dice onion. Add ingredients to bowl with pineapple.",
            "secondary_message": "2 mangoes\n2 kiwifruit\n2 red bell peppers\n2 jalapeño peppers\n1 medium red onion"
          },
          {
            "id": 8702,
            "primary_message": "Peel and mince garlic. In a small mixing bowl, prepare dressing by whisking together garlic, lime juice, oil, honey, salt, and pepper.",
            "secondary_message": "2 cloves garlic\r\n2 limes\r\n4 tbsp extra virgin olive oil\r\n2 tsp honey\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 89133,
            "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle.",
            "secondary_message": "1 small bunch green onions (scallions)"
          },
          {
            "id": 8703,
            "primary_message": "Uncover quinoa, fluff with a fork, and add to bowl.",
            "secondary_message": ""
          },
          {
            "id": 8704,
            "primary_message": "Pour dressing over top salad and toss.",
            "secondary_message": ""
          },
          {
            "id": 8705,
            "primary_message": "To serve, divide salad between bowls and top with green onions. Enjoy!",
            "secondary_message": ""
          }
        ],
