        "instructions": [
          {
            "id": 253711,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 small bunch green onions (scallions)\n4 medium carrots\n2 pints grape tomatoes\n2 red chili peppers\n2 avocados\n1 small pkg fresh basil"
          },
          {
            "id": 253712,
            "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp balsamic vinegar\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 253713,
            "primary_message": "Trim and mince green onions; add half to the bowl with the dressing. (Place remaining green onions in a small bowl and set aside for the sauce.)",
            "secondary_message": null
          },
          {
            "id": 253714,
            "primary_message": "Peel, trim, and julienne or coarsely grate the carrots; add to the bowl with the dressing.",
            "secondary_message": null
          },
          {
            "id": 253715,
            "primary_message": "Halve tomatoes and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 253716,
            "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon. Thinly slice crosswise and add to the bowl. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
            "secondary_message": null
          },
          {
            "id": 253717,
            "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl along with the pumpkin seeds. Gently stir to combine the salad and set aside.",
            "secondary_message": "¼ cup pumpkin seeds"
          },
          {
            "id": 253718,
            "primary_message": "Drain tuna, place in a medium bowl, and flake with a fork.",
            "secondary_message": "4 (6 oz) cans chunk light tuna in water"
          },
          {
            "id": 253719,
            "primary_message": "Peel and mince garlic; add to the bowl with the tuna.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 253720,
            "primary_message": "Add eggs, bread crumbs, yogurt, and spices to the bowl; stir well to combine the tuna mixture.",
            "secondary_message": "2 eggs\n⅔ cup panko bread crumbs\n½ cup plain Greek yogurt\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 253721,
            "primary_message": "Using a ⅓-cup measure, form the tuna mixture into ½-inch thick fritters; place on a large plate.",
            "secondary_message": null
          },
          {
            "id": 253722,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 253723,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters and cook until golden and warmed through, 3-4 minutes per side. Remove from heat.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 253724,
            "primary_message": "While the fritters are cooking, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add basil, yogurt, salt, and pepper to the bowl with the remaining green onions. Stir to combine the sauce.",
            "secondary_message": "1 cup plain Greek yogurt\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 253725,
            "primary_message": "To serve, divide fritters, salad, and sauce between plates. Enjoy!",
            "secondary_message": null
          }
        ],
