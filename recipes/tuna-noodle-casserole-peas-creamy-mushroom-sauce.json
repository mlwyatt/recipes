        "instructions": [
          {
            "id": 12261,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain.",
            "secondary_message": "about 14 cups water\n2 tbsp salt\n12 oz (4 ½ cups) penne pasta"
          },
          {
            "id": 12262,
            "primary_message": "Preheat oven to broil and position rack under the broiler.",
            "secondary_message": ""
          },
          {
            "id": 12263,
            "primary_message": "Peel and small dice onion. Wash and slice mushrooms.",
            "secondary_message": "1 medium yellow onion\r\n1 lb white mushrooms"
          },
          {
            "id": 12264,
            "primary_message": "Heat a sauté pan over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 12265,
            "primary_message": "Melt butter in pan. Add onion and mushrooms. Stirring frequently, cook until softened, 3-4 minutes.",
            "secondary_message": "4 tbsp butter, unsalted"
          },
          {
            "id": 12266,
            "primary_message": "Grate ½ cup of Parmesan.",
            "secondary_message": "2 oz Parmesan cheese"
          },
          {
            "id": 12267,
            "primary_message": "Sprinkle onion and mushrooms with flour; stir to coat.",
            "secondary_message": "2 tbsp all-purpose flour"
          },
          {
            "id": 12268,
            "primary_message": "Add milk, and stirring constantly, cook until slightly thickened, about 5 minutes.",
            "secondary_message": "16 fl oz (2 cups) whole milk"
          },
          {
            "id": 12269,
            "primary_message": "Add tuna, peas, Parmesan, paprika, salt, and pepper. Stir until well combined. Remove from heat.",
            "secondary_message": "2 (6 oz) cans chunk light tuna in water\n2 cups frozen peas\n2 tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 12270,
            "primary_message": "Add pasta and toss to coat. Place in the oven and broil until golden, 3-4 minutes.",
            "secondary_message": ""
          },
          {
            "id": 12271,
            "primary_message": "To serve, place pasta in a bowl. Enjoy!",
            "secondary_message": ""
          }
        ],
