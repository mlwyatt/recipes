        "instructions": [
          {
            "id": 428148,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 428149,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 ½ lb new potatoes\n4 medium zucchini squash\n2 sticks celery"
          },
          {
            "id": 428150,
            "primary_message": "Halve potatoes. Transfer to a baking sheet pan, drizzle with oil, and season with spices; stir to coat and spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 428151,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring once, until potatoes are golden and fork-tender, about 25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 428152,
            "primary_message": "Meanwhile, trim and halve zucchini lengthwise. Scrape out the soft flesh from the middle of each half, place in a medium bowl, and set aside for later use.",
            "secondary_message": null
          },
          {
            "id": 428153,
            "primary_message": "Arrange zucchini halves, cut-side up, on another baking sheet; drizzle with additional oil and season with salt and pepper.",
            "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 428154,
            "primary_message": "Add zucchini boats to the oven and bake until starting to soften, 5-7 minutes.",
            "secondary_message": null
          },
          {
            "id": 428155,
            "primary_message": "Meanwhile, roughly chop reserved zucchini flesh and return to the bowl.",
            "secondary_message": null
          },
          {
            "id": 428156,
            "primary_message": "Trim and small dice celery. Add to the bowl with the zucchini.",
            "secondary_message": null
          },
          {
            "id": 428157,
            "primary_message": "Drain tuna and flake with a fork. Add to the bowl along with Parmesan, salt, and pepper. Set aside.",
            "secondary_message": "4 (6 oz) cans chunk light tuna in water\n½ cup Parmesan cheese, shredded\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 428158,
            "primary_message": "Place pesto, mayo, salt, and pepper in a small bowl; stir to combine the sauce. Add half of the sauce to the bowl with the tuna and stir to combine the filling. (Set remaining sauce aside for serving.)",
            "secondary_message": "½ cup sun-dried tomato pesto\n⅓ cup mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 428159,
            "primary_message": "Remove zucchini boats from the oven and divide filling between them.",
            "secondary_message": null
          },
          {
            "id": 428160,
            "primary_message": "Return zucchini boats to the oven and continue to bake until flesh is tender and filling is warmed through, about 10 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 428161,
            "primary_message": "To serve, divide zucchini boats, potatoes, and remaining sauce between plates. Enjoy!",
            "secondary_message": null
          }
        ],
