  "instructions": [
    {
      "id": 340439,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes; drain and set aside.",
      "secondary_message": "1 tsp salt\n10 oz fettuccine pasta"
    },
    {
      "id": 340440,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 crowns broccoli\n1 small pkg fresh basil"
    },
    {
      "id": 340441,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 340442,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340443,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add turkey and cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n1 ½ lb ground turkey"
    },
    {
      "id": 340444,
      "primary_message": "While the turkey is cooking, separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 340445,
      "primary_message": "When the turkey is done, add veggies to the skillet; cook, stirring occasionally, until tender-crisp, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 340446,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 340447,
      "primary_message": "When the veggies are done, sprinkle with flour and continue to cook, stirring constantly, for 1 minute.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 340448,
      "primary_message": "Add milk, salt, and pepper to the skillet; cook, stirring occasionally, until the sauce thickens, 4-5 minutes.",
      "secondary_message": "8 fl oz (1 cup) whole milk\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 340449,
      "primary_message": "Add drained pasta and basil to the skillet; toss to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 340450,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
