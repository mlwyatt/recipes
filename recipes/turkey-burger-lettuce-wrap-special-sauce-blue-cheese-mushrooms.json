        "instructions": [
          {
            "id": 385014,
            "primary_message": "Place vinegar, sugar, and salt in a small bowl; whisk to combine the pickling liquid.",
            "secondary_message": "⅓ cup white wine vinegar\n1 ½ tsp brown sugar\n1 tsp salt"
          },
          {
            "id": 385015,
            "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
            "secondary_message": "1 medium red onion"
          },
          {
            "id": 385016,
            "primary_message": "Place turkey, eggs, Worcestershire, salt, and pepper in a medium bowl; mix with your hands until well combined. Form the turkey mixture into 4 equal-sized patties, place on a plate, and set aside.",
            "secondary_message": "1 ½ lb ground turkey\n2 eggs\n2 tsp Worcestershire sauce\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 385017,
            "primary_message": "Wash, dry, and thinly slice mushrooms. ",
            "secondary_message": "1 lb cremini mushrooms"
          },
          {
            "id": 385018,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 385019,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the mushrooms, salt, and pepper; cook, stirring occasionally, until mushrooms are soft, 8-10 minutes. ",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 385020,
            "primary_message": "While the mushrooms are cooking, place mayo, ketchup, Dijon, and cayenne in another small bowl. Whisk to combine the special sauce and set aside.",
            "secondary_message": "¼ cup mayonnaise\n4 tsp ketchup\n2 tsp Dijon mustard\n⅛ tsp cayenne pepper"
          },
          {
            "id": 385021,
            "primary_message": "When the mushrooms are done, add additional vinegar and cook until dry, 15-30 seconds. Transfer to a plate and loosely cover with aluminum foil.",
            "secondary_message": "2 tsp white wine vinegar"
          },
          {
            "id": 385022,
            "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 385023,
            "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, until golden underneath, about 5 minutes; flip patties, and cook an additional 5-6 minutes, until cooked through. Add burgers to the plate with the mushrooms and re-cover with foil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 385024,
            "primary_message": "Meanwhile, place additional oil, vinegar, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 385025,
            "primary_message": "Wash, dry, and separate lettuce into leaves. Set aside two leaves per burger and chop (or tear) remaining leaves into bite-sized pieces. Add to the bowl with the dressing and toss to coat.",
            "secondary_message": "2 heads butter (Boston) lettuce"
          },
          {
            "id": 385026,
            "primary_message": "Pile lettuce leaves, in stacks of two per wrap, on each plate; top with special sauce, burgers, mushrooms, blue cheese, and pickled onions. Serve with salad on the side and enjoy!",
            "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
          }
        ],
