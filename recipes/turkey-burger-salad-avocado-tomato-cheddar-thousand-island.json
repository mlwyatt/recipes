  "instructions": [
    {
      "id": 256521,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 pints grape tomatoes\n1 small bunch green onions (scallions)\n1 avocado\n2 heads romaine lettuce"
    },
    {
      "id": 256522,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl along with yogurt, ketchup, mayo, vinegar, water, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "2 cloves garlic\n2 tbsp capers\n½ cup plain Greek yogurt\n⅓ cup ketchup\n¼ cup mayonnaise\n2 tbsp red wine vinegar\n2 tbsp water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 256523,
      "primary_message": "Halve tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 256524,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 256525,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 256526,
      "primary_message": "Coarsely grate cheese and add to the plate.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 256527,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 256528,
      "primary_message": "While the skillet heats up, peel and mince additional garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 256529,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ground turkey, garlic, and spices to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1 ½ lb ground turkey\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 256530,
      "primary_message": "Meanwhile, chop or tear romaine leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 256531,
      "primary_message": "Divide the romaine between plates or bowls; top with tomato, avocado, cheese, and turkey crumble. Sprinkle with green onions and serve with dressing on the side. Enjoy!",
      "secondary_message": null
    }
  ],
