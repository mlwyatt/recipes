  "instructions": [
    {
      "id": 378323,
      "primary_message": "Place turkey, carrots, bread crumbs, eggs, and spices in a medium bowl. Use your hands to combine the turkey mixture. Using a ¼-cup measure, form the mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": "1 ½ lb ground turkey\n1 (10 oz) bag shredded carrots\n½ cup panko bread crumbs\n2 eggs\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 378324,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 378325,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fritters to the skillet and cook, flipping once, until golden and cooked through, about 10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 378326,
      "primary_message": "Meanwhile, wash and dry tomatoes. Halve lengthwise and place in a clean medium bowl.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 378327,
      "primary_message": "Wash, dry, and cut snap peas crosswise into ½-inch pieces. Add to the bowl with the tomatoes.",
      "secondary_message": "2 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 378328,
      "primary_message": "Roughly chop olives. Add to the bowl along with the tzatziki and salt. Stir to combine the salad and set aside.",
      "secondary_message": "½ cup Kalamata olives, pitted\n½ cup tzatziki sauce\n⅛ tsp salt"
    },
    {
      "id": 378329,
      "primary_message": "To serve, divide fritters and salad between plates; top fritters with additional tzatziki. Enjoy!",
      "secondary_message": "½ cup tzatziki sauce"
    }
  ],
