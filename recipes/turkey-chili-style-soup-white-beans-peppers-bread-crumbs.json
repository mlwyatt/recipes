  "instructions": [
    {
      "id": 441765,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 red bell peppers\n2 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 441766,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 441767,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 441768,
      "primary_message": "While the pot heats up, small dice celery. Add to the bowl with the bell peppers and set aside.",
      "secondary_message": null
    },
    {
      "id": 441769,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ lb ground turkey\n4 tsp chili powder\n1 ½ tsp garlic powder\n1 ½ tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 441770,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 441771,
      "primary_message": "When the turkey is done, add veggies to the pot; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 441772,
      "primary_message": "Add beans, broth, tomatoes, and hot sauce to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until beans are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 (14.5 oz) cans diced tomatoes\n4 tsp hot sauce"
    },
    {
      "id": 441773,
      "primary_message": "While the soup is cooking, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 441774,
      "primary_message": "While the skillet heats up, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 441775,
      "primary_message": "Once the skillet is hot, add bread crumbs and cook, stirring frequently, until golden brown, 3-4 minutes. Transfer toasted bread crumbs to the bowl with the parsley and stir to combine.",
      "secondary_message": "⅔ cup panko bread crumbs"
    },
    {
      "id": 441776,
      "primary_message": "To serve, divide soup between bowls and top with parsley bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
