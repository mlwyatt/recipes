  "instructions": [
    {
      "id": 49333,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) water"
    },
    {
      "id": 49334,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n1 small bunch green onions\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 49335,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 49336,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Small dice the carrots into ¼-inch cubes. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 49337,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces. Add to the bowl with the carrots.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 49338,
      "primary_message": "Peel and grate or mince the ginger. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 49339,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 49340,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 49341,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 49342,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 49343,
      "primary_message": "Add the ground turkey to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer to a bowl, leaving some of the juices in the skillet.",
      "secondary_message": "1 ½ lb ground turkey"
    },
    {
      "id": 49344,
      "primary_message": "In a small bowl, whisk the eggs.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 49345,
      "primary_message": "Once the turkey has been transferred, add the carrots, onion, ginger, garlic, and peas to the skillet. Cook, stirring frequently, until the carrots are tender, 2 to 4 minutes.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 49346,
      "primary_message": "Move the vegetables to one side of the skillet and pour the eggs on the other side. Scramble the eggs until cooked and mix with the vegetables.",
      "secondary_message": null
    },
    {
      "id": 49347,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 49348,
      "primary_message": "Add the rice, turkey, ½ of the green onions (save the rest for garnishing), and soy sauce to the vegetables. Stir until well combined and heated through, 1 to 2 minutes.",
      "secondary_message": "4 tbsp soy sauce"
    },
    {
      "id": 49349,
      "primary_message": "To serve, divide the fried rice between bowls and garnish with the remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
