  "instructions": [
    {
      "id": 352113,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 352114,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 English cucumber\n1 head romaine lettuce\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 352115,
      "primary_message": "Place mayo, vinegar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n2 tbsp red wine vinegar\n1 tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 352116,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 352117,
      "primary_message": "Trim, halve lengthwise, and cut cucumber crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352118,
      "primary_message": "Halve olives lengthwise and add to the bowl; set aside.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 352119,
      "primary_message": "Peel and mince onion and garlic. ",
      "secondary_message": "½ medium red onion\n2 cloves garlic"
    },
    {
      "id": 352120,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 352121,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, turkey, and spices; cook, breaking apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ lb ground turkey\n1 tsp Italian seasoning\n½ tsp crushed red pepper\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 352122,
      "primary_message": "Meanwhile, coarsely grate mozzarella and set aside.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 352123,
      "primary_message": "Add tomato sauce to the skillet with the turkey and stir to combine. Remove from heat.",
      "secondary_message": "2 (8 oz) cans tomato sauce"
    },
    {
      "id": 352124,
      "primary_message": "Arrange pitas on a large baking sheet pan. Divide turkey mixture between the pitas and top with cheese. Place in the oven and bake until the cheese is melted, 4-5 minutes. Remove from oven and cut into wedges.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 352125,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 352126,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add half to the bowl (reserving the rest for the pizzas) and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 352127,
      "primary_message": "To serve, divide pizzas and salad between plates. Sprinkle pizzas with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
