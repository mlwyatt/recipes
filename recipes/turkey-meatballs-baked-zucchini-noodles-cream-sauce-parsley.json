  "instructions": [
    {
      "id": 485268,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 485269,
      "primary_message": "Wash, dry, and trim zucchini; run a vegetable peeler along the length of the zucchini to make ribbons. Transfer to a large baking sheet pan, drizzle with oil, and season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "6 medium zucchini squash\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 485270,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 485271,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl (reserve remaining parsley for serving). ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 485272,
      "primary_message": "Add turkey, bread crumbs, eggs, and spices to the bowl with the parsley; use your hands to combine. Using a tablespoon measure, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "1 ½ lb ground turkey\n1 cup panko bread crumbs\n2 eggs\n1 tsp salt\n1 tsp garlic powder\n1 tsp onion powder\n½ tsp oregano, dried\n¼ tsp nutmeg, ground\n¼ tsp cloves, ground\n¼ tsp black pepper"
    },
    {
      "id": 485273,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485274,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). Transfer meatballs to a clean plate. (Reserve skillet with drippings for next step.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 485275,
      "primary_message": "Return skillet (with drippings) to medium heat. Add broth, cream, Worcestershire, Dijon, and salt. Whisk to combine the sauce and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until sauce has thickened, 4-5 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n8 fl oz (1 cup) heavy whipping cream\n2 tsp Worcestershire sauce\n1 tsp Dijon mustard\n1 tsp salt"
    },
    {
      "id": 485276,
      "primary_message": "Return meatballs to the skillet along with any juices from the plate. Gently stir to cover with sauce.",
      "secondary_message": null
    },
    {
      "id": 485277,
      "primary_message": "Place skillet in the oven and bake until meatballs are cooked through, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 485278,
      "primary_message": "To serve, divide zucchini noodles, meatballs, and sauce between plates. Top with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
