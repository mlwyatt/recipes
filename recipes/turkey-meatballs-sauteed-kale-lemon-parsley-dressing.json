        "instructions": [
          {
            "id": 139345,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 139346,
            "primary_message": "Peel and mince garlic; set aside in a small bowl. ",
            "secondary_message": "6 cloves garlic"
          },
          {
            "id": 139347,
            "primary_message": "Peel and small dice the onion and add to a large bowl. ",
            "secondary_message": "½ medium red onion"
          },
          {
            "id": 139348,
            "primary_message": "Add ⅓ of the minced garlic, ground turkey, eggs, almond flour, salt, and pepper to the bowl with the onion and mix with your hands until well combined.",
            "secondary_message": "1 ½ lb ground turkey\n2 eggs\n½ cup almond meal/flour\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 139349,
            "primary_message": "Coat a large baking dish with a thin layer of olive oil. Using a tablespoon measure, form the turkey mixture into rounded meatballs and place in the dish. Place in the oven and bake until cooked through, about 18 minutes ",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 139350,
            "primary_message": "Meanwhile, wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl. ",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 139351,
            "primary_message": "Wash and dry lemon, then zest into the bowl with the parsley; add oil and ⅓ of the garlic and stir to combine the dressing. Save the lemon to juice later.",
            "secondary_message": "1 lemon\n¼ cup extra virgin olive oil"
          },
          {
            "id": 139352,
            "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces.",
            "secondary_message": "2 bunches kale"
          },
          {
            "id": 139353,
            "primary_message": "Preheat a large skillet over medium-high heat. Add butter and swirl to coat the bottom. Add the remaining ⅓ of the garlic and cook for 1 minute. ",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 139354,
            "primary_message": "Juice the lemon into the skillet; add kale and spices. Cook, stirring frequently, for 1-2 minutes.",
            "secondary_message": "¼ tsp crushed red pepper\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 139355,
            "primary_message": "Add broth, cover with a lid, and cook until tender, about 5 minutes. Top kale with meatballs, then remove from heat.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
          },
          {
            "id": 139356,
            "primary_message": "To serve, divide kale and meatballs between dishes and top with parsley dressing. Enjoy! ",
            "secondary_message": null
          }
        ],
