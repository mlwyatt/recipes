        "instructions": [
          {
            "id": 300865,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "4 medium yellow potatoes\n2 medium carrots\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 300866,
            "primary_message": "Peel and small dice the potatoes.",
            "secondary_message": null
          },
          {
            "id": 300867,
            "primary_message": "Add the potatoes to a large pot and cover with hot water (from the tap). Bring to a boil; reduce heat and simmer, 12-13 minutes, until potatoes are fork-tender.",
            "secondary_message": null
          },
          {
            "id": 300868,
            "primary_message": "Peel and mince the onion. Peel and small dice the carrots. ",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 300869,
            "primary_message": "Heat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 300870,
            "primary_message": "Add the carrots and onion to the skillet; cook, stirring frequently, until softened, 4-5 minutes.",
            "secondary_message": null
          },
          {
            "id": 300871,
            "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": null
          },
          {
            "id": 300872,
            "primary_message": "Add the ground turkey to the skillet and break it apart with a spatula. Add half of the minced parsley and the spices. Cook, stirring occasionally, until the meat is browned, 7-8 minutes. ",
            "secondary_message": "1 ½ lb ground turkey\n1 tsp rosemary, dried\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 300873,
            "primary_message": "Preheat oven to broil on high.",
            "secondary_message": null
          },
          {
            "id": 300874,
            "primary_message": "Peel and mince the garlic. ",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 300875,
            "primary_message": "Add the Worcestershire sauce and garlic to the skillet. Cook, stirring occasionally, for 1 minute. ",
            "secondary_message": "4 tsp Worcestershire sauce"
          },
          {
            "id": 300876,
            "primary_message": "Add the flour and tomato paste to the skillet. Stir well, then add the broth, peas, and corn. Bring to a boil over high heat, then reduce heat to low and simmer for 6 minutes, stirring occasionally. ",
            "secondary_message": "2 tbsp all-purpose flour\n2 tbsp tomato paste\n16 fl oz (2 cups) chicken or vegetable broth\n½ cup frozen peas\n½ cup frozen corn"
          },
          {
            "id": 300877,
            "primary_message": "Once the potatoes are done, drain and return to the pot. Add the butter, broth, garlic powder, and salt; mash with a potato masher until smooth.",
            "secondary_message": "2 tbsp butter, unsalted\n4 fl oz (½ cup) chicken or vegetable broth\n½ tsp garlic powder\n¼ tsp salt"
          },
          {
            "id": 300878,
            "primary_message": "Finely grate the Parmesan.",
            "secondary_message": "1 oz Parmesan cheese"
          },
          {
            "id": 300879,
            "primary_message": "Transfer the turkey mixture to a medium baking dish and spread evenly. Top with mashed potatoes and Parmesan. Place in the oven and broil for 2-3 minutes, until the cheese begins to brown.",
            "secondary_message": null
          },
          {
            "id": 300880,
            "primary_message": "To serve, divide the Shepherd's pie between plates and garnish with remaining parsley. Enjoy! ",
            "secondary_message": null
          }
        ],
