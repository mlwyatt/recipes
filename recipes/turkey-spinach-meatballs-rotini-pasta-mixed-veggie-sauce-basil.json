  "instructions": [
    {
      "id": 338344,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 338345,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach\n2 medium carrots\n2 sticks celery\n1 small pkg fresh basil"
    },
    {
      "id": 338346,
      "primary_message": "Finely chop half of the spinach and place in a large bowl. (Reserve remaining spinach for the sauce.) ",
      "secondary_message": null
    },
    {
      "id": 338347,
      "primary_message": "Finely grate Parmesan and add to the bowl with the chopped spinach. ",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 338348,
      "primary_message": "Add turkey and spices to the bowl; mix with your hands until well combined. Using a ¼-cup measure, form turkey mixture into rounded meatballs and place on a plate. ",
      "secondary_message": "1 ½ lb ground turkey\n½ tsp salt\n½ tsp black pepper\n½ tsp Italian seasoning"
    },
    {
      "id": 338349,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 338350,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs to the skillet and cook, turning occasionally, until browned on all sides and cooked through, 6-8 minutes. Once done, transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 338351,
      "primary_message": "While the meatballs are cooking, peel and mince onion and garlic. Place both in a medium bowl.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 338352,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery; add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 338353,
      "primary_message": "When the pasta is done, drain in a colander. Return pasta to the pot, cover, and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 338354,
      "primary_message": "Return the skillet to medium heat. Add more oil and swirl to coat the bottom; add the veggies and cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 338355,
      "primary_message": "Add tomato sauce, water, and spices to the skillet with the veggies and stir to combine. Cook, stirring occasionally, until slightly thickened, about 5 minutes. ",
      "secondary_message": "2 (8 oz) cans tomato sauce\n½ cup water\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 338356,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half of the basil to the sauce and stir to combine (set remaining basil aside for garnish).",
      "secondary_message": null
    },
    {
      "id": 338357,
      "primary_message": "Add reserved spinach to the sauce in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 338358,
      "primary_message": "Return meatballs to the skillet with the sauce, stir gently to combine, and simmer until warmed though, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 338359,
      "primary_message": "To serve, divide pasta, sauce, and meatballs between bowls. Top with remaining basil and enjoy!",
      "secondary_message": null
    }
  ],
