        "instructions": [
          {
            "id": 219639,
            "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 219640,
            "primary_message": "Pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp cumin\n½ tsp coriander\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 219641,
            "primary_message": "Once the grill pan is hot, coat with oil. Add steak and cook, flipping once, until desired doneness, 4-5 minutes for medium-rare. Transfer to a clean plate and cover loosely with aluminum foil.",
            "secondary_message": "2 tsp extra virgin olive oil"
          },
          {
            "id": 219642,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
            "secondary_message": "2 tomatoes\n1 English cucumber\n1 (5 oz) pkg baby arugula"
          },
          {
            "id": 219643,
            "primary_message": "Peel and slice shallots into thin rings. Peel and mince garlic. Place both in a large bowl along with oil, vinegar, dill, and salt.",
            "secondary_message": "2 shallots\n2 cloves garlic\n4 tsp extra virgin olive oil\n4 tsp red wine vinegar\n½ tsp dill\n⅛ tsp salt"
          },
          {
            "id": 219644,
            "primary_message": "Small dice tomatoes and add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 219645,
            "primary_message": "Trim cucumber, quarter lengthwise, then slice crosswise into ¼-inch thick pieces; add to the bowl. ",
            "secondary_message": null
          },
          {
            "id": 219646,
            "primary_message": "Halve olives and add to bowl.",
            "secondary_message": "¼ cup Kalamata olives, pitted"
          },
          {
            "id": 219647,
            "primary_message": "Add arugula to the bowl and toss to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 219648,
            "primary_message": "Return the grill pan to medium-high heat. Working in batches, place tortillas in the pan and warm, flipping occasionally, until lightly charred, about 1 minute. Remove from heat.",
            "secondary_message": "4 large flour tortillas"
          },
          {
            "id": 219649,
            "primary_message": "Thinly slice steak against the grain.",
            "secondary_message": null
          },
          {
            "id": 219650,
            "primary_message": "Place tortillas on a flat surface and spread evenly with yogurt. Divide steak and ⅓ of the salad between them; roll tightly to close and cut in half. ",
            "secondary_message": "¼ cup plain Greek yogurt"
          },
          {
            "id": 219651,
            "primary_message": "Divide wraps between plates; serve with remaining salad on the side and enjoy!",
            "secondary_message": null
          }
        ],
