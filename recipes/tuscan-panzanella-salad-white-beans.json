        "instructions": [
          {
            "id": 49932,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 pints grape tomatoes\n1 English cucumber\n1 small pkg fresh basil"
          },
          {
            "id": 49933,
            "primary_message": "Drain and rinse the beans; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 49934,
            "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a large salad bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 49935,
            "primary_message": "To the garlic, add olive oil, red wine vinegar, Dijon, salt, and pepper; whisk together.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n½ tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 49936,
            "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into ¼-inch-thick pieces at an angle. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 49937,
            "primary_message": "Halve the grape tomatoes and add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 49938,
            "primary_message": "Pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons. Add to the salad bowl.",
            "secondary_message": null
          },
          {
            "id": 49939,
            "primary_message": "Trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds. Add to the salad bowl.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 49940,
            "primary_message": "Large dice the mozzarella into ¾-inch cubes and add to the salad bowl.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 49941,
            "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 49942,
            "primary_message": "Large dice the buns or rolls into ¾-inch cubes.",
            "secondary_message": "2 whole grain buns or rolls"
          },
          {
            "id": 49943,
            "primary_message": "Once the skillet is hot, add the bread cubes and cook, stirring frequently, until toasted and browned, 4 to 6 minutes. Transfer to a bowl.",
            "secondary_message": null
          },
          {
            "id": 49944,
            "primary_message": "Once the bread has been transferred, add the beans to the skillet and season with salt and pepper; cook until heated through, 1 to 2 minutes.",
            "secondary_message": "½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 49945,
            "primary_message": "Add the beans and bread cubes to the salad bowl; toss to combine.",
            "secondary_message": null
          },
          {
            "id": 49946,
            "primary_message": "To serve, divide the salad between plates or bowls. Enjoy!",
            "secondary_message": null
          }
        ],
