        "instructions": [
          {
            "id": 31412,
            "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
            "secondary_message": "1 cup basmati rice\n2 cups water\n¼ tsp salt"
          },
          {
            "id": 31413,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "1 medium head napa cabbage\n2 medium carrots"
          },
          {
            "id": 31414,
            "primary_message": "Once the water is boiling, reduce the heat to low, stir, and cover. Cook until liquid is absorbed, 10 to 15 minutes. Remove from the heat and let it stand, covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 31415,
            "primary_message": "Trim off and discard the root end of the cabbage; quarter the cabbage lengthwise, then cut crosswise into 1-inch pieces and transfer to a large bowl.",
            "secondary_message": null
          },
          {
            "id": 31416,
            "primary_message": "Peel and small dice the onion.",
            "secondary_message": "1 medium yellow onion"
          },
          {
            "id": 31417,
            "primary_message": "Heat a skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 31418,
            "primary_message": "Peel and mince the garlic.",
            "secondary_message": "4 cloves garlic"
          },
          {
            "id": 31419,
            "primary_message": "Add the beef, onion, and garlic to the skillet; cook, breaking apart the meat into smaller pieces, until the beef is browned and the onion is tender, 3 to 5 minutes.",
            "secondary_message": "1 ½ lb lean ground beef"
          },
          {
            "id": 31420,
            "primary_message": "Add the diced tomatoes and cabbage and season with salt and pepper. If the cabbage doesn't fit, cook it down and add the rest after. Reduce heat to medium and cover. Cook until the cabbage is softened, 10 to 15 minutes.",
            "secondary_message": "2 (14.5 oz) cans diced tomatoes\n1 tsp salt\n1 tsp black pepper"
          },
          {
            "id": 31421,
            "primary_message": "Trim the stem ends and peel the carrots; discard the trimmings and coarsely grate the carrots.",
            "secondary_message": null
          },
          {
            "id": 31422,
            "primary_message": "Once the cabbage is softened, add the grated carrots and rice to the skillet; stir to combine. Cook until the carrots are softened, 1 to 2 minutes.",
            "secondary_message": null
          },
          {
            "id": 31423,
            "primary_message": "Divide the lazy cabbage rolls between plates. Enjoy!",
            "secondary_message": null
          }
        ],
