  "instructions": [
    {
      "id": 198555,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 198556,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 198557,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium beets\n4 medium carrots\n1 (8 oz) pkg sugar snap peas\n1 avocado\n1 small pkg chives\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 198558,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 198559,
      "primary_message": "Trim, peel, and cut beets into ½-inch cubes. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, and toss to coat.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 198560,
      "primary_message": "Spread beets out in an even layer; place in the oven (it doesn't have to be fully heated), and roast, stirring halfway through, until fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 198561,
      "primary_message": "Meanwhile, place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 198562,
      "primary_message": "Peel and grate carrots; transfer to a large plate.",
      "secondary_message": null
    },
    {
      "id": 198563,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces at an angle; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 198564,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out onto the plate. Set veggies aside.",
      "secondary_message": null
    },
    {
      "id": 198565,
      "primary_message": "Place mayo, water, tahini, and salt in a small bowl. Whisk to combine the sesame mayo and set aside.",
      "secondary_message": "⅓ cup vegan mayonnaise\n¼ cup water\n2 tbsp tahini\n⅛ tsp salt"
    },
    {
      "id": 198566,
      "primary_message": "Mince chives. Peel and mince ginger and garlic. Place in a medium bowl along with vinegar, soy sauce, and maple syrup. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp apple cider vinegar\n4 tsp soy sauce\n2 tsp pure maple syrup"
    },
    {
      "id": 198567,
      "primary_message": "Transfer roasted beets to the bowl with the dressing and toss to combine the \"poke.\"",
      "secondary_message": null
    },
    {
      "id": 198568,
      "primary_message": "To serve, divide rice between bowls. Arrange beet \"poke,\" edamame, and veggies on top. Drizzle with sesame mayo and enjoy!",
      "secondary_message": null
    }
  ],
