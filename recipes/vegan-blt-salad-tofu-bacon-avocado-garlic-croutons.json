  "instructions": [
    {
      "id": 273059,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 273060,
      "primary_message": "Place soy sauce, maple syrup, oil, and spices in a large baking dish; whisk to combine the marinade.",
      "secondary_message": "⅓ cup soy sauce\n¼ cup pure maple syrup\n1 tbsp extra virgin olive oil\n2 tsp paprika\n2 tsp onion powder\n1 tsp black pepper\n¼ tsp cardamom, ground"
    },
    {
      "id": 273061,
      "primary_message": "Cut tofu into ¼-inch thick planks along the short side; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Add to the marinade in a single layer, turn to coat, and set aside.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 273062,
      "primary_message": "While the tofu bacon marinates, peel and mince garlic. Place in a large bowl along with oil and spices; whisk to combine the garlic oil.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n½ tsp basil, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 273063,
      "primary_message": "Cut bread into cubes and add to the bowl with the garlic oil. Toss to combine the croutons, transfer to a large baking sheet pan, and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 273064,
      "primary_message": "Place baking sheet in the oven and bake, tossing halfway through, until the croutons are golden and crispy, about 8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 273065,
      "primary_message": "Add the baking dish to the oven and bake until tofu bacon is firm and marinade has been absorbed, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 273066,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 pints grape tomatoes\n1 avocado\n2 heads romaine lettuce"
    },
    {
      "id": 273067,
      "primary_message": "Place oil, mayo, vinegar, Dijon, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp vegan mayonnaise\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 273068,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 273069,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 273070,
      "primary_message": "Chop or tear the romaine into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 273071,
      "primary_message": "Right before serving, add croutons to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 273072,
      "primary_message": "To serve, divide salad between plates or bowls, top with tofu bacon, and enjoy!",
      "secondary_message": null
    }
  ],
