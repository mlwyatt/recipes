        "instructions": [
          {
            "id": 276652,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 276653,
            "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Remove from heat and drain in a colander. (Reserve pot for later use.)",
            "secondary_message": "1 tsp salt\n10 oz macaroni (elbow) pasta"
          },
          {
            "id": 276654,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "1 lb cremini mushrooms\n2 green bell peppers\n2 pints grape tomatoes\n1 small pkg fresh basil"
          },
          {
            "id": 276655,
            "primary_message": "Thinly slice mushrooms and transfer to a large baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 276656,
            "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheet with the mushrooms.",
            "secondary_message": null
          },
          {
            "id": 276657,
            "primary_message": "Add tomatoes to the baking sheet. Drizzle veggies with oil and season with spices; toss to combine, then spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 276658,
            "primary_message": "Place baking sheet in the oven and roast, tossing once, until veggies are tender and tomatoes start to burst, about 15 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 276659,
            "primary_message": "When the pasta is done, place almond milk, nutritional yeast, oil, arrowroot starch, Dijon, onion powder, and garlic powder in the reserved pot; whisk until smooth. Place the pot over medium heat and bring the sauce to a simmer, whisking occasionally.",
            "secondary_message": "12 fl oz (1 ½ cups) almond milk, unsweetened\n⅔ cup nutritional yeast flakes\n¼ cup extra virgin olive oil\n2 tbsp arrowroot starch/powder\n2 tbsp Dijon mustard\n½ tsp onion powder\n½ tsp garlic powder"
          },
          {
            "id": 276660,
            "primary_message": "Once the sauce is simmering, continue to cook, whisking constantly, until the sauce becomes thick and stretchy, 1-2 minutes more. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 276661,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 276662,
            "primary_message": "Return drained pasta to the pot with the cheese sauce, add half of the basil (reserving the rest for serving), and stir to combine.",
            "secondary_message": null
          },
          {
            "id": 276663,
            "primary_message": "If needed, warm the mac & cheese over medium heat, stirring constantly, until heated through, 1-2 minutes.",
            "secondary_message": null
          },
          {
            "id": 276664,
            "primary_message": "To serve, divide mac & cheese between plates or bowls; top with roasted veggies and reserved basil. Enjoy!",
            "secondary_message": null
          }
        ],
