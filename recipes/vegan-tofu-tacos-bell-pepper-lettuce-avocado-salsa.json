        "instructions": [
          {
            "id": 444488,
            "primary_message": "Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
            "secondary_message": "2 (12 oz) pkgs extra firm tofu"
          },
          {
            "id": 444489,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n2 hearts romaine hearts\n2 avocados"
          },
          {
            "id": 444490,
            "primary_message": "Trim, seed, and small dice bell peppers. Transfer to a large plate.",
            "secondary_message": null
          },
          {
            "id": 444491,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 444492,
            "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
            "secondary_message": "1 medium red onion\n2 cloves garlic"
          },
          {
            "id": 444493,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, and garlic. Cook, stirring often, until softened, 4-5 minutes. (Reserve plate for the next step.)",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 444494,
            "primary_message": "Meanwhile, halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Transfer to the reserved plate.",
            "secondary_message": null
          },
          {
            "id": 444495,
            "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the plate with the lettuce.",
            "secondary_message": null
          },
          {
            "id": 444496,
            "primary_message": "Crumble tofu into small pieces with your fingers and add to the skillet along with spices. Cook, stirring occasionally, until tofu is golden brown, 4-5 minutes. Remove from heat.",
            "secondary_message": "3 tbsp taco seasoning\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 444497,
            "primary_message": "Warm taco shells in the microwave if desired.",
            "secondary_message": "12 hard taco shells"
          },
          {
            "id": 444498,
            "primary_message": "To serve, divide taco shells between plates. Fill with tofu mixture, salsa, lettuce, and avocado. Enjoy!",
            "secondary_message": "½ cup salsa"
          }
        ],
