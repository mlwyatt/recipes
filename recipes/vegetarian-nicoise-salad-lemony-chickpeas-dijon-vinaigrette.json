  "instructions": [
    {
      "id": 209723,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lb new potatoes\n2 lemons\n1 pint grape tomatoes\n1 lb green beans\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 209724,
      "primary_message": "Halve potatoes and transfer to a large pot. Cover with hot water (from the tap), season with salt, cover, and bring to a boil over high heat.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 209725,
      "primary_message": "Meanwhile, drain and rinse chickpeas; transfer to a medium bowl.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 209726,
      "primary_message": "Juice lemons into the bowl with the chickpeas; add turmeric and salt. Stir to combine and set aside to marinate.",
      "secondary_message": "½ tsp turmeric\n½ tsp salt"
    },
    {
      "id": 209727,
      "primary_message": "Once the water in the pot is boiling, reduce heat to medium and cook until the potatoes are almost tender, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 209728,
      "primary_message": "While the potatoes are cooking, peel and mince garlic; place in a large bowl along with oil, vinegar, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n4 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 209729,
      "primary_message": "Halve tomatoes and thinly slice olives; transfer both to the bowl with the dressing and set aside.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 209730,
      "primary_message": "Trim and halve the green beans.",
      "secondary_message": null
    },
    {
      "id": 209731,
      "primary_message": "When the potatoes are almost done, add green beans and edamame; continue to cook, until veggies are fork-tender, about 6 minutes. Drain and rinse with cold water.",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 209732,
      "primary_message": "Transfer green beans, edamame, potatoes, and marinated chickpeas to the bowl with the dressing. Add mixed greens and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 209733,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy.",
      "secondary_message": null
    }
  ],
