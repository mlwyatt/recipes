        "instructions": [
          {
            "id": 20680,
            "primary_message": "Rinse rice in a colander until water runs clear, then transfer to a small saucepan. Add water and salt; bring to a boil. Reduce heat to low, stir, and cover. Cook until liquid is absorbed, 16-18 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup basmati rice\r\n2 cups water\r\n½ tsp salt"
          },
          {
            "id": 20681,
            "primary_message": "Halve and pit avocados; scoop out the flesh into a medium bowl.",
            "secondary_message": "2 avocados"
          },
          {
            "id": 20682,
            "primary_message": "Wash and small dice tomatoes. Transfer to a different medium bowl.",
            "secondary_message": "4 tomatoes"
          },
          {
            "id": 20683,
            "primary_message": "Peel and small dice onion. Peel and mince garlic. Wash, seed, and mince jalapeños. Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": "1 medium red onion\r\n6 cloves garlic\r\n2 jalapeño peppers\r\n1 small bunch cilantro"
          },
          {
            "id": 20684,
            "primary_message": "Add ½ of the cilantro (save the rest for the rice), ⅓ of the garlic (save the rest for the salsa and beans), lime juice, salt, and pepper to avocado. Mash and mix until well combined. Set aside.",
            "secondary_message": "juice of 1 lime\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 20685,
            "primary_message": "Add ½ of the onion, ½ of the remaining garlic, ½ of the jalapeño, lime juice, salt, and pepper to tomatoes. Mix and set aside.",
            "secondary_message": "juice of ½ lime\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 20686,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 20687,
            "primary_message": "Drain and rinse beans.",
            "secondary_message": "2 (15 oz) cans pinto beans"
          },
          {
            "id": 20688,
            "primary_message": "Coat bottom of skillet with oil. Add beans, water, remaining onion, garlic and jalapeño, cumin, oregano, salt, and pepper. Stirring occasionally, cook until water is evaporated and beans are heated through, 2-3 minutes.",
            "secondary_message": "1 tbsp virgin coconut oil\r\n½ cup water\r\n½ tsp cumin\r\n½ tsp oregano\r\n½ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 20689,
            "primary_message": "Finely grate 1 cup of cheddar.",
            "secondary_message": "½ (8 oz) block cheddar cheese"
          },
          {
            "id": 20690,
            "primary_message": "Add remaining cilantro and lime juice to rice. Stir to combine.",
            "secondary_message": "juice of ½ lime"
          },
          {
            "id": 20691,
            "primary_message": "Place rice in a bowl and top with beans, salsa, guacamole, and cheddar. Enjoy!",
            "secondary_message": ""
          }
        ],
