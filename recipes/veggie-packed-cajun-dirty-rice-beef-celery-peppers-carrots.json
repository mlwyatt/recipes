        "instructions": [
          {
            "id": 354566,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 354567,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "4 sticks celery\n2 green bell peppers\n4 medium carrots"
          },
          {
            "id": 354568,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 354569,
            "primary_message": "While the rice is cooking, peel, halve, and small dice onions; peel and mince garlic. Place both in a large bowl.",
            "secondary_message": "2 medium yellow onions\n4 cloves garlic"
          },
          {
            "id": 354570,
            "primary_message": "Trim and small dice celery; add to the bowl with the onion and garlic.",
            "secondary_message": null
          },
          {
            "id": 354571,
            "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 354572,
            "primary_message": "Peel, trim, and small dice carrots; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 354573,
            "primary_message": "Preheat a large skillet over medium heat.",
            "secondary_message": null
          },
          {
            "id": 354574,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring often, until they begin to soften, 5-6 minutes.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 354575,
            "primary_message": "Once the veggies are soft, add ground beef and spices to the skillet. Continue to cook, breaking the meat apart with a spoon, until the beef is browned and crumbly, 4-5 minutes more.",
            "secondary_message": "1 ½ lb lean ground beef\n1 ½ tsp salt\n1 tsp paprika\n1 tsp thyme, dried\n1 tsp oregano, dried\n¼ tsp cayenne pepper\n¼ tsp black pepper"
          },
          {
            "id": 354576,
            "primary_message": "Add cooked rice and additional broth to the skillet; continue to cook, stirring occasionally, until heated through, 2-3 minutes more. Remove from heat.",
            "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
          },
          {
            "id": 354577,
            "primary_message": "To serve, divide \"dirty rice\" between plates or bowls and enjoy!",
            "secondary_message": null
          }
        ],
