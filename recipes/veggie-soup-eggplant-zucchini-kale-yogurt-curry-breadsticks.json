        "instructions": [
          {
            "id": 284844,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 284845,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n2 eggplants\n2 medium zucchini squash\n1 bunch kale\n1 small bunch cilantro"
          },
          {
            "id": 284846,
            "primary_message": "Peel and mince ginger and garlic; place both in a small bowl, along with the spices, and set aside.",
            "secondary_message": "4 cloves garlic\n1 tsp coriander, ground\n1 tsp cumin, ground\n1 tsp salt\n½ tsp cinnamon, ground\n¼ tsp cayenne pepper"
          },
          {
            "id": 284847,
            "primary_message": "Trim and medium dice eggplants and zucchini; place both in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 284848,
            "primary_message": "Preheat a large pot over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 284849,
            "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add eggplant and zucchini; cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for the next step.)",
            "secondary_message": "3 tbsp extra virgin olive oil"
          },
          {
            "id": 284850,
            "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in the reserved bowl; set aside.",
            "secondary_message": null
          },
          {
            "id": 284851,
            "primary_message": "Once the veggies start to soften, add ginger, garlic, and spices to the pot. Cook, stirring constantly, until fragrant, about 30 seconds.",
            "secondary_message": null
          },
          {
            "id": 284852,
            "primary_message": "Add broth to the pot and stir to combine the soup; cover and bring to a boil. Once boiling, reduce heat to medium, and simmer, stirring occasionally, until veggies are soft, 4-5 minutes.",
            "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
          },
          {
            "id": 284853,
            "primary_message": "While the soup is cooking, drizzle oil over the flatbread and season with spices; cut into 1½-inch wide strips and transfer to a baking sheet pan. Place in the oven and bake until crispy, 8-10 minutes. Remove from oven.",
            "secondary_message": "4 tsp extra virgin olive oil\n2 flatbreads or naan\n¼ tsp curry powder\n⅛ tsp salt\n⅛ tsp cayenne pepper"
          },
          {
            "id": 284854,
            "primary_message": "When the veggies are soft, add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until the kale is tender, 2-3 minutes more.",
            "secondary_message": null
          },
          {
            "id": 284855,
            "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the soup, stir to combine, and remove from heat.",
            "secondary_message": null
          },
          {
            "id": 284856,
            "primary_message": "Divide soup between bowls; top with yogurt and almonds. Serve with breadsticks on the side and enjoy!",
            "secondary_message": "½ cup plain Greek yogurt\n¼ cup almonds, sliced"
          }
        ],
