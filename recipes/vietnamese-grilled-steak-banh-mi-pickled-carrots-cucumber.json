        "instructions": [
          {
            "id": 394590,
            "primary_message": "Peel and mince shallot. Peel and mince the garlic.",
            "secondary_message": "1 shallot\n4 cloves garlic"
          },
          {
            "id": 394591,
            "primary_message": "Add shallot, garlic, fish sauce, maple syrup, and pepper to a medium bowl; whisk together.",
            "secondary_message": "2 tbsp fish sauce\n4 tsp pure maple syrup\n½ tsp black pepper"
          },
          {
            "id": 394592,
            "primary_message": "Cut the steak into 3-inch sections, then thinly slice each section against the grain into ¼-inch strips; add to the bowl with the marinade. Turn to coat and set aside to marinate. ",
            "secondary_message": "1 ½ lb striploin (New York strip) steak"
          },
          {
            "id": 394593,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium carrots\n1 English cucumber\n1 jalapeño pepper\n½ small bunch cilantro\n1 head butter (Boston) lettuce"
          },
          {
            "id": 394594,
            "primary_message": "Trim off and discard the ends of the carrots and cucumber. Using a julienne (or regular) peeler, peel the carrots and cucumber into thin noodle-like sticks. Transfer the carrots to a medium saucepan and the cucumber to a large bowl. ",
            "secondary_message": null
          },
          {
            "id": 394595,
            "primary_message": "Thinly slice the jalapeño into rounds; add to the saucepan with the carrots. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
            "secondary_message": null
          },
          {
            "id": 394596,
            "primary_message": "Add vinegar, maple syrup, and salt to the saucepan with carrots and jalapeño. Bring to a boil over high heat; immediately remove from heat, stir in 4 ice cubes (or ½ cup water) and set aside to cool.",
            "secondary_message": "½ cup rice vinegar\n4 tsp pure maple syrup\n1 tsp salt"
          },
          {
            "id": 394597,
            "primary_message": "Heat a grill pan (or skillet) over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 394598,
            "primary_message": "Halve the lettuce head lengthwise, then chop crosswise into thick, bite-sized, pieces; set aside.",
            "secondary_message": null
          },
          {
            "id": 394599,
            "primary_message": "Coat grill with oil. Working in batches, place steak on the grill and cook until desired doneness, about 1½ minutes per side for medium-rare. Transfer to a plate and loosely cover with foil. ",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 394600,
            "primary_message": "Slice rolls in half. Place on grill, cut side down, and toast until browned, about 2 minutes. Alternatively, you can toast the rolls in a toaster. ",
            "secondary_message": "4 whole grain buns or rolls"
          },
          {
            "id": 394601,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems. Add cilantro to the bowl with the cucumber. Reserving the pickling liquid, remove carrots and jalapeño from the saucepan using tongs or a fork, and add them to the bowl; toss to combine. ",
            "secondary_message": null
          },
          {
            "id": 394602,
            "primary_message": "To assemble the sandwiches, spread mayonnaise on bottom slices of rolls; top with steak, some of the pickled carrots, cucumber, jalapeño, and cilantro. Close sandwiches with tops of the rolls. ",
            "secondary_message": "¼ cup mayonnaise"
          },
          {
            "id": 394603,
            "primary_message": "Add lettuce to the bowl with carrots, cucumber, jalapeño, and cilantro; drizzle with ⅓ cup of the reserved pickling liquid, and toss to coat.",
            "secondary_message": null
          },
          {
            "id": 394604,
            "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
            "secondary_message": null
          }
        ],
