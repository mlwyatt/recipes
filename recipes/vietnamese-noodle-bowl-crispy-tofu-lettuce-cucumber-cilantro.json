  "instructions": [
    {
      "id": 321098,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 321099,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 limes\n1 jalapeño pepper\n1 small bunch green onions (scallions)\n1 head butter (Boston) lettuce\n1 English cucumber\n2 medium carrots\n1 small bunch cilantro"
    },
    {
      "id": 321100,
      "primary_message": "Juice limes into a small bowl. Add water, sugar, fish sauce, soy sauce, and chili-garlic sauce; whisk the dressing until sugar is dissolved.",
      "secondary_message": "1 cup water\n¼ cup brown sugar\n¼ cup fish sauce\n2 tbsp soy sauce\n1 tsp chili-garlic sauce"
    },
    {
      "id": 321101,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) ",
      "secondary_message": null
    },
    {
      "id": 321102,
      "primary_message": "Peel and mince garlic; add to the bowl. Whisk to combine and set aside.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 321103,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Once boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "10 oz flat rice (pad thai) noodles"
    },
    {
      "id": 321104,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321105,
      "primary_message": "While the skillet heats up, large dice tofu and place in a medium bowl. Sprinkle with cornstarch and gently toss to coat.",
      "secondary_message": "¼ cup cornstarch"
    },
    {
      "id": 321106,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning every few minutes, until golden brown and crispy, about 10 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 321107,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into ¼-inch pieces; transfer to a large plate.",
      "secondary_message": null
    },
    {
      "id": 321108,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips. Add to the plate with the green onion.",
      "secondary_message": null
    },
    {
      "id": 321109,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into ¼-inch thick pieces; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 321110,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 321111,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 321112,
      "primary_message": "To serve, divide noodles, veggies, and tofu between bowls. Pour dressing over top and sprinkle with cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
