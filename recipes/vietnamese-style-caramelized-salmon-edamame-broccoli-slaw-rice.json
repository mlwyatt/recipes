        "instructions": [
          {
            "id": 297113,
            "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
            "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
          },
          {
            "id": 297114,
            "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 297115,
            "primary_message": "Meanwhile, wash and dry the fresh produce.",
            "secondary_message": "2 (1 inch) pieces ginger root\n1 lime\n2 small bunches green onions (scallions)\n1 English cucumber\n2 medium carrots"
          },
          {
            "id": 297116,
            "primary_message": "Peel and mince ginger; place in a medium bowl.",
            "secondary_message": null
          },
          {
            "id": 297117,
            "primary_message": "Zest and juice lime into the bowl with the ginger. Add sugar, fish sauce, soy sauce, and water; whisk to combine the sauce.",
            "secondary_message": "3 tbsp brown sugar\n3 tbsp fish sauce\n2 tbsp soy sauce\n2 tbsp water"
          },
          {
            "id": 297118,
            "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. ",
            "secondary_message": null
          },
          {
            "id": 297119,
            "primary_message": "Cut salmon into equal portions, pat dry with paper towels, and place on a plate; drizzle skin-side with oil, then sprinkle with salt and pepper on both sides. Pour sauce into a large ovenproof skillet, then place salmon, skin-side down, in the sauce. (Reserve bowl for later use.)",
            "secondary_message": "1 ½ lb salmon fillet\n2 tsp toasted sesame oil\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 297120,
            "primary_message": "Place skillet in the oven and broil until salmon is just opaque, about 5 minutes. Flip salmon and continue to broil until the skin is crispy, about 3 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 297121,
            "primary_message": "While the salmon cooks, place edamame in a colander and rinse under hot water (from the tap) to thaw. Set aside to drain.",
            "secondary_message": "1 cup edamame, shelled"
          },
          {
            "id": 297122,
            "primary_message": "Place oil, vinegar, soy sauce, and chili-garlic sauce in the reserved bowl; whisk to combine the dressing.",
            "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp rice vinegar\n2 tbsp soy sauce\n2 tsp chili-garlic sauce"
          },
          {
            "id": 297123,
            "primary_message": "Using a clean cutting board, trim green onions and cut crosswise into thin pieces; add half to the bowl with the dressing. (Reserve remaining green onions for serving.)",
            "secondary_message": null
          },
          {
            "id": 297124,
            "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 297125,
            "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl along with the broccoli slaw and edamame. Toss to combine the slaw.",
            "secondary_message": "1 (12 oz) pkg broccoli slaw"
          },
          {
            "id": 297126,
            "primary_message": "When the salmon is done, transfer to a clean plate.",
            "secondary_message": null
          },
          {
            "id": 297127,
            "primary_message": "Place skillet over medium-high heat and cook, stirring frequently, until sauce begins to thicken and caramelize, 1-2 minutes. Remove from heat.",
            "secondary_message": null
          },
          {
            "id": 297128,
            "primary_message": "To serve, divide rice, salmon, and slaw between bowls; spoon sauce over salmon and top with reserved green onion. Enjoy!",
            "secondary_message": null
          }
        ],
