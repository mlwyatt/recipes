        "instructions": [
          {
            "id": 339153,
            "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
            "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 339154,
            "primary_message": "Place chicken in a medium saucepan. Cover with 1-inch of water and bring to a boil.",
            "secondary_message": null
          },
          {
            "id": 339155,
            "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
            "secondary_message": "2 lemons\n2 Granny Smith apples\n4 sticks celery\n1 lb red grapes\n1 (5 oz) pkg spring mix (mixed greens)"
          },
          {
            "id": 339156,
            "primary_message": "Once the water in the pan is boiling, reduce heat to medium and simmer until chicken is cooked through, 8-10 minutes.",
            "secondary_message": null
          },
          {
            "id": 339157,
            "primary_message": "While the chicken is cooking, juice one lemon into a large bowl (reserve remaining lemon for the mixed green salad). Add yogurt, mayo, Dijon, salt, and pepper; whisk to combine the creamy dressing. ",
            "secondary_message": "½ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 339158,
            "primary_message": "Using a clean cutting board, quarter, core, and small dice apples; add to the bowl with the dressing. ",
            "secondary_message": null
          },
          {
            "id": 339159,
            "primary_message": "Trim and small dice celery; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 339160,
            "primary_message": "Halve grapes and add half to the bowl. (Reserve remaining grapes for the mixed green salad.)",
            "secondary_message": null
          },
          {
            "id": 339161,
            "primary_message": "Roughly chop walnuts and add to the bowl; set aside. ",
            "secondary_message": "¼ cup walnuts"
          },
          {
            "id": 339162,
            "primary_message": "When the chicken is done, drain and transfer to a plate; set aside to cool, 5 min.",
            "secondary_message": null
          },
          {
            "id": 339163,
            "primary_message": "Meanwhile, juice the remaining lemon into a medium bowl; add oil, additional Dijon, honey, salt, and pepper. Whisk to combine the vinaigrette. ",
            "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 339164,
            "primary_message": "Add mixed greens and reserved grapes to the bowl with the vinaigrette; toss to combine the salad. Set aside. ",
            "secondary_message": null
          },
          {
            "id": 339165,
            "primary_message": "Shred the chicken using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat. Add to the bowl with the creamy dressing and stir to combine the chicken salad. ",
            "secondary_message": null
          },
          {
            "id": 339166,
            "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with the chicken salad.",
            "secondary_message": "4 whole grain pitas"
          },
          {
            "id": 339167,
            "primary_message": "To serve, divide pitas and mixed green salad between plates. Enjoy!",
            "secondary_message": null
          }
        ],
