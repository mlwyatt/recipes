        "instructions": [
          {
            "id": 173694,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 173695,
            "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans black beans"
          },
          {
            "id": 173696,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 red bell peppers\n2 yellow bell peppers\n2 small bunches asparagus\n1 avocado\n2 limes\n1 small pkg fresh basil"
          },
          {
            "id": 173697,
            "primary_message": "Cut peppers into large pieces and toss in a large bowl with oil, oregano, salt, and pepper. Spread in a single layer on a parchment-lined baking sheet and roast in the oven, until beginning to soften, about 10 minutes. Save bowl for use in the next step.",
            "secondary_message": "4 tsp extra virgin olive oil\n1 tsp oregano\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 173698,
            "primary_message": "Snap or cut off the woody ends of the asparagus. Place in the large bowl with additional oil and oregano; toss to coat and set aside.",
            "secondary_message": "2 tsp extra virgin olive oil\n½ tsp oregano"
          },
          {
            "id": 173699,
            "primary_message": "Halve and pit the avocado. Slice into chunks while still in the skin, then scoop out into a blender. Juice lime into the blender.",
            "secondary_message": null
          },
          {
            "id": 173700,
            "primary_message": "Peel and mince garlic; add to the blender along with oil, salt, and pepper; purée until smooth, 30-60 seconds. Add water to thin out the dressing if necessary.",
            "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n2 tbsp water"
          },
          {
            "id": 173701,
            "primary_message": "Remove peppers from the oven and toss. Lay the asparagus on top of the peppers and return to the oven; roast until vegetables are tender, about 10 minutes.",
            "secondary_message": null
          },
          {
            "id": 173702,
            "primary_message": "Peel and thinly slice the shallots into rings.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 173703,
            "primary_message": "Cut mozzarella into bite sized pieces.",
            "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
          },
          {
            "id": 173704,
            "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
            "secondary_message": null
          },
          {
            "id": 173705,
            "primary_message": "To serve, divide roasted peppers and asparagus between plates and top with beans, shallots, cheese, and basil; drizzle with dressing and enjoy!",
            "secondary_message": null
          }
        ],
