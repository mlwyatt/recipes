  "instructions": [
    {
      "id": 177651,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 177652,
      "primary_message": "Wash and chop the potatoes into ½-inch pieces. Place on a large baking sheet pan along with the edamame; drizzle with oil, season with salt and pepper, and spread out in a single layer.",
      "secondary_message": "6 medium yellow potatoes\n2 cups edamame\n4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 177653,
      "primary_message": "Place the potatoes and edamame in the oven (it doesn't have to be fully heated) and bake until potatoes are fork-tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 177654,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 avocados\n1 small bunch fresh dill\n1 lemon\n2 small bunches asparagus"
    },
    {
      "id": 177655,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out into a large bowl. Mash well with a fork or potato masher.",
      "secondary_message": null
    },
    {
      "id": 177656,
      "primary_message": "Using a knife, shave the dill leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 177657,
      "primary_message": "Juice the lemon into the bowl. Add water, salt, and pepper, and whisk to combine the dressing; add more water, 1 Tbsp at a time, if needed to reach a creamy, dressing-like consistency.",
      "secondary_message": "¼ cup water\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 177658,
      "primary_message": "Trim and cut asparagus into 2-inch pieces. Spread in an even layer on a second, large baking sheet pan; drizzle with oil, and season with salt and pepper.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 177659,
      "primary_message": "Remove potatoes and edamame from the oven and toss; return them to the oven, along with the sheet of asparagus. Cook until vegetables are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 177660,
      "primary_message": "Remove potatoes, edamame, and asparagus from the oven and carefully add to the bowl with the dressing; toss well to combine.",
      "secondary_message": null
    },
    {
      "id": 177661,
      "primary_message": "To serve, divide potato salad between dishes, top with pine nuts, and enjoy!",
      "secondary_message": "½ cup pine nuts"
    }
  ],
