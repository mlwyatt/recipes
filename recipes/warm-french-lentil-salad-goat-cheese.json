        "instructions": [
          {
            "id": 20806,
            "primary_message": "Rinse lentils under cold water and transfer to a medium saucepan. Cover with broth and bring to a boil. Reduce heat to a simmer and, stirring occasionally, cook until just tender, 15-20 minutes.",
            "secondary_message": "1 ½ cups green lentils\n24 fl oz (3 cups) chicken or vegetable broth"
          },
          {
            "id": 20807,
            "primary_message": "Wash carrots and celery. Peel and small dice carrots. Small dice celery.",
            "secondary_message": "4 medium carrots\r\n4 sticks celery"
          },
          {
            "id": 20808,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 20809,
            "primary_message": "Peel and thinly slice shallots crosswise; separate into rings.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 20810,
            "primary_message": "Coat bottom of skillet with oil. Add shallots and, stirring occasionally, cook until it begins to soften, 2-3 minutes.",
            "secondary_message": "1 tbsp extra virgin olive oil"
          },
          {
            "id": 20811,
            "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
            "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 20812,
            "primary_message": "Add carrots and celery to skillet and season with salt and pepper. Continue to cook, stirring occasionally, until vegetables are tender, about 5 minutes more.",
            "secondary_message": "½ tsp salt\r\n½ tsp black pepper"
          },
          {
            "id": 20813,
            "primary_message": "Peel and mince garlic. In a large bowl, prepare salad dressing by whisking together garlic, olive oil, vinegar, Dijon, thyme, salt, and pepper.",
            "secondary_message": "2 cloves garlic\r\n3 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n¼ tsp Dijon mustard\r\n¼ tsp thyme\r\n¼ tsp salt\r\n¼ tsp black pepper"
          },
          {
            "id": 20814,
            "primary_message": "Add vegetables and parsley to bowl with vinaigrette.",
            "secondary_message": ""
          },
          {
            "id": 20815,
            "primary_message": "Drain lentils and add to bowl. Toss salad.",
            "secondary_message": ""
          },
          {
            "id": 20816,
            "primary_message": "Serve on a plate and crumble goat cheese over top. Enjoy!",
            "secondary_message": "1 (4 oz) log goat cheese"
          }
        ],
