        "instructions": [
          {
            "id": 274905,
            "primary_message": "Preheat oven to 425°F.",
            "secondary_message": null
          },
          {
            "id": 274906,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 Gala apples\n1 small butternut squash\n1 small pkg fresh thyme"
          },
          {
            "id": 274907,
            "primary_message": "Quarter and core apples, then cut each quarter into ¾-inch cubes; transfer to a large baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 274908,
            "primary_message": "Trim and peel squash. Halve lengthwise, scrape out seeds, and cut into ¾-inch cubes; add to the baking sheet with the apple.",
            "secondary_message": null
          },
          {
            "id": 274909,
            "primary_message": "Slide thyme leaves off the stems; discard the stems. Sprinkle leaves over the apple and squash, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
            "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 274910,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until apple and squash are golden and fork-tender, 20-25 minutes. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 274911,
            "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse in a colander.",
            "secondary_message": "1 tsp salt\n10 oz rotini pasta"
          },
          {
            "id": 274912,
            "primary_message": "While the pasta is cooking, place oil, vinegar, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing.",
            "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 274913,
            "primary_message": "Peel and mince garlic and shallot; add both to the bowl with the dressing. Stir to combine and set aside.",
            "secondary_message": "2 cloves garlic\n1 shallot"
          },
          {
            "id": 274914,
            "primary_message": "Roughly chop pecans and set aside.",
            "secondary_message": "⅔ cup pecans, dry roasted"
          },
          {
            "id": 274915,
            "primary_message": "When the apple, squash, and pasta are done, add to the bowl with the dressing; gently stir to combine the pasta salad.",
            "secondary_message": null
          },
          {
            "id": 274916,
            "primary_message": "To serve, divide warm pasta salad between plates or bowls. Crumble goat cheese over top and sprinkle with pecans. Enjoy!",
            "secondary_message": "1 (4 oz) log goat cheese"
          }
        ],
