  "instructions": [
    {
      "id": 83253,
      "primary_message": "Preheat oven to 425°F. Line two baking sheets with parchment paper (optional).",
      "secondary_message": null
    },
    {
      "id": 83254,
      "primary_message": "Wash and dry the fresh produce. Leave the lettuce intact while washing.",
      "secondary_message": "2 lemons\n2 heads romaine lettuce"
    },
    {
      "id": 83255,
      "primary_message": "Peel and mince garlic and transfer to a small bowl for the dressing. Mince the anchovy fillets and add to the bowl. Add salt and stir to combine.",
      "secondary_message": "2 cloves garlic\n6 anchovy fillets, packed in oil\n1 tsp salt"
    },
    {
      "id": 83256,
      "primary_message": "Juice the lemon and add to the dressing bowl. Add mustard, olive oil, and pepper; whisk together.",
      "secondary_message": "2 tsp Dijon mustard\n¼ cup extra virgin olive oil\n½ tsp black pepper"
    },
    {
      "id": 83257,
      "primary_message": "Pat the salmon dry with paper towels and place, on a sheet pan. Rub the salmon with olive oil and season with salt and pepper.",
      "secondary_message": "1 ½ lb salmon fillet\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 83258,
      "primary_message": "Place the salmon in the oven and roast for 5 minutes while you prepare the lettuce.",
      "secondary_message": null
    },
    {
      "id": 83259,
      "primary_message": "Cut romaine lengthwise and rub with ¾ of the dressing.",
      "secondary_message": null
    },
    {
      "id": 83260,
      "primary_message": "Place lettuce on the second baking sheet and place in the oven for 7-10 minutes, until the salmon is cooked through and the tops of the lettuce begin to char.",
      "secondary_message": null
    },
    {
      "id": 83261,
      "primary_message": "Finely grate ½ cup of Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 83262,
      "primary_message": "Remove the pan from the oven. Sprinkle the lettuce with the Parmesan cheese. Chop the lettuce into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 83263,
      "primary_message": "To serve, arrange a bed of romaine on a plate, top with salmon and drizzle with remaining dressing. Serve immediately, enjoy!",
      "secondary_message": null
    }
  ],
