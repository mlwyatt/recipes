        "instructions": [
          {
            "id": 379796,
            "primary_message": "Preheat oven to 450°F.",
            "secondary_message": null
          },
          {
            "id": 379797,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "4 leeks\n2 oranges\n2 (5 oz) pkgs baby spinach"
          },
          {
            "id": 379798,
            "primary_message": "Trim off the root ends and the dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and transfer to a large baking sheet pan.",
            "secondary_message": null
          },
          {
            "id": 379799,
            "primary_message": "Add butternut squash to the baking sheet with the leek. Drizzle veggies with oil and vinegar, then season with salt and pepper. Toss to combine and spread out in an even layer.",
            "secondary_message": "4 cup frozen butternut squash, pieces\n2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 379800,
            "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, about 15 minutes.",
            "secondary_message": null
          },
          {
            "id": 379801,
            "primary_message": "Meanwhile, drain and rinse lentils. Set aside to drain further. ",
            "secondary_message": "2 (15 oz) cans lentils"
          },
          {
            "id": 379802,
            "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Place in a large bowl along with spinach and pumpkin seeds. Set aside. ",
            "secondary_message": "¼ cup pumpkin seeds"
          },
          {
            "id": 379803,
            "primary_message": "When the veggies are done, remove from oven and let cool slightly, about 5 minutes. ",
            "secondary_message": null
          },
          {
            "id": 379804,
            "primary_message": "Add warm veggies, lentils, and dressing to the bowl with the orange and spinach. Toss to combine the salad. ",
            "secondary_message": "½ cup Italian salad dressing"
          },
          {
            "id": 379805,
            "primary_message": "To serve, divide salad between plates or bowls and crumble goat cheese over top. Enjoy!",
            "secondary_message": "1 (4 oz) log goat cheese"
          }
        ],
