        "instructions": [
          {
            "id": 378408,
            "primary_message": "Preheat a large skillet over medium-high heat.",
            "secondary_message": null
          },
          {
            "id": 378409,
            "primary_message": "While the skillet heats up, wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips.",
            "secondary_message": "2 yellow bell peppers"
          },
          {
            "id": 378410,
            "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and broccoli; cook, stirring occasionally, until starting to soften, about 4 minutes.",
            "secondary_message": "4 tsp toasted sesame oil\n1 (18 oz) bag broccoli florets"
          },
          {
            "id": 378411,
            "primary_message": "Meanwhile, pat the steak dry with paper towels and slice crosswise into thin strips. Season with salt and pepper.",
            "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 378412,
            "primary_message": "When the veggies have softened, add steak and stir-fry sauce to the skillet. Cook, stirring occasionally, until veggies are tender and steak is cooked through, 3-4 minutes. Remove from heat.",
            "secondary_message": "¼ cup stir-fry sauce"
          },
          {
            "id": 378413,
            "primary_message": "Meanwhile, place water, additional stir-fry sauce, oil, and sesame seeds in a large bowl. Whisk to combine the dressing.",
            "secondary_message": "¼ cup water\n¼ cup stir-fry sauce\n4 tsp toasted sesame oil\n4 tsp sesame seeds"
          },
          {
            "id": 378414,
            "primary_message": "Wash and dry mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and toss to coat.",
            "secondary_message": "2 (5 oz) pkgs spring mix (mixed greens)"
          },
          {
            "id": 378415,
            "primary_message": "To serve, divide dressed greens between plates or bowls; top with warm steak and veggies. Enjoy!",
            "secondary_message": null
          }
        ],
