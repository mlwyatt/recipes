  "instructions": [
    {
      "id": 309692,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n2 pints grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 309693,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 309694,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 309695,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onion; peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 309696,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add onion, garlic, and spices. Cook, stirring occasionally, until softened, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 309697,
      "primary_message": "Meanwhile, separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add cauliflower and water to the pot with the onion; continue to cook, stirring occasionally, while preparing the tomatoes.",
      "secondary_message": "¼ cup water"
    },
    {
      "id": 309698,
      "primary_message": "Halve tomatoes; add to the pot along with the beans and broth. Stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies are fork-tender, about 10 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
    },
    {
      "id": 309699,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 309700,
      "primary_message": "Peel and mince additional garlic; place in a small bowl along with oil and spices. Stir to combine the garlic oil.",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 309701,
      "primary_message": "Place flatbread on a baking sheet pan and spread garlic oil over top; place in the oven and broil until golden and crisp, 3-4 minutes. Remove from oven and slice crosswise into sticks.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 309702,
      "primary_message": "While the garlic bread is toasting, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 309703,
      "primary_message": "When the soup is done, add vinegar, stir to combine, and remove from heat.",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 309704,
      "primary_message": "Divide soup between bowls and top with basil. Serve with breadsticks on the side and enjoy!",
      "secondary_message": null
    }
  ],
