        "instructions": [
          {
            "id": 295255,
            "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
            "secondary_message": "1 lemon\n2 yellow bell peppers\n2 oranges\n2 grapefruits\n1 avocado\n1 (5 oz) pkg baby spinach"
          },
          {
            "id": 295256,
            "primary_message": "Zest lemon into a medium saucepan (set lemon aside for later use).",
            "secondary_message": null
          },
          {
            "id": 295257,
            "primary_message": "Add quinoa and broth to the saucepan with the zest, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
            "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
          },
          {
            "id": 295258,
            "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further.",
            "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
          },
          {
            "id": 295259,
            "primary_message": "Juice the lemon into a large bowl, then add oil, Dijon, maple syrup, and spices; whisk to combine the dressing.",
            "secondary_message": "3 tbsp extra virgin olive oil\n4 tsp Dijon mustard\n4 tsp pure maple syrup\n1 tsp garlic powder\n½ tsp paprika\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 295260,
            "primary_message": "Peel and slice shallots into thin rings; add to the bowl with the dressing.",
            "secondary_message": "2 shallots"
          },
          {
            "id": 295261,
            "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
            "secondary_message": null
          },
          {
            "id": 295262,
            "primary_message": "Cut off skin and white pith from the oranges and grapefruits. Slice between the membranes to release segments; cut into bite-sized pieces and add both to the bowl, along with the beans. Stir to combine and set aside.",
            "secondary_message": null
          },
          {
            "id": 295263,
            "primary_message": "Transfer the cooked quinoa to a baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
            "secondary_message": null
          },
          {
            "id": 295264,
            "primary_message": "Meanwhile, halve and pit avocado; scoop the flesh out with a spoon and medium dice. Add to the bowl with the dressing and citrus fruit.",
            "secondary_message": null
          },
          {
            "id": 295265,
            "primary_message": "Add cooled quinoa to the bowl and gently stir to combine the salad.",
            "secondary_message": null
          },
          {
            "id": 295266,
            "primary_message": "To serve, divide spinach between plates and top with salad. Enjoy!",
            "secondary_message": null
          }
        ],
