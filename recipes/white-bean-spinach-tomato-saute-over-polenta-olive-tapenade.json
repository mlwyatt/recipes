  "instructions": [
    {
      "id": 250418,
      "primary_message": "In a medium saucepan, bring broth and water to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated into the broth. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 cup water\n1 ½ cups polenta (cornmeal)"
    },
    {
      "id": 250419,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 yellow bell peppers\n2 (5 oz) pkgs baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 250420,
      "primary_message": "Zest lemon into a small bowl. Cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 250421,
      "primary_message": "Mince olives, sun-dried tomatoes, and capers; add to the bowl with the lemon zest.",
      "secondary_message": "½ cup Kalamata olives, pitted\n8 sun-dried tomatoes, oil-packed\n2 tbsp capers"
    },
    {
      "id": 250422,
      "primary_message": "Peel and mince garlic; add to the bowl along with the oil. Stir to combine the tapenade and set aside.",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil"
    },
    {
      "id": 250423,
      "primary_message": "Trim, seed, and medium dice bell peppers; peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 250424,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250425,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, and spices; cook, stirring occasionally, until soft, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 250426,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 250427,
      "primary_message": "Add beans and tomatoes to the skillet; cook, stirring occasionally, until warmed through, about 5 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 250428,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 250429,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 250430,
      "primary_message": "Add oil, salt, and pepper to the polenta and stir to combine; if the polenta is too firm, add hot water, a few tablespoons at a time, until you reach a desired consistency.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 250431,
      "primary_message": "To serve, divide polenta and veggie sauté between bowls; top with olive tapenade and fresh basil. Serve with lemon wedges and enjoy!",
      "secondary_message": null
    }
  ],
