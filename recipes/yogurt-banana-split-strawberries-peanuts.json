  "instructions": [
    {
      "id": 487940,
      "primary_message": "Roughly chop peanuts. Place on a plate.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 487941,
      "primary_message": "Wash, dry, trim, and thinly slice strawberries. Add to the plate with the peanuts, keeping them separate.",
      "secondary_message": "1 (16 oz) pkg strawberries"
    },
    {
      "id": 487942,
      "primary_message": "Peel bananas and halve lengthwise. Divide between plates or bowls.",
      "secondary_message": "4 bananas"
    },
    {
      "id": 487943,
      "primary_message": "Use an ice cream scoop or measuring cup to portion yogurt over the bananas, then top with sliced strawberries.",
      "secondary_message": "2 cups plain Greek yogurt"
    },
    {
      "id": 487944,
      "primary_message": "To serve, sprinkle \"banana splits\" with peanuts and enjoy!",
      "secondary_message": null
    }
  ],
