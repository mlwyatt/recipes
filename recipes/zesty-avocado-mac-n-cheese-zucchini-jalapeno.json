        "instructions": [
          {
            "id": 115759,
            "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
            "secondary_message": "12 oz rotini pasta\n2 tsp salt"
          },
          {
            "id": 115760,
            "primary_message": "Coarsely grate the cheddar cheese and set aside.",
            "secondary_message": "½ (8 oz) block cheddar cheese"
          },
          {
            "id": 115761,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 medium zucchini squash\n2 jalapeño peppers\n1 small bunch cilantro\n1 avocado\n1 lime"
          },
          {
            "id": 115762,
            "primary_message": "Juice the lime into a medium bowl. Peel and mince or press the garlic into the same bowl.",
            "secondary_message": "2 cloves garlic"
          },
          {
            "id": 115763,
            "primary_message": "Halve the avocado and remove pit; scoop out the flesh into the medium bowl. Mash with a fork, mixing it into the lime juice and garlic.",
            "secondary_message": null
          },
          {
            "id": 115764,
            "primary_message": "Slice the zucchini into ½-inch half moons and set aside.",
            "secondary_message": null
          },
          {
            "id": 115765,
            "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and set aside. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
            "secondary_message": null
          },
          {
            "id": 115766,
            "primary_message": "Heat a large non-stick skillet over medium heat and add butter, swirling to coat the bottom.",
            "secondary_message": "2 tbsp butter, unsalted"
          },
          {
            "id": 115767,
            "primary_message": "Add the zucchini and jalapeños to the skillet. Cook, stirring occasionally, until the zucchini begins to brown; 4-5 minutes. Pour contents of skillet into a medium bowl and set aside.",
            "secondary_message": null
          },
          {
            "id": 115768,
            "primary_message": "Return the skillet to medium-low heat and add butter. Once melted, whisk in the flour and cook for 2 minutes.",
            "secondary_message": "2 tbsp butter, unsalted\n3 tbsp all-purpose flour"
          },
          {
            "id": 115769,
            "primary_message": "Whisk in the milk and cook, stirring constantly, until smooth and thick, about 3-4 minutes. Season with salt and pepper.",
            "secondary_message": "14 fl oz (1 ¾ cups) whole milk\n½ tsp salt\n¼ tsp black pepper"
          },
          {
            "id": 115770,
            "primary_message": "Add the grated cheese to the skillet and stir until melted. Remove skillet from heat.",
            "secondary_message": null
          },
          {
            "id": 115771,
            "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Set aside.",
            "secondary_message": null
          },
          {
            "id": 115772,
            "primary_message": "Add the avocado mixture to the skillet and stir until combined. Fold in the cooked pasta, veggie mixture, and cilantro.",
            "secondary_message": null
          },
          {
            "id": 115773,
            "primary_message": "Divide between plates, serve immediately, and enjoy!",
            "secondary_message": null
          }
        ],
