  "instructions": [
    {
      "id": 128434,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 128435,
      "primary_message": "Meanwhile, drain and rinse the chickpeas in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 128436,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 bunches kale\n4 medium carrots\n1 small bunch green onions (scallions)\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 128437,
      "primary_message": "Grate the zest from the lemon and transfer to a salad bowl; juice the lemon into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 128438,
      "primary_message": "Peel and mince garlic; transfer to the bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 128439,
      "primary_message": "Add vinegar, oil, Dijon, maple syrup, salt, and pepper to the bowl and whisk to combine. ",
      "secondary_message": "¼ cup red wine vinegar\n¼ cup extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp pure maple syrup\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 128440,
      "primary_message": "Fold the kale leaves in half lengthwise and slice off the stems. Finely chop leaves and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 128441,
      "primary_message": "Grate the carrots and add to the bowl with the kale. ",
      "secondary_message": null
    },
    {
      "id": 128442,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle and transfer to the bowl.",
      "secondary_message": null
    },
    {
      "id": 128443,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 128444,
      "primary_message": "Uncover the quinoa and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 128445,
      "primary_message": "Thinly slice the sun-dried tomatoes and add to the bowl.",
      "secondary_message": "16 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 128446,
      "primary_message": "Add the cooked quinoa and the chickpeas to the bowl; toss until well combined. ",
      "secondary_message": null
    },
    {
      "id": 128447,
      "primary_message": "To serve, divide salad between bowls and top with pumpkin seeds. Enjoy! ",
      "secondary_message": "⅔ cup pumpkin seeds"
    }
  ],
