        "instructions": [
          {
            "id": 486769,
            "primary_message": "Wash and dry the fresh produce.",
            "secondary_message": "2 limes\n1 avocado\n½ small bunch cilantro"
          },
          {
            "id": 486770,
            "primary_message": "Juice limes into a blender.",
            "secondary_message": null
          },
          {
            "id": 486771,
            "primary_message": "Peel garlic. Add to the blender along with cottage cheese, salsa, and spices. Blend the mixture on high for several minutes until smooth, scraping down the sides of the blender as needed. Add water, 1 tablespoon at a time, if needed, to reach a saucy consistency. Set aside.",
            "secondary_message": "2 cloves garlic\n1 ½ cups cottage cheese\n½ cup salsa\n1 tsp chili powder\n½ tsp onion powder\n½ tsp salt"
          },
          {
            "id": 486772,
            "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice. ",
            "secondary_message": null
          },
          {
            "id": 486773,
            "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
            "secondary_message": null
          },
          {
            "id": 486774,
            "primary_message": "To serve, divide chips between plates, arranging them in a single layer. Top with cottage cheese crema, avocado, and cilantro. Enjoy!",
            "secondary_message": "4 oz tortilla chips"
          }
        ],
