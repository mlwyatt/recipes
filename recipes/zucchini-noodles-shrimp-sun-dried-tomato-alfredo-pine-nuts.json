        "instructions": [
          {
            "id": 409000,
            "primary_message": "Preheat oven to 400°F.",
            "secondary_message": null
          },
          {
            "id": 409001,
            "primary_message": "Wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. Divide between two baking sheet pans, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
            "secondary_message": "8 medium zucchini squash\n2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
          },
          {
            "id": 409002,
            "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until zucchini noodles start to soften, about 8 minutes.",
            "secondary_message": null
          },
          {
            "id": 409003,
            "primary_message": "Meanwhile, place Alfredo sauce and pesto in a medium saucepan. Bring to a simmer over medium heat, stirring occasionally. Once simmering, remove from heat and cover to keep warm.",
            "secondary_message": "1 (16 oz) jar Alfredo sauce\n½ cup sun-dried tomato pesto"
          },
          {
            "id": 409004,
            "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
            "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
          },
          {
            "id": 409005,
            "primary_message": "When the zucchini is soft, remove from the oven and toss. Top with shrimp and drizzle with additional oil.",
            "secondary_message": "4 tsp extra virgin olive oil"
          },
          {
            "id": 409006,
            "primary_message": "Return baking sheets to the oven and continue to bake until zucchini noodles are tender and shrimp are cooked through, 6-7 minutes more. Remove from oven.",
            "secondary_message": null
          },
          {
            "id": 409007,
            "primary_message": "To serve, divide zucchini noodles and shrimp between plates or bowls; top with sauce and pine nuts. Enjoy!",
            "secondary_message": "¼ cup pine nuts"
          }
        ],
