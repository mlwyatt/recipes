        "instructions": [
          {
            "id": 8604,
            "primary_message": "Rinse lentils under cold water and transfer to a medium saucepan. Add water and salt; bring to a boil. Reduce heat to a simmer and cook until tender, 15-25 minutes.",
            "secondary_message": "1 ½ cups brown lentils\r\n¼ tsp salt\r\n3 cups water"
          },
          {
            "id": 8605,
            "primary_message": "Wash and dry zucchini, potatoes, bell peppers, and parsley.",
            "secondary_message": "2 zucchini\r\n2 medium yellow potatoes\r\n2 red bell peppers\r\n1 small bunch Italian (flat-leaf) parsley"
          },
          {
            "id": 8606,
            "primary_message": "Coarsely grate the zucchini. Peel and coarsely grate the potatoes. Place both in the middle of a clean tea towel, bring the corners together, and squeeze out excess moisture. Transfer to a medium bowl.",
            "secondary_message": "2 zucchini\r\n2 medium yellow potatoes"
          },
          {
            "id": 8607,
            "primary_message": "Heat a skillet over medium heat.",
            "secondary_message": ""
          },
          {
            "id": 8608,
            "primary_message": "Add oil, flour, salt, and pepper to bowl and mix.",
            "secondary_message": "1 tbsp extra virgin olive oil\n6 tbsp all-purpose flour\n½ tsp salt\n½ tsp black pepper"
          },
          {
            "id": 8609,
            "primary_message": "Once the skillet is hot, add oil to coat the bottom. Using a ¼ cup measure, form the zucchini mixture into patties. Working in batches if necessary, add patties to the skillet and flatten into ½-thick circles using the back of a spatula. Cook, flipping once, until golden and cooked through, 6-8 minutes. Remove to a paper towel-lined plate.",
            "secondary_message": "2 tbsp extra virgin olive oil"
          },
          {
            "id": 8610,
            "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. In a small bowl, prepare sauce by mixing together ½ of the minced parsley (save the rest for the salad), yogurt, salt, and pepper. Set aside.",
            "secondary_message": "½ cup plain Greek yogurt\n⅛ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 8611,
            "primary_message": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together garlic, oil, vinegar, Dijon, salt, and pepper.",
            "secondary_message": "1 clove garlic\n3 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n¼ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
          },
          {
            "id": 8612,
            "primary_message": "Add remaining parsley to bowl with dressing. Seed bell peppers, cut into small strips, and add to the bowl.",
            "secondary_message": "2 red bell peppers"
          },
          {
            "id": 8614,
            "primary_message": "Drain lentils, add to bowl, and toss salad.",
            "secondary_message": ""
          },
          {
            "id": 8615,
            "primary_message": "To serve, divide lentil salad and fritters between plates. Crumble goat cheese over the salad and top fritters with yogurt sauce. Enjoy!",
            "secondary_message": "1 (4 oz) log goat cheese"
          }
        ],
