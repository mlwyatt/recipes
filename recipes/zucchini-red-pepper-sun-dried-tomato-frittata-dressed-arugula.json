  "instructions": [
    {
      "id": 429941,
      "primary_message": "Wash, dry, trim and medium dice zucchini. Place in a medium bowl. ",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 429942,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 429943,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini and spices; cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 429944,
      "primary_message": "Meanwhile, place eggs, pesto, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "12 eggs\n⅔ cup sun-dried tomato pesto\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 429945,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 429946,
      "primary_message": "When the zucchini is done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 429947,
      "primary_message": "While the egg is cooking, drain and roughly chop roasted peppers. ",
      "secondary_message": "1 (12 oz) jar roasted red bell peppers"
    },
    {
      "id": 429948,
      "primary_message": "Sprinkle peppers and cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": "1 cup shredded cheese, Italian blend"
    },
    {
      "id": 429949,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 429950,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Add arugula to the plate and drizzle with dressing. Enjoy!",
      "secondary_message": "¼ cup Italian salad dressing"
    }
  ],
